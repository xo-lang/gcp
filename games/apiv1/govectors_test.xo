  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"avatarImageUrl\":\"s-avatarimageurl\",\"bannerUrlLandscape\":\"s-bannerurllandscape\",\"bannerUrlPortrait\":\"s-bannerurlportrait\",\"displayName\":\"s-displayname\",\"experienceInfo\":{\"currentExperiencePoints\":\"7\",\"kind\":\"s-kind\",\"lastLevelUpTimestampMillis\":\"7\"},\"friendStatus\":\"s-friendstatus\",\"gamePlayerId\":\"s-gameplayerid\",\"kind\":\"s-kind\",\"name\":{\"familyName\":\"s-familyname\",\"givenName\":\"s-givenname\"},\"originalPlayerId\":\"s-originalplayerid\",\"playerId\":\"s-playerid\",\"profileSettings\":{\"friendsListVisibility\":\"s-friendslistvisibility\",\"kind\":\"s-kind\",\"profileVisible\":true},\"title\":\"s-title\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"avatarImageUrl\":\"s-avatarimageurl\",\"bannerUrlLandscape\":\"s-bannerurllandscape\",\"bannerUrlPortrait\":\"s-bannerurlportrait\",\"displayName\":\"s-displayname\",\"experienceInfo\":{\"currentExperiencePoints\":\"7\",\"kind\":\"s-kind\",\"lastLevelUpTimestampMillis\":\"7\"},\"friendStatus\":\"s-friendstatus\",\"gamePlayerId\":\"s-gameplayerid\",\"kind\":\"s-kind\",\"name\":{\"familyName\":\"s-familyname\",\"givenName\":\"s-givenname\"},\"originalPlayerId\":\"s-originalplayerid\",\"playerId\":\"s-playerid\",\"profileSettings\":{\"friendsListVisibility\":\"s-friendslistvisibility\",\"kind\":\"s-kind\",\"profileVisible\":true},\"title\":\"s-title\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL games.players.list pages")
  var p = svc.players.list_pages("id1/ x", options: PlayersListOptions{language: Some("s-language"), max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_31)
}

