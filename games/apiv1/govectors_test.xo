test "Go's games.snapshots.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"coverImage\":{\"height\":7,\"kind\":\"s-kind\",\"mime_type\":\"s-mime_type\",\"url\":\"s-url\",\"width\":7},\"description\":\"s-description\",\"driveId\":\"s-driveid\",\"durationMillis\":\"7\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"lastModifiedMillis\":\"7\",\"progressValue\":\"7\",\"title\":\"s-title\",\"type\":\"s-type\",\"uniqueName\":\"s-uniquename\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"coverImage\":{\"height\":7,\"kind\":\"s-kind\",\"mime_type\":\"s-mime_type\",\"url\":\"s-url\",\"width\":7},\"description\":\"s-description\",\"driveId\":\"s-driveid\",\"durationMillis\":\"7\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"lastModifiedMillis\":\"7\",\"progressValue\":\"7\",\"title\":\"s-title\",\"type\":\"s-type\",\"uniqueName\":\"s-uniquename\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL games.snapshots.list pages")
  var p = svc.snapshots.list_pages("id1/ x", options: SnapshotsListOptions{language: Some("s-language"), max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_49)
}

