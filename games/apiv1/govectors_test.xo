  gv_queue(f, "{\"items\":[{\"friendsRank\":{\"formattedNumScores\":\"s-formattednumscores\",\"formattedRank\":\"s-formattedrank\",\"kind\":\"s-kind\",\"numScores\":\"7\",\"rank\":\"7\"},\"kind\":\"s-kind\",\"leaderboard_id\":\"s-leaderboard_id\",\"publicRank\":{\"formattedNumScores\":\"s-formattednumscores\",\"formattedRank\":\"s-formattedrank\",\"kind\":\"s-kind\",\"numScores\":\"7\",\"rank\":\"7\"},\"scoreString\":\"s-scorestring\",\"scoreTag\":\"s-scoretag\",\"scoreValue\":\"7\",\"socialRank\":{\"formattedNumScores\":\"s-formattednumscores\",\"formattedRank\":\"s-formattedrank\",\"kind\":\"s-kind\",\"numScores\":\"7\",\"rank\":\"7\"},\"timeSpan\":\"s-timespan\",\"writeTimestamp\":\"7\"}],\"kind\":\"s-kind\",\"player\":{\"avatarImageUrl\":\"s-avatarimageurl\",\"bannerUrlLandscape\":\"s-bannerurllandscape\",\"bannerUrlPortrait\":\"s-bannerurlportrait\",\"displayName\":\"s-displayname\",\"experienceInfo\":{\"currentExperiencePoints\":\"7\",\"kind\":\"s-kind\",\"lastLevelUpTimestampMillis\":\"7\"},\"friendStatus\":\"s-friendstatus\",\"gamePlayerId\":\"s-gameplayerid\",\"kind\":\"s-kind\",\"name\":{\"familyName\":\"s-familyname\",\"givenName\":\"s-givenname\"},\"originalPlayerId\":\"s-originalplayerid\",\"playerId\":\"s-playerid\",\"profileSettings\":{\"friendsListVisibility\":\"s-friendslistvisibility\",\"kind\":\"s-kind\",\"profileVisible\":true},\"title\":\"s-title\"}}")
  gv_note(f, "CALL games.scores.get pages")
  var p = svc.scores.get_pages("id1/ x", "id2/ x", "id3/ x", options: ScoresGetOptions{include_rank_type: Some("s-includeranktype"), language: Some("s-language"), max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_40)
}

