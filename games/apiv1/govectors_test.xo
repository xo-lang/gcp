  gv_queue(f, "{\"items\":[{\"formattedScore\":\"s-formattedscore\",\"formattedScoreRank\":\"s-formattedscorerank\",\"kind\":\"s-kind\",\"player\":{\"avatarImageUrl\":\"s-avatarimageurl\",\"bannerUrlLandscape\":\"s-bannerurllandscape\",\"bannerUrlPortrait\":\"s-bannerurlportrait\",\"displayName\":\"s-displayname\",\"friendStatus\":\"s-friendstatus\",\"gamePlayerId\":\"s-gameplayerid\",\"kind\":\"s-kind\",\"originalPlayerId\":\"s-originalplayerid\",\"playerId\":\"s-playerid\",\"title\":\"s-title\"},\"scoreRank\":\"7\",\"scoreTag\":\"s-scoretag\",\"scoreValue\":\"7\",\"timeSpan\":\"s-timespan\",\"writeTimestampMillis\":\"7\"}],\"kind\":\"s-kind\",\"numScores\":\"7\",\"playerScore\":{\"formattedScore\":\"s-formattedscore\",\"formattedScoreRank\":\"s-formattedscorerank\",\"kind\":\"s-kind\",\"player\":{\"avatarImageUrl\":\"s-avatarimageurl\",\"bannerUrlLandscape\":\"s-bannerurllandscape\",\"bannerUrlPortrait\":\"s-bannerurlportrait\",\"displayName\":\"s-displayname\",\"friendStatus\":\"s-friendstatus\",\"gamePlayerId\":\"s-gameplayerid\",\"kind\":\"s-kind\",\"name\":{\"familyName\":\"s-familyname\",\"givenName\":\"s-givenname\"},\"originalPlayerId\":\"s-originalplayerid\",\"playerId\":\"s-playerid\",\"title\":\"s-title\"},\"scoreRank\":\"7\",\"scoreTag\":\"s-scoretag\",\"scoreValue\":\"7\",\"timeSpan\":\"s-timespan\",\"writeTimestampMillis\":\"7\"},\"prevPageToken\":\"s-prevpagetoken\"}")
  gv_note(f, "CALL games.scores.listWindow pages")
  var p = svc.scores.list_window_pages("id1/ x", "id2/ x", "s-timespan", options: ScoresListWindowOptions{language: Some("s-language"), max_results: Some(7), page_token: Some("s-pagetoken"), results_above: Some(7), return_top_if_absent: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_44)
}

