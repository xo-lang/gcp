  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"avg_session_length_minutes\":1.5,\"churn_probability\":1.5,\"days_since_last_played\":7,\"high_spender_probability\":1.5,\"kind\":\"s-kind\",\"num_purchases\":7,\"num_sessions\":7,\"num_sessions_percentile\":1.5,\"spend_percentile\":1.5,\"spend_probability\":1.5,\"total_spend_next_28_days\":1.5}")
  gv_note(f, "CALL games.stats.get")
  match svc.stats.get(options: StatsGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
