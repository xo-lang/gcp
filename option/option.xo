// The options every service takes, as google.golang.org/api's option
// package (BSD-3-Clause, Copyright (c) 2011 Google Inc.; NOTICE.md).

use github.com/xo-lang/gcp/auth

/// Go's option.ClientOption values, as one struct with defaults.
pub struct ClientOptions[fx: Effects] {
  /// The service's endpoint in place of its default (Go's
  /// option.WithEndpoint); "" for the service's own.
  pub endpoint: Str = ""
  /// Put after this library's own User-Agent (Go's option.WithUserAgent).
  pub user_agent: Str = ""
  /// An API key, sent as the `key` query parameter (Go's
  /// option.WithAPIKey).
  pub api_key: Str = ""
  /// The project billed for quota (Go's option.WithQuotaProject), sent
  /// as `X-Goog-User-Project`.
  pub quota_project: Str = ""
  /// Where tokens come from (Go's option.WithAuthCredentials).
  pub credentials: auth.TokenProvider[fx]? = None
  /// Send no credentials at all (Go's option.WithoutAuthentication).
  pub without_authentication: Bool = false
  /// How long one request may take in all.
  pub timeout: Duration = 60s
}
