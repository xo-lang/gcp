  match svc.presentations.batch_update("id1/ x", json.decode_str[BatchUpdatePresentationRequest]("{\"requests\":[{\"addCommentReply\":{\"commentId\":\"s-commentid\"},\"createImage\":{\"objectId\":\"s-objectid\",\"url\":\"s-url\"},\"createLine\":{\"category\":\"s-category\",\"lineCategory\":\"s-linecategory\",\"objectId\":\"s-objectid\"},\"createParagraphBullets\":{\"bulletPreset\":\"s-bulletpreset\",\"objectId\":\"s-objectid\"},\"createShape\":{\"objectId\":\"s-objectid\",\"shapeType\":\"s-shapetype\"},\"createSheetsChart\":{\"chartId\":7,\"linkingMode\":\"s-linkingmode\",\"objectId\":\"s-objectid\",\"spreadsheetId\":\"s-spreadsheetid\"},\"createSlide\":{\"insertionIndex\":7,\"objectId\":\"s-objectid\"},\"createTable\":{\"columns\":7,\"objectId\":\"s-objectid\",\"rows\":7},\"createVideo\":{\"id\":\"s-id\",\"objectId\":\"s-objectid\",\"source\":\"s-source\"},\"deleteComment\":{\"commentId\":\"s-commentid\"},\"deleteCommentReply\":{\"commentId\":\"s-commentid\",\"postId\":\"s-postid\"},\"deleteObject\":{\"objectId\":\"s-objectid\"},\"deleteParagraphBullets\":{\"objectId\":\"s-objectid\"},\"deleteTableColumn\":{\"tableObjectId\":\"s-tableobjectid\"},\"deleteTableRow\":{\"tableObjectId\":\"s-tableobjectid\"},\"deleteText\":{\"objectId\":\"s-objectid\"},\"duplicateObject\":{\"objectId\":\"s-objectid\"},\"groupObjects\":{\"groupObjectId\":\"s-groupobjectid\"},\"insertComment\":{\"assigneeEmailAddress\":\"s-assigneeemailaddress\",\"content\":\"s-content\",\"objectId\":\"s-objectid\"},\"insertTableColumns\":{\"insertRight\":true,\"number\":7,\"tableObjectId\":\"s-tableobjectid\"},\"insertTableRows\":{\"insertBelow\":true,\"number\":7,\"tableObjectId\":\"s-tableobjectid\"},\"insertText\":{\"insertionIndex\":7,\"objectId\":\"s-objectid\",\"text\":\"s-text\"},\"mergeTableCells\":{\"objectId\":\"s-objectid\"},\"refreshSheetsChart\":{\"objectId\":\"s-objectid\"},\"replaceAllShapesWithImage\":{\"imageReplaceMethod\":\"s-imagereplacemethod\",\"imageUrl\":\"s-imageurl\",\"replaceMethod\":\"s-replacemethod\"},\"replaceAllShapesWithSheetsChart\":{\"chartId\":7,\"linkingMode\":\"s-linkingmode\",\"spreadsheetId\":\"s-spreadsheetid\"},\"replaceAllText\":{\"replaceText\":\"s-replacetext\"},\"replaceImage\":{\"imageObjectId\":\"s-imageobjectid\",\"imageReplaceMethod\":\"s-imagereplacemethod\",\"url\":\"s-url\"},\"rerouteLine\":{\"objectId\":\"s-objectid\"},\"ungroupObjects\":{},\"unmergeTableCells\":{\"objectId\":\"s-objectid\"},\"updateCommentPost\":{\"commentId\":\"s-commentid\",\"content\":\"s-content\",\"postId\":\"s-postid\"},\"updateImageProperties\":{\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"},\"updateLineCategory\":{\"lineCategory\":\"s-linecategory\",\"objectId\":\"s-objectid\"},\"updateLineProperties\":{\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"},\"updatePageElementAltText\":{\"description\":\"s-description\",\"objectId\":\"s-objectid\",\"title\":\"s-title\"},\"updatePageElementTransform\":{\"applyMode\":\"s-applymode\",\"objectId\":\"s-objectid\"},\"updatePageElementsZOrder\":{\"operation\":\"s-operation\"},\"updatePageProperties\":{\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"},\"updateParagraphStyle\":{\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"},\"updateShapeProperties\":{\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"},\"updateSlideProperties\":{\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"},\"updateSlidesPosition\":{\"insertionIndex\":7},\"updateTableBorderProperties\":{\"borderPosition\":\"s-borderposition\",\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"},\"updateTableCellProperties\":{\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"},\"updateTableColumnProperties\":{\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"},\"updateTableRowProperties\":{\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"},\"updateTextStyle\":{\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"},\"updateVideoProperties\":{\"fields\":\"s-fields\",\"objectId\":\"s-objectid\"}}],\"writeControl\":{\"requiredRe