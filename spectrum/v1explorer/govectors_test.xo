  "  B {\"deviceDescs\":[{\"etsiEnDeviceCategory\":\"s-etsiendevicecategory\",\"etsiEnDeviceEmissionsClass\":\"s-etsiendeviceemissionsclass\",\"etsiEnDeviceType\":\"s-etsiendevicetype\",\"etsiEnTechnologyId\":\"s-etsientechnologyid\",\"fccId\":\"s-fccid\",\"fccTvbdDeviceType\":\"s-fcctvbddevicetype\",\"manufacturerId\":\"s-manufacturerid\",\"modelId\":\"s-modelid\",\"rulesetIds\":[\"s-rulesetids\"],\"serialNumber\":\"s-serialnumber\"}],\"type\":\"s-type\",\"version\":\"s-version\"}",
  "",
  "  SERVED 200 {\"databaseChange\":{\"databases\":[{\"name\":\"s-name\",\"uri\":\"s-uri\"}]},\"deviceValidities\":[{\"deviceDesc\":{\"etsiEnDeviceCategory\":\"s-etsiendevicecategory\",\"etsiEnDeviceEmissionsClass\":\"s-etsiendeviceemissionsclass\",\"etsiEnDeviceType\":\"s-etsiendevicetype\",\"etsiEnTechnologyId\":\"s-etsientechnologyid\",\"fccId\":\"s-fccid\",\"fccTvbdDeviceType\":\"s-fcctvbddevicetype\",\"manufacturerId\":\"s-manufacturerid\",\"modelId\":\"s-modelid\",\"serialNumber\":\"s-serialnumber\"},\"isValid\":true,\"reason\":\"s-reason\"}],\"kind\":\"s-kind\",\"type\":\"s-type\",\"version\":\"s-version\"}",
  "OUT: {\"databaseChange\":{\"databases\":[{\"name\":\"s-name\",\"uri\":\"s-uri\"}]},\"deviceValidities\":[{\"deviceDesc\":{\"etsiEnDeviceCategory\":\"s-etsiendevicecategory\",\"etsiEnDeviceEmissionsClass\":\"s-etsiendeviceemissionsclass\",\"etsiEnDeviceType\":\"s-etsiendevicetype\",\"etsiEnTechnologyId\":\"s-etsientechnologyid\",\"fccId\":\"s-fccid\",\"fccTvbdDeviceType\":\"s-fcctvbddevicetype\",\"manufacturerId\":\"s-manufacturerid\",\"modelId\":\"s-modelid\",\"serialNumber\":\"s-serialnumber\"},\"isValid\":true,\"reason\":\"s-reason\"}],\"kind\":\"s-kind\",\"type\":\"s-type\",\"version\":\"s-version\"}",
]

test "Go's spectrum.paws.verifyDevice" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"databaseChange\":{\"databases\":[{\"name\":\"s-name\",\"uri\":\"s-uri\"}]},\"deviceValidities\":[{\"deviceDesc\":{\"etsiEnDeviceCategory\":\"s-etsiendevicecategory\",\"etsiEnDeviceEmissionsClass\":\"s-etsiendeviceemissionsclass\",\"etsiEnDeviceType\":\"s-etsiendevicetype\",\"etsiEnTechnologyId\":\"s-etsientechnologyid\",\"fccId\":\"s-fccid\",\"fccTvbdDeviceType\":\"s-fcctvbddevicetype\",\"manufacturerId\":\"s-manufacturerid\",\"modelId\":\"s-modelid\",\"serialNumber\":\"s-serialnumber\"},\"isValid\":true,\"reason\":\"s-reason\"}],\"kind\":\"s-kind\",\"type\":\"s-type\",\"version\":\"s-version\"}")
  gv_note(f, "CALL spectrum.paws.verifyDevice")
  match svc.paws.verify_device(json.decode_str[PawsVerifyDeviceRequest]("{\"deviceDescs\":[{\"etsiEnDeviceCategory\":\"s-etsiendevicecategory\",\"etsiEnDeviceEmissionsClass\":\"s-etsiendeviceemissionsclass\",\"etsiEnDeviceType\":\"s-etsiendevicetype\",\"etsiEnTechnologyId\":\"s-etsientechnologyid\",\"fccId\":\"s-fccid\",\"fccTvbdDeviceType\":\"s-fcctvbddevicetype\",\"manufacturerId\":\"s-manufacturerid\",\"modelId\":\"s-modelid\",\"rulesetIds\":[\"s-rulesetids\"],\"serialNumber\":\"s-serialnumber\"}],\"type\":\"s-type\",\"version\":\"s-version\"}") ?? e => fault(e.display()), options: PawsVerifyDeviceOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_5)
}
