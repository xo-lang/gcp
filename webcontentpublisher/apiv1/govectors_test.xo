test "Go's webcontentpublisher.organizations.publications.ctas.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"ctas\":[{\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"newsletterConfig\":{\"customConsentText\":\"s-customconsenttext\",\"customMessage\":\"s-custommessage\",\"nameRequired\":true,\"optInRequired\":true,\"title\":\"s-title\"},\"state\":\"s-state\",\"surveyConfig\":{\"customMessage\":\"s-custommessage\",\"reportUrl\":\"s-reporturl\"},\"type\":\"s-type\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"ctas\":[{\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"newsletterConfig\":{\"customConsentText\":\"s-customconsenttext\",\"customMessage\":\"s-custommessage\",\"nameRequired\":true,\"optInRequired\":true,\"title\":\"s-title\"},\"state\":\"s-state\",\"surveyConfig\":{\"customMessage\":\"s-custommessage\",\"reportUrl\":\"s-reporturl\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL webcontentpublisher.organizations.publications.ctas.list pages")
  var p = svc.organizations.publications.ctas.list_pages("id1/ x", options: OrganizationsPublicationsCtasListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_9)
}

