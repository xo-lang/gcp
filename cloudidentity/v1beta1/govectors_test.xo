test "Go's cloudidentity.policies.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"policies\":[{\"customer\":\"s-customer\",\"name\":\"s-name\",\"policyQuery\":{\"group\":\"s-group\",\"orgUnit\":\"s-orgunit\",\"query\":\"s-query\",\"sortOrder\":1.5},\"setting\":{\"type\":\"s-type\",\"value\":{\"k\":\"v\"}},\"type\":\"s-type\"}]}")
  gv_queue(f, "{\"policies\":[{\"customer\":\"s-customer\",\"name\":\"s-name\",\"policyQuery\":{\"group\":\"s-group\",\"orgUnit\":\"s-orgunit\",\"query\":\"s-query\",\"sortOrder\":1.5},\"setting\":{\"type\":\"s-type\",\"value\":{\"k\":\"v\"}},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL cloudidentity.policies.list pages")
  var p = svc.policies.list_pages(options: PoliciesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_86)
}

