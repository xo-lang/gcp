use std/json

const GV_HOST: Str = "https://indexing.googleapis.com"

const GO_0: List[Str] = [
  "CALL indexing.urlNotifications.getMetadata",
  "REQ GET https://indexing.googleapis.com/v3/urlNotifications/metadata?alt=json&fields=kind%2Cid&prettyPrint=false&url=s-url",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"latestRemove\":{\"notifyTime\":\"s-notifytime\",\"type\":\"s-type\",\"url\":\"s-url\"},\"latestUpdate\":{\"notifyTime\":\"s-notifytime\",\"type\":\"s-type\",\"url\":\"s-url\"},\"url\":\"s-url\"}",
  "OUT: {\"latestRemove\":{\"notifyTime\":\"s-notifytime\",\"type\":\"s-type\",\"url\":\"s-url\"},\"latestUpdate\":{\"notifyTime\":\"s-notifytime\",\"type\":\"s-type\",\"url\":\"s-url\"},\"url\":\"s-url\"}",
]

test "Go's indexing.urlNotifications.getMetadata" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"latestRemove\":{\"notifyTime\":\"s-notifytime\",\"type\":\"s-type\",\"url\":\"s-url\"},\"latestUpdate\":{\"notifyTime\":\"s-notifytime\",\"type\":\"s-type\",\"url\":\"s-url\"},\"url\":\"s-url\"}")
  gv_note(f, "CALL indexing.urlNotifications.getMetadata")
  match svc.url_notifications.get_metadata(options: UrlNotificationsGetMetadataOptions{url: Some("s-url"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

const GO_1: List[Str] = [
  "CALL indexing.urlNotifications.publish",
  "REQ POST https://indexing.googleapis.com/v3/urlNotifications:publish?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
