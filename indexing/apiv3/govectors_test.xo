  "OUT: {\"urlNotificationMetadata\":{\"latestRemove\":{\"notifyTime\":\"s-notifytime\",\"type\":\"s-type\",\"url\":\"s-url\"},\"latestUpdate\":{\"notifyTime\":\"s-notifytime\",\"type\":\"s-type\",\"url\":\"s-url\"},\"url\":\"s-url\"}}",
]

test "Go's indexing.urlNotifications.publish" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"urlNotificationMetadata\":{\"latestRemove\":{\"notifyTime\":\"s-notifytime\",\"type\":\"s-type\",\"url\":\"s-url\"},\"latestUpdate\":{\"notifyTime\":\"s-notifytime\",\"type\":\"s-type\",\"url\":\"s-url\"},\"url\":\"s-url\"}}")
  gv_note(f, "CALL indexing.urlNotifications.publish")
  match svc.url_notifications.publish(json.decode_str[UrlNotification]("{\"notifyTime\":\"s-notifytime\",\"type\":\"s-type\",\"url\":\"s-url\"}") ?? e => fault(e.display()), options: UrlNotificationsPublishOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
