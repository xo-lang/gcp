use std/json

const GV_HOST: Str = "https://addressvalidation.googleapis.com"

const GO_0: List[Str] = [
  "CALL addressvalidation.provideValidationFeedback",
  "REQ POST https://addressvalidation.googleapis.com/v1:provideValidationFeedback?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"conclusion\":\"s-conclusion\",\"responseId\":\"s-responseid\"}",
  "",
  "  SERVED 200 {}",
  "OUT: {}",
]

test "Go's addressvalidation.provideValidationFeedback" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{}")
  gv_note(f, "CALL addressvalidation.provideValidationFeedback")
  match svc.v1.provide_validation_feedback(json.decode_str[GoogleMapsAddressvalidationV1ProvideValidationFeedbackRequest]("{\"conclusion\":\"s-conclusion\",\"responseId\":\"s-responseid\"}") ?? e => fault(e.display()), options: V1ProvideValidationFeedbackOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

