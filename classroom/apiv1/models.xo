  /// Identifier of the course. Read-only.
  pub course_id as "courseId,omitempty": Str = ""
  /// Identifier for the course work this corresponds to. Read-only.
  pub course_work_id as "courseWorkId,omitempty": Str = ""
  /// Type of course work this submission is for. Read-only.
  pub course_work_type as "courseWorkType,omitempty": Str = ""
  /// Creation time of this submission. This may be unset if the student has not accessed this item. Read-only.
  pub creation_time as "creationTime,omitempty": Str = ""
  /// Optional pending grade. If unset, no grade was set. This value must be non-negative. Decimal (that is, non-integer) values are allowed, but are rounded to two decimal places. This is only visible to and modifiable by course teachers.
  pub draft_grade as "draftGrade,omitempty": Float = 0.0
  /// Pending rubric grades based on the rubric's criteria. This map is empty if there is no rubric attached to this course work or if a rubric is attached, but no grades have been set on any criteria. Entries are only populated for grades that have been set. Key: The rubric's criterion ID. Read-only.
  pub draft_rubric_grades as "draftRubricGrades,omitempty": Map[Str, RubricGrade] = {}
  /// Classroom-assigned Identifier for the student submission. This is unique among submissions for the relevant course work. Read-only.
  pub id as "id,omitempty": Str = ""
  /// Whether this submission is late. Read-only.
  pub late as "late,omitempty": Bool = false
  /// Submission content when course_work_type is MULTIPLE_CHOICE_QUESTION.
