test "Go's classroom.courses.courseWork.studentSubmissions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"studentSubmissions\":[{\"alternateLink\":\"s-alternatelink\",\"assignedGrade\":1.5,\"assignmentSubmission\":{},\"associatedWithDeveloper\":true,\"courseId\":\"s-courseid\",\"courseWorkId\":\"s-courseworkid\",\"courseWorkType\":\"s-courseworktype\",\"creationTime\":\"s-creationtime\",\"draftGrade\":1.5,\"id\":\"s-id\",\"late\":true,\"multipleChoiceSubmission\":{\"answer\":\"s-answer\"},\"shortAnswerSubmission\":{\"answer\":\"s-answer\"},\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"userId\":\"s-userid\"}]}")
  gv_queue(f, "{\"studentSubmissions\":[{\"alternateLink\":\"s-alternatelink\",\"assignedGrade\":1.5,\"assignmentSubmission\":{},\"associatedWithDeveloper\":true,\"courseId\":\"s-courseid\",\"courseWorkId\":\"s-courseworkid\",\"courseWorkType\":\"s-courseworktype\",\"creationTime\":\"s-creationtime\",\"draftGrade\":1.5,\"id\":\"s-id\",\"late\":true,\"multipleChoiceSubmission\":{\"answer\":\"s-answer\"},\"shortAnswerSubmission\":{\"answer\":\"s-answer\"},\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"userId\":\"s-userid\"}]}")
  gv_note(f, "CALL classroom.courses.courseWork.studentSubmissions.list pages")
  var p = svc.courses.course_work.student_submissions.list_pages("id1/ x", "id2/ x", options: CoursesCourseWorkStudentSubmissionsListOptions{late: Some("s-late"), page_size: Some(7), page_token: Some("s-pagetoken"), states: ["s-states"], user_id: Some("s-userid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_54)
}

