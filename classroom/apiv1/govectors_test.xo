test "Go's classroom.courses.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"courses\":[{\"alternateLink\":\"s-alternatelink\",\"calendarId\":\"s-calendarid\",\"courseGroupEmail\":\"s-coursegroupemail\",\"courseState\":\"s-coursestate\",\"creationTime\":\"s-creationtime\",\"description\":\"s-description\",\"descriptionHeading\":\"s-descriptionheading\",\"enrollmentCode\":\"s-enrollmentcode\",\"gradebookSettings\":{\"calculationType\":\"s-calculationtype\",\"displaySetting\":\"s-displaysetting\"},\"guardiansEnabled\":true,\"id\":\"s-id\",\"levels\":\"s-levels\",\"name\":\"s-name\",\"ownerId\":\"s-ownerid\",\"room\":\"s-room\",\"section\":\"s-section\",\"subject\":\"s-subject\",\"teacherFolder\":{\"alternateLink\":\"s-alternatelink\",\"id\":\"s-id\",\"title\":\"s-title\"},\"teacherGroupEmail\":\"s-teachergroupemail\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"courses\":[{\"alternateLink\":\"s-alternatelink\",\"calendarId\":\"s-calendarid\",\"courseGroupEmail\":\"s-coursegroupemail\",\"courseState\":\"s-coursestate\",\"creationTime\":\"s-creationtime\",\"description\":\"s-description\",\"descriptionHeading\":\"s-descriptionheading\",\"enrollmentCode\":\"s-enrollmentcode\",\"gradebookSettings\":{\"calculationType\":\"s-calculationtype\",\"displaySetting\":\"s-displaysetting\"},\"guardiansEnabled\":true,\"id\":\"s-id\",\"levels\":\"s-levels\",\"name\":\"s-name\",\"ownerId\":\"s-ownerid\",\"room\":\"s-room\",\"section\":\"s-section\",\"subject\":\"s-subject\",\"teacherFolder\":{\"alternateLink\":\"s-alternatelink\",\"id\":\"s-id\",\"title\":\"s-title\"},\"teacherGroupEmail\":\"s-teachergroupemail\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL classroom.courses.list pages")
  var p = svc.courses.list_pages(options: CoursesListOptions{course_states: ["s-coursestates"], page_size: Some(7), page_token: Some("s-pagetoken"), student_id: Some("s-studentid"), teacher_id: Some("s-teacherid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_5)
}

