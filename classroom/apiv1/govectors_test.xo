  gv_queue(f, "{\"courseWork\":[{\"alternateLink\":\"s-alternatelink\",\"assigneeMode\":\"s-assigneemode\",\"assignment\":{},\"associatedWithDeveloper\":true,\"courseId\":\"s-courseid\",\"creationTime\":\"s-creationtime\",\"creatorUserId\":\"s-creatoruserid\",\"description\":\"s-description\",\"dueDate\":{\"day\":7,\"month\":7,\"year\":7},\"dueTime\":{\"hours\":7,\"minutes\":7,\"nanos\":7,\"seconds\":7},\"gradeCategory\":{\"defaultGradeDenominator\":7,\"id\":\"s-id\",\"name\":\"s-name\",\"weight\":7},\"gradingPeriodId\":\"s-gradingperiodid\",\"id\":\"s-id\",\"individualStudentsOptions\":{},\"maxPoints\":1.5,\"multipleChoiceQuestion\":{},\"scheduledTime\":\"s-scheduledtime\",\"state\":\"s-state\",\"submissionModificationMode\":\"s-submissionmodificationmode\",\"title\":\"s-title\",\"topicId\":\"s-topicid\",\"updateTime\":\"s-updatetime\",\"workType\":\"s-worktype\"}]}")
  gv_note(f, "CALL classroom.courses.courseWork.list pages")
  var p = svc.courses.course_work.list_pages("id1/ x", options: CoursesCourseWorkListOptions{course_work_states: ["s-courseworkstates"], order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
