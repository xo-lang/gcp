test "Go's classroom.courses.announcements.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"announcements\":[{\"alternateLink\":\"s-alternatelink\",\"assigneeMode\":\"s-assigneemode\",\"courseId\":\"s-courseid\",\"creationTime\":\"s-creationtime\",\"creatorUserId\":\"s-creatoruserid\",\"id\":\"s-id\",\"individualStudentsOptions\":{},\"scheduledTime\":\"s-scheduledtime\",\"state\":\"s-state\",\"text\":\"s-text\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"announcements\":[{\"alternateLink\":\"s-alternatelink\",\"assigneeMode\":\"s-assigneemode\",\"courseId\":\"s-courseid\",\"creationTime\":\"s-creationtime\",\"creatorUserId\":\"s-creatoruserid\",\"id\":\"s-id\",\"individualStudentsOptions\":{},\"scheduledTime\":\"s-scheduledtime\",\"state\":\"s-state\",\"text\":\"s-text\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL classroom.courses.announcements.list pages")
  var p = svc.courses.announcements.list_pages("id1/ x", options: CoursesAnnouncementsListOptions{announcement_states: ["s-announcementstates"], order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_18)
}

