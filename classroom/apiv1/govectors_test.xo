  gv_queue(f, "{\"addOnAttachments\":[{\"courseId\":\"s-courseid\",\"dueDate\":{\"day\":7,\"month\":7,\"year\":7},\"dueTime\":{\"hours\":7,\"minutes\":7,\"nanos\":7,\"seconds\":7},\"gradeSyncEnabled\":true,\"id\":\"s-id\",\"itemId\":\"s-itemid\",\"maxPoints\":1.5,\"postId\":\"s-postid\",\"studentViewUri\":{\"uri\":\"s-uri\"},\"studentWorkReviewUri\":{\"uri\":\"s-uri\"},\"teacherViewUri\":{\"uri\":\"s-uri\"},\"title\":\"s-title\"}]}")
