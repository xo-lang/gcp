  gv_note(f, "CALL classroom.userProfiles.guardians.list")
  match svc.user_profiles.guardians.list("id1/ x", options: UserProfilesGuardiansListOptions{invited_email_address: Some("s-invitedemailaddress"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_123)
}

const GO_124: List[Str] = [
  "CALL classroom.userProfiles.guardians.list pages",
  "REQ GET https://classroom.googleapis.com/v1/userProfiles/id1%2F%20x/guardians?alt=json&fields=kind%2Cid&invitedEmailAddress=s-invitedemailaddress&pageSize=7&pageToken=s-pagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"guardians\":[{\"guardianId\":\"s-guardianid\",\"guardianProfile\":{\"emailAddress\":\"s-emailaddress\",\"id\":\"s-id\",\"photoUrl\":\"s-photourl\",\"verifiedTeacher\":true},\"invitedEmailAddress\":\"s-invitedemailaddress\",\"studentId\":\"s-studentid\"}],\"nextPageToken\":\"s-nextpagetoken\"}",
  "OUT: {\"guardians\":[{\"guardianId\":\"s-guardianid\",\"guardianProfile\":{\"emailAddress\":\"s-emailaddress\",\"id\":\"s-id\",\"photoUrl\":\"s-photourl\",\"verifiedTeacher\":true},\"invitedEmailAddress\":\"s-invitedemailaddress\",\"studentId\":\"s-studentid\"}],\"nextPageToken\":\"s-nextpagetoken\"}",
  "REQ GET https://classroom.googleapis.com/v1/userProfiles/id1%2F%20x/guardians?alt=json&fields=kind%2Cid&invitedEmailAddress=s-invitedemailaddress&pageSize=7&pageToken=s-nextpagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"guardians\":[{\"guardianId\":\"s-guardianid\",\"guardianProfile\":{\"emailAddress\":\"s-emailaddress\",\"id\":\"s-id\",\"photoUrl\":\"s-photourl\",\"verifiedTeacher\":true},\"invitedEmailAddress\":\"s-invitedemailaddress\",\"studentId\":\"s-studentid\"}]}",
  "OUT: {\"guardians\":[{\"guardianId\":\"s-guardianid\",\"guardianProfile\":{\"emailAddress\":\"s-emailaddress\",\"id\":\"s-id\",\"photoUrl\":\"s-photourl\",\"verifiedTeacher\":true},\"invitedEmailAddress\":\"s-invitedemailaddress\",\"studentId\":\"s-studentid\"}]}",
  "OUT: ok",
]

test "Go's classroom.userProfiles.guardians.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"guardians\":[{\"guardianId\":\"s-guardianid\",\"guardianProfile\":{\"emailAddress\":\"s-emailaddress\",\"id\":\"s-id\",\"photoUrl\":\"s-photourl\",\"verifiedTeacher\":true},\"invitedEmailAddress\":\"s-invitedemailaddress\",\"studentId\":\"s-studentid\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"guardians\":[{\"guardianId\":\"s-guardianid\",\"guardianProfile\":{\"emailAddress\":\"s-emailaddress\",\"id\":\"s-id\",\"photoUrl\":\"s-photourl\",\"verifiedTeacher\":true},\"invitedEmailAddress\":\"s-invitedemailaddress\",\"studentId\":\"s-studentid\"}]}")
  gv_note(f, "CALL classroom.userProfiles.guardians.list pages")
  var p = svc.user_profiles.guardians.list_pages("id1/ x", options: UserProfilesGuardiansListOptions{invited_email_address: Some("s-invitedemailaddress"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_124)
}
