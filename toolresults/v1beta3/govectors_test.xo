  "REQ GET https://toolresults.googleapis.com/toolresults/v1beta3/projects/id1%2F%20x/histories/id2%2F%20x/executions/id3%2F%20x/steps/id4%2F%20x/thumbnails?alt=json&fields=kind%2Cid&pageSize=7&pageToken=s-pagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"nextPageToken\":\"s-nextpagetoken\",\"thumbnails\":[{\"error\":{\"code\":7,\"message\":\"s-message\"},\"sourceImage\":{},\"stepId\":\"s-stepid\",\"thumbnail\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"heightPx\":7,\"widthPx\":7}}]}",
  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"thumbnails\":[{\"error\":{\"code\":7,\"message\":\"s-message\"},\"sourceImage\":{},\"stepId\":\"s-stepid\",\"thumbnail\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"heightPx\":7,\"widthPx\":7}}]}",
]

test "Go's toolresults.projects.histories.executions.steps.thumbnails.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"thumbnails\":[{\"error\":{\"code\":7,\"message\":\"s-message\"},\"sourceImage\":{},\"stepId\":\"s-stepid\",\"thumbnail\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"heightPx\":7,\"widthPx\":7}}]}")
  gv_note(f, "CALL toolresults.projects.histories.executions.steps.thumbnails.list")
  match svc.projects.histories.executions.steps.thumbnails.list("id1/ x", "id2/ x", "id3/ x", "id4/ x", options: ProjectsHistoriesExecutionsStepsThumbnailsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_34)
}

const GO_35: List[Str] = [
  "CALL toolresults.projects.histories.executions.steps.thumbnails.list pages",
  "REQ GET https://toolresults.googleapis.com/toolresults/v1beta3/projects/id1%2F%20x/histories/id2%2F%20x/executions/id3%2F%20x/steps/id4%2F%20x/thumbnails?alt=json&fields=kind%2Cid&pageSize=7&pageToken=s-pagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"nextPageToken\":\"s-nextpagetoken\",\"thumbnails\":[{\"error\":{\"code\":7,\"message\":\"s-message\"},\"sourceImage\":{},\"stepId\":\"s-stepid\",\"thumbnail\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"heightPx\":7,\"widthPx\":7}}]}",
  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"thumbnails\":[{\"error\":{\"code\":7,\"message\":\"s-message\"},\"sourceImage\":{},\"stepId\":\"s-stepid\",\"thumbnail\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"heightPx\":7,\"widthPx\":7}}]}",
  "REQ GET https://toolresults.googleapis.com/toolresults/v1beta3/projects/id1%2F%20x/histories/id2%2F%20x/executions/id3%2F%20x/steps/id4%2F%20x/thumbnails?alt=json&fields=kind%2Cid&pageSize=7&pageToken=s-nextpagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"thumbnails\":[{\"error\":{\"code\":7,\"message\":\"s-message\"},\"sourceImage\":{},\"stepId\":\"s-stepid\",\"thumbnail\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"heightPx\":7,\"widthPx\":7}}]}",
  "OUT: {\"thumbnails\":[{\"error\":{\"code\":7,\"message\":\"s-message\"},\"sourceImage\":{},\"stepId\":\"s-stepid\",\"thumbnail\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"heightPx\":7,\"widthPx\":7}}]}",
  "OUT: ok",
]

test "Go's toolresults.projects.histories.executions.steps.thumbnails.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"thumbnails\":[{\"error\":{\"code\":7,\"message\":\"s-message\"},\"sourceImage\":{},\"stepId\":\"s-stepid\",\"thumbnail\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"heightPx\":7,\"widthPx\":7}}]}")
  gv_queue(f, "{\"thumbnails\":[{\"error\":{\"code\":7,\"message\":\"s-message\"},\"sourceImage\":{},\"stepId\":\"s-stepid\",\"thumbnail\":{\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"heightPx\":7,\"widthPx\":7}}]}")
  gv_note(f, "CALL toolresults.projects.histories.executions.steps.thumbnails.list pages")
  var p = svc.projects.histories.executions.steps.thumbnails.list_pages("id1/ x", "id2/ x", "id3/ x", "id4/ x", options: ProjectsHistoriesExecutionsStepsThumbnailsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_35)
}
