  gv_note(f, "CALL toolresults.projects.histories.list pages")
  var p = svc.projects.histories.list_pages("id1/ x", options: ProjectsHistoriesListOptions{filter_by_name: Some("s-filterbyname"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
