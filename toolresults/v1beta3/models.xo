  /// ID of the screen for the suggestion. It is used for getting the corresponding screenshot path. For example, screen_id "1" corresponds to "1.png" file in GCS. Always set.
  pub screen_id as "screenId,omitempty": Str = ""
  /// Relative importance of a suggestion as compared with other suggestions that have the same priority and category. This is a meaningless value that can be used to order suggestions that are in the same category and have the same priority. The larger values have higher priority (i.e., are more important). Optional.
  pub secondary_priority as "secondaryPriority,omitempty": Float = 0.0
  /// Concise message, in the user's language, representing the suggestion, which may contain markup. Always set.
  pub short_message as "shortMessage,omitempty": SafeHtmlProto? = None
  /// General title for the suggestion, in the user's language, without markup. Always set.
  pub title as "title,omitempty": Str = ""
} derive Json

/// TestCase:
pub struct TestCase {
  /// The elapsed run time of the test case. Required.
  pub elapsed_time as "elapsedTime,omitempty": DurationModel? = None
  /// The end time of the test case.
  pub end_time as "endTime,omitempty": Timestamp? = None
  /// Why the test case was skipped. Present only for skipped test case
  pub skipped_message as "skippedMessage,omitempty": Str = ""
  /// The stack trace details if the test case failed or encountered an error. The maximum size of the stack traces is 100KiB, beyond which the stack track will be truncated. Zero if the test case passed.
  pub stack_traces as "stackTraces,omitempty": List[StackTrace] = []
  /// The start time of the test case.
  pub start_time as "startTime,omitempty": Timestamp? = None
  /// The status of the test case. Required.
  pub status as "status,omitempty": Str = ""
  /// A unique identifier within a Step for this Test Case.
  pub test_case_id as "testCaseId,omitempty": Str = ""
  /// Test case reference, e.g. name, class name and test suite name. Required.
  pub test_case_reference as "testCaseReference,omitempty": TestCaseReference? = None
  /// References to opaque files of any format output by the tool execution. @OutputOnly
  pub tool_outputs as "toolOutputs,omitempty": List[ToolOutputReference] = []
} derive Json

/// TestCaseReference: A reference to a test case. Test case references are canonically ordered lexicographically by these three factors: * First, by test_suite_name. * Second, by class_name. * Third, by name.
pub struct TestCaseReference {
  /// The name of the class.
  pub class_name as "className,omitempty": Str = ""
  /// The name of the test case. Required.
  pub name as "name,omitempty": Str = ""
  /// The name of the test suite to which this test case belongs.
  pub test_suite_name as "testSuiteName,omitempty": Str = ""
} derive Json

/// TestExecutionStep: A step that represents running tests. It accepts ant-junit xml files which will be parsed into structured test results by the service. Xml file paths are updated in order to append more files, however they can't be deleted. Users can also add test results manually by using the test_result field.
pub struct TestExecutionStep {
  /// Issues observed during the test execution. For example, if the mobile app under test crashed during the test, the error message and the stack trace content can be recorded here to assist debugging. - In response: present if set by create or update - In create/update request: optional
  pub test_issues as "testIssues,omitempty": List[TestIssue] = []
  /// List of test suite overview contents. This could be parsed from xUnit XML log by server, or uploaded directly by user. This references should only be called when test suites are fully parsed or uploaded. The maximum allowed number of test suite overviews per step is 1000. - In response: always set - In create request: optional - In update request: never (use publishXunitXmlFiles custom method instead)
  pub test_suite_overviews as "testSuiteOverviews,omitempty": List[TestSuiteOverview] = []
  /// The timing break down of the test execution. - In response: present if set by create or update - In create/update request: optional
  pub test_timing as "testTiming,omitempty": TestTiming? = None
  /// Represents the execution of the test runner. The exit code of this tool will be used to determine if the test passed. - In response: always set - In create/update request: optional
  pub tool_execution as "toolExecution,omitempty": ToolExecution? = None
} derive Json

/// TestIssue: An issue detected occurring during a test execution.
pub struct TestIssue {
  /// Category of issue. Required.
  pub category as "category,omitempty": Str = ""
  /// A brief human-readable message describing the issue. Required.
  pub error_message as "errorMessage,omitempty": Str = ""
  /// Severity of issue. Required.
  pub severity as "severity,omitempty": Str = ""
  /// Deprecated in favor of stack trace fields inside specific warnings.
  pub stack_trace as "stackTrace,omitempty": StackTrace? = None
  /// Type of issue. Required.
  pub type_ as "type,omitempty": Str = ""
  /// Warning message with additional details of the issue. Should always be a message from com.google.devtools.toolresults.v1.warnings
  pub warning_migration as "warning_migration,omitempty": Any? = None
} derive Json

/// TestSuiteOverview: A summary of a test suite result either parsed from XML or uploaded directly by a user. Note: the API related comments are for StepService only. This message is also being used in ExecutionService in a read only mode for the corresponding step.
pub struct TestSuiteOverview {
  /// Elapsed time of test suite.
  pub elapsed_time as "elapsedTime,omitempty": DurationModel? = None
  /// Number of test cases in error, typically set by the service by parsing the xml_source. - In create/response: always set - In update request: never
  pub error_count as "errorCount,omitempty": Int = 0
  /// Number of failed test cases, typically set by the service by parsing the xml_source. May also be set by the user. - In create/response: always set - In update request: never
  pub failure_count as "failureCount,omitempty": Int = 0
  /// Number of flaky test cases, set by the service by rolling up flaky test attempts. Present only for rollup test suite overview at environment level. A step cannot have flaky test cases.
  pub flaky_count as "flakyCount,omitempty": Int = 0
  /// The name of the test suite. - In create/response: always set - In update request: never
  pub name as "name,omitempty": Str = ""
  /// Number of test cases not run, typically set by the service by parsing the xml_source. - In create/response: always set - In update request: never
  pub skipped_count as "skippedCount,omitempty": Int = 0
  /// Number of test cases, typically set by the service by parsing the xml_source. - In create/response: always set - In update request: never
  pub total_count as "totalCount,omitempty": Int = 0
  /// If this test suite was parsed from XML, this is the URI where the original XML file is stored. Note: Multiple test suites can share the same xml_source Returns INVALID_ARGUMENT if the uri format is not supported. - In create/response: optional - In update request: never
  pub xml_source as "xmlSource,omitempty": FileReference? = None
} derive Json

/// TestTiming: Testing timing break down to know phases.
pub struct TestTiming {
  /// How long it took to run the test process. - In response: present if previously set. - In create/update request: optional
  pub test_process_duration as "testProcessDuration,omitempty": DurationModel? = None
} derive Json

/// Thumbnail: A single thumbnail, with its size and format.
pub struct Thumbnail {
  /// The thumbnail's content type, i.e. "image/png". Always set.
  pub content_type as "contentType,omitempty": Str = ""
  /// The thumbnail file itself. That is, the bytes here are precisely the bytes that make up the thumbnail file; they can be served as an image as-is (with the appropriate content type.) Always set.
  pub data as "data,omitempty": Str = ""
  /// The height of the thumbnail, in pixels. Always set.
  pub height_px as "heightPx,omitempty": Int = 0
  /// The width of the thumbnail, in pixels. Always set.
  pub width_px as "widthPx,omitempty": Int = 0
} derive Json

/// Timestamp: A Timestamp represents a point in time independent of any time zone or local calendar, encoded as a count of seconds and fractions of seconds at nanosecond resolution. The count is relative to an epoch at UTC midnight on January 1, 1970, in the proleptic Gregorian calendar which extends the Gregorian calendar backwards to year one. All minutes are 60 seconds long. Leap seconds are "smeared" so that no leap second table is needed for interpretation, using a [24-hour linear smear](https://developers.google.com/time/smear). The range is from 0001-01-01T00:00:00Z to 9999-12-31T23:59:59.999999999Z. By restricting to that range, we ensure that we can convert to and from [RFC 3339](https://www.ietf.org/rfc/rfc3339.txt) date strings.
pub struct Timestamp {
  /// Non-negative fractions of a second at nanosecond resolution. Negative second values with fractions must still have non-negative nanos values that count forward in time. Must be from 0 to 999,999,999 inclusive.
  pub nanos as "nanos,omitempty": Int = 0
  /// Represents seconds of UTC time since Unix epoch 1970-01-01T00:00:00Z. Must be from 0001-01-01T00:00:00Z to 9999-12-31T23:59:59Z inclusive.
  pub seconds as "seconds,omitempty,string": Int = 0
} derive Json

/// ToolExecution: An execution of an arbitrary tool. It could be a test runner or a tool copying artifacts or deploying code.
pub struct ToolExecution {
  /// The full tokenized command line including the program name (equivalent to argv in a C program). - In response: present if set by create request - In create request: optional - In update request: never set
  pub command_line_arguments as "commandLineArguments,omitempty": List[Str] = []
  /// Tool execution exit code. This field will be set once the tool has exited. - In response: present if set by create/update request - In create request: optional - In update request: optional, a FAILED_PRECONDITION error will be returned if an exit_code is already set.
  pub exit_code as "exitCode,omitempty": ToolExitCode? = None
  /// References to any plain text logs output the tool execution. This field can be set before the tool has exited in order to be able to have access to a live view of the logs while the tool is running. The maximum allowed number of tool logs per step is 1000. - In response: present if set by create/update request - In create request: optional - In update request: optional, any value provided will be appended to the existing list
  pub tool_logs as "toolLogs,omitempty": List[FileReference] = []
  /// References to opaque files of any format output by the tool execution. The maximum allowed number of tool outputs per step is 1000. - In response: present if set by create/update request - In create request: optional - In update request: optional, any value provided will be appended to the existing list
  pub tool_outputs as "toolOutputs,omitempty": List[ToolOutputReference] = []
} derive Json

/// ToolExecutionStep: Generic tool step to be used for binaries we do not explicitly support. For example: running cp to copy artifacts from one location to another.
pub struct ToolExecutionStep {
  /// A Tool execution. - In response: present if set by create/update request - In create/update request: optional
  pub tool_execution as "toolExecution,omitempty": ToolExecution? = None
} derive Json

/// ToolExitCode: Exit code from a tool execution.
pub struct ToolExitCode {
  /// Tool execution exit code. A value of 0 means that the execution was successful. - In response: always set - In create/update request: always set
  pub number as "number,omitempty": Int = 0
} derive Json

/// ToolOutputReference: A reference to a ToolExecution output file.
pub struct ToolOutputReference {
  /// The creation time of the file. - In response: present if set by create/update request - In create/update request: optional
  pub creation_time as "creationTime,omitempty": Timestamp? = None
  /// A FileReference to an output file. - In response: always set - In create/update request: always set
  pub output as "output,omitempty": FileReference? = None
  /// The test case to which this output file belongs. - In response: present if set by create/update request - In create/update request: optional
  pub test_case as "testCase,omitempty": TestCaseReference? = None
} derive Json

/// UIElementTooDeep: A warning that the screen hierarchy is deeper than the recommended threshold.
pub struct UIElementTooDeep {
  /// The depth of the screen element
  pub depth as "depth,omitempty": Int = 0
  /// The screen id of the element
  pub screen_id as "screenId,omitempty": Str = ""
  /// The screen state id of the element
  pub screen_state_id as "screenStateId,omitempty": Str = ""
} derive Json

/// UnspecifiedWarning: Default unspecified warning.
pub struct UnspecifiedWarning {} derive Json

/// UnusedRoboDirective: Additional details of an unused robodirective.
pub struct UnusedRoboDirective {
  /// The name of the resource that was unused.
  pub resource_name as "resourceName,omitempty": Str = ""
} derive Json

/// UpgradeInsight: This insight is a recommendation to upgrade a given library to the specified version, in order to avoid dependencies on non-SDK APIs.
pub struct UpgradeInsight {
  /// The name of the package to be upgraded.
  pub package_name as "packageName,omitempty": Str = ""
  /// The suggested version to upgrade to. Optional: In case we are not sure which version solves this problem
  pub upgrade_to_version as "upgradeToVersion,omitempty": Str = ""
} derive Json

/// UsedRoboDirective: Additional details of a used Robo directive.
pub struct UsedRoboDirective {
  /// The name of the resource that was used.
  pub resource_name as "resourceName,omitempty": Str = ""
} derive Json

/// UsedRoboIgnoreDirective: Additional details of a used Robo directive with an ignore action. Note: This is a different scenario than unused directive.
pub struct UsedRoboIgnoreDirective {
  /// The name of the resource that was ignored.
  pub resource_name as "resourceName,omitempty": Str = ""
} derive Json
