// What every generated call is built and sent with, as
// google.golang.org/api's internal/gensupport (BSD-3-Clause, Copyright
// (c) 2011 Google Inc.; NOTICE.md): the request headers, the send, the
// response check and its decoding.

use std/http
use std/json
use std/url
use github.com/xo-lang/gcp/auth
use github.com/xo-lang/gcp/googleapi
use github.com/xo-lang/gcp/option

/// This library's version, in its User-Agent.
pub const VERSION: Str = "0.3.0"

/// Why a call gave no result.
pub enum CallErr {
  /// The transport failed (connect, timeout, protocol).
  Http(e: http.ClientErr)
  /// The credentials gave no token.
  Auth(e: auth.AuthErr)
  /// The service answered with a status outside 2xx.
  Api(e: googleapi.ApiErr)
  /// The response body was not the result's JSON.
  Decode(msg: Str)
  /// No credentials, and authentication was not turned off.
  NoCredentials
  /// A media upload failed (Go's resumable upload errors).
  Upload(msg: Str)
}

pub fn (e: CallErr) display() -> Str {
  match e {
    Http(he) => he.display()
    Auth(ae) => ae.display()
    Api(ge) => ge.display()
    Decode(m) => m
    Upload(m) => m
    NoCredentials => "google: no credentials: pass option.ClientOptions.credentials, or set without_authentication"
  }
}

/// The client a service sends through.
pub struct Client[fx: Effects] {
  pub http: http.Client
  pub user_agent: Str
  pub api_key: Str = ""
  pub quota_project: Str = ""
  pub credentials: auth.TokenProvider[fx]? = None
  pub without_authentication: Bool = false
}

/// The client for `opts`.
pub fn new_client[fx: Effects](net: Net, opts: option.ClientOptions[fx]) -> Client[fx] {
  let ua = if opts.user_agent == "" { "xo-lang-gcp/${VERSION}" } else { "xo-lang-gcp/${VERSION} ${opts.user_agent}" }
  Client{http: http.client(net, opts.timeout), user_agent: ua, api_key: opts.api_key, quota_project: opts.quota_project, credentials: opts.credentials, without_authentication: opts.without_authentication}
}

/// One request a generated call makes.
pub struct Request {
  pub method: Str
  /// The URL, its path expanded (googleapi.expand), without the query.
  pub url: Str
  pub query: url.Values
  /// The call's own headers (If-None-Match, a body's Content-Type,
  /// the caller's extra headers), in order.
  pub headers: List[(Str, Str)] = []
  pub body: Bytes = b""
}

/// Sends `req` (Go's SendRequest, under the transport the options make):
/// the User-Agent and `x-goog-api-client` headers (SetHeaders), the
/// credentials' Authorization, the quota project, and the API key as the
/// `key` query parameter.
pub fn (c: Client[fx]) send(req: Request) -> http.Response ! CallErr uses (net.dial, clock, rand, fx) {
  var q = req.query
  if c.api_key != "" {
    q.set("key", c.api_key)
  }
  let qs = q.encode()
  let u = if qs == "" { req.url } else { "${req.url}?${qs}" }
  var hreq = http.new_request(req.method, u, {}, req.body)
  hreq = hreq.with_header("x-goog-api-client", "gl-xo/preview gdcl/${VERSION}")
  hreq = hreq.with_header("User-Agent", c.user_agent)
  for (k, v) in req.headers {
    hreq = hreq.with_header(k, v)
  }
  if c.quota_project != "" {
    hreq = hreq.with_header("X-Goog-User-Project", c.quota_project)
  }
  if !c.without_authentication {
    let p = c.credentials ?? return Err(CallErr.NoCredentials)
    let t = p.token() ?? e => return Err(CallErr.Auth(e))
    hreq = hreq.with_header("Authorization", auth.authorization(t))
  }
  hreq = hreq.with_header("Accept-Encoding", "identity")
  c.http.send(hreq) ?? e => Err(CallErr.Http(e))
}

/// `resp`'s error for a status outside 2xx (googleapi.CheckResponse).
pub fn check(resp: http.Response) -> () ! CallErr {
  match googleapi.check_response(resp) {
    Some(e) => Err(CallErr.Api(e))
    None => Ok(())
  }
}

/// `resp`'s error for a status outside 2xx, the body not parsed
/// (googleapi.CheckMediaResponse, for storage's downloads).
pub fn check_media(resp: http.Response) -> () ! CallErr {
  match googleapi.check_media_response(resp) {
    Some(e) => Err(CallErr.Api(e))
    None => Ok(())
  }
}

/// `resp`'s body as T (Go's DecodeResponse); an empty body (204) is T's
/// JSON `{}`.
pub fn decode[T: Json](resp: http.Response) -> T ! CallErr {
  let body = if resp.body.is_empty() || resp.status == 204 { b"{}" } else { resp.body }
  json.decode[T](body) ?? e => Err(CallErr.Decode(e.display()))
}

/// What a generated service and each of its resources share: the client
/// and the base path its requests resolve against.
pub struct Core[fx: Effects] {
  pub client: Client[fx]
  pub base_path: Str
}

/// The core for `opts`, `base_path` unless `opts.endpoint` names
/// another (Go's option.WithEndpoint).
pub fn new_core[fx: Effects](net: Net, opts: option.ClientOptions[fx], base_path: Str) -> Core[fx] {
  Core{client: new_client(net, opts), base_path: if opts.endpoint == "" { base_path } else { opts.endpoint }}
}

/// A request body as Go's googleapi.WithoutDataWrapper.JSONBuffer (or
/// WithDataWrapper's `{"data": ...}`) writes it: json.Encoder's text,
/// ending with a newline.
///
/// A model's `force_send_fields` and `null_fields` (decision 0013, Go's
/// ForceSendFields and NullFields) apply here: a forced field goes in
/// even when empty, a null field as `null`, and neither list reaches the
/// body. A level that names either list has its keys, and its values'
/// keys, in sorted order, as Go's map re-encoding writes them.
pub fn json_body[T: Json](v: T, data_wrapper: Bool = false, marks: json.Value? = None) -> Bytes {
  // marks: v's JSON with its models' force and null entries (body_mark,
  // decision 0013), given only when one is set
  let s = match marks {
    Some(mv) => apply_fields(mv).encode()
    None => json.encode_str(v)
  }
  if data_wrapper {
    // Go's `{"data": `, json.Encoder's text with its newline, then `}`
    return "{\"data\": ${s}\n}".bytes()
  }
  "${s}\n".bytes()
}

/// The keys a model's force_send_fields and null_fields have in its JSON
/// (decision 0013). Each entry is a field's JSON name, then for a field
/// that is not an Option `=` and its empty value's JSON (`attendees=[]`).
pub const FORCE_KEY: Str = "~forceSendFields"
pub const NULL_KEY: Str = "~nullFields"

fn entry_names(v: json.Value) -> List[Str] {
  match v {
    json.Value.List(items) => items.filter_map(fn(x: json.Value) -> Str? {
      match x {
        json.Value.Str(s) => Some(s)
        _ => None
      }
    })
    _ => []
  }
}

/// The key of an entry (`attendees=[]` -> `attendees`) and its empty
/// value's JSON, None for an Option field (Go never sends a nil pointer).
fn split_entry(e: Str) -> (Str, Str?) {
  match e.cut("=") {
    Some((k, z)) => (k, Some(z))
    None => (e, None)
  }
}

/// v's JSON as a Value through its text: json.encode_str's instance,
/// which json_body has for T anyway, not a json.to_value of each request
/// type (decision 0013's body_mark input).
pub fn body_value[T: Json](v: T) -> json.Value {
  json.parse_value(json.encode_str(v)).ok() ?? json.Value.Null
}

/// v, an object, with key's value replaced by f of it (a request model's
/// body_mark, decision 0013).
pub fn mark_field(v: json.Value, key: Str, f: fn(json.Value) -> json.Value) -> json.Value {
  match v {
    json.Value.Object(fields) => json.Value.Object(fields.map(fn(p: (Str, json.Value)) -> (Str, json.Value) {
      if p.0 == key { (p.0, f(p.1)) } else { p }
    }))
    _ => v
  }
}

/// v, a list, with each item replaced by f of its index and it.
pub fn mark_list(v: json.Value, f: fn(Int, json.Value) -> json.Value) -> json.Value {
  match v {
    json.Value.List(items) => {
      var out: List[json.Value] = []
      for x in items {
        out.push(f(out.len(), x))
      }
      json.Value.List(out)
    }
    _ => v
  }
}

/// v, an object of models, with each value replaced by f of its key and it.
pub fn mark_map(v: json.Value, f: fn(Str, json.Value) -> json.Value) -> json.Value {
  match v {
    json.Value.Object(fields) => json.Value.Object(fields.map(fn(p: (Str, json.Value)) -> (Str, json.Value) { (p.0, f(p.0, p.1)) }))
    _ => v
  }
}

/// v, a model's object, with its force and null entries as the keys
/// apply_fields reads, in place of any already there.
pub fn mark(v: json.Value, force: List[Str], nulls: List[Str]) -> json.Value {
  match v {
    json.Value.Object(fields) => {
      var out = fields.filter(fn(p: (Str, json.Value)) -> Bool { p.0 != FORCE_KEY && p.0 != NULL_KEY })
      if !force.is_empty() {
        out.push((FORCE_KEY, json.Value.List(force.map(fn(e: Str) -> json.Value { json.Value.Str(e) }))))
      }
      if !nulls.is_empty() {
        out.push((NULL_KEY, json.Value.List(nulls.map(fn(e: Str) -> json.Value { json.Value.Str(e) }))))
      }
      json.Value.Object(out)
    }
    _ => v
  }
}

/// v with every object's force and null lists applied and removed.
pub fn apply_fields(v: json.Value) -> json.Value {
  match v {
    json.Value.Object(fields) => {
      var force: List[Str] = []
      var nulls: List[Str] = []
      var out: List[(Str, json.Value)] = []
      for (k, x) in fields {
        if k == FORCE_KEY {
          force = entry_names(x)
        } else if k == NULL_KEY {
          nulls = entry_names(x)
        } else {
          out.push((k, apply_fields(x)))
        }
      }
      if force.is_empty() && nulls.is_empty() {
        return json.Value.Object(out)
      }
      let null_keys = nulls.map(fn(e: Str) -> Str { split_entry(e).0 })
      for e in force {
        let (key, zero) = split_entry(e)
        if null_keys.contains(key) || out.any(fn(p: (Str, json.Value)) -> Bool { p.0 == key }) {
          continue
        }
        if let Some(z) = zero {
          if let Ok(zv) = json.parse_value(z) {
            out.push((key, zv))
          }
        }
      }
      // a null field is null whatever its value (Go reports an error for a
      // non-empty one; a Go body never has both)
      for key in null_keys {
        out = out.filter(fn(p: (Str, json.Value)) -> Bool { p.0 != key })
        out.push((key, json.Value.Null))
      }
      sorted(json.Value.Object(out))
    }
    json.Value.List(items) => json.Value.List(items.map(apply_fields))
    _ => v
  }
}

/// v with every object's keys in byte order, all the way down.
fn sorted(v: json.Value) -> json.Value {
  match v {
    json.Value.Object(fields) => json.Value.Object(fields.map(fn(p: (Str, json.Value)) -> (Str, json.Value) { (p.0, sorted(p.1)) }).sort_by(fn(p: (Str, json.Value)) -> Str { p.0 }))
    json.Value.List(items) => json.Value.List(items.map(sorted))
    _ => v
  }
}

struct DataWrapper {
  data as "data": json.Value? = None
} derive Json

/// `resp`'s body as T under Go's data wrapper (`{"data": ...}`, the
/// Discovery feature `dataWrapper`).
pub fn decode_data[T: Json](resp: http.Response) -> T ! CallErr {
  // Go decodes into `{Data: ret}`: without `data` the result stays empty
  let w = decode[DataWrapper](resp)?
  let text = match w.data {
    Some(v) => v.encode()
    None => "{}"
  }
  json.decode_str[T](text) ?? e => Err(CallErr.Decode(e.display()))
}
