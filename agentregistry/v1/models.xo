pub struct Status {
  /// The status code, which should be an enum value of google.rpc.Code.
  pub code as "code,omitempty": Int = 0
  /// A list of messages that carry the error details. There is a common set of message types for APIs to use.
  pub details as "details,omitempty": List[json.Value] = []
  /// A developer-facing error message, which should be in English. Any user-facing error message should be localized and sent in the google.rpc.Status.details field, or localized by the client.
  pub message as "message,omitempty": Str = ""
} derive Json

/// Target: The target of the Binding.
pub struct Target {
  /// The identifier of the target Agent, MCP Server, or Endpoint. Format: * `urn:agent:{publisher}:{namespace}:{name}` * `urn:mcp:{publisher}:{namespace}:{name}` * `urn:endpoint:{publisher}:{namespace}:{name}`
  pub identifier as "identifier,omitempty": Str = ""
} derive Json

/// Tool: Represents a single tool provided by an MCP Server.
pub struct Tool {
  /// Output only. Protocol-level tool metadata conforming to MCP _meta specification. Output only.
  pub meta as "_meta,omitempty": json.Value? = None
  /// Output only. Annotations associated with the tool.
  pub annotations as "annotations,omitempty": Annotations? = None
  /// Output only. Description of what the tool does.
  pub description as "description,omitempty": Str = ""
  /// Output only. Human-readable name of the tool.
  pub name as "name,omitempty": Str = ""
} derive Json
