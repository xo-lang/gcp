  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"reports\":[{\"createTime\":\"s-createtime\",\"iacValidationReport\":{\"note\":\"s-note\"},\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}",
]

test "Go's securityposture.organizations.locations.reports.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"reports\":[{\"createTime\":\"s-createtime\",\"iacValidationReport\":{\"note\":\"s-note\"},\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL securityposture.organizations.locations.reports.list")
  match svc.organizations.locations.reports.list("id1/ x", options: OrganizationsLocationsReportsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_22)
}
