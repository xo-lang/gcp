  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: X509Extension) body_mark(v: json.Value) -> json.Value {
  var o = v
  if let Some(c) = m.object_id {
    o = gensupport.mark_field(o, "objectId", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  gensupport.mark(o, m.force_send_fields.map(x509_extension_field_entry), m.null_fields.map(x509_extension_field_entry))
}

/// X509Parameters: An X509Parameters is used to describe certain fields of an X.509 certificate, such as the key usage fields, fields specific to CA certificates, certificate policy extensions and custom extensions.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct X509Parameters {
  /// Optional. Describes custom X.509 extensions.
  pub additional_extensions as "additionalExtensions,omitempty": List[X509Extension] = []
  /// Optional. Describes Online Certificate Status Protocol (OCSP) endpoint addresses that appear in the "Authority Information Access" extension in the certificate.
  pub aia_ocsp_servers as "aiaOcspServers,omitempty": List[Str] = []
  /// Optional. Describes options in this X509Parameters that are relevant in a CA certificate. If not specified, a default basic constraints extension with `is_ca=false` will be added for leaf certificates.
  pub ca_options as "caOptions,omitempty": CaOptions? = None
  /// Optional. Indicates the intended use for keys that correspond to a certificate.
  pub key_usage as "keyUsage,omitempty": KeyUsage? = None
  /// Optional. Describes the X.509 name constraints extension.
  pub name_constraints as "nameConstraints,omitempty": NameConstraints? = None
  /// Optional. Describes the X.509 certificate policy object identifiers, per https://tools.ietf.org/html/rfc5280#section-4.2.1.4.
  pub policy_ids as "policyIds,omitempty": List[ObjectId] = []
  pub force_send_fields as "-": List[X509ParametersField] = []
  pub null_fields as "-": List[X509ParametersField] = []
} derive Json

/// X509ParametersField: X509Parameters's fields, for force_send_fields and null_fields.
pub enum X509ParametersField {
  AdditionalExtensions
  AiaOcspServers
  CaOptions
  KeyUsage
  NameConstraints
  PolicyIds
}

fn x509_parameters_field_entry(f: X509ParametersField) -> Str {
  match f {
    AdditionalExtensions => "additionalExtensions=[]"
    AiaOcspServers => "aiaOcspServers=[]"
    CaOptions => "caOptions"
    KeyUsage => "keyUsage"
    NameConstraints => "nameConstraints"
    PolicyIds => "policyIds=[]"
  }
}

/// body_marked: whether m, or a model in it, sets force_send_fields or
/// null_fields (decision 0013; the service's request bodies ask).
pub fn (m: X509Parameters) body_marked() -> Bool {
  if m.force_send_fields.len() > 0 || m.null_fields.len() > 0 {
    return true
  }
  for c in m.additional_extensions {
    if c.body_marked() {
      return true
    }
  }
  if let Some(c) = m.ca_options {
    if c.body_marked() {
      return true
    }
  }
  if let Some(c) = m.key_usage {
    if c.body_marked() {
      return true
    }
  }
  if let Some(c) = m.name_constraints {
    if c.body_marked() {
      return true
    }
  }
  for c in m.policy_ids {
    if c.body_marked() {
      return true
    }
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: X509Parameters) body_mark(v: json.Value) -> json.Value {
  var o = v
  o = gensupport.mark_field(o, "additionalExtensions", fn(x: json.Value) -> json.Value { gensupport.mark_list(x, fn(i: Int, e: json.Value) -> json.Value { m.additional_extensions[i].body_mark(e) }) })
  if let Some(c) = m.ca_options {
    o = gensupport.mark_field(o, "caOptions", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  if let Some(c) = m.key_usage {
    o = gensupport.mark_field(o, "keyUsage", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  if let Some(c) = m.name_constraints {
    o = gensupport.mark_field(o, "nameConstraints", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  o = gensupport.mark_field(o, "policyIds", fn(x: json.Value) -> json.Value { gensupport.mark_list(x, fn(i: Int, e: json.Value) -> json.Value { m.policy_ids[i].body_mark(e) }) })
  gensupport.mark(o, m.force_send_fields.map(x509_parameters_field_entry), m.null_fields.map(x509_parameters_field_entry))
}
