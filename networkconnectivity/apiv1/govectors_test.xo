  "  B {\"advertisedRoutes\":[\"s-advertisedroutes\"],\"autoAccept\":true,\"bandwidth\":\"s-bandwidth\",\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"generatedActivationKey\":\"s-generatedactivationkey\",\"hub\":\"s-hub\",\"labels\":{\"k1\":\"s-labels\"},\"mtuLimit\":7,\"name\":\"s-name\",\"network\":\"s-network\",\"peeringNetwork\":\"s-peeringnetwork\",\"providedActivationKey\":\"s-providedactivationkey\",\"pscRoutingEnabled\":true,\"remoteAccountId\":\"s-remoteaccountid\",\"remoteProfile\":\"s-remoteprofile\",\"stackType\":\"s-stacktype\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\"}",
  "",
  "  SERVED 200 {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}",
  "OUT: {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}",
]

test "Go's networkconnectivity.projects.locations.transports.patch" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}")
  gv_note(f, "CALL networkconnectivity.projects.locations.transports.patch")
  match svc.projects.locations.transports.patch("id1/ x", json.decode_str[Transport]("{\"advertisedRoutes\":[\"s-advertisedroutes\"],\"autoAccept\":true,\"bandwidth\":\"s-bandwidth\",\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"generatedActivationKey\":\"s-generatedactivationkey\",\"hub\":\"s-hub\",\"labels\":{\"k1\":\"s-labels\"},\"mtuLimit\":7,\"name\":\"s-name\",\"network\":\"s-network\",\"peeringNetwork\":\"s-peeringnetwork\",\"providedActivationKey\":\"s-providedactivationkey\",\"pscRoutingEnabled\":true,\"remoteAccountId\":\"s-remoteaccountid\",\"remoteProfile\":\"s-remoteprofile\",\"stackType\":\"s-stacktype\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\"}") ?? e => fault(e.display()), options: ProjectsLocationsTransportsPatchOptions{request_id: Some("s-requestid"), update_mask: Some("s-updatemask"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_131)
}
