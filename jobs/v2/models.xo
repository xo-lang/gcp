  /// Output only. The timestamp when this job was last updated.
  pub update_time as "updateTime,omitempty": Str = ""
  /// Optional. The visibility of the job. Defaults to JobVisibility.PRIVATE if not specified. Currently only JobVisibility.PRIVATE is supported.
  pub visibility as "visibility,omitempty": Str = ""
} derive Json

/// JobFilters: Input only. Deprecated. Use JobQuery instead. The filters required to perform a search query or histogram.
pub struct JobFilters {
