  /// Structured locations of the job, resolved from Job.addresses. locations are exactly matched to Job.addresses in the same order.
  pub locations as "locations,omitempty": List[Location] = []
} derive Json

/// JobEvent: An event issued when a job seeker interacts with the application that implements Cloud Talent Solution.
pub struct JobEvent {
