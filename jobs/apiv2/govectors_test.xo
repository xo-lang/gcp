  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"companies\":[{\"careerPageLink\":\"s-careerpagelink\",\"companySize\":\"s-companysize\",\"disableLocationOptimization\":true,\"displayName\":\"s-displayname\",\"distributorBillingCompanyId\":\"s-distributorbillingcompanyid\",\"distributorCompanyId\":\"s-distributorcompanyid\",\"eeoText\":\"s-eeotext\",\"hiringAgency\":true,\"hqLocation\":\"s-hqlocation\",\"imageUrl\":\"s-imageurl\",\"keywordSearchableCustomAttributes\":[\"s-keywordsearchablecustomattributes\"],\"keywordSearchableCustomFields\":[7],\"name\":\"s-name\",\"structuredCompanyHqLocation\":{\"locationType\":\"s-locationtype\",\"radiusMeters\":1.5},\"suspended\":true,\"title\":\"s-title\",\"website\":\"s-website\"}],\"metadata\":{\"experimentIdList\":[7],\"mode\":\"s-mode\",\"requestId\":\"s-requestid\"},\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"companies\":[{\"careerPageLink\":\"s-careerpagelink\",\"companySize\":\"s-companysize\",\"disableLocationOptimization\":true,\"displayName\":\"s-displayname\",\"distributorBillingCompanyId\":\"s-distributorbillingcompanyid\",\"distributorCompanyId\":\"s-distributorcompanyid\",\"eeoText\":\"s-eeotext\",\"hiringAgency\":true,\"hqLocation\":\"s-hqlocation\",\"imageUrl\":\"s-imageurl\",\"keywordSearchableCustomAttributes\":[\"s-keywordsearchablecustomattributes\"],\"keywordSearchableCustomFields\":[7],\"name\":\"s-name\",\"structuredCompanyHqLocation\":{\"locationType\":\"s-locationtype\",\"radiusMeters\":1.5},\"suspended\":true,\"title\":\"s-title\",\"website\":\"s-website\"}],\"metadata\":{\"experimentIdList\":[7],\"mode\":\"s-mode\",\"requestId\":\"s-requestid\"}}")
  gv_note(f, "CALL jobs.companies.list pages")
  var p = svc.companies.list_pages(options: CompaniesListOptions{must_have_open_jobs: Some(true), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_4)
}

