  gv_queue(f, "{\"jobs\":[{\"applicationEmailList\":[\"s-applicationemaillist\"],\"applicationInstruction\":\"s-applicationinstruction\",\"applicationUrls\":[\"s-applicationurls\"],\"benefits\":[\"s-benefits\"],\"companyDisplayName\":\"s-companydisplayname\",\"companyName\":\"s-companyname\",\"companyTitle\":\"s-companytitle\",\"compensationInfo\":{\"type\":\"s-type\"},\"createTime\":\"s-createtime\",\"department\":\"s-department\",\"description\":\"s-description\",\"distributorCompanyId\":\"s-distributorcompanyid\",\"educationLevels\":[\"s-educationlevels\"],\"employmentTypes\":[\"s-employmenttypes\"],\"endDate\":{\"day\":7,\"month\":7,\"year\":7},\"expireTime\":\"s-expiretime\",\"expiryDate\":{\"day\":7,\"month\":7,\"year\":7},\"extendedCompensationInfo\":{\"annualizedBaseCompensationUnspecified\":true,\"annualizedTotalCompensationUnspecified\":true,\"currency\":\"s-currency\"},\"incentives\":\"s-incentives\",\"jobTitle\":\"s-jobtitle\",\"languageCode\":\"s-languagecode\",\"level\":\"s-level\",\"locations\":[\"s-locations\"],\"name\":\"s-name\",\"promotionValue\":7,\"publishDate\":{\"day\":7,\"month\":7,\"year\":7},\"qualifications\":\"s-qualifications\",\"referenceUrl\":\"s-referenceurl\",\"region\":\"s-region\",\"requisitionId\":\"s-requisitionid\",\"responsibilities\":\"s-responsibilities\",\"startDate\":{\"day\":7,\"month\":7,\"year\":7},\"updateTime\":\"s-updatetime\",\"visibility\":\"s-visibility\"}],\"metadata\":{\"experimentIdList\":[7],\"mode\":\"s-mode\",\"requestId\":\"s-requestid\"}}")
  gv_note(f, "CALL jobs.jobs.list pages")
  var p = svc.jobs.list_pages(options: JobsListOptions{filter: Some("s-filter"), ids_only: Some(true), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_15)
}

