\"s-requestid\"},\"nextPageToken\":\"s-nextpagetoken\",\"numJobsFromBroadenedQuery\":7,\"spellResult\":{\"corrected\":true,\"correctedText\":\"s-correctedtext\"},\"totalSize\":\"7\"}")
  gv_queue(f, "{\"appliedCommuteFilter\":{\"allowNonStreetLevelAddress\":true,\"departureHourLocal\":7,\"method\":\"s-method\",\"roadTraffic\":\"s-roadtraffic\",\"startLocation\":{\"latitude\":1.5,\"longitude\":1.5},\"travelTime\":\"s-traveltime\"},\"appliedJobLocationFilters\":[{\"latLng\":{\"latitude\":1.5,\"longitude\":1.5},\"locationType\":\"s-locationtype\",\"postalAddress\":{\"administrativeArea\":\"s-administrativearea\",\"languageCode\":\"s-languagecode\",\"locality\":\"s-locality\",\"organization\":\"s-organization\",\"postalCode\":\"s-postalcode\",\"regionCode\":\"s-regioncode\",\"revision\":7,\"sortingCode\":\"s-sortingcode\",\"sublocality\":\"s-sublocality\"},\"radiusMeters\":1.5}],\"estimatedTotalSize\":\"7\",\"histogramResults\":{\"compensationHistogramResults\":[{\"type\":\"s-type\"}],\"customAttributeHistogramResults\":[{\"key\":\"s-key\"}],\"simpleHistogramResults\":[{\"searchType\":\"s-searchtype\"}]},\"jobView\":\"s-jobview\",\"matchingJobs\":[{\"commuteInfo\":{\"travelDuration\":\"s-travelduration\"},\"job\":{\"applicationInstruction\":\"s-applicationinstruction\",\"companyDisplayName\":\"s-companydisplayname\",\"companyName\":\"s-companyname\",\"companyTitle\":\"s-companytitle\",\"createTime\":\"s-createtime\",\"department\":\"s-department\",\"description\":\"s-description\",\"distributorCompanyId\":\"s-distributorcompanyid\",\"expireTime\":\"s-expiretime\",\"incentives\":\"s-incentives\",\"jobTitle\":\"s-jobtitle\",\"languageCode\":\"s-languagecode\",\"level\":\"s-level\",\"name\":\"s-name\",\"promotionValue\":7,\"qualifications\":\"s-qualifications\",\"referenceUrl\":\"s-referenceurl\",\"region\":\"s-region\",\"requisitionId\":\"s-requisitionid\",\"responsibilities\":\"s-responsibilities\",\"updateTime\":\"s-updatetime\",\"visibility\":\"s-visibility\"},\"jobSummary\":\"s-jobsummary\",\"jobTitleSnippet\":\"s-jobtitlesnippet\",\"searchTextSnippet\":\"s-searchtextsnippet\"}],\"metadata\":{\"experimentIdList\":[7],\"mode\":\"s-mode\",\"requestId\":\"s-requestid\"},\"numJobsFromBroadenedQuery\":7,\"spellResult\":{\"corrected\":true,\"correctedText\":\"s-correctedtext\"},\"totalSize\":\"7\"}")
  gv_note(f, "CALL jobs.jobs.searchForAlert pages")
  var p = svc.jobs.search_for_alert_pages(json.decode_str[SearchJobsRequest]("{\"disableRelevanceThresholding\":true,\"enableBroadening\":true,\"enablePreciseResultSize\":true,\"filters\":{\"categories\":[\"s-categories\"],\"commuteFilter\":{\"allowNonStreetLevelAddress\":true,\"departureHourLocal\":7,\"method\":\"s-method\",\"roadTraffic\":\"s-roadtraffic\",\"travelTime\":\"s-traveltime\"},\"companyNames\":[\"s-companynames\"],\"companyTitles\":[\"s-companytitles\"],\"compensationFilter\":{\"includeJobsWithUnspecifiedCompensationRange\":true,\"type\":\"s-type\",\"units\":[\"s-units\"]},\"customAttributeFilter\":\"s-customattributefilter\",\"customFieldFilters\":{\"k1\":{\"type\":\"s-type\"}},\"disableSpellCheck\":true,\"employmentTypes\":[\"s-employmenttypes\"],\"extendedCompensationFilter\":{\"compensationUnits\":[\"s-compensationunits\"],\"currency\":\"s-currency\",\"includeJobWithUnspecifiedCompensationRange\":true,\"type\":\"s-type\"},\"languageCodes\":[\"s-languagecodes\"],\"locationFilters\":[{\"distanceInMiles\":1.5,\"isTelecommute\":true,\"name\":\"s-name\",\"regionCode\":\"s-regioncode\"}],\"publishDateRange\":\"s-publishdaterange\",\"query\":\"s-query\",\"tenantJobOnly\":true},\"histogramFacets\":{\"compensationHistogramFacets\":[{\"type\":\"s-type\"}],\"customAttributeHistogramFacets\":[{\"key\":\"s-key\",\"stringValueHistogram\":true}],\"simpleHistogramFacets\":[\"s-simplehistogramfacets\"]},\"jobView\":\"s-jobview\",\"mode\":\"s-mode\",\"offset\":7,\"orderBy\":\"s-orderby\",\"pageSize\":7,\"pageToken\":\"s-pagetoken\",\"query\":{\"categories\":[\"s-categories\"],\"commuteFilter\":{\"allowNonStreetLevelAddress\":true,\"departureHourLocal\":7,\"method\":\"s-method\",\"roadTraffic\":\"s-roadtraffic\",\"travelTime\":\"s-traveltime\"},\"companyDisplayNames\":[\"s-companydisplaynames\"],\"companyNames\":[\"s-companynames\"],\"compensationFilter\":{\"includeJobsWithUnspecifiedCompensationRange\":true,\"type\":\"s-type\",\"units\":[\"s-units\"]},\"customAttributeFilter\":\"s-customattributefilter\",\"disableSpellCheck\":true,\"employmentTypes\":[\"s-employmenttypes\"],\"languageCodes\":[\"s-languagecodes\"],\"locationFilters\":[{\"distanceInMiles\":1.5,\"isTelecommute\":true,\"name\":\"s-name\",\"regionCode\":\"s-regioncode\"}],\"publishDateRange\":\"s-publishdaterange\",\"query\":\"s-query\"},\"requestMetadata\":{\"deviceInfo\":{\"deviceType\":\"s-devicetype\",\"id\":\"s-id\"},\"domain\":\"s-domain\",\"sessionId\":\"s-sessionid\",\"userId\":\"s-userid\"},\"sortBy\":\"s-sortby\"}") ?? e => fault(e.display()), options: JobsSearchForAlertOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_20)
}

const GO_21: List[Str] = [
  "CALL jobs.complete",
  "REQ GET https://jobs.googleapis.com/v2:complete?alt=json&companyName=s-companyname&fields=kind%2Cid&languageCode=s-languagecode&pageSize=7&prettyPrint=false&query=s-query&scope=s-scope&type=s-type",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"completionResults\":[{\"imageUrl\":\"s-imageurl\",\"suggestion\":\"s-suggestion\",\"type\":\"s-type\"}],\"metadata\":{\"experimentIdList\":[7],\"mode\":\"s-mode\",\"requestId\":\"s-requestid\"}}",
  "OUT: {\"completionResults\":[{\"imageUrl\":\"s-imageurl\",\"suggestion\":\"s-suggestion\",\"type\":\"s-type\"}],\"metadata\":{\"experimentIdList\":[7],\"mode\":\"s-mode\",\"requestId\":\"s-requestid\"}}",
]

test "Go's jobs.complete" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"completionResults\":[{\"imageUrl\":\"s-imageurl\",\"suggestion\":\"s-suggestion\",\"type\":\"s-type\"}],\"metadata\":{\"experimentIdList\":[7],\"mode\":\"s-mode\",\"requestId\":\"s-requestid\"}}")
  gv_note(f, "CALL jobs.complete")
  match svc.v2.complete(options: V2CompleteOptions{company_name: Some("s-companyname"), language_code: Some("s-languagecode"), page_size: Some(7), query: Some("s-query"), scope: Some("s-scope"), type_: Some("s-type"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_21)
}
