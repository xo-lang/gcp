  pub null_fields as "-": List[LatLngField] = []
} derive Json

/// LatLngField: LatLng's fields, for force_send_fields and null_fields.
pub enum LatLngField {
  Latitude
  Longitude
}

fn lat_lng_field_entry(f: LatLngField) -> Str {
  match f {
    Latitude => "latitude=0"
    Longitude => "longitude=0"
  }
}

/// body_marked: whether m, or a model in it, sets force_send_fields or
/// null_fields (decision 0013; the service's request bodies ask).
pub fn (m: LatLng) body_marked() -> Bool {
  if m.force_send_fields.len() > 0 || m.null_fields.len() > 0 {
    return true
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: LatLng) body_mark(v: json.Value) -> json.Value {
  var o = v
  gensupport.mark(o, m.force_send_fields.map(lat_lng_field_entry), m.null_fields.map(lat_lng_field_entry))
}

