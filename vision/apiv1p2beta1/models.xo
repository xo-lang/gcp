/// GoogleCloudVisionV1p2beta1AnnotateFileRequest: A request to annotate one single file, e.g. a PDF, TIFF or GIF file.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct GoogleCloudVisionV1p2beta1AnnotateFileRequest {
  /// Required. Requested features.
  pub features as "features,omitempty": List[GoogleCloudVisionV1p2beta1Feature] = []
  /// Additional context that may accompany the image(s) in the file.
  pub image_context as "imageContext,omitempty": GoogleCloudVisionV1p2beta1ImageContext? = None
  /// Required. Information about the input file.
  pub input_config as "inputConfig,omitempty": GoogleCloudVisionV1p2beta1InputConfig? = None
  /// Pages of the file to perform image annotation. Pages starts from 1, we assume the first page of the file is page 1. At most 5 pages are supported per request. Pages can be negative. Page 1 means the first page. Page 2 means the second page. Page -1 means the last page. Page -2 means the second to the last page. If the file is GIF instead of PDF or TIFF, page refers to GIF frames. If this field is empty, by default the service performs image annotation for the first 5 pages of the file.
  pub pages as "pages,omitempty": List[Int] = []
  pub force_send_fields as "-": List[GoogleCloudVisionV1p2beta1AnnotateFileRequestField] = []
  pub null_fields as "-": List[GoogleCloudVisionV1p2beta1AnnotateFileRequestField] = []
} derive Json

/// GoogleCloudVisionV1p2beta1AnnotateFileRequestField: GoogleCloudVisionV1p2beta1AnnotateFileRequest's fields, for force_send_fields and null_fields.
pub enum GoogleCloudVisionV1p2beta1AnnotateFileRequestField {
  Features
  ImageContext
  InputConfig
  Pages
}

fn google_cloud_vision_v1p2beta1_annotate_file_request_field_entry(f: GoogleCloudVisionV1p2beta1AnnotateFileRequestField) -> Str {
  match f {
    Features => "features=[]"
    ImageContext => "imageContext"
    InputConfig => "inputConfig"
    Pages => "pages=[]"
