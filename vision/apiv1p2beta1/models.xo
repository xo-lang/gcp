  /// The resource name of the reference image. Format is: `projects/PROJECT_ID/locations/LOC_ID/products/PRODUCT_ID/referenceImages/IMAGE_ID`. This field is ignored when creating a reference image.
  pub name as "name,omitempty": Str = ""
  /// Required. The Google Cloud Storage URI of the reference image. The URI must start with `gs://`.
  pub uri as "uri,omitempty": Str = ""
} derive Json

/// ResultModel: Information about a product.
pub struct ResultModel {
  /// The resource name of the image from the product that is the closest match to the query.
  pub image as "image,omitempty": Str = ""
  /// The Product.
  pub product as "product,omitempty": Product? = None
  /// A confidence level on the match, ranging from 0 (no confidence) to 1 (full confidence).
  pub score as "score,omitempty": Float = 0.0
} derive Json

/// SafeSearchAnnotation: Set of features pertaining to the image, computed by computer vision methods over safe-search verticals (for example, adult, spoof, medical, violence).
pub struct SafeSearchAnnotation {
  /// Represents the adult content likelihood for the image. Adult content may contain elements such as nudity, pornographic images or cartoons, or sexual activities.
  pub adult as "adult,omitempty": Str = ""
  /// Likelihood that this is a medical image.
  pub medical as "medical,omitempty": Str = ""
  /// Likelihood that the request image contains racy content. Racy content may include (but is not limited to) skimpy or sheer clothing, strategically covered nudity, lewd or provocative poses, or close-ups of sensitive body areas.
  pub racy as "racy,omitempty": Str = ""
  /// Spoof likelihood. The likelihood that an modification was made to the image's canonical version to make it appear funny or offensive.
  pub spoof as "spoof,omitempty": Str = ""
  /// Likelihood that this image contains violent content. Violent content may include death, serious harm, or injury to individuals or groups of individuals.
  pub violence as "violence,omitempty": Str = ""
} derive Json

/// Status: The `Status` type defines a logical error model that is suitable for different programming environments, including REST APIs and RPC APIs. It is used by [gRPC](https://github.com/grpc). Each `Status` message contains three pieces of data: error code, error message, and error details. You can find out more about this error model and how to work with it in the [API Design Guide](https://cloud.google.com/apis/design/errors).
pub struct Status {
  /// The status code, which should be an enum value of google.rpc.Code.
  pub code as "code,omitempty": Int = 0
  /// A list of messages that carry the error details. There is a common set of message types for APIs to use.
  pub details as "details,omitempty": List[json.Value] = []
  /// A developer-facing error message, which should be in English. Any user-facing error message should be localized and sent in the google.rpc.Status.details field, or localized by the client.
  pub message as "message,omitempty": Str = ""
} derive Json

/// Symbol: A single symbol representation.
pub struct Symbol {
  /// The bounding box for the symbol. The vertices are in the order of top-left, top-right, bottom-right, bottom-left. When a rotation of the bounding box is detected the rotation is represented as around the top-left corner as defined when the text is read in the 'natural' orientation. For example: * when the text is horizontal it might look like: 0----1 | | 3----2 * when it's rotated 180 degrees around the top-left corner it becomes: 2----3 | | 1----0 and the vertex order will still be (0, 1, 2, 3).
  pub bounding_box as "boundingBox,omitempty": BoundingPoly? = None
  /// Confidence of the OCR results for the symbol. Range [0, 1].
  pub confidence as "confidence,omitempty": Float = 0.0
  /// Additional information detected for the symbol.
  pub property as "property,omitempty": TextProperty? = None
  /// The actual UTF-8 representation of the symbol.
  pub text as "text,omitempty": Str = ""
} derive Json

/// TextAnnotation: TextAnnotation contains a structured representation of OCR extracted text. The hierarchy of an OCR extracted text structure is like this: TextAnnotation -> Page -> Block -> Paragraph -> Word -> Symbol Each structural component, starting from Page, may further have their own properties. Properties describe detected languages, breaks etc.. Please refer to the TextAnnotation.TextProperty message definition below for more detail.
pub struct TextAnnotation {
  /// List of pages detected by OCR.
  pub pages as "pages,omitempty": List[Page] = []
  /// UTF-8 text detected on the pages.
  pub text as "text,omitempty": Str = ""
} derive Json

/// TextProperty: Additional information detected on the structural component.
pub struct TextProperty {
  /// Detected start or end of a text segment.
  pub detected_break as "detectedBreak,omitempty": DetectedBreak? = None
  /// A list of detected languages together with confidence.
  pub detected_languages as "detectedLanguages,omitempty": List[DetectedLanguage] = []
} derive Json

/// Vertex: A vertex represents a 2D point in the image. NOTE: the vertex coordinates are in the same scale as the original image.
pub struct Vertex {
  /// X coordinate.
  pub x as "x,omitempty": Int = 0
  /// Y coordinate.
  pub y as "y,omitempty": Int = 0
} derive Json

/// WebDetection: Relevant information for the image from the Internet.
pub struct WebDetection {
  /// The service's best guess as to the topic of the request image. Inferred from similar images on the open web.
  pub best_guess_labels as "bestGuessLabels,omitempty": List[WebLabel] = []
  /// Fully matching images from the Internet. Can include resized copies of the query image.
  pub full_matching_images as "fullMatchingImages,omitempty": List[WebImage] = []
  /// Web pages containing the matching images from the Internet.
  pub pages_with_matching_images as "pagesWithMatchingImages,omitempty": List[WebPage] = []
  /// Partial matching images from the Internet. Those images are similar enough to share some key-point features. For example an original image will likely have partial matching for its crops.
  pub partial_matching_images as "partialMatchingImages,omitempty": List[WebImage] = []
  /// The visually similar image results.
  pub visually_similar_images as "visuallySimilarImages,omitempty": List[WebImage] = []
  /// Deduced entities from similar images on the Internet.
  pub web_entities as "webEntities,omitempty": List[WebEntity] = []
} derive Json

/// WebEntity: Entity deduced from similar images on the Internet.
pub struct WebEntity {
  /// Canonical description of the entity, in English.
  pub description as "description,omitempty": Str = ""
  /// Opaque entity ID.
  pub entity_id as "entityId,omitempty": Str = ""
  /// Overall relevancy score for the entity. Not normalized and not comparable across different image queries.
  pub score as "score,omitempty": Float = 0.0
} derive Json

/// WebImage: Metadata for online images.
pub struct WebImage {
  /// (Deprecated) Overall relevancy score for the image.
  pub score as "score,omitempty": Float = 0.0
  /// The result image URL.
  pub url as "url,omitempty": Str = ""
} derive Json

/// WebLabel: Label to provide extra metadata for the web detection.
pub struct WebLabel {
  /// Label for extra metadata.
  pub label as "label,omitempty": Str = ""
  /// The BCP-47 language code for `label`, such as "en-US" or "sr-Latn". For more information, see http://www.unicode.org/reports/tr35/#Unicode_locale_identifier.
  pub language_code as "languageCode,omitempty": Str = ""
} derive Json

/// WebPage: Metadata for web pages.
pub struct WebPage {
  /// Fully matching images on the page. Can include resized copies of the query image.
  pub full_matching_images as "fullMatchingImages,omitempty": List[WebImage] = []
  /// Title for the web page, may contain HTML markups.
  pub page_title as "pageTitle,omitempty": Str = ""
  /// Partial matching images on the page. Those images are similar enough to share some key-point features. For example an original image will likely have partial matching for its crops.
  pub partial_matching_images as "partialMatchingImages,omitempty": List[WebImage] = []
  /// (Deprecated) Overall relevancy score for the web page.
  pub score as "score,omitempty": Float = 0.0
  /// The result web page URL.
  pub url as "url,omitempty": Str = ""
} derive Json

/// Word: A word representation.
pub struct Word {
  /// The bounding box for the word. The vertices are in the order of top-left, top-right, bottom-right, bottom-left. When a rotation of the bounding box is detected the rotation is represented as around the top-left corner as defined when the text is read in the 'natural' orientation. For example: * when the text is horizontal it might look like: 0----1 | | 3----2 * when it's rotated 180 degrees around the top-left corner it becomes: 2----3 | | 1----0 and the vertex order will still be (0, 1, 2, 3).
  pub bounding_box as "boundingBox,omitempty": BoundingPoly? = None
  /// Confidence of the OCR results for the word. Range [0, 1].
  pub confidence as "confidence,omitempty": Float = 0.0
  /// Additional information detected for the word.
  pub property as "property,omitempty": TextProperty? = None
  /// List of symbols in the word. The order of the symbols follows the natural reading order.
  pub symbols as "symbols,omitempty": List[Symbol] = []
} derive Json
