test "Go's drivelabels.labels.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"labels\":[{\"appliedCapabilities\":{\"canApply\":true,\"canRead\":true,\"canRemove\":true},\"appliedLabelPolicy\":{\"copyMode\":\"s-copymode\"},\"createTime\":\"s-createtime\",\"creator\":{\"person\":\"s-person\"},\"customer\":\"s-customer\",\"disableTime\":\"s-disabletime\",\"disabler\":{\"person\":\"s-person\"},\"displayHints\":{\"disabled\":true,\"hiddenInSearch\":true,\"priority\":\"7\",\"shownInApply\":true},\"enabledAppSettings\":{},\"id\":\"s-id\",\"labelType\":\"s-labeltype\",\"learnMoreUri\":\"s-learnmoreuri\",\"lifecycle\":{\"hasUnpublishedChanges\":true,\"state\":\"s-state\"},\"lockStatus\":{\"locked\":true},\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"title\":\"s-title\"},\"publishTime\":\"s-publishtime\",\"publisher\":{\"person\":\"s-person\"},\"revisionCreateTime\":\"s-revisioncreatetime\",\"revisionCreator\":{\"person\":\"s-person\"},\"revisionId\":\"s-revisionid\",\"schemaCapabilities\":{\"canDelete\":true,\"canDisable\":true,\"canEnable\":true,\"canUpdate\":true}}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"labels\":[{\"appliedCapabilities\":{\"canApply\":true,\"canRead\":true,\"canRemove\":true},\"appliedLabelPolicy\":{\"copyMode\":\"s-copymode\"},\"createTime\":\"s-createtime\",\"creator\":{\"person\":\"s-person\"},\"customer\":\"s-customer\",\"disableTime\":\"s-disabletime\",\"disabler\":{\"person\":\"s-person\"},\"displayHints\":{\"disabled\":true,\"hiddenInSearch\":true,\"priority\":\"7\",\"shownInApply\":true},\"enabledAppSettings\":{},\"id\":\"s-id\",\"labelType\":\"s-labeltype\",\"learnMoreUri\":\"s-learnmoreuri\",\"lifecycle\":{\"hasUnpublishedChanges\":true,\"state\":\"s-state\"},\"lockStatus\":{\"locked\":true},\"name\":\"s-name\",\"properties\":{\"description\":\"s-description\",\"title\":\"s-title\"},\"publishTime\":\"s-publishtime\",\"publisher\":{\"person\":\"s-person\"},\"revisionCreateTime\":\"s-revisioncreatetime\",\"revisionCreator\":{\"person\":\"s-person\"},\"revisionId\":\"s-revisionid\",\"schemaCapabilities\":{\"canDelete\":true,\"canDisable\":true,\"canEnable\":true,\"canUpdate\":true}}]}")
  gv_note(f, "CALL drivelabels.labels.list pages")
  var p = svc.labels.list_pages(options: LabelsListOptions{customer: Some("s-customer"), language_code: Some("s-languagecode"), minimum_role: Some("s-minimumrole"), page_size: Some(7), page_token: Some("s-pagetoken"), published_only: Some(true), use_admin_access: Some(true), view: Some("s-view"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_7)
}

