test "Go's drivelabels.labels.locks.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"labelLocks\":[{\"capabilities\":{\"canViewPolicy\":true},\"choiceId\":\"s-choiceid\",\"createTime\":\"s-createtime\",\"creator\":{\"person\":\"s-person\"},\"deleteTime\":\"s-deletetime\",\"fieldId\":\"s-fieldid\",\"name\":\"s-name\",\"state\":\"s-state\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"labelLocks\":[{\"capabilities\":{\"canViewPolicy\":true},\"choiceId\":\"s-choiceid\",\"createTime\":\"s-createtime\",\"creator\":{\"person\":\"s-person\"},\"deleteTime\":\"s-deletetime\",\"fieldId\":\"s-fieldid\",\"name\":\"s-name\",\"state\":\"s-state\"}]}")
  gv_note(f, "CALL drivelabels.labels.locks.list pages")
  var p = svc.labels.locks.list_pages("id1/ x", options: LabelsLocksListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_13)
}

