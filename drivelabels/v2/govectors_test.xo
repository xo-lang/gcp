test "Go's drivelabels.limits.getLabel" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"fieldLimits\":{\"dateLimits\":{},\"integerLimits\":{\"maxValue\":\"7\",\"minValue\":\"7\"},\"longTextLimits\":{\"maxLength\":7,\"minLength\":7},\"maxDescriptionLength\":7,\"maxDisplayNameLength\":7,\"maxIdLength\":7,\"selectionLimits\":{\"maxChoices\":7,\"maxDeletedChoices\":7,\"maxDisplayNameLength\":7,\"maxIdLength\":7},\"textLimits\":{\"maxLength\":7,\"minLength\":7},\"userLimits\":{}},\"maxDeletedFields\":7,\"maxDescriptionLength\":7,\"maxDraftRevisions\":7,\"maxFields\":7,\"maxTitleLength\":7,\"name\":\"s-name\"}")
  gv_note(f, "CALL drivelabels.limits.getLabel")
  match svc.limits.get_label(options: LimitsGetLabelOptions{name: Some("s-name"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
