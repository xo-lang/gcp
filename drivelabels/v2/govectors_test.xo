}

const GO_30: List[Str] = [
  "CALL drivelabels.users.getCapabilities",
  "REQ GET https://drivelabels.googleapis.com/v2/id1/%20x?alt=json&customer=s-customer&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"canAccessLabelManager\":true,\"canAdministrateLabels\":true,\"canCreateAdminLabels\":true,\"canCreateSharedLabels\":true,\"name\":\"s-name\"}",
  "OUT: {\"canAccessLabelManager\":true,\"canAdministrateLabels\":true,\"canCreateAdminLabels\":true,\"canCreateSharedLabels\":true,\"name\":\"s-name\"}",
]

test "Go's drivelabels.users.getCapabilities" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"canAccessLabelManager\":true,\"canAdministrateLabels\":true,\"canCreateAdminLabels\":true,\"canCreateSharedLabels\":true,\"name\":\"s-name\"}")
  gv_note(f, "CALL drivelabels.users.getCapabilities")
  match svc.users.get_capabilities("id1/ x", options: UsersGetCapabilitiesOptions{customer: Some("s-customer"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_30)
}
