test "Go's adsenseplatform.platforms.accounts.sites.requestReview" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{}")
  gv_note(f, "CALL adsenseplatform.platforms.accounts.sites.requestReview")
  match svc.platforms.accounts.sites.request_review("id1/ x", options: PlatformsAccountsSitesRequestReviewOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_12)
}
