test "Go's agenciesandbrands.agencies.reports.results.fetchRows pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"dateRanges\":[{\"endDate\":{\"day\":7,\"month\":7,\"year\":7},\"startDate\":{\"day\":7,\"month\":7,\"year\":7}}],\"nextPageToken\":\"s-nextpagetoken\",\"rows\":[{}],\"runTime\":\"s-runtime\",\"totalRowCount\":7}")
  gv_queue(f, "{\"dateRanges\":[{\"endDate\":{\"day\":7,\"month\":7,\"year\":7},\"startDate\":{\"day\":7,\"month\":7,\"year\":7}}],\"rows\":[{}],\"runTime\":\"s-runtime\",\"totalRowCount\":7}")
  gv_note(f, "CALL agenciesandbrands.agencies.reports.results.fetchRows pages")
  var p = svc.agencies.reports.results.fetch_rows_pages("id1/ x", options: AgenciesReportsResultsFetchRowsOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_9)
}
