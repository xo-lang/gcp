/// Service: An individual service. A service contains a name and optional metadata. A service must exist before endpoints can be added to it.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct Service {
  /// Output only. The timestamp when the service was created.
  pub create_time as "createTime,omitempty": Str = ""
  /// Output only. Endpoints associated with this service. Returned on LookupService.ResolveService. Control plane clients should use RegistrationService.ListEndpoints.
  pub endpoints as "endpoints,omitempty": List[Endpoint] = []
  /// Optional. Metadata for the service. This data can be consumed by service clients. Restrictions: * The entire metadata dictionary may contain up to 2000 characters, spread accoss all key-value pairs. Metadata that goes beyond this limit are rejected * Valid metadata keys have two segments: an optional prefix and name, separated by a slash (/). The name segment is required and must be 63 characters or less, beginning and ending with an alphanumeric character ([a-z0-9A-Z]) with dashes (-), underscores (_), dots (.), and alphanumerics between. The prefix is optional. If specified, the prefix must be a DNS subdomain: a series of DNS labels separated by dots (.), not longer than 253 characters in total, followed by a slash (/). Metadata that fails to meet these requirements are rejected Note: This field is equivalent to the `annotations` field in the v1 API. They have the same syntax and read/write to the same location in Service Directory.
  pub metadata as "metadata,omitempty": Map[Str, Str] = {}
  /// Identifier. The resource name for the service in the format `projects/*/locations/*/namespaces/*/services/*`.
  pub name as "name,omitempty": Str = ""
  /// Output only. A globally unique identifier (in UUID4 format) for this service.
  pub uid as "uid,omitempty": Str = ""
  /// Output only. The timestamp when the service was last updated. Note: endpoints being created/deleted/updated within the service are not considered service updates for the purpose of this timestamp.
  pub update_time as "updateTime,omitempty": Str = ""
  pub force_send_fields as "-": List[ServiceField] = []
  pub null_fields as "-": List[ServiceField] = []
} derive Json

/// ServiceField: Service's fields, for force_send_fields and null_fields.
pub enum ServiceField {
  CreateTime
  Endpoints
  Metadata
  Name
  Uid
  UpdateTime
}

fn service_field_entry(f: ServiceField) -> Str {
  match f {
    CreateTime => "createTime=\"\""
    Endpoints => "endpoints=[]"
    Metadata => "metadata={}"
    Name => "name=\"\""
    Uid => "uid=\"\""
    UpdateTime => "updateTime=\"\""
  }
}

/// body_marked: whether m, or a model in it, sets force_send_fields or
/// null_fields (decision 0013; the service's request bodies ask).
pub fn (m: Service) body_marked() -> Bool {
  if m.force_send_fields.len() > 0 || m.null_fields.len() > 0 {
    return true
  }
  for c in m.endpoints {
    if c.body_marked() {
      return true
    }
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: Service) body_mark(v: json.Value) -> json.Value {
  var o = v
  o = gensupport.mark_field(o, "endpoints", fn(x: json.Value) -> json.Value { gensupport.mark_list(x, fn(i: Int, e: json.Value) -> json.Value { m.endpoints[i].body_mark(e) }) })
  gensupport.mark(o, m.force_send_fields.map(service_field_entry), m.null_fields.map(service_field_entry))
}

