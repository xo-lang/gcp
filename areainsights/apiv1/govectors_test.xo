use std/json

const GV_HOST: Str = "https://areainsights.googleapis.com"

const GO_0: List[Str] = [
  "CALL areainsights.computeInsights",
  "REQ POST https://areainsights.googleapis.com/v1:computeInsights?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"filter\":{\"locationFilter\":{},\"operatingStatus\":[\"s-operatingstatus\"],\"priceLevels\":[\"s-pricelevels\"],\"ratingFilter\":{\"maxRating\":1.5,\"minRating\":1.5},\"typeFilter\":{\"excludedPrimaryTypes\":[\"s-excludedprimarytypes\"],\"excludedTypes\":[\"s-excludedtypes\"],\"includedPrimaryTypes\":[\"s-includedprimarytypes\"],\"includedTypes\":[\"s-includedtypes\"]}},\"insights\":[\"s-insights\"]}",
  "",
  "  SERVED 200 {\"count\":\"7\",\"placeInsights\":[{\"place\":\"s-place\"}]}",
  "OUT: {\"count\":\"7\",\"placeInsights\":[{\"place\":\"s-place\"}]}",
]

test "Go's areainsights.computeInsights" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"count\":\"7\",\"placeInsights\":[{\"place\":\"s-place\"}]}")
  gv_note(f, "CALL areainsights.computeInsights")
  match svc.v1.compute_insights(json.decode_str[ComputeInsightsRequest]("{\"filter\":{\"locationFilter\":{},\"operatingStatus\":[\"s-operatingstatus\"],\"priceLevels\":[\"s-pricelevels\"],\"ratingFilter\":{\"maxRating\":1.5,\"minRating\":1.5},\"typeFilter\":{\"excludedPrimaryTypes\":[\"s-excludedprimarytypes\"],\"excludedTypes\":[\"s-excludedtypes\"],\"includedPrimaryTypes\":[\"s-includedprimarytypes\"],\"includedTypes\":[\"s-includedtypes\"]}},\"insights\":[\"s-insights\"]}") ?? e => fault(e.display()), options: V1ComputeInsightsOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
