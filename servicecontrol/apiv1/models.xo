  /// A set of user-defined (key, value) data that provides additional information about the moniotored resource that the log entry belongs to.
  pub monitored_resource_labels as "monitoredResourceLabels,omitempty": Map[Str, Str] = {}
  /// Required. The log to which this log entry belongs. Examples: `"syslog"`, `"book_log"`.
  pub name as "name,omitempty": Str = ""
  /// Optional. Information about an operation associated with the log entry, if applicable.
  pub operation as "operation,omitempty": V1LogEntryOperation? = None
  /// The log entry payload, represented as a protocol buffer that is expressed as a JSON object. The only accepted type currently is AuditLog.
  pub proto_payload as "protoPayload,omitempty": json.Value? = None
  /// The severity of the log entry. The default value is `LogSeverity.DEFAULT`.
  pub severity as "severity,omitempty": Str = ""
  /// Optional. Source code location information associated with the log entry, if any.
  pub source_location as "sourceLocation,omitempty": V1LogEntrySourceLocation? = None
  /// The log entry payload, represented as a structure that is expressed as a JSON object.
  pub struct_payload as "structPayload,omitempty": json.Value? = None
  /// The log entry payload, represented as a Unicode string (UTF-8).
  pub text_payload as "textPayload,omitempty": Str = ""
  /// The time the event described by the log entry occurred. If omitted, defaults to operation start time.
  pub timestamp as "timestamp,omitempty": Str = ""
  /// Optional. Resource name of the trace associated with the log entry, if any. If this field contains a relative resource name, you can assume the name is relative to `//tracing.googleapis.com`. Example: `projects/my-projectid/traces/06796866738c859f2f19b7cfb3214824`
  pub trace as "trace,omitempty": Str = ""
} derive Json

/// V1LogEntryOperation: Additional information about a potentially long-running operation with which a log entry is associated.
pub struct V1LogEntryOperation {
  /// Optional. Set this to True if this is the first log entry in the operation.
  pub first as "first,omitempty": Bool = false
  /// Optional. An arbitrary operation identifier. Log entries with the same identifier are assumed to be part of the same operation.
  pub id as "id,omitempty": Str = ""
  /// Optional. Set this to True if this is the last log entry in the operation.
  pub last as "last,omitempty": Bool = false
  /// Optional. An arbitrary producer identifier. The combination of `id` and `producer` must be globally unique. Examples for `producer`: `"MyDivision.MyBigCompany.com"`, `"github.com/MyProject/MyApplication"`.
  pub producer as "producer,omitempty": Str = ""
} derive Json

/// V1LogEntrySourceLocation: Additional information about the source code location that produced the log entry.
pub struct V1LogEntrySourceLocation {
  /// Optional. Source file name. Depending on the runtime environment, this might be a simple name or a fully-qualified name.
  pub file as "file,omitempty": Str = ""
  /// Optional. Human-readable name of the function or method being invoked, with optional context such as the class or package name. This information may be used in contexts such as the logs viewer, where a file and line number are less meaningful. The format can vary by language. For example: `qual.if.ied.Class.method` (Java), `dir/package.func` (Go), `function` (Python).
  pub function as "function,omitempty": Str = ""
  /// Optional. Line within the source file. 1-based; 0 indicates no line number available.
  pub line as "line,omitempty,string": Int = 0
} derive Json

/// V1ResourceEvent: Report v2 extension proto for passing the resource metadata associated with a resource create/update/delete/undelete event from ESF to Chemist. ResourceEvent proto should be serialized into the ReportRequest.operations.extensions.
pub struct V1ResourceEvent {
  /// The ESF unique context id of the api request, from which this resource event originated. This field is only needed for CAIS integration via api annotation. See go/cais-lro-delete for more details.
  pub context_id as "contextId,omitempty,string": Int = 0
  /// The destinations field determines which backend services should handle the event. This should be specified as a comma-delimited string.
  pub destinations as "destinations,omitempty": Str = ""
  /// The parent resource for the resource.
  pub parent as "parent,omitempty": Resource? = None
  /// The api path the resource event was created in. This should match the source of the `payload` field. For direct integrations with Chemist, this should generally be the RESPONSE. go/resource-event-pipeline-type
  pub path as "path,omitempty": Str = ""
  /// The payload contains metadata associated with the resource event. A ResourceEventPayloadStatus is provided instead if the original payload cannot be returned due to a limitation (e.g. size limit).
  pub payload as "payload,omitempty": json.Value? = None
  /// The resource associated with the event.
  pub resource as "resource,omitempty": Resource? = None
  /// The resource event type determines how the backend service should process the event.
  pub type_ as "type,omitempty": Str = ""
} derive Json

/// ViolationInfo: Provides information about the Policy violation info for this request.
pub struct ViolationInfo {
  /// Optional. Value that is being checked for the policy. This could be in encrypted form (if pii sensitive). This field will only be emitted in LIST_POLICY types
  pub checked_value as "checkedValue,omitempty": Str = ""
  /// Optional. Constraint name
  pub constraint as "constraint,omitempty": Str = ""
  /// Optional. Provides extra information for the specific violated constraint. See the constraint's documentation to determine if this field is populated and what the structure of the message should be.
  pub constraint_violation_info as "constraintViolationInfo,omitempty": json.Value? = None
  /// Optional. Error message that policy is indicating.
  pub error_message as "errorMessage,omitempty": Str = ""
  /// Optional. Indicates the type of the policy.
  pub policy_type as "policyType,omitempty": Str = ""
} derive Json
