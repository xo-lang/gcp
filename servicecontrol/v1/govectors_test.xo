// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://servicecontrol.googleapis.com"

const GO_0: List[Str] = [
  "CALL servicecontrol.services.allocateQuota",
  "REQ POST https://servicecontrol.googleapis.com/v1/services/id1%2F%20x:allocateQuota?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"allocateOperation\":{\"consumerId\":\"s-consumerid\",\"labels\":{\"k1\":\"s-labels\"},\"methodName\":\"s-methodname\",\"operationId\":\"s-operationid\",\"quotaMetrics\":[{\"metricName\":\"s-metricname\"}],\"quotaMode\":\"s-quotamode\"},\"serviceConfigId\":\"s-serviceconfigid\"}",
  "",
  "  SERVED 200 {\"allocateErrors\":[{\"code\":\"s-code\",\"description\":\"s-description\",\"status\":{\"code\":7,\"message\":\"s-message\"},\"subject\":\"s-subject\"}],\"allocateInfo\":{\"unusedArguments\":[\"s-unusedarguments\"]},\"operationId\":\"s-operationid\",\"quotaMetrics\":[{\"metricName\":\"s-metricname\"}],\"serviceConfigId\":\"s-serviceconfigid\"}",
  "OUT: {\"allocateErrors\":[{\"code\":\"s-code\",\"description\":\"s-description\",\"status\":{\"code\":7,\"message\":\"s-message\"},\"subject\":\"s-subject\"}],\"allocateInfo\":{\"unusedArguments\":[\"s-unusedarguments\"]},\"operationId\":\"s-operationid\",\"quotaMetrics\":[{\"metricName\":\"s-metricname\"}],\"serviceConfigId\":\"s-serviceconfigid\"}",
]

test "Go's servicecontrol.services.allocateQuota" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"allocateErrors\":[{\"code\":\"s-code\",\"description\":\"s-description\",\"status\":{\"code\":7,\"message\":\"s-message\"},\"subject\":\"s-subject\"}],\"allocateInfo\":{\"unusedArguments\":[\"s-unusedarguments\"]},\"operationId\":\"s-operationid\",\"quotaMetrics\":[{\"metricName\":\"s-metricname\"}],\"serviceConfigId\":\"s-serviceconfigid\"}")
  gv_note(f, "CALL servicecontrol.services.allocateQuota")
  match svc.services.allocate_quota("id1/ x", json.decode_str[AllocateQuotaRequest]("{\"allocateOperation\":{\"consumerId\":\"s-consumerid\",\"labels\":{\"k1\":\"s-labels\"},\"methodName\":\"s-methodname\",\"operationId\":\"s-operationid\",\"quotaMetrics\":[{\"metricName\":\"s-metricname\"}],\"quotaMode\":\"s-quotamode\"},\"serviceConfigId\":\"s-serviceconfigid\"}") ?? e => fault(e.display()), options: ServicesAllocateQuotaOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

