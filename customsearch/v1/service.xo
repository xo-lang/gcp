    q.set("rights", v)
  }
  if let Some(v) = options.safe {
    q.set("safe", v)
  }
  if let Some(v) = options.search_type {
    q.set("searchType", v)
  }
  if let Some(v) = options.site_search {
    q.set("siteSearch", v)
  }
  if let Some(v) = options.site_search_filter {
    q.set("siteSearchFilter", v)
  }
  if let Some(v) = options.snippet_length {
    q.set("snippetLength", "${v}")
  }
  if let Some(v) = options.sort {
    q.set("sort", v)
  }
  if let Some(v) = options.start {
    q.set("start", "${v}")
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "customsearch/v1/siterestrict"), {})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[Search](resp)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
  new_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
