const GV_HOST: Str = "https://www.googleapis.com"

const GO_0: List[Str] = [
  "CALL analytics.data.get",
  "REQ GET https://www.googleapis.com/analytics/v2.4/data?alt=json&dimensions=s-dimensions&end-date=s-end-date&fields=kind%2Cid&filters=s-filters&ids=s-ids&max-results=7&metrics=s-metrics&prettyPrint=false&segment=s-segment&sort=s-sort&start-date=s-start-date&start-index=7",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 ",
  "OUT: ok",
]

test "Go's analytics.data.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "")
  gv_note(f, "CALL analytics.data.get")
  match svc.data.get("s-ids", "s-start-date", "s-end-date", "s-metrics", options: DataGetOptions{dimensions: Some("s-dimensions"), filters: Some("s-filters"), max_results: Some(7), segment: Some("s-segment"), sort: Some("s-sort"), start_index: Some(7), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(_) => gv_note(f, "OUT: ok")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

