  gv_note(f, "CALL analytics.provisioning.createAccountTree")
  match svc.provisioning.create_account_tree(json.decode_str[AccountTreeRequest]("{\"accountName\":\"s-accountname\",\"kind\":\"s-kind\",\"profileName\":\"s-profilename\",\"timezone\":\"s-timezone\",\"webpropertyName\":\"s-webpropertyname\",\"websiteUrl\":\"s-websiteurl\"}") ?? e => fault(e.display()), options: ProvisioningCreateAccountTreeOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
