const GO_89: List[Str] = [
  "CALL analytics.userDeletion.userDeletionRequest.upsert",
  "REQ POST https://analytics.googleapis.com/analytics/v3/userDeletion/userDeletionRequests:upsert?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"deletionRequestTime\":\"s-deletionrequesttime\",\"firebaseProjectId\":\"s-firebaseprojectid\",\"id\":{\"type\":\"s-type\",\"userId\":\"s-userid\"},\"kind\":\"s-kind\",\"propertyId\":\"s-propertyid\",\"webPropertyId\":\"s-webpropertyid\"}",
  "",
  "  SERVED 200 {\"deletionRequestTime\":\"s-deletionrequesttime\",\"firebaseProjectId\":\"s-firebaseprojectid\",\"id\":{\"type\":\"s-type\",\"userId\":\"s-userid\"},\"kind\":\"s-kind\",\"propertyId\":\"s-propertyid\",\"webPropertyId\":\"s-webpropertyid\"}",
  "OUT: {\"deletionRequestTime\":\"s-deletionrequesttime\",\"firebaseProjectId\":\"s-firebaseprojectid\",\"id\":{\"type\":\"s-type\",\"userId\":\"s-userid\"},\"kind\":\"s-kind\",\"propertyId\":\"s-propertyid\",\"webPropertyId\":\"s-webpropertyid\"}",
]

test "Go's analytics.userDeletion.userDeletionRequest.upsert" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"deletionRequestTime\":\"s-deletionrequesttime\",\"firebaseProjectId\":\"s-firebaseprojectid\",\"id\":{\"type\":\"s-type\",\"userId\":\"s-userid\"},\"kind\":\"s-kind\",\"propertyId\":\"s-propertyid\",\"webPropertyId\":\"s-webpropertyid\"}")
  gv_note(f, "CALL analytics.userDeletion.userDeletionRequest.upsert")
  match svc.user_deletion.user_deletion_request.upsert(json.decode_str[UserDeletionRequest]("{\"deletionRequestTime\":\"s-deletionrequesttime\",\"firebaseProjectId\":\"s-firebaseprojectid\",\"id\":{\"type\":\"s-type\",\"userId\":\"s-userid\"},\"kind\":\"s-kind\",\"propertyId\":\"s-propertyid\",\"webPropertyId\":\"s-webpropertyid\"}") ?? e => fault(e.display()), options: UserDeletionUserDeletionRequestUpsertOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
