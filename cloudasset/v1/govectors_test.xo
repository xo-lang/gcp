test "Go's cloudasset.savedQueries.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"savedQueries\":[{\"content\":{},\"createTime\":\"s-createtime\",\"creator\":\"s-creator\",\"description\":\"s-description\",\"labels\":{\"k1\":\"s-labels\"},\"lastUpdateTime\":\"s-lastupdatetime\",\"lastUpdater\":\"s-lastupdater\",\"name\":\"s-name\"}]}")
  gv_queue(f, "{\"savedQueries\":[{\"content\":{},\"createTime\":\"s-createtime\",\"creator\":\"s-creator\",\"description\":\"s-description\",\"labels\":{\"k1\":\"s-labels\"},\"lastUpdateTime\":\"s-lastupdatetime\",\"lastUpdater\":\"s-lastupdater\",\"name\":\"s-name\"}]}")
  gv_note(f, "CALL cloudasset.savedQueries.list pages")
  var p = svc.saved_queries.list_pages("id1/ x", options: SavedQueriesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_13)
}

