test "Go's cloudasset.searchAllResources pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"results\":[{\"additionalAttributes\":{\"k\":\"v\"},\"assetType\":\"s-assettype\",\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"folders\":[\"s-folders\"],\"kmsKey\":\"s-kmskey\",\"kmsKeys\":[\"s-kmskeys\"],\"labels\":{\"k1\":\"s-labels\"},\"location\":\"s-location\",\"name\":\"s-name\",\"networkTags\":[\"s-networktags\"],\"organization\":\"s-organization\",\"parentAssetType\":\"s-parentassettype\",\"parentFullResourceName\":\"s-parentfullresourcename\",\"project\":\"s-project\",\"sccSecurityMarks\":{\"k1\":\"s-sccsecuritymarks\"},\"state\":\"s-state\",\"tagKeys\":[\"s-tagkeys\"],\"tagValueIds\":[\"s-tagvalueids\"],\"tagValues\":[\"s-tagvalues\"],\"updateTime\":\"s-updatetime\"}]}")
  gv_queue(f, "{\"results\":[{\"additionalAttributes\":{\"k\":\"v\"},\"assetType\":\"s-assettype\",\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"folders\":[\"s-folders\"],\"kmsKey\":\"s-kmskey\",\"kmsKeys\":[\"s-kmskeys\"],\"labels\":{\"k1\":\"s-labels\"},\"location\":\"s-location\",\"name\":\"s-name\",\"networkTags\":[\"s-networktags\"],\"organization\":\"s-organization\",\"parentAssetType\":\"s-parentassettype\",\"parentFullResourceName\":\"s-parentfullresourcename\",\"project\":\"s-project\",\"sccSecurityMarks\":{\"k1\":\"s-sccsecuritymarks\"},\"state\":\"s-state\",\"tagKeys\":[\"s-tagkeys\"],\"tagValueIds\":[\"s-tagvalueids\"],\"tagValues\":[\"s-tagvalues\"],\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL cloudasset.searchAllResources pages")
  var p = svc.v1.search_all_resources_pages("id1/ x", options: V1SearchAllResourcesOptions{asset_types: ["s-assettypes"], order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), query: Some("s-query"), read_mask: Some("s-readmask"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_30)
}
