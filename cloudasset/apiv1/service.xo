/// search_all_resources: Searches all Google Cloud resources within the specified scope, such as a project, folder, or organization. The caller must be granted the `cloudasset.assets.searchAllResources` permission on the desired scope, otherwise the request will be rejected.
/// (Go's cloudasset.searchAllResources.)
pub fn (r: V1Service[fx]) search_all_resources(scope: Str, options: V1SearchAllResourcesOptions = V1SearchAllResourcesOptions{}) -> SearchAllResourcesResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  for v in options.asset_types {
    q.add("assetTypes", v)
  }
  if let Some(v) = options.order_by {
    q.set("orderBy", v)
  }
  if let Some(v) = options.page_size {
    q.set("pageSize", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if let Some(v) = options.query {
    q.set("query", v)
  }
  if let Some(v) = options.read_mask {
    q.set("readMask", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v1/{+scope}:searchAllResources"), {"scope": scope})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[SearchAllResourcesResponse](resp)
}

/// V1SearchAllResourcesPages: the pages of V1Service.search_all_resources (Go's Pages).
/// Call next_page while more() is true.
pub struct V1SearchAllResourcesPages[fx: Effects] {
  r: V1Service[fx]
  scope: Str
  options: V1SearchAllResourcesOptions
  next_token: Str = ""
  started: Bool = false
}

/// search_all_resources_pages: V1Service.search_all_resources's pages, from the first.
pub fn (r: V1Service[fx]) search_all_resources_pages(scope: Str, options: V1SearchAllResourcesOptions = V1SearchAllResourcesOptions{}) -> V1SearchAllResourcesPages[fx] {
  V1SearchAllResourcesPages{r: r, scope: scope, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: V1SearchAllResourcesPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: V1SearchAllResourcesPages[fx]) next_page() -> SearchAllResourcesResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.search_all_resources(p.scope, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
