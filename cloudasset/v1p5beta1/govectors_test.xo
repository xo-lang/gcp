// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 cloudasset/v1p5beta1 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://cloudasset.googleapis.com"

const GO_0: List[Str] = [
  "CALL cloudasset.assets.list",
  "REQ GET https://cloudasset.googleapis.com/v1p5beta1/id1/%20x/assets?alt=json&assetTypes=s-assettypes&contentType=s-contenttype&fields=kind%2Cid&pageSize=7&pageToken=s-pagetoken&prettyPrint=false&readTime=s-readtime",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"assets\":[{\"accessLevel\":{\"description\":\"s-description\",\"name\":\"s-name\",\"title\":\"s-title\"},\"accessPolicy\":{\"etag\":\"s-etag\",\"name\":\"s-name\",\"parent\":\"s-parent\",\"title\":\"s-title\"},\"ancestors\":[\"s-ancestors\"],\"assetType\":\"s-assettype\",\"iamPolicy\":{\"etag\":\"YWI=\",\"version\":7},\"name\":\"s-name\",\"resource\":{\"data\":{\"k\":\"v\"},\"discoveryDocumentUri\":\"s-discoverydocumenturi\",\"discoveryName\":\"s-discoveryname\",\"parent\":\"s-parent\",\"resourceUrl\":\"s-resourceurl\",\"version\":\"s-version\"},\"servicePerimeter\":{\"description\":\"s-description\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"perimeterType\":\"s-perimetertype\",\"title\":\"s-title\",\"useExplicitDryRunSpec\":true}}],\"nextPageToken\":\"s-nextpagetoken\",\"readTime\":\"s-readtime\"}",
  "OUT: {\"assets\":[{\"accessLevel\":{\"description\":\"s-description\",\"name\":\"s-name\",\"title\":\"s-title\"},\"accessPolicy\":{\"etag\":\"s-etag\",\"name\":\"s-name\",\"parent\":\"s-parent\",\"title\":\"s-title\"},\"ancestors\":[\"s-ancestors\"],\"assetType\":\"s-assettype\",\"iamPolicy\":{\"etag\":\"YWI=\",\"version\":7},\"name\":\"s-name\",\"resource\":{\"data\":{\"k\":\"v\"},\"discoveryDocumentUri\":\"s-discoverydocumenturi\",\"discoveryName\":\"s-discoveryname\",\"parent\":\"s-parent\",\"resourceUrl\":\"s-resourceurl\",\"version\":\"s-version\"},\"servicePerimeter\":{\"description\":\"s-description\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"perimeterType\":\"s-perimetertype\",\"title\":\"s-title\",\"useExplicitDryRunSpec\":true}}],\"nextPageToken\":\"s-nextpagetoken\",\"readTime\":\"s-readtime\"}",
]

test "Go's cloudasset.assets.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"assets\":[{\"accessLevel\":{\"description\":\"s-description\",\"name\":\"s-name\",\"title\":\"s-title\"},\"accessPolicy\":{\"etag\":\"s-etag\",\"name\":\"s-name\",\"parent\":\"s-parent\",\"title\":\"s-title\"},\"ancestors\":[\"s-ancestors\"],\"assetType\":\"s-assettype\",\"iamPolicy\":{\"etag\":\"YWI=\",\"version\":7},\"name\":\"s-name\",\"resource\":{\"data\":{\"k\":\"v\"},\"discoveryDocumentUri\":\"s-discoverydocumenturi\",\"discoveryName\":\"s-discoveryname\",\"parent\":\"s-parent\",\"resourceUrl\":\"s-resourceurl\",\"version\":\"s-version\"},\"servicePerimeter\":{\"description\":\"s-description\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"perimeterType\":\"s-perimetertype\",\"title\":\"s-title\",\"useExplicitDryRunSpec\":true}}],\"nextPageToken\":\"s-nextpagetoken\",\"readTime\":\"s-readtime\"}")
  gv_note(f, "CALL cloudasset.assets.list")
  match svc.assets.list("id1/ x", options: AssetsListOptions{asset_types: ["s-assettypes"], content_type: Some("s-contenttype"), page_size: Some(7), page_token: Some("s-pagetoken"), read_time: Some("s-readtime"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
