  gv_queue(f, "{\"dbSystems\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"entitlementId\":\"s-entitlementid\",\"gcpOracleZone\":\"s-gcporaclezone\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"ociUrl\":\"s-ociurl\",\"odbNetwork\":\"s-odbnetwork\",\"odbSubnet\":\"s-odbsubnet\",\"properties\":{\"computeCount\":7,\"computeModel\":\"s-computemodel\",\"dataStorageSizeGb\":7,\"databaseEdition\":\"s-databaseedition\",\"domain\":\"s-domain\",\"hostname\":\"s-hostname\",\"hostnamePrefix\":\"s-hostnameprefix\",\"initialDataStorageSizeGb\":7,\"licenseModel\":\"s-licensemodel\",\"lifecycleState\":\"s-lifecyclestate\",\"memorySizeGb\":7,\"nodeCount\":7,\"ocid\":\"s-ocid\",\"privateIp\":\"s-privateip\",\"recoStorageSizeGb\":7,\"shape\":\"s-shape\"}}],\"unreachable\":[\"s-unreachable\"]}")
