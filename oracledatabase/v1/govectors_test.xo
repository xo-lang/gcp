  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"goldengateConnections\":[{\"createTime\":\"s-createtime\",\"entitlementId\":\"s-entitlementid\",\"gcpOracleZone\":\"s-gcporaclezone\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"ociUrl\":\"s-ociurl\",\"odbNetwork\":\"s-odbnetwork\",\"odbSubnet\":\"s-odbsubnet\",\"properties\":{\"connectionType\":\"s-connectiontype\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"lifecycleDetails\":\"s-lifecycledetails\",\"lifecycleState\":\"s-lifecyclestate\",\"ocid\":\"s-ocid\",\"routingMethod\":\"s-routingmethod\",\"updateTime\":\"s-updatetime\"}}],\"nextPageToken\":\"s-nextpagetoken\",\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"goldengateConnections\":[{\"createTime\":\"s-createtime\",\"entitlementId\":\"s-entitlementid\",\"gcpOracleZone\":\"s-gcporaclezone\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"ociUrl\":\"s-ociurl\",\"odbNetwork\":\"s-odbnetwork\",\"odbSubnet\":\"s-odbsubnet\",\"properties\":{\"connectionType\":\"s-connectiontype\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"lifecycleDetails\":\"s-lifecycledetails\",\"lifecycleState\":\"s-lifecyclestate\",\"ocid\":\"s-ocid\",\"routingMethod\":\"s-routingmethod\",\"updateTime\":\"s-updatetime\"}}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL oracledatabase.projects.locations.goldengateConnections.list pages")
  var p = svc.projects.locations.goldengate_connections.list_pages("id1/ x", options: ProjectsLocationsGoldengateConnectionsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_100)
}

