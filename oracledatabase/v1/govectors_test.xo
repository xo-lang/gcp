test "Go's oracledatabase.projects.locations.pluggableDatabases.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"pluggableDatabases\":[{\"createTime\":\"s-createtime\",\"name\":\"s-name\",\"ociUrl\":\"s-ociurl\",\"properties\":{\"compartmentId\":\"s-compartmentid\",\"containerDatabaseOcid\":\"s-containerdatabaseocid\",\"isRestricted\":true,\"lifecycleDetails\":\"s-lifecycledetails\",\"lifecycleState\":\"s-lifecyclestate\",\"ocid\":\"s-ocid\",\"operationsInsightsState\":\"s-operationsinsightsstate\",\"pdbName\":\"s-pdbname\"}}]}")
  gv_queue(f, "{\"pluggableDatabases\":[{\"createTime\":\"s-createtime\",\"name\":\"s-name\",\"ociUrl\":\"s-ociurl\",\"properties\":{\"compartmentId\":\"s-compartmentid\",\"containerDatabaseOcid\":\"s-containerdatabaseocid\",\"isRestricted\":true,\"lifecycleDetails\":\"s-lifecycledetails\",\"lifecycleState\":\"s-lifecyclestate\",\"ocid\":\"s-ocid\",\"operationsInsightsState\":\"s-operationsinsightsstate\",\"pdbName\":\"s-pdbname\"}}]}")
  gv_note(f, "CALL oracledatabase.projects.locations.pluggableDatabases.list pages")
  var p = svc.projects.locations.pluggable_databases.list_pages("id1/ x", options: ProjectsLocationsPluggableDatabasesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_140)
}
