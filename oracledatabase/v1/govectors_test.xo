test "Go's oracledatabase.projects.locations.databaseConnections.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"databaseConnections\":[{\"connectionString\":\"s-connectionstring\",\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"labels\":{\"k1\":\"s-labels\"},\"lifecycleDetails\":\"s-lifecycledetails\",\"name\":\"s-name\",\"odbNetwork\":\"s-odbnetwork\",\"passwordSecretVersion\":\"s-passwordsecretversion\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"username\":\"s-username\",\"walletSecretVersion\":\"s-walletsecretversion\"}],\"nextPageToken\":\"s-nextpagetoken\",\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"databaseConnections\":[{\"connectionString\":\"s-connectionstring\",\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"labels\":{\"k1\":\"s-labels\"},\"lifecycleDetails\":\"s-lifecycledetails\",\"name\":\"s-name\",\"odbNetwork\":\"s-odbnetwork\",\"passwordSecretVersion\":\"s-passwordsecretversion\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"username\":\"s-username\",\"walletSecretVersion\":\"s-walletsecretversion\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL oracledatabase.projects.locations.databaseConnections.list pages")
  var p = svc.projects.locations.database_connections.list_pages("id1/ x", options: ProjectsLocationsDatabaseConnectionsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_48)
}

