test "Go's logging.projects.metrics.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"metrics\":[{\"bucketName\":\"s-bucketname\",\"bucketOptions\":{},\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"disabled\":true,\"filter\":\"s-filter\",\"labelExtractors\":{\"k1\":\"s-labelextractors\"},\"metricDescriptor\":{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"launchStage\":\"s-launchstage\",\"metricKind\":\"s-metrickind\",\"name\":\"s-name\",\"type\":\"s-type\",\"unit\":\"s-unit\",\"valueType\":\"s-valuetype\"},\"name\":\"s-name\",\"resourceName\":\"s-resourcename\",\"updateTime\":\"s-updatetime\",\"valueExtractor\":\"s-valueextractor\",\"version\":\"s-version\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"metrics\":[{\"bucketName\":\"s-bucketname\",\"bucketOptions\":{},\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"disabled\":true,\"filter\":\"s-filter\",\"labelExtractors\":{\"k1\":\"s-labelextractors\"},\"metricDescriptor\":{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"launchStage\":\"s-launchstage\",\"metricKind\":\"s-metrickind\",\"name\":\"s-name\",\"type\":\"s-type\",\"unit\":\"s-unit\",\"valueType\":\"s-valuetype\"},\"name\":\"s-name\",\"resourceName\":\"s-resourcename\",\"updateTime\":\"s-updatetime\",\"valueExtractor\":\"s-valueextractor\",\"version\":\"s-version\"}]}")
  gv_note(f, "CALL logging.projects.metrics.list pages")
  var p = svc.projects.metrics.list_pages("id1/ x", options: ProjectsMetricsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_293)
}

