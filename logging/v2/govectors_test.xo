test "Go's logging.folders.locations.buckets.links.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"links\":[{\"bigqueryDataset\":{\"datasetId\":\"s-datasetid\"},\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"lifecycleState\":\"s-lifecyclestate\",\"name\":\"s-name\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"links\":[{\"bigqueryDataset\":{\"datasetId\":\"s-datasetid\"},\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"lifecycleState\":\"s-lifecyclestate\",\"name\":\"s-name\"}]}")
  gv_note(f, "CALL logging.folders.locations.buckets.links.list pages")
  var p = svc.folders.locations.buckets.links.list_pages("id1/ x", options: FoldersLocationsBucketsLinksListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_91)
}

