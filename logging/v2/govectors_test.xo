test "Go's logging.projects.sinks.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"sinks\":[{\"bigqueryOptions\":{\"usePartitionedTables\":true,\"usesTimestampColumnPartitioning\":true},\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"destination\":\"s-destination\",\"disabled\":true,\"filter\":\"s-filter\",\"includeChildren\":true,\"interceptChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"resourceName\":\"s-resourcename\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}]}")
  gv_queue(f, "{\"sinks\":[{\"bigqueryOptions\":{\"usePartitionedTables\":true,\"usesTimestampColumnPartitioning\":true},\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"destination\":\"s-destination\",\"disabled\":true,\"filter\":\"s-filter\",\"includeChildren\":true,\"interceptChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"resourceName\":\"s-resourcename\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}]}")
  gv_note(f, "CALL logging.projects.sinks.list pages")
  var p = svc.projects.sinks.list_pages("id1/ x", options: ProjectsSinksListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_299)
}

