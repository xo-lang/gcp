  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"entries\":[{\"apphub\":{},\"apphubDestination\":{},\"apphubSource\":{},\"httpRequest\":{\"cacheFillBytes\":\"7\",\"cacheHit\":true,\"cacheLookup\":true,\"cacheValidatedWithOriginServer\":true,\"latency\":\"s-latency\",\"protocol\":\"s-protocol\",\"referer\":\"s-referer\",\"remoteIp\":\"s-remoteip\",\"requestMethod\":\"s-requestmethod\",\"requestSize\":\"7\",\"requestUrl\":\"s-requesturl\",\"responseSize\":\"7\",\"serverIp\":\"s-serverip\",\"status\":7,\"userAgent\":\"s-useragent\"},\"insertId\":\"s-insertid\",\"jsonPayload\":{\"k\":\"v\"},\"labels\":{\"k1\":\"s-labels\"},\"logName\":\"s-logname\",\"metadata\":{\"systemLabels\":{\"k\":\"v\"}},\"operation\":{\"first\":true,\"id\":\"s-id\",\"last\":true,\"producer\":\"s-producer\"},\"otel\":{\"k\":\"v\"},\"protoPayload\":{\"k\":\"v\"},\"receiveTimestamp\":\"s-receivetimestamp\",\"resource\":{\"type\":\"s-type\"},\"severity\":\"s-severity\",\"sourceLocation\":{\"file\":\"s-file\",\"function\":\"s-function\",\"line\":\"7\"},\"spanId\":\"s-spanid\",\"split\":{\"index\":7,\"totalSplits\":7,\"uid\":\"s-uid\"},\"textPayload\":\"s-textpayload\",\"timestamp\":\"s-timestamp\",\"trace\":\"s-trace\",\"traceSampled\":true}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"entries\":[{\"apphub\":{},\"apphubDestination\":{},\"apphubSource\":{},\"httpRequest\":{\"cacheFillBytes\":\"7\",\"cacheHit\":true,\"cacheLookup\":true,\"cacheValidatedWithOriginServer\":true,\"latency\":\"s-latency\",\"protocol\":\"s-protocol\",\"referer\":\"s-referer\",\"remoteIp\":\"s-remoteip\",\"requestMethod\":\"s-requestmethod\",\"requestSize\":\"7\",\"requestUrl\":\"s-requesturl\",\"responseSize\":\"7\",\"serverIp\":\"s-serverip\",\"status\":7,\"userAgent\":\"s-useragent\"},\"insertId\":\"s-insertid\",\"jsonPayload\":{\"k\":\"v\"},\"labels\":{\"k1\":\"s-labels\"},\"logName\":\"s-logname\",\"metadata\":{\"systemLabels\":{\"k\":\"v\"}},\"operation\":{\"first\":true,\"id\":\"s-id\",\"last\":true,\"producer\":\"s-producer\"},\"otel\":{\"k\":\"v\"},\"protoPayload\":{\"k\":\"v\"},\"receiveTimestamp\":\"s-receivetimestamp\",\"resource\":{\"type\":\"s-type\"},\"severity\":\"s-severity\",\"sourceLocation\":{\"file\":\"s-file\",\"function\":\"s-function\",\"line\":\"7\"},\"spanId\":\"s-spanid\",\"split\":{\"index\":7,\"totalSplits\":7,\"uid\":\"s-uid\"},\"textPayload\":\"s-textpayload\",\"timestamp\":\"s-timestamp\",\"trace\":\"s-trace\",\"traceSampled\":true}]}")
  gv_note(f, "CALL logging.entries.list pages")
  var p = svc.entries.list_pages(json.decode_str[ListLogEntriesRequest]("{\"filter\":\"s-filter\",\"orderBy\":\"s-orderby\",\"pageSize\":7,\"pageToken\":\"s-pagetoken\",\"projectIds\":[\"s-projectids\"],\"resourceNames\":[\"s-resourcenames\"]}") ?? e => fault(e.display()), options: EntriesListOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_57)
}

