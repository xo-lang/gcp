test "Go's logging.locations.buckets.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"buckets\":[{\"analyticsEnabled\":true,\"cmekSettings\":{\"kmsKeyName\":\"s-kmskeyname\",\"kmsKeyVersionName\":\"s-kmskeyversionname\",\"name\":\"s-name\",\"serviceAccountId\":\"s-serviceaccountid\"},\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"lifecycleState\":\"s-lifecyclestate\",\"locked\":true,\"name\":\"s-name\",\"restrictedFields\":[\"s-restrictedfields\"],\"retentionDays\":7,\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"buckets\":[{\"analyticsEnabled\":true,\"cmekSettings\":{\"kmsKeyName\":\"s-kmskeyname\",\"kmsKeyVersionName\":\"s-kmskeyversionname\",\"name\":\"s-name\",\"serviceAccountId\":\"s-serviceaccountid\"},\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"lifecycleState\":\"s-lifecyclestate\",\"locked\":true,\"name\":\"s-name\",\"restrictedFields\":[\"s-restrictedfields\"],\"retentionDays\":7,\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL logging.locations.buckets.list pages")
  var p = svc.locations.buckets.list_pages("id1/ x", options: LocationsBucketsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_139)
}

