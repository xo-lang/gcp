  gv_set(f, "{\"exclusions\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"disabled\":true,\"filter\":\"s-filter\",\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"exclusions\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"disabled\":true,\"filter\":\"s-filter\",\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL logging.projects.exclusions.list pages")
  var p = svc.projects.exclusions.list_pages("id1/ x", options: ProjectsExclusionsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
