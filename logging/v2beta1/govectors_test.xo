  "REQ GET https://logging.googleapis.com/v2beta1/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}",
  "OUT: {\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}",
]

test "Go's logging.projects.sinks.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}")
  gv_note(f, "CALL logging.projects.sinks.get")
  match svc.projects.sinks.get("id1/ x", options: ProjectsSinksGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_13)
}

