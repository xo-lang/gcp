const GO_15: List[Str] = [
  "CALL logging.projects.sinks.list pages",
  "REQ GET https://logging.googleapis.com/v2beta1/id1/%20x/sinks?alt=json&fields=kind%2Cid&pageSize=7&pageToken=s-pagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"nextPageToken\":\"s-nextpagetoken\",\"sinks\":[{\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}]}",
  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"sinks\":[{\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}]}",
  "REQ GET https://logging.googleapis.com/v2beta1/id1/%20x/sinks?alt=json&fields=kind%2Cid&pageSize=7&pageToken=s-nextpagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"sinks\":[{\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}]}",
  "OUT: {\"sinks\":[{\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}]}",
  "OUT: ok",
]

test "Go's logging.projects.sinks.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"sinks\":[{\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}]}")
  gv_queue(f, "{\"sinks\":[{\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}]}")
  gv_note(f, "CALL logging.projects.sinks.list pages")
  var p = svc.projects.sinks.list_pages("id1/ x", options: ProjectsSinksListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_15)
}

const GO_16: List[Str] = [
  "CALL logging.projects.sinks.update",
  "REQ PUT https://logging.googleapis.com/v2beta1/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false&uniqueWriterIdentity=true&updateMask=s-updatemask",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}",
  "",
  "  SERVED 200 {\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}",
  "OUT: {\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}",
]

test "Go's logging.projects.sinks.update" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}")
  gv_note(f, "CALL logging.projects.sinks.update")
  match svc.projects.sinks.update("id1/ x", json.decode_str[LogSink]("{\"createTime\":\"s-createtime\",\"destination\":\"s-destination\",\"filter\":\"s-filter\",\"includeChildren\":true,\"name\":\"s-name\",\"outputVersionFormat\":\"s-outputversionformat\",\"updateTime\":\"s-updatetime\",\"writerIdentity\":\"s-writeridentity\"}") ?? e => fault(e.display()), options: ProjectsSinksUpdateOptions{unique_writer_identity: Some(true), update_mask: Some("s-updatemask"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_16)
}
