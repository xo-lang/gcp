  gv_queue(f, "{\"occurrences\":[{\"advisoryPublishTime\":\"s-advisorypublishtime\",\"aiSkillAnalysis\":{\"maxSeverity\":\"s-maxseverity\",\"skillName\":\"s-skillname\"},\"attestation\":{\"serializedPayload\":\"YWI=\"},\"build\":{\"provenanceBytes\":\"s-provenancebytes\"},\"compliance\":{\"nonComplianceReason\":\"s-noncompliancereason\"},\"createTime\":\"s-createtime\",\"deployment\":{\"address\":\"s-address\",\"config\":\"s-config\",\"deployTime\":\"s-deploytime\",\"platform\":\"s-platform\",\"undeployTime\":\"s-undeploytime\",\"userEmail\":\"s-useremail\"},\"discovery\":{\"analysisStatus\":\"s-analysisstatus\",\"archiveTime\":\"s-archivetime\",\"continuousAnalysis\":\"s-continuousanalysis\",\"cpe\":\"s-cpe\",\"lastScanTime\":\"s-lastscantime\",\"lastVulnerabilityUpdateTime\":\"s-lastvulnerabilityupdatetime\"},\"dsseAttestation\":{},\"envelope\":{\"payload\":\"YWI=\",\"payloadType\":\"s-payloadtype\"},\"image\":{\"baseResourceUrl\":\"s-baseresourceurl\",\"distance\":7},\"kind\":\"s-kind\",\"name\":\"s-name\",\"noteName\":\"s-notename\",\"package\":{\"architecture\":\"s-architecture\",\"cpeUri\":\"s-cpeuri\",\"name\":\"s-name\",\"packageType\":\"s-packagetype\"},\"remediation\":\"s-remediation\",\"resourceUri\":\"s-resourceuri\",\"sbomReference\":{\"payloadType\":\"s-payloadtype\"},\"secret\":{\"kind\":\"s-kind\"},\"updateTime\":\"s-updatetime\",\"upgrade\":{\"package\":\"s-package\"},\"vulnerability\":{\"cvssScore\":1.5,\"cvssVersion\":\"s-cvssversion\",\"effectiveSeverity\":\"s-effectiveseverity\",\"extraDetails\":\"s-extradetails\",\"fixAvailable\":true,\"longDescription\":\"s-longdescription\",\"severity\":\"s-severity\",\"shortDescription\":\"s-shortdescription\",\"type\":\"s-type\"}}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL containeranalysis.projects.occurrences.list pages")
  var p = svc.projects.occurrences.list_pages("id1/ x", options: ProjectsOccurrencesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), return_partial_success: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_45)
}

