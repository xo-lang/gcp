const GO_2: List[Str] = [
  "CALL containeranalysis.projects.locations.notes.delete",
  "REQ DELETE https://containeranalysis.googleapis.com/v1/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H x-extra=v1",
  "  B ",
  "  SERVED 200 {}",
  "OUT: {}",
]

test "Go's containeranalysis.projects.locations.notes.delete" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{}")
  gv_note(f, "CALL containeranalysis.projects.locations.notes.delete")
  match svc.projects.locations.notes.delete("id1/ x", options: ProjectsLocationsNotesDeleteOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_2)
}

