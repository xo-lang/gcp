  gv_queue(f, "{\"notes\":[{\"aiSkillAnalysis\":{},\"attestation\":{},\"build\":{\"builderVersion\":\"s-builderversion\"},\"compliance\":{\"description\":\"s-description\",\"impact\":\"s-impact\",\"rationale\":\"s-rationale\",\"remediation\":\"s-remediation\",\"scanInstructions\":\"YWI=\",\"title\":\"s-title\"},\"createTime\":\"s-createtime\",\"deployment\":{},\"discovery\":{\"analysisKind\":\"s-analysiskind\"},\"dsseAttestation\":{},\"expirationTime\":\"s-expirationtime\",\"image\":{\"resourceUrl\":\"s-resourceurl\"},\"kind\":\"s-kind\",\"longDescription\":\"s-longdescription\",\"name\":\"s-name\",\"package\":{\"architecture\":\"s-architecture\",\"cpeUri\":\"s-cpeuri\",\"description\":\"s-description\",\"maintainer\":\"s-maintainer\",\"name\":\"s-name\",\"packageType\":\"s-packagetype\",\"url\":\"s-url\"},\"relatedNoteNames\":[\"s-relatednotenames\"],\"sbomReference\":{\"format\":\"s-format\",\"version\":\"s-version\"},\"secret\":{},\"shortDescription\":\"s-shortdescription\",\"updateTime\":\"s-updatetime\",\"upgrade\":{\"package\":\"s-package\"},\"vulnerability\":{\"advisoryPublishTime\":\"s-advisorypublishtime\",\"cvssScore\":1.5,\"cvssVersion\":\"s-cvssversion\",\"severity\":\"s-severity\",\"sourceUpdateTime\":\"s-sourceupdatetime\"},\"vulnerabilityAssessment\":{\"languageCode\":\"s-languagecode\",\"longDescription\":\"s-longdescription\",\"shortDescription\":\"s-shortdescription\",\"title\":\"s-title\"}}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL containeranalysis.projects.locations.notes.list pages")
  var p = svc.projects.locations.notes.list_pages("id1/ x", options: ProjectsLocationsNotesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), return_partial_success: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_6)
}

