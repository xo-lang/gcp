  pub verdict as "verdict,omitempty": Str = ""
} derive Json

/// Material: Material is a material used in the generation of the provenance
pub struct Material {
  /// digest is a map from a hash algorithm (e.g. sha256) to the value in the material
  pub digest as "digest,omitempty": Map[Str, Str] = {}
  /// uri is the uri of the material
  pub uri as "uri,omitempty": Str = ""
} derive Json

/// Metadata: Other properties of the build.
pub struct Metadata {
  /// The timestamp of when the build completed.
  pub build_finished_on as "buildFinishedOn,omitempty": Str = ""
  /// Identifies the particular build invocation, which can be useful for finding associated logs or other ad-hoc analysis. The value SHOULD be globally unique, per in-toto Provenance spec.
  pub build_invocation_id as "buildInvocationId,omitempty": Str = ""
  /// The timestamp of when the build started.
  pub build_started_on as "buildStartedOn,omitempty": Str = ""
  /// Indicates that the builder claims certain fields in this message to be complete.
  pub completeness as "completeness,omitempty": Completeness? = None
  /// If true, the builder claims that running the recipe on materials will produce bit-for-bit identical output.
  pub reproducible as "reproducible,omitempty": Bool = false
} derive Json

/// NonCompliantFile: Details about files that caused a compliance check to fail.
pub struct NonCompliantFile {
  /// Command to display the non-compliant files.
  pub display_command as "displayCommand,omitempty": Str = ""
  /// display_command is a single command that can be used to display a list of non compliant files. When there is no such command, we can also iterate a list of non compliant file using 'path'. Empty if `display_command` is set.
  pub path as "path,omitempty": Str = ""
  /// Explains why a file is non compliant for a CIS check.
  pub reason as "reason,omitempty": Str = ""
} derive Json

/// Note: Provides a detailed description of a `Note`.
pub struct Note {
  /// A note describing an AI skill analysis.
