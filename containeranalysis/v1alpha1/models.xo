  /// A note describing something that can be deployed.
  pub deployable as "deployable,omitempty": Deployable? = None
  /// A note describing a provider/analysis type.
  pub discovery as "discovery,omitempty": Discovery? = None
  /// A note describing a dsse attestation note.
  pub dsse_attestation as "dsseAttestation,omitempty": DSSEAttestationNote? = None
  /// Time of expiration for this note, null if note does not expire.
  pub expiration_time as "expirationTime,omitempty": Str = ""
  /// Output only. This explicitly denotes which kind of note is specified. This field can be used as a filter in list requests.
  pub kind as "kind,omitempty": Str = ""
  /// A detailed description of this `Note`.
  pub long_description as "longDescription,omitempty": Str = ""
  /// The name of the note in the form "projects/{provider_project_id}/notes/{NOTE_ID}"
  pub name as "name,omitempty": Str = ""
  /// A note describing a package hosted by various package managers.
  pub package as "package,omitempty": Package? = None
  /// URLs associated with this note
  pub related_url as "relatedUrl,omitempty": List[RelatedUrl] = []
  /// A note describing a software bill of materials.
  pub sbom as "sbom,omitempty": DocumentNote? = None
  /// A note describing a reference to an SBOM.
  pub sbom_reference as "sbomReference,omitempty": SBOMReferenceNote? = None
  /// A note describing a secret.
  pub secret as "secret,omitempty": SecretNote? = None
  /// A one sentence description of this `Note`.
  pub short_description as "shortDescription,omitempty": Str = ""
  /// A note describing an SPDX File.
  pub spdx_file as "spdxFile,omitempty": FileNote? = None
  /// A note describing an SPDX Package.
  pub spdx_package as "spdxPackage,omitempty": PackageInfoNote? = None
  /// A note describing a relationship between SPDX elements.
  pub spdx_relationship as "spdxRelationship,omitempty": RelationshipNote? = None
  /// Output only. The time this note was last updated. This field can be used as a filter in list requests.
  pub update_time as "updateTime,omitempty": Str = ""
  /// A note describing an upgrade.
  pub upgrade as "upgrade,omitempty": UpgradeNote? = None
  /// A note describing a vulnerability assessment.
  pub vulnerability_assessment as "vulnerabilityAssessment,omitempty": VulnerabilityAssessmentNote? = None
  /// A package vulnerability type of note.
  pub vulnerability_type as "vulnerabilityType,omitempty": VulnerabilityType? = None
} derive Json

/// Occurrence: `Occurrence` includes information about analysis occurrences for an image.
pub struct Occurrence {
  /// This represents an AI skill analysis occurrence
  pub ai_skill_analysis as "aiSkillAnalysis,omitempty": AISkillAnalysisOccurrence? = None
  /// Describes an attestation of an artifact.
  pub attestation as "attestation,omitempty": Attestation? = None
  /// Build details for a verifiable build.
  pub build_details as "buildDetails,omitempty": BuildDetails? = None
  /// Describes whether or not a resource passes compliance checks.
  pub compliance as "compliance,omitempty": ComplianceOccurrence? = None
  /// Output only. The time this `Occurrence` was created.
  pub create_time as "createTime,omitempty": Str = ""
  /// Describes the deployment of an artifact on a runtime.
  pub deployment as "deployment,omitempty": Deployment? = None
  /// Describes how this resource derives from the basis in the associated note.
  pub derived_image as "derivedImage,omitempty": Derived? = None
  /// Describes the initial scan status for this resource.
  pub discovered as "discovered,omitempty": Discovered? = None
  /// This represents a DSSE attestation occurrence
  pub dsse_attestation as "dsseAttestation,omitempty": DSSEAttestationOccurrence? = None
  /// https://github.com/secure-systems-lab/dsse
  pub envelope as "envelope,omitempty": Envelope? = None
  /// Describes the installation of a package on the linked resource.
  pub installation as "installation,omitempty": Installation? = None
  /// Output only. This explicitly denotes which of the `Occurrence` details are specified. This field can be used as a filter in list requests.
  pub kind as "kind,omitempty": Str = ""
  /// Output only. The name of the `Occurrence` in the form "projects/{project_id}/occurrences/{OCCURRENCE_ID}"
  pub name as "name,omitempty": Str = ""
  /// An analysis note associated with this image, in the form "providers/{provider_id}/notes/{NOTE_ID}" This field can be used as a filter in list requests.
  pub note_name as "noteName,omitempty": Str = ""
  /// A description of actions that can be taken to remedy the `Note`
  pub remediation as "remediation,omitempty": Str = ""
  /// The resource for which the `Occurrence` applies.
  pub resource as "resource,omitempty": Resource? = None
  /// The unique URL of the image or the container for which the `Occurrence` applies. For example, https://gcr.io/project/image@sha256:foo This field can be used as a filter in list requests.
  pub resource_url as "resourceUrl,omitempty": Str = ""
  /// Describes a specific software bill of materials document.
  pub sbom as "sbom,omitempty": DocumentOccurrence? = None
  /// This represents an SBOM reference occurrence
  pub sbom_reference as "sbomReference,omitempty": SBOMReferenceOccurrence? = None
  /// This represents a secret occurrence
  pub secret as "secret,omitempty": SecretOccurrence? = None
  /// Describes a specific SPDX File.
  pub spdx_file as "spdxFile,omitempty": FileOccurrence? = None
  /// Describes a specific SPDX Package.
  pub spdx_package as "spdxPackage,omitempty": PackageInfoOccurrence? = None
  /// Describes a specific relationship between SPDX elements.
  pub spdx_relationship as "spdxRelationship,omitempty": RelationshipOccurrence? = None
  /// Output only. The time this `Occurrence` was last updated.
  pub update_time as "updateTime,omitempty": Str = ""
  /// Describes an upgrade.
  pub upgrade as "upgrade,omitempty": UpgradeOccurrence? = None
  /// Details of a security vulnerability note.
  pub vulnerability_details as "vulnerabilityDetails,omitempty": VulnerabilityDetails? = None
} derive Json

/// Operation: This resource represents a long-running operation that is the result of a network API call.
pub struct Operation {
  /// If the value is `false`, it means the operation is still in progress. If `true`, the operation is completed, and either `error` or `response` is available.
  pub done as "done,omitempty": Bool = false
  /// The error result of the operation in case of failure or cancellation.
  pub error as "error,omitempty": Status? = None
  /// Service-specific metadata associated with the operation. It typically contains progress information and common metadata such as create time. Some services might not provide such metadata. Any method that returns a long-running operation should document the metadata type, if any.
  pub metadata as "metadata,omitempty": json.Value? = None
  /// The server-assigned name, which is only unique within the same service that originally returns it. If you use the default HTTP mapping, the `name` should be a resource name ending with `operations/{unique_id}`.
  pub name as "name,omitempty": Str = ""
  /// The normal, successful response of the operation. If the original method returns no data on success, such as `Delete`, the response is `google.protobuf.Empty`. If the original method is standard `Get`/`Create`/`Update`, the response should be the resource. For other methods, the response should have the type `XxxResponse`, where `Xxx` is the original method name. For example, if the original method name is `TakeSnapshot()`, the inferred response type is `TakeSnapshotResponse`.
  pub response as "response,omitempty": json.Value? = None
} derive Json

/// Package: This represents a particular package that is distributed over various channels. e.g. glibc (aka libc6) is distributed by many, at various versions.
pub struct Package {
  /// The CPU architecture for which packages in this distribution channel were built. Architecture will be blank for language packages.
  pub architecture as "architecture,omitempty": Str = ""
  /// The cpe_uri in [CPE format](https://cpe.mitre.org/specification/) denoting the package manager version distributing a package. The cpe_uri will be blank for language packages.
  pub cpe_uri as "cpeUri,omitempty": Str = ""
  /// The description of this package.
  pub description as "description,omitempty": Str = ""
  /// Hash value, typically a file digest, that allows unique identification a specific package.
  pub digest as "digest,omitempty": List[Digest] = []
  /// The various channels by which a package is distributed.
  pub distribution as "distribution,omitempty": List[Distribution] = []
  /// Licenses that have been declared by the authors of the package.
  pub license as "license,omitempty": License? = None
  /// A freeform text denoting the maintainer of this package.
  pub maintainer as "maintainer,omitempty": Str = ""
  /// The name of the package.
  pub name as "name,omitempty": Str = ""
  /// The type of package; whether native or non native (e.g., ruby gems, node.js packages, etc.).
  pub package_type as "packageType,omitempty": Str = ""
  /// The homepage for this package.
  pub url as "url,omitempty": Str = ""
  /// The version of the package.
  pub version as "version,omitempty": Version? = None
} derive Json

/// PackageInfoNote: PackageInfoNote represents an SPDX Package Information section: https://spdx.github.io/spdx-spec/3-package-information/
pub struct PackageInfoNote {
  /// Indicates whether the file content of this package has been available for or subjected to analysis when creating the SPDX document
  pub analyzed as "analyzed,omitempty": Bool = false
  /// A place for the SPDX data creator to record, at the package level, acknowledgements that may be needed to be communicated in some contexts
  pub attribution as "attribution,omitempty": Str = ""
  /// Provide an independently reproducible mechanism that permits unique identification of a specific package that correlates to the data in this SPDX file
  pub checksum as "checksum,omitempty": Str = ""
  /// Identify the copyright holders of the package, as well as any dates present
  pub copyright as "copyright,omitempty": Str = ""
  /// A more detailed description of the package
  pub detailed_description as "detailedDescription,omitempty": Str = ""
  /// This section identifies the download Universal Resource Locator (URL), or a specific location within a version control system (VCS) for the package at the time that the SPDX file was created
  pub download_location as "downloadLocation,omitempty": Str = ""
  /// ExternalRef
  pub external_refs as "externalRefs,omitempty": List[ExternalRef] = []
  /// Contain the license the SPDX file creator has concluded as governing the This field is to contain a list of all licenses found in the package. The relationship between licenses (i.e., conjunctive, disjunctive) is not specified in this field – it is simply a listing of all licenses found
  pub files_license_info as "filesLicenseInfo,omitempty": List[Str] = []
  /// Provide a place for the SPDX file creator to record a web site that serves as the package's home page
  pub home_page as "homePage,omitempty": Str = ""
  /// List the licenses that have been declared by the authors of the package
  pub license_declared as "licenseDeclared,omitempty": License? = None
  /// If the package identified in the SPDX file originated from a different person or organization than identified as Package Supplier, this field identifies from where or whom the package originally came
  pub originator as "originator,omitempty": Str = ""
  /// The type of package: OS, MAVEN, GO, GO_STDLIB, etc.
  pub package_type as "packageType,omitempty": Str = ""
  /// A short description of the package
  pub summary_description as "summaryDescription,omitempty": Str = ""
  /// Identify the actual distribution source for the package/directory identified in the SPDX file
  pub supplier as "supplier,omitempty": Str = ""
  /// Identify the full name of the package as given by the Package Originator
  pub title as "title,omitempty": Str = ""
  /// This field provides an independently reproducible mechanism identifying specific contents of a package based on the actual files (except the SPDX file itself, if it is included in the package) that make up each package and that correlates to the data in this SPDX file
  pub verification_code as "verificationCode,omitempty": Str = ""
  /// Identify the version of the package
  pub version as "version,omitempty": Str = ""
} derive Json

/// PackageInfoOccurrence: PackageInfoOccurrence represents an SPDX Package Information section: https://spdx.github.io/spdx-spec/3-package-information/
pub struct PackageInfoOccurrence {
  /// A place for the SPDX file creator to record any general comments about the package being described
  pub comment as "comment,omitempty": Str = ""
  /// Provide the actual file name of the package, or path of the directory being treated as a package
  pub filename as "filename,omitempty": Str = ""
  /// Output only. Provide a place for the SPDX file creator to record a web site that serves as the package's home page
  pub home_page as "homePage,omitempty": Str = ""
  /// Uniquely identify any element in an SPDX document which may be referenced by other elements
  pub id as "id,omitempty": Str = ""
  /// package or alternative values, if the governing license cannot be determined
  pub license_concluded as "licenseConcluded,omitempty": License? = None
  /// Output only. The type of package: OS, MAVEN, GO, GO_STDLIB, etc.
  pub package_type as "packageType,omitempty": Str = ""
  /// Provide a place for the SPDX file creator to record any relevant background information or additional comments about the origin of the package
  pub source_info as "sourceInfo,omitempty": Str = ""
  /// Output only. A short description of the package
  pub summary_description as "summaryDescription,omitempty": Str = ""
  /// Output only. Identify the full name of the package as given by the Package Originator
  pub title as "title,omitempty": Str = ""
  /// Output only. Identify the version of the package
  pub version as "version,omitempty": Str = ""
} derive Json

