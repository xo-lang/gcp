  /// Output only. The CPU architecture for which packages in this distribution channel were built. Architecture will be blank for language packages.
  pub architecture as "architecture,omitempty": Str = ""
  /// Output only. The cpe_uri in [CPE format](https://cpe.mitre.org/specification/) denoting the package manager version distributing a package. The cpe_uri will be blank for language packages.
  pub cpe_uri as "cpeUri,omitempty": Str = ""
  /// Licenses that have been declared by the authors of the package.
  pub license as "license,omitempty": License? = None
  /// All of the places within the filesystem versions of this package have been found.
  pub location as "location,omitempty": List[Location] = []
  /// Output only. The name of the installed package.
  pub name as "name,omitempty": Str = ""
  /// Output only. The type of package; whether native or non native (e.g., ruby gems, node.js packages, etc.).
  pub package_type as "packageType,omitempty": Str = ""
  /// Output only. The version of the package.
  pub version as "version,omitempty": Version? = None
} derive Json

/// Justification: Justification provides the justification when the state of the assessment if NOT_AFFECTED.
pub struct Justification {
  /// Additional details on why this justification was chosen.
  pub details as "details,omitempty": Str = ""
  /// The justification type for this vulnerability.
  pub justification_type as "justificationType,omitempty": Str = ""
} derive Json

/// Layer: Layer holds metadata specific to a layer of a Docker image.
pub struct Layer {
  /// The recovered arguments to the Dockerfile directive.
  pub arguments as "arguments,omitempty": Str = ""
  /// The recovered Dockerfile directive used to construct this layer.
  pub directive as "directive,omitempty": Str = ""
} derive Json

/// LayerDetails: Details about the layer a package was found in.
pub struct LayerDetails {
  /// The base images the layer is found within.
  pub base_images as "baseImages,omitempty": List[BaseImage] = []
  /// The chain ID of the layer in the container image.
  pub chain_id as "chainId,omitempty": Str = ""
  /// The layer build command that was used to build the layer. This may not be found in all layers depending on how the container image is built.
  pub command as "command,omitempty": Str = ""
  /// The diff ID (sha256 hash) of the layer in the container image.
  pub diff_id as "diffId,omitempty": Str = ""
  /// The index of the layer in the container image.
  pub index as "index,omitempty": Int = 0
} derive Json

/// License: License information.
pub struct License {
  /// Comments
  pub comments as "comments,omitempty": Str = ""
  /// Often a single license can be used to represent the licensing terms. Sometimes it is necessary to include a choice of one or more licenses or some combination of license identifiers. Examples: "LGPL-2.1-only OR MIT", "LGPL-2.1-only AND MIT", "GPL-2.0-or-later WITH Bison-exception-2.2".
  pub expression as "expression,omitempty": Str = ""
} derive Json

