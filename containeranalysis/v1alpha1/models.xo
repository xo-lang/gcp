  /// Holds the MITRE standard Common Vulnerabilities and Exposures (CVE) tracking number for the vulnerability.
  pub cve as "cve,omitempty": Str = ""
  /// Contains information about the impact of this vulnerability, this will change with time.
  pub impacts as "impacts,omitempty": List[Str] = []
  /// Justification provides the justification when the state of the assessment if NOT_AFFECTED.
  pub justification as "justification,omitempty": Justification? = None
  /// The VulnerabilityAssessment note from which this VexAssessment was generated. This will be of the form: `projects/[PROJECT_ID]/notes/[NOTE_ID]`.
  pub note_name as "noteName,omitempty": Str = ""
  /// Holds a list of references associated with this vulnerability item and assessment. These uris have additional information about the vulnerability and the assessment itself. E.g. Link to a document which details how this assessment concluded the state of this vulnerability.
  pub related_uris as "relatedUris,omitempty": List[URI] = []
  /// Specifies details on how to handle (and presumably, fix) a vulnerability.
  pub remediations as "remediations,omitempty": List[Remediation] = []
  /// Provides the state of this Vulnerability assessment.
  pub state as "state,omitempty": Str = ""
  /// The vulnerability identifier for this Assessment. Will hold one of common identifiers e.g. CVE, GHSA etc.
  pub vulnerability_id as "vulnerabilityId,omitempty": Str = ""
} derive Json

/// Volume: Volume describes a Docker container volume which is mounted into build steps in order to persist files across build step execution. Next ID: 3
pub struct Volume {
  /// Name of the volume to mount. Volume names must be unique per build step and must be valid names for Docker volumes. Each named volume must be used by at least two build steps.
  pub name as "name,omitempty": Str = ""
  /// Path at which to mount the volume. Paths must be absolute and cannot conflict with other volume paths on the same build step or with certain reserved volume paths.
  pub path as "path,omitempty": Str = ""
} derive Json

/// VulnerabilityAssessmentNote: A single VulnerabilityAssessmentNote represents one particular product's vulnerability assessment for one CVE. Multiple VulnerabilityAssessmentNotes together form a Vex statement. Please go/sds-vex-example for a sample Vex statement in the CSAF format.
pub struct VulnerabilityAssessmentNote {
  /// Represents a vulnerability assessment for the product.
  pub assessment as "assessment,omitempty": Assessment? = None
  /// Identifies the language used by this document, corresponding to IETF BCP 47 / RFC 5646.
  pub language_code as "languageCode,omitempty": Str = ""
  /// A detailed description of this Vex.
  pub long_description as "longDescription,omitempty": Str = ""
  /// The product affected by this vex.
  pub product as "product,omitempty": Product? = None
  /// Publisher details of this Note.
  pub publisher as "publisher,omitempty": Publisher? = None
  /// A one sentence description of this Vex.
  pub short_description as "shortDescription,omitempty": Str = ""
  /// The title of the note. E.g. `Vex-Debian-11.4`
  pub title as "title,omitempty": Str = ""
} derive Json

/// VulnerabilityAttestation: The status of a vulnerability attestation generation.
pub struct VulnerabilityAttestation {
  /// Output only. If failure, the error reason for why the attestation generation failed.
  pub error as "error,omitempty": Str = ""
  /// Output only. The last time we attempted to generate an attestation.
  pub last_attempt_time as "lastAttemptTime,omitempty": Str = ""
  /// Output only. The success/failure state of the latest attestation attempt.
  pub state as "state,omitempty": Str = ""
} derive Json

/// VulnerabilityDetails: Used by Occurrence to point to where the vulnerability exists and how to fix it.
pub struct VulnerabilityDetails {
  /// Output only. The CVSS score of this vulnerability. CVSS score is on a scale of 0-10 where 0 indicates low severity and 10 indicates high severity.
  pub cvss_score as "cvssScore,omitempty": Float = 0.0
  /// The CVSS v2 score of this vulnerability.
  pub cvss_v2 as "cvssV2,omitempty": CVSS? = None
  /// The CVSS v3 score of this vulnerability.
  pub cvss_v3 as "cvssV3,omitempty": CVSS? = None
  /// Optional. The CVSS v4 score of this vulnerability.
  pub cvss_v4 as "cvssV4,omitempty": CVSS? = None
  /// Output only. CVSS version used to populate cvss_score and severity.
  pub cvss_version as "cvssVersion,omitempty": Str = ""
  /// The distro assigned severity for this vulnerability when that is available and note provider assigned severity when distro has not yet assigned a severity for this vulnerability. When there are multiple package issues for this vulnerability, they can have different effective severities because some might come from the distro and some might come from installed language packs (e.g. Maven JARs or Go binaries). For this reason, it is advised to use the effective severity on the PackageIssue level, as this field may eventually be deprecated. In the case where multiple PackageIssues have different effective severities, the one set here will be the highest severity of any of the PackageIssues.
  pub effective_severity as "effectiveSeverity,omitempty": Str = ""
  /// Occurrence-specific extra details about the vulnerability.
  pub extra_details as "extraDetails,omitempty": Str = ""
  /// The set of affected locations and their fixes (if available) within the associated resource.
  pub package_issue as "packageIssue,omitempty": List[PackageIssue] = []
  /// Risk information about the vulnerability, such as CISA, EPSS, etc.
  pub risk as "risk,omitempty": Risk? = None
  /// Output only. The note provider assigned Severity of the vulnerability.
  pub severity as "severity,omitempty": Str = ""
  /// The type of package; whether native or non native(ruby gems, node.js packages etc). This may be deprecated in the future because we can have multiple PackageIssues with different package types.
  pub type_ as "type,omitempty": Str = ""
  /// VexAssessment provides all publisher provided Vex information that is related to this vulnerability for this resource.
  pub vex_assessment as "vexAssessment,omitempty": VexAssessment? = None
} derive Json

/// VulnerabilityLocation: The location of the vulnerability
pub struct VulnerabilityLocation {
  /// The cpe_uri in [cpe format] (https://cpe.mitre.org/specification/) format. Examples include distro or storage location for vulnerable jar. This field can be used as a filter in list requests.
  pub cpe_uri as "cpeUri,omitempty": Str = ""
  /// The file location at which this package was found.
  pub file_location as "fileLocation,omitempty": List[FileLocation] = []
  /// The package being described.
  pub package as "package,omitempty": Str = ""
  /// The version of the package being described. This field can be used as a filter in list requests.
  pub version as "version,omitempty": Version? = None
} derive Json

/// VulnerabilityType: VulnerabilityType provides metadata about a security vulnerability.
pub struct VulnerabilityType {
  /// Time this advisory was published by the source.
  pub advisory_publish_time as "advisoryPublishTime,omitempty": Str = ""
  /// The CVSS score for this Vulnerability.
  pub cvss_score as "cvssScore,omitempty": Float = 0.0
  /// The full description of the CVSS for version 2.
  pub cvss_v2 as "cvssV2,omitempty": CVSS? = None
  /// Optional. The full description of the CVSS for version 4.
  pub cvss_v4 as "cvssV4,omitempty": CVSS? = None
  /// CVSS version used to populate cvss_score and severity.
  pub cvss_version as "cvssVersion,omitempty": Str = ""
  /// A list of CWE for this vulnerability. For details, see: https://cwe.mitre.org/index.html
  pub cwe as "cwe,omitempty": List[Str] = []
  /// All information about the package to specifically identify this vulnerability. One entry per (version range and cpe_uri) the package vulnerability has manifested in.
  pub details as "details,omitempty": List[Detail] = []
  /// Note provider assigned impact of the vulnerability
  pub severity as "severity,omitempty": Str = ""
} derive Json

/// WorkspacePolicyResult: Result of Workspace Policy scan.
pub struct WorkspacePolicyResult {
  /// Output only. State of the scan.
  pub scan_state as "scanState,omitempty": Str = ""
  /// Optional. Verdict of the scan.
  pub verdict as "verdict,omitempty": Str = ""
} derive Json
