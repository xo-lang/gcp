  /// The set of scan configs.
  pub scan_configs as "scanConfigs,omitempty": List[ScanConfig] = []
} derive Json

/// Location: An occurrence of a particular package installation found within a system's filesystem. e.g. glibc was found in /var/lib/dpkg/status
pub struct Location {
  /// Deprecated. The cpe_uri in [cpe format](https://cpe.mitre.org/specification/) denoting the package manager version distributing a package.
  pub cpe_uri as "cpeUri,omitempty": Str = ""
  /// The path from which we gathered that this package/version is installed.
  pub path as "path,omitempty": Str = ""
  /// Deprecated. The version installed at this location.
  pub version as "version,omitempty": Version? = None
} derive Json

