const GO_35: List[Str] = [
  "CALL containeranalysis.projects.occurrences.delete",
  "REQ DELETE https://containeranalysis.googleapis.com/v1beta1/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H x-extra=v1",
  "  B ",
  "  SERVED 200 {}",
  "OUT: {}",
]

test "Go's containeranalysis.projects.occurrences.delete" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{}")
  gv_note(f, "CALL containeranalysis.projects.occurrences.delete")
  match svc.projects.occurrences.delete("id1/ x", options: ProjectsOccurrencesDeleteOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_35)
}

