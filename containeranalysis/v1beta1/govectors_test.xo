  "OUT: {}",
]

test "Go's containeranalysis.projects.locations.occurrences.delete" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{}")
  gv_note(f, "CALL containeranalysis.projects.locations.occurrences.delete")
  match svc.projects.locations.occurrences.delete("id1/ x", options: ProjectsLocationsOccurrencesDeleteOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_12)
}

