test "Go's containeranalysis.projects.occurrences.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"occurrences\":[{\"aiSkillAnalysis\":{\"maxSeverity\":\"s-maxseverity\",\"skillName\":\"s-skillname\"},\"attestation\":{},\"build\":{\"provenanceBytes\":\"s-provenancebytes\"},\"createTime\":\"s-createtime\",\"deployment\":{},\"derivedImage\":{},\"discovered\":{},\"envelope\":{\"payload\":\"YWI=\",\"payloadType\":\"s-payloadtype\"},\"installation\":{},\"intoto\":{},\"kind\":\"s-kind\",\"name\":\"s-name\",\"noteName\":\"s-notename\",\"remediation\":\"s-remediation\",\"resource\":{\"name\":\"s-name\",\"uri\":\"s-uri\"},\"sbom\":{\"createTime\":\"s-createtime\",\"creatorComment\":\"s-creatorcomment\",\"documentComment\":\"s-documentcomment\",\"id\":\"s-id\",\"licenseListVersion\":\"s-licenselistversion\",\"namespace\":\"s-namespace\",\"title\":\"s-title\"},\"sbomReference\":{\"payloadType\":\"s-payloadtype\"},\"secret\":{\"kind\":\"s-kind\"},\"spdxFile\":{\"comment\":\"s-comment\",\"copyright\":\"s-copyright\",\"id\":\"s-id\",\"notice\":\"s-notice\"},\"spdxPackage\":{\"comment\":\"s-comment\",\"filename\":\"s-filename\",\"homePage\":\"s-homepage\",\"id\":\"s-id\",\"packageType\":\"s-packagetype\",\"sourceInfo\":\"s-sourceinfo\",\"summaryDescription\":\"s-summarydescription\",\"title\":\"s-title\",\"version\":\"s-version\"},\"spdxRelationship\":{\"comment\":\"s-comment\",\"source\":\"s-source\",\"target\":\"s-target\",\"type\":\"s-type\"},\"updateTime\":\"s-updatetime\",\"vulnerability\":{\"cvssScore\":1.5,\"cvssVersion\":\"s-cvssversion\",\"effectiveSeverity\":\"s-effectiveseverity\",\"extraDetails\":\"s-extradetails\",\"longDescription\":\"s-longdescription\",\"severity\":\"s-severity\",\"shortDescription\":\"s-shortdescription\",\"type\":\"s-type\"}}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL containeranalysis.projects.occurrences.list")
  match svc.projects.occurrences.list("id1/ x", options: ProjectsOccurrencesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), return_partial_success: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_40)
}

