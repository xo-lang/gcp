  pub discovery_occurrence_id as "discoveryOccurrenceId,omitempty": Str = ""
} derive Json

/// Expr: Represents a textual expression in the Common Expression Language (CEL) syntax. CEL is a C-like expression language. The syntax and semantics of CEL are documented at https://github.com/google/cel-spec. Example (Comparison): title: "Summary size limit" description: "Determines if a summary is less than 100 chars" expression: "document.summary.size() < 100" Example (Equality): title: "Requestor is owner" description: "Determines if requestor is the document owner" expression: "document.owner == request.auth.claims.email" Example (Logic): title: "Public documents" description: "Determine whether the document should be publicly visible" expression: "document.type != 'private' && document.type != 'internal'" Example (Data Manipulation): title: "Notification string" description: "Create a notification string with a timestamp." expression: "'New message received at ' + string(document.create_time)" The exact variables and functions that may be referenced within an expression are determined by the service that evaluates it. See the service documentation for additional information.
pub struct Expr {
  /// Optional. Description of the expression. This is a longer text which describes the expression, e.g. when hovered over it in a UI.
  pub description as "description,omitempty": Str = ""
  /// Textual representation of an expression in Common Expression Language syntax.
  pub expression as "expression,omitempty": Str = ""
  /// Optional. String indicating the location of the expression for error reporting, e.g. a file name and a position in the file.
  pub location as "location,omitempty": Str = ""
  /// Optional. Title for the expression, i.e. a short string describing its purpose. This can be used e.g. in UIs which allow to enter the expression.
  pub title as "title,omitempty": Str = ""
} derive Json

/// ExternalRef: An External Reference allows a Package to reference an external source of additional information, metadata, enumerations, asset identifiers, or downloadable content believed to be relevant to the Package
pub struct ExternalRef {
  /// An External Reference allows a Package to reference an external source of additional information, metadata, enumerations, asset identifiers, or downloadable content believed to be relevant to the Package
  pub category as "category,omitempty": Str = ""
  /// Human-readable information about the purpose and target of the reference
  pub comment as "comment,omitempty": Str = ""
  /// The unique string with no spaces necessary to access the package-specific information, metadata, or content within the target location
  pub locator as "locator,omitempty": Str = ""
  /// Type of category (e.g. 'npm' for the PACKAGE_MANAGER category)
  pub type_ as "type,omitempty": Str = ""
} derive Json

