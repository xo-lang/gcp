  /// The CPU architecture for which packages in this distribution channel were built.
  pub architecture as "architecture,omitempty": Str = ""
  /// Required. The cpe_uri in [CPE format](https://cpe.mitre.org/specification/) denoting the package manager version distributing a package.
  pub cpe_uri as "cpeUri,omitempty": Str = ""
  /// The distribution channel-specific description of this package.
  pub description as "description,omitempty": Str = ""
  /// The latest available version of this package in this distribution channel.
  pub latest_version as "latestVersion,omitempty": Version? = None
  /// A freeform string denoting the maintainer of this package.
  pub maintainer as "maintainer,omitempty": Str = ""
  /// The distribution channel-specific homepage for this package.
  pub url as "url,omitempty": Str = ""
} derive Json

/// DocumentNote: DocumentNote represents an SPDX Document Creation Information section: https://spdx.github.io/spdx-spec/2-document-creation-information/
pub struct DocumentNote {
  /// Compliance with the SPDX specification includes populating the SPDX fields therein with data related to such fields ("SPDX-Metadata")
  pub data_licence as "dataLicence,omitempty": Str = ""
  /// Provide a reference number that can be used to understand how to parse and interpret the rest of the file
  pub spdx_version as "spdxVersion,omitempty": Str = ""
} derive Json

/// DocumentOccurrence: DocumentOccurrence represents an SPDX Document Creation Information section: https://spdx.github.io/spdx-spec/2-document-creation-information/
pub struct DocumentOccurrence {
  /// Identify when the SPDX file was originally created. The date is to be specified according to combined date and time in UTC format as specified in ISO 8601 standard
  pub create_time as "createTime,omitempty": Str = ""
  /// A field for creators of the SPDX file to provide general comments about the creation of the SPDX file or any other relevant comment not included in the other fields
  pub creator_comment as "creatorComment,omitempty": Str = ""
  /// Identify who (or what, in the case of a tool) created the SPDX file. If the SPDX file was created by an individual, indicate the person's name
  pub creators as "creators,omitempty": List[Str] = []
  /// A field for creators of the SPDX file content to provide comments to the consumers of the SPDX document
  pub document_comment as "documentComment,omitempty": Str = ""
  /// Identify any external SPDX documents referenced within this SPDX document
  pub external_document_refs as "externalDocumentRefs,omitempty": List[Str] = []
  /// Identify the current SPDX document which may be referenced in relationships by other files, packages internally and documents externally
  pub id as "id,omitempty": Str = ""
  /// A field for creators of the SPDX file to provide the version of the SPDX License List used when the SPDX file was created
  pub license_list_version as "licenseListVersion,omitempty": Str = ""
  /// Provide an SPDX document specific namespace as a unique absolute Uniform Resource Identifier (URI) as specified in RFC-3986, with the exception of the ‘#’ delimiter
  pub namespace as "namespace,omitempty": Str = ""
  /// Identify name of this document as designated by creator
  pub title as "title,omitempty": Str = ""
} derive Json

/// Empty: A generic empty message that you can re-use to avoid defining duplicated empty messages in your APIs. A typical example is to use it as the request or the response type of an API method. For instance: service Foo { rpc Bar(google.protobuf.Empty) returns (google.protobuf.Empty); }
pub struct Empty {} derive Json

