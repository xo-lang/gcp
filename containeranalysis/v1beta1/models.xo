} derive Json

/// Version: Version contains structured information about the version of a package.
pub struct Version {
  /// Used to correct mistakes in the version numbering scheme.
  pub epoch as "epoch,omitempty": Int = 0
  /// Whether this version is specifying part of an inclusive range. Grafeas does not have the capability to specify version ranges; instead we have fields that specify start version and end versions. At times this is insufficient - we also need to specify whether the version is included in the range or is excluded from the range. This boolean is expected to be set to true when the version is included in a range.
  pub inclusive as "inclusive,omitempty": Bool = false
  /// Required. Distinguishes between sentinel MIN/MAX versions and normal versions.
  pub kind as "kind,omitempty": Str = ""
  /// Required only when version kind is NORMAL. The main part of the version name.
  pub name as "name,omitempty": Str = ""
  /// The iteration of the package build from the above version.
  pub revision as "revision,omitempty": Str = ""
} derive Json

/// VexAssessment: VexAssessment provides all publisher provided Vex information that is related to this vulnerability.
pub struct VexAssessment {
  /// Holds the MITRE standard Common Vulnerabilities and Exposures (CVE) tracking number for the vulnerability. Deprecated: Use vulnerability_id instead to denote CVEs.
  pub cve as "cve,omitempty": Str = ""
  /// Contains information about the impact of this vulnerability, this will change with time.
  pub impacts as "impacts,omitempty": List[Str] = []
  /// Justification provides the justification when the state of the assessment if NOT_AFFECTED.
  pub justification as "justification,omitempty": Justification? = None
  /// The VulnerabilityAssessment note from which this VexAssessment was generated. This will be of the form: `projects/[PROJECT_ID]/notes/[NOTE_ID]`.
  pub note_name as "noteName,omitempty": Str = ""
  /// Holds a list of references associated with this vulnerability item and assessment.
  pub related_uris as "relatedUris,omitempty": List[RelatedUrl] = []
  /// Specifies details on how to handle (and presumably, fix) a vulnerability.
  pub remediations as "remediations,omitempty": List[Remediation] = []
  /// Provides the state of this Vulnerability assessment.
  pub state as "state,omitempty": Str = ""
  /// The vulnerability identifier for this Assessment. Will hold one of common identifiers e.g. CVE, GHSA etc.
  pub vulnerability_id as "vulnerabilityId,omitempty": Str = ""
} derive Json

/// Volume: Volume describes a Docker container volume which is mounted into build steps in order to persist files across build step execution. Next ID: 3
pub struct Volume {
  /// Name of the volume to mount. Volume names must be unique per build step and must be valid names for Docker volumes. Each named volume must be used by at least two build steps.
  pub name as "name,omitempty": Str = ""
  /// Path at which to mount the volume. Paths must be absolute and cannot conflict with other volume paths on the same build step or with certain reserved volume paths.
  pub path as "path,omitempty": Str = ""
} derive Json

/// Vulnerability: Vulnerability provides metadata about a security vulnerability in a Note.
pub struct Vulnerability {
  /// The time this advisory was published by the source.
  pub advisory_publish_time as "advisoryPublishTime,omitempty": Str = ""
  /// The CVSS score for this vulnerability.
  pub cvss_score as "cvssScore,omitempty": Float = 0.0
  /// The full description of the CVSS for version 2.
  pub cvss_v2 as "cvssV2,omitempty": CVSS? = None
  /// The full description of the CVSS for version 3.
  pub cvss_v3 as "cvssV3,omitempty": CVSSv3? = None
  /// The full description of the CVSS for version 4.
  pub cvss_v4 as "cvssV4,omitempty": CVSS? = None
  /// CVSS version used to populate cvss_score and severity.
  pub cvss_version as "cvssVersion,omitempty": Str = ""
  /// A list of CWE for this vulnerability. For details, see: https://cwe.mitre.org/index.html
  pub cwe as "cwe,omitempty": List[Str] = []
  /// All information about the package to specifically identify this vulnerability. One entry per (version range and cpe_uri) the package vulnerability has manifested in.
  pub details as "details,omitempty": List[Detail] = []
  /// Note provider assigned impact of the vulnerability.
  pub severity as "severity,omitempty": Str = ""
  /// The time this information was last changed at the source. This is an upstream timestamp from the underlying information source - e.g. Ubuntu security tracker.
  pub source_update_time as "sourceUpdateTime,omitempty": Str = ""
  /// Windows details get their own format because the information format and model don't match a normal detail. Specifically Windows updates are done as patches, thus Windows vulnerabilities really are a missing package, rather than a package being at an incorrect version.
  pub windows_details as "windowsDetails,omitempty": List[WindowsDetail] = []
} derive Json

/// VulnerabilityAssessmentNote: A single VulnerabilityAssessmentNote represents one particular product's vulnerability assessment for one CVE.
pub struct VulnerabilityAssessmentNote {
  /// Represents a vulnerability assessment for the product.
  pub assessment as "assessment,omitempty": Assessment? = None
  /// Identifies the language used by this document, corresponding to IETF BCP 47 / RFC 5646.
  pub language_code as "languageCode,omitempty": Str = ""
  /// A detailed description of this Vex.
  pub long_description as "longDescription,omitempty": Str = ""
  /// The product affected by this vex.
  pub product as "product,omitempty": Product? = None
  /// Publisher details of this Note.
  pub publisher as "publisher,omitempty": Publisher? = None
  /// A one sentence description of this Vex.
  pub short_description as "shortDescription,omitempty": Str = ""
  /// The title of the note. E.g. `Vex-Debian-11.4`
  pub title as "title,omitempty": Str = ""
} derive Json

/// VulnerabilityLocation: The location of the vulnerability.
pub struct VulnerabilityLocation {
  /// Required. The CPE URI in [cpe format](https://cpe.mitre.org/specification/) format. Examples include distro or storage location for vulnerable jar.
  pub cpe_uri as "cpeUri,omitempty": Str = ""
  /// Required. The package being described.
  pub package as "package,omitempty": Str = ""
  /// Required. The version of the package being described.
  pub version as "version,omitempty": Version? = None
} derive Json

/// VulnerabilityOccurrencesSummary: A summary of how many vulnerability occurrences there are per resource and severity type.
pub struct VulnerabilityOccurrencesSummary {
  /// A listing by resource of the number of fixable and total vulnerabilities.
  pub counts as "counts,omitempty": List[FixableTotalByDigest] = []
  /// Unordered list. Unreachable regions. Populated for requests from the global region when `return_partial_success` is set. Format: `projects/[PROJECT_ID]/locations/[LOCATION]`
  pub unreachable as "unreachable,omitempty": List[Str] = []
} derive Json

/// WindowsDetail:
pub struct WindowsDetail {
  /// Required. The CPE URI in [cpe format](https://cpe.mitre.org/specification/) in which the vulnerability manifests. Examples include distro or storage location for vulnerable jar.
  pub cpe_uri as "cpeUri,omitempty": Str = ""
  /// The description of the vulnerability.
  pub description as "description,omitempty": Str = ""
  /// Required. The names of the KBs which have hotfixes to mitigate this vulnerability. Note that there may be multiple hotfixes (and thus multiple KBs) that mitigate a given vulnerability. Currently any listed kb's presence is considered a fix.
  pub fixing_kbs as "fixingKbs,omitempty": List[KnowledgeBase] = []
  /// Required. The name of the vulnerability.
  pub name as "name,omitempty": Str = ""
} derive Json

/// WorkspacePolicyResult: Result of Workspace Policy scan.
pub struct WorkspacePolicyResult {
  /// Status of the scan.
  pub scan_status as "scanStatus,omitempty": Str = ""
  /// Verdict of the scan.
  pub verdict as "verdict,omitempty": Str = ""
