  pub file_path as "filePath,omitempty": Str = ""
} derive Json

/// FileNote: FileNote represents an SPDX File Information section: https://spdx.github.io/spdx-spec/4-file-information/
pub struct FileNote {
  /// Provide a unique identifier to match analysis information on each specific file in a package
  pub checksum as "checksum,omitempty": List[Str] = []
  /// This field provides information about the type of file identified
  pub file_type as "fileType,omitempty": Str = ""
  /// Identify the full path and filename that corresponds to the file information in this section
  pub title as "title,omitempty": Str = ""
} derive Json

/// FileOccurrence: FileOccurrence represents an SPDX File Information section: https://spdx.github.io/spdx-spec/4-file-information/
pub struct FileOccurrence {
  /// This field provides a place for the SPDX data creator to record, at the file level, acknowledgements that may be needed to be communicated in some contexts
  pub attributions as "attributions,omitempty": List[Str] = []
  /// This field provides a place for the SPDX file creator to record any general comments about the file
  pub comment as "comment,omitempty": Str = ""
  /// This field provides a place for the SPDX file creator to record file contributors
  pub contributors as "contributors,omitempty": List[Str] = []
  /// Identify the copyright holder of the file, as well as any dates present
  pub copyright as "copyright,omitempty": Str = ""
  /// This field contains the license information actually found in the file, if any
  pub files_license_info as "filesLicenseInfo,omitempty": List[Str] = []
  /// Uniquely identify any element in an SPDX document which may be referenced by other elements
  pub id as "id,omitempty": Str = ""
  /// This field contains the license the SPDX file creator has concluded as governing the file or alternative values if the governing license cannot be determined
  pub license_concluded as "licenseConcluded,omitempty": License? = None
  /// This field provides a place for the SPDX file creator to record license notices or other such related notices found in the file
  pub notice as "notice,omitempty": Str = ""
} derive Json

/// Finding: Finding provides details for a single finding within an AISkillAnalysisOccurrence.
pub struct Finding {
