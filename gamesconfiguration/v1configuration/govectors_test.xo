test "Go's gamesConfiguration.leaderboardConfigurations.update" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"draft\":{\"iconUrl\":\"s-iconurl\",\"kind\":\"s-kind\",\"name\":{\"kind\":\"s-kind\"},\"scoreFormat\":{\"currencyCode\":\"s-currencycode\",\"numDecimalPlaces\":7,\"numberFormatType\":\"s-numberformattype\"},\"sortRank\":7},\"id\":\"s-id\",\"kind\":\"s-kind\",\"published\":{\"iconUrl\":\"s-iconurl\",\"kind\":\"s-kind\",\"name\":{\"kind\":\"s-kind\"},\"scoreFormat\":{\"currencyCode\":\"s-currencycode\",\"numDecimalPlaces\":7,\"numberFormatType\":\"s-numberformattype\"},\"sortRank\":7},\"scoreMax\":\"7\",\"scoreMin\":\"7\",\"scoreOrder\":\"s-scoreorder\",\"token\":\"s-token\"}")
  gv_note(f, "CALL gamesConfiguration.leaderboardConfigurations.update")
  match svc.leaderboard_configurations.update("id1/ x", json.decode_str[LeaderboardConfiguration]("{\"draft\":{\"iconUrl\":\"s-iconurl\",\"kind\":\"s-kind\",\"name\":{\"kind\":\"s-kind\"},\"scoreFormat\":{\"currencyCode\":\"s-currencycode\",\"numDecimalPlaces\":7,\"numberFormatType\":\"s-numberformattype\"},\"sortRank\":7},\"id\":\"s-id\",\"kind\":\"s-kind\",\"published\":{\"iconUrl\":\"s-iconurl\",\"kind\":\"s-kind\",\"name\":{\"kind\":\"s-kind\"},\"scoreFormat\":{\"currencyCode\":\"s-currencycode\",\"numDecimalPlaces\":7,\"numberFormatType\":\"s-numberformattype\"},\"sortRank\":7},\"scoreMax\":\"7\",\"scoreMin\":\"7\",\"scoreOrder\":\"s-scoreorder\",\"token\":\"s-token\"}") ?? e => fault(e.display()), options: LeaderboardConfigurationsUpdateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_9)
}
