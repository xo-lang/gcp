  gv_set(f, "{\"items\":[{\"draft\":{\"iconUrl\":\"s-iconurl\",\"kind\":\"s-kind\",\"sortRank\":7},\"id\":\"s-id\",\"kind\":\"s-kind\",\"published\":{\"iconUrl\":\"s-iconurl\",\"kind\":\"s-kind\",\"sortRank\":7},\"scoreMax\":\"7\",\"scoreMin\":\"7\",\"scoreOrder\":\"s-scoreorder\",\"token\":\"s-token\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_note(f, "CALL gamesConfiguration.leaderboardConfigurations.list")
  match svc.leaderboard_configurations.list("id1/ x", options: LeaderboardConfigurationsListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_8)
}

