use std/json

const GV_HOST: Str = "https://policytroubleshooter.googleapis.com"

const GO_0: List[Str] = [
  "CALL policytroubleshooter.iam.troubleshoot",
  "REQ POST https://policytroubleshooter.googleapis.com/v1/iam:troubleshoot?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"accessTuple\":{\"fullResourceName\":\"s-fullresourcename\",\"permission\":\"s-permission\",\"principal\":\"s-principal\"}}",
  "",
  "  SERVED 200 {\"access\":\"s-access\",\"errors\":[{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"}],\"explainedPolicies\":[{\"access\":\"s-access\",\"fullResourceName\":\"s-fullresourcename\",\"policy\":{\"etag\":\"YWI=\",\"version\":7},\"relevance\":\"s-relevance\"}]}",
  "OUT: {\"access\":\"s-access\",\"errors\":[{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"}],\"explainedPolicies\":[{\"access\":\"s-access\",\"fullResourceName\":\"s-fullresourcename\",\"policy\":{\"etag\":\"YWI=\",\"version\":7},\"relevance\":\"s-relevance\"}]}",
]

test "Go's policytroubleshooter.iam.troubleshoot" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"access\":\"s-access\",\"errors\":[{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"}],\"explainedPolicies\":[{\"access\":\"s-access\",\"fullResourceName\":\"s-fullresourcename\",\"policy\":{\"etag\":\"YWI=\",\"version\":7},\"relevance\":\"s-relevance\"}]}")
  gv_note(f, "CALL policytroubleshooter.iam.troubleshoot")
  match svc.iam.troubleshoot(json.decode_str[GoogleCloudPolicytroubleshooterV1TroubleshootIamPolicyRequest]("{\"accessTuple\":{\"fullResourceName\":\"s-fullresourcename\",\"permission\":\"s-permission\",\"principal\":\"s-principal\"}}") ?? e => fault(e.display()), options: IamTroubleshootOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
