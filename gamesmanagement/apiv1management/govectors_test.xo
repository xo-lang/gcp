  match svc.scores.reset_all_for_all_players(options: ScoresResetAllForAllPlayersOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(_) => gv_note(f, "OUT: ok")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_16)
}

