  gv_queue(f, "{\"googleApiSources\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"createTime\":\"s-createtime\",\"cryptoKeyName\":\"s-cryptokeyname\",\"destination\":\"s-destination\",\"displayName\":\"s-displayname\",\"etag\":\"s-etag\",\"labels\":{\"k1\":\"s-labels\"},\"loggingConfig\":{\"logSeverity\":\"s-logseverity\"},\"name\":\"s-name\",\"organizationSubscription\":{\"enabled\":true},\"projectSubscriptions\":{},\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
