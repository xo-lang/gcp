  var p = svc.projects.locations.channels.list_pages("id1/ x", options: ProjectsLocationsChannelsListOptions{order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
