  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"servicePerimeters\":[{\"description\":\"s-description\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"perimeterType\":\"s-perimetertype\",\"spec\":{},\"status\":{},\"title\":\"s-title\",\"useExplicitDryRunSpec\":true}]}")
  gv_queue(f, "{\"servicePerimeters\":[{\"description\":\"s-description\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"perimeterType\":\"s-perimetertype\",\"spec\":{},\"status\":{},\"title\":\"s-title\",\"useExplicitDryRunSpec\":true}]}")
  gv_note(f, "CALL accesscontextmanager.accessPolicies.servicePerimeters.list pages")
  var p = svc.access_policies.service_perimeters.list_pages("id1/ x", options: AccessPoliciesServicePerimetersListOptions{deleted_principal_syntax: Some("s-deletedprincipalsyntax"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_28)
}

