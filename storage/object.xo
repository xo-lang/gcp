// Objects: handles, attributes, conditions and the metadata calls, as
// cloud.google.com/go/storage v1.70.0's storage.go and http_client.go
// (Apache-2.0, Copyright Google LLC; NOTICE.md).

use std/base64
use std/json
use std/time
use std/url
use github.com/xo-lang/gcp/gensupport
use github.com/xo-lang/gcp/googleapi
use github.com/xo-lang/gcp/storage/v1 as raw

/// Preconditions on an object's generation and metageneration (Go's
/// Conditions): 0 and false mean unset. At most one generation condition
/// and one metageneration condition.
pub struct Conditions {
  pub generation_match: Int = 0
  pub generation_not_match: Int = 0
  /// The object must not exist (ifGenerationMatch=0).
  pub does_not_exist: Bool = false
  pub metageneration_match: Int = 0
  pub metageneration_not_match: Int = 0
}

/// Go's Conditions.validate, for method's error texts.
fn (c: Conditions) validate(method: Str) -> () ! StorageErr {
  if c == (Conditions{}) {
    return Err(StorageErr.Invalid("storage: ${method}: empty conditions"))
  }
  var n = 0
  if c.generation_match != 0 {
    n += 1
  }
  if c.generation_not_match != 0 {
    n += 1
  }
  if c.does_not_exist {
    n += 1
  }
  if n > 1 {
    return Err(StorageErr.Invalid("storage: ${method}: multiple conditions specified for generation"))
  }
  if c.metageneration_match != 0 && c.metageneration_not_match != 0 {
    return Err(StorageErr.Invalid("storage: ${method}: multiple conditions specified for metageneration"))
  }
  Ok(())
}

/// The query parameters of a generation and conditions (Go's applyConds).
struct CondParams {
  generation: Int? = None
  if_generation_match: Int? = None
  if_generation_not_match: Int? = None
  if_metageneration_match: Int? = None
  if_metageneration_not_match: Int? = None
}

fn cond_params(method: Str, gen: Int, conds: Conditions?) -> CondParams ! StorageErr {
  var p = CondParams{}
  if gen >= 0 {
    p.generation = Some(gen)
  }
  let c = conds ?? return Ok(p)
  c.validate(method)?
  if c.generation_match != 0 {
    p.if_generation_match = Some(c.generation_match)
  } else if c.generation_not_match != 0 {
    p.if_generation_not_match = Some(c.generation_not_match)
  } else if c.does_not_exist {
    p.if_generation_match = Some(0)
  }
  if c.metageneration_match != 0 {
    p.if_metageneration_match = Some(c.metageneration_match)
  } else if c.metageneration_not_match != 0 {
    p.if_metageneration_not_match = Some(c.metageneration_not_match)
  }
  Ok(p)
}

/// An access control entry (Go's ACLRule).
pub struct ACLRule {
  pub entity: Str
  pub entity_id: Str = ""
  pub role: Str
  pub domain: Str = ""
  pub email: Str = ""
  pub project_team: ProjectTeam? = None
}

/// The project team of an ACL entry (Go's ProjectTeam).
pub struct ProjectTeam {
  pub project_number: Str
  pub team: Str
}

fn object_acl(items: List[raw.ObjectAccessControl]) -> List[ACLRule] {
  var out: List[ACLRule] = []
  for a in items {
    let pt = match a.project_team {
      Some(t) => Some(ProjectTeam{project_number: t.project_number, team: t.team})
      None => None
    }
    out.push(ACLRule{entity: a.entity, entity_id: a.entity_id, role: a.role, domain: a.domain, email: a.email, project_team: pt})
  }
  out
}

/// An object's attributes (Go's ObjectAttrs). A time the object lacks is
/// None (Go's zero time).
pub struct ObjectAttrs {
  pub bucket: Str = ""
  pub name: Str = ""
  pub content_type: Str = ""
  pub content_language: Str = ""
  pub cache_control: Str = ""
  pub event_based_hold: Bool = false
  pub temporary_hold: Bool = false
  pub retention_expiration_time: Time? = None
  pub acl: List[ACLRule] = []
  pub owner: Str = ""
  pub size: Int = 0
  pub content_encoding: Str = ""
  pub content_disposition: Str = ""
  /// The MD5 hash of the content, empty when the object has none.
  pub md5: Bytes = b""
  /// The CRC32C checksum (Castagnoli) of the content.
  pub crc32c: Int = 0
  pub media_link: Str = ""
  pub metadata: Map[Str, Str] = {}
  pub generation: Int = 0
  pub metageneration: Int = 0
  pub storage_class: Str = ""
  pub created: Time? = None
  pub finalized: Time? = None
  pub deleted: Time? = None
  pub updated: Time? = None
  pub customer_key_sha256: Str = ""
  pub kms_key_name: Str = ""
  /// Set for a prefix a delimited listing returns, the rest empty.
  pub prefix: Str = ""
  pub etag: Str = ""
  pub custom_time: Time? = None
  pub component_count: Int = 0
  pub soft_delete_time: Time? = None
  pub hard_delete_time: Time? = None
  /// The object's own retention, if any.
  pub retention: ObjectRetention? = None
  pub contexts: ObjectContexts? = None
}

/// Go's convertTime: an RFC 3339 time, None for "" or one that does not
/// parse.
fn convert_time(s: Str) -> Time? {
  if s.is_empty() {
    return None
  }
  time.RFC3339_LAYOUT.parse(s, time.utc()).ok()
}

/// Go's decodeUint32: the big-endian value of base64 text of 4 bytes.
fn decode_uint32(s: Str) -> Int {
  let b = base64.decode(s, base64.Base64.Std).ok() ?? return 0
  if b.len() != 4 {
    return 0
  }
  (Int(b[0]) << 24) | (Int(b[1]) << 16) | (Int(b[2]) << 8) | Int(b[3])
}

/// Go's newObject.
fn new_object(o: raw.Object) -> ObjectAttrs {
  let owner = match o.owner {
    Some(w) => w.entity
    None => ""
  }
  let sha = match o.customer_encryption {
    Some(ce) => ce.key_sha256
    None => ""
  }
  ObjectAttrs{
    bucket: o.bucket,
    name: o.name,
    content_type: o.content_type,
    content_language: o.content_language,
    cache_control: o.cache_control,
    event_based_hold: o.event_based_hold,
    temporary_hold: o.temporary_hold,
    retention_expiration_time: convert_time(o.retention_expiration_time),
    acl: object_acl(o.acl),
    owner: owner,
    content_encoding: o.content_encoding,
    content_disposition: o.content_disposition,
    size: o.size,
    md5: base64.decode(o.md5_hash, base64.Base64.Std).ok() ?? b"",
    crc32c: decode_uint32(o.crc32c),
    media_link: o.media_link,
    metadata: o.metadata,
    generation: o.generation,
    metageneration: o.metageneration,
    storage_class: o.storage_class,
    customer_key_sha256: sha,
    kms_key_name: o.kms_key_name,
    created: convert_time(o.time_created),
    finalized: convert_time(o.time_finalized),
    deleted: convert_time(o.time_deleted),
    updated: convert_time(o.updated),
    etag: o.etag,
    custom_time: convert_time(o.custom_time),
    component_count: o.component_count,
    soft_delete_time: convert_time(o.soft_delete_time),
    hard_delete_time: convert_time(o.hard_delete_time),
    retention: to_object_retention(o.retention),
    contexts: to_object_contexts(o.contexts),
  }
}

/// The attributes an update changes (Go's ObjectAttrsToUpdate): None
/// leaves one as it is. An empty content_type or content_language, or an
/// empty metadata map, removes it (sent as null); an empty metadata value
/// removes that key.
pub struct ObjectAttrsToUpdate {
  pub event_based_hold: Bool? = None
  pub temporary_hold: Bool? = None
  pub content_type: Str? = None
  pub content_language: Str? = None
  pub content_encoding: Str? = None
  pub content_disposition: Str? = None
  pub cache_control: Str? = None
  /// Set when not None (it cannot be removed).
  pub custom_time: Time? = None
  pub metadata: Map[Str, Str]? = None
  pub acl: List[ACLRule]? = None
  pub predefined_acl: Str = ""
  /// An empty retention (no mode, no time) removes it.
  pub retention: ObjectRetention? = None
  /// Sets or empties the keys given; no keys removes all contexts.
  pub contexts: ObjectContexts? = None
}

fn format_time(t: Time) -> Str { t.format_rfc3339() }

fn acl_value(rs: List[ACLRule]) -> json.Value {
  var out: List[json.Value] = []
  for r in rs {
    var f: List[(Str, json.Value)] = []
    if r.domain != "" {
      f.push(("domain", json.Value.Str(r.domain)))
    }
    if r.email != "" {
      f.push(("email", json.Value.Str(r.email)))
    }
    f.push(("entity", json.Value.Str(r.entity)))
    if r.entity_id != "" {
      f.push(("entityId", json.Value.Str(r.entity_id)))
    }
    if let Some(t) = r.project_team {
      f.push(("projectTeam", json.Value.Object([("projectNumber", json.Value.Str(t.project_number)), ("team", json.Value.Str(t.team))])))
    }
    f.push(("role", json.Value.Str(r.role)))
    out.push(json.Value.Object(f))
  }
  json.Value.List(out)
}

/// The PATCH body of an update (UpdateObject: its ForceSendFields and
/// NullFields), with the bucket as toRawObject sets it.
fn update_body(bucket: Str, u: ObjectAttrsToUpdate) -> json.Value {
  var f: List[(Str, json.Value)] = []
  if let Some(a) = u.acl {
    f.push(("acl", acl_value(a)))
  }
  f.push(("bucket", json.Value.Str(bucket)))
  if let Some(v) = u.cache_control {
    f.push(("cacheControl", json.Value.Str(v)))
  }
  if let Some(v) = u.content_disposition {
    f.push(("contentDisposition", json.Value.Str(v)))
  }
  if let Some(v) = u.content_encoding {
    f.push(("contentEncoding", json.Value.Str(v)))
  }
  if let Some(v) = u.content_language {
    f.push(("contentLanguage", if v.is_empty() { json.Value.Null } else { json.Value.Str(v) }))
  }
  if let Some(v) = u.content_type {
    f.push(("contentType", if v.is_empty() { json.Value.Null } else { json.Value.Str(v) }))
  }
  if let Some(c) = u.contexts {
    f.push(("contexts", if c.custom.is_empty() { json.Value.Null } else { contexts_value(c) }))
  }
  if let Some(t) = u.custom_time {
    f.push(("customTime", json.Value.Str(format_time(t))))
  }
  if let Some(v) = u.event_based_hold {
    f.push(("eventBasedHold", json.Value.Bool(v)))
  }
  if let Some(m) = u.metadata {
    if m.is_empty() {
      f.push(("metadata", json.Value.Null))
    } else {
      var kv: List[(Str, json.Value)] = []
      for k in m.keys().sort() {
        kv.push((k, json.Value.Str(m.get_or_fault(k, "k is one of the keys"))))
      }
      f.push(("metadata", json.Value.Object(kv)))
    }
  }
  if let Some(r) = u.retention {
    f.push(("retention", if r.mode.is_empty() && r.retain_until.is_none() { json.Value.Null } else { object_retention_value(r) }))
  }
  if let Some(v) = u.temporary_hold {
    f.push(("temporaryHold", json.Value.Bool(v)))
  }
  json.Value.Object(f)
}

/// An object's handle (Go's ObjectHandle): its bucket, name, generation
/// (-1 for the latest), conditions, billing project and retries. No
/// request is made until a call.
pub struct ObjectHandle[fx: Effects] {
  c: Client[fx]
  bucket: Str
  object: Str
  gen: Int = -1
  conds: Conditions? = None
  user_project: Str = ""
  retry: Retry
  read_compressed: Bool = false
  override_retention: Bool? = None
  want_soft_deleted: Bool = false
}

pub fn (o: ObjectHandle[fx]) bucket_name() -> Str { o.bucket }

pub fn (o: ObjectHandle[fx]) object_name() -> Str { o.object }

/// The handle of the object's generation gen (Go's Generation).
pub fn (o: ObjectHandle[fx]) generation(gen: Int) -> ObjectHandle[fx] {
  var h = o
  h.gen = gen
  h
}

/// The handle with conds on every call (Go's If).
pub fn (o: ObjectHandle[fx]) if_(conds: Conditions) -> ObjectHandle[fx] {
  var h = o
  h.conds = Some(conds)
  h
}

/// The handle with its own retries (Go's Retryer).
pub fn (o: ObjectHandle[fx]) retryer(r: Retry) -> ObjectHandle[fx] {
  var h = o
  h.retry = r
  h
}

/// Go's ObjectHandle.validate.
fn (o: ObjectHandle[fx]) validate() -> () ! StorageErr {
  if o.bucket.is_empty() {
    return Err(StorageErr.Invalid("storage: bucket name is empty"))
  }
  if o.object.is_empty() {
    return Err(StorageErr.Invalid("storage: object name is empty"))
  }
  if o.object == "." || o.object == ".." {
    return Err(StorageErr.Invalid("storage: object name ${o.object.quote()} is not valid"))
  }
  Ok(())
}

fn opt_str(s: Str) -> Str? { if s.is_empty() { None } else { Some(s) } }

/// The object's attributes (Go's Attrs).
pub fn (o: ObjectHandle[fx]) attrs() -> ObjectAttrs ! StorageErr uses (net.dial, clock, rand, fx) {
  o.validate()?
  let p = cond_params("Attrs", o.gen, o.conds)?
  let got = o.c.run(o.retry, true, fn(h: List[(Str, Str)]) -> raw.Object ! gensupport.CallErr uses net.dial, clock, rand, fx {
    o.c.svc.objects.get(o.bucket, o.object, raw.ObjectsGetOptions{generation: p.generation, if_generation_match: p.if_generation_match, if_generation_not_match: p.if_generation_not_match, if_metageneration_match: p.if_metageneration_match, if_metageneration_not_match: p.if_metageneration_not_match, projection: Some("full"), soft_deleted: if o.want_soft_deleted { Some(true) } else { None }, user_project: opt_str(o.user_project), headers: h})
  }) ?? e => return Err(object_err(e))
  Ok(new_object(got))
}

/// Updates the object's attributes and returns them (Go's Update). It is
/// retried by the Idempotent policy only with a metageneration_match
/// condition.
pub fn (o: ObjectHandle[fx]) update(u: ObjectAttrsToUpdate) -> ObjectAttrs ! StorageErr uses (net.dial, clock, rand, fx) {
  o.validate()?
  let p = cond_params("Update", o.gen, o.conds)?
  let idempotent = match o.conds {
    Some(c) => c.metageneration_match != 0
    None => false
  }
  var q = url.values()
  if let Some(v) = p.generation {
    q.set("generation", "${v}")
  }
  if let Some(v) = p.if_generation_match {
    q.set("ifGenerationMatch", "${v}")
  }
  if let Some(v) = p.if_generation_not_match {
    q.set("ifGenerationNotMatch", "${v}")
  }
  if let Some(v) = p.if_metageneration_match {
    q.set("ifMetagenerationMatch", "${v}")
  }
  if let Some(v) = p.if_metageneration_not_match {
    q.set("ifMetagenerationNotMatch", "${v}")
  }
  if let Some(v) = o.override_retention {
    q.set("overrideUnlockedRetention", "${v}")
  }
  if !u.predefined_acl.is_empty() {
    q.set("predefinedAcl", u.predefined_acl)
  }
  q.set("projection", "full")
  if !o.user_project.is_empty() {
    q.set("userProject", o.user_project)
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  let body = json_bytes(update_body(o.bucket, u))
  let target = googleapi.expand(googleapi.resolve_relative(o.c.core.base_path, "b/{bucket}/o/{object}"), {"bucket": o.bucket, "object": o.object})
  let got = o.c.run(o.retry, idempotent, fn(h: List[(Str, Str)]) -> raw.Object ! gensupport.CallErr uses net.dial, clock, rand, fx {
    var hs: List[(Str, Str)] = [("Content-Type", "application/json")]
    hs = hs + h
    let resp = o.c.core.client.send(gensupport.Request{method: "PATCH", url: target, query: q, headers: hs, body: body})?
    gensupport.check(resp)?
    gensupport.decode[raw.Object](resp)
  }) ?? e => return Err(object_err(e))
  Ok(new_object(got))
}

/// Deletes the object (Go's Delete). It is retried by the Idempotent
/// policy only for a generation, or with a generation_match condition.
pub fn (o: ObjectHandle[fx]) delete() -> () ! StorageErr uses (net.dial, clock, rand, fx) {
  o.validate()?
  let p = cond_params("Delete", o.gen, o.conds)?
  let idempotent = o.gen >= 0 || match o.conds {
    Some(c) => c.generation_match != 0
    None => false
  }
  o.c.run(o.retry, idempotent, fn(h: List[(Str, Str)]) -> () ! gensupport.CallErr uses net.dial, clock, rand, fx {
    o.c.svc.objects.delete(o.bucket, o.object, raw.ObjectsDeleteOptions{generation: p.generation, if_generation_match: p.if_generation_match, if_generation_not_match: p.if_generation_not_match, if_metageneration_match: p.if_metageneration_match, if_metageneration_not_match: p.if_metageneration_not_match, user_project: opt_str(o.user_project), headers: h})
  }) ?? e => return Err(object_err(e))
  Ok(())
}
