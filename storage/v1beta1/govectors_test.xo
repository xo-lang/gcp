test "Go's storage.objects.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"bucket\":\"s-bucket\",\"cacheControl\":\"s-cachecontrol\",\"contentDisposition\":\"s-contentdisposition\",\"contentEncoding\":\"s-contentencoding\",\"contentLanguage\":\"s-contentlanguage\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"media\":{\"algorithm\":\"s-algorithm\",\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"hash\":\"s-hash\",\"length\":\"7\",\"link\":\"s-link\",\"timeCreated\":\"s-timecreated\"},\"metadata\":{\"k1\":\"s-metadata\"},\"name\":\"s-name\",\"owner\":{\"entity\":\"s-entity\",\"entityId\":\"s-entityid\"},\"selfLink\":\"s-selflink\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"prefixes\":[\"s-prefixes\"]}")
  gv_queue(f, "{\"items\":[{\"bucket\":\"s-bucket\",\"cacheControl\":\"s-cachecontrol\",\"contentDisposition\":\"s-contentdisposition\",\"contentEncoding\":\"s-contentencoding\",\"contentLanguage\":\"s-contentlanguage\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"media\":{\"algorithm\":\"s-algorithm\",\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"hash\":\"s-hash\",\"length\":\"7\",\"link\":\"s-link\",\"timeCreated\":\"s-timecreated\"},\"metadata\":{\"k1\":\"s-metadata\"},\"name\":\"s-name\",\"owner\":{\"entity\":\"s-entity\",\"entityId\":\"s-entityid\"},\"selfLink\":\"s-selflink\"}],\"kind\":\"s-kind\",\"prefixes\":[\"s-prefixes\"]}")
  gv_note(f, "CALL storage.objects.list pages")
  var p = svc.objects.list_pages("id1/ x", options: ObjectsListOptions{delimiter: Some("s-delimiter"), max_results: Some(7), page_token: Some("s-pagetoken"), prefix: Some("s-prefix"), projection: Some("s-projection"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_26)
}

