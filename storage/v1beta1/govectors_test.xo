test "Go's storage.buckets.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"owner\":{\"entity\":\"s-entity\",\"entityId\":\"s-entityid\"},\"projectId\":\"7\",\"selfLink\":\"s-selflink\",\"timeCreated\":\"s-timecreated\",\"website\":{\"mainPageSuffix\":\"s-mainpagesuffix\",\"notFoundPage\":\"s-notfoundpage\"}}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"owner\":{\"entity\":\"s-entity\",\"entityId\":\"s-entityid\"},\"projectId\":\"7\",\"selfLink\":\"s-selflink\",\"timeCreated\":\"s-timecreated\",\"website\":{\"mainPageSuffix\":\"s-mainpagesuffix\",\"notFoundPage\":\"s-notfoundpage\"}}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL storage.buckets.list pages")
  var p = svc.buckets.list_pages(7, options: BucketsListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), projection: Some("s-projection"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_10)
}

