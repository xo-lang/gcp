    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_28)
}

const GO_29: List[Str] = [
  "CALL storage.objects.update download",
  "REQ PUT https://www.googleapis.com/storage/v1beta1/b/id1%2F%20x/o/id2%2F%20x?alt=media&fields=kind%2Cid&prettyPrint=false&projection=s-projection",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"acl\":[{\"bucket\":\"s-bucket\",\"domain\":\"s-domain\",\"email\":\"s-email\",\"entity\":\"s-entity\",\"entityId\":\"s-entityid\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"object\":\"s-object\",\"role\":\"s-role\",\"selfLink\":\"s-selflink\"}],\"bucket\":\"s-bucket\",\"cacheControl\":\"s-cachecontrol\",\"contentDisposition\":\"s-contentdisposition\",\"contentEncoding\":\"s-contentencoding\",\"contentLanguage\":\"s-contentlanguage\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"media\":{\"algorithm\":\"s-algorithm\",\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"hash\":\"s-hash\",\"length\":\"7\",\"link\":\"s-link\",\"timeCreated\":\"s-timecreated\"},\"metadata\":{\"k1\":\"s-metadata\"},\"name\":\"s-name\",\"owner\":{\"entity\":\"s-entity\",\"entityId\":\"s-entityid\"},\"selfLink\":\"s-selflink\"}",
  "",
  "  SERVED 200 media-bytes \u{0001}ÿ",
  "OUT: media 200 media-bytes \u{0001}ÿ",
]

test "Go's storage.objects.update download" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "media-bytes \u{0001}ÿ")
  gv_note(f, "CALL storage.objects.update download")
  match svc.objects.update_download("id1/ x", "id2/ x", json.decode_str[Object]("{\"acl\":[{\"bucket\":\"s-bucket\",\"domain\":\"s-domain\",\"email\":\"s-email\",\"entity\":\"s-entity\",\"entityId\":\"s-entityid\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"object\":\"s-object\",\"role\":\"s-role\",\"selfLink\":\"s-selflink\"}],\"bucket\":\"s-bucket\",\"cacheControl\":\"s-cachecontrol\",\"contentDisposition\":\"s-contentdisposition\",\"contentEncoding\":\"s-contentencoding\",\"contentLanguage\":\"s-contentlanguage\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"media\":{\"algorithm\":\"s-algorithm\",\"contentType\":\"s-contenttype\",\"data\":\"YWI=\",\"hash\":\"s-hash\",\"length\":\"7\",\"link\":\"s-link\",\"timeCreated\":\"s-timecreated\"},\"metadata\":{\"k1\":\"s-metadata\"},\"name\":\"s-name\",\"owner\":{\"entity\":\"s-entity\",\"entityId\":\"s-entityid\"},\"selfLink\":\"s-selflink\"}") ?? e => fault(e.display()), options: ObjectsUpdateOptions{projection: Some("s-projection"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: media ${r.status} ${r.body.to_str_lossy()}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_29)
}
