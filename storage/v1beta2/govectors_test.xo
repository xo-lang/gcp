test "Go's storage.objects.watchAll" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"address\":\"s-address\",\"expiration\":\"7\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"params\":{\"k1\":\"s-params\"},\"payload\":true,\"resourceId\":\"s-resourceid\",\"resourceUri\":\"s-resourceuri\",\"token\":\"s-token\",\"type\":\"s-type\"}")
  gv_note(f, "CALL storage.objects.watchAll")
  match svc.objects.watch_all("id1/ x", json.decode_str[Channel]("{\"address\":\"s-address\",\"expiration\":\"7\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"params\":{\"k1\":\"s-params\"},\"payload\":true,\"resourceId\":\"s-resourceid\",\"resourceUri\":\"s-resourceuri\",\"token\":\"s-token\",\"type\":\"s-type\"}") ?? e => fault(e.display()), options: ObjectsWatchAllOptions{delimiter: Some("s-delimiter"), max_results: Some(7), page_token: Some("s-pagetoken"), prefix: Some("s-prefix"), projection: Some("s-projection"), versions: Some(true), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_33)
}
