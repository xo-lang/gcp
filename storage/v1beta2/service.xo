/// ObjectsWatchAllOptions: the optional parameters of ObjectsService.watch_all.
pub struct ObjectsWatchAllOptions {
  /// Returns results in a directory-like mode. items will contain only objects whose names, aside from the prefix, do not contain delimiter. Objects whose names, aside from the prefix, contain delimiter will have their name, truncated after the delimiter, returned in prefixes. Duplicate prefixes are omitted.
  pub delimiter: Str? = None
  /// Maximum number of items plus prefixes to return. As duplicate prefixes are omitted, fewer total results may be returned than requested.
  pub max_results: Int? = None
  /// A previously-returned page token representing part of the larger set of results to view.
  pub page_token: Str? = None
  /// Filter results to objects whose names begin with this prefix.
  pub prefix: Str? = None
  /// Set of properties to return. Defaults to noAcl.
  pub projection: Str? = None
  /// If true, lists all versions of a file as distinct results.
  pub versions: Bool? = None
  /// The fields of the result to return (Go's Fields), joined with commas.
  pub fields: List[Str] = []
  /// More request headers (Go's Header).
  pub headers: List[(Str, Str)] = []
}

/// watch_all: Watch for changes on all objects in a bucket.
/// (Go's storage.objects.watchAll.)
pub fn (r: ObjectsService[fx]) watch_all(bucket: Str, channel: Channel, options: ObjectsWatchAllOptions = ObjectsWatchAllOptions{}) -> Channel ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.delimiter {
    q.set("delimiter", v)
  }
  if let Some(v) = options.max_results {
    q.set("maxResults", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if let Some(v) = options.prefix {
    q.set("prefix", v)
  }
  if let Some(v) = options.projection {
    q.set("projection", v)
  }
  if let Some(v) = options.versions {
    q.set("versions", "${v}")
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs.push(("Content-Type", "application/json"))
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "b/{bucket}/o/watch"), {"bucket": bucket})
  let resp = r.core.client.send(gensupport.Request{method: "POST", url: u, query: q, headers: hs, body: gensupport.json_body(channel, data_wrapper: false)})?
  gensupport.check(resp)?
  gensupport.decode[Channel](resp)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
  new_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
