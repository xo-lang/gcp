/// ObjectsListPages: the pages of ObjectsService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct ObjectsListPages[fx: Effects] {
  r: ObjectsService[fx]
  bucket: Str
  options: ObjectsListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: ObjectsService.list's pages, from the first.
pub fn (r: ObjectsService[fx]) list_pages(bucket: Str, options: ObjectsListOptions = ObjectsListOptions{}) -> ObjectsListPages[fx] {
  ObjectsListPages{r: r, bucket: bucket, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: ObjectsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: ObjectsListPages[fx]) next_page() -> Objects ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.bucket, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

