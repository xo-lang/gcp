test "oracle: write, SendCRC32C and MD5" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: obj_for("a", "hello, world")}])
  let c = fake_client(os)
  var w = c.bucket("b1").object("a").new_writer()
  w.attrs.content_type = "text/plain"
  w.send_crc32c = true
  w.attrs.crc32c = 1771676703
  w.attrs.md5 = b"0123456789abcdef"
  write_lines(f, w, "hello, world", 100)
  expect(lines(f)) == ["  POST https://storage.fake/upload/storage/v1/b/b1/o?alt=json&name=a&prettyPrint=false&projection=full&uploadType=multipart", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: multipart/related; boundary=BOUNDARY", "    body --BOUNDARY\\r", "    body Content-Type: application/json\\r", "    body \\r", "    body {\"bucket\":\"b1\",\"contentType\":\"text/plain\",\"crc32c\":\"aZmkHw==\",\"md5Hash\":\"MDEyMzQ1Njc4OWFiY2RlZg==\",\"name\":\"a\"}", "    body \\r", "    body --BOUNDARY\\r", "    body Content-Type: text/plain\\r", "    body \\r", "    body hello, world\\r", "    body --BOUNDARY--\\r", "    body ", "  ok name=a gen=1700000000000001 size=12 crc32c=1771676703"]
}

