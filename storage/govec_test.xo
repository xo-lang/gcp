test "oracle: copy, two calls with a rewrite token, progress" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: rewrite_reply(false, "tok1", 6, 12, "")}, Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: rewrite_reply(true, "", 12, 12, obj_for("b", "hello, world"))}])
  let c = fake_client(os)
  var cp = c.bucket("b1").object("b").copier_from(c.bucket("b1").object("a"))
  cp.progress = Some(fn(d: Int, t: Int) { note(f, "  progress ${d}/${t}") })
  ran_lines(f, cp.run())
  note(f, "  token ${cp.rewrite_token.quote()}")
  expect(lines(f)) == ["  POST https://storage.fake/storage/v1/b/b1/o/a/rewriteTo/b/b1/o/b?alt=json&prettyPrint=false&projection=full", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/json", "    body {}", "  progress 6/12", "  POST https://storage.fake/storage/v1/b/b1/o/a/rewriteTo/b/b1/o/b?alt=json&prettyPrint=false&projection=full&rewriteToken=tok1", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/json", "    body {}", "  progress 12/12", "  ok name=b bucket=b1 gen=1700000000000001 size=12 type=\"text/plain\"", "  token \"\""]
}

test "oracle: copy, attributes, conditions, source generation, KMS key, ACL, user project" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: rewrite_reply(true, "", 12, 12, obj_for("b", "hello, world"))}])
  let c = fake_client(os)
  let src = c.bucket("b1").billed_to("srcbilled").object("a").generation(9).if_(Conditions{generation_match: 9, metageneration_not_match: 2})
  var cp = c.bucket("b1").object("b").if_(Conditions{does_not_exist: true}).copier_from(src)
  cp.attrs.content_type = "text/csv"
  cp.attrs.metadata = {"k": "v"}
  cp.destination_kms_key_name = "projects/p/locations/l/keyRings/r/cryptoKeys/k"
  cp.predefined_acl = "private"
  ran_lines(f, cp.run())
  expect(lines(f)) == ["  POST https://storage.fake/storage/v1/b/b1/o/a/rewriteTo/b/b1/o/b?alt=json&destinationKmsKeyName=projects%2Fp%2Flocations%2Fl%2FkeyRings%2Fr%2FcryptoKeys%2Fk&destinationPredefinedAcl=private&ifGenerationMatch=0&ifSourceGenerationMatch=9&ifSourceMetagenerationNotMatch=2&prettyPrint=false&projection=full&sourceGeneration=9&userProject=srcbilled", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/json", "    body {\"contentType\":\"text/csv\",\"metadata\":{\"k\":\"v\"}}", "  ok name=b bucket=b1 gen=1700000000000001 size=12 type=\"text/plain\""]
}

