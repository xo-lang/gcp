  o.conditions = [PostPolicyV4Condition.StartsWith(key: "$key", value: "dir/"), PostPolicyV4Condition.ContentLengthRange(start: 1, end: 1024), PostPolicyV4Condition.StartsWith(key: "$x", value: ""), PostPolicyV4Condition.ContentLengthRange(start: 0, end: 0)]
