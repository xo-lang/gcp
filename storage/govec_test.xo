test "oracle: objects, prefix, delimiter, versions, match glob, two pages" {
  let f = new_fake(os.net, [(200, "{\"kind\":\"storage#objects\",\"nextPageToken\":\"tok1\",\"prefixes\":[\"dir/sub/\"],\"items\":[{\"name\":\"dir/a\",\"bucket\":\"b1\",\"generation\":\"1\",\"size\":\"3\"},{\"name\":\"dir/b\",\"bucket\":\"b1\",\"generation\":\"2\",\"size\":\"4\"}]}"), (200, "{\"kind\":\"storage#objects\",\"items\":[{\"name\":\"dir/c\",\"bucket\":\"b1\",\"generation\":\"3\",\"size\":\"5\"}]}")])
  let c = fake_client(os)
  objects(f, c.bucket("b1").objects(Query{prefix: "dir/", delimiter: "/", versions: true, match_glob: "**.txt", start_offset: "dir/a", end_offset: "dir/z", include_trailing_delimiter: true}))
  expect(lines(f)) == ["  GET https://storage.fake/storage/v1/b/b1/o?alt=json&delimiter=%2F&endOffset=dir%2Fz&includeFoldersAsPrefixes=false&includeTrailingDelimiter=true&matchGlob=%2A%2A.txt&pageToken=&prefix=dir%2F&prettyPrint=false&projection=full&startOffset=dir%2Fa&versions=true", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "  object dir/a gen=1 size=3", "  object dir/b gen=2 size=4", "  prefix dir/sub/", "  GET https://storage.fake/storage/v1/b/b1/o?alt=json&delimiter=%2F&endOffset=dir%2Fz&includeFoldersAsPrefixes=false&includeTrailingDelimiter=true&matchGlob=%2A%2A.txt&pageToken=tok1&prefix=dir%2F&prettyPrint=false&projection=full&startOffset=dir%2Fa&versions=true", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "  object dir/c gen=3 size=5", "  done"]
}

