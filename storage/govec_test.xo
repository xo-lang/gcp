test "oracle: write, resumable in two chunks" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Location": "https://storage.fake/upload/storage/v1/b/b1/o?uploadType=resumable&upload_id=U1"}, body: ""}, Reply{status: 200, headers: {"Range": "bytes=0-262143", "X-Http-Status-Code-Override": "308"}, body: ""}, Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: obj_for("big", big(300000))}])
  let c = fake_client(os)
  var w = c.bucket("b1").object("big").new_writer()
  w.attrs.content_type = "application/octet-stream"
  w.chunk_size = 262144
  write_lines(f, w, big(300000), 65536)
  expect(lines(f)) == ["  POST https://storage.fake/upload/storage/v1/b/b1/o?alt=json&name=big&prettyPrint=false&projection=full&uploadType=resumable", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    X-Upload-Content-Type: application/octet-stream", "    body {\"bucket\":\"b1\",\"contentType\":\"application/octet-stream\",\"name\":\"big\"}", "  POST https://storage.fake/upload/storage/v1/b/b1/o?uploadType=resumable&upload_id=U1", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/1", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/octet-stream", "    Content-Range: bytes 0-262143/*", "    body <262144 bytes> \"0123456789abcdef0123456789abcdef\"...\"0123456789abcdef0123456789abcdef\"", "  POST https://storage.fake/upload/storage/v1/b/b1/o?uploadType=resumable&upload_id=U1", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/1", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/octet-stream", "    Content-Range: bytes 262144-299999/300000", "    X-Goog-Hash: crc32c=W4TEbA==", "    body <37856 bytes> \"0123456789abcdef0123456789abcdef\"...\"0123456789abcdef0123456789abcdef\"", "  ok name=big gen=1700000000000001 size=300000 crc32c=1535427692"]
}

test "oracle: write, resumable, a chunk retried" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Location": "https://storage.fake/upload/storage/v1/b/b1/o?uploadType=resumable&upload_id=U2"}, body: ""}, Reply{status: 503, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: "{\"error\":{\"code\":503,\"message\":\"busy\"}}"}, Reply{status: 200, headers: {"Range": "bytes=0-262143", "X-Http-Status-Code-Override": "308"}, body: ""}, Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: obj_for("big", big(300000))}])
  let c = fake_client(os)
  var w = c.bucket("b1").object("big").if_(Conditions{does_not_exist: true}).retryer(Retry{backoff: FAST}).new_writer()
  w.attrs.content_type = "application/octet-stream"
  w.chunk_size = 262144
  write_lines(f, w, big(300000), 65536)
  expect(lines(f)) == ["  POST https://storage.fake/upload/storage/v1/b/b1/o?alt=json&ifGenerationMatch=0&name=big&prettyPrint=false&projection=full&uploadType=resumable", "    X-Goog-Api-Client: gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/json", "    X-Upload-Content-Type: application/octet-stream", "    body {\"bucket\":\"b1\",\"contentType\":\"application/octet-stream\",\"name\":\"big\"}", "  POST https://storage.fake/upload/storage/v1/b/b1/o?uploadType=resumable&upload_id=U2", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/1", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/octet-stream", "    Content-Range: bytes 0-262143/*", "    body <262144 bytes> \"0123456789abcdef0123456789abcdef\"...\"0123456789abcdef0123456789abcdef\"", "  POST https://storage.fake/upload/storage/v1/b/b1/o?uploadType=resumable&upload_id=U2", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/2", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/octet-stream", "    Content-Range: bytes 0-262143/*", "    body <262144 bytes> \"0123456789abcdef0123456789abcdef\"...\"0123456789abcdef0123456789abcdef\"", "  POST https://storage.fake/upload/storage/v1/b/b1/o?uploadType=resumable&upload_id=U2", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/1", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/octet-stream", "    Content-Range: bytes 262144-299999/300000", "    X-Goog-Hash: crc32c=W4TEbA==", "    body <37856 bytes> \"0123456789abcdef0123456789abcdef\"...\"0123456789abcdef0123456789abcdef\"", "  ok name=big gen=1700000000000001 size=300000 crc32c=1535427692"]
}

test "oracle: write, an empty object name" {
  let f = new_reply_fake(os.net, [])
  let c = fake_client(os)
  var w = c.bucket("b1").object("").new_writer()
  write_lines(f, w, "hello, world", 100)
  expect(lines(f)) == ["  POST https://storage.fake/upload/storage/v1/b/b1/o?alt=json&name=&prettyPrint=false&projection=full&uploadType=multipart", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: multipart/related; boundary=BOUNDARY", "    body --BOUNDARY\\r", "    body Content-Type: application/json\\r", "    body \\r", "    body {\"bucket\":\"b1\",\"crc32c\":\"aZmkHw==\"}", "    body \\r", "    body --BOUNDARY\\r", "    body Content-Type: text/plain; charset=utf-8\\r", "    body \\r", "    body hello, world\\r", "    body --BOUNDARY--\\r", "    body ", "  ok name= gen=0 size=0 crc32c=0"]
}

test "oracle: write, nothing written" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: obj_for("empty", "")}])
  let c = fake_client(os)
  var w = c.bucket("b1").object("empty").new_writer()
  w.attrs.content_type = "text/plain"
  write_lines(f, w, "", 100)
  expect(lines(f)) == ["  POST https://storage.fake/upload/storage/v1/b/b1/o?alt=json&name=empty&prettyPrint=false&projection=full&uploadType=multipart", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: multipart/related; boundary=BOUNDARY", "    body --BOUNDARY\\r", "    body Content-Type: application/json\\r", "    body \\r", "    body {\"bucket\":\"b1\",\"contentType\":\"text/plain\",\"crc32c\":\"AAAAAA==\",\"name\":\"empty\"}", "    body \\r", "    body --BOUNDARY\\r", "    body Content-Type: text/plain\\r", "    body \\r", "    body \\r", "    body --BOUNDARY--\\r", "    body ", "  ok name=empty gen=1700000000000001 size=0 crc32c=0"]
}
