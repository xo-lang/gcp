}

test "oracle: post policy v4, an RSA key" {
  let f = new_reply_fake(os.net, [])
  os.clock.set(Time.from_unix(NOW0))
  let k = test_key(os)
  var o = po(f)
  o.sign_raw_bytes = None
  o.private_key = Some(k.pem.bytes())
  policy_rsa_lines(f, generate_signed_post_policy_v4(os.clock, os.rand, "b1", "a", o), k)
  expect(lines(f)) == ["  verified", "  url https://storage.googleapis.com/b1/", "  field key=a", "  field policy (decoded) {\"conditions\":[{\"bucket\":\"b1\"},{\"key\":\"a\"},{\"x-goog-date\":\"20260102T030405Z\"},{\"x-goog-credential\":\"robot@example.com/20260102/auto/storage/goog4_request\"},{\"x-goog-algorithm\":\"GOOG4-RSA-SHA256\"}],\"expiration\":\"2026-01-02T04:04:05Z\"}", "  field x-goog-algorithm=GOOG4-RSA-SHA256", "  field x-goog-credential=robot@example.com/20260102/auto/storage/goog4_request", "  field x-goog-date=20260102T030405Z", "  field x-goog-signature=SIG"]
}

