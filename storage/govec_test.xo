test "oracle: object update, retry always" {
  let f = new_fake(os.net, [(500, "{\"error\":{\"code\":500,\"message\":\"internal\"}}"), (200, OBJ_JSON)])
  let c = fake_client(os)
  obj(f, c.bucket("b1").object("a").retryer(Retry{backoff: FAST, policy: RetryPolicy.Always}).update(ObjectAttrsToUpdate{content_type: Some("x/y")}))
  expect(lines(f)) == ["  PATCH https://storage.fake/storage/v1/b/b1/o/a?alt=json&prettyPrint=false&projection=full", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/json", "    body {\"bucket\":\"b1\",\"contentType\":\"x/y\"}", "  PATCH https://storage.fake/storage/v1/b/b1/o/a?alt=json&prettyPrint=false&projection=full", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/2 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/json", "    body {\"bucket\":\"b1\",\"contentType\":\"x/y\"}", "  ok {\"ACL\":[{\"Domain\":\"\",\"Email\":\"\",\"Entity\":\"allUsers\",\"EntityID\":\"\",\"ProjectTeam\":{\"ProjectNumber\":\"123\",\"Team\":\"owners\"},\"Role\":\"READER\"}],\"Bucket\":\"b1\",\"CRC32C\":3381945770,\"CacheControl\":\"no-cache\",\"ComponentCount\":2,\"ContentDisposition\":\"inline\",\"ContentEncoding\":\"gzip\",\"ContentLanguage\":\"en\",\"ContentType\":\"text/plain\",\"Created\":\"2023-11-14T22:13:20Z\",\"CustomTime\":\"2024-01-02T03:04:05Z\",\"CustomerKeySHA256\":\"\",\"Deleted\":\"0001-01-01T00:00:00Z\",\"Etag\":\"CIGAgICAgICAAhAD\",\"EventBasedHold\":true,\"Finalized\":\"2023-11-14T22:13:20Z\",\"Generation\":1700000000000001,\"HardDeleteTime\":\"0001-01-01T00:00:00Z\",\"KMSKeyName\":\"projects/p/locations/l/keyRings/r/cryptoKeys/k\",\"MD5\":\"XUFAKrxLKna5cZ2REBfFkg==\",\"MediaLink\":\"https://storage.googleapis.com/download/storage/v1/b/b1/o/dir%2Fa.txt?generation=1700000000000001&alt=media\",\"Metadata\":{\"k1\":\"v1\",\"k2\":\"v2\"},\"Metageneration\":3,\"Name\":\"dir/a.txt\",\"Owner\":\"user-owner\",\"Prefix\":\"\",\"RetentionExpirationTime\":\"2025-01-01T00:00:00Z\",\"Size\":1234,\"SoftDeleteTime\":\"0001-01-01T00:00:00Z\",\"StorageClass\":\"STANDARD\",\"TemporaryHold\":false,\"Updated\":\"2023-11-15T01:00:00.123Z\"}"]
}

