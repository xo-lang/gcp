test "oracle: post policy v4, a hashed signer, virtual hosted" {
  let f = new_reply_fake(os.net, [])
  os.clock.set(Time.from_unix(NOW0))
  var o = po(f)
  o.sign_raw_bytes = None
  o.sign_bytes = Some(fake_signer(f))
  o.style = URLStyle.VirtualHosted
  policy_lines(f, generate_signed_post_policy_v4(os.clock, os.rand, "b1", "a", o))
  expect(lines(f)) == ["  sign \"\\xcc\\xf0\\xe7\\xed\\\\\\x89Cǳ\\x9c\\xf9o\\x87\\xd3&\\xfe\\x16\\nd\\x0f\\xe6\\xda_\\xeb\\xa7\\x01X\\xa4ٗ\\x81&\"", "  url https://b1.storage.googleapis.com/", "  field key=a", "  field policy (decoded) {\"conditions\":[{\"bucket\":\"b1\"},{\"key\":\"a\"},{\"x-goog-date\":\"20260102T030405Z\"},{\"x-goog-credential\":\"robot@example.com/20260102/auto/storage/goog4_request\"},{\"x-goog-algorithm\":\"GOOG4-RSA-SHA256\"}],\"expiration\":\"2026-01-02T04:04:05Z\"}", "  field x-goog-algorithm=GOOG4-RSA-SHA256", "  field x-goog-credential=robot@example.com/20260102/auto/storage/goog4_request", "  field x-goog-date=20260102T030405Z", "  field x-goog-signature=bea1a77558d2be3bdc7b204e6bdecc63d6b98a0484d200d46e1477e70c0a5ee8"]
}

test "oracle: post policy v4, bucket bound hostname, insecure" {
  let f = new_reply_fake(os.net, [])
  os.clock.set(Time.from_unix(NOW0))
  var o = po(f)
  o.style = URLStyle.BucketBound(hostname: "files.example.com")
