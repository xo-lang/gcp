fn obj(f: Fake, r: Result[ObjectAttrs, StorageErr]) {
  result_lines(f, match r {
    Ok(a) => Ok(object_json(a))
    Err(e) => Err(e)
  })
}

fn bkt(f: Fake, r: Result[BucketAttrs, StorageErr]) {
  result_lines(f, match r {
    Ok(a) => Ok(bucket_json(a))
    Err(e) => Err(e)
  })
}

fn unit(f: Fake, r: Result[(), StorageErr]) {
  result_lines(f, match r {
    Ok(_) => Ok("")
    Err(e) => Err(e)
  })
}

fn str_result(f: Fake, r: Result[Str, StorageErr]) {
  result_lines(f, match r {
    Ok(x) => Ok(json.Value.Str(x).encode())
    Err(e) => Err(e)
  })
}

fn objects(f: Fake, it0: ObjectIterator[()]) {
  var it = it0
  while true {
    match it.next() {
      Ok(Some(a)) => note(f, if a.prefix != "" { "  prefix ${a.prefix}" } else { "  object ${a.name} gen=${a.generation} size=${a.size}" })
      Ok(None) => {
        note(f, "  done")
        break
      }
      Err(e) => {
        note(f, "  error ${e.display()}")
        break
      }
    }
  }
}

fn buckets(f: Fake, it0: BucketIterator[()]) {
  var it = it0
  while true {
    match it.next() {
      Ok(Some(a)) => note(f, "  bucket ${a.name} location=${a.location} class=${a.storage_class}")
      Ok(None) => {
        note(f, "  done")
        break
      }
      Err(e) => {
        note(f, "  error ${e.display()}")
        break
      }
    }
  }
}

