test "oracle: read" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Cache-Control": "no-cache", "Content-Length": "12", "Content-Type": "text/plain", "Last-Modified": "Tue, 14 Nov 2023 22:13:20 GMT", "X-Goog-Generation": "1700000000000000", "X-Goog-Hash": "crc32c=aZmkHw==,md5=XrY7u+Ae7tCTyyK7j1rNww==", "X-Goog-Meta-Owner": "ada", "X-Goog-Metageneration": "3", "X-Goog-Stored-Content-Length": "12"}, body: "hello, world"}])
  var c = fake_client(os)
  read_lines(f, c.bucket("b1").object("dir/a b.txt").new_reader())
  expect(lines(f)) == ["  GET https://storage.fake/b1/dir%2Fa%20b.txt", "    X-Goog-Api-Client: gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "  attrs size=12 start=0 gen=1700000000000000 metagen=3 crc32c=1771676703 type=\"text/plain\" encoding=\"\" cache=\"no-cache\" modified=2023-11-14T22:13:20Z decompressed=false remain=12", "  metadata Owner=ada", "  read \"hello, world\"", "  remain 0"]
}

test "oracle: read, bad crc" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Cache-Control": "no-cache", "Content-Length": "12", "Content-Type": "text/plain", "Last-Modified": "Tue, 14 Nov 2023 22:13:20 GMT", "X-Goog-Generation": "1700000000000000", "X-Goog-Hash": "crc32c=AAAAAA==", "X-Goog-Meta-Owner": "ada", "X-Goog-Metageneration": "3", "X-Goog-Stored-Content-Length": "12"}, body: "hello, world"}])
  var c = fake_client(os)
  read_lines(f, c.bucket("b1").object("a").new_reader())
  expect(lines(f)) == ["  GET https://storage.fake/b1/a", "    X-Goog-Api-Client: gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "  attrs size=12 start=0 gen=1700000000000000 metagen=3 crc32c=0 type=\"text/plain\" encoding=\"\" cache=\"no-cache\" modified=2023-11-14T22:13:20Z decompressed=false remain=12", "  metadata Owner=ada", "  read \"hello, world\"", "  read error storage: bad CRC on read: got 1771676703, want 0", "  close error storage: bad CRC on read: got 1771676703, want 0", "  remain 0"]
