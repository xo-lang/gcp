test "oracle: compose, conditions, ACL, CRC32C, delete sources, user project" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: obj_for("all", "hello, world")}])
  let c = fake_client(os)
  let b = c.bucket("b1").billed_to("billed")
  var cm = b.object("all").if_(Conditions{does_not_exist: true}).composer_from([b.object("p1"), b.object("p2")])
  cm.predefined_acl = "private"
  cm.send_crc32c = true
  cm.attrs.crc32c = 1771676703
  cm.delete_source_objects = true
  ran_lines(f, cm.run())
  expect(lines(f)) == ["  POST https://storage.fake/storage/v1/b/b1/o/all/compose?alt=json&destinationPredefinedAcl=private&ifGenerationMatch=0&prettyPrint=false&userProject=billed", "    X-Goog-Api-Client: gl-go/GO gdcl/V gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: application/json", "    body {\"deleteSourceObjects\":true,\"destination\":{\"bucket\":\"b1\",\"crc32c\":\"aZmkHw==\"},\"sourceObjects\":[{\"name\":\"p1\"},{\"name\":\"p2\"}]}", "  ok name=all bucket=b1 gen=1700000000000001 size=12 type=\"text/plain\""]
}

