  expect(lines(f)) == ["  sign \"\"", "  url https://storage.googleapis.com/b1/", "  field acl=public-read", "  field cache-control=no-cache", "  field content-disposition=inline", "  field content-encoding=gzip", "  field content-type=text/plain", "  field key=a", "  field policy (decoded) {\"conditions\":[[\"starts-with\",\"\$key\",\"dir/\"],[\"content-length-range\",1,1024],{\"acl\":\"public-read\"},{\"cache-control\":\"no-cache\"},{\"content-disposition\":\"inline\"},{\"content-encoding\":\"gzip\"},{\"content-type\":\"text/plain\"},{\"success_action_redirect\":\"https://example.com/done?a=1\\u0026b=\\u003c2\\u003e\"},{\"success_action_status\":\"201\"},{\"x-goog-meta-owner\":\"ada\"},{\"bucket\":\"b1\"},{\"key\":\"a\"},{\"x-goog-date\":\"20260102T030405Z\"},{\"x-goog-credential\":\"robot@example.com/20260102/auto/storage/goog4_request\"},{\"x-goog-algorithm\":\"GOOG4-RSA-SHA256\"}],\"expiration\":\"2026-01-02T04:04:05Z\"}", "  field success_action_redirect=https://example.com/done?a=1&b=<2>", "  field success_action_status=201", "  field x-goog-algorithm=GOOG4-RSA-SHA256", "  field x-goog-credential=robot@example.com/20260102/auto/storage/goog4_request", "  field x-goog-date=20260102T030405Z", "  field x-goog-meta-owner=ada", "  field x-goog-signature=d5284f041cc2e677e9bfbaadbf081943df67fa191f88fdd70bb5506e46260e46"]
