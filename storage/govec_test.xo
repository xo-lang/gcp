test "oracle: write, chunk size 0: one request, the server's checksum checked" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: obj_for("a", "other")}])
  let c = fake_client(os)
  var w = c.bucket("b1").object("a").new_writer()
  w.chunk_size = 0
  w.attrs.content_type = "text/plain"
  write_lines(f, w, "hello, world", 100)
  expect(lines(f)) == ["  POST https://storage.fake/upload/storage/v1/b/b1/o?alt=json&name=a&prettyPrint=false&projection=full&uploadType=multipart", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: multipart/related; boundary=BOUNDARY", "    body --BOUNDARY\\r", "    body Content-Type: application/json\\r", "    body \\r", "    body {\"bucket\":\"b1\",\"contentType\":\"text/plain\",\"name\":\"a\"}", "    body \\r", "    body --BOUNDARY\\r", "    body Content-Type: text/plain\\r", "    body \\r", "    body hello, world\\r", "    body --BOUNDARY--\\r", "    body ", "  close error storage: object checksum mismatch: computed \"aZmkHw==\", server \"uTja5A==\"; the bucket may contain corrupted object"]
}

