test "oracle: write, small: multipart with the auto checksum" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: obj_for("dir/a.txt", "hello, world")}])
  let c = fake_client(os)
  var w = c.bucket("b1").object("dir/a.txt").new_writer()
  w.attrs.content_type = "text/plain"
  w.attrs.cache_control = "no-cache"
  w.attrs.metadata = {"owner": "ada"}
  write_lines(f, w, "hello, world", 5)
  expect(lines(f)) == ["  POST https://storage.fake/upload/storage/v1/b/b1/o?alt=json&name=dir%2Fa.txt&prettyPrint=false&projection=full&uploadType=multipart", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: multipart/related; boundary=BOUNDARY", "    body --BOUNDARY\\r", "    body Content-Type: application/json\\r", "    body \\r", "    body {\"bucket\":\"b1\",\"cacheControl\":\"no-cache\",\"contentType\":\"text/plain\",\"crc32c\":\"aZmkHw==\",\"metadata\":{\"owner\":\"ada\"},\"name\":\"dir/a.txt\"}", "    body \\r", "    body --BOUNDARY\\r", "    body Content-Type: text/plain\\r", "    body \\r", "    body hello, world\\r", "    body --BOUNDARY--\\r", "    body ", "  ok name=dir/a.txt gen=1700000000000001 size=12 crc32c=1771676703"]
}

