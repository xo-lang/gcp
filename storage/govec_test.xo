test "oracle: write, does not exist condition, user project, predefined ACL, KMS key" {
  let f = new_reply_fake(os.net, [Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: obj_for("a", "hello, world")}])
  let c = fake_client(os)
  var w = c.bucket("b1").billed_to("billed").object("a").if_(Conditions{does_not_exist: true}).new_writer()
  w.attrs.content_type = "text/plain"
  w.predefined_acl = "publicRead"
  w.attrs.kms_key_name = "projects/p/locations/l/keyRings/r/cryptoKeys/k"
  write_lines(f, w, "hello, world", 100)
  expect(lines(f)) == ["  POST https://storage.fake/upload/storage/v1/b/b1/o?alt=json&ifGenerationMatch=0&kmsKeyName=projects%2Fp%2Flocations%2Fl%2FkeyRings%2Fr%2FcryptoKeys%2Fk&name=a&predefinedAcl=publicRead&prettyPrint=false&projection=full&uploadType=multipart&userProject=billed", "    X-Goog-Api-Client: gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: multipart/related; boundary=BOUNDARY", "    body --BOUNDARY\\r", "    body Content-Type: application/json\\r", "    body \\r", "    body {\"bucket\":\"b1\",\"contentType\":\"text/plain\",\"crc32c\":\"aZmkHw==\",\"name\":\"a\"}", "    body \\r", "    body --BOUNDARY\\r", "    body Content-Type: text/plain\\r", "    body \\r", "    body hello, world\\r", "    body --BOUNDARY--\\r", "    body ", "  ok name=a gen=1700000000000001 size=12 crc32c=1771676703"]
}

test "oracle: write, 503 without a precondition is not retried" {
  let f = new_reply_fake(os.net, [Reply{status: 503, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: "{\"error\":{\"code\":503,\"message\":\"busy\"}}"}, Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: obj_for("a", "hello, world")}])
  let c = fake_client(os)
  var w = c.bucket("b1").object("a").retryer(Retry{backoff: FAST}).new_writer()
  w.attrs.content_type = "text/plain"
  write_lines(f, w, "hello, world", 100)
  expect(lines(f)) == ["  POST https://storage.fake/upload/storage/v1/b/b1/o?alt=json&name=a&prettyPrint=false&projection=full&uploadType=multipart", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: multipart/related; boundary=BOUNDARY", "    body --BOUNDARY\\r", "    body Content-Type: application/json\\r", "    body \\r", "    body {\"bucket\":\"b1\",\"contentType\":\"text/plain\",\"crc32c\":\"aZmkHw==\",\"name\":\"a\"}", "    body \\r", "    body --BOUNDARY\\r", "    body Content-Type: text/plain\\r", "    body \\r", "    body hello, world\\r", "    body --BOUNDARY--\\r", "    body ", "  close error googleapi: Error 503: busy"]
}

test "oracle: write, 503 with a precondition is retried" {
  let f = new_reply_fake(os.net, [Reply{status: 503, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: "{\"error\":{\"code\":503,\"message\":\"busy\"}}"}, Reply{status: 200, headers: {"Content-Type": "application/json; charset=UTF-8"}, body: obj_for("a", "hello, world")}])
  let c = fake_client(os)
  var w = c.bucket("b1").object("a").if_(Conditions{generation_match: 5}).retryer(Retry{backoff: FAST}).new_writer()
  w.attrs.content_type = "text/plain"
  write_lines(f, w, "hello, world", 100)
  expect(lines(f)) == ["  POST https://storage.fake/upload/storage/v1/b/b1/o?alt=json&ifGenerationMatch=5&name=a&prettyPrint=false&projection=full&uploadType=multipart", "    X-Goog-Api-Client: gccl-invocation-id/UUID gccl-attempt-count/1 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: multipart/related; boundary=BOUNDARY", "    body --BOUNDARY\\r", "    body Content-Type: application/json\\r", "    body \\r", "    body {\"bucket\":\"b1\",\"contentType\":\"text/plain\",\"crc32c\":\"aZmkHw==\",\"name\":\"a\"}", "    body \\r", "    body --BOUNDARY\\r", "    body Content-Type: text/plain\\r", "    body \\r", "    body hello, world\\r", "    body --BOUNDARY--\\r", "    body ", "  POST https://storage.fake/upload/storage/v1/b/b1/o?alt=json&ifGenerationMatch=5&name=a&prettyPrint=false&projection=full&uploadType=multipart", "    X-Goog-Api-Client: gccl-invocation-id/UUID gccl-attempt-count/2 gl-go/GO gccl/V", "    X-Goog-Gcs-Idempotency-Token: UUID", "    Content-Type: multipart/related; boundary=BOUNDARY", "    body --BOUNDARY\\r", "    body Content-Type: application/json\\r", "    body \\r", "    body {\"bucket\":\"b1\",\"contentType\":\"text/plain\",\"crc32c\":\"aZmkHw==\",\"name\":\"a\"}", "    body \\r", "    body --BOUNDARY\\r", "    body Content-Type: text/plain\\r", "    body \\r", "    body hello, world\\r", "    body --BOUNDARY--\\r", "    body ", "  ok name=a gen=1700000000000001 size=12 crc32c=1771676703"]
}

