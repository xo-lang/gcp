/// BucketsListPages: the pages of BucketsService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct BucketsListPages[fx: Effects] {
  r: BucketsService[fx]
  projectid: Str
  options: BucketsListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: BucketsService.list's pages, from the first.
pub fn (r: BucketsService[fx]) list_pages(projectid: Str, options: BucketsListOptions = BucketsListOptions{}) -> BucketsListPages[fx] {
  BucketsListPages{r: r, projectid: projectid, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: BucketsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: BucketsListPages[fx]) next_page() -> Buckets ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.projectid, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

