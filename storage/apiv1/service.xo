  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.bucket, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

/// RapidCachesUpdateOptions: the optional parameters of RapidCachesService.update.
pub struct RapidCachesUpdateOptions {
  /// The fields of the result to return (Go's Fields), joined with commas.
  pub fields: List[Str] = []
  /// More request headers (Go's Header).
  pub headers: List[(Str, Str)] = []
}

/// update: Updates the configuration of a Rapid Cache instance.
/// (Go's storage.rapidCaches.update.)
pub fn (r: RapidCachesService[fx]) update(bucket: Str, rapid_cache_id: Str, rapidcache: RapidCache, options: RapidCachesUpdateOptions = RapidCachesUpdateOptions{}) -> GoogleLongrunningOperation ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs.push(("Content-Type", "application/json"))
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "b/{bucket}/rapidCaches/{rapidCacheId}"), {"bucket": bucket, "rapidCacheId": rapid_cache_id})
  let resp = r.core.client.send(gensupport.Request{method: "PATCH", url: u, query: q, headers: hs, body: gensupport.json_body(rapidcache, data_wrapper: false, marks: if rapidcache.body_marked() { Some(rapidcache.body_mark(gensupport.body_value(rapidcache))) } else { None })})?
  gensupport.check(resp)?
  gensupport.decode[GoogleLongrunningOperation](resp)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
  new_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
