  bucket: Str
  options: FoldersListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: FoldersService.list's pages, from the first.
pub fn (r: FoldersService[fx]) list_pages(bucket: Str, options: FoldersListOptions = FoldersListOptions{}) -> FoldersListPages[fx] {
  FoldersListPages{r: r, bucket: bucket, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: FoldersListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: FoldersListPages[fx]) next_page() -> Folders ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.bucket, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

