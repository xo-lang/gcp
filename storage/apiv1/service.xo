/// ManagedFoldersListPages: the pages of ManagedFoldersService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct ManagedFoldersListPages[fx: Effects] {
  r: ManagedFoldersService[fx]
  bucket: Str
  options: ManagedFoldersListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: ManagedFoldersService.list's pages, from the first.
pub fn (r: ManagedFoldersService[fx]) list_pages(bucket: Str, options: ManagedFoldersListOptions = ManagedFoldersListOptions{}) -> ManagedFoldersListPages[fx] {
  ManagedFoldersListPages{r: r, bucket: bucket, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: ManagedFoldersListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: ManagedFoldersListPages[fx]) next_page() -> ManagedFolders ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.bucket, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

