// The fake JSON API the oracle's cases run against here
// (~/xo-lead/notes/aws-43/storagego, not in the repository): replies
// served in order, every request noted as the oracle prints it, and the
// results rendered as its JSON of Go's ObjectAttrs and BucketAttrs.

use std/base64
use std/crypto
use std/http
use std/json
use std/testing
use std/time
use std/url
use github.com/xo-lang/gcp/gensupport
use github.com/xo-lang/gcp/option

/// A reply: its status, headers (Content-Type JSON when empty) and body.
struct Reply {
  status: Int
  headers: Map[Str, Str] = {}
  body: Str = ""
}

struct Fake {
  replies: Mutex[List[Reply]]
  log: Mutex[List[Str]]
}

fn note(f: Fake, s: Str) {
  f.log.with(fn(var l: List[Str]) { l.push(s) })
}

fn header_of(req: http.Request, name: Str) -> Str? {
  for (k, v) in req.headers {
    if k.to_lower() == name.to_lower() {
      return Some(v)
    }
  }
  None
}

/// Go's printed x-goog-api-client: the versions and the invocation id
/// replaced.
fn norm_api_client(v: Str) -> Str {
  var out: List[Str] = []
  for t in v.split(" ") {
    out.push(if t.starts_with("gl-xo/") {
      "gl-go/GO"
    } else if t.starts_with("gdcl/") {
      "gdcl/V"
    } else if t.starts_with("gccl/") {
      "gccl/V"
    } else if t.starts_with("gccl-invocation-id/") {
      "gccl-invocation-id/UUID"
    } else {
      t
    })
  }
  out.join(" ")
}

/// A JSON text with object keys sorted, as the oracle prints bodies.
fn canon_text(s: Str) -> Str {
  match json.parse_value(s) {
    Ok(v) => canon(v)
    Err(_) => s
  }
}

fn canon(v: json.Value) -> Str {
  match v {
    json.Value.Object(fs) => {
      var ks: List[Str] = []
      for (k, _) in fs {
        ks.push(k)
      }
      var parts: List[Str] = []
      for k in ks.sort() {
        parts.push(json.Value.Str(k).encode() + ":" + canon(v.get(k) ?? json.Value.Null))
      }
      "{" + parts.join(",") + "}"
    }
    json.Value.List(xs) => {
      var parts: List[Str] = []
      for x in xs {
        parts.push(canon(x))
      }
      "[" + parts.join(",") + "]"
    }
    _ => v.encode()
  }
}

/// The fields inside an escaped fields=...items(...) pair, sorted: Go's
/// SetAttrSelection writes them in a map's order, which differs per run.
fn sort_items(p: Str) -> Str {
  let i = p.find("items%28") ?? return p
  if !p.starts_with("fields=") || !p.ends_with("%29") {
    return p
  }
  let fs = p[i + 8..p.len() - 3].split("%2C").sort()
  p[0..i + 8] + fs.join("%2C") + "%29"
}

fn answer(f: Fake, req: http.Request) -> http.Response {
  let q = req.raw_query()
  var pairs: List[Str] = if q == "" { [] } else { q.split("&") }
  // Go's Values.Encode: by key, each key's values in their order
  pairs = by_key(pairs.map(sort_items))
  note(f, "  ${req.method} ${req.url.scheme}://${req.url.host}${req.escaped_path()}${if pairs.is_empty() { "" } else { "?" + pairs.join("&") }}")
  if let Some(v) = header_of(req, "x-goog-api-client") {
    note(f, "    X-Goog-Api-Client: ${norm_api_client(v)}")
  }
  if header_of(req, "x-goog-gcs-idempotency-token").is_some() {
    note(f, "    X-Goog-Gcs-Idempotency-Token: UUID")
  }
  if let Some(v) = header_of(req, "x-goog-user-project") {
    note(f, "    X-Goog-User-Project: ${v}")
  }
  if let Some(v) = header_of(req, "if-none-match") {
    note(f, "    If-None-Match: ${v}")
  }
  let ct = header_of(req, "content-type") ?? ""
  let boundary = match ct.find("boundary=") {
    Some(i) => ct[i + 9..ct.len()]
    None => ""
  }
  for h in ["Content-Type", "Range", "X-Goog-If-Generation-Match", "X-Goog-If-Metageneration-Match", "X-Goog-Encryption-Algorithm", "Content-Range", "X-Upload-Content-Type", "X-Goog-Hash"] {
    if let Some(v) = header_of(req, h) {
      note(f, "    ${h}: ${if boundary == "" { v } else { v.replace(boundary, "BOUNDARY") }}")
    }
  }
  if header_of(req, "accept-encoding") == Some("gzip") {
    note(f, "    Accept-Encoding: gzip")
  }
  if !req.body.is_empty() {
    var t = canon_text(req.body.to_str_lossy())
    if boundary != "" {
      t = t.replace(boundary, "BOUNDARY")
    }
    t = t.replace("\r", "\\r")
    if t.len() > 1024 {
      t = "<${t.len()} bytes> ${t[0..32].quote()}...${t[t.len() - 32..t.len()].quote()}"
    }
    for line in t.split("\n") {
      note(f, "    body ${line}")
    }
  }
  let r = f.replies.with(fn(var rs: List[Reply]) -> Reply {
    let x = rs.get(0) ?? Reply{status: 200, body: "{}"}
    if !rs.is_empty() {
      rs = rs[1..rs.len()]
    }
    x
  })
  let hs: Map[Str, Str] = if r.headers.is_empty() { {"Content-Type": "application/json; charset=UTF-8"} } else { r.headers }
  http.Response{status: r.status, headers: hs, body: r.body.bytes()}
}

fn new_fake(net: testing.FakeNet, replies: List[(Int, Str)]) -> Fake {
  var rs: List[Reply] = []
  for (st, b) in replies {
    rs.push(Reply{status: st, body: b})
  }
  new_reply_fake(net, rs)
}

fn new_reply_fake(net: testing.FakeNet, replies: List[Reply]) -> Fake {
  let f = Fake{replies: Mutex[List[Reply]].new(replies), log: Mutex[List[Str]].new([])}
  let h = fn(req: http.Request) -> http.Response { answer(f, req) }
  for m in ["GET", "PUT", "POST", "DELETE", "PATCH", "HEAD"] {
    net.handle("${m} https://storage.fake/{rest...}", h)
  }
  // the IAM Credentials API, where a bucket's signed_url signs
  net.handle("POST https://iamcredentials.googleapis.com/{rest...}", h)
  f
}

fn lines(f: Fake) -> List[Str] { f.log.with(fn(var l: List[Str]) -> List[Str] { l }) }

/// The client of a case, as the oracle's: the fake endpoint, no
/// credentials, the backoff a millisecond.
fn fake_client(os: testing.TestOs) -> Client[()] {
  new_client(os.net, os.clock, os.rand, ClientOptions{service: option.ClientOptions{endpoint: "https://storage.fake/storage/v1/", without_authentication: true}})
}

const FAST: Backoff = Backoff{initial: 1ms, max: 1ms, multiplier: 2.0}

// Go's JSON of ObjectAttrs and BucketAttrs (field names, zero times),
// keys sorted by canon.

fn s(x: Str) -> json.Value { json.Value.Str(x) }

fn i(x: Int) -> json.Value { json.Value.Int(x) }

fn b(x: Bool) -> json.Value { json.Value.Bool(x) }

fn t(x: Time?) -> json.Value {
  match x {
    Some(v) => s(v.format_rfc3339())
    None => s("0001-01-01T00:00:00Z")
  }
}

fn smap(m: Map[Str, Str]) -> json.Value {
  if m.is_empty() {
    return json.Value.Null
  }
  var kv: List[(Str, json.Value)] = []
  for (k, v) in m {
    kv.push((k, s(v)))
  }
  json.Value.Object(kv)
}

fn slist(xs: List[Str]) -> json.Value {
  if xs.is_empty() {
    return json.Value.Null
  }
  var out: List[json.Value] = []
  for x in xs {
    out.push(s(x))
  }
  json.Value.List(out)
}

fn acl_json(rs: List[ACLRule]) -> json.Value {
  if rs.is_empty() {
    return json.Value.Null
  }
  var out: List[json.Value] = []
  for r in rs {
    let pt = match r.project_team {
      Some(p) => json.Value.Object([("ProjectNumber", s(p.project_number)), ("Team", s(p.team))])
      None => json.Value.Null
    }
    out.push(json.Value.Object([("Domain", s(r.domain)), ("Email", s(r.email)), ("Entity", s(r.entity)), ("EntityID", s(r.entity_id)), ("ProjectTeam", pt), ("Role", s(r.role))]))
  }
  json.Value.List(out)
}

fn base64_std(x: Bytes) -> Str { base64.encode(x, base64.Base64.Std) }

fn object_json(a: ObjectAttrs) -> Str {
  canon(json.Value.Object([("ACL", acl_json(a.acl)), ("Bucket", s(a.bucket)), ("CRC32C", i(a.crc32c)), ("CacheControl", s(a.cache_control)), ("ComponentCount", i(a.component_count)), ("ContentDisposition", s(a.content_disposition)), ("ContentEncoding", s(a.content_encoding)), ("ContentLanguage", s(a.content_language)), ("ContentType", s(a.content_type)), ("Created", t(a.created)), ("CustomTime", t(a.custom_time)), ("CustomerKeySHA256", s(a.customer_key_sha256)), ("Deleted", t(a.deleted)), ("Etag", s(a.etag)), ("EventBasedHold", b(a.event_based_hold)), ("Finalized", t(a.finalized)), ("Generation", i(a.generation)), ("HardDeleteTime", t(a.hard_delete_time)), ("KMSKeyName", s(a.kms_key_name)), ("MD5", s(base64_std(a.md5))), ("MediaLink", s(a.media_link)), ("Metadata", smap(a.metadata)), ("Metageneration", i(a.metageneration)), ("Name", s(a.name)), ("Owner", s(a.owner)), ("Prefix", s(a.prefix)), ("RetentionExpirationTime", t(a.retention_expiration_time)), ("Size", i(a.size)), ("SoftDeleteTime", t(a.soft_delete_time)), ("Retention", match a.retention {
    Some(r) => json.Value.Object([("Mode", s(r.mode)), ("RetainUntil", t(r.retain_until))])
    None => json.Value.Null
  }), ("StorageClass", s(a.storage_class)), ("TemporaryHold", b(a.temporary_hold)), ("Updated", t(a.updated))]))
}

fn ubla_json(u: UniformBucketLevelAccess) -> json.Value { json.Value.Object([("Enabled", b(u.enabled)), ("LockedTime", t(u.locked_time))]) }

fn bucket_json(a: BucketAttrs) -> Str {
  var cors: List[json.Value] = []
  for c in a.cors {
    cors.push(json.Value.Object([("MaxAge", i(c.max_age.nanos())), ("Methods", slist(c.methods)), ("Origins", slist(c.origins)), ("ResponseHeaders", slist(c.response_headers))]))
  }
  let enc = match a.encryption {
    Some(e) => json.Value.Object([("DefaultKMSKeyName", s(e.default_kms_key_name))])
    None => json.Value.Null
  }
  let logging = match a.logging {
    Some(l) => json.Value.Object([("LogBucket", s(l.log_bucket)), ("LogObjectPrefix", s(l.log_object_prefix))])
    None => json.Value.Null
  }
  let website = match a.website {
    Some(w) => json.Value.Object([("MainPageSuffix", s(w.main_page_suffix)), ("NotFoundPage", s(w.not_found_page))])
    None => json.Value.Null
  }
  let pap = match a.public_access_prevention {
    PublicAccessPrevention.Unknown => 0
    PublicAccessPrevention.Inherited => 1
    PublicAccessPrevention.Enforced => 2
  }
  let rpo = match a.rpo {
    RPO.Unknown => 0
    RPO.Default => 1
    RPO.AsyncTurbo => 2
  }
  var rules: List[json.Value] = []
  for r in a.lifecycle.rules {
    let c = r.condition
    let live = match c.liveness {
      Liveness.LiveAndArchived => 0
      Liveness.Live => 1
      Liveness.Archived => 2
    }
    rules.push(json.Value.Object([("Action", json.Value.Object([("StorageClass", s(r.action.storage_class)), ("Type", s(r.action.type_))])), ("Condition", json.Value.Object([("AgeInDays", i(c.age_in_days)), ("AllObjects", b(c.all_objects)), ("CreatedBefore", t(c.created_before)), ("CustomTimeBefore", t(c.custom_time_before)), ("DaysSinceCustomTime", i(c.days_since_custom_time)), ("DaysSinceNoncurrentTime", i(c.days_since_noncurrent_time)), ("Liveness", i(live)), ("MatchesPrefix", slist(c.matches_prefix)), ("MatchesStorageClasses", slist(c.matches_storage_classes)), ("MatchesSuffix", slist(c.matches_suffix)), ("NoncurrentTimeBefore", t(c.noncurrent_time_before)), ("NumNewerVersions", i(c.num_newer_versions))]))]))
  }
  let mgmt: List[(Str, json.Value)] = [
    ("Lifecycle", json.Value.Object([("Rules", if rules.is_empty() { json.Value.Null } else { json.Value.List(rules) })])),
    ("RetentionPolicy", match a.retention_policy {
      Some(p) => json.Value.Object([("EffectiveTime", t(p.effective_time)), ("IsLocked", b(p.is_locked)), ("RetentionPeriod", i(p.retention_period.nanos()))])
      None => json.Value.Null
    }),
    ("ObjectRetentionMode", s(a.object_retention_mode)),
    ("CustomPlacementConfig", match a.custom_placement_config {
      Some(p) => json.Value.Object([("DataLocations", slist(p.data_locations))])
      None => json.Value.Null
    }),
    ("Autoclass", match a.autoclass {
      Some(x) => json.Value.Object([("Enabled", b(x.enabled)), ("TerminalStorageClass", s(x.terminal_storage_class)), ("TerminalStorageClassUpdateTime", t(x.terminal_storage_class_update_time)), ("ToggleTime", t(x.toggle_time))])
      None => json.Value.Null
    }),
    ("SoftDeletePolicy", match a.soft_delete_policy {
      Some(p) => json.Value.Object([("EffectiveTime", t(p.effective_time)), ("RetentionDuration", i(p.retention_duration.nanos()))])
      None => json.Value.Null
    }),
    ("HierarchicalNamespace", match a.hierarchical_namespace {
      Some(h) => json.Value.Object([("Enabled", b(h.enabled))])
      None => json.Value.Null
    }),
  ]
  canon(json.Value.Object(mgmt + [("ACL", acl_json(a.acl)), ("BucketPolicyOnly", ubla_json(a.bucket_policy_only)), ("CORS", if cors.is_empty() { json.Value.Null } else { json.Value.List(cors) }), ("Created", t(a.created)), ("DefaultEventBasedHold", b(a.default_event_based_hold)), ("DefaultObjectACL", acl_json(a.default_object_acl)), ("Encryption", enc), ("Etag", s(a.etag)), ("Labels", smap(a.labels)), ("Location", s(a.location)), ("LocationType", s(a.location_type)), ("Logging", logging), ("MetaGeneration", i(a.meta_generation)), ("Name", s(a.name)), ("OwnerEntity", s(a.owner_entity)), ("PredefinedACL", s(a.predefined_acl)), ("PredefinedDefaultObjectACL", s(a.predefined_default_object_acl)), ("ProjectNumber", i(a.project_number)), ("PublicAccessPrevention", i(pap)), ("RPO", i(rpo)), ("RequesterPays", b(a.requester_pays)), ("StorageClass", s(a.storage_class)), ("UniformBucketLevelAccess", ubla_json(a.uniform_bucket_level_access)), ("Updated", t(a.updated)), ("VersioningEnabled", b(a.versioning_enabled)), ("Website", website)]))
}

/// A result line as the oracle prints it, with the Is lines.
fn result_lines(f: Fake, r: Result[Str, StorageErr]) {
  match r {
    Ok(x) => note(f, if x.is_empty() { "  ok" } else { "  ok ${x}" })
    Err(e) => {
      note(f, "  error ${e.display()}")
      if e.is_object_not_exist() {
        note(f, "  is ErrObjectNotExist")
      }
      if e.is_bucket_not_exist() {
        note(f, "  is ErrBucketNotExist")
      }
    }
  }
}

/// A reader's attributes and what reading it to the end gives, as the
/// oracle prints them.
fn read_lines(f: Fake, r0: Result[Reader[()], StorageErr]) {
  var r = match r0 {
    Ok(r) => r
    Err(e) => {
      result_lines(f, Err(e))
      return
    }
  }
  let a = r.attrs
  let lm = match a.last_modified {
    Some(t) => time.RFC3339_LAYOUT.format(t, time.utc())
    None => "0001-01-01T00:00:00Z"
  }
  note(f, "  attrs size=${a.size} start=${a.start_offset} gen=${a.generation} metagen=${a.metageneration} crc32c=${a.crc32c} type=${a.content_type.quote()} encoding=${a.content_encoding.quote()} cache=${a.cache_control.quote()} modified=${lm} decompressed=${a.decompressed} remain=${r.remaining()}")
  let md = r.object_metadata()
  for k in md.keys().sort() {
    note(f, "  metadata ${k}=${md.get(k) ?? ""}")
  }
  var got = b""
  var err: StorageErr? = None
  while true {
    match r.read() {
      Ok(Some(d)) => got = got + d
      Ok(None) => break
      Err(e) => {
        err = Some(e)
        break
      }
    }
  }
  note(f, "  read ${got.to_str_lossy().quote()}")
  if let Some(e) = err {
    note(f, "  read error ${e.display()}")
  }
  match r.close() {
    Err(e) => note(f, "  close error ${e.display()}")
    Ok(_) => {}
  }
  note(f, "  remain ${r.remaining()}")
}

/// Writes data in pieces of at most piece bytes, closes, and notes the
/// result as the oracle prints it.
fn write_lines(f: Fake, w0: Writer[()], data: Str, piece: Int) {
  var w = w0
  var d = data.bytes()
  while d.len() > 0 {
    let n = if piece < d.len() { piece } else { d.len() }
    match w.write(d[0..n]) {
      Err(e) => {
        note(f, "  write error ${e.display()}")
        break
      }
      Ok(_) => {}
    }
    d = d[n..d.len()]
  }
  match w.close() {
    Err(e) => note(f, "  close error ${e.display()}")
    Ok(a) => note(f, "  ok name=${a.name} gen=${a.generation} size=${a.size} crc32c=${a.crc32c}")
  }
}

/// n bytes of the oracle's repeating pattern.
fn big(n: Int) -> Str { "0123456789abcdef".repeat(n / 16 + 1)[0..n] }

/// The service's answer for an object of content s (the oracle's objFor).
fn obj_for(name: Str, s: Str) -> Str {
  "{\"kind\":\"storage#object\",\"name\":${name.quote()},\"bucket\":\"b1\",\"generation\":\"1700000000000001\",\"metageneration\":\"1\",\"size\":\"${s.len()}\",\"crc32c\":\"${gensupport.crc32c_text(s.bytes())}\",\"contentType\":\"text/plain\"}"
}

/// A copy's or compose's result as the oracle prints it.
fn ran_lines(f: Fake, r: Result[ObjectAttrs, StorageErr]) {
  match r {
    Ok(a) => note(f, "  ok name=${a.name} bucket=${a.bucket} gen=${a.generation} size=${a.size} type=${a.content_type.quote()}")
    Err(e) => result_lines(f, Err(e))
  }
}

/// A rewrite response (the oracle's rewriteReply).
fn rewrite_reply(done: Bool, token: Str, written: Int, size: Int, obj: Str) -> Str {
  if done {
    return "{\"kind\":\"storage#rewriteResponse\",\"done\":true,\"totalBytesRewritten\":\"${written}\",\"objectSize\":\"${size}\",\"resource\":${obj}}"
  }
  "{\"kind\":\"storage#rewriteResponse\",\"done\":false,\"totalBytesRewritten\":\"${written}\",\"objectSize\":\"${size}\",\"rewriteToken\":${token.quote()}}"
}

// Signing (decision 0010 step 3): the oracle's fixed time is NOW0, its
// fake signer notes what it signs and gives its SHA-256, and its RSA key
// is generated per run (none is stored).

const NOW0: Int = 1767323045

fn fake_signer(f: Fake) -> Signer {
  fn(x: Bytes) -> Bytes ! StorageErr {
    note(f, "  sign ${x.quote()}")
    Ok(crypto.sha256(x))
  }
}

fn exp1h() -> Time { Time.from_unix(NOW0 + 3600) }

/// The oracle's SignedURLOptions: robot@example.com, the fake signer,
/// GET, an hour.
fn so(f: Fake) -> SignedURLOptions { SignedURLOptions{google_access_id: "robot@example.com", sign_bytes: Some(fake_signer(f)), method: "GET", expires: Some(exp1h())} }

fn po(f: Fake) -> PostPolicyV4Options { PostPolicyV4Options{google_access_id: "robot@example.com", sign_raw_bytes: Some(fake_signer(f)), expires: Some(exp1h())} }

fn qv(kv: List[(Str, Str)]) -> url.Values {
  var q = url.values()
  for (k, v) in kv {
    q.add(k, v)
  }
  q
}

struct TestKey {
  pem: Str
  public: crypto.PublicKey
}

fn test_key(os: testing.TestOs) -> TestKey uses rand {
  let k = crypto.generate_key(os.rand, crypto.KeyAlg.Rsa) ?? e => fault(e.display())
  let pem = crypto.pem_encode(crypto.PemBlock{kind: "PRIVATE KEY", headers: {}, bytes: crypto.marshal_private_key(k)}) ?? e => fault(e.display())
  TestKey{pem: pem, public: k.public_key()}
}

/// The oracle's credentials file: a service account with the key, or an
/// impersonated account signer@example.com over it.
fn sa_json(k: TestKey, impersonated: Bool) -> Bytes {
  let sa = json.Value.Object([("type", s("service_account")), ("project_id", s("project-one")), ("private_key_id", s("key-one")), ("private_key", s(k.pem)), ("client_email", s("robot@example.com")), ("client_id", s("100000000000000000001")), ("token_uri", s("https://oauth2.fake/token"))])
  if !impersonated {
    return sa.encode().bytes()
  }
  json.Value.Object([("type", s("impersonated_service_account")), ("service_account_impersonation_url", s("https://iamcredentials.fake/v1/projects/-/serviceAccounts/signer@example.com:generateAccessToken")), ("source_credentials", sa)]).encode().bytes()
}

fn cred_client(os: testing.TestOs, j: Bytes) -> Client[()] {
  new_client(os.net, os.clock, os.rand, ClientOptions{service: option.ClientOptions{endpoint: "https://storage.fake/storage/v1/", without_authentication: true}, credentials_json: j})
}

fn signed_lines(f: Fake, r: Result[Str, StorageErr]) {
  match r {
    Ok(u) => note(f, "  url ${u}")
    Err(e) => note(f, "  error ${e.display()}")
  }
}

/// An RSA-signed URL with its signature as SIG.
fn signed_rsa_lines(f: Fake, r: Result[Str, StorageErr]) {
  let u = match r {
    Ok(u) => u
    Err(e) => {
      note(f, "  error ${e.display()}")
      return
    }
  }
  let i = u.find("?") ?? u.len()
  var parts: List[Str] = []
  var n = 0
  for p in u[i + 1..u.len()].split("&") {
    if p.starts_with("Signature=") || p.starts_with("X-Goog-Signature=") {
      let k = p[0..(p.find("=") ?? 0)]
      let v = p[k.len() + 1..p.len()]
      n = if k == "Signature" { (base64.decode(url.query_unescape(v) ?? _ => "", base64.Base64.Std) ?? _ => b"").len() } else { (Bytes.from_hex(v) ?? b"").len() }
      parts.push("${k}=SIG")
    } else {
      parts.push(p)
    }
  }
  note(f, "  url ${u[0..i]}?${parts.join("&")}")
  note(f, "  signature ${n} bytes")
}

fn policy_lines(f: Fake, r: Result[PostPolicyV4, StorageErr]) {
  let p = match r {
    Ok(p) => p
    Err(e) => {
      note(f, "  error ${e.display()}")
      return
    }
  }
  note(f, "  url ${p.url}")
  for k in p.fields.keys().sort() {
    let v = p.fields.get_or_fault(k, "a key")
    if k == "policy" {
      note(f, "  field policy (decoded) ${(base64.decode(v, base64.Base64.Std) ?? _ => b"").to_str_lossy()}")
    } else {
      note(f, "  field ${k}=${v}")
    }
  }
}

/// An RSA-signed policy: checked with the public key, its signature SIG.
fn policy_rsa_lines(f: Fake, r: Result[PostPolicyV4, StorageErr], k: TestKey) {
  match r {
    Ok(p) => {
      let sig = Bytes.from_hex(p.fields.get("x-goog-signature") ?? "") ?? b""
      let ok = crypto.verify(k.public, crypto.Hash.Sha256, (p.fields.get("policy") ?? "").bytes(), sig)
      note(f, if ok { "  verified" } else { "  NOT verified" })
      var fs = p.fields
      fs.put("x-goog-signature", "SIG")
      policy_lines(f, Ok(PostPolicyV4{url: p.url, fields: fs}))
    }
    Err(e) => policy_lines(f, Err(e))
  }
}

// Access (decision 0010 step 3): results printed as the oracle prints
// them (Go's field names; a nil list or map as null).

fn unit_lines(f: Fake, r: Result[(), StorageErr]) {
  match r {
    Ok(_) => result_lines(f, Ok(""))
    Err(e) => result_lines(f, Err(e))
  }
}

fn acl_lines(f: Fake, r: Result[List[ACLRule], StorageErr]) {
  match r {
    Ok(rs) => result_lines(f, Ok(canon(acl_json(rs))))
    Err(e) => result_lines(f, Err(e))
  }
}

fn hmac_json(k: HMACKey) -> Str {
  canon(json.Value.Object([("AccessID", s(k.access_id)), ("CreatedTime", t(k.created_time)), ("Etag", s(k.etag)), ("ID", s(k.id)), ("ProjectID", s(k.project_id)), ("Secret", s(k.secret)), ("ServiceAccountEmail", s(k.service_account_email)), ("State", s(k.state)), ("UpdatedTime", t(k.updated_time))]))
}

fn hmac_lines(f: Fake, r: Result[HMACKey, StorageErr]) {
  match r {
    Ok(k) => result_lines(f, Ok(hmac_json(k)))
    Err(e) => result_lines(f, Err(e))
  }
}

fn keys_lines(f: Fake, it0: HMACKeysIterator[()]) {
  var it = it0
  while true {
    match it.next() {
      Ok(Some(k)) => note(f, "  key ${hmac_json(k)}")
      Ok(None) => {
        note(f, "  done")
        return
      }
      Err(e) => {
        result_lines(f, Err(e))
        return
      }
    }
  }
}

fn notification_json(n: Notification) -> Str {
  let attrs = if n.custom_attributes.is_empty() { json.Value.Null } else { smap(n.custom_attributes) }
  let events = if n.event_types.is_empty() { json.Value.Null } else { slist(n.event_types) }
  canon(json.Value.Object([("CustomAttributes", attrs), ("EventTypes", events), ("ID", s(n.id)), ("ObjectNamePrefix", s(n.object_name_prefix)), ("PayloadFormat", s(n.payload_format)), ("TopicID", s(n.topic_id)), ("TopicProjectID", s(n.topic_project_id))]))
}

fn notification_lines(f: Fake, r: Result[Notification, StorageErr]) {
  match r {
    Ok(n) => result_lines(f, Ok(notification_json(n)))
    Err(e) => result_lines(f, Err(e))
  }
}

fn notes_lines(f: Fake, r: Result[Map[Str, Notification], StorageErr]) {
  match r {
    Ok(m) => {
      for k in m.keys().sort() {
        note(f, "  notification ${k} ${notification_json(m.get_or_fault(k, "a key"))}")
      }
    }
    Err(e) => result_lines(f, Err(e))
  }
}

/// Go's %q of a []string.
fn go_list(xs: List[Str]) -> Str {
  var q: List[Str] = []
  for x in xs {
    q.push(x.quote())
  }
  "[${q.join(" ")}]"
}

/// A policy as the oracle's showPolicy prints it (Go's v1 Policy keeps no
/// version: 0).
fn show_policy(f: Fake, p: Policy) {
  for r in p.roles() {
    note(f, "  role ${r} members ${go_list(p.members(r))}")
  }
  for b in p.bindings {
    if let Some(c) = b.condition {
      note(f, "  condition ${b.role} title=${c.title.quote()} expression=${c.expression.quote()}")
    }
  }
  note(f, "  etag ${p.etag.quote()} version 0")
}

/// The oracle's "iam policy, edited and set".
fn iam_edit_lines(f: Fake, h: IAMHandle[()]) {
  var p = match h.policy() {
    Ok(p) => p
    Err(e) => {
      result_lines(f, Err(e))
      return
    }
  }
  show_policy(f, p)
  p.add("user:b@example.com", IAM_VIEWER)
  p.add("user:a@example.com", "roles/storage.objectViewer")
  p.remove("allUsers", "roles/storage.objectViewer")
  p.remove("user:a@example.com", "roles/storage.admin")
  p.remove("nobody", IAM_OWNER)
  note(f, "  has ${p.has_role("user:b@example.com", IAM_VIEWER)} ${p.has_role("allUsers", "roles/storage.objectViewer")}")
  show_policy(f, p)
  unit_lines(f, h.set_policy(p))
}

/// The oracle's "iam policy v3".
fn iam_v3_lines(f: Fake, h: IAMHandle[()]) {
  match h.policy() {
    Ok(p) => {
      note(f, "  bindings ${p.bindings.len()}")
      unit_lines(f, h.set_policy(p))
    }
    Err(e) => result_lines(f, Err(e))
  }
}

fn perms_lines(f: Fake, r: Result[List[Str], StorageErr]) {
  match r {
    Ok(ps) => result_lines(f, Ok(canon(slist(ps))))
    Err(e) => result_lines(f, Err(e))
  }
}

fn policy_err_lines(f: Fake, r: Result[Policy, StorageErr]) {
  match r {
    Ok(_) => result_lines(f, Ok(""))
    Err(e) => result_lines(f, Err(e))
  }
}

fn str_lines(f: Fake, r: Result[Str, StorageErr]) {
  match r {
    Ok(x) => result_lines(f, Ok(x.quote()))
    Err(e) => result_lines(f, Err(e))
  }
}

/// k=v pairs sorted by key, a stable sort (the values of a key keep their
/// order).
fn by_key(pairs: List[Str]) -> List[Str] {
  var keys: List[Str] = []
  for p in pairs {
    let k = p[0..(p.find("=") ?? p.len())]
    if !keys.contains(k) {
      keys.push(k)
    }
  }
  var out: List[Str] = []
  for k in keys.sort() {
    for p in pairs {
      if p[0..(p.find("=") ?? p.len())] == k {
        out.push(p)
      }
    }
  }
  out
}
