  match svc.buckets.relocate("id1/ x", json.decode_str[RelocateBucketRequest]("{\"destinationCustomPlacementConfig\":{\"dataLocations\":[\"s-datalocations\"]},\"destinationKmsKeyName\":\"s-destinationkmskeyname\",\"destinationLocation\":\"s-destinationlocation\",\"validateOnly\":true}") ?? e => fault(e.display()), options: BucketsRelocateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
