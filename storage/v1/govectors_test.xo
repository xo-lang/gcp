  gv_note(f, "CALL storage.objects.insert resumable")
  match svc.objects.insert_media(os.clock, os.rand, "id1/ x", json.decode_str[Object]("{\"acl\":[{\"bucket\":\"s-bucket\",\"domain\":\"s-domain\",\"email\":\"s-email\",\"entity\":\"s-entity\",\"entityId\":\"s-entityid\",\"etag\":\"s-etag\",\"generation\":\"7\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"object\":\"s-object\",\"projectTeam\":{\"projectNumber\":\"s-projectnumber\",\"team\":\"s-team\"},\"role\":\"s-role\",\"selfLink\":\"s-selflink\"}],\"bucket\":\"s-bucket\",\"cacheControl\":\"s-cachecontrol\",\"componentCount\":7,\"contentDisposition\":\"s-contentdisposition\",\"contentEncoding\":\"s-contentencoding\",\"contentLanguage\":\"s-contentlanguage\",\"contentType\":\"s-contenttype\",\"contexts\":{\"custom\":{\"k1\":{\"createTime\":\"s-createtime\",\"extendedDataTypeUrl\":\"s-extendeddatatypeurl\",\"updateTime\":\"s-updatetime\",\"value\":\"s-value\"}}},\"crc32c\":\"s-crc32c\",\"customTime\":\"s-customtime\",\"customerEncryption\":{\"encryptionAlgorithm\":\"s-encryptionalgorithm\",\"keySha256\":\"s-keysha256\"},\"etag\":\"s-etag\",\"eventBasedHold\":true,\"generation\":\"7\",\"hardDeleteTime\":\"s-harddeletetime\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"kmsKeyName\":\"s-kmskeyname\",\"md5Hash\":\"s-md5hash\",\"mediaLink\":\"s-medialink\",\"metadata\":{\"k1\":\"s-metadata\"},\"metageneration\":\"7\",\"name\":\"s-name\",\"owner\":{\"entity\":\"s-entity\",\"entityId\":\"s-entityid\"},\"restoreToken\":\"s-restoretoken\",\"retention\":{\"mode\":\"s-mode\",\"retainUntilTime\":\"s-retainuntiltime\"},\"retentionExpirationTime\":\"s-retentionexpirationtime\",\"selfLink\":\"s-selflink\",\"size\":\"7\",\"softDeleteTime\":\"s-softdeletetime\",\"storageClass\":\"s-storageclass\",\"temporaryHold\":true,\"timeCreated\":\"s-timecreated\",\"timeDeleted\":\"s-timedeleted\",\"timeFinalized\":\"s-timefinalized\",\"timeStorageClassUpdated\":\"s-timestorageclassupdated\",\"updated\":\"s-updated\"}") ?? e => fault(e.display()), media: gensupport.Media{data: gv_big(), content_type: "text/plain", chunk_size: 262144}, options: ObjectsInsertOptions{content_encoding: Some("s-contentencoding"), if_generation_match: Some(7), if_generation_not_match: Some(7), if_metageneration_match: Some(7), if_metageneration_not_match: Some(7), kms_key_name: Some("s-kmskeyname"), name: Some("s-name"), predefined_acl: Some("s-predefinedacl"), projection: Some("s-projection"), user_project: Some("s-userproject"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
