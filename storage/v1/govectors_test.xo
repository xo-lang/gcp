  "OUT: {\"items\":[{\"admissionPolicy\":\"s-admissionpolicy\",\"bucket\":\"s-bucket\",\"cacheType\":\"s-cachetype\",\"createTime\":\"s-createtime\",\"id\":\"s-id\",\"ingestOnWrite\":true,\"kind\":\"s-kind\",\"pendingUpdate\":true,\"rapidCacheId\":\"s-rapidcacheid\",\"selfLink\":\"s-selflink\",\"state\":\"s-state\",\"ttl\":\"s-ttl\",\"updateTime\":\"s-updatetime\",\"zone\":\"s-zone\"}],\"kind\":\"s-kind\"}",
  "OUT: ok",
]

test "Go's storage.rapidCaches.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"admissionPolicy\":\"s-admissionpolicy\",\"bucket\":\"s-bucket\",\"cacheType\":\"s-cachetype\",\"createTime\":\"s-createtime\",\"id\":\"s-id\",\"ingestOnWrite\":true,\"kind\":\"s-kind\",\"pendingUpdate\":true,\"rapidCacheId\":\"s-rapidcacheid\",\"selfLink\":\"s-selflink\",\"state\":\"s-state\",\"ttl\":\"s-ttl\",\"updateTime\":\"s-updatetime\",\"zone\":\"s-zone\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"admissionPolicy\":\"s-admissionpolicy\",\"bucket\":\"s-bucket\",\"cacheType\":\"s-cachetype\",\"createTime\":\"s-createtime\",\"id\":\"s-id\",\"ingestOnWrite\":true,\"kind\":\"s-kind\",\"pendingUpdate\":true,\"rapidCacheId\":\"s-rapidcacheid\",\"selfLink\":\"s-selflink\",\"state\":\"s-state\",\"ttl\":\"s-ttl\",\"updateTime\":\"s-updatetime\",\"zone\":\"s-zone\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL storage.rapidCaches.list pages")
  var p = svc.rapid_caches.list_pages("id1/ x", options: RapidCachesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_96)
}

const GO_97: List[Str] = [
  "CALL storage.rapidCaches.update",
  "REQ PATCH https://storage.googleapis.com/storage/v1/b/id1%2F%20x/rapidCaches/id2%2F%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"admissionPolicy\":\"s-admissionpolicy\",\"bucket\":\"s-bucket\",\"cacheType\":\"s-cachetype\",\"createTime\":\"s-createtime\",\"id\":\"s-id\",\"ingestOnWrite\":true,\"kind\":\"s-kind\",\"pendingUpdate\":true,\"rapidCacheId\":\"s-rapidcacheid\",\"selfLink\":\"s-selflink\",\"state\":\"s-state\",\"ttl\":\"s-ttl\",\"updateTime\":\"s-updatetime\",\"zone\":\"s-zone\"}",
  "",
  "  SERVED 200 {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"kind\":\"s-kind\",\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"},\"selfLink\":\"s-selflink\"}",
  "OUT: {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"kind\":\"s-kind\",\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"},\"selfLink\":\"s-selflink\"}",
]

test "Go's storage.rapidCaches.update" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"kind\":\"s-kind\",\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"},\"selfLink\":\"s-selflink\"}")
  gv_note(f, "CALL storage.rapidCaches.update")
  match svc.rapid_caches.update("id1/ x", "id2/ x", json.decode_str[RapidCache]("{\"admissionPolicy\":\"s-admissionpolicy\",\"bucket\":\"s-bucket\",\"cacheType\":\"s-cachetype\",\"createTime\":\"s-createtime\",\"id\":\"s-id\",\"ingestOnWrite\":true,\"kind\":\"s-kind\",\"pendingUpdate\":true,\"rapidCacheId\":\"s-rapidcacheid\",\"selfLink\":\"s-selflink\",\"state\":\"s-state\",\"ttl\":\"s-ttl\",\"updateTime\":\"s-updatetime\",\"zone\":\"s-zone\"}") ?? e => fault(e.display()), options: RapidCachesUpdateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_97)
}
