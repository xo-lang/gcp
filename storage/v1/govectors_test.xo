  "REQ GET https://storage.googleapis.com/storage/v1/b/id1%2F%20x/o/id2%2F%20x/iam?alt=json&fields=kind%2Cid&generation=7&prettyPrint=false&userProject=s-userproject",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"bindings\":[{\"condition\":{\"description\":\"s-description\",\"expression\":\"s-expression\",\"location\":\"s-location\",\"title\":\"s-title\"},\"members\":[\"s-members\"],\"role\":\"s-role\"}],\"etag\":\"YWI=\",\"kind\":\"s-kind\",\"resourceId\":\"s-resourceid\",\"version\":7}",
  "OUT: {\"bindings\":[{\"condition\":{\"description\":\"s-description\",\"expression\":\"s-expression\",\"location\":\"s-location\",\"title\":\"s-title\"},\"members\":[\"s-members\"],\"role\":\"s-role\"}],\"etag\":\"YWI=\",\"kind\":\"s-kind\",\"resourceId\":\"s-resourceid\",\"version\":7}",
]

test "Go's storage.objects.getIamPolicy" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"bindings\":[{\"condition\":{\"description\":\"s-description\",\"expression\":\"s-expression\",\"location\":\"s-location\",\"title\":\"s-title\"},\"members\":[\"s-members\"],\"role\":\"s-role\"}],\"etag\":\"YWI=\",\"kind\":\"s-kind\",\"resourceId\":\"s-resourceid\",\"version\":7}")
  gv_note(f, "CALL storage.objects.getIamPolicy")
  match svc.objects.get_iam_policy("id1/ x", "id2/ x", options: ObjectsGetIamPolicyOptions{generation: Some(7), user_project: Some("s-userproject"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_66)
}

