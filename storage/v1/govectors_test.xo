test "Go's storage.managedFolders.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"bucket\":\"s-bucket\",\"createTime\":\"s-createtime\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"metageneration\":\"7\",\"name\":\"s-name\",\"rapidCacheConfig\":{},\"selfLink\":\"s-selflink\",\"updateTime\":\"s-updatetime\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"bucket\":\"s-bucket\",\"createTime\":\"s-createtime\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"metageneration\":\"7\",\"name\":\"s-name\",\"rapidCacheConfig\":{},\"selfLink\":\"s-selflink\",\"updateTime\":\"s-updatetime\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL storage.managedFolders.list pages")
  var p = svc.managed_folders.list_pages("id1/ x", options: ManagedFoldersListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), prefix: Some("s-prefix"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_46)
}

