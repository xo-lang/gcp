test "Go's storage.projects.hmacKeys.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"accessId\":\"s-accessid\",\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"projectId\":\"s-projectid\",\"selfLink\":\"s-selflink\",\"serviceAccountEmail\":\"s-serviceaccountemail\",\"state\":\"s-state\",\"timeCreated\":\"s-timecreated\",\"updated\":\"s-updated\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"accessId\":\"s-accessid\",\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"projectId\":\"s-projectid\",\"selfLink\":\"s-selflink\",\"serviceAccountEmail\":\"s-serviceaccountemail\",\"state\":\"s-state\",\"timeCreated\":\"s-timecreated\",\"updated\":\"s-updated\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL storage.projects.hmacKeys.list pages")
  var p = svc.projects.hmac_keys.list_pages("id1/ x", options: ProjectsHmacKeysListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), service_account_email: Some("s-serviceaccountemail"), show_deleted_keys: Some(true), user_project: Some("s-userproject"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_89)
}

