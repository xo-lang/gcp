test "Go's cloudcommerceprocurement.providers.entitlements.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"entitlements\":[{\"account\":\"s-account\",\"cancellationReason\":\"s-cancellationreason\",\"createTime\":\"s-createtime\",\"entitlementBenefitIds\":[\"s-entitlementbenefitids\"],\"inputProperties\":{\"k\":\"v\"},\"messageToUser\":\"s-messagetouser\",\"name\":\"s-name\",\"newOfferEndTime\":\"s-newofferendtime\",\"newOfferStartTime\":\"s-newofferstarttime\",\"newPendingOffer\":\"s-newpendingoffer\",\"newPendingOfferDuration\":\"s-newpendingofferduration\",\"newPendingPlan\":\"s-newpendingplan\",\"offer\":\"s-offer\",\"offerDuration\":\"s-offerduration\",\"offerEndTime\":\"s-offerendtime\",\"orderId\":\"s-orderid\",\"plan\":\"s-plan\",\"product\":\"s-product\",\"productExternalName\":\"s-productexternalname\",\"provider\":\"s-provider\",\"quoteExternalName\":\"s-quoteexternalname\",\"state\":\"s-state\",\"subscriptionEndTime\":\"s-subscriptionendtime\",\"updateTime\":\"s-updatetime\",\"usageReportingId\":\"s-usagereportingid\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"entitlements\":[{\"account\":\"s-account\",\"cancellationReason\":\"s-cancellationreason\",\"createTime\":\"s-createtime\",\"entitlementBenefitIds\":[\"s-entitlementbenefitids\"],\"inputProperties\":{\"k\":\"v\"},\"messageToUser\":\"s-messagetouser\",\"name\":\"s-name\",\"newOfferEndTime\":\"s-newofferendtime\",\"newOfferStartTime\":\"s-newofferstarttime\",\"newPendingOffer\":\"s-newpendingoffer\",\"newPendingOfferDuration\":\"s-newpendingofferduration\",\"newPendingPlan\":\"s-newpendingplan\",\"offer\":\"s-offer\",\"offerDuration\":\"s-offerduration\",\"offerEndTime\":\"s-offerendtime\",\"orderId\":\"s-orderid\",\"plan\":\"s-plan\",\"product\":\"s-product\",\"productExternalName\":\"s-productexternalname\",\"provider\":\"s-provider\",\"quoteExternalName\":\"s-quoteexternalname\",\"state\":\"s-state\",\"subscriptionEndTime\":\"s-subscriptionendtime\",\"updateTime\":\"s-updatetime\",\"usageReportingId\":\"s-usagereportingid\"}]}")
  gv_note(f, "CALL cloudcommerceprocurement.providers.entitlements.list pages")
  var p = svc.providers.entitlements.list_pages("id1/ x", options: ProvidersEntitlementsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_10)
}

