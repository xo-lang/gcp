  "OUT: {\"footer\":{\"matchingRowCount\":\"7\",\"warnings\":[{\"description\":\"s-description\",\"type\":\"s-type\"}]},\"header\":{\"dateRange\":{},\"localizationSettings\":{\"currencyCode\":\"s-currencycode\",\"languageCode\":\"s-languagecode\"},\"reportingTimeZone\":\"s-reportingtimezone\"},\"row\":{\"dimensionValues\":{\"k1\":{\"displayLabel\":\"s-displaylabel\",\"value\":\"s-value\"}},\"metricValues\":{\"k1\":{\"doubleValue\":1.5,\"integerValue\":\"7\",\"microsValue\":\"7\"}}}}",
]

test "Go's admob.accounts.networkReport.generate" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"footer\":{\"matchingRowCount\":\"7\",\"warnings\":[{\"description\":\"s-description\",\"type\":\"s-type\"}]},\"header\":{\"dateRange\":{},\"localizationSettings\":{\"currencyCode\":\"s-currencycode\",\"languageCode\":\"s-languagecode\"},\"reportingTimeZone\":\"s-reportingtimezone\"},\"row\":{\"dimensionValues\":{\"k1\":{\"displayLabel\":\"s-displaylabel\",\"value\":\"s-value\"}},\"metricValues\":{\"k1\":{\"doubleValue\":1.5,\"integerValue\":\"7\",\"microsValue\":\"7\"}}}}")
  gv_note(f, "CALL admob.accounts.networkReport.generate")
  match svc.accounts.network_report.generate("id1/ x", json.decode_str[GenerateNetworkReportRequest]("{\"reportSpec\":{\"dateRange\":{},\"dimensionFilters\":[{\"dimension\":\"s-dimension\"}],\"dimensions\":[\"s-dimensions\"],\"localizationSettings\":{\"currencyCode\":\"s-currencycode\",\"languageCode\":\"s-languagecode\"},\"maxReportRows\":7,\"metrics\":[\"s-metrics\"],\"sortConditions\":[{\"dimension\":\"s-dimension\",\"metric\":\"s-metric\",\"order\":\"s-order\"}],\"timeZone\":\"s-timezone\"}}") ?? e => fault(e.display()), options: AccountsNetworkReportGenerateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_18)
}
