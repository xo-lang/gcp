use std/json

const GV_HOST: Str = "https://admob.googleapis.com"

const GO_0: List[Str] = [
  "CALL admob.accounts.get",
  "REQ GET https://admob.googleapis.com/v1/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"currencyCode\":\"s-currencycode\",\"name\":\"s-name\",\"publisherId\":\"s-publisherid\",\"reportingTimeZone\":\"s-reportingtimezone\"}",
  "OUT: {\"currencyCode\":\"s-currencycode\",\"name\":\"s-name\",\"publisherId\":\"s-publisherid\",\"reportingTimeZone\":\"s-reportingtimezone\"}",
]

test "Go's admob.accounts.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"currencyCode\":\"s-currencycode\",\"name\":\"s-name\",\"publisherId\":\"s-publisherid\",\"reportingTimeZone\":\"s-reportingtimezone\"}")
  gv_note(f, "CALL admob.accounts.get")
  match svc.accounts.get("id1/ x", options: AccountsGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

