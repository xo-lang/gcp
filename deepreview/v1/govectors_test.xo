  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"customLimitEnabled\":true,\"maxReviewCountPerWeek\":7,\"name\":\"s-name\",\"nextAvailableTime\":\"s-nextavailabletime\",\"remainingReviewCount\":7,\"usedReviewCount\":7}")
  gv_note(f, "CALL deepreview.getUserQuota")
  match svc.v1.get_user_quota("id1/ x", options: V1GetUserQuotaOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_10)
}
