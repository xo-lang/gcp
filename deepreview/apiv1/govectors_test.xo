test "Go's deepreview.documents.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"documents\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"driveSource\":{\"fileId\":\"s-fileid\",\"resourceKey\":\"s-resourcekey\",\"resourceKeySet\":true,\"revisionId\":\"s-revisionid\"},\"latestReviewSummary\":{\"createTime\":\"s-createtime\",\"review\":\"s-review\",\"state\":\"s-state\"},\"name\":\"s-name\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"documents\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"driveSource\":{\"fileId\":\"s-fileid\",\"resourceKey\":\"s-resourcekey\",\"resourceKeySet\":true,\"revisionId\":\"s-revisionid\"},\"latestReviewSummary\":{\"createTime\":\"s-createtime\",\"review\":\"s-review\",\"state\":\"s-state\"},\"name\":\"s-name\"}]}")
  gv_note(f, "CALL deepreview.documents.list pages")
  var p = svc.documents.list_pages(options: DocumentsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_4)
}

