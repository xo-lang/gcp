test "Go's deepreview.documents.reviews.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"reviews\":[{\"createTime\":\"s-createtime\",\"endTime\":\"s-endtime\",\"name\":\"s-name\",\"progressPercent\":7,\"result\":{\"reviewMarkdown\":\"s-reviewmarkdown\"},\"runConfig\":{\"geminiApiKey\":\"s-geminiapikey\",\"geminiApiKeySet\":true,\"model\":\"s-model\",\"thinkingLevel\":\"s-thinkinglevel\",\"topology\":\"s-topology\",\"userPrompt\":\"s-userprompt\"},\"startTime\":\"s-starttime\",\"state\":\"s-state\"}]}")
  gv_queue(f, "{\"reviews\":[{\"createTime\":\"s-createtime\",\"endTime\":\"s-endtime\",\"name\":\"s-name\",\"progressPercent\":7,\"result\":{\"reviewMarkdown\":\"s-reviewmarkdown\"},\"runConfig\":{\"geminiApiKey\":\"s-geminiapikey\",\"geminiApiKeySet\":true,\"model\":\"s-model\",\"thinkingLevel\":\"s-thinkinglevel\",\"topology\":\"s-topology\",\"userPrompt\":\"s-userprompt\"},\"startTime\":\"s-starttime\",\"state\":\"s-state\"}]}")
  gv_note(f, "CALL deepreview.documents.reviews.list pages")
  var p = svc.documents.reviews.list_pages("id1/ x", options: DocumentsReviewsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_8)
}

