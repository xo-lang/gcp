const GO_0: List[Str] = [
  "CALL chromeuxreport.records.queryHistoryRecord",
  "REQ POST https://chromeuxreport.googleapis.com/v1/records:queryHistoryRecord?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"collectionPeriodCount\":7,\"formFactor\":\"s-formfactor\",\"metrics\":[\"s-metrics\"],\"origin\":\"s-origin\",\"url\":\"s-url\"}",
