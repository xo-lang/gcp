  match svc.records.query_history_record(json.decode_str[QueryHistoryRequest]("{\"collectionPeriodCount\":7,\"formFactor\":\"s-formfactor\",\"metrics\":[\"s-metrics\"],\"origin\":\"s-origin\",\"url\":\"s-url\"}") ?? e => fault(e.display()), options: RecordsQueryHistoryRecordOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
