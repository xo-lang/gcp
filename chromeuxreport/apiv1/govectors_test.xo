]

test "Go's chromeuxreport.records.queryHistoryRecord" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"record\":{\"collectionPeriods\":[{}],\"key\":{\"formFactor\":\"s-formfactor\",\"origin\":\"s-origin\",\"url\":\"s-url\"},\"metrics\":{\"k1\":{}}},\"urlNormalizationDetails\":{\"normalizedUrl\":\"s-normalizedurl\",\"originalUrl\":\"s-originalurl\"}}")
