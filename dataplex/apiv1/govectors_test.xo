  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"categories\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"parent\":\"s-parent\",\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\",\"unreachableLocations\":[\"s-unreachablelocations\"]}")
  gv_queue(f, "{\"categories\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"parent\":\"s-parent\",\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"unreachableLocations\":[\"s-unreachablelocations\"]}")
  gv_note(f, "CALL dataplex.projects.locations.glossaries.categories.list pages")
  var p = svc.projects.locations.glossaries.categories.list_pages("id1/ x", options: ProjectsLocationsGlossariesCategoriesListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_148)
}

