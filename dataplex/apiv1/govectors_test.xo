  gv_queue(f, "{\"dataDomainBindings\":[{\"createTime\":\"s-createtime\",\"name\":\"s-name\",\"resource\":\"s-resource\",\"uid\":\"s-uid\"}]}")
  gv_note(f, "CALL dataplex.projects.locations.dataDomains.bindings.list pages")
  var p = svc.projects.locations.data_domains.bindings.list_pages("id1/ x", options: ProjectsLocationsDataDomainsBindingsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
