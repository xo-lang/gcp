  /// Output only. The result of a data discovery scan.
  pub data_discovery_result as "dataDiscoveryResult,omitempty": GoogleCloudDataplexV1DataDiscoveryResult? = None
  /// Settings for a data discovery scan.
  pub data_discovery_spec as "dataDiscoverySpec,omitempty": GoogleCloudDataplexV1DataDiscoverySpec? = None
  /// Output only. The result of a data documentation scan.
  pub data_documentation_result as "dataDocumentationResult,omitempty": GoogleCloudDataplexV1DataDocumentationResult? = None
  /// Settings for a data documentation scan.
  pub data_documentation_spec as "dataDocumentationSpec,omitempty": GoogleCloudDataplexV1DataDocumentationSpec? = None
  /// Output only. The result of a data profile scan.
  pub data_profile_result as "dataProfileResult,omitempty": GoogleCloudDataplexV1DataProfileResult? = None
  /// Settings for a data profile scan.
  pub data_profile_spec as "dataProfileSpec,omitempty": GoogleCloudDataplexV1DataProfileSpec? = None
  /// Output only. The result of a data quality scan.
  pub data_quality_result as "dataQualityResult,omitempty": GoogleCloudDataplexV1DataQualityResult? = None
  /// Settings for a data quality scan.
  pub data_quality_spec as "dataQualitySpec,omitempty": GoogleCloudDataplexV1DataQualitySpec? = None
  /// Optional. Description of the scan. Must be between 1-1024 characters.
  pub description as "description,omitempty": Str = ""
  /// Optional. User friendly display name. Must be between 1-256 characters.
  pub display_name as "displayName,omitempty": Str = ""
  /// Optional. Immutable. The identity to run the datascan. If not specified, defaults to the Dataplex Service Agent.
  pub execution_identity as "executionIdentity,omitempty": GoogleCloudDataplexV1ExecutionIdentity? = None
  /// Optional. DataScan execution settings.If not specified, the fields in it will use their default values.
  pub execution_spec as "executionSpec,omitempty": GoogleCloudDataplexV1DataScanExecutionSpec? = None
  /// Output only. Status of the data scan execution.
