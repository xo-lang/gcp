ength\":\"7\",\"md5Hash\":\"YWI=\",\"path\":\"s-path\",\"referenceType\":\"s-referencetype\",\"sha1Hash\":\"YWI=\"}},\"diffUploadRequest\":{\"checksumsInfo\":{\"blobRef\":\"YWI=\",\"cosmoBinaryReference\":\"YWI=\",\"crc32cHash\":7,\"inline\":\"YWI=\",\"length\":\"7\",\"md5Hash\":\"YWI=\",\"path\":\"s-path\",\"referenceType\":\"s-referencetype\",\"sha1Hash\":\"YWI=\"},\"objectInfo\":{\"blobRef\":\"YWI=\",\"cosmoBinaryReference\":\"YWI=\",\"crc32cHash\":7,\"inline\":\"YWI=\",\"length\":\"7\",\"md5Hash\":\"YWI=\",\"path\":\"s-path\",\"referenceType\":\"s-referencetype\",\"sha1Hash\":\"YWI=\"},\"objectVersion\":\"s-objectversion\"},\"diffUploadResponse\":{\"objectVersion\":\"s-objectversion\",\"originalObject\":{\"blobRef\":\"YWI=\",\"cosmoBinaryReference\":\"YWI=\",\"crc32cHash\":7,\"inline\":\"YWI=\",\"length\":\"7\",\"md5Hash\":\"YWI=\",\"path\":\"s-path\",\"referenceType\":\"s-referencetype\",\"sha1Hash\":\"YWI=\"}},\"diffVersionResponse\":{\"objectSizeBytes\":\"7\",\"objectVersion\":\"s-objectversion\"},\"downloadParameters\":{\"allowGzipCompression\":true,\"ignoreRange\":true},\"filename\":\"s-filename\",\"hash\":\"s-hash\",\"hashVerified\":true,\"inline\":\"YWI=\",\"isPotentialRetry\":true,\"length\":\"7\",\"md5Hash\":\"YWI=\",\"mediaId\":\"YWI=\",\"objectId\":{\"bucketName\":\"s-bucketname\",\"generation\":\"7\",\"objectName\":\"s-objectname\"},\"path\":\"s-path\",\"referenceType\":\"s-referencetype\",\"sha1Hash\":\"YWI=\",\"sha256Hash\":\"YWI=\",\"sha512Hash\":\"YWI=\",\"timestamp\":\"7\",\"token\":\"s-token\"}")
