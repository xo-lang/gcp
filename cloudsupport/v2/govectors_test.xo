test "Go's cloudsupport.caseClassifications.search pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"caseClassifications\":[{\"displayName\":\"s-displayname\",\"id\":\"s-id\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"caseClassifications\":[{\"displayName\":\"s-displayname\",\"id\":\"s-id\"}]}")
  gv_note(f, "CALL cloudsupport.caseClassifications.search pages")
  var p = svc.case_classifications.search_pages(options: CaseClassificationsSearchOptions{page_size: Some(7), page_token: Some("s-pagetoken"), query: Some("s-query"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_1)
}

