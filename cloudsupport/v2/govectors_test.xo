  "REQ POST https://cloudsupport.googleapis.com/upload/v2/id1/%20x/attachments?alt=json&fields=kind%2Cid&prettyPrint=false&uploadType=multipart",
  "  H content-type=multipart/related; boundary=BOUNDARY | x-extra=v1",
  "  B --BOUNDARY\u{000d}",
  "Content-Type: application/json\u{000d}",
  "\u{000d}",
  "{\"attachment\":{\"createTime\":\"s-createtime\",\"creator\":{\"displayName\":\"s-displayname\",\"email\":\"s-email\",\"googleSupport\":true,\"username\":\"s-username\"},\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"name\":\"s-name\",\"sizeBytes\":\"7\"}}",
  "\u{000d}",
  "--BOUNDARY\u{000d}",
  "Content-Type: text/plain\u{000d}",
  "\u{000d}",
  "hello media\u{000d}",
  "--BOUNDARY--\u{000d}",
  "",
  "  SERVED 200 {\"createTime\":\"s-createtime\",\"creator\":{\"displayName\":\"s-displayname\",\"email\":\"s-email\",\"googleSupport\":true,\"username\":\"s-username\"},\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"name\":\"s-name\",\"sizeBytes\":\"7\"}",
  "OUT: {\"createTime\":\"s-createtime\",\"creator\":{\"displayName\":\"s-displayname\",\"email\":\"s-email\",\"googleSupport\":true,\"username\":\"s-username\"},\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"name\":\"s-name\",\"sizeBytes\":\"7\"}",
]

test "Go's cloudsupport.media.upload media" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"createTime\":\"s-createtime\",\"creator\":{\"displayName\":\"s-displayname\",\"email\":\"s-email\",\"googleSupport\":true,\"username\":\"s-username\"},\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"name\":\"s-name\",\"sizeBytes\":\"7\"}")
