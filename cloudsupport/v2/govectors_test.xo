test "Go's cloudsupport.cases.comments.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"comments\":[{\"body\":\"s-body\",\"createTime\":\"s-createtime\",\"creator\":{\"displayName\":\"s-displayname\",\"email\":\"s-email\",\"googleSupport\":true,\"username\":\"s-username\"},\"name\":\"s-name\",\"plainTextBody\":\"s-plaintextbody\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"comments\":[{\"body\":\"s-body\",\"createTime\":\"s-createtime\",\"creator\":{\"displayName\":\"s-displayname\",\"email\":\"s-email\",\"googleSupport\":true,\"username\":\"s-username\"},\"name\":\"s-name\",\"plainTextBody\":\"s-plaintextbody\"}]}")
  gv_note(f, "CALL cloudsupport.cases.comments.list pages")
  var p = svc.cases.comments.list_pages("id1/ x", options: CasesCommentsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_17)
}

