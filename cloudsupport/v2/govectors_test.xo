const GO_22: List[Str] = [
  "CALL cloudsupport.media.upload resumable",
  "REQ POST https://cloudsupport.googleapis.com/upload/v2/id1/%20x/attachments?alt=json&fields=kind%2Cid&prettyPrint=false&uploadType=resumable",
  "  H content-type=application/json | x-extra=v1 | x-upload-content-type=text/plain",
  "  B {\"attachment\":{\"createTime\":\"s-createtime\",\"creator\":{\"displayName\":\"s-displayname\",\"email\":\"s-email\",\"googleSupport\":true,\"username\":\"s-username\"},\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"name\":\"s-name\",\"sizeBytes\":\"7\"}}",
  "",
  "  SERVED 200 @H Location=https://cloudsupport.googleapis.com/upload/session-1 @B ",
  "REQ POST https://cloudsupport.googleapis.com/upload/session-1",
  "  H content-range=bytes 0-262143/* | content-type=text/plain | x-goog-gcs-idempotency-token=UUID | x-guploader-no-308=yes",
  "  B <262144 bytes> 0123456789abcdef0123456789abcdef...0123456789abcdef0123456789abcdef",
  "  SERVED 200 @H X-Http-Status-Code-Override=308 @B ",
  "REQ POST https://cloudsupport.googleapis.com/upload/session-1",
  "  H content-range=bytes 262144-262153/262154 | content-type=text/plain | x-goog-gcs-idempotency-token=UUID | x-guploader-no-308=yes",
  "  B 0123456789",
  "  SERVED 200 {\"createTime\":\"s-createtime\",\"creator\":{\"displayName\":\"s-displayname\",\"email\":\"s-email\",\"googleSupport\":true,\"username\":\"s-username\"},\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"name\":\"s-name\",\"sizeBytes\":\"7\"}",
  "OUT: {\"createTime\":\"s-createtime\",\"creator\":{\"displayName\":\"s-displayname\",\"email\":\"s-email\",\"googleSupport\":true,\"username\":\"s-username\"},\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"name\":\"s-name\",\"sizeBytes\":\"7\"}",
]

