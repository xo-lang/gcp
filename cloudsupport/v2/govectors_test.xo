test "Go's cloudsupport.organizations.supportEventSubscriptions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"supportEventSubscriptions\":[{\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"failureReason\":\"s-failurereason\",\"name\":\"s-name\",\"pubSubTopic\":\"s-pubsubtopic\",\"purgeTime\":\"s-purgetime\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\"}]}")
  gv_queue(f, "{\"supportEventSubscriptions\":[{\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"failureReason\":\"s-failurereason\",\"name\":\"s-name\",\"pubSubTopic\":\"s-pubsubtopic\",\"purgeTime\":\"s-purgetime\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL cloudsupport.organizations.supportEventSubscriptions.list pages")
  var p = svc.organizations.support_event_subscriptions.list_pages("id1/ x", options: OrganizationsSupportEventSubscriptionsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), show_deleted: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_28)
}

