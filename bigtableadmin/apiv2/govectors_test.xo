test "Go's bigtableadmin.projects.instances.materializedViews.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"materializedViews\":[{\"deletionProtection\":true,\"etag\":\"s-etag\",\"name\":\"s-name\",\"query\":\"s-query\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"materializedViews\":[{\"deletionProtection\":true,\"etag\":\"s-etag\",\"name\":\"s-name\",\"query\":\"s-query\"}]}")
  gv_note(f, "CALL bigtableadmin.projects.instances.materializedViews.list pages")
  var p = svc.projects.instances.materialized_views.list_pages("id1/ x", options: ProjectsInstancesMaterializedViewsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), view: Some("s-view"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_56)
}

