  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"authorizedViews\":[{\"deletionProtection\":true,\"etag\":\"s-etag\",\"name\":\"s-name\",\"subsetView\":{}}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"authorizedViews\":[{\"deletionProtection\":true,\"etag\":\"s-etag\",\"name\":\"s-name\",\"subsetView\":{}}]}")
  gv_note(f, "CALL bigtableadmin.projects.instances.tables.authorizedViews.list pages")
  var p = svc.projects.instances.tables.authorized_views.list_pages("id1/ x", options: ProjectsInstancesTablesAuthorizedViewsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), view: Some("s-view"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
