// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 oauth2/v2 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://www.googleapis.com"

const GO_0: List[Str] = [
  "CALL oauth2.tokeninfo",
  "REQ POST https://www.googleapis.com/oauth2/v2/tokeninfo?access_token=s-access_token&alt=json&fields=kind%2Cid&id_token=s-id_token&prettyPrint=false",
  "  H x-extra=v1",
  "  B ",
  "  SERVED 200 {\"audience\":\"s-audience\",\"email\":\"s-email\",\"expires_in\":7,\"issued_to\":\"s-issued_to\",\"scope\":\"s-scope\",\"user_id\":\"s-user_id\",\"verified_email\":true}",
  "OUT: {\"audience\":\"s-audience\",\"email\":\"s-email\",\"expires_in\":7,\"issued_to\":\"s-issued_to\",\"scope\":\"s-scope\",\"user_id\":\"s-user_id\",\"verified_email\":true}",
]

test "Go's oauth2.tokeninfo" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"audience\":\"s-audience\",\"email\":\"s-email\",\"expires_in\":7,\"issued_to\":\"s-issued_to\",\"scope\":\"s-scope\",\"user_id\":\"s-user_id\",\"verified_email\":true}")
  gv_note(f, "CALL oauth2.tokeninfo")
  match svc.tokeninfo(options: TokeninfoOptions{access_token: Some("s-access_token"), id_token: Some("s-id_token"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

const GO_1: List[Str] = [
  "CALL oauth2.userinfo.get",
  "REQ GET https://www.googleapis.com/oauth2/v2/userinfo?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"email\":\"s-email\",\"family_name\":\"s-family_name\",\"gender\":\"s-gender\",\"given_name\":\"s-given_name\",\"hd\":\"s-hd\",\"id\":\"s-id\",\"link\":\"s-link\",\"locale\":\"s-locale\",\"name\":\"s-name\",\"picture\":\"s-picture\",\"verified_email\":true}",
  "OUT: {\"email\":\"s-email\",\"family_name\":\"s-family_name\",\"gender\":\"s-gender\",\"given_name\":\"s-given_name\",\"hd\":\"s-hd\",\"id\":\"s-id\",\"link\":\"s-link\",\"locale\":\"s-locale\",\"name\":\"s-name\",\"picture\":\"s-picture\",\"verified_email\":true}",
]

test "Go's oauth2.userinfo.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"email\":\"s-email\",\"family_name\":\"s-family_name\",\"gender\":\"s-gender\",\"given_name\":\"s-given_name\",\"hd\":\"s-hd\",\"id\":\"s-id\",\"link\":\"s-link\",\"locale\":\"s-locale\",\"name\":\"s-name\",\"picture\":\"s-picture\",\"verified_email\":true}")
  gv_note(f, "CALL oauth2.userinfo.get")
  match svc.userinfo.get(options: UserinfoGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
