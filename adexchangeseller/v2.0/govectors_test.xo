  "REQ GET https://www.googleapis.com/adexchangeseller/v2.0/accounts/id1%2F%20x/reports/saved?alt=json&fields=kind%2Cid&maxResults=7&pageToken=s-pagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"etag\":\"s-etag\",\"items\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}",
  "OUT: {\"etag\":\"s-etag\",\"items\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}",
]

test "Go's adexchangeseller.accounts.reports.saved.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"items\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_note(f, "CALL adexchangeseller.accounts.reports.saved.list")
  match svc.accounts.reports.saved.list("id1/ x", options: AccountsReportsSavedListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_12)
}

const GO_13: List[Str] = [
  "CALL adexchangeseller.accounts.urlchannels.list",
  "REQ GET https://www.googleapis.com/adexchangeseller/v2.0/accounts/id1%2F%20x/adclients/id2%2F%20x/urlchannels?alt=json&fields=kind%2Cid&maxResults=7&pageToken=s-pagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"etag\":\"s-etag\",\"items\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"urlPattern\":\"s-urlpattern\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}",
  "OUT: {\"etag\":\"s-etag\",\"items\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"urlPattern\":\"s-urlpattern\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}",
]

test "Go's adexchangeseller.accounts.urlchannels.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"items\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"urlPattern\":\"s-urlpattern\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_note(f, "CALL adexchangeseller.accounts.urlchannels.list")
  match svc.accounts.urlchannels.list("id1/ x", "id2/ x", options: AccountsUrlchannelsListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_13)
}
