  if let Some(v) = options.max_results {
    q.set("maxResults", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "adclients/{adClientId}/urlchannels"), {"adClientId": ad_client_id})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[UrlChannels](resp)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
  new_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
