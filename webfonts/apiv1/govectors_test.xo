// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 webfonts/v1 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://webfonts.googleapis.com"

const GO_0: List[Str] = [
  "CALL webfonts.webfonts.list",
  "REQ GET https://webfonts.googleapis.com/v1/webfonts?alt=json&capability=s-capability&category=s-category&family=s-family&fields=kind%2Cid&prettyPrint=false&sort=s-sort&subset=s-subset",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"items\":[{\"category\":\"s-category\",\"colorCapabilities\":[\"s-colorcapabilities\"],\"family\":\"s-family\",\"files\":{\"k1\":\"s-files\"},\"kind\":\"s-kind\",\"lastModified\":\"s-lastmodified\",\"menu\":\"s-menu\",\"subsets\":[\"s-subsets\"],\"variants\":[\"s-variants\"],\"version\":\"s-version\"}],\"kind\":\"s-kind\"}",
  "OUT: {\"items\":[{\"category\":\"s-category\",\"colorCapabilities\":[\"s-colorcapabilities\"],\"family\":\"s-family\",\"files\":{\"k1\":\"s-files\"},\"kind\":\"s-kind\",\"lastModified\":\"s-lastmodified\",\"menu\":\"s-menu\",\"subsets\":[\"s-subsets\"],\"variants\":[\"s-variants\"],\"version\":\"s-version\"}],\"kind\":\"s-kind\"}",
]

test "Go's webfonts.webfonts.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"category\":\"s-category\",\"colorCapabilities\":[\"s-colorcapabilities\"],\"family\":\"s-family\",\"files\":{\"k1\":\"s-files\"},\"kind\":\"s-kind\",\"lastModified\":\"s-lastmodified\",\"menu\":\"s-menu\",\"subsets\":[\"s-subsets\"],\"variants\":[\"s-variants\"],\"version\":\"s-version\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL webfonts.webfonts.list")
  match svc.webfonts.list(options: WebfontsListOptions{capability: ["s-capability"], category: Some("s-category"), family: ["s-family"], sort: Some("s-sort"), subset: Some("s-subset"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
