test "Go's content.datafeeds.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"resources\":[{\"attributeLanguage\":\"s-attributelanguage\",\"contentType\":\"s-contenttype\",\"fetchSchedule\":{\"dayOfMonth\":7,\"fetchUrl\":\"s-fetchurl\",\"hour\":7,\"minuteOfHour\":7,\"password\":\"s-password\",\"paused\":true,\"timeZone\":\"s-timezone\",\"username\":\"s-username\",\"weekday\":\"s-weekday\"},\"fileName\":\"s-filename\",\"format\":{\"columnDelimiter\":\"s-columndelimiter\",\"fileEncoding\":\"s-fileencoding\",\"quotingMode\":\"s-quotingmode\"},\"id\":\"7\",\"kind\":\"s-kind\",\"name\":\"s-name\"}]}")
  gv_queue(f, "{\"kind\":\"s-kind\",\"resources\":[{\"attributeLanguage\":\"s-attributelanguage\",\"contentType\":\"s-contenttype\",\"fetchSchedule\":{\"dayOfMonth\":7,\"fetchUrl\":\"s-fetchurl\",\"hour\":7,\"minuteOfHour\":7,\"password\":\"s-password\",\"paused\":true,\"timeZone\":\"s-timezone\",\"username\":\"s-username\",\"weekday\":\"s-weekday\"},\"fileName\":\"s-filename\",\"format\":{\"columnDelimiter\":\"s-columndelimiter\",\"fileEncoding\":\"s-fileencoding\",\"quotingMode\":\"s-quotingmode\"},\"id\":\"7\",\"kind\":\"s-kind\",\"name\":\"s-name\"}]}")
  gv_note(f, "CALL content.datafeeds.list pages")
  var p = svc.datafeeds.list_pages(7, options: DatafeedsListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_59)
}

