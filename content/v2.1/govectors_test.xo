test "Go's content.shippingsettings.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"resources\":[{\"accountId\":\"7\"}]}")
  gv_queue(f, "{\"kind\":\"s-kind\",\"resources\":[{\"accountId\":\"7\"}]}")
  gv_note(f, "CALL content.shippingsettings.list pages")
  var p = svc.shippingsettings.list_pages(7, options: ShippingsettingsListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_140)
}

