test "Go's content.accounts.labels.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"accountLabels\":[{\"accountId\":\"7\",\"description\":\"s-description\",\"labelId\":\"7\",\"labelType\":\"s-labeltype\",\"name\":\"s-name\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"accountLabels\":[{\"accountId\":\"7\",\"description\":\"s-description\",\"labelId\":\"7\",\"labelType\":\"s-labeltype\",\"name\":\"s-name\"}]}")
  gv_note(f, "CALL content.accounts.labels.list pages")
  var p = svc.accounts.labels.list_pages(7, options: AccountsLabelsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_19)
}

