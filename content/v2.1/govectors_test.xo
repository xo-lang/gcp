test "Go's content.productstatuses.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"resources\":[{\"creationDate\":\"s-creationdate\",\"googleExpirationDate\":\"s-googleexpirationdate\",\"kind\":\"s-kind\",\"lastUpdateDate\":\"s-lastupdatedate\",\"link\":\"s-link\",\"productId\":\"s-productid\",\"title\":\"s-title\"}]}")
  gv_queue(f, "{\"kind\":\"s-kind\",\"resources\":[{\"creationDate\":\"s-creationdate\",\"googleExpirationDate\":\"s-googleexpirationdate\",\"kind\":\"s-kind\",\"lastUpdateDate\":\"s-lastupdatedate\",\"link\":\"s-link\",\"productId\":\"s-productid\",\"title\":\"s-title\"}]}")
  gv_note(f, "CALL content.productstatuses.list pages")
  var p = svc.productstatuses.list_pages(7, options: ProductstatusesListOptions{destinations: ["s-destinations"], max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_108)
}

