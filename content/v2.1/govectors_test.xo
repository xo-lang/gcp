  gv_note(f, "CALL content.reports.search")
  match svc.reports.search(7, json.decode_str[SearchRequest]("{\"pageSize\":7,\"pageToken\":\"s-pagetoken\",\"query\":\"s-query\"}") ?? e => fault(e.display()), options: ReportsSearchOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
