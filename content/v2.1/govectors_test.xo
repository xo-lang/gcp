test "Go's content.pos.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"kind\":\"s-kind\",\"resources\":[{\"gcidCategory\":[\"s-gcidcategory\"],\"kind\":\"s-kind\",\"matchingStatus\":\"s-matchingstatus\",\"matchingStatusHint\":\"s-matchingstatushint\",\"phoneNumber\":\"s-phonenumber\",\"placeId\":\"s-placeid\",\"storeAddress\":\"s-storeaddress\",\"storeCode\":\"s-storecode\",\"storeName\":\"s-storename\",\"websiteUrl\":\"s-websiteurl\"}]}")
