  merchant_id: Int
  options: ProductsListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: ProductsService.list's pages, from the first.
pub fn (r: ProductsService[fx]) list_pages(merchant_id: Int, options: ProductsListOptions = ProductsListOptions{}) -> ProductsListPages[fx] {
  ProductsListPages{r: r, merchant_id: merchant_id, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: ProductsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: ProductsListPages[fx]) next_page() -> ProductsListResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.merchant_id, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

