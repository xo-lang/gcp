  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: ShippingsettingsListPages[fx]) next_page() -> ShippingsettingsListResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.merchant_id, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

