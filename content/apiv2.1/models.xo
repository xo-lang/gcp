/// PriceCompetitiveness: Price competitiveness fields requested by the merchant in the query. Field values are only set if the merchant queries `PriceCompetitivenessProductView`. https://support.google.com/merchants/answer/9626903
pub struct PriceCompetitiveness {
  /// The price benchmark currency (ISO 4217 code).
  pub benchmark_price_currency_code as "benchmarkPriceCurrencyCode,omitempty": Str = ""
  /// The latest available price benchmark in micros (1 millionth of a standard unit, 1 USD = 1000000 micros) for the product's catalog in the benchmark country.
  pub benchmark_price_micros as "benchmarkPriceMicros,omitempty,string": Int = 0
  /// The country of the price benchmark (ISO 3166 code).
  pub country_code as "countryCode,omitempty": Str = ""
} derive Json

/// PriceInsights: Price insights fields requested by the merchant in the query. Field values are only set if the merchant queries `PriceInsightsProductView`. https://support.google.com/merchants/answer/11916926
pub struct PriceInsights {
  /// The predicted effectiveness of applying the price suggestion, bucketed.
  pub effectiveness as "effectiveness,omitempty": Str = ""
  /// The predicted change in clicks as a fraction after introducing the suggested price compared to current active price. For example, 0.05 is a 5% predicted increase in clicks.
  pub predicted_clicks_change_fraction as "predictedClicksChangeFraction,omitempty": Float = 0.0
  /// The predicted change in conversions as a fraction after introducing the suggested price compared to current active price. For example, 0.05 is a 5% predicted increase in conversions).
  pub predicted_conversions_change_fraction as "predictedConversionsChangeFraction,omitempty": Float = 0.0
  /// *Deprecated*: This field is no longer supported and will start returning 0. The predicted change in gross profit as a fraction after introducing the suggested price compared to current active price. For example, 0.05 is a 5% predicted increase in gross profit.
  pub predicted_gross_profit_change_fraction as "predictedGrossProfitChangeFraction,omitempty": Float = 0.0
  /// The predicted change in impressions as a fraction after introducing the suggested price compared to current active price. For example, 0.05 is a 5% predicted increase in impressions.
  pub predicted_impressions_change_fraction as "predictedImpressionsChangeFraction,omitempty": Float = 0.0
  /// *Deprecated*: This field is no longer supported and will start returning USD for all requests. The predicted monthly gross profit change currency (ISO 4217 code).
  pub predicted_monthly_gross_profit_change_currency_code as "predictedMonthlyGrossProfitChangeCurrencyCode,omitempty": Str = ""
  /// *Deprecated*: This field is no longer supported and will start returning 0. The predicted change in gross profit in micros (1 millionth of a standard unit, 1 USD = 1000000 micros) after introducing the suggested price for a month compared to current active price.
  pub predicted_monthly_gross_profit_change_micros as "predictedMonthlyGrossProfitChangeMicros,omitempty,string": Int = 0
  /// The suggested price currency (ISO 4217 code).
  pub suggested_price_currency_code as "suggestedPriceCurrencyCode,omitempty": Str = ""
  /// The latest suggested price in micros (1 millionth of a standard unit, 1 USD = 1000000 micros) for the product.
  pub suggested_price_micros as "suggestedPriceMicros,omitempty,string": Int = 0
} derive Json

/// Product:  Required product attributes are primarily defined by the product data specification. See the Product Data Specification Help Center article for information. Product data. After inserting, updating, or deleting a product, it may take several minutes before changes take effect. The following reference documentation lists the field names in the **camelCase** casing style while the Products Data Specification lists the names in the **snake_case** casing style.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct Product {
  /// Additional URLs of images of the item.
  pub additional_image_links as "additionalImageLinks,omitempty": List[Str] = []
  /// Additional cut of the item. Used together with size_type to represent combined size types for apparel items.
  pub additional_size_type as "additionalSizeType,omitempty": Str = ""
  /// Used to group items in an arbitrary way. Only for CPA%, discouraged otherwise.
  pub ads_grouping as "adsGrouping,omitempty": Str = ""
  /// Similar to ads_grouping, but only works on CPC.
  pub ads_labels as "adsLabels,omitempty": List[Str] = []
  /// Allows advertisers to override the item URL when the product is shown within the context of Product Ads.
  pub ads_redirect as "adsRedirect,omitempty": Str = ""
  /// Should be set to true if the item is targeted towards adults.
  pub adult as "adult,omitempty": Bool = false
  /// Target age group of the item.
  pub age_group as "ageGroup,omitempty": Str = ""
  /// A safeguard in the [Automated Discounts](//support.google.com/merchants/answer/10295759) and [Dynamic Promotions](//support.google.com/merchants/answer/13949249) projects, ensuring that discounts on merchants' offers do not fall below this value, thereby preserving the offer's value and profitability.
  pub auto_pricing_min_price as "autoPricingMinPrice,omitempty": Price? = None
  /// Availability status of the item.
  pub availability as "availability,omitempty": Str = ""
  /// The day a pre-ordered product becomes available for delivery, in ISO 8601 format.
  pub availability_date as "availabilityDate,omitempty": Str = ""
  /// Brand of the item.
  pub brand as "brand,omitempty": Str = ""
  /// URL for the canonical version of your item's landing page.
  pub canonical_link as "canonicalLink,omitempty": Str = ""
  /// Product [certification](https://support.google.com/merchants/answer/13528839), introduced for EU energy efficiency labeling compliance using the [EU EPREL](https://eprel.ec.europa.eu/screen/home) database.
  pub certifications as "certifications,omitempty": List[ProductCertification] = []
  /// Required. The item's channel (online or local). Acceptable values are: - "`local`" - "`online`"
  pub channel as "channel,omitempty": Str = ""
  /// Extra fields to export to the Cloud Retail program.
  pub cloud_export_additional_properties as "cloudExportAdditionalProperties,omitempty": List[CloudExportAdditionalProperties] = []
  /// Color of the item.
  pub color as "color,omitempty": Str = ""
  /// Condition or state of the item.
  pub condition as "condition,omitempty": Str = ""
  /// Required. The two-letter ISO 639-1 language code for the item.
  pub content_language as "contentLanguage,omitempty": Str = ""
  /// Cost of goods sold. Used for gross profit reporting.
  pub cost_of_goods_sold as "costOfGoodsSold,omitempty": Price? = None
  /// A list of custom (merchant-provided) attributes. It can also be used for submitting any attribute of the feed specification in its generic form (for example, `{ "name": "size type", "value": "regular" }`). This is useful for submitting attributes not explicitly exposed by the API, such as additional attributes used for Buy on Google (formerly known as Shopping Actions).
  pub custom_attributes as "customAttributes,omitempty": List[CustomAttribute] = []
  /// Custom label 0 for custom grouping of items in a Shopping campaign.
  pub custom_label0 as "customLabel0,omitempty": Str = ""
  /// Custom label 1 for custom grouping of items in a Shopping campaign.
  pub custom_label1 as "customLabel1,omitempty": Str = ""
  /// Custom label 2 for custom grouping of items in a Shopping campaign.
  pub custom_label2 as "customLabel2,omitempty": Str = ""
  /// Custom label 3 for custom grouping of items in a Shopping campaign.
  pub custom_label3 as "customLabel3,omitempty": Str = ""
  /// Custom label 4 for custom grouping of items in a Shopping campaign.
  pub custom_label4 as "customLabel4,omitempty": Str = ""
  /// Description of the item.
  pub description as "description,omitempty": Str = ""
  /// The date time when an offer becomes visible in search results across Google’s YouTube surfaces, in [ISO 8601](http://en.wikipedia.org/wiki/ISO_8601) format. See [Disclosure date](https://support.google.com/merchants/answer/13034208) for more information.
  pub disclosure_date as "disclosureDate,omitempty": Str = ""
  /// An identifier for an item for dynamic remarketing campaigns.
  pub display_ads_id as "displayAdsId,omitempty": Str = ""
  /// URL directly to your item's landing page for dynamic remarketing campaigns.
  pub display_ads_link as "displayAdsLink,omitempty": Str = ""
  /// Advertiser-specified recommendations.
  pub display_ads_similar_ids as "displayAdsSimilarIds,omitempty": List[Str] = []
  /// Title of an item for dynamic remarketing campaigns.
  pub display_ads_title as "displayAdsTitle,omitempty": Str = ""
  /// Offer margin for dynamic remarketing campaigns.
  pub display_ads_value as "displayAdsValue,omitempty": Float = 0.0
  /// The energy efficiency class as defined in EU directive 2010/30/EU.
  pub energy_efficiency_class as "energyEfficiencyClass,omitempty": Str = ""
  /// The list of [destinations to exclude](//support.google.com/merchants/answer/6324486) for this target (corresponds to cleared check boxes in Merchant Center). Products that are excluded from all destinations for more than 7 days are automatically deleted.
  pub excluded_destinations as "excludedDestinations,omitempty": List[Str] = []
  /// Date on which the item should expire, as specified upon insertion, in ISO 8601 format. The actual expiration date in Google Shopping is exposed in `productstatuses` as `googleExpirationDate` and might be earlier if `expirationDate` is too far in the future.
  pub expiration_date as "expirationDate,omitempty": Str = ""
  /// Required for multi-seller accounts. Use this attribute if you're a marketplace uploading products for various sellers to your multi-seller account.
  pub external_seller_id as "externalSellerId,omitempty": Str = ""
  /// Feed label for the item. Either `targetCountry` or `feedLabel` is required. Must be less than or equal to 20 uppercase letters (A-Z), numbers (0-9), and dashes (-).
  pub feed_label as "feedLabel,omitempty": Str = ""
  /// Optional. Conditions to be met for a product to have free shipping.
  pub free_shipping_threshold as "freeShippingThreshold,omitempty": List[FreeShippingThreshold] = []
  /// Target gender of the item.
  pub gender as "gender,omitempty": Str = ""
  /// Google's category of the item (see [Google product taxonomy](https://support.google.com/merchants/answer/1705911)). When querying products, this field will contain the user provided value. There is currently no way to get back the auto assigned google product categories through the API.
  pub google_product_category as "googleProductCategory,omitempty": Str = ""
  /// Global Trade Item Number (GTIN) of the item.
  pub gtin as "gtin,omitempty": Str = ""
  /// The REST ID of the product. Content API methods that operate on products take this as their `productId` parameter. The REST ID for a product has one of the 2 forms channel:contentLanguage: targetCountry: offerId or channel:contentLanguage:feedLabel: offerId.
  pub id as "id,omitempty": Str = ""
  /// False when the item does not have unique product identifiers appropriate to its category, such as GTIN, MPN, and brand. Required according to the Unique Product Identifier Rules for all target countries except for Canada.
  pub identifier_exists as "identifierExists,omitempty": Bool = false
  /// URL of an image of the item.
  pub image_link as "imageLink,omitempty": Str = ""
  /// The list of [destinations to include](//support.google.com/merchants/answer/7501026) for this target (corresponds to checked check boxes in Merchant Center). Default destinations are always included unless provided in `excludedDestinations`.
  pub included_destinations as "includedDestinations,omitempty": List[Str] = []
  /// Number and amount of installments to pay for an item.
  pub installment as "installment,omitempty": Installment? = None
  /// Whether the item is a merchant-defined bundle. A bundle is a custom grouping of different products sold by a merchant for a single price.
  pub is_bundle as "isBundle,omitempty": Bool = false
  /// Shared identifier for all variants of the same product.
  pub item_group_id as "itemGroupId,omitempty": Str = ""
  /// Identifies what kind of resource this is. Value: the fixed string "`content#product`"
  pub kind as "kind,omitempty": Str = ""
  /// Additional URLs of lifestyle images of the item. Used to explicitly identify images that showcase your item in a real-world context. See the Help Center article for more information.
  pub lifestyle_image_links as "lifestyleImageLinks,omitempty": List[Str] = []
  /// URL directly linking to your item's page on your website.
  pub link as "link,omitempty": Str = ""
  /// URL template for merchant hosted local storefront.
  pub link_template as "linkTemplate,omitempty": Str = ""
  /// Loyalty program information that is used to surface loyalty benefits ( for example, better pricing, points, etc) to the user of this item. This signular field points to the latest uploaded loyalty program info. This field will be deprecated in the coming weeks and should not be used in favor of the plural 'LoyaltyProgram' field below.
  pub loyalty_program as "loyaltyProgram,omitempty": LoyaltyProgram? = None
  /// Optional. A list of loyalty program information that is used to surface loyalty benefits (for example, better pricing, points, etc) to the user of this item.
  pub loyalty_programs as "loyaltyPrograms,omitempty": List[LoyaltyProgram] = []
  /// The material of which the item is made.
  pub material as "material,omitempty": Str = ""
  /// The energy efficiency class as defined in EU directive 2010/30/EU.
  pub max_energy_efficiency_class as "maxEnergyEfficiencyClass,omitempty": Str = ""
  /// Maximal product handling time (in business days).
  pub max_handling_time as "maxHandlingTime,omitempty,string": Int = 0
  /// Maximum retail price (MRP) of the item. Applicable to India only.
  pub maximum_retail_price as "maximumRetailPrice,omitempty": Price? = None
  /// The energy efficiency class as defined in EU directive 2010/30/EU.
  pub min_energy_efficiency_class as "minEnergyEfficiencyClass,omitempty": Str = ""
  /// Minimal product handling time (in business days).
  pub min_handling_time as "minHandlingTime,omitempty,string": Int = 0
  /// URL for the mobile-optimized version of your item's landing page.
  pub mobile_link as "mobileLink,omitempty": Str = ""
  /// URL template for merchant hosted local storefront optimized for mobile devices.
  pub mobile_link_template as "mobileLinkTemplate,omitempty": Str = ""
  /// Manufacturer Part Number (MPN) of the item.
  pub mpn as "mpn,omitempty": Str = ""
  /// The number of identical products in a merchant-defined multipack.
  pub multipack as "multipack,omitempty,string": Int = 0
  /// Required. A unique identifier for the item. Leading and trailing whitespaces are stripped and multiple whitespaces are replaced by a single whitespace upon submission. Only valid unicode characters are accepted. See the products feed specification for details. *Note:* Content API methods that operate on products take the REST ID of the product, *not* this identifier.
  pub offer_id as "offerId,omitempty": Str = ""
  /// The item's pattern (for example, polka dots).
  pub pattern as "pattern,omitempty": Str = ""
  /// Publication of this item should be temporarily paused. Acceptable values are: - "`ads`"
  pub pause as "pause,omitempty": Str = ""
  /// The pick up option for the item. Acceptable values are: - "`buy`" - "`reserve`" - "`ship to store`" - "`not supported`"
  pub pickup_method as "pickupMethod,omitempty": Str = ""
  /// Item store pickup timeline. Acceptable values are: - "`same day`" - "`next day`" - "`2-day`" - "`3-day`" - "`4-day`" - "`5-day`" - "`6-day`" - "`7-day`" - "`multi-week`"
  pub pickup_sla as "pickupSla,omitempty": Str = ""
  /// Price of the item.
  pub price as "price,omitempty": Price? = None
  /// Technical specification or additional product details.
  pub product_details as "productDetails,omitempty": List[ProductProductDetail] = []
  /// The height of the product in the units provided. The value must be between 0 (exclusive) and 3000 (inclusive).
  pub product_height as "productHeight,omitempty": ProductDimension? = None
  /// Bullet points describing the most relevant highlights of a product.
  pub product_highlights as "productHighlights,omitempty": List[Str] = []
  /// The length of the product in the units provided. The value must be between 0 (exclusive) and 3000 (inclusive).
  pub product_length as "productLength,omitempty": ProductDimension? = None
  /// Categories of the item (formatted as in product data specification).
  pub product_types as "productTypes,omitempty": List[Str] = []
  /// The weight of the product in the units provided. The value must be between 0 (exclusive) and 2000 (inclusive).
  pub product_weight as "productWeight,omitempty": ProductWeight? = None
  /// The width of the product in the units provided. The value must be between 0 (exclusive) and 3000 (inclusive).
  pub product_width as "productWidth,omitempty": ProductDimension? = None
  /// The unique ID of a promotion.
  pub promotion_ids as "promotionIds,omitempty": List[Str] = []
  /// Advertised sale price of the item.
  pub sale_price as "salePrice,omitempty": Price? = None
  /// Date range during which the item is on sale (see product data specification ).
  pub sale_price_effective_date as "salePriceEffectiveDate,omitempty": Str = ""
  /// The quantity of the product that is available for selling on Google. Supported only for online products.
  pub sell_on_google_quantity as "sellOnGoogleQuantity,omitempty,string": Int = 0
  /// Shipping rules.
  pub shipping as "shipping,omitempty": List[ProductShipping] = []
  /// Height of the item for shipping.
  pub shipping_height as "shippingHeight,omitempty": ProductShippingDimension? = None
  /// The shipping label of the product, used to group product in account-level shipping rules.
  pub shipping_label as "shippingLabel,omitempty": Str = ""
  /// Length of the item for shipping.
  pub shipping_length as "shippingLength,omitempty": ProductShippingDimension? = None
  /// Weight of the item for shipping.
  pub shipping_weight as "shippingWeight,omitempty": ProductShippingWeight? = None
  /// Width of the item for shipping.
  pub shipping_width as "shippingWidth,omitempty": ProductShippingDimension? = None
  /// List of country codes (ISO 3166-1 alpha-2) to exclude the offer from Shopping Ads destination. Countries from this list are removed from countries configured in MC feed settings.
  pub shopping_ads_excluded_countries as "shoppingAdsExcludedCountries,omitempty": List[Str] = []
  /// System in which the size is specified. Recommended for apparel items.
  pub size_system as "sizeSystem,omitempty": Str = ""
  /// The cut of the item. Recommended for apparel items.
  pub size_type as "sizeType,omitempty": Str = ""
  /// Size of the item. Only one value is allowed. For variants with different sizes, insert a separate product for each size with the same `itemGroupId` value (see size definition).
  pub sizes as "sizes,omitempty": List[Str] = []
  /// Output only. The source of the offer, that is, how the offer was created. Acceptable values are: - "`api`" - "`crawl`" - "`feed`"
