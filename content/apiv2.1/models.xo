  /// The measure and dimension of an item.
  pub unit_pricing_measure as "unitPricingMeasure,omitempty": ProductUnitPricingMeasure? = None
  /// URL of the 3D model of the item to provide more visuals.
  pub virtual_model_link as "virtualModelLink,omitempty": Str = ""
