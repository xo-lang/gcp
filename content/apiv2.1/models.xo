  /// Optional. The list of sustainability incentive programs.
  pub sustainability_incentives as "sustainabilityIncentives,omitempty": List[ProductSustainabilityIncentive] = []
  /// Required. The CLDR territory code for the item's country of sale.
  pub target_country as "targetCountry,omitempty": Str = ""
  /// The tax category of the product, used to configure detailed tax nexus in account-level tax settings.
  pub tax_category as "taxCategory,omitempty": Str = ""
  /// Tax information.
  pub taxes as "taxes,omitempty": List[ProductTax] = []
  /// Title of the item.
