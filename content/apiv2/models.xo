/// TransitTable:
pub struct TransitTable {
  /// A list of postal group names. The last value can be `"all other locations"`. Example: `["zone 1", "zone 2", "all other locations"]`. The referred postal code groups must match the delivery country of the service.
  pub postal_code_group_names as "postalCodeGroupNames,omitempty": List[Str] = []
  pub rows as "rows,omitempty": List[TransitTableTransitTimeRow] = []
  /// A list of transit time labels. The last value can be `"all other labels"`. Example: `["food", "electronics", "all other labels"]`.
  pub transit_time_labels as "transitTimeLabels,omitempty": List[Str] = []
} derive Json

/// TransitTableTransitTimeRow:
pub struct TransitTableTransitTimeRow {
  pub values as "values,omitempty": List[TransitTableTransitTimeRowTransitTimeValue] = []
} derive Json

/// TransitTableTransitTimeRowTransitTimeValue:
pub struct TransitTableTransitTimeRowTransitTimeValue {
  /// Must be greater than or equal to `minTransitTimeInDays`.
  pub max_transit_time_in_days as "maxTransitTimeInDays,omitempty": Int = 0
  /// Transit time range (min-max) in business days. 0 means same day delivery, 1 means next day delivery.
  pub min_transit_time_in_days as "minTransitTimeInDays,omitempty": Int = 0
} derive Json

/// UnitInvoice:
pub struct UnitInvoice {
  /// Additional charges for a unit, e.g. shipping costs.
  pub additional_charges as "additionalCharges,omitempty": List[UnitInvoiceAdditionalCharge] = []
  /// Deprecated.
  pub promotions as "promotions,omitempty": List[Promotion] = []
  /// [required] Price of the unit, before applying taxes.
  pub unit_price_pretax as "unitPricePretax,omitempty": Price? = None
  /// Tax amounts to apply to the unit price.
  pub unit_price_taxes as "unitPriceTaxes,omitempty": List[UnitInvoiceTaxLine] = []
} derive Json

/// UnitInvoiceAdditionalCharge:
pub struct UnitInvoiceAdditionalCharge {
  /// [required] Amount of the additional charge.
  pub additional_charge_amount as "additionalChargeAmount,omitempty": Amount? = None
  /// Deprecated.
  pub additional_charge_promotions as "additionalChargePromotions,omitempty": List[Promotion] = []
  /// [required] Type of the additional charge. Acceptable values are: - "`shipping`"
  pub type_ as "type,omitempty": Str = ""
} derive Json

/// UnitInvoiceTaxLine:
pub struct UnitInvoiceTaxLine {
  /// [required] Tax amount for the tax type.
  pub tax_amount as "taxAmount,omitempty": Price? = None
  /// Optional name of the tax type. This should only be provided if `taxType` is `otherFeeTax`.
  pub tax_name as "taxName,omitempty": Str = ""
  /// [required] Type of the tax. Acceptable values are: - "`otherFee`" - "`otherFeeTax`" - "`sales`"
  pub tax_type as "taxType,omitempty": Str = ""
} derive Json

/// ValueModel: The single value of a rate group or the value of a rate group table's cell. Exactly one of `noShipping`, `flatRate`, `pricePercentage`, `carrierRateName`, `subtableName` must be set.
pub struct ValueModel {
  /// The name of a carrier rate referring to a carrier rate defined in the same rate group. Can only be set if all other fields are not set.
  pub carrier_rate_name as "carrierRateName,omitempty": Str = ""
  /// A flat rate. Can only be set if all other fields are not set.
  pub flat_rate as "flatRate,omitempty": Price? = None
  /// If true, then the product can't ship. Must be true when set, can only be set if all other fields are not set.
  pub no_shipping as "noShipping,omitempty": Bool = false
  /// A percentage of the price represented as a number in decimal notation (e.g., `"5.4"`). Can only be set if all other fields are not set.
  pub price_percentage as "pricePercentage,omitempty": Str = ""
  /// The name of a subtable. Can only be set in table cells (i.e., not for single values), and only if all other fields are not set.
  pub subtable_name as "subtableName,omitempty": Str = ""
} derive Json

/// Warehouse: A fulfillment warehouse, which stores and handles inventory.
pub struct Warehouse {
  /// Business days of the warehouse. If not set, will be Monday to Friday by default.
  pub business_day_config as "businessDayConfig,omitempty": BusinessDayConfig? = None
  /// Required. The latest time of day that an order can be accepted and begin processing. Later orders will be processed in the next day. The time is based on the warehouse postal code.
  pub cutoff_time as "cutoffTime,omitempty": WarehouseCutoffTime? = None
  /// Required. The number of days it takes for this warehouse to pack up and ship an item. This is on the warehouse level, but can be overridden on the offer level based on the attributes of an item.
  pub handling_days as "handlingDays,omitempty,string": Int = 0
  /// Required. The name of the warehouse. Must be unique within account.
  pub name as "name,omitempty": Str = ""
  /// Required. Shipping address of the warehouse.
  pub shipping_address as "shippingAddress,omitempty": Address? = None
} derive Json

/// WarehouseBasedDeliveryTime:
pub struct WarehouseBasedDeliveryTime {
  /// Required. Carrier, such as `"UPS"` or `"Fedex"`. The list of supported carriers can be retrieved via the `listSupportedCarriers` method.
  pub carrier as "carrier,omitempty": Str = ""
  /// Required. Carrier service, such as `"ground"` or `"2 days"`. The list of supported services for a carrier can be retrieved via the `listSupportedCarriers` method. The name of the service must be in the eddSupportedServices list.
  pub carrier_service as "carrierService,omitempty": Str = ""
  /// Shipping origin's state.
  pub origin_administrative_area as "originAdministrativeArea,omitempty": Str = ""
  /// Shipping origin's city.
  pub origin_city as "originCity,omitempty": Str = ""
  /// Shipping origin's country represented as a [CLDR territory code](http://www.unicode.org/repos/cldr/tags/latest/common/main/en.xml).
  pub origin_country as "originCountry,omitempty": Str = ""
  /// Shipping origin.
  pub origin_postal_code as "originPostalCode,omitempty": Str = ""
  /// Shipping origin's street address
  pub origin_street_address as "originStreetAddress,omitempty": Str = ""
  /// The name of the warehouse. Warehouse name need to be matched with name. If warehouseName is set, the below fields will be ignored. The warehouse info will be read from warehouse.
  pub warehouse_name as "warehouseName,omitempty": Str = ""
} derive Json

/// WarehouseCutoffTime:
pub struct WarehouseCutoffTime {
  /// Required. Hour (24-hour clock) of the cutoff time until which an order has to be placed to be processed in the same day by the warehouse. Hour is based on the timezone of warehouse.
  pub hour as "hour,omitempty": Int = 0
  /// Required. Minute of the cutoff time until which an order has to be placed to be processed in the same day by the warehouse. Minute is based on the timezone of warehouse.
  pub minute as "minute,omitempty": Int = 0
} derive Json

/// Weight:
pub struct Weight {
  /// Required. The weight unit. Acceptable values are: - "`kg`" - "`lb`"
  pub unit as "unit,omitempty": Str = ""
  /// Required. The weight represented as a number. The weight can have a maximum precision of four decimal places.
  pub value as "value,omitempty": Str = ""
} derive Json
