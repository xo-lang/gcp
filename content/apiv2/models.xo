/// DeliveryTime:
pub struct DeliveryTime {
  /// Business days cutoff time definition. If not configured the cutoff time will be defaulted to 8AM PST.
  pub cutoff_time as "cutoffTime,omitempty": CutoffTime? = None
  /// The business days during which orders can be handled. If not provided, Monday to Friday business days will be assumed.
  pub handling_business_day_config as "handlingBusinessDayConfig,omitempty": BusinessDayConfig? = None
  /// Holiday cutoff definitions. If configured, they specify order cutoff times for holiday-specific shipping.
  pub holiday_cutoffs as "holidayCutoffs,omitempty": List[HolidayCutoff] = []
  /// Maximum number of business days spent before an order is shipped. 0 means same day shipped, 1 means next day shipped. Must be greater than or equal to `minHandlingTimeInDays`.
  pub max_handling_time_in_days as "maxHandlingTimeInDays,omitempty": Int = 0
  /// Maximum number of business days that is spent in transit. 0 means same day delivery, 1 means next day delivery. Must be greater than or equal to `minTransitTimeInDays`.
  pub max_transit_time_in_days as "maxTransitTimeInDays,omitempty": Int = 0
  /// Minimum number of business days spent before an order is shipped. 0 means same day shipped, 1 means next day shipped.
  pub min_handling_time_in_days as "minHandlingTimeInDays,omitempty": Int = 0
  /// Minimum number of business days that is spent in transit. 0 means same day delivery, 1 means next day delivery. Either `{min,max}TransitTimeInDays` or `transitTimeTable` must be set, but not both.
  pub min_transit_time_in_days as "minTransitTimeInDays,omitempty": Int = 0
  /// The business days during which orders can be in-transit. If not provided, Monday to Friday business days will be assumed.
  pub transit_business_day_config as "transitBusinessDayConfig,omitempty": BusinessDayConfig? = None
  /// Transit time table, number of business days spent in transit based on row and column dimensions. Either `{min,max}TransitTimeInDays` or `transitTimeTable` can be set, but not both.
  pub transit_time_table as "transitTimeTable,omitempty": TransitTable? = None
  /// Indicates that the delivery time should be calculated per warehouse (shipping origin location) based on the settings of the selected carrier. When set, no other transit time related field in DeliveryTime should be set.
  pub warehouse_based_delivery_times as "warehouseBasedDeliveryTimes,omitempty": List[WarehouseBasedDeliveryTime] = []
} derive Json

