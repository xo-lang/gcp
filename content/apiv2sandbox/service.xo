/// OrdersListOptions: the optional parameters of OrdersService.list.
pub struct OrdersListOptions {
  /// Obtains orders that match the acknowledgement status. When set to true, obtains orders that have been acknowledged. When false, obtains orders that have not been acknowledged.
  /// We recommend using this filter set to false, in conjunction with the acknowledge call, such that only un-acknowledged orders are returned.
  pub acknowledged: Bool? = None
  /// The maximum number of orders to return in the response, used for paging. The default value is 25 orders per page, and the maximum allowed value is 250 orders per page.
  /// Known issue: All List calls will return all Orders without limit regardless of the value of this field.
  pub max_results: Int? = None
  /// The ordering of the returned list. The only supported value are placedDate desc and placedDate asc for now, which returns orders sorted by placement date. "placedDate desc" stands for listing orders by placement date, from oldest to most recent. "placedDate asc" stands for listing orders by placement date, from most recent to oldest. In future releases we'll support other sorting criteria.
  pub order_by: Str? = None
  /// The token returned by the previous request.
  pub page_token: Str? = None
  /// Obtains orders placed before this date (exclusively), in ISO 8601 format.
  pub placed_date_end: Str? = None
  /// Obtains orders placed after this date (inclusively), in ISO 8601 format.
  pub placed_date_start: Str? = None
  /// Obtains orders that match any of the specified statuses. Multiple values can be specified with comma separation. Additionally, please note that active is a shortcut for pendingShipment and partiallyShipped, and completed is a shortcut for shipped , partiallyDelivered, delivered, partiallyReturned, returned, and canceled.
  pub statuses: List[Str] = []
  /// The fields of the result to return (Go's Fields), joined with commas.
  pub fields: List[Str] = []
  /// Fail with 304 when the result's ETag is this (Go's IfNoneMatch).
  pub if_none_match: Str = ""
  /// More request headers (Go's Header).
  pub headers: List[(Str, Str)] = []
}

/// list: Lists the orders in your Merchant Center account.
/// (Go's content.orders.list.)
pub fn (r: OrdersService[fx]) list(merchant_id: Int, options: OrdersListOptions = OrdersListOptions{}) -> OrdersListResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.acknowledged {
    q.set("acknowledged", "${v}")
  }
  if let Some(v) = options.max_results {
    q.set("maxResults", "${v}")
  }
  if let Some(v) = options.order_by {
    q.set("orderBy", v)
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if let Some(v) = options.placed_date_end {
    q.set("placedDateEnd", v)
  }
  if let Some(v) = options.placed_date_start {
    q.set("placedDateStart", v)
  }
  for v in options.statuses {
    q.add("statuses", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "{merchantId}/orders"), {"merchantId": "${merchant_id}"})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[OrdersListResponse](resp)
}

/// OrdersListPages: the pages of OrdersService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct OrdersListPages[fx: Effects] {
  r: OrdersService[fx]
  merchant_id: Int
  options: OrdersListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: OrdersService.list's pages, from the first.
pub fn (r: OrdersService[fx]) list_pages(merchant_id: Int, options: OrdersListOptions = OrdersListOptions{}) -> OrdersListPages[fx] {
  OrdersListPages{r: r, merchant_id: merchant_id, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: OrdersListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: OrdersListPages[fx]) next_page() -> OrdersListResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.merchant_id, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

