/// TestOrder:
pub struct TestOrder {
  /// The details of the customer who placed the order.
  pub customer as "customer,omitempty": TestOrderCustomer? = None
  /// Whether the orderinvoices service should support this order.
  pub enable_orderinvoices as "enableOrderinvoices,omitempty": Bool = false
  /// Identifies what kind of resource this is. Value: the fixed string "content#testOrder".
  pub kind as "kind,omitempty": Str = ""
  /// Line items that are ordered. At least one line item must be provided.
  pub line_items as "lineItems,omitempty": List[TestOrderLineItem] = []
  /// Determines if test order must be pulled by merchant or pushed to merchant via push integration.
  pub notification_mode as "notificationMode,omitempty": Str = ""
  /// The details of the payment method.
  pub payment_method as "paymentMethod,omitempty": TestOrderPaymentMethod? = None
  /// Identifier of one of the predefined delivery addresses for the delivery.
  pub predefined_delivery_address as "predefinedDeliveryAddress,omitempty": Str = ""
  /// Deprecated. The details of the merchant provided promotions applied to the order. More details about the program are here.
  pub promotions as "promotions,omitempty": List[OrderLegacyPromotion] = []
  /// The total cost of shipping for all items.
  pub shipping_cost as "shippingCost,omitempty": Price? = None
  /// The tax for the total shipping cost.
  pub shipping_cost_tax as "shippingCostTax,omitempty": Price? = None
  /// The requested shipping option.
  pub shipping_option as "shippingOption,omitempty": Str = ""
} derive Json

