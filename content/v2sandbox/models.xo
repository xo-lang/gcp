} derive Json

/// OrdersUpdateShipmentRequest:
pub struct OrdersUpdateShipmentRequest {
  /// The carrier handling the shipment. Not updated if missing. See shipments[].carrier in the  Orders resource representation for a list of acceptable values.
  pub carrier as "carrier,omitempty": Str = ""
  /// Date on which the shipment has been delivered, in ISO 8601 format. Optional and can be provided only if status is delivered.
  pub delivery_date as "deliveryDate,omitempty": Str = ""
  /// The ID of the operation. Unique across all operations for a given order.
  pub operation_id as "operationId,omitempty": Str = ""
  /// The ID of the shipment.
  pub shipment_id as "shipmentId,omitempty": Str = ""
  /// New status for the shipment. Not updated if missing.
  pub status as "status,omitempty": Str = ""
  /// The tracking id for the shipment. Not updated if missing.
  pub tracking_id as "trackingId,omitempty": Str = ""
} derive Json

/// OrdersUpdateShipmentResponse:
pub struct OrdersUpdateShipmentResponse {
  /// The status of the execution.
  pub execution_status as "executionStatus,omitempty": Str = ""
  /// Identifies what kind of resource this is. Value: the fixed string "content#ordersUpdateShipmentResponse".
  pub kind as "kind,omitempty": Str = ""
} derive Json

/// Price:
pub struct Price {
