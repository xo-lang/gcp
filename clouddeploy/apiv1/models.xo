    o = gensupport.mark_field(o, "endTime", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  if let Some(c) = m.start_time {
    o = gensupport.mark_field(o, "startTime", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  gensupport.mark(o, m.force_send_fields.map(weekly_window_field_entry), m.null_fields.map(weekly_window_field_entry))
}
