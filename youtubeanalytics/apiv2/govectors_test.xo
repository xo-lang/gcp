  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"columnHeaders\":[{\"columnType\":\"s-columntype\",\"dataType\":\"s-datatype\",\"name\":\"s-name\"}],\"errors\":{\"code\":\"s-code\",\"error\":[{\"code\":\"s-code\",\"debugInfo\":\"s-debuginfo\",\"domain\":\"s-domain\",\"externalErrorMessage\":\"s-externalerrormessage\",\"location\":\"s-location\",\"locationType\":\"s-locationtype\"}],\"requestId\":\"s-requestid\"},\"kind\":\"s-kind\",\"rows\":[[{\"k\":\"v\"}]]}")
  gv_note(f, "CALL youtubeAnalytics.reports.query")
  match svc.reports.query(options: ReportsQueryOptions{currency: Some("s-currency"), dimensions: Some("s-dimensions"), end_date: Some("s-enddate"), filters: Some("s-filters"), ids: Some("s-ids"), include_historical_channel_data: Some(true), max_results: Some(7), metrics: Some("s-metrics"), sort: Some("s-sort"), start_date: Some("s-startdate"), start_index: Some(7), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
