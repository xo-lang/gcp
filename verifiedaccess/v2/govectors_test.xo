// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 verifiedaccess/v2 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://verifiedaccess.googleapis.com"

const GO_0: List[Str] = [
  "CALL verifiedaccess.challenge.generate",
  "REQ POST https://verifiedaccess.googleapis.com/v2/challenge:generate?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {}",
  "",
  "  SERVED 200 {\"challenge\":\"YWI=\"}",
  "OUT: {\"challenge\":\"YWI=\"}",
]

test "Go's verifiedaccess.challenge.generate" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"challenge\":\"YWI=\"}")
  gv_note(f, "CALL verifiedaccess.challenge.generate")
  match svc.challenge.generate(json.decode_str[Empty]("{}") ?? e => fault(e.display()), options: ChallengeGenerateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

