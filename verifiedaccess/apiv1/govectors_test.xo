use std/json

const GV_HOST: Str = "https://verifiedaccess.googleapis.com"

const GO_0: List[Str] = [
  "CALL verifiedaccess.challenge.create",
  "REQ POST https://verifiedaccess.googleapis.com/v1/challenge?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {}",
  "",
  "  SERVED 200 {\"alternativeChallenge\":{\"data\":\"YWI=\",\"signature\":\"YWI=\"},\"challenge\":{\"data\":\"YWI=\",\"signature\":\"YWI=\"}}",
  "OUT: {\"alternativeChallenge\":{\"data\":\"YWI=\",\"signature\":\"YWI=\"},\"challenge\":{\"data\":\"YWI=\",\"signature\":\"YWI=\"}}",
]

test "Go's verifiedaccess.challenge.create" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"alternativeChallenge\":{\"data\":\"YWI=\",\"signature\":\"YWI=\"},\"challenge\":{\"data\":\"YWI=\",\"signature\":\"YWI=\"}}")
  gv_note(f, "CALL verifiedaccess.challenge.create")
  match svc.challenge.create(json.decode_str[Empty]("{}") ?? e => fault(e.display()), options: ChallengeCreateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

