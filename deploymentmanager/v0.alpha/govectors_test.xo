test "Go's deploymentmanager.deployments.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"deployments\":[{\"credential\":{\"useProjectDefault\":true},\"description\":\"s-description\",\"fingerprint\":\"YWI=\",\"id\":\"7\",\"insertTime\":\"s-inserttime\",\"manifest\":\"s-manifest\",\"name\":\"s-name\",\"operation\":{\"clientOperationId\":\"s-clientoperationid\",\"creationTimestamp\":\"s-creationtimestamp\",\"description\":\"s-description\",\"endTime\":\"s-endtime\",\"httpErrorMessage\":\"s-httperrormessage\",\"httpErrorStatusCode\":7,\"id\":\"7\",\"insertTime\":\"s-inserttime\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"operationGroupId\":\"s-operationgroupid\",\"operationType\":\"s-operationtype\",\"progress\":7,\"region\":\"s-region\",\"selfLink\":\"s-selflink\",\"selfLinkWithId\":\"s-selflinkwithid\",\"startTime\":\"s-starttime\",\"status\":\"s-status\",\"statusMessage\":\"s-statusmessage\",\"targetId\":\"7\",\"targetLink\":\"s-targetlink\",\"user\":\"s-user\",\"zone\":\"s-zone\"},\"selfLink\":\"s-selflink\",\"target\":{},\"update\":{\"description\":\"s-description\",\"manifest\":\"s-manifest\"},\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"deployments\":[{\"credential\":{\"useProjectDefault\":true},\"description\":\"s-description\",\"fingerprint\":\"YWI=\",\"id\":\"7\",\"insertTime\":\"s-inserttime\",\"manifest\":\"s-manifest\",\"name\":\"s-name\",\"operation\":{\"clientOperationId\":\"s-clientoperationid\",\"creationTimestamp\":\"s-creationtimestamp\",\"description\":\"s-description\",\"endTime\":\"s-endtime\",\"httpErrorMessage\":\"s-httperrormessage\",\"httpErrorStatusCode\":7,\"id\":\"7\",\"insertTime\":\"s-inserttime\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"operationGroupId\":\"s-operationgroupid\",\"operationType\":\"s-operationtype\",\"progress\":7,\"region\":\"s-region\",\"selfLink\":\"s-selflink\",\"selfLinkWithId\":\"s-selflinkwithid\",\"startTime\":\"s-starttime\",\"status\":\"s-status\",\"statusMessage\":\"s-statusmessage\",\"targetId\":\"7\",\"targetLink\":\"s-targetlink\",\"user\":\"s-user\",\"zone\":\"s-zone\"},\"selfLink\":\"s-selflink\",\"target\":{},\"update\":{\"description\":\"s-description\",\"manifest\":\"s-manifest\"},\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL deploymentmanager.deployments.list pages")
  var p = svc.deployments.list_pages("id1/ x", options: DeploymentsListOptions{filter: Some("s-filter"), max_results: Some(7), order_by: Some("s-orderby"), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_13)
}

