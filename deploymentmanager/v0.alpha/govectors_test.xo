test "Go's deploymentmanager.resources.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"resources\":[{\"accessControl\":{\"gcpIamPolicy\":\"s-gcpiampolicy\"},\"finalProperties\":\"s-finalproperties\",\"id\":\"7\",\"insertTime\":\"s-inserttime\",\"lastUsedCredential\":{\"useProjectDefault\":true},\"manifest\":\"s-manifest\",\"name\":\"s-name\",\"properties\":\"s-properties\",\"runtimePolicies\":[\"s-runtimepolicies\"],\"type\":\"s-type\",\"update\":{\"finalProperties\":\"s-finalproperties\",\"intent\":\"s-intent\",\"manifest\":\"s-manifest\",\"properties\":\"s-properties\",\"state\":\"s-state\"},\"updateTime\":\"s-updatetime\",\"url\":\"s-url\",\"warnings\":[{\"code\":\"s-code\",\"message\":\"s-message\"}]}]}")
  gv_queue(f, "{\"resources\":[{\"accessControl\":{\"gcpIamPolicy\":\"s-gcpiampolicy\"},\"finalProperties\":\"s-finalproperties\",\"id\":\"7\",\"insertTime\":\"s-inserttime\",\"lastUsedCredential\":{\"useProjectDefault\":true},\"manifest\":\"s-manifest\",\"name\":\"s-name\",\"properties\":\"s-properties\",\"runtimePolicies\":[\"s-runtimepolicies\"],\"type\":\"s-type\",\"update\":{\"finalProperties\":\"s-finalproperties\",\"intent\":\"s-intent\",\"manifest\":\"s-manifest\",\"properties\":\"s-properties\",\"state\":\"s-state\"},\"updateTime\":\"s-updatetime\",\"url\":\"s-url\",\"warnings\":[{\"code\":\"s-code\",\"message\":\"s-message\"}]}]}")
  gv_note(f, "CALL deploymentmanager.resources.list pages")
  var p = svc.resources.list_pages("id1/ x", "id2/ x", options: ResourcesListOptions{filter: Some("s-filter"), max_results: Some(7), order_by: Some("s-orderby"), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_27)
}

