  gv_queue(f, "{\"compositeTypes\":[{\"description\":\"s-description\",\"id\":\"7\",\"insertTime\":\"s-inserttime\",\"name\":\"s-name\",\"operation\":{\"clientOperationId\":\"s-clientoperationid\",\"creationTimestamp\":\"s-creationtimestamp\",\"description\":\"s-description\",\"endTime\":\"s-endtime\",\"httpErrorMessage\":\"s-httperrormessage\",\"httpErrorStatusCode\":7,\"id\":\"7\",\"insertTime\":\"s-inserttime\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"operationGroupId\":\"s-operationgroupid\",\"operationType\":\"s-operationtype\",\"progress\":7,\"region\":\"s-region\",\"selfLink\":\"s-selflink\",\"selfLinkWithId\":\"s-selflinkwithid\",\"startTime\":\"s-starttime\",\"status\":\"s-status\",\"statusMessage\":\"s-statusmessage\",\"targetId\":\"7\",\"targetLink\":\"s-targetlink\",\"user\":\"s-user\",\"zone\":\"s-zone\"},\"selfLink\":\"s-selflink\",\"status\":\"s-status\",\"templateContents\":{\"interpreter\":\"s-interpreter\",\"mainTemplate\":\"s-maintemplate\",\"schema\":\"s-schema\",\"template\":\"s-template\"}}]}")
  gv_note(f, "CALL deploymentmanager.compositeTypes.list pages")
  var p = svc.composite_types.list_pages("id1/ x", options: CompositeTypesListOptions{filter: Some("s-filter"), max_results: Some(7), order_by: Some("s-orderby"), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_4)
}

