pub enum TimePeriodField {
  CloseDay as "closeDay=\"\""
  CloseTime as "closeTime"
  OpenDay as "openDay=\"\""
  OpenTime as "openTime"
} derive Json

/// UriAttributeValue: Values for an attribute with a `value_type` of URL.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct UriAttributeValue {
  /// Required. The proposed URI value for this attribute.
  pub uri as "uri,omitempty": Str = ""
  pub force_send_fields as "~forceSendFields,omitempty": List[UriAttributeValueField] = []
  pub null_fields as "~nullFields,omitempty": List[UriAttributeValueField] = []
} derive Json

/// UriAttributeValueField: UriAttributeValue's fields, for force_send_fields and null_fields.
pub enum UriAttributeValueField {
  Uri as "uri=\"\""
} derive Json
