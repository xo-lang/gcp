  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"protectedResources\":[{\"cloudProduct\":\"s-cloudproduct\",\"createTime\":\"s-createtime\",\"cryptoKeyVersion\":\"s-cryptokeyversion\",\"cryptoKeyVersions\":[\"s-cryptokeyversions\"],\"labels\":{\"k1\":\"s-labels\"},\"location\":\"s-location\",\"name\":\"s-name\",\"project\":\"s-project\",\"projectId\":\"s-projectid\",\"resourceType\":\"s-resourcetype\"}]}",
  "REQ GET https://kmsinventory.googleapis.com/v1/id1/%20x/protectedResources:search?alt=json&cryptoKey=s-cryptokey&fields=kind%2Cid&pageSize=7&pageToken=s-nextpagetoken&prettyPrint=false&resourceTypes=s-resourcetypes",
