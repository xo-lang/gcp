]

test "Go's kmsinventory.projects.protectedResources.search pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"protectedResources\":[{\"cloudProduct\":\"s-cloudproduct\",\"createTime\":\"s-createtime\",\"cryptoKeyVersion\":\"s-cryptokeyversion\",\"cryptoKeyVersions\":[\"s-cryptokeyversions\"],\"labels\":{\"k1\":\"s-labels\"},\"location\":\"s-location\",\"name\":\"s-name\",\"project\":\"s-project\",\"projectId\":\"s-projectid\",\"resourceType\":\"s-resourcetype\"}]}")
  gv_queue(f, "{\"protectedResources\":[{\"cloudProduct\":\"s-cloudproduct\",\"createTime\":\"s-createtime\",\"cryptoKeyVersion\":\"s-cryptokeyversion\",\"cryptoKeyVersions\":[\"s-cryptokeyversions\"],\"labels\":{\"k1\":\"s-labels\"},\"location\":\"s-location\",\"name\":\"s-name\",\"project\":\"s-project\",\"projectId\":\"s-projectid\",\"resourceType\":\"s-resourcetype\"}]}")
  gv_note(f, "CALL kmsinventory.projects.protectedResources.search pages")
  var p = svc.projects.protected_resources.search_pages("id1/ x", options: ProjectsProtectedResourcesSearchOptions{crypto_key: Some("s-cryptokey"), page_size: Some(7), page_token: Some("s-pagetoken"), resource_types: ["s-resourcetypes"], fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_6)
}
