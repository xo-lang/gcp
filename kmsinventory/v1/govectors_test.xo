  "OUT: {\"protectedResources\":[{\"cloudProduct\":\"s-cloudproduct\",\"createTime\":\"s-createtime\",\"cryptoKeyVersion\":\"s-cryptokeyversion\",\"cryptoKeyVersions\":[\"s-cryptokeyversions\"],\"labels\":{\"k1\":\"s-labels\"},\"location\":\"s-location\",\"name\":\"s-name\",\"project\":\"s-project\",\"projectId\":\"s-projectid\",\"resourceType\":\"s-resourcetype\"}]}",
