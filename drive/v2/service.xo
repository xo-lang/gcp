/// DrivesListPages: the pages of DrivesService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct DrivesListPages[fx: Effects] {
  r: DrivesService[fx]
  options: DrivesListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: DrivesService.list's pages, from the first.
pub fn (r: DrivesService[fx]) list_pages(options: DrivesListOptions = DrivesListOptions{}) -> DrivesListPages[fx] {
  DrivesListPages{r: r, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: DrivesListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: DrivesListPages[fx]) next_page() -> DriveList ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

