  file_id: Str
  options: PermissionsListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: PermissionsService.list's pages, from the first.
pub fn (r: PermissionsService[fx]) list_pages(file_id: Str, options: PermissionsListOptions = PermissionsListOptions{}) -> PermissionsListPages[fx] {
  PermissionsListPages{r: r, file_id: file_id, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: PermissionsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: PermissionsListPages[fx]) next_page() -> PermissionList ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.file_id, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

