test "Go's drive.revisions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"items\":[{\"downloadUrl\":\"s-downloadurl\",\"etag\":\"s-etag\",\"exportLinks\":{\"k1\":\"s-exportlinks\"},\"fileSize\":\"7\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"lastModifyingUser\":{\"displayName\":\"s-displayname\",\"emailAddress\":\"s-emailaddress\",\"isAuthenticatedUser\":true,\"kind\":\"s-kind\",\"permissionId\":\"s-permissionid\"},\"lastModifyingUserName\":\"s-lastmodifyingusername\",\"md5Checksum\":\"s-md5checksum\",\"mimeType\":\"s-mimetype\",\"modifiedDate\":\"s-modifieddate\",\"originalFilename\":\"s-originalfilename\",\"pinned\":true,\"publishAuto\":true,\"published\":true,\"publishedLink\":\"s-publishedlink\",\"publishedOutsideDomain\":true,\"selfLink\":\"s-selflink\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"selfLink\":\"s-selflink\"}")
  gv_queue(f, "{\"etag\":\"s-etag\",\"items\":[{\"downloadUrl\":\"s-downloadurl\",\"etag\":\"s-etag\",\"exportLinks\":{\"k1\":\"s-exportlinks\"},\"fileSize\":\"7\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"lastModifyingUser\":{\"displayName\":\"s-displayname\",\"emailAddress\":\"s-emailaddress\",\"isAuthenticatedUser\":true,\"kind\":\"s-kind\",\"permissionId\":\"s-permissionid\"},\"lastModifyingUserName\":\"s-lastmodifyingusername\",\"md5Checksum\":\"s-md5checksum\",\"mimeType\":\"s-mimetype\",\"modifiedDate\":\"s-modifieddate\",\"originalFilename\":\"s-originalfilename\",\"pinned\":true,\"publishAuto\":true,\"published\":true,\"publishedLink\":\"s-publishedlink\",\"publishedOutsideDomain\":true,\"selfLink\":\"s-selflink\"}],\"kind\":\"s-kind\",\"selfLink\":\"s-selflink\"}")
  gv_note(f, "CALL drive.revisions.list pages")
  var p = svc.revisions.list_pages("id1/ x", options: RevisionsListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_82)
}

