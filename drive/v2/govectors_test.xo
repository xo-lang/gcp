test "Go's drive.changes.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"items\":[{\"changeType\":\"s-changetype\",\"deleted\":true,\"drive\":{\"backgroundImageLink\":\"s-backgroundimagelink\",\"colorRgb\":\"s-colorrgb\",\"createdDate\":\"s-createddate\",\"hidden\":true,\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"orgUnitId\":\"s-orgunitid\",\"themeId\":\"s-themeid\"},\"driveId\":\"s-driveid\",\"file\":{\"alternateLink\":\"s-alternatelink\",\"appDataContents\":true,\"canComment\":true,\"canReadRevisions\":true,\"copyRequiresWriterPermission\":true,\"copyable\":true,\"createdDate\":\"s-createddate\",\"defaultOpenWithLink\":\"s-defaultopenwithlink\",\"description\":\"s-description\",\"downloadUrl\":\"s-downloadurl\",\"driveId\":\"s-driveid\",\"editable\":true,\"embedLink\":\"s-embedlink\",\"etag\":\"s-etag\",\"explicitlyTrashed\":true,\"fileExtension\":\"s-fileextension\",\"fileSize\":\"7\",\"folderColorRgb\":\"s-foldercolorrgb\",\"fullFileExtension\":\"s-fullfileextension\",\"hasAugmentedPermissions\":true,\"hasThumbnail\":true,\"headRevisionId\":\"s-headrevisionid\",\"iconLink\":\"s-iconlink\",\"id\":\"s-id\",\"inheritedPermissionsDisabled\":true,\"isAppAuthorized\":true,\"kind\":\"s-kind\",\"lastModifyingUserName\":\"s-lastmodifyingusername\",\"lastViewedByMeDate\":\"s-lastviewedbymedate\",\"markedViewedByMeDate\":\"s-markedviewedbymedate\",\"md5Checksum\":\"s-md5checksum\",\"mimeType\":\"s-mimetype\",\"modifiedByMeDate\":\"s-modifiedbymedate\",\"modifiedDate\":\"s-modifieddate\",\"originalFilename\":\"s-originalfilename\",\"ownedByMe\":true,\"quotaBytesUsed\":\"7\",\"resourceKey\":\"s-resourcekey\",\"selfLink\":\"s-selflink\",\"sha1Checksum\":\"s-sha1checksum\",\"sha256Checksum\":\"s-sha256checksum\",\"shareable\":true,\"shared\":true,\"sharedWithMeDate\":\"s-sharedwithmedate\",\"teamDriveId\":\"s-teamdriveid\",\"thumbnailLink\":\"s-thumbnaillink\",\"thumbnailVersion\":\"7\",\"title\":\"s-title\",\"trashedDate\":\"s-trasheddate\",\"version\":\"7\",\"webContentLink\":\"s-webcontentlink\",\"webViewLink\":\"s-webviewlink\",\"writersCanShare\":true},\"fileId\":\"s-fileid\",\"id\":\"7\",\"kind\":\"s-kind\",\"modificationDate\":\"s-modificationdate\",\"selfLink\":\"s-selflink\",\"teamDrive\":{\"backgroundImageLink\":\"s-backgroundimagelink\",\"colorRgb\":\"s-colorrgb\",\"createdDate\":\"s-createddate\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"orgUnitId\":\"s-orgunitid\",\"themeId\":\"s-themeid\"},\"teamDriveId\":\"s-teamdriveid\",\"type\":\"s-type\"}],\"kind\":\"s-kind\",\"largestChangeId\":\"7\",\"newStartPageToken\":\"s-newstartpagetoken\",\"nextLink\":\"s-nextlink\",\"nextPageToken\":\"s-nextpagetoken\",\"selfLink\":\"s-selflink\"}")
  gv_note(f, "CALL drive.changes.list")
  match svc.changes.list(options: ChangesListOptions{drive_id: Some("s-driveid"), include_corpus_removals: Some(true), include_deleted: Some(true), include_items_from_all_drives: Some(true), include_labels: Some("s-includelabels"), include_permissions_for_view: Some("s-includepermissionsforview"), include_subscribed: Some(true), include_team_drive_items: Some(true), max_results: Some(7), page_token: Some("s-pagetoken"), spaces: Some("s-spaces"), start_change_id: Some(7), supports_all_drives: Some(true), supports_team_drives: Some(true), team_drive_id: Some("s-teamdriveid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_5)
}

