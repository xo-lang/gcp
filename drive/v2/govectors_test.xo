test "Go's drive.replies.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"author\":{\"displayName\":\"s-displayname\",\"emailAddress\":\"s-emailaddress\",\"isAuthenticatedUser\":true,\"kind\":\"s-kind\",\"permissionId\":\"s-permissionid\"},\"content\":\"s-content\",\"createdDate\":\"s-createddate\",\"deleted\":true,\"htmlContent\":\"s-htmlcontent\",\"kind\":\"s-kind\",\"modifiedDate\":\"s-modifieddate\",\"replyId\":\"s-replyid\",\"verb\":\"s-verb\"}],\"kind\":\"s-kind\",\"nextLink\":\"s-nextlink\",\"nextPageToken\":\"s-nextpagetoken\",\"selfLink\":\"s-selflink\"}")
  gv_queue(f, "{\"items\":[{\"author\":{\"displayName\":\"s-displayname\",\"emailAddress\":\"s-emailaddress\",\"isAuthenticatedUser\":true,\"kind\":\"s-kind\",\"permissionId\":\"s-permissionid\"},\"content\":\"s-content\",\"createdDate\":\"s-createddate\",\"deleted\":true,\"htmlContent\":\"s-htmlcontent\",\"kind\":\"s-kind\",\"modifiedDate\":\"s-modifieddate\",\"replyId\":\"s-replyid\",\"verb\":\"s-verb\"}],\"kind\":\"s-kind\",\"nextLink\":\"s-nextlink\",\"selfLink\":\"s-selflink\"}")
  gv_note(f, "CALL drive.replies.list pages")
  var p = svc.replies.list_pages("id1/ x", "id2/ x", options: RepliesListOptions{include_deleted: Some(true), max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_76)
}

