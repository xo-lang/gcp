]

test "Go's drive.changes.getStartPageToken" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"kind\":\"s-kind\",\"startPageToken\":\"s-startpagetoken\"}")
  gv_note(f, "CALL drive.changes.getStartPageToken")
  match svc.changes.get_start_page_token(options: ChangesGetStartPageTokenOptions{drive_id: Some("s-driveid"), supports_all_drives: Some(true), supports_team_drives: Some(true), team_drive_id: Some("s-teamdriveid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_4)
}

