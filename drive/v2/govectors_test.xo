test "Go's drive.permissions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"items\":[{\"additionalRoles\":[\"s-additionalroles\"],\"authKey\":\"s-authkey\",\"deleted\":true,\"domain\":\"s-domain\",\"emailAddress\":\"s-emailaddress\",\"etag\":\"s-etag\",\"expirationDate\":\"s-expirationdate\",\"id\":\"s-id\",\"inheritedPermissionsDisabled\":true,\"kind\":\"s-kind\",\"name\":\"s-name\",\"pendingOwner\":true,\"permissionDetails\":[{\"inherited\":true,\"inheritedFrom\":\"s-inheritedfrom\",\"permissionType\":\"s-permissiontype\",\"role\":\"s-role\"}],\"photoLink\":\"s-photolink\",\"role\":\"s-role\",\"selfLink\":\"s-selflink\",\"teamDrivePermissionDetails\":[{\"inherited\":true,\"inheritedFrom\":\"s-inheritedfrom\",\"role\":\"s-role\",\"teamDrivePermissionType\":\"s-teamdrivepermissiontype\"}],\"type\":\"s-type\",\"value\":\"s-value\",\"view\":\"s-view\",\"withLink\":true}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"selfLink\":\"s-selflink\"}")
  gv_queue(f, "{\"etag\":\"s-etag\",\"items\":[{\"additionalRoles\":[\"s-additionalroles\"],\"authKey\":\"s-authkey\",\"deleted\":true,\"domain\":\"s-domain\",\"emailAddress\":\"s-emailaddress\",\"etag\":\"s-etag\",\"expirationDate\":\"s-expirationdate\",\"id\":\"s-id\",\"inheritedPermissionsDisabled\":true,\"kind\":\"s-kind\",\"name\":\"s-name\",\"pendingOwner\":true,\"permissionDetails\":[{\"inherited\":true,\"inheritedFrom\":\"s-inheritedfrom\",\"permissionType\":\"s-permissiontype\",\"role\":\"s-role\"}],\"photoLink\":\"s-photolink\",\"role\":\"s-role\",\"selfLink\":\"s-selflink\",\"teamDrivePermissionDetails\":[{\"inherited\":true,\"inheritedFrom\":\"s-inheritedfrom\",\"role\":\"s-role\",\"teamDrivePermissionType\":\"s-teamdrivepermissiontype\"}],\"type\":\"s-type\",\"value\":\"s-value\",\"view\":\"s-view\",\"withLink\":true}],\"kind\":\"s-kind\",\"selfLink\":\"s-selflink\"}")
  gv_note(f, "CALL drive.permissions.list pages")
  var p = svc.permissions.list_pages("id1/ x", options: PermissionsListOptions{include_permissions_for_view: Some("s-includepermissionsforview"), max_results: Some(7), page_token: Some("s-pagetoken"), supports_all_drives: Some(true), supports_team_drives: Some(true), use_domain_admin_access: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_63)
}

