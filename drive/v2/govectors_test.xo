  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"backgroundImageFile\":{\"id\":\"s-id\",\"width\":1.5,\"xCoordinate\":1.5,\"yCoordinate\":1.5},\"backgroundImageLink\":\"s-backgroundimagelink\",\"capabilities\":{\"canAddChildren\":true,\"canChangeCopyRequiresWriterPermissionRestriction\":true,\"canChangeDomainUsersOnlyRestriction\":true,\"canChangeDriveBackground\":true,\"canChangeDriveMembersOnlyRestriction\":true,\"canChangeSharingFoldersRequiresOrganizerPermissionRestriction\":true,\"canComment\":true,\"canCopy\":true,\"canDeleteChildren\":true,\"canDeleteDrive\":true,\"canDownload\":true,\"canEdit\":true,\"canListChildren\":true,\"canManageMembers\":true,\"canReadRevisions\":true,\"canRename\":true,\"canRenameDrive\":true,\"canResetDriveRestrictions\":true,\"canShare\":true,\"canTrashChildren\":true},\"colorRgb\":\"s-colorrgb\",\"createdDate\":\"s-createddate\",\"hidden\":true,\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"orgUnitId\":\"s-orgunitid\",\"restrictions\":{\"adminManagedRestrictions\":true,\"copyRequiresWriterPermission\":true,\"domainUsersOnly\":true,\"driveMembersOnly\":true,\"sharingFoldersRequiresOrganizerPermission\":true},\"themeId\":\"s-themeid\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"backgroundImageFile\":{\"id\":\"s-id\",\"width\":1.5,\"xCoordinate\":1.5,\"yCoordinate\":1.5},\"backgroundImageLink\":\"s-backgroundimagelink\",\"capabilities\":{\"canAddChildren\":true,\"canChangeCopyRequiresWriterPermissionRestriction\":true,\"canChangeDomainUsersOnlyRestriction\":true,\"canChangeDriveBackground\":true,\"canChangeDriveMembersOnlyRestriction\":true,\"canChangeSharingFoldersRequiresOrganizerPermissionRestriction\":true,\"canComment\":true,\"canCopy\":true,\"canDeleteChildren\":true,\"canDeleteDrive\":true,\"canDownload\":true,\"canEdit\":true,\"canListChildren\":true,\"canManageMembers\":true,\"canReadRevisions\":true,\"canRename\":true,\"canRenameDrive\":true,\"canResetDriveRestrictions\":true,\"canShare\":true,\"canTrashChildren\":true},\"colorRgb\":\"s-colorrgb\",\"createdDate\":\"s-createddate\",\"hidden\":true,\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"orgUnitId\":\"s-orgunitid\",\"restrictions\":{\"adminManagedRestrictions\":true,\"copyRequiresWriterPermission\":true,\"domainUsersOnly\":true,\"driveMembersOnly\":true,\"sharingFoldersRequiresOrganizerPermission\":true},\"themeId\":\"s-themeid\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL drive.drives.list pages")
  var p = svc.drives.list_pages(options: DrivesListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), q: Some("s-q"), use_domain_admin_access: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_26)
}

