test "Go's drive.comments.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"anchor\":\"s-anchor\",\"author\":{\"displayName\":\"s-displayname\",\"emailAddress\":\"s-emailaddress\",\"isAuthenticatedUser\":true,\"kind\":\"s-kind\",\"permissionId\":\"s-permissionid\"},\"commentId\":\"s-commentid\",\"content\":\"s-content\",\"context\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"createdDate\":\"s-createddate\",\"deleted\":true,\"fileId\":\"s-fileid\",\"fileTitle\":\"s-filetitle\",\"htmlContent\":\"s-htmlcontent\",\"kind\":\"s-kind\",\"modifiedDate\":\"s-modifieddate\",\"selfLink\":\"s-selflink\",\"status\":\"s-status\"}],\"kind\":\"s-kind\",\"nextLink\":\"s-nextlink\",\"nextPageToken\":\"s-nextpagetoken\",\"selfLink\":\"s-selflink\"}")
  gv_queue(f, "{\"items\":[{\"anchor\":\"s-anchor\",\"author\":{\"displayName\":\"s-displayname\",\"emailAddress\":\"s-emailaddress\",\"isAuthenticatedUser\":true,\"kind\":\"s-kind\",\"permissionId\":\"s-permissionid\"},\"commentId\":\"s-commentid\",\"content\":\"s-content\",\"context\":{\"type\":\"s-type\",\"value\":\"s-value\"},\"createdDate\":\"s-createddate\",\"deleted\":true,\"fileId\":\"s-fileid\",\"fileTitle\":\"s-filetitle\",\"htmlContent\":\"s-htmlcontent\",\"kind\":\"s-kind\",\"modifiedDate\":\"s-modifieddate\",\"selfLink\":\"s-selflink\",\"status\":\"s-status\"}],\"kind\":\"s-kind\",\"nextLink\":\"s-nextlink\",\"selfLink\":\"s-selflink\"}")
  gv_note(f, "CALL drive.comments.list pages")
  var p = svc.comments.list_pages("id1/ x", options: CommentsListOptions{include_deleted: Some(true), max_results: Some(7), page_token: Some("s-pagetoken"), updated_min: Some("s-updatedmin"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_18)
}

