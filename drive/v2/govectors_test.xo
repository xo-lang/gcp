const GO_37: List[Str] = [
  "CALL drive.files.get download",
  "REQ GET https://www.googleapis.com/drive/v2/files/id1%2F%20x?acknowledgeAbuse=true&alt=media&fields=kind%2Cid&includeLabels=s-includelabels&includePermissionsForView=s-includepermissionsforview&prettyPrint=false&projection=s-projection&revisionId=s-revisionid&supportsAllDrives=true&supportsTeamDrives=true&updateViewedDate=true",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 media-bytes \u{0001}ÿ",
  "OUT: media 200 media-bytes \u{0001}ÿ",
]

test "Go's drive.files.get download" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "media-bytes \u{0001}ÿ")
  gv_note(f, "CALL drive.files.get download")
  match svc.files.get_download("id1/ x", options: FilesGetOptions{acknowledge_abuse: Some(true), include_labels: Some("s-includelabels"), include_permissions_for_view: Some("s-includepermissionsforview"), projection: Some("s-projection"), revision_id: Some("s-revisionid"), supports_all_drives: Some(true), supports_team_drives: Some(true), update_viewed_date: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: media ${r.status} ${r.body.to_str_lossy()}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_37)
}

