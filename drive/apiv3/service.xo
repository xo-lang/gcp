/// list:  Lists the user's files. For more information, see [Search for files and folders](https://developers.google.com/workspace/drive/api/guides/search-files). This method accepts the `q` parameter, which is a search query combining one or more search terms. This method returns *all* files by default, including trashed files. If you don't want trashed files to appear in the list, use the `trashed=false` query parameter to remove trashed files from the results.
/// (Go's drive.files.list.)
pub fn (r: FilesService[fx]) list(options: FilesListOptions = FilesListOptions{}) -> FileList ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.corpora {
    q.set("corpora", v)
  }
  if let Some(v) = options.corpus {
    q.set("corpus", v)
  }
  if let Some(v) = options.drive_id {
    q.set("driveId", v)
  }
  if let Some(v) = options.include_items_from_all_drives {
    q.set("includeItemsFromAllDrives", "${v}")
  }
  if let Some(v) = options.include_labels {
    q.set("includeLabels", v)
  }
  if let Some(v) = options.include_permissions_for_view {
    q.set("includePermissionsForView", v)
  }
  if let Some(v) = options.include_team_drive_items {
    q.set("includeTeamDriveItems", "${v}")
  }
  if let Some(v) = options.order_by {
    q.set("orderBy", v)
  }
  if let Some(v) = options.page_size {
    q.set("pageSize", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if let Some(v) = options.q {
