pub fn (r: FilesService[fx]) create_media(clock: Clock, rand: Rand, file: File, media: gensupport.Media, options: FilesCreateOptions = FilesCreateOptions{}) -> File ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.enforce_single_parent {
    q.set("enforceSingleParent", "${v}")
  }
  if let Some(v) = options.ignore_default_visibility {
    q.set("ignoreDefaultVisibility", "${v}")
  }
  if let Some(v) = options.include_labels {
    q.set("includeLabels", v)
  }
  if let Some(v) = options.include_permissions_for_view {
    q.set("includePermissionsForView", v)
  }
  if let Some(v) = options.keep_revision_forever {
    q.set("keepRevisionForever", "${v}")
  }
  if let Some(v) = options.ocr_language {
    q.set("ocrLanguage", v)
  }
  if let Some(v) = options.supports_all_drives {
    q.set("supportsAllDrives", "${v}")
  }
  if let Some(v) = options.supports_team_drives {
    q.set("supportsTeamDrives", "${v}")
  }
  if let Some(v) = options.use_content_as_indexable_text {
    q.set("useContentAsIndexableText", "${v}")
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs.push(("Content-Type", "application/json"))
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "files"), {})
  let mu = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "/upload/drive/v3/files"), {})
  let resp = r.core.client.upload(clock, rand, gensupport.Request{method: "POST", url: u, query: q, headers: hs, body: gensupport.json_body(file, data_wrapper: false)}, mu, media)?
  gensupport.check(resp)?
  gensupport.decode[File](resp)
}

