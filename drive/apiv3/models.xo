  /// Output only. The user's ID as visible in Permission resources.
  pub permission_id as "permissionId,omitempty": Str = ""
  /// Output only. A link to the user's profile photo, if available.
  pub photo_link as "photoLink,omitempty": Str = ""
  pub force_send_fields as "-": List[UserField] = []
  pub null_fields as "-": List[UserField] = []
} derive Json

/// UserField: User's fields, for force_send_fields and null_fields.
pub enum UserField {
  DisplayName
  EmailAddress
  Kind
  Me
  PermissionId
  PhotoLink
}

fn user_field_entry(f: UserField) -> Str {
  match f {
    DisplayName => "displayName=\"\""
    EmailAddress => "emailAddress=\"\""
    Kind => "kind=\"\""
    Me => "me=false"
    PermissionId => "permissionId=\"\""
    PhotoLink => "photoLink=\"\""
  }
}

/// body_marked: whether m, or a model in it, sets force_send_fields or
/// null_fields (decision 0013; the service's request bodies ask).
pub fn (m: User) body_marked() -> Bool {
  if m.force_send_fields.len() > 0 || m.null_fields.len() > 0 {
    return true
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: User) body_mark(v: json.Value) -> json.Value {
  var o = v
  gensupport.mark(o, m.force_send_fields.map(user_field_entry), m.null_fields.map(user_field_entry))
}
