  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"id\":\"s-id\",\"items\":[{\"actor\":{\"clientSpecificActorInfo\":{},\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"image\":{\"url\":\"s-url\"},\"url\":\"s-url\",\"verification\":{\"adHocVerified\":\"s-adhocverified\"}},\"etag\":\"s-etag\",\"id\":\"s-id\",\"inReplyTo\":[{\"id\":\"s-id\",\"url\":\"s-url\"}],\"kind\":\"s-kind\",\"object\":{\"content\":\"s-content\",\"objectType\":\"s-objecttype\",\"originalContent\":\"s-originalcontent\"},\"plusoners\":{\"totalItems\":7},\"published\":\"s-published\",\"selfLink\":\"s-selflink\",\"updated\":\"s-updated\",\"verb\":\"s-verb\"}],\"kind\":\"s-kind\",\"nextLink\":\"s-nextlink\",\"nextPageToken\":\"s-nextpagetoken\",\"title\":\"s-title\",\"updated\":\"s-updated\"}")
  gv_queue(f, "{\"etag\":\"s-etag\",\"id\":\"s-id\",\"items\":[{\"actor\":{\"clientSpecificActorInfo\":{},\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"image\":{\"url\":\"s-url\"},\"url\":\"s-url\",\"verification\":{\"adHocVerified\":\"s-adhocverified\"}},\"etag\":\"s-etag\",\"id\":\"s-id\",\"inReplyTo\":[{\"id\":\"s-id\",\"url\":\"s-url\"}],\"kind\":\"s-kind\",\"object\":{\"content\":\"s-content\",\"objectType\":\"s-objecttype\",\"originalContent\":\"s-originalcontent\"},\"plusoners\":{\"totalItems\":7},\"published\":\"s-published\",\"selfLink\":\"s-selflink\",\"updated\":\"s-updated\",\"verb\":\"s-verb\"}],\"kind\":\"s-kind\",\"nextLink\":\"s-nextlink\",\"title\":\"s-title\",\"updated\":\"s-updated\"}")
  gv_note(f, "CALL plus.comments.list pages")
  var p = svc.comments.list_pages("id1/ x", options: CommentsListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), sort_order: Some("s-sortorder"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_7)
}

