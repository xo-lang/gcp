test "Go's plus.activities.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"id\":\"s-id\",\"items\":[{\"access\":{\"description\":\"s-description\",\"kind\":\"s-kind\"},\"actor\":{\"clientSpecificActorInfo\":{},\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"image\":{\"url\":\"s-url\"},\"name\":{\"familyName\":\"s-familyname\",\"givenName\":\"s-givenname\"},\"url\":\"s-url\",\"verification\":{\"adHocVerified\":\"s-adhocverified\"}},\"address\":\"s-address\",\"annotation\":\"s-annotation\",\"crosspostSource\":\"s-crosspostsource\",\"etag\":\"s-etag\",\"geocode\":\"s-geocode\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"location\":{\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"kind\":\"s-kind\"},\"object\":{\"actor\":{\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"url\":\"s-url\"},\"content\":\"s-content\",\"id\":\"s-id\",\"objectType\":\"s-objecttype\",\"originalContent\":\"s-originalcontent\",\"plusoners\":{\"selfLink\":\"s-selflink\",\"totalItems\":7},\"replies\":{\"selfLink\":\"s-selflink\",\"totalItems\":7},\"resharers\":{\"selfLink\":\"s-selflink\",\"totalItems\":7},\"url\":\"s-url\"},\"placeId\":\"s-placeid\",\"placeName\":\"s-placename\",\"provider\":{\"title\":\"s-title\"},\"published\":\"s-published\",\"radius\":\"s-radius\",\"title\":\"s-title\",\"updated\":\"s-updated\",\"url\":\"s-url\",\"verb\":\"s-verb\"}],\"kind\":\"s-kind\",\"nextLink\":\"s-nextlink\",\"nextPageToken\":\"s-nextpagetoken\",\"selfLink\":\"s-selflink\",\"title\":\"s-title\",\"updated\":\"s-updated\"}")
  gv_note(f, "CALL plus.activities.list")
  match svc.activities.list("id1/ x", "id2/ x", options: ActivitiesListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_1)
}

