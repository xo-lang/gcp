le\":\"s-title\",\"updated\":\"s-updated\",\"url\":\"s-url\",\"verb\":\"s-verb\"}")
  gv_note(f, "CALL plus.activities.get")
  match svc.activities.get("id1/ x", options: ActivitiesGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
