  gv_set(f, "{\"breakpoint\":{\"action\":\"s-action\",\"canaryExpireTime\":\"s-canaryexpiretime\",\"condition\":\"s-condition\",\"createTime\":\"s-createtime\",\"evaluatedExpressions\":[{\"name\":\"s-name\",\"type\":\"s-type\",\"value\":\"s-value\",\"varTableIndex\":7}],\"expressions\":[\"s-expressions\"],\"finalTime\":\"s-finaltime\",\"id\":\"s-id\",\"isFinalState\":true,\"labels\":{\"k1\":\"s-labels\"},\"location\":{\"column\":7,\"line\":7,\"path\":\"s-path\"},\"logLevel\":\"s-loglevel\",\"logMessageFormat\":\"s-logmessageformat\",\"stackFrames\":[{\"function\":\"s-function\"}],\"state\":\"s-state\",\"status\":{\"isError\":true,\"refersTo\":\"s-refersto\"},\"userEmail\":\"s-useremail\",\"variableTable\":[{\"name\":\"s-name\",\"type\":\"s-type\",\"value\":\"s-value\",\"varTableIndex\":7}]}}")
  gv_note(f, "CALL clouddebugger.debugger.debuggees.breakpoints.set")
  match svc.debugger.debuggees.breakpoints.set("id1/ x", json.decode_str[Breakpoint]("{\"action\":\"s-action\",\"canaryExpireTime\":\"s-canaryexpiretime\",\"condition\":\"s-condition\",\"createTime\":\"s-createtime\",\"evaluatedExpressions\":[{\"name\":\"s-name\",\"status\":{\"isError\":true,\"refersTo\":\"s-refersto\"},\"type\":\"s-type\",\"value\":\"s-value\",\"varTableIndex\":7}],\"expressions\":[\"s-expressions\"],\"finalTime\":\"s-finaltime\",\"id\":\"s-id\",\"isFinalState\":true,\"labels\":{\"k1\":\"s-labels\"},\"location\":{\"column\":7,\"line\":7,\"path\":\"s-path\"},\"logLevel\":\"s-loglevel\",\"logMessageFormat\":\"s-logmessageformat\",\"stackFrames\":[{\"function\":\"s-function\",\"location\":{\"column\":7,\"line\":7,\"path\":\"s-path\"}}],\"state\":\"s-state\",\"status\":{\"description\":{\"format\":\"s-format\",\"parameters\":[\"s-parameters\"]},\"isError\":true,\"refersTo\":\"s-refersto\"},\"userEmail\":\"s-useremail\",\"variableTable\":[{\"name\":\"s-name\",\"status\":{\"isError\":true,\"refersTo\":\"s-refersto\"},\"type\":\"s-type\",\"value\":\"s-value\",\"varTableIndex\":7}]}") ?? e => fault(e.display()), options: DebuggerDebuggeesBreakpointsSetOptions{canary_option: Some("s-canaryoption"), client_version: Some("s-clientversion"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_7)
}
