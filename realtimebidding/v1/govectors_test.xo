  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"allowedUserTargetingModes\":[\"s-allowedusertargetingmodes\"],\"appTargeting\":{\"mobileAppCategoryTargeting\":{\"excludedIds\":[\"7\"],\"includedIds\":[\"7\"]},\"mobileAppTargeting\":{\"targetingMode\":\"s-targetingmode\",\"values\":[\"s-values\"]}},\"billingId\":\"7\",\"displayName\":\"s-displayname\",\"excludedContentLabelIds\":[\"7\"],\"geoTargeting\":{\"excludedIds\":[\"7\"],\"includedIds\":[\"7\"]},\"includedCreativeDimensions\":[{\"height\":\"7\",\"width\":\"7\"}],\"includedEnvironments\":[\"s-includedenvironments\"],\"includedFormats\":[\"s-includedformats\"],\"includedLanguages\":[\"s-includedlanguages\"],\"includedMobileOperatingSystemIds\":[\"7\"],\"includedPlatforms\":[\"s-includedplatforms\"],\"includedUserIdTypes\":[\"s-includeduseridtypes\"],\"interstitialTargeting\":\"s-interstitialtargeting\",\"invalidGeoIds\":[\"7\"],\"maximumQps\":\"7\",\"minimumViewabilityDecile\":7,\"name\":\"s-name\",\"publisherTargeting\":{\"targetingMode\":\"s-targetingmode\",\"values\":[\"s-values\"]},\"state\":\"s-state\",\"userListTargeting\":{\"excludedIds\":[\"7\"],\"includedIds\":[\"7\"]},\"verticalTargeting\":{\"excludedIds\":[\"7\"],\"includedIds\":[\"7\"]},\"webTargeting\":{\"targetingMode\":\"s-targetingmode\",\"values\":[\"s-values\"]}}")
  gv_note(f, "CALL realtimebidding.bidders.pretargetingConfigs.addTargetedApps")
  match svc.bidders.pretargeting_configs.add_targeted_apps("id1/ x", json.decode_str[AddTargetedAppsRequest]("{\"appIds\":[\"s-appids\"],\"targetingMode\":\"s-targetingmode\"}") ?? e => fault(e.display()), options: BiddersPretargetingConfigsAddTargetedAppsOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_8)
}

