  WebhookData
}

fn webhook_subscriptions_field_entry(f: WebhookSubscriptionsField) -> Str {
  match f {
    WebhookData => "webhookData=[]"
  }
}

/// body_marked: whether m, or a model in it, sets force_send_fields or
/// null_fields (decision 0013; the service's request bodies ask).
pub fn (m: WebhookSubscriptions) body_marked() -> Bool {
  if m.force_send_fields.len() > 0 || m.null_fields.len() > 0 {
    return true
  }
  for c in m.webhook_data {
    if c.body_marked() {
      return true
    }
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: WebhookSubscriptions) body_mark(v: json.Value) -> json.Value {
  var o = v
  o = gensupport.mark_field(o, "webhookData", fn(x: json.Value) -> json.Value { gensupport.mark_list(x, fn(i: Int, e: json.Value) -> json.Value { m.webhook_data[i].body_mark(e) }) })
  gensupport.mark(o, m.force_send_fields.map(webhook_subscriptions_field_entry), m.null_fields.map(webhook_subscriptions_field_entry))
}

