  gv_note(f, "CALL connectors.projects.locations.connections.actions.list pages")
  var p = svc.projects.locations.connections.actions.list_pages("id1/ x", options: ProjectsLocationsConnectionsActionsListOptions{execution_config_headers: Some("s-executionconfig.headers"), page_size: Some(7), page_token: Some("s-pagetoken"), view: Some("s-view"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_13)
}

