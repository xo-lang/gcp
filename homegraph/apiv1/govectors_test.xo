// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://homegraph.googleapis.com"

const GO_0: List[Str] = [
  "CALL homegraph.agentUsers.delete",
  "REQ DELETE https://homegraph.googleapis.com/v1/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false&requestId=s-requestid",
  "  H x-extra=v1",
  "  B ",
  "  SERVED 200 {}",
  "OUT: {}",
]

test "Go's homegraph.agentUsers.delete" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{}")
  gv_note(f, "CALL homegraph.agentUsers.delete")
  match svc.agent_users.delete("id1/ x", options: AgentUsersDeleteOptions{request_id: Some("s-requestid"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

