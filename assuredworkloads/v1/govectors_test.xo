  gv_set(f, "{\"dbFrameworkComplianceSummaries\":[{\"controlAssessmentDetails\":{\"assessedPassingControls\":7,\"failingControls\":7,\"notAssessedControls\":7,\"passingControls\":7},\"controlsPassingTrend\":{\"duration\":\"s-duration\",\"valuePercent\":1.5},\"findingCount\":\"7\",\"framework\":\"s-framework\",\"frameworkCategories\":[\"s-frameworkcategories\"],\"frameworkDisplayName\":\"s-frameworkdisplayname\",\"frameworkType\":\"s-frameworktype\",\"majorRevisionId\":\"7\",\"minorRevisionId\":\"7\",\"name\":\"s-name\",\"supportedCloudProviders\":[\"s-supportedcloudproviders\"]}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_note(f, "CALL assuredworkloads.projects.locations.dbFrameworkComplianceSummaries.list")
  match svc.projects.locations.db_framework_compliance_summaries.list("id1/ x", options: ProjectsLocationsDbFrameworkComplianceSummariesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), view: Some("s-view"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_31)
}
