  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"taxonomies\":[{\"activatedPolicyTypes\":[\"s-activatedpolicytypes\"],\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"policyTagCount\":7,\"service\":{\"identity\":\"s-identity\",\"name\":\"s-name\"},\"taxonomyTimestamps\":{\"createTime\":\"s-createtime\",\"expireTime\":\"s-expiretime\",\"updateTime\":\"s-updatetime\"}}]}")
  gv_queue(f, "{\"taxonomies\":[{\"activatedPolicyTypes\":[\"s-activatedpolicytypes\"],\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"policyTagCount\":7,\"service\":{\"identity\":\"s-identity\",\"name\":\"s-name\"},\"taxonomyTimestamps\":{\"createTime\":\"s-createtime\",\"expireTime\":\"s-expiretime\",\"updateTime\":\"s-updatetime\"}}]}")
  gv_note(f, "CALL datacatalog.projects.locations.taxonomies.list pages")
  var p = svc.projects.locations.taxonomies.list_pages("id1/ x", options: ProjectsLocationsTaxonomiesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
