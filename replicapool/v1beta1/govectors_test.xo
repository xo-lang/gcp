test "Go's replicapool.pools.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"resources\":[{\"autoRestart\":true,\"baseInstanceName\":\"s-baseinstancename\",\"currentNumReplicas\":7,\"description\":\"s-description\",\"initialNumReplicas\":7,\"name\":\"s-name\",\"numReplicas\":7,\"resourceViews\":[\"s-resourceviews\"],\"selfLink\":\"s-selflink\",\"targetPool\":\"s-targetpool\",\"targetPools\":[\"s-targetpools\"],\"template\":{\"version\":\"s-version\"},\"type\":\"s-type\"}]}")
  gv_queue(f, "{\"resources\":[{\"autoRestart\":true,\"baseInstanceName\":\"s-baseinstancename\",\"currentNumReplicas\":7,\"description\":\"s-description\",\"initialNumReplicas\":7,\"name\":\"s-name\",\"numReplicas\":7,\"resourceViews\":[\"s-resourceviews\"],\"selfLink\":\"s-selflink\",\"targetPool\":\"s-targetpool\",\"targetPools\":[\"s-targetpools\"],\"template\":{\"version\":\"s-version\"},\"type\":\"s-type\"}]}")
  gv_note(f, "CALL replicapool.pools.list pages")
  var p = svc.pools.list_pages("id1/ x", "id2/ x", options: PoolsListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_4)
}

