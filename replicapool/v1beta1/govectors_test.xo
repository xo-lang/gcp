test "Go's replicapool.replicas.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"resources\":[{\"name\":\"s-name\",\"selfLink\":\"s-selflink\",\"status\":{\"details\":\"s-details\",\"state\":\"s-state\",\"templateVersion\":\"s-templateversion\",\"vmLink\":\"s-vmlink\",\"vmStartTime\":\"s-vmstarttime\"}}]}")
  gv_queue(f, "{\"resources\":[{\"name\":\"s-name\",\"selfLink\":\"s-selflink\",\"status\":{\"details\":\"s-details\",\"state\":\"s-state\",\"templateVersion\":\"s-templateversion\",\"vmLink\":\"s-vmlink\",\"vmStartTime\":\"s-vmstarttime\"}}]}")
  gv_note(f, "CALL replicapool.replicas.list pages")
  var p = svc.replicas.list_pages("id1/ x", "id2/ x", "id3/ x", options: ReplicasListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_10)
}

