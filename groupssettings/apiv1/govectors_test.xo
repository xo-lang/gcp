test "Go's groupsSettings.groups.update" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"allowExternalMembers\":\"s-allowexternalmembers\",\"allowGoogleCommunication\":\"s-allowgooglecommunication\",\"allowWebPosting\":\"s-allowwebposting\",\"archiveOnly\":\"s-archiveonly\",\"customFooterText\":\"s-customfootertext\",\"customReplyTo\":\"s-customreplyto\",\"customRolesEnabledForSettingsToBeMerged\":\"s-customrolesenabledforsettingstobemerged\",\"defaultMessageDenyNotificationText\":\"s-defaultmessagedenynotificationtext\",\"default_sender\":\"s-default_sender\",\"description\":\"s-description\",\"email\":\"s-email\",\"enableCollaborativeInbox\":\"s-enablecollaborativeinbox\",\"favoriteRepliesOnTop\":\"s-favoriterepliesontop\",\"includeCustomFooter\":\"s-includecustomfooter\",\"includeInGlobalAddressList\":\"s-includeinglobaladdresslist\",\"isArchived\":\"s-isarchived\",\"kind\":\"s-kind\",\"maxMessageBytes\":7,\"membersCanPostAsTheGroup\":\"s-memberscanpostasthegroup\",\"messageDisplayFont\":\"s-messagedisplayfont\",\"messageModerationLevel\":\"s-messagemoderationlevel\",\"name\":\"s-name\",\"primaryLanguage\":\"s-primarylanguage\",\"replyTo\":\"s-replyto\",\"sendMessageDenyNotification\":\"s-sendmessagedenynotification\",\"showInGroupDirectory\":\"s-showingroupdirectory\",\"spamModerationLevel\":\"s-spammoderationlevel\",\"whoCanAdd\":\"s-whocanadd\",\"whoCanAddReferences\":\"s-whocanaddreferences\",\"whoCanApproveMembers\":\"s-whocanapprovemembers\",\"whoCanApproveMessages\":\"s-whocanapprovemessages\",\"whoCanAssignTopics\":\"s-whocanassigntopics\",\"whoCanAssistContent\":\"s-whocanassistcontent\",\"whoCanBanUsers\":\"s-whocanbanusers\",\"whoCanContactOwner\":\"s-whocancontactowner\",\"whoCanDeleteAnyPost\":\"s-whocandeleteanypost\",\"whoCanDeleteTopics\":\"s-whocandeletetopics\",\"whoCanDiscoverGroup\":\"s-whocandiscovergroup\",\"whoCanEnterFreeFormTags\":\"s-whocanenterfreeformtags\",\"whoCanHideAbuse\":\"s-whocanhideabuse\",\"whoCanInvite\":\"s-whocaninvite\",\"whoCanJoin\":\"s-whocanjoin\",\"whoCanLeaveGroup\":\"s-whocanleavegroup\",\"whoCanLockTopics\":\"s-whocanlocktopics\",\"whoCanMakeTopicsSticky\":\"s-whocanmaketopicssticky\",\"whoCanMarkDuplicate\":\"s-whocanmarkduplicate\",\"whoCanMarkFavoriteReplyOnAnyTopic\":\"s-whocanmarkfavoritereplyonanytopic\",\"whoCanMarkFavoriteReplyOnOwnTopic\":\"s-whocanmarkfavoritereplyonowntopic\",\"whoCanMarkNoResponseNeeded\":\"s-whocanmarknoresponseneeded\",\"whoCanModerateContent\":\"s-whocanmoderatecontent\",\"whoCanModerateMembers\":\"s-whocanmoderatemembers\",\"whoCanModifyMembers\":\"s-whocanmodifymembers\",\"whoCanModifyTagsAndCategories\":\"s-whocanmodifytagsandcategories\",\"whoCanMoveTopicsIn\":\"s-whocanmovetopicsin\",\"whoCanMoveTopicsOut\":\"s-whocanmovetopicsout\",\"whoCanPostAnnouncements\":\"s-whocanpostannouncements\",\"whoCanPostMessage\":\"s-whocanpostmessage\",\"whoCanTakeTopics\":\"s-whocantaketopics\",\"whoCanUnassignTopic\":\"s-whocanunassigntopic\",\"whoCanUnmarkFavoriteReplyOnAnyTopic\":\"s-whocanunmarkfavoritereplyonanytopic\",\"whoCanViewGroup\":\"s-whocanviewgroup\",\"whoCanViewMembership\":\"s-whocanviewmembership\"}")
  gv_note(f, "CALL groupsSettings.groups.update")
  match svc.groups.update("id1/ x", json.decode_str[Groups]("{\"allowExternalMembers\":\"s-allowexternalmembers\",\"allowGoogleCommunication\":\"s-allowgooglecommunication\",\"allowWebPosting\":\"s-allowwebposting\",\"archiveOnly\":\"s-archiveonly\",\"customFooterText\":\"s-customfootertext\",\"customReplyTo\":\"s-customreplyto\",\"customRolesEnabledForSettingsToBeMerged\":\"s-customrolesenabledforsettingstobemerged\",\"defaultMessageDenyNotificationText\":\"s-defaultmessagedenynotificationtext\",\"default_sender\":\"s-default_sender\",\"description\":\"s-description\",\"email\":\"s-email\",\"enableCollaborativeInbox\":\"s-enablecollaborativeinbox\",\"favoriteRepliesOnTop\":\"s-favoriterepliesontop\",\"includeCustomFooter\":\"s-includecustomfooter\",\"includeInGlobalAddressList\":\"s-includeinglobaladdresslist\",\"isArchived\":\"s-isarchived\",\"kind\":\"s-kind\",\"maxMessageBytes\":7,\"membersCanPostAsTheGroup\":\"s-memberscanpostasthegroup\",\"messageDisplayFont\":\"s-messagedisplayfont\",\"messageModerationLevel\":\"s-messagemoderationlevel\",\"name\":\"s-name\",\"primaryLanguage\":\"s-primarylanguage\",\"replyTo\":\"s-replyto\",\"sendMessageDenyNotification\":\"s-sendmessagedenynotification\",\"showInGroupDirectory\":\"s-showingroupdirectory\",\"spamModerationLevel\":\"s-spammoderationlevel\",\"whoCanAdd\":\"s-whocanadd\",\"whoCanAddReferences\":\"s-whocanaddreferences\",\"whoCanApproveMembers\":\"s-whocanapprovemembers\",\"whoCanApproveMessages\":\"s-whocanapprovemessages\",\"whoCanAssignTopics\":\"s-whocanassigntopics\",\"whoCanAssistContent\":\"s-whocanassistcontent\",\"whoCanBanUsers\":\"s-whocanbanusers\",\"whoCanContactOwner\":\"s-whocancontactowner\",\"whoCanDeleteAnyPost\":\"s-whocandeleteanypost\",\"whoCanDeleteTopics\":\"s-whocandeletetopics\",\"whoCanDiscoverGroup\":\"s-whocandiscovergroup\",\"whoCanEnterFreeFormTags\":\"s-whocanenterfreeformtags\",\"whoCanHideAbuse\":\"s-whocanhideabuse\",\"whoCanInvite\":\"s-whocaninvite\",\"whoCanJoin\":\"s-whocanjoin\",\"whoCanLeaveGroup\":\"s-whocanleavegroup\",\"whoCanLockTopics\":\"s-whocanlocktopics\",\"whoCanMakeTopicsSticky\":\"s-whocanmaketopicssticky\",\"whoCanMarkDuplicate\":\"s-whocanmarkduplicate\",\"whoCanMarkFavoriteReplyOnAnyTopic\":\"s-whocanmarkfavoritereplyonanytopic\",\"whoCanMarkFavoriteReplyOnOwnTopic\":\"s-whocanmarkfavoritereplyonowntopic\",\"whoCanMarkNoResponseNeeded\":\"s-whocanmarknoresponseneeded\",\"whoCanModerateContent\":\"s-whocanmoderatecontent\",\"whoCanModerateMembers\":\"s-whocanmoderatemembers\",\"whoCanModifyMembers\":\"s-whocanmodifymembers\",\"whoCanModifyTagsAndCategories\":\"s-whocanmodifytagsandcategories\",\"whoCanMoveTopicsIn\":\"s-whocanmovetopicsin\",\"whoCanMoveTopicsOut\":\"s-whocanmovetopicsout\",\"whoCanPostAnnouncements\":\"s-whocanpostannouncements\",\"whoCanPostMessage\":\"s-whocanpostmessage\",\"whoCanTakeTopics\":\"s-whocantaketopics\",\"whoCanUnassignTopic\":\"s-whocanunassigntopic\",\"whoCanUnmarkFavoriteReplyOnAnyTopic\":\"s-whocanunmarkfavoritereplyonanytopic\",\"whoCanViewGroup\":\"s-whocanviewgroup\",\"whoCanViewMembership\":\"s-whocanviewmembership\"}") ?? e => fault(e.display()), options: GroupsUpdateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_2)
}
