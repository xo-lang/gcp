test "Go's networkservices.projects.locations.wasmPlugins.versions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"unreachable\":[\"s-unreachable\"],\"wasmPluginVersions\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"imageDigest\":\"s-imagedigest\",\"imageUri\":\"s-imageuri\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"pluginConfigData\":\"YWI=\",\"pluginConfigDigest\":\"s-pluginconfigdigest\",\"pluginConfigUri\":\"s-pluginconfiguri\",\"updateTime\":\"s-updatetime\"}]}")
  gv_queue(f, "{\"unreachable\":[\"s-unreachable\"],\"wasmPluginVersions\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"imageDigest\":\"s-imagedigest\",\"imageUri\":\"s-imageuri\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"pluginConfigData\":\"YWI=\",\"pluginConfigDigest\":\"s-pluginconfigdigest\",\"pluginConfigUri\":\"s-pluginconfiguri\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL networkservices.projects.locations.wasmPlugins.versions.list pages")
  var p = svc.projects.locations.wasm_plugins.versions.list_pages("id1/ x", options: ProjectsLocationsWasmPluginsVersionsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_146)
}
