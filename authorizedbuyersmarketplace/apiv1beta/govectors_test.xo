test "Go's authorizedbuyersmarketplace.curators.dataSegments.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"dataSegments\":[{\"cpmFee\":{\"currencyCode\":\"s-currencycode\",\"nanos\":7,\"units\":\"7\"},\"createTime\":\"s-createtime\",\"millipercentOfMediaFee\":\"7\",\"name\":\"s-name\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"userListId\":\"s-userlistid\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"dataSegments\":[{\"cpmFee\":{\"currencyCode\":\"s-currencycode\",\"nanos\":7,\"units\":\"7\"},\"createTime\":\"s-createtime\",\"millipercentOfMediaFee\":\"7\",\"name\":\"s-name\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"userListId\":\"s-userlistid\"}]}")
  gv_note(f, "CALL authorizedbuyersmarketplace.curators.dataSegments.list pages")
  var p = svc.curators.data_segments.list_pages("id1/ x", options: CuratorsDataSegmentsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_12)
}

