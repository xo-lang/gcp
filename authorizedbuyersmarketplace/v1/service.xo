pub fn (r: BuyersProposalsDealsService[fx]) patch(nameid: Str, deal: Deal, options: BuyersProposalsDealsPatchOptions = BuyersProposalsDealsPatchOptions{}) -> Deal ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.update_mask {
    q.set("updateMask", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs.push(("Content-Type", "application/json"))
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v1/{+name}"), {"name": nameid})
  let resp = r.core.client.send(gensupport.Request{method: "PATCH", url: u, query: q, headers: hs, body: gensupport.json_body(deal, data_wrapper: false)})?
  gensupport.check(resp)?
  gensupport.decode[Deal](resp)
}

