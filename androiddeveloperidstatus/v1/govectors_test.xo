// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 androiddeveloperidstatus/v1 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://androiddeveloperidstatus.googleapis.com"

const GO_0: List[Str] = [
  "CALL androiddeveloperidstatus.packages.packageRegistrationStatus.check",
  "REQ GET https://androiddeveloperidstatus.googleapis.com/v1/id1/%20x:check?alt=json&certificateFingerprint=s-certificatefingerprint&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"certificateFingerprint\":\"s-certificatefingerprint\",\"name\":\"s-name\",\"state\":\"s-state\"}",
  "OUT: {\"certificateFingerprint\":\"s-certificatefingerprint\",\"name\":\"s-name\",\"state\":\"s-state\"}",
]

test "Go's androiddeveloperidstatus.packages.packageRegistrationStatus.check" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"certificateFingerprint\":\"s-certificatefingerprint\",\"name\":\"s-name\",\"state\":\"s-state\"}")
  gv_note(f, "CALL androiddeveloperidstatus.packages.packageRegistrationStatus.check")
  match svc.packages.package_registration_status.check("id1/ x", options: PackagesPackageRegistrationStatusCheckOptions{certificate_fingerprint: Some("s-certificatefingerprint"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
