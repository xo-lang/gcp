test "Go's saasservicemgmt.projects.locations.units.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"units\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"application\":\"s-application\",\"createTime\":\"s-createtime\",\"engine\":{\"engineId\":\"s-engineid\",\"location\":\"s-location\"},\"etag\":\"s-etag\",\"flagConfigName\":\"s-flagconfigname\",\"flagRevisions\":[\"s-flagrevisions\"],\"labels\":{\"k1\":\"s-labels\"},\"maintenance\":{\"pinnedUntilTime\":\"s-pinneduntiltime\"},\"managementMode\":\"s-managementmode\",\"name\":\"s-name\",\"ongoingOperations\":[\"s-ongoingoperations\"],\"pendingOperations\":[\"s-pendingoperations\"],\"release\":\"s-release\",\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"scheduledOperations\":[\"s-scheduledoperations\"],\"state\":\"s-state\",\"systemCleanupAt\":\"s-systemcleanupat\",\"systemManagedState\":\"s-systemmanagedstate\",\"tenant\":\"s-tenant\",\"uid\":\"s-uid\",\"unitGroup\":\"s-unitgroup\",\"unitKind\":\"s-unitkind\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"units\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"application\":\"s-application\",\"createTime\":\"s-createtime\",\"engine\":{\"engineId\":\"s-engineid\",\"location\":\"s-location\"},\"etag\":\"s-etag\",\"flagConfigName\":\"s-flagconfigname\",\"flagRevisions\":[\"s-flagrevisions\"],\"labels\":{\"k1\":\"s-labels\"},\"maintenance\":{\"pinnedUntilTime\":\"s-pinneduntiltime\"},\"managementMode\":\"s-managementmode\",\"name\":\"s-name\",\"ongoingOperations\":[\"s-ongoingoperations\"],\"pendingOperations\":[\"s-pendingoperations\"],\"release\":\"s-release\",\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"scheduledOperations\":[\"s-scheduledoperations\"],\"state\":\"s-state\",\"systemCleanupAt\":\"s-systemcleanupat\",\"systemManagedState\":\"s-systemmanagedstate\",\"tenant\":\"s-tenant\",\"uid\":\"s-uid\",\"unitGroup\":\"s-unitgroup\",\"unitKind\":\"s-unitkind\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL saasservicemgmt.projects.locations.units.list pages")
  var p = svc.projects.locations.units.list_pages("id1/ x", options: ProjectsLocationsUnitsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_79)
}

