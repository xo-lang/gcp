test "Go's saasservicemgmt.projects.locations.releases.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"releases\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"applicationTemplateComponent\":{\"component\":\"s-component\",\"revision\":\"s-revision\"},\"blueprint\":{\"engine\":\"s-engine\",\"package\":\"s-package\",\"version\":\"s-version\"},\"createTime\":\"s-createtime\",\"etag\":\"s-etag\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"releaseRequirements\":{},\"uid\":\"s-uid\",\"unitKind\":\"s-unitkind\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"releases\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"applicationTemplateComponent\":{\"component\":\"s-component\",\"revision\":\"s-revision\"},\"blueprint\":{\"engine\":\"s-engine\",\"package\":\"s-package\",\"version\":\"s-version\"},\"createTime\":\"s-createtime\",\"etag\":\"s-etag\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"releaseRequirements\":{},\"uid\":\"s-uid\",\"unitKind\":\"s-unitkind\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
