test "Go's dlp.organizations.locations.inspectTemplates.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"inspectTemplates\":[{\"allowLimitedAvailabilityInfoTypes\":true,\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"inspectConfig\":{\"excludeInfoTypes\":true,\"includeQuote\":true,\"minLikelihood\":\"s-minlikelihood\"},\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"inspectTemplates\":[{\"allowLimitedAvailabilityInfoTypes\":true,\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"inspectConfig\":{\"excludeInfoTypes\":true,\"includeQuote\":true,\"minLikelihood\":\"s-minlikelihood\"},\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL dlp.organizations.locations.inspectTemplates.list pages")
  var p = svc.organizations.locations.inspect_templates.list_pages("id1/ x", options: OrganizationsLocationsInspectTemplatesListOptions{location_id: Some("s-locationid"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
