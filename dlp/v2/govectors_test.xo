  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"discoveryConfigs\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"inspectTemplates\":[\"s-inspecttemplates\"],\"lastRunTime\":\"s-lastruntime\",\"name\":\"s-name\",\"orgConfig\":{\"projectId\":\"s-projectid\"},\"otherCloudStartingLocation\":{},\"processingLocation\":{},\"status\":\"s-status\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"discoveryConfigs\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"inspectTemplates\":[\"s-inspecttemplates\"],\"lastRunTime\":\"s-lastruntime\",\"name\":\"s-name\",\"orgConfig\":{\"projectId\":\"s-projectid\"},\"otherCloudStartingLocation\":{},\"processingLocation\":{},\"status\":\"s-status\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL dlp.organizations.locations.discoveryConfigs.list pages")
  var p = svc.organizations.locations.discovery_configs.list_pages("id1/ x", options: OrganizationsLocationsDiscoveryConfigsListOptions{order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
