  gv_queue(f, "{\"jobTriggers\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"inspectJob\":{\"inspectTemplateName\":\"s-inspecttemplatename\"},\"lastRunTime\":\"s-lastruntime\",\"name\":\"s-name\",\"status\":\"s-status\",\"updateTime\":\"s-updatetime\"}]}")
