  gv_set(f, "{\"deidentifyTemplates\":[{\"createTime\":\"s-createtime\",\"deidentifyConfig\":{},\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"deidentifyTemplates\":[{\"createTime\":\"s-createtime\",\"deidentifyConfig\":{},\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL dlp.organizations.locations.deidentifyTemplates.list pages")
  var p = svc.organizations.locations.deidentify_templates.list_pages("id1/ x", options: OrganizationsLocationsDeidentifyTemplatesListOptions{location_id: Some("s-locationid"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
