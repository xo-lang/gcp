  gv_queue(f, "{\"enterprises\":[{\"appAutoApprovalEnabled\":true,\"contactInfo\":{\"contactEmail\":\"s-contactemail\",\"dataProtectionOfficerEmail\":\"s-dataprotectionofficeremail\",\"dataProtectionOfficerName\":\"s-dataprotectionofficername\",\"dataProtectionOfficerPhone\":\"s-dataprotectionofficerphone\",\"euRepresentativeEmail\":\"s-eurepresentativeemail\",\"euRepresentativeName\":\"s-eurepresentativename\",\"euRepresentativePhone\":\"s-eurepresentativephone\"},\"enabledNotificationTypes\":[\"s-enablednotificationtypes\"],\"enterpriseDisplayName\":\"s-enterprisedisplayname\",\"enterpriseType\":\"s-enterprisetype\",\"googleAuthenticationSettings\":{\"googleAuthenticationRequired\":\"s-googleauthenticationrequired\"},\"logo\":{\"sha256Hash\":\"s-sha256hash\",\"url\":\"s-url\"},\"managedGoogleDomainType\":\"s-managedgoogledomaintype\",\"managedGooglePlayAccountsEnterpriseType\":\"s-managedgoogleplayaccountsenterprisetype\",\"name\":\"s-name\",\"primaryColor\":7,\"pubsubTopic\":\"s-pubsubtopic\"}]}")
