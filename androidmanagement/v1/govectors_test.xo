s-androidversion\",\"bootloaderVersion\":\"s-bootloaderversion\",\"deviceBuildSignature\":\"s-devicebuildsignature\",\"deviceKernelVersion\":\"s-devicekernelversion\",\"primaryLanguageCode\":\"s-primarylanguagecode\",\"securityPatchLevel\":\"s-securitypatchlevel\"},\"state\":\"s-state\",\"systemProperties\":{\"k1\":\"s-systemproperties\"},\"user\":{\"accountIdentifier\":\"s-accountidentifier\"},\"userName\":\"s-username\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"devices\":[{\"apiLevel\":7,\"appliedPolicyName\":\"s-appliedpolicyname\",\"appliedPolicyVersion\":\"7\",\"appliedState\":\"s-appliedstate\",\"commonCriteriaModeInfo\":{\"commonCriteriaModeStatus\":\"s-commoncriteriamodestatus\",\"policySignatureVerificationStatus\":\"s-policysignatureverificationstatus\"},\"deviceSettings\":{\"adbEnabled\":true,\"developmentSettingsEnabled\":true,\"encryptionStatus\":\"s-encryptionstatus\",\"isDeviceSecure\":true,\"isEncrypted\":true,\"unknownSourcesEnabled\":true,\"verifyAppsEnabled\":true},\"disabledReason\":{\"defaultMessage\":\"s-defaultmessage\"},\"dpcMigrationInfo\":{\"additionalData\":\"s-additionaldata\",\"previousDpc\":\"s-previousdpc\"},\"enrollmentTime\":\"s-enrollmenttime\",\"enrollmentTokenData\":\"s-enrollmenttokendata\",\"enrollmentTokenName\":\"s-enrollmenttokenname\",\"hardwareInfo\":{\"brand\":\"s-brand\",\"deviceBasebandVersion\":\"s-devicebasebandversion\",\"enterpriseSpecificId\":\"s-enterprisespecificid\",\"hardware\":\"s-hardware\",\"manufacturer\":\"s-manufacturer\",\"model\":\"s-model\",\"serialNumber\":\"s-serialnumber\"},\"lastPolicyComplianceReportTime\":\"s-lastpolicycompliancereporttime\",\"lastPolicySyncTime\":\"s-lastpolicysynctime\",\"lastStatusReportTime\":\"s-laststatusreporttime\",\"managementMode\":\"s-managementmode\",\"memoryInfo\":{\"totalInternalStorage\":\"7\",\"totalRam\":\"7\"},\"name\":\"s-name\",\"networkInfo\":{\"imei\":\"s-imei\",\"meid\":\"s-meid\",\"networkOperatorName\":\"s-networkoperatorname\",\"wifiMacAddress\":\"s-wifimacaddress\"},\"ownership\":\"s-ownership\",\"policyCompliant\":true,\"policyName\":\"s-policyname\",\"previousDeviceNames\":[\"s-previousdevicenames\"],\"securityPosture\":{\"devicePosture\":\"s-deviceposture\"},\"softwareInfo\":{\"androidBuildNumber\":\"s-androidbuildnumber\",\"androidBuildTime\":\"s-androidbuildtime\",\"androidDevicePolicyVersionCode\":7,\"androidDevicePolicyVersionName\":\"s-androiddevicepolicyversionname\",\"androidVersion\":\"s-androidversion\",\"bootloaderVersion\":\"s-bootloaderversion\",\"deviceBuildSignature\":\"s-devicebuildsignature\",\"deviceKernelVersion\":\"s-devicekernelversion\",\"primaryLanguageCode\":\"s-primarylanguagecode\",\"securityPatchLevel\":\"s-securitypatchlevel\"},\"state\":\"s-state\",\"systemProperties\":{\"k1\":\"s-systemproperties\"},\"user\":{\"accountIdentifier\":\"s-accountidentifier\"},\"userName\":\"s-username\"}]}")
  gv_note(f, "CALL androidmanagement.enterprises.devices.list pages")
  var p = svc.enterprises.devices.list_pages("id1/ x", options: EnterprisesDevicesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_12)
}

