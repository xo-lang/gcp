test "Go's androidmanagement.enterprises.webApps.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"webApps\":[{\"displayMode\":\"s-displaymode\",\"name\":\"s-name\",\"startUrl\":\"s-starturl\",\"title\":\"s-title\",\"versionCode\":\"7\"}]}")
  gv_queue(f, "{\"webApps\":[{\"displayMode\":\"s-displaymode\",\"name\":\"s-name\",\"startUrl\":\"s-starturl\",\"title\":\"s-title\",\"versionCode\":\"7\"}]}")
  gv_note(f, "CALL androidmanagement.enterprises.webApps.list pages")
  var p = svc.enterprises.web_apps.list_pages("id1/ x", options: EnterprisesWebAppsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_38)
}

