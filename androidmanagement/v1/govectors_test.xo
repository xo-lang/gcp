  match svc.enterprises.devices.issue_command("id1/ x", json.decode_str[Command]("{\"addEsimParams\":{\"activationCode\":\"s-activationcode\",\"activationState\":\"s-activationstate\"},\"clearAppsDataParams\":{\"packageNames\":[\"s-packagenames\"]},\"clearAppsDataStatus\":{\"results\":{\"k1\":{\"clearingResult\":\"s-clearingresult\"}}},\"createTime\":\"s-createtime\",\"duration\":\"s-duration\",\"errorCode\":\"s-errorcode\",\"esimStatus\":{\"esimInfo\":{\"iccId\":\"s-iccid\"},\"internalErrorDetails\":{\"errorCode\":\"7\",\"errorCodeDetail\":\"s-errorcodedetail\",\"operationCode\":\"7\",\"operationCodeDetail\":\"s-operationcodedetail\"},\"status\":\"s-status\"},\"newPassword\":\"s-newpassword\",\"removeEsimParams\":{\"iccId\":\"s-iccid\"},\"requestDeviceInfoParams\":{\"deviceInfo\":\"s-deviceinfo\"},\"requestDeviceInfoStatus\":{\"eidInfo\":{},\"status\":\"s-status\"},\"resetPasswordFlags\":[\"s-resetpasswordflags\"],\"startLostModeParams\":{\"lostEmailAddress\":\"s-lostemailaddress\",\"lostMessage\":{\"defaultMessage\":\"s-defaultmessage\",\"localizedMessages\":{\"k1\":\"s-localizedmessages\"}},\"lostOrganization\":{\"defaultMessage\":\"s-defaultmessage\",\"localizedMessages\":{\"k1\":\"s-localizedmessages\"}},\"lostPhoneNumber\":{\"defaultMessage\":\"s-defaultmessage\",\"localizedMessages\":{\"k1\":\"s-localizedmessages\"}},\"lostStreetAddress\":{\"defaultMessage\":\"s-defaultmessage\",\"localizedMessages\":{\"k1\":\"s-localizedmessages\"}}},\"startLostModeStatus\":{\"status\":\"s-status\"},\"stopLostModeParams\":{},\"stopLostModeStatus\":{\"status\":\"s-status\"},\"type\":\"s-type\",\"userName\":\"s-username\",\"wipeParams\":{\"wipeDataFlags\":[\"s-wipedataflags\"],\"wipeReason\":{\"defaultMessage\":\"s-defaultmessage\",\"localizedMessages\":{\"k1\":\"s-localizedmessages\"}}}}") ?? e => fault(e.display()), options: EnterprisesDevicesIssueCommandOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
