/// UsageLogEvent: An event logged on the device.
pub struct UsageLogEvent {
  /// A shell command was issued over ADB via “adb shell command”. Part of SECURITY_LOGS.
  pub adb_shell_command_event as "adbShellCommandEvent,omitempty": AdbShellCommandEvent? = None
  /// An ADB interactive shell was opened via “adb shell”. Part of SECURITY_LOGS.
  pub adb_shell_interactive_event as "adbShellInteractiveEvent,omitempty": AdbShellInteractiveEvent? = None
  /// An app process was started. Part of SECURITY_LOGS.
  pub app_process_start_event as "appProcessStartEvent,omitempty": AppProcessStartEvent? = None
  /// An admin has enabled or disabled backup service. Part of SECURITY_LOGS.
  pub backup_service_toggled_event as "backupServiceToggledEvent,omitempty": BackupServiceToggledEvent? = None
  /// A new root certificate was installed into the system's trusted credential storage. Part of SECURITY_LOGS.
  pub cert_authority_installed_event as "certAuthorityInstalledEvent,omitempty": CertAuthorityInstalledEvent? = None
  /// A root certificate was removed from the system's trusted credential storage. Part of SECURITY_LOGS.
  pub cert_authority_removed_event as "certAuthorityRemovedEvent,omitempty": CertAuthorityRemovedEvent? = None
  /// An X.509v3 certificate failed to validate, currently this validation is performed on the Wi-FI access point and failure may be due to a mismatch upon server certificate validation. However it may in the future include other validation events of an X.509v3 certificate. Part of SECURITY_LOGS.
  pub cert_validation_failure_event as "certValidationFailureEvent,omitempty": CertValidationFailureEvent? = None
  /// A TCP connect event was initiated through the standard network stack. Part of NETWORK_ACTIVITY_LOGS.
  pub connect_event as "connectEvent,omitempty": ConnectEvent? = None
  /// Validates whether Android’s built-in cryptographic library (BoringSSL) is valid. Should always succeed on device boot, if it fails, the device should be considered untrusted. Part of SECURITY_LOGS.
  pub crypto_self_test_completed_event as "cryptoSelfTestCompletedEvent,omitempty": CryptoSelfTestCompletedEvent? = None
  /// A DNS lookup event was initiated through the standard network stack. Part of NETWORK_ACTIVITY_LOGS.
  pub dns_event as "dnsEvent,omitempty": DnsEvent? = None
  /// Device has completed enrollment. Part of AMAPI_LOGS.
  pub enrollment_complete_event as "enrollmentCompleteEvent,omitempty": EnrollmentCompleteEvent? = None
  /// Unique id of the event.
  pub event_id as "eventId,omitempty": Str = ""
  /// Device timestamp when the event was logged.
  pub event_time as "eventTime,omitempty": Str = ""
  /// The particular usage log event type that was reported on the device. Use this to determine which event field to access.
  pub event_type as "eventType,omitempty": Str = ""
  /// A file was downloaded from the device. Part of SECURITY_LOGS.
  pub file_pulled_event as "filePulledEvent,omitempty": FilePulledEvent? = None
  /// A file was uploaded onto the device. Part of SECURITY_LOGS.
  pub file_pushed_event as "filePushedEvent,omitempty": FilePushedEvent? = None
  /// A cryptographic key including user installed, admin installed and system maintained private key is removed from the device either by the user or management. Part of SECURITY_LOGS.
  pub key_destruction_event as "keyDestructionEvent,omitempty": KeyDestructionEvent? = None
  /// A cryptographic key including user installed, admin installed and system maintained private key is installed on the device either by the user or management. Part of SECURITY_LOGS.
  pub key_generated_event as "keyGeneratedEvent,omitempty": KeyGeneratedEvent? = None
  /// A cryptographic key including user installed, admin installed and system maintained private key is imported on the device either by the user or management. Part of SECURITY_LOGS.
  pub key_import_event as "keyImportEvent,omitempty": KeyImportEvent? = None
  /// A cryptographic key including user installed, admin installed and system maintained private key is determined to be corrupted due to storage corruption, hardware failure or some OS issue. Part of SECURITY_LOGS.
  pub key_integrity_violation_event as "keyIntegrityViolationEvent,omitempty": KeyIntegrityViolationEvent? = None
  /// An attempt was made to unlock the device. Part of SECURITY_LOGS.
  pub keyguard_dismiss_auth_attempt_event as "keyguardDismissAuthAttemptEvent,omitempty": KeyguardDismissAuthAttemptEvent? = None
  /// The keyguard was dismissed. Part of SECURITY_LOGS.
  pub keyguard_dismissed_event as "keyguardDismissedEvent,omitempty": KeyguardDismissedEvent? = None
  /// The device was locked either by user or timeout. Part of SECURITY_LOGS.
  pub keyguard_secured_event as "keyguardSecuredEvent,omitempty": KeyguardSecuredEvent? = None
  /// The audit log buffer has reached 90% of its capacity, therefore older events may be dropped. Part of SECURITY_LOGS.
  pub log_buffer_size_critical_event as "logBufferSizeCriticalEvent,omitempty": LogBufferSizeCriticalEvent? = None
  /// usageLog policy has been enabled. Part of SECURITY_LOGS.
  pub logging_started_event as "loggingStartedEvent,omitempty": LoggingStartedEvent? = None
  /// usageLog policy has been disabled. Part of SECURITY_LOGS.
  pub logging_stopped_event as "loggingStoppedEvent,omitempty": LoggingStoppedEvent? = None
  /// A lost mode location update when a device in lost mode.
  pub lost_mode_location_event as "lostModeLocationEvent,omitempty": LostModeLocationEvent? = None
  /// An outgoing phone call has been made when a device in lost mode.
  pub lost_mode_outgoing_phone_call_event as "lostModeOutgoingPhoneCallEvent,omitempty": LostModeOutgoingPhoneCallEvent? = None
  /// Removable media was mounted. Part of SECURITY_LOGS.
  pub media_mount_event as "mediaMountEvent,omitempty": MediaMountEvent? = None
  /// Removable media was unmounted. Part of SECURITY_LOGS.
  pub media_unmount_event as "mediaUnmountEvent,omitempty": MediaUnmountEvent? = None
  /// Device was shutdown. Part of SECURITY_LOGS.
  pub os_shutdown_event as "osShutdownEvent,omitempty": OsShutdownEvent? = None
  /// Device was started. Part of SECURITY_LOGS.
  pub os_startup_event as "osStartupEvent,omitempty": OsStartupEvent? = None
  /// The device or profile has been remotely locked via the LOCK command. Part of SECURITY_LOGS.
  pub remote_lock_event as "remoteLockEvent,omitempty": RemoteLockEvent? = None
  /// An attempt to take a device out of lost mode.
  pub stop_lost_mode_user_attempt_event as "stopLostModeUserAttemptEvent,omitempty": StopLostModeUserAttemptEvent? = None
  /// The work profile or company-owned device failed to wipe when requested. This could be user initiated or admin initiated e.g. delete was received. Part of SECURITY_LOGS.
  pub wipe_failure_event as "wipeFailureEvent,omitempty": WipeFailureEvent? = None
} derive Json

/// User: A user belonging to an enterprise.
pub struct User {
  /// A unique identifier you create for this user, such as user342 or asset#44418. This field must be set when the user is created and can't be updated. This field must not contain personally identifiable information (PII). This identifier must be 1024 characters or less; otherwise, the update policy request will fail.
  pub account_identifier as "accountIdentifier,omitempty": Str = ""
} derive Json

/// UserFacingMessage: Provides a user-facing message with locale info. The maximum message length is 4096 characters.
pub struct UserFacingMessage {
  /// The default message displayed if no localized message is specified or the user's locale doesn't match with any of the localized messages. A default message must be provided if any localized messages are provided.
  pub default_message as "defaultMessage,omitempty": Str = ""
  /// A map containing pairs, where locale is a well-formed BCP 47 language (https://www.w3.org/International/articles/language-tags/) code, such as en-US, es-ES, or fr.
  pub localized_messages as "localizedMessages,omitempty": Map[Str, Str] = {}
} derive Json

/// WebApp: A web app.
pub struct WebApp {
  /// The display mode of the web app.
  pub display_mode as "displayMode,omitempty": Str = ""
  /// A list of icons for the web app. Must have at least one element.
  pub icons as "icons,omitempty": List[WebAppIcon] = []
  /// The name of the web app, which is generated by the server during creation in the form enterprises/{enterpriseId}/webApps/{packageName}.
  pub name as "name,omitempty": Str = ""
  /// The start URL, i.e. the URL that should load when the user opens the application.
  pub start_url as "startUrl,omitempty": Str = ""
  /// The title of the web app as displayed to the user (e.g., amongst a list of other applications, or as a label for an icon).
  pub title as "title,omitempty": Str = ""
  /// The current version of the app.Note that the version can automatically increase during the lifetime of the web app, while Google does internal housekeeping to keep the web app up-to-date.
  pub version_code as "versionCode,omitempty": Str = ""
} derive Json

/// WebAppIcon: An icon for a web app. Supported formats are: png, jpg and webp.
pub struct WebAppIcon {
  /// The actual bytes of the image in a base64url encoded string (c.f. RFC4648, section 5 "Base 64 Encoding with URL and Filename Safe Alphabet"). - The image type can be png or jpg. - The image should ideally be square. - The image should ideally have a size of 512x512.
  pub image_data as "imageData,omitempty": Str = ""
} derive Json

/// WebToken: A web token used to access the managed Google Play iframe.
pub struct WebToken {
  /// The features to enable. Use this if you want to control exactly which feature(s) will be activated; leave empty to allow all features.Restrictions / things to note: - If no features are listed here, all features are enabled — this is the default behavior where you give access to all features to your admins. - This must not contain any FEATURE_UNSPECIFIED values. - Repeated values are ignored
  pub enabled_features as "enabledFeatures,omitempty": List[Str] = []
  /// The name of the web token, which is generated by the server during creation in the form enterprises/{enterpriseId}/webTokens/{webTokenId}.
  pub name as "name,omitempty": Str = ""
  /// The URL of the parent frame hosting the iframe with the embedded UI. To prevent XSS, the iframe may not be hosted at other URLs. The URL must use the https scheme.
  pub parent_frame_url as "parentFrameUrl,omitempty": Str = ""
  /// Permissions available to an admin in the embedded UI. An admin must have all of these permissions in order to view the UI. This field is deprecated.
  pub permissions as "permissions,omitempty": List[Str] = []
  /// The token value which is used in the hosting page to generate the iframe with the embedded UI. This is a read-only field generated by the server.
  pub value as "value,omitempty": Str = ""
} derive Json

/// WifiRoamingPolicy: Wi-Fi roaming policy.
pub struct WifiRoamingPolicy {
  /// Optional. Wi-Fi roaming settings. SSIDs provided in this list must be unique, the policy will be rejected otherwise.
  pub wifi_roaming_settings as "wifiRoamingSettings,omitempty": List[WifiRoamingSetting] = []
} derive Json

/// WifiRoamingSetting: Wi-Fi roaming setting.
pub struct WifiRoamingSetting {
  /// Required. Wi-Fi roaming mode for the specified SSID.
  pub wifi_roaming_mode as "wifiRoamingMode,omitempty": Str = ""
  /// Required. SSID of the Wi-Fi network.
  pub wifi_ssid as "wifiSsid,omitempty": Str = ""
} derive Json

/// WifiSsid: Represents a Wi-Fi SSID.
pub struct WifiSsid {
  /// Required. Wi-Fi SSID represented as a string.
  pub wifi_ssid as "wifiSsid,omitempty": Str = ""
} derive Json

/// WifiSsidPolicy: Restrictions on which Wi-Fi SSIDs the device can connect to. Note that this does not affect which networks can be configured on the device. Supported on company-owned devices running Android 13 and above.
pub struct WifiSsidPolicy {
  /// Optional. Type of the Wi-Fi SSID policy to be applied.
  pub wifi_ssid_policy_type as "wifiSsidPolicyType,omitempty": Str = ""
  /// Optional. List of Wi-Fi SSIDs that should be applied in the policy. This field must be non-empty when WifiSsidPolicyType is set to WIFI_SSID_ALLOWLIST. If this is set to a non-empty list, then a NonComplianceDetail detail with API_LEVEL is reported if the Android version is less than 13 and a NonComplianceDetail with MANAGEMENT_MODE is reported for non-company-owned devices.
  pub wifi_ssids as "wifiSsids,omitempty": List[WifiSsid] = []
} derive Json

/// WipeAction: An action to reset a company owned device or delete a work profile. Note: blockAction must also be specified.
pub struct WipeAction {
  /// Whether the factory-reset protection data is preserved on the device. This setting applies to fully managed devices and work profiles on company-owned devices.
  pub preserve_frp as "preserveFrp,omitempty": Bool = false
  /// Number of days the policy is non-compliant before the device or work profile is wiped. wipeAfterDays must be greater than blockAfterDays.
  pub wipe_after_days as "wipeAfterDays,omitempty": Int = 0
} derive Json

/// WipeFailureEvent: The work profile or company-owned device failed to wipe when requested. This could be user initiated or admin initiated e.g. delete was received. Intentionally empty.
pub struct WipeFailureEvent {} derive Json

/// WipeParams: Parameters associated with the WIPE command to wipe the device.
pub struct WipeParams {
  /// Optional. Flags to determine what data to wipe.
  pub wipe_data_flags as "wipeDataFlags,omitempty": List[Str] = []
  /// Optional. A short message displayed to the user before wiping the work profile on personal devices. This has no effect on company owned devices. The maximum message length is 200 characters.
  pub wipe_reason as "wipeReason,omitempty": UserFacingMessage? = None
} derive Json

/// WorkAccountSetupConfig: Controls the work account setup configuration, such as details of whether a Google authenticated account is required.
pub struct WorkAccountSetupConfig {
  /// Optional. The authentication type of the user on the device.
  pub authentication_type as "authenticationType,omitempty": Str = ""
  /// Optional. The specific google work account email address to be added. This field is only relevant if authenticationType is GOOGLE_AUTHENTICATED. This must be an enterprise account and not a consumer account. Once set and a Google authenticated account is added to the device, changing this field will have no effect, and thus recommended to be set only once. The email address must be all lowercase.
  pub required_account_email as "requiredAccountEmail,omitempty": Str = ""
} derive Json
