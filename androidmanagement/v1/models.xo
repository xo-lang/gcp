  /// The management mode of the device or profile.
  pub management_mode as "managementMode,omitempty": Str = ""
  /// For corporate-owned devices, MEID number of the CDMA device. For example, A00000292788E1.
  pub meid as "meid,omitempty": Str = ""
  /// The model of the device. For example, Asus Nexus 7.
  pub model as "model,omitempty": Str = ""
  /// The name of this resource in the form provisioningInfo/{provisioning_info}.
  pub name as "name,omitempty": Str = ""
  /// Ownership of the managed device.
  pub ownership as "ownership,omitempty": Str = ""
  /// For corporate-owned devices, The device serial number.
  pub serial_number as "serialNumber,omitempty": Str = ""
} derive Json

