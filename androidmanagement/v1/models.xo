/// NonComplianceDetail: Provides detail about non-compliance with a policy setting.
pub struct NonComplianceDetail {
  /// If the policy setting could not be applied, the current value of the setting on the device.
  pub current_value as "currentValue,omitempty": json.Value? = None
  /// For settings with nested fields, if a particular nested field is out of compliance, this specifies the full path to the offending field. The path is formatted in the same way the policy JSON field would be referenced in JavaScript, that is: 1) For object-typed fields, the field name is followed by a dot then by a subfield name. 2) For array-typed fields, the field name is followed by the array index enclosed in brackets. For example, to indicate a problem with the url field in the externalData field in the 3rd application, the path would be applications[2].externalData.url
  pub field_path as "fieldPath,omitempty": Str = ""
  /// If package_name is set and the non-compliance reason is APP_NOT_INSTALLED or APP_NOT_UPDATED, the detailed reason the app can't be installed or updated.
  pub installation_failure_reason as "installationFailureReason,omitempty": Str = ""
  /// The reason the device is not in compliance with the setting.
  pub non_compliance_reason as "nonComplianceReason,omitempty": Str = ""
  /// The package name indicating which app is out of compliance, if applicable.
  pub package_name as "packageName,omitempty": Str = ""
  /// The name of the policy setting. This is the JSON field name of a top-level Policy field.
  pub setting_name as "settingName,omitempty": Str = ""
  /// Additional context for specific_non_compliance_reason.
  pub specific_non_compliance_context as "specificNonComplianceContext,omitempty": SpecificNonComplianceContext? = None
  /// The policy-specific reason the device is not in compliance with the setting.
  pub specific_non_compliance_reason as "specificNonComplianceReason,omitempty": Str = ""
} derive Json

/// NonComplianceDetailCondition: A compliance rule condition which is satisfied if there exists any matching NonComplianceDetail for the device. A NonComplianceDetail matches a NonComplianceDetailCondition if all the fields which are set within the NonComplianceDetailCondition match the corresponding NonComplianceDetail fields.
