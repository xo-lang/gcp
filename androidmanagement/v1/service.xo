/// SignupUrlsCreateOptions: the optional parameters of SignupUrlsService.create.
pub struct SignupUrlsCreateOptions {
  /// Optional. Email address used to prefill the admin field of the enterprise signup form. This value is a hint only and can be altered by the user. If allowedDomains is non-empty then this must belong to one of the allowedDomains.
  pub admin_email: Str? = None
  /// Optional. A list of domains that are permitted for the admin email. The IT admin cannot enter an email address with a domain name that is not in this list. Subdomains of domains in this list are not allowed but can be allowed by adding a second entry which has *. prefixed to the domain name (e.g. *.example.com). If the field is not present or is an empty list then the IT admin is free to use any valid domain name. Personal email domains are always allowed, but will result in the creation of a managed Google Play Accounts enterprise.
  pub allowed_domains: List[Str] = []
  /// The callback URL that the admin will be redirected to after successfully creating an enterprise. Before redirecting there the system will add a query parameter to this URL named enterpriseToken which will contain an opaque token to be used for the create enterprise request. The URL will be parsed then reformatted in order to add the enterpriseToken parameter, so there may be some minor formatting changes.
  pub callback_url: Str? = None
  /// The ID of the Google Cloud Platform project which will own the enterprise.
  pub project_id: Str? = None
  /// The fields of the result to return (Go's Fields), joined with commas.
  pub fields: List[Str] = []
  /// More request headers (Go's Header).
  pub headers: List[(Str, Str)] = []
}

/// create: Creates an enterprise signup URL.
/// (Go's androidmanagement.signupUrls.create.)
pub fn (r: SignupUrlsService[fx]) create(options: SignupUrlsCreateOptions = SignupUrlsCreateOptions{}) -> SignupUrl ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.admin_email {
    q.set("adminEmail", v)
  }
  for v in options.allowed_domains {
    q.add("allowedDomains", v)
  }
  if let Some(v) = options.callback_url {
    q.set("callbackUrl", v)
  }
  if let Some(v) = options.project_id {
    q.set("projectId", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v1/signupUrls"), {})
  let resp = r.core.client.send(gensupport.Request{method: "POST", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[SignupUrl](resp)
}

