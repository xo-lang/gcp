  pub string_val as "stringVal,omitempty": Str = ""
  pub force_send_fields as "~forceSendFields,omitempty": List[ValueModelField] = []
  pub null_fields as "~nullFields,omitempty": List[ValueModelField] = []
} derive Json

/// ValueModelField: ValueModel's fields, for force_send_fields and null_fields.
pub enum ValueModelField {
  FpVal as "fpVal=0"
  IntVal as "intVal=0"
  MapVal as "mapVal=[]"
  StringVal as "stringVal=\"\""
} derive Json

/// ValueMapValEntry:
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct ValueMapValEntry {
  pub key as "key,omitempty": Str = ""
  pub value as "value,omitempty": MapValue? = None
  pub force_send_fields as "~forceSendFields,omitempty": List[ValueMapValEntryField] = []
  pub null_fields as "~nullFields,omitempty": List[ValueMapValEntryField] = []
} derive Json

/// ValueMapValEntryField: ValueMapValEntry's fields, for force_send_fields and null_fields.
pub enum ValueMapValEntryField {
  Key as "key=\"\""
  Value as "value"
} derive Json
