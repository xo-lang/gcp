test "Go's fitness.users.sessions.update" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"activeTimeMillis\":\"7\",\"activityType\":7,\"application\":{\"detailsUrl\":\"s-detailsurl\",\"name\":\"s-name\",\"packageName\":\"s-packagename\",\"version\":\"s-version\"},\"description\":\"s-description\",\"endTimeMillis\":\"7\",\"id\":\"s-id\",\"modifiedTimeMillis\":\"7\",\"name\":\"s-name\",\"startTimeMillis\":\"7\"}")
  gv_note(f, "CALL fitness.users.sessions.update")
  match svc.users.sessions.update("id1/ x", "id2/ x", json.decode_str[Session]("{\"activeTimeMillis\":\"7\",\"activityType\":7,\"application\":{\"detailsUrl\":\"s-detailsurl\",\"name\":\"s-name\",\"packageName\":\"s-packagename\",\"version\":\"s-version\"},\"description\":\"s-description\",\"endTimeMillis\":\"7\",\"id\":\"s-id\",\"modifiedTimeMillis\":\"7\",\"name\":\"s-name\",\"startTimeMillis\":\"7\"}") ?? e => fault(e.display()), options: UsersSessionsUpdateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_16)
}
