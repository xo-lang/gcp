test "Go's fitness.users.sessions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"deletedSession\":[{\"activeTimeMillis\":\"7\",\"activityType\":7,\"application\":{\"detailsUrl\":\"s-detailsurl\",\"name\":\"s-name\",\"packageName\":\"s-packagename\",\"version\":\"s-version\"},\"description\":\"s-description\",\"endTimeMillis\":\"7\",\"id\":\"s-id\",\"modifiedTimeMillis\":\"7\",\"name\":\"s-name\",\"startTimeMillis\":\"7\"}],\"hasMoreData\":true,\"nextPageToken\":\"s-nextpagetoken\",\"session\":[{\"activeTimeMillis\":\"7\",\"activityType\":7,\"application\":{\"detailsUrl\":\"s-detailsurl\",\"name\":\"s-name\",\"packageName\":\"s-packagename\",\"version\":\"s-version\"},\"description\":\"s-description\",\"endTimeMillis\":\"7\",\"id\":\"s-id\",\"modifiedTimeMillis\":\"7\",\"name\":\"s-name\",\"startTimeMillis\":\"7\"}]}")
  gv_queue(f, "{\"deletedSession\":[{\"activeTimeMillis\":\"7\",\"activityType\":7,\"application\":{\"detailsUrl\":\"s-detailsurl\",\"name\":\"s-name\",\"packageName\":\"s-packagename\",\"version\":\"s-version\"},\"description\":\"s-description\",\"endTimeMillis\":\"7\",\"id\":\"s-id\",\"modifiedTimeMillis\":\"7\",\"name\":\"s-name\",\"startTimeMillis\":\"7\"}],\"hasMoreData\":true,\"session\":[{\"activeTimeMillis\":\"7\",\"activityType\":7,\"application\":{\"detailsUrl\":\"s-detailsurl\",\"name\":\"s-name\",\"packageName\":\"s-packagename\",\"version\":\"s-version\"},\"description\":\"s-description\",\"endTimeMillis\":\"7\",\"id\":\"s-id\",\"modifiedTimeMillis\":\"7\",\"name\":\"s-name\",\"startTimeMillis\":\"7\"}]}")
  gv_note(f, "CALL fitness.users.sessions.list pages")
  var p = svc.users.sessions.list_pages("id1/ x", options: UsersSessionsListOptions{activity_type: [7], end_time: Some("s-endtime"), include_deleted: Some(true), page_token: Some("s-pagetoken"), start_time: Some("s-starttime"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_15)
}

