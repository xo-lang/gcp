/// WidgetTool: Represents a widget tool that the agent can invoke. When the tool is chosen by the agent, agent will return the widget to the client. The client is responsible for processing the widget and generating the next user query to continue the interaction with the agent.
pub struct WidgetTool {
  /// Optional. The mapping that defines how data from a source tool is mapped to the widget's input parameters.
  pub data_mapping as "dataMapping,omitempty": WidgetToolDataMapping? = None
  /// Optional. The description of the widget tool.
  pub description as "description,omitempty": Str = ""
  /// Required. The display name of the widget tool.
  pub name as "name,omitempty": Str = ""
  /// Optional. The input parameters of the widget tool.
  pub parameters as "parameters,omitempty": Schema? = None
  /// Optional. Configuration for always-included text responses.
  pub text_response_config as "textResponseConfig,omitempty": WidgetToolTextResponseConfig? = None
  /// Optional. Configuration for rendering the widget.
  pub ui_config as "uiConfig,omitempty": json.Value? = None
  /// Optional. The type of the widget tool. If not specified, the default type will be CUSTOMIZED.
  pub widget_type as "widgetType,omitempty": Str = ""
} derive Json

/// WidgetToolDataMapping: Configuration for mapping data from a source tool to the widget's input parameters.
pub struct WidgetToolDataMapping {
  /// Optional. A map of widget input parameter fields to the corresponding output fields of the source tool.
  pub field_mappings as "fieldMappings,omitempty": Map[Str, Str] = {}
  /// Optional. The mode of the data mapping.
  pub mode as "mode,omitempty": Str = ""
  /// Optional. Configuration for a Python function used to transform the source tool's output into the widget's input format.
  pub python_function as "pythonFunction,omitempty": PythonFunction? = None
  /// Deprecated: Use `python_function` instead.
  pub python_script as "pythonScript,omitempty": Str = ""
  /// Optional. The resource name of the tool that provides the data for the widget (e.g., a search tool or a custom function). Format: `projects/{project}/locations/{location}/agents/{agent}/tools/{tool}`
  pub source_tool_name as "sourceToolName,omitempty": Str = ""
} derive Json

/// WidgetToolTextResponseConfig: Configuration for the text response returned with the widget.
pub struct WidgetToolTextResponseConfig {
  /// Optional. The static text response to return when type is STATIC.
  pub static_text as "staticText,omitempty": Str = ""
  /// Optional. Instruction for the LLM on how to generate the text response. Used as the description for the text response parameter if type is LLM_GENERATED.
  pub text_response_instruction as "textResponseInstruction,omitempty": Str = ""
  /// Optional. The strategy for providing the text response.
  pub type_ as "type,omitempty": Str = ""
} derive Json
