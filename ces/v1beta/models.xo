  /// Identifier. The unique identifier of this evaluation. Format: `projects/{project}/locations/{location}/apps/{app}/evaluations/{evaluation}`
  pub name as "name,omitempty": Str = ""
  /// Optional. The config for a scenario.
  pub scenario as "scenario,omitempty": EvaluationScenario? = None
  /// Optional. User defined tags to categorize the evaluation.
  pub tags as "tags,omitempty": List[Str] = []
  /// Output only. Timestamp when the evaluation was last updated.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

/// EvaluationConfig: EvaluationConfig configures settings for running the evaluation.
pub struct EvaluationConfig {
  /// Optional. The channel to evaluate.
  pub evaluation_channel as "evaluationChannel,omitempty": Str = ""
  /// Optional. Configuration for processing the input audio.
  pub input_audio_config as "inputAudioConfig,omitempty": InputAudioConfig? = None
  /// Optional. Configuration for generating the output audio.
  pub output_audio_config as "outputAudioConfig,omitempty": OutputAudioConfig? = None
  /// Optional. Specifies whether the evaluation should use real tool calls or fake tools.
  pub tool_call_behaviour as "toolCallBehaviour,omitempty": Str = ""
} derive Json

/// EvaluationDataset: An evaluation dataset represents a set of evaluations that are grouped together basaed on shared tags.
pub struct EvaluationDataset {
  /// Output only. The aggregated metrics for this evaluation dataset across all runs.
  pub aggregated_metrics as "aggregatedMetrics,omitempty": AggregatedMetrics? = None
  /// Output only. Timestamp when the evaluation dataset was created.
  pub create_time as "createTime,omitempty": Str = ""
  /// Output only. The user who created the evaluation dataset.
  pub created_by as "createdBy,omitempty": Str = ""
  /// Required. User-defined display name of the evaluation dataset. Unique within an App.
  pub display_name as "displayName,omitempty": Str = ""
  /// Output only. Etag used to ensure the object hasn't changed during a read-modify-write operation. If the etag is empty, the update will overwrite any concurrent changes.
  pub etag as "etag,omitempty": Str = ""
  /// Optional. Evaluations that are included in this dataset.
  pub evaluations as "evaluations,omitempty": List[Str] = []
  /// Output only. The user who last updated the evaluation dataset.
  pub last_updated_by as "lastUpdatedBy,omitempty": Str = ""
  /// Identifier. The unique identifier of this evaluation dataset. Format: `projects/{project}/locations/{location}/apps/{app}/evaluationDatasets/{evaluationDataset}`
  pub name as "name,omitempty": Str = ""
  /// Output only. Timestamp when the evaluation dataset was last updated.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

/// EvaluationErrorInfo: Information about an error encountered during an evaluation execution.
pub struct EvaluationErrorInfo {
  /// Output only. The error message.
  pub error_message as "errorMessage,omitempty": Str = ""
  /// Output only. The type of error.
  pub error_type as "errorType,omitempty": Str = ""
  /// Output only. The session ID for the conversation that caused the error.
  pub session_id as "sessionId,omitempty": Str = ""
  /// Output only. The user facing error message.
  pub user_facing_error_message as "userFacingErrorMessage,omitempty": Str = ""
} derive Json

/// EvaluationExpectation: An evaluation expectation represents a specific criteria to evaluate against.
pub struct EvaluationExpectation {
  /// Output only. Timestamp when the evaluation expectation was created.
  pub create_time as "createTime,omitempty": Str = ""
  /// Required. User-defined display name. Must be unique within the app.
  pub display_name as "displayName,omitempty": Str = ""
  /// Output only. Etag used to ensure the object hasn't changed during a read-modify-write operation. If the etag is empty, the update will overwrite any concurrent changes.
  pub etag as "etag,omitempty": Str = ""
  /// Optional. Evaluation criteria based on an LLM prompt.
  pub llm_criteria as "llmCriteria,omitempty": EvaluationExpectationLlmCriteria? = None
  /// Identifier. The unique identifier of this evaluation expectation. Format: `projects/{project}/locations/{location}/apps/{app}/evaluationExpectations/{evaluation_expectation}`
  pub name as "name,omitempty": Str = ""
  /// Optional. User-defined tags for expectations. Can be used to filter expectations.
  pub tags as "tags,omitempty": List[Str] = []
  /// Output only. Timestamp when the evaluation expectation was last updated.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

/// EvaluationExpectationLlmCriteria: Configuration for LLM-based evaluation criteria.
pub struct EvaluationExpectationLlmCriteria {
  /// Required. The prompt/instructions provided to the LLM judge.
  pub prompt as "prompt,omitempty": Str = ""
} derive Json

/// EvaluationGolden: The steps required to replay a golden conversation.
pub struct EvaluationGolden {
  /// Optional. The evaluation expectations to evaluate the replayed conversation against. Format: `projects/{project}/locations/{location}/apps/{app}/evaluationExpectations/{evaluationExpectation}`
  pub evaluation_expectations as "evaluationExpectations,omitempty": List[Str] = []
  /// Required. The golden turns required to replay a golden conversation. The maximum number of allowed turns is 100.
  pub turns as "turns,omitempty": List[EvaluationGoldenTurn] = []
} derive Json

/// EvaluationGoldenExpectation: Represents a single, checkable requirement.
pub struct EvaluationGoldenExpectation {
  /// Optional. Check that the agent responded with the correct response. The role "agent" is implied.
  pub agent_response as "agentResponse,omitempty": Message? = None
  /// Optional. Overrides for agent_response hallucination metrics.
  pub agent_response_hallucination_metrics_config_override as "agentResponseHallucinationMetricsConfigOverride,omitempty": EvaluationMetricsConfigHallucinationMetricsConfig? = None
  /// Optional. Overrides for agent_response semantic similarity metrics.
  pub agent_response_semantic_similarity_metrics_config_override as "agentResponseSemanticSimilarityMetricsConfigOverride,omitempty": EvaluationMetricsConfigSemanticSimilarityMetricsConfig? = None
  /// Optional. Check that the agent transferred the conversation to a different agent.
  pub agent_transfer as "agentTransfer,omitempty": AgentTransfer? = None
  /// Optional. The comparison type to use for the expectation check.
  pub comparison_type as "comparisonType,omitempty": Str = ""
  /// Optional. Overrides metrics at the step level.
  pub expectation_level_metrics_thresholds_override as "expectationLevelMetricsThresholdsOverride,omitempty": EvaluationMetricsThresholdsGoldenEvaluationMetricsThresholdsExpectationLevelMetricsThresholds? = None
  /// Optional. The tool response to mock, with the parameters of interest specified. Any parameters not specified will be hallucinated by the LLM.
  pub mock_tool_response as "mockToolResponse,omitempty": ToolResponse? = None
  /// Optional. Check that no tools were called during this turn.
  pub no_tool_calls as "noToolCalls,omitempty": Bool = false
  /// Optional. A note for this requirement, useful in reporting when specific checks fail. E.g., "Check_Payment_Tool_Called".
  pub note as "note,omitempty": Str = ""
  /// Optional. If set to true, this specific expectation will not be evaluated.
  pub skip_evaluation as "skipEvaluation,omitempty": Bool = false
  /// Optional. Check that a specific tool was called with the parameters.
  pub tool_call as "toolCall,omitempty": ToolCall? = None
  /// Optional. Check that a specific tool had the expected response.
  pub tool_response as "toolResponse,omitempty": ToolResponse? = None
  /// Optional. Check that the agent updated the session variables to the expected values. Used to also capture agent variable updates for golden evals.
  pub updated_variables as "updatedVariables,omitempty": json.Value? = None
} derive Json

/// EvaluationGoldenTurn: A golden turn defines a single turn in a golden conversation.
pub struct EvaluationGoldenTurn {
  /// Optional. Override for turn-level hallucination metric behavior.
  pub hallucination_metric_behavior_override as "hallucinationMetricBehaviorOverride,omitempty": Str = ""
  /// Optional. The root span of the golden turn for processing and maintaining audio information. The uri for the audio must contain audio saved in 16Khz sample rate.
  pub root_span as "rootSpan,omitempty": Span? = None
  /// Required. The steps required to replay a golden conversation.
  pub steps as "steps,omitempty": List[EvaluationStep] = []
  /// Optional. Overrides for turn-level metric thresholds.
  pub turn_level_metrics_thresholds_override as "turnLevelMetricsThresholdsOverride,omitempty": EvaluationMetricsThresholdsGoldenEvaluationMetricsThresholdsTurnLevelMetricsThresholds? = None
} derive Json

/// EvaluationMetricsConfig: Configures the metrics for an evaluation.
pub struct EvaluationMetricsConfig {
  /// Optional. Configuration for the golden metrics for the evaluation.
  pub golden_metrics_config as "goldenMetricsConfig,omitempty": EvaluationMetricsConfigGoldenMetricsConfig? = None
  /// Optional. Configuration for the scenario metrics for the evaluation.
  pub scenario_metrics_config as "scenarioMetricsConfig,omitempty": EvaluationMetricsConfigScenarioMetricsConfig? = None
} derive Json

/// EvaluationMetricsConfigExpectationsMetMetricsConfig: Configuration for the expectation level metrics for the evaluation. To disable the metric, set the message but do not set the `enable_expectations_met_metrics` field to true (or explicitly set it to false). To unset the configuration and fallback to the default behavior, omit the message entirely.
pub struct EvaluationMetricsConfigExpectationsMetMetricsConfig {
  /// Optional. Whether to calculate the expectation level metrics for the evaluation.
  pub enable_expectations_met_metrics as "enableExpectationsMetMetrics,omitempty": Bool = false
} derive Json

/// EvaluationMetricsConfigGoldenMetricsConfig: Configuration for the golden metrics for the evaluation.
pub struct EvaluationMetricsConfigGoldenMetricsConfig {
  /// Optional. Global configuration for semantic similarity metrics.
  pub semantic_similarity_metrics_config as "semanticSimilarityMetricsConfig,omitempty": EvaluationMetricsConfigSemanticSimilarityMetricsConfig? = None
  /// Optional. Configuration for step level tool correctness metrics.
  pub step_tool_correctness_metrics_config as "stepToolCorrectnessMetricsConfig,omitempty": EvaluationMetricsConfigToolCorrectnessMetricsConfig? = None
  /// Optional. Configuration for turn level tool correctness metrics.
  pub tool_correctness_metrics_config as "toolCorrectnessMetricsConfig,omitempty": EvaluationMetricsConfigToolCorrectnessMetricsConfig? = None
} derive Json

/// EvaluationMetricsConfigHallucinationMetricsConfig: Configuration for the hallucination metrics for the evaluation. To disable the metric, set the message but do not set the `enable_hallucination_metrics` field to true (or explicitly set it to false). To unset the configuration and fallback to the default behavior, omit the message entirely.
pub struct EvaluationMetricsConfigHallucinationMetricsConfig {
  /// Optional. Whether to calculate hallucination metrics for the evaluation.
  pub enable_hallucination_metrics as "enableHallucinationMetrics,omitempty": Bool = false
} derive Json

/// EvaluationMetricsConfigScenarioMetricsConfig: Configuration for the scenario metrics for the evaluation.
pub struct EvaluationMetricsConfigScenarioMetricsConfig {
  /// Optional. Configuration for expectation level metrics.
  pub expectations_met_metrics_config as "expectationsMetMetricsConfig,omitempty": EvaluationMetricsConfigExpectationsMetMetricsConfig? = None
  /// Optional. Configuration for user goal met metrics.
  pub user_goal_met_metrics_config as "userGoalMetMetricsConfig,omitempty": EvaluationMetricsConfigUserGoalMetMetricsConfig? = None
} derive Json

/// EvaluationMetricsConfigSemanticSimilarityMetricsConfig: Configuration for similarity metrics for the evaluation. To disable the metric, set the message but do not set the `enable_semantic_similarity_metrics` field to true (or explicitly set it to false). To unset the configuration and fallback to the default behavior, omit the message entirely.
pub struct EvaluationMetricsConfigSemanticSimilarityMetricsConfig {
  /// Optional. Whether to calculate semantic similarity metrics for the evaluation.
  pub enable_semantic_similarity_metrics as "enableSemanticSimilarityMetrics,omitempty": Bool = false
} derive Json

/// EvaluationMetricsConfigToolCorrectnessMetricsConfig: Configuration for correctness metrics for the evaluation. To disable the metric, set the message but do not set the `enable_tool_correctness_metrics` field to true (or explicitly set it to false). To unset the configuration and fallback to the default behavior, omit the message entirely.
pub struct EvaluationMetricsConfigToolCorrectnessMetricsConfig {
  /// Optional. Whether to calculate tool correctness metrics for the evaluation.
  pub enable_tool_correctness_metrics as "enableToolCorrectnessMetrics,omitempty": Bool = false
} derive Json

/// EvaluationMetricsConfigUserGoalMetMetricsConfig: Configuration for the user goal met metrics for the evaluation. To disable the metric, set the message but do not set the `enable_user_goal_met_metrics` field to true (or explicitly set it to false). To unset the configuration and fallback to the default behavior, omit the message entirely.
pub struct EvaluationMetricsConfigUserGoalMetMetricsConfig {
  /// Optional. Whether to calculate the user goal met metrics for the evaluation.
  pub enable_user_goal_met_metrics as "enableUserGoalMetMetrics,omitempty": Bool = false
} derive Json

/// EvaluationMetricsThresholds: Threshold settings for metrics in an Evaluation.
pub struct EvaluationMetricsThresholds {
  /// Optional. The golden evaluation metrics thresholds.
  pub golden_evaluation_metrics_thresholds as "goldenEvaluationMetricsThresholds,omitempty": EvaluationMetricsThresholdsGoldenEvaluationMetricsThresholds? = None
  /// Optional. The hallucination metric behavior for golden evaluations.
  pub golden_hallucination_metric_behavior as "goldenHallucinationMetricBehavior,omitempty": Str = ""
  /// Optional. Deprecated: Use `golden_hallucination_metric_behavior` instead. The hallucination metric behavior is currently used for golden evaluations.
  pub hallucination_metric_behavior as "hallucinationMetricBehavior,omitempty": Str = ""
  /// Optional. The hallucination metric behavior for scenario evaluations.
  pub scenario_hallucination_metric_behavior as "scenarioHallucinationMetricBehavior,omitempty": Str = ""
} derive Json

/// EvaluationMetricsThresholdsGoldenEvaluationMetricsThresholds: Settings for golden evaluations.
pub struct EvaluationMetricsThresholdsGoldenEvaluationMetricsThresholds {
  /// Optional. The expectation level metrics thresholds.
  pub expectation_level_metrics_thresholds as "expectationLevelMetricsThresholds,omitempty": EvaluationMetricsThresholdsGoldenEvaluationMetricsThresholdsExpectationLevelMetricsThresholds? = None
  /// Optional. The tool matching settings. An extra tool call is a tool call that is present in the execution but does not match any tool call in the golden expectation.
  pub tool_matching_settings as "toolMatchingSettings,omitempty": EvaluationMetricsThresholdsToolMatchingSettings? = None
  /// Optional. The turn level metrics thresholds.
  pub turn_level_metrics_thresholds as "turnLevelMetricsThresholds,omitempty": EvaluationMetricsThresholdsGoldenEvaluationMetricsThresholdsTurnLevelMetricsThresholds? = None
} derive Json

/// EvaluationMetricsThresholdsGoldenEvaluationMetricsThresholdsExpectationLevelMetricsThresholds: Expectation level metrics thresholds.
pub struct EvaluationMetricsThresholdsGoldenEvaluationMetricsThresholdsExpectationLevelMetricsThresholds {
  /// Optional. The success threshold for individual tool invocation parameter correctness. Must be a float between 0 and 1. Default is 1.0.
  pub tool_invocation_parameter_correctness_threshold as "toolInvocationParameterCorrectnessThreshold,omitempty": Float = 0.0
} derive Json

/// EvaluationMetricsThresholdsGoldenEvaluationMetricsThresholdsTurnLevelMetricsThresholds: Turn level metrics thresholds.
pub struct EvaluationMetricsThresholdsGoldenEvaluationMetricsThresholdsTurnLevelMetricsThresholds {
  /// Optional. The success threshold for overall tool invocation correctness. Must be a float between 0 and 1. Default is 1.0.
  pub overall_tool_invocation_correctness_threshold as "overallToolInvocationCorrectnessThreshold,omitempty": Float = 0.0
  /// Optional. The semantic similarity channel to use for evaluation.
  pub semantic_similarity_channel as "semanticSimilarityChannel,omitempty": Str = ""
  /// Optional. The success threshold for semantic similarity. Must be an integer between 0 and 4. Default is >= 3.
  pub semantic_similarity_success_threshold as "semanticSimilaritySuccessThreshold,omitempty": Int = 0
} derive Json

/// EvaluationMetricsThresholdsToolMatchingSettings: Settings for matching tool calls.
pub struct EvaluationMetricsThresholdsToolMatchingSettings {
  /// Optional. Behavior for extra tool calls. Defaults to FAIL.
  pub extra_tool_call_behavior as "extraToolCallBehavior,omitempty": Str = ""
} derive Json

/// EvaluationPersona: A persona represents an end user in an evaluation.
pub struct EvaluationPersona {
  /// Optional. The description of the persona.
  pub description as "description,omitempty": Str = ""
  /// Required. The display name of the persona. Unique within an app.
  pub display_name as "displayName,omitempty": Str = ""
  /// Required. The unique identifier of the persona. Format: `projects/{project}/locations/{location}/apps/{app}/evaluationPersonas/{evaluationPersona}`
  pub name as "name,omitempty": Str = ""
  /// Required. An instruction for the agent on how to behave in the evaluation.
  pub personality as "personality,omitempty": Str = ""
  /// Optional. Configuration for how the persona sounds (TTS settings).
  pub speech_config as "speechConfig,omitempty": EvaluationPersonaSpeechConfig? = None
} derive Json

/// EvaluationPersonaSpeechConfig: Configuration for Text-to-Speech generation.
pub struct EvaluationPersonaSpeechConfig {
  /// Optional. The simulated audio environment.
  pub environment as "environment,omitempty": Str = ""
  /// Optional. The speaking rate. 1.0 is normal. Lower is slower (e.g., 0.8), higher is faster (e.g., 1.5). Useful for testing how the agent handles fast talkers.
  pub speaking_rate as "speakingRate,omitempty": Float = 0.0
  /// Optional. The specific voice identifier/accent to use. Example: "en-US-Wavenet-D" or "en-GB-Standard-A"
  pub voice_id as "voiceId,omitempty": Str = ""
} derive Json

/// EvaluationResult: An evaluation result represents the output of running an Evaluation.
pub struct EvaluationResult {
  /// Output only. The app version used to generate the conversation that resulted in this result. Format: `projects/{project}/locations/{location}/apps/{app}/versions/{version}`
  pub app_version as "appVersion,omitempty": Str = ""
  /// Output only. The display name of the `app_version` that the evaluation ran against.
  pub app_version_display_name as "appVersionDisplayName,omitempty": Str = ""
  /// Output only. The changelog of the app version that the evaluation ran against. This is populated if user runs evaluation on latest/draft.
  pub changelog as "changelog,omitempty": Str = ""
  /// Output only. The create time of the changelog of the app version that the evaluation ran against. This is populated if user runs evaluation on latest/draft.
  pub changelog_create_time as "changelogCreateTime,omitempty": Str = ""
  /// Output only. The configuration used in the evaluation run that resulted in this result.
  pub config as "config,omitempty": EvaluationConfig? = None
  /// Output only. Timestamp when the evaluation result was created.
  pub create_time as "createTime,omitempty": Str = ""
  /// Required. Display name of the Evaluation Result. Unique within an Evaluation. By default, it has the following format: " result - ".
  pub display_name as "displayName,omitempty": Str = ""
  /// Output only. Deprecated: Use `error_info` instead. Errors encountered during execution.
  pub error as "error,omitempty": Status? = None
  /// Output only. Error information for the evaluation result.
  pub error_info as "errorInfo,omitempty": EvaluationErrorInfo? = None
  /// Output only. The evaluation thresholds for the result.
  pub evaluation_metrics_thresholds as "evaluationMetricsThresholds,omitempty": EvaluationMetricsThresholds? = None
  /// Output only. The evaluation run that produced this result. Format: `projects/{project}/locations/{location}/apps/{app}/evaluationRuns/{evaluationRun}`
  pub evaluation_run as "evaluationRun,omitempty": Str = ""
  /// Output only. The outcome of the evaluation. Only populated if execution_state is COMPLETE.
  pub evaluation_status as "evaluationStatus,omitempty": Str = ""
  /// Output only. The state of the evaluation result execution.
  pub execution_state as "executionState,omitempty": Str = ""
  /// Output only. The outcome of a golden evaluation.
  pub golden_result as "goldenResult,omitempty": EvaluationResultGoldenResult? = None
  /// Output only. The method used to run the golden evaluation.
  pub golden_run_method as "goldenRunMethod,omitempty": Str = ""
  /// Output only. The user who initiated the evaluation run that resulted in this result.
  pub initiated_by as "initiatedBy,omitempty": Str = ""
  /// Identifier. The unique identifier of the evaluation result. Format: `projects/{project}/locations/{location}/apps/{app}/evaluations/{evaluation}/results/{result}`
  pub name as "name,omitempty": Str = ""
  /// Output only. The outcome metadata of the evaluation. Only populated if execution_state is COMPLETE.
  pub outcome_metadata as "outcomeMetadata,omitempty": Str = ""
  /// Output only. The persona used to generate the conversation for the evaluation result.
  pub persona as "persona,omitempty": EvaluationPersona? = None
  /// Output only. The root span of the evaluation execution, which includes information about each step of the evaluation.
  pub root_span as "rootSpan,omitempty": Span? = None
  /// Output only. The outcome of a scenario evaluation.
  pub scenario_result as "scenarioResult,omitempty": EvaluationResultScenarioResult? = None
} derive Json

/// EvaluationResultEvaluationExpectationResult: The result of a single evaluation expectation.
pub struct EvaluationResultEvaluationExpectationResult {
  /// Output only. The evaluation expectation. Format: `projects/{project}/locations/{location}/apps/{app}/evaluationExpectations/{evaluation_expectation}`
  pub evaluation_expectation as "evaluationExpectation,omitempty": Str = ""
  /// Output only. The explanation for the result.
  pub explanation as "explanation,omitempty": Str = ""
  /// Output only. The outcome of the evaluation expectation.
  pub outcome as "outcome,omitempty": Str = ""
  /// Output only. The prompt that was used for the evaluation.
  pub prompt as "prompt,omitempty": Str = ""
} derive Json

/// EvaluationResultGoldenExpectationOutcome: Specifies the expectation and the result of that expectation.
pub struct EvaluationResultGoldenExpectationOutcome {
  /// Output only. The expectation that was evaluated.
  pub expectation as "expectation,omitempty": EvaluationGoldenExpectation? = None
  /// Output only. The result of the agent response expectation.
  pub observed_agent_response as "observedAgentResponse,omitempty": Message? = None
  /// Output only. The result of the agent transfer expectation.
  pub observed_agent_transfer as "observedAgentTransfer,omitempty": AgentTransfer? = None
  /// Output only. An observed custom payload. There are no expectations for custom payloads. This is only used for metrics calculation. The outcome is always SKIPPED.
  pub observed_payload as "observedPayload,omitempty": json.Value? = None
  /// Output only. The result of the tool call expectation.
  pub observed_tool_call as "observedToolCall,omitempty": ToolCall? = None
  /// Output only. The result of the tool response expectation.
  pub observed_tool_response as "observedToolResponse,omitempty": ToolResponse? = None
  /// Output only. The outcome of the expectation.
  pub outcome as "outcome,omitempty": Str = ""
  /// Output only. The result of the semantic similarity check.
  pub semantic_similarity_result as "semanticSimilarityResult,omitempty": EvaluationResultSemanticSimilarityResult? = None
  /// Output only. The result of the tool invocation check.
  pub tool_invocation_result as "toolInvocationResult,omitempty": EvaluationResultGoldenExpectationOutcomeToolInvocationResult? = None
} derive Json

/// EvaluationResultGoldenExpectationOutcomeToolInvocationResult: The result of the tool invocation check.
pub struct EvaluationResultGoldenExpectationOutcomeToolInvocationResult {
  /// Output only. A free text explanation for the tool invocation result.
  pub explanation as "explanation,omitempty": Str = ""
  /// Output only. The outcome of the tool invocation check. This is determined by comparing the parameter_correctness_score to the threshold. If the score is equal to or above the threshold, the outcome will be PASS. Otherwise, the outcome will be FAIL.
  pub outcome as "outcome,omitempty": Str = ""
  /// Output only. The tool invocation parameter correctness score. This indicates the percent of parameters from the expected tool call that were also present in the actual tool call.
  pub parameter_correctness_score as "parameterCorrectnessScore,omitempty": Float = 0.0
} derive Json

/// EvaluationResultGoldenResult: The result of a golden evaluation.
pub struct EvaluationResultGoldenResult {
  /// Output only. The results of the evaluation expectations.
  pub evaluation_expectation_results as "evaluationExpectationResults,omitempty": List[EvaluationResultEvaluationExpectationResult] = []
  /// Output only. The result of running each turn of the golden conversation.
  pub turn_replay_results as "turnReplayResults,omitempty": List[EvaluationResultGoldenResultTurnReplayResult] = []
} derive Json

/// EvaluationResultGoldenResultTurnReplayResult: The result of running a single turn of the golden conversation.
pub struct EvaluationResultGoldenResultTurnReplayResult {
  /// Output only. The conversation that was generated for this turn.
  pub conversation as "conversation,omitempty": Str = ""
  /// Output only. Information about the error that occurred during this turn.
  pub error_info as "errorInfo,omitempty": EvaluationErrorInfo? = None
  /// Output only. The outcome of each expectation.
  pub expectation_outcome as "expectationOutcome,omitempty": List[EvaluationResultGoldenExpectationOutcome] = []
  /// Output only. The result of the hallucination check.
  pub hallucination_result as "hallucinationResult,omitempty": EvaluationResultHallucinationResult? = None
  /// Output only. The result of the overall tool invocation check.
  pub overall_tool_invocation_result as "overallToolInvocationResult,omitempty": EvaluationResultOverallToolInvocationResult? = None
  /// Output only. The result of the semantic similarity check.
  pub semantic_similarity_result as "semanticSimilarityResult,omitempty": EvaluationResultSemanticSimilarityResult? = None
  /// Output only. The latency of spans in the turn.
  pub span_latencies as "spanLatencies,omitempty": List[EvaluationResultSpanLatency] = []
  /// Output only. The latency of each tool call in the turn.
  pub tool_call_latencies as "toolCallLatencies,omitempty": List[EvaluationResultToolCallLatency] = []
  /// Output only. Deprecated. Use OverallToolInvocationResult instead.
  pub tool_invocation_score as "toolInvocationScore,omitempty": Float = 0.0
  /// Output only. The overall tool ordered invocation score for this turn. This indicates the overall percent of tools from the expected turn that were actually invoked in the expected order.
  pub tool_ordered_invocation_score as "toolOrderedInvocationScore,omitempty": Float = 0.0
  /// Output only. Duration of the turn.
  pub turn_latency as "turnLatency,omitempty": Str = ""
} derive Json

/// EvaluationResultHallucinationResult: The result of the hallucination check for a single turn.
pub struct EvaluationResultHallucinationResult {
  /// Output only. The explanation for the hallucination score.
  pub explanation as "explanation,omitempty": Str = ""
  /// Output only. The label associated with each score. Score 1: Justified Score 0: Not Justified Score -1: No Claim To Assess
  pub label as "label,omitempty": Str = ""
  /// Output only. The hallucination score. Can be -1, 0, 1.
  pub score as "score,omitempty": Int = 0
} derive Json

/// EvaluationResultOverallToolInvocationResult: The result of the overall tool invocation check.
pub struct EvaluationResultOverallToolInvocationResult {
  /// Output only. The outcome of the tool invocation check. This is determined by comparing the tool_invocation_score to the overall_tool_invocation_correctness_threshold. If the score is equal to or above the threshold, the outcome will be PASS. Otherwise, the outcome will be FAIL.
  pub outcome as "outcome,omitempty": Str = ""
  /// The overall tool invocation score for this turn. This indicates the overall percent of tools from the expected turn that were actually invoked.
  pub tool_invocation_score as "toolInvocationScore,omitempty": Float = 0.0
} derive Json

/// EvaluationResultScenarioExpectationOutcome: The outcome of a scenario expectation.
pub struct EvaluationResultScenarioExpectationOutcome {
  /// Output only. The expectation that was evaluated.
  pub expectation as "expectation,omitempty": EvaluationScenarioExpectation? = None
  /// Output only. The observed agent response.
  pub observed_agent_response as "observedAgentResponse,omitempty": Message? = None
  /// Output only. The observed tool call.
  pub observed_tool_call as "observedToolCall,omitempty": EvaluationResultScenarioExpectationOutcomeObservedToolCall? = None
  /// Output only. The outcome of the ScenarioExpectation.
  pub outcome as "outcome,omitempty": Str = ""
} derive Json

/// EvaluationResultScenarioExpectationOutcomeObservedToolCall: The observed tool call and response.
pub struct EvaluationResultScenarioExpectationOutcomeObservedToolCall {
  /// Output only. The observed tool call.
  pub tool_call as "toolCall,omitempty": ToolCall? = None
  /// Output only. The observed tool response.
  pub tool_response as "toolResponse,omitempty": ToolResponse? = None
} derive Json

/// EvaluationResultScenarioResult: The outcome of a scenario evaluation.
pub struct EvaluationResultScenarioResult {
  /// Output only. Whether all expectations were satisfied for this turn.
  pub all_expectations_satisfied as "allExpectationsSatisfied,omitempty": Bool = false
  /// Output only. The conversation that was generated in the scenario.
  pub conversation as "conversation,omitempty": Str = ""
  /// Output only. The results of the evaluation expectations.
  pub evaluation_expectation_results as "evaluationExpectationResults,omitempty": List[EvaluationResultEvaluationExpectationResult] = []
  /// Output only. The outcome of each expectation.
  pub expectation_outcomes as "expectationOutcomes,omitempty": List[EvaluationResultScenarioExpectationOutcome] = []
  /// Output only. The result of the hallucination check. There will be one hallucination result for each turn in the conversation.
  pub hallucination_result as "hallucinationResult,omitempty": List[EvaluationResultHallucinationResult] = []
  /// Output only. The outcome of the rubric.
  pub rubric_outcomes as "rubricOutcomes,omitempty": List[EvaluationResultScenarioRubricOutcome] = []
  /// Output only. The latency of spans in the conversation.
  pub span_latencies as "spanLatencies,omitempty": List[EvaluationResultSpanLatency] = []
  /// Output only. The task that was used when running the scenario for this result.
  pub task as "task,omitempty": Str = ""
  /// Output only. Whether the task was completed for this turn. This is a composite of all expectations satisfied, no hallucinations, and user goal satisfaction.
  pub task_completed as "taskCompleted,omitempty": Bool = false
  /// Output only. The result of the task completion check.
  pub task_completion_result as "taskCompletionResult,omitempty": EvaluationResultTaskCompletionResult? = None
  /// Output only. The latency of each tool call execution in the conversation.
  pub tool_call_latencies as "toolCallLatencies,omitempty": List[EvaluationResultToolCallLatency] = []
  /// Output only. The user facts that were used by the scenario for this result.
  pub user_facts as "userFacts,omitempty": List[EvaluationScenarioUserFact] = []
  /// Output only. The result of the user goal satisfaction check.
  pub user_goal_satisfaction_result as "userGoalSatisfactionResult,omitempty": EvaluationResultUserGoalSatisfactionResult? = None
} derive Json

