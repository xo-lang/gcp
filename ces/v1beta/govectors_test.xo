  "REQ POST https://ces.googleapis.com/v1beta/id1/%20x:importEvaluations?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"conversationList\":{\"conversations\":[\"s-conversations\"]},\"csvContent\":\"YWI=\",\"gcsUri\":\"s-gcsuri\",\"importOptions\":{\"conflictResolutionStrategy\":\"s-conflictresolutionstrategy\"}}",
  "",
  "  SERVED 200 {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}",
  "OUT: {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}",
]

test "Go's ces.projects.locations.apps.importEvaluations" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}")
  gv_note(f, "CALL ces.projects.locations.apps.importEvaluations")
  match svc.projects.locations.apps.import_evaluations("id1/ x", json.decode_str[ImportEvaluationsRequest]("{\"conversationList\":{\"conversations\":[\"s-conversations\"]},\"csvContent\":\"YWI=\",\"gcsUri\":\"s-gcsuri\",\"importOptions\":{\"conflictResolutionStrategy\":\"s-conflictresolutionstrategy\"}}") ?? e => fault(e.display()), options: ProjectsLocationsAppsImportEvaluationsOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_14)
}

