test "Go's ces.projects.locations.apps.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"apps\":[{\"audioProcessingConfig\":{\"inactivityTimeout\":\"s-inactivitytimeout\"},\"clientCertificateSettings\":{\"passphrase\":\"s-passphrase\",\"privateKey\":\"s-privatekey\",\"tlsCertificate\":\"s-tlscertificate\"},\"createTime\":\"s-createtime\",\"dashboardSettings\":{\"defaultDashboard\":\"s-defaultdashboard\"},\"dataStoreSettings\":{},\"defaultChannelProfile\":{\"channelType\":\"s-channeltype\",\"disableBargeInControl\":true,\"disableDtmf\":true,\"noiseSuppressionLevel\":\"s-noisesuppressionlevel\",\"profileId\":\"s-profileid\"},\"deploymentCount\":7,\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"errorHandlingSettings\":{\"errorHandlingStrategy\":\"s-errorhandlingstrategy\"},\"etag\":\"s-etag\",\"evaluationMetricsThresholds\":{\"goldenHallucinationMetricBehavior\":\"s-goldenhallucinationmetricbehavior\",\"hallucinationMetricBehavior\":\"s-hallucinationmetricbehavior\",\"scenarioHallucinationMetricBehavior\":\"s-scenariohallucinationmetricbehavior\"},\"globalInstruction\":\"s-globalinstruction\",\"guardrails\":[\"s-guardrails\"],\"languageSettings\":{\"defaultLanguageCode\":\"s-defaultlanguagecode\",\"enableMultilingualSupport\":true,\"fallbackAction\":\"s-fallbackaction\"},\"locked\":true,\"loggingSettings\":{\"requiredRecordingConsent\":true},\"metadata\":{\"k1\":\"s-metadata\"},\"modelSettings\":{\"model\":\"s-model\",\"temperature\":1.5,\"thinkingLevel\":\"s-thinkinglevel\"},\"name\":\"s-name\",\"pinned\":true,\"rootAgent\":\"s-rootagent\",\"timeZoneSettings\":{\"timeZone\":\"s-timezone\"},\"toolExecutionMode\":\"s-toolexecutionmode\",\"updateTime\":\"s-updatetime\",\"validationErrors\":[\"s-validationerrors\"],\"vpcScSettings\":{}}],\"nextPageToken\":\"s-nextpagetoken\",\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL ces.projects.locations.apps.list")
  match svc.projects.locations.apps.list("id1/ x", options: ProjectsLocationsAppsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_10)
}

