  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"outputs\":[{\"audio\":\"YWI=\",\"citations\":{},\"diagnosticInfo\":{},\"endSession\":{\"metadata\":{\"k\":\"v\"}},\"googleSearchSuggestions\":{},\"image\":{\"altText\":\"s-alttext\",\"data\":\"YWI=\",\"mimeType\":\"s-mimetype\"},\"payload\":{\"k\":\"v\"},\"progress\":\"s-progress\",\"text\":\"s-text\",\"toolCalls\":{},\"turnCompleted\":true,\"turnIndex\":7}]}")
  gv_note(f, "CALL ces.projects.locations.apps.sessions.runSession")
  match svc.projects.locations.apps.sessions.run_session("id1/ x", json.decode_str[RunSessionRequest]("{\"config\":{\"deployment\":\"s-deployment\",\"enableTextStreaming\":true,\"entryAgent\":\"s-entryagent\",\"excludeDiagnosticInfo\":true,\"historicalContexts\":[{\"eventTime\":\"s-eventtime\",\"role\":\"s-role\"}],\"includeLlmThoughtSummary\":true,\"includeProgressUpdate\":true,\"inputAudioConfig\":{\"audioEncoding\":\"s-audioencoding\",\"noiseSuppressionLevel\":\"s-noisesuppressionlevel\",\"sampleRateHertz\":7},\"outputAudioConfig\":{\"audioEncoding\":\"s-audioencoding\",\"sampleRateHertz\":7},\"remoteDialogflowQueryParameters\":{\"endUserMetadata\":{\"k\":\"v\"},\"payload\":{\"k\":\"v\"},\"webhookHeaders\":{\"k1\":\"s-webhookheaders\"}},\"timeZone\":\"s-timezone\",\"useToolFakes\":true},\"inputs\":[{\"audio\":\"YWI=\",\"blob\":{\"data\":\"YWI=\",\"mimeType\":\"s-mimetype\"},\"dtmf\":\"s-dtmf\",\"event\":{\"event\":\"s-event\",\"variables\":{\"k\":\"v\"}},\"image\":{\"altText\":\"s-alttext\",\"data\":\"YWI=\",\"mimeType\":\"s-mimetype\"},\"recordingControl\":\"s-recordingcontrol\",\"text\":\"s-text\",\"toolResponses\":{},\"variables\":{\"k\":\"v\"},\"willContinue\":true}]}") ?? e => fault(e.display()), options: ProjectsLocationsAppsSessionsRunSessionOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
