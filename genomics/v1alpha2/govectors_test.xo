  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"pipelines\":[{\"description\":\"s-description\",\"docker\":{\"cmd\":\"s-cmd\",\"imageName\":\"s-imagename\"},\"name\":\"s-name\",\"pipelineId\":\"s-pipelineid\",\"projectId\":\"s-projectid\",\"resources\":{\"acceleratorCount\":\"7\",\"acceleratorType\":\"s-acceleratortype\",\"bootDiskSizeGb\":7,\"minimumCpuCores\":7,\"minimumRamGb\":1.5,\"noAddress\":true,\"preemptible\":true}}]}",
  "REQ GET https://genomics.googleapis.com/v1alpha2/pipelines?alt=json&fields=kind%2Cid&namePrefix=s-nameprefix&pageSize=7&pageToken=s-nextpagetoken&prettyPrint=false&projectId=s-projectid",
