]

test "Go's genomics.pipelines.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"pipelines\":[{\"description\":\"s-description\",\"docker\":{\"cmd\":\"s-cmd\",\"imageName\":\"s-imagename\"},\"name\":\"s-name\",\"pipelineId\":\"s-pipelineid\",\"projectId\":\"s-projectid\",\"resources\":{\"acceleratorCount\":\"7\",\"acceleratorType\":\"s-acceleratortype\",\"bootDiskSizeGb\":7,\"minimumCpuCores\":7,\"minimumRamGb\":1.5,\"noAddress\":true,\"preemptible\":true}}]}")
  gv_queue(f, "{\"pipelines\":[{\"description\":\"s-description\",\"docker\":{\"cmd\":\"s-cmd\",\"imageName\":\"s-imagename\"},\"name\":\"s-name\",\"pipelineId\":\"s-pipelineid\",\"projectId\":\"s-projectid\",\"resources\":{\"acceleratorCount\":\"7\",\"acceleratorType\":\"s-acceleratortype\",\"bootDiskSizeGb\":7,\"minimumCpuCores\":7,\"minimumRamGb\":1.5,\"noAddress\":true,\"preemptible\":true}}]}")
  gv_note(f, "CALL genomics.pipelines.list pages")
  var p = svc.pipelines.list_pages(options: PipelinesListOptions{name_prefix: Some("s-nameprefix"), page_size: Some(7), page_token: Some("s-pagetoken"), project_id: Some("s-projectid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_9)
}

