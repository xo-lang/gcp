test "Go's genomics.pipelines.run" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}")
  gv_note(f, "CALL genomics.pipelines.run")
  match svc.pipelines.run(json.decode_str[RunPipelineRequest]("{\"ephemeralPipeline\":{\"description\":\"s-description\",\"docker\":{\"cmd\":\"s-cmd\",\"imageName\":\"s-imagename\"},\"inputParameters\":[{\"defaultValue\":\"s-defaultvalue\",\"description\":\"s-description\",\"name\":\"s-name\"}],\"name\":\"s-name\",\"outputParameters\":[{\"defaultValue\":\"s-defaultvalue\",\"description\":\"s-description\",\"name\":\"s-name\"}],\"pipelineId\":\"s-pipelineid\",\"projectId\":\"s-projectid\",\"resources\":{\"acceleratorCount\":\"7\",\"acceleratorType\":\"s-acceleratortype\",\"bootDiskSizeGb\":7,\"minimumCpuCores\":7,\"minimumRamGb\":1.5,\"noAddress\":true,\"preemptible\":true,\"zones\":[\"s-zones\"]}},\"pipelineArgs\":{\"clientId\":\"s-clientid\",\"inputs\":{\"k1\":\"s-inputs\"},\"keepVmAliveOnFailureDuration\":\"s-keepvmaliveonfailureduration\",\"labels\":{\"k1\":\"s-labels\"},\"logging\":{\"gcsPath\":\"s-gcspath\"},\"outputs\":{\"k1\":\"s-outputs\"},\"projectId\":\"s-projectid\",\"resources\":{\"acceleratorCount\":\"7\",\"acceleratorType\":\"s-acceleratortype\",\"bootDiskSizeGb\":7,\"minimumCpuCores\":7,\"minimumRamGb\":1.5,\"noAddress\":true,\"preemptible\":true,\"zones\":[\"s-zones\"]},\"serviceAccount\":{\"email\":\"s-email\",\"scopes\":[\"s-scopes\"]}},\"pipelineId\":\"s-pipelineid\"}") ?? e => fault(e.display()), options: PipelinesRunOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_10)
}

