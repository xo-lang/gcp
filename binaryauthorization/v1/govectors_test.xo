test "Go's binaryauthorization.systempolicy.getPolicy" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"admissionWhitelistPatterns\":[{\"namePattern\":\"s-namepattern\"}],\"clusterAdmissionRules\":{\"k1\":{\"enforcementMode\":\"s-enforcementmode\",\"evaluationMode\":\"s-evaluationmode\",\"requireAttestationsBy\":[\"s-requireattestationsby\"]}},\"defaultAdmissionRule\":{\"enforcementMode\":\"s-enforcementmode\",\"evaluationMode\":\"s-evaluationmode\",\"requireAttestationsBy\":[\"s-requireattestationsby\"]},\"description\":\"s-description\",\"etag\":\"s-etag\",\"globalPolicyEvaluationMode\":\"s-globalpolicyevaluationmode\",\"istioServiceIdentityAdmissionRules\":{\"k1\":{\"enforcementMode\":\"s-enforcementmode\",\"evaluationMode\":\"s-evaluationmode\",\"requireAttestationsBy\":[\"s-requireattestationsby\"]}},\"kubernetesNamespaceAdmissionRules\":{\"k1\":{\"enforcementMode\":\"s-enforcementmode\",\"evaluationMode\":\"s-evaluationmode\",\"requireAttestationsBy\":[\"s-requireattestationsby\"]}},\"kubernetesServiceAccountAdmissionRules\":{\"k1\":{\"enforcementMode\":\"s-enforcementmode\",\"evaluationMode\":\"s-evaluationmode\",\"requireAttestationsBy\":[\"s-requireattestationsby\"]}},\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}")
  gv_note(f, "CALL binaryauthorization.systempolicy.getPolicy")
  match svc.systempolicy.get_policy("id1/ x", options: SystempolicyGetPolicyOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_20)
}
