  profile_id: Int
  options: UserRolesListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: UserRolesService.list's pages, from the first.
pub fn (r: UserRolesService[fx]) list_pages(profile_id: Int, options: UserRolesListOptions = UserRolesListOptions{}) -> UserRolesListPages[fx] {
  UserRolesListPages{r: r, profile_id: profile_id, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: UserRolesListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: UserRolesListPages[fx]) next_page() -> UserRolesListResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.profile_id, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

