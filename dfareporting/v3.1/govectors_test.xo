test "Go's dfareporting.creatives.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"creatives\":[{\"accountId\":\"7\",\"active\":true,\"adParameters\":\"s-adparameters\",\"adTagKeys\":[\"s-adtagkeys\"],\"advertiserId\":\"7\",\"allowScriptAccess\":true,\"archived\":true,\"artworkType\":\"s-artworktype\",\"authoringSource\":\"s-authoringsource\",\"authoringTool\":\"s-authoringtool\",\"autoAdvanceImages\":true,\"backgroundColor\":\"s-backgroundcolor\",\"backupImageClickThroughUrl\":{\"computedClickThroughUrl\":\"s-computedclickthroughurl\",\"customClickThroughUrl\":\"s-customclickthroughurl\",\"landingPageId\":\"7\"},\"backupImageFeatures\":[\"s-backupimagefeatures\"],\"backupImageReportingLabel\":\"s-backupimagereportinglabel\",\"backupImageTargetWindow\":{\"customHtml\":\"s-customhtml\",\"targetWindowOption\":\"s-targetwindowoption\"},\"commercialId\":\"s-commercialid\",\"companionCreatives\":[\"7\"],\"compatibility\":[\"s-compatibility\"],\"convertFlashToHtml5\":true,\"creativeAssetSelection\":{\"defaultAssetId\":\"7\"},\"customKeyValues\":[\"s-customkeyvalues\"],\"dynamicAssetSelection\":true,\"fsCommand\":{\"left\":7,\"positionOption\":\"s-positionoption\",\"top\":7,\"windowHeight\":7,\"windowWidth\":7},\"htmlCode\":\"s-htmlcode\",\"htmlCodeLocked\":true,\"id\":\"7\",\"idDimensionValue\":{\"dimensionName\":\"s-dimensionname\",\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"matchType\":\"s-matchtype\",\"value\":\"s-value\"},\"kind\":\"s-kind\",\"lastModifiedInfo\":{\"time\":\"7\"},\"latestTraffickedCreativeId\":\"7\",\"mediaDescription\":\"s-mediadescription\",\"mediaDuration\":1.5,\"name\":\"s-name\",\"overrideCss\":\"s-overridecss\",\"progressOffset\":{\"offsetPercentage\":7,\"offsetSeconds\":7},\"redirectUrl\":\"s-redirecturl\",\"renderingId\":\"7\",\"renderingIdDimensionValue\":{\"dimensionName\":\"s-dimensionname\",\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"matchType\":\"s-matchtype\",\"value\":\"s-value\"},\"requiredFlashPluginVersion\":\"s-requiredflashpluginversion\",\"requiredFlashVersion\":7,\"size\":{\"height\":7,\"iab\":true,\"id\":\"7\",\"kind\":\"s-kind\",\"width\":7},\"skipOffset\":{\"offsetPercentage\":7,\"offsetSeconds\":7},\"skippable\":true,\"sslCompliant\":true,\"sslOverride\":true,\"studioAdvertiserId\":\"7\",\"studioCreativeId\":\"7\",\"studioTraffickedCreativeId\":\"7\",\"subaccountId\":\"7\",\"thirdPartyBackupImageImpressionsUrl\":\"s-thirdpartybackupimageimpressionsurl\",\"thirdPartyRichMediaImpressionsUrl\":\"s-thirdpartyrichmediaimpressionsurl\",\"totalFileSize\":\"7\",\"type\":\"s-type\",\"universalAdId\":{\"registry\":\"s-registry\",\"value\":\"s-value\"},\"version\":7}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_note(f, "CALL dfareporting.creatives.list")
  match svc.creatives.list("7", options: CreativesListOptions{active: Some(true), advertiser_id: Some("7"), archived: Some(true), campaign_id: Some("7"), companion_creative_ids: ["7"], creative_field_ids: ["7"], ids: ["7"], max_results: Some(7), page_token: Some("s-pagetoken"), rendering_ids: ["7"], search_string: Some("s-searchstring"), size_ids: ["7"], sort_field: Some("s-sortfield"), sort_order: Some("s-sortorder"), studio_creative_id: Some("7"), types: ["s-types"], fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_78)
}

