test "Go's dfareporting.reports.run" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"dateRange\":{\"endDate\":\"s-enddate\",\"kind\":\"s-kind\",\"relativeDateRange\":\"s-relativedaterange\",\"startDate\":\"s-startdate\"},\"etag\":\"s-etag\",\"fileName\":\"s-filename\",\"format\":\"s-format\",\"id\":\"7\",\"kind\":\"s-kind\",\"lastModifiedTime\":\"7\",\"reportId\":\"7\",\"status\":\"s-status\",\"urls\":{\"apiUrl\":\"s-apiurl\",\"browserUrl\":\"s-browserurl\"}}")
  gv_note(f, "CALL dfareporting.reports.run")
  match svc.reports.run("7", "7", options: ReportsRunOptions{synchronous: Some(true), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
