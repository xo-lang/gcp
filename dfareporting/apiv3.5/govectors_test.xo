test "Go's dfareporting.media.upload resumable" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "@H Location=https://dfareporting.googleapis.com/upload/session-1 @B ")
  gv_queue(f, "@H X-Http-Status-Code-Override=308 @B ")
  gv_queue(f, "{\"assetIdentifier\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"clickTags\":[{\"clickThroughUrl\":{\"computedClickThroughUrl\":\"s-computedclickthroughurl\",\"customClickThroughUrl\":\"s-customclickthroughurl\",\"landingPageId\":\"7\"},\"eventName\":\"s-eventname\",\"name\":\"s-name\"}],\"counterCustomEvents\":[{\"advertiserCustomEventId\":\"7\",\"advertiserCustomEventName\":\"s-advertisercustomeventname\",\"advertiserCustomEventType\":\"s-advertisercustomeventtype\",\"artworkLabel\":\"s-artworklabel\",\"artworkType\":\"s-artworktype\",\"exitClickThroughUrl\":{\"computedClickThroughUrl\":\"s-computedclickthroughurl\",\"customClickThroughUrl\":\"s-customclickthroughurl\",\"landingPageId\":\"7\"},\"id\":\"7\",\"popupWindowProperties\":{\"positionType\":\"s-positiontype\",\"showAddressBar\":true,\"showMenuBar\":true,\"showScrollBar\":true,\"showStatusBar\":true,\"showToolBar\":true,\"title\":\"s-title\"},\"targetType\":\"s-targettype\",\"videoReportingId\":\"s-videoreportingid\"}],\"detectedFeatures\":[\"s-detectedfeatures\"],\"exitCustomEvents\":[{\"advertiserCustomEventId\":\"7\",\"advertiserCustomEventName\":\"s-advertisercustomeventname\",\"advertiserCustomEventType\":\"s-advertisercustomeventtype\",\"artworkLabel\":\"s-artworklabel\",\"artworkType\":\"s-artworktype\",\"exitClickThroughUrl\":{\"computedClickThroughUrl\":\"s-computedclickthroughurl\",\"customClickThroughUrl\":\"s-customclickthroughurl\",\"landingPageId\":\"7\"},\"id\":\"7\",\"popupWindowProperties\":{\"positionType\":\"s-positiontype\",\"showAddressBar\":true,\"showMenuBar\":true,\"showScrollBar\":true,\"showStatusBar\":true,\"showToolBar\":true,\"title\":\"s-title\"},\"targetType\":\"s-targettype\",\"videoReportingId\":\"s-videoreportingid\"}],\"id\":\"7\",\"idDimensionValue\":{\"dimensionName\":\"s-dimensionname\",\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"matchType\":\"s-matchtype\",\"value\":\"s-value\"},\"kind\":\"s-kind\",\"richMedia\":true,\"timerCustomEvents\":[{\"advertiserCustomEventId\":\"7\",\"advertiserCustomEventName\":\"s-advertisercustomeventname\",\"advertiserCustomEventType\":\"s-advertisercustomeventtype\",\"artworkLabel\":\"s-artworklabel\",\"artworkType\":\"s-artworktype\",\"exitClickThroughUrl\":{\"computedClickThroughUrl\":\"s-computedclickthroughurl\",\"customClickThroughUrl\":\"s-customclickthroughurl\",\"landingPageId\":\"7\"},\"id\":\"7\",\"popupWindowProperties\":{\"positionType\":\"s-positiontype\",\"showAddressBar\":true,\"showMenuBar\":true,\"showScrollBar\":true,\"showStatusBar\":true,\"showToolBar\":true,\"title\":\"s-title\"},\"targetType\":\"s-targettype\",\"videoReportingId\":\"s-videoreportingid\"}],\"warnedValidationRules\":[\"s-warnedvalidationrules\"]}")
  gv_note(f, "CALL dfareporting.media.upload resumable")
  match svc.media.upload_media(os.clock, os.rand, 7, 7, json.decode_str[CreativeAssetMetadata]("{\"assetIdentifier\":{\"name\":\"s-name\",\"type\":\"s-type\"},\"clickTags\":[{\"clickThroughUrl\":{\"computedClickThroughUrl\":\"s-computedclickthroughurl\",\"customClickThroughUrl\":\"s-customclickthroughurl\",\"landingPageId\":\"7\"},\"eventName\":\"s-eventname\",\"name\":\"s-name\"}],\"counterCustomEvents\":[{\"advertiserCustomEventId\":\"7\",\"advertiserCustomEventName\":\"s-advertisercustomeventname\",\"advertiserCustomEventType\":\"s-advertisercustomeventtype\",\"artworkLabel\":\"s-artworklabel\",\"artworkType\":\"s-artworktype\",\"exitClickThroughUrl\":{\"computedClickThroughUrl\":\"s-computedclickthroughurl\",\"customClickThroughUrl\":\"s-customclickthroughurl\",\"landingPageId\":\"7\"},\"id\":\"7\",\"popupWindowProperties\":{\"positionType\":\"s-positiontype\",\"showAddressBar\":true,\"showMenuBar\":true,\"showScrollBar\":true,\"showStatusBar\":true,\"showToolBar\":true,\"title\":\"s-title\"},\"targetType\":\"s-targettype\",\"videoReportingId\":\"s-videoreportingid\"}],\"detectedFeatures\":[\"s-detectedfeatures\"],\"exitCustomEvents\":[{\"advertiserCustomEventId\":\"7\",\"advertiserCustomEventName\":\"s-advertisercustomeventname\",\"advertiserCustomEventType\":\"s-advertisercustomeventtype\",\"artworkLabel\":\"s-artworklabel\",\"artworkType\":\"s-artworktype\",\"exitClickThroughUrl\":{\"computedClickThroughUrl\":\"s-computedclickthroughurl\",\"customClickThroughUrl\":\"s-customclickthroughurl\",\"landingPageId\":\"7\"},\"id\":\"7\",\"popupWindowProperties\":{\"positionType\":\"s-positiontype\",\"showAddressBar\":true,\"showMenuBar\":true,\"showScrollBar\":true,\"showStatusBar\":true,\"showToolBar\":true,\"title\":\"s-title\"},\"targetType\":\"s-targettype\",\"videoReportingId\":\"s-videoreportingid\"}],\"id\":\"7\",\"idDimensionValue\":{\"dimensionName\":\"s-dimensionname\",\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"matchType\":\"s-matchtype\",\"value\":\"s-value\"},\"kind\":\"s-kind\",\"richMedia\":true,\"timerCustomEvents\":[{\"advertiserCustomEventId\":\"7\",\"advertiserCustomEventName\":\"s-advertisercustomeventname\",\"advertiserCustomEventType\":\"s-advertisercustomeventtype\",\"artworkLabel\":\"s-artworklabel\",\"artworkType\":\"s-artworktype\",\"exitClickThroughUrl\":{\"computedClickThroughUrl\":\"s-computedclickthroughurl\",\"customClickThroughUrl\":\"s-customclickthroughurl\",\"landingPageId\":\"7\"},\"id\":\"7\",\"popupWindowProperties\":{\"positionType\":\"s-positiontype\",\"showAddressBar\":true,\"showMenuBar\":true,\"showScrollBar\":true,\"showStatusBar\":true,\"showToolBar\":true,\"title\":\"s-title\"},\"targetType\":\"s-targettype\",\"videoReportingId\":\"s-videoreportingid\"}],\"warnedValidationRules\":[\"s-warnedvalidationrules\"]}") ?? e => fault(e.display()), media: gensupport.Media{data: gv_big(), content_type: "text/plain", chunk_size: 262144}, options: MediaUploadOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_2)
}
