  /// Number of non-container artifacts uploaded to Cloud Storage. Only populated when artifacts are uploaded to Cloud Storage.
  pub num_artifacts as "numArtifacts,omitempty,string": Int = 0
  /// Python artifacts uploaded to Artifact Registry at the end of the build.
  pub python_packages as "pythonPackages,omitempty": List[GoogleDevtoolsCloudbuildV1UploadedPythonPackage] = []
  /// Output only. Aggregated metrics for the build.
