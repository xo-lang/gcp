  /// Option to specify whether or not to apply bash style string operations to the substitutions. NOTE: this is always enabled for triggered builds and cannot be overridden in the build configuration file.
  pub dynamic_substitutions as "dynamicSubstitutions,omitempty": Bool = false
  /// Optional. Option to specify whether structured logging is enabled. If true, JSON-formatted logs are parsed as structured logs.
  pub enable_structured_logging as "enableStructuredLogging,omitempty": Bool = false
  /// A list of global environment variable definitions that will exist for all build steps in this build. If a variable is defined in both globally and in a build step, the variable will use the build step value. The elements are of the form "KEY=VALUE" for the environment variable "KEY" being given the value "VALUE".
  pub env as "env,omitempty": List[Str] = []
  /// Option to define build log streaming behavior to Cloud Storage.
  pub log_streaming_option as "logStreamingOption,omitempty": Str = ""
  /// Option to specify the logging mode, which determines if and where build logs are stored.
  pub logging as "logging,omitempty": Str = ""
  /// Compute Engine machine type on which to run the build.
  pub machine_type as "machineType,omitempty": Str = ""
  /// Optional. Specification for execution on a `WorkerPool`. See [running builds in a private pool](https://cloud.google.com/build/docs/private-pools/run-builds-in-private-pool) for more information.
  pub pool as "pool,omitempty": GoogleDevtoolsCloudbuildV1PoolOption? = None
  /// Optional. Option to specify the Pub/Sub topic to receive build status updates.
  pub pubsub_topic as "pubsubTopic,omitempty": Str = ""
  /// Optional. Ranked list (earlier items have higher priority) of Machine Series to consider when provisioning Worker VMs. A concrete machine type will be selected based on machine availability in the given region. This field must be empty for the Build to be eligible to be paired with a pre-provisioned worker VM.
  pub ranked_machine_series as "rankedMachineSeries,omitempty": List[Str] = []
  /// Requested verifiability options.
  pub requested_verify_option as "requestedVerifyOption,omitempty": Str = ""
  /// Output only. Worker release resolved from the release channel.
  pub resolved_worker_release as "resolvedWorkerRelease,omitempty": Str = ""
  /// A list of global environment variables, which are encrypted using a Cloud Key Management Service crypto key. These values must be specified in the build's `Secret`. These variables will be available to all build steps in this build.
  pub secret_env as "secretEnv,omitempty": List[Str] = []
  /// Requested hash for SourceProvenance.
  pub source_provenance_hash as "sourceProvenanceHash,omitempty": List[Str] = []
  /// Option to specify behavior when there is an error in the substitution checks. NOTE: this is always set to ALLOW_LOOSE for triggered builds and cannot be overridden in the build configuration file.
  pub substitution_option as "substitutionOption,omitempty": Str = ""
  /// Global list of volumes to mount for ALL build steps Each volume is created as an empty volume prior to starting the build process. Upon completion of the build, volumes and their contents are discarded. Global volume names and paths cannot conflict with the volumes defined a build step. Using a global volume in a build with only one step is not valid as it is indicative of a build request with an incorrect configuration.
  pub volumes as "volumes,omitempty": List[GoogleDevtoolsCloudbuildV1Volume] = []
  /// This field deprecated; please use `pool.name` instead.
  pub worker_pool as "workerPool,omitempty": Str = ""
  /// Optional. Option to specify which release or release channel (rapid|regular|stable) to use to run this build.
  pub worker_release as "workerRelease,omitempty": Str = ""
} derive Json

/// GoogleDevtoolsCloudbuildV1BuildResourceUsage: Aggregated/summary metrics over the entire build lifecycle.
pub struct GoogleDevtoolsCloudbuildV1BuildResourceUsage {
  /// Output only. The average CPU utilization ratio across all vCPUs over the duration of the build, expressed as a fraction in the range [0.0, 1.0].
  pub average_cpu_utilization as "averageCpuUtilization,omitempty": Float = 0.0
  /// Output only. The average memory utilization ratio over the duration of the build, expressed as a fraction in the range [0.0, 1.0].
  pub average_memory_utilization as "averageMemoryUtilization,omitempty": Float = 0.0
  /// Output only. The highest CPU utilization ratio across all vCPUs observed over the duration of the build, expressed as a fraction in the range [0.0, 1.0].
  pub peak_cpu_utilization as "peakCpuUtilization,omitempty": Float = 0.0
  /// Output only. The highest memory utilization ratio observed over the duration of the build, expressed as a fraction in the range [0.0, 1.0].
  pub peak_memory_utilization as "peakMemoryUtilization,omitempty": Float = 0.0
  /// Output only. Total CPU execution time consumed across all cores during build execution.
  pub total_cpu_duration as "totalCpuDuration,omitempty": Str = ""
} derive Json

/// GoogleDevtoolsCloudbuildV1BuildStep: A step in the build pipeline.
pub struct GoogleDevtoolsCloudbuildV1BuildStep {
  /// Allow this build step to fail without failing the entire build if and only if the exit code is one of the specified codes. If allow_failure is also specified, this field will take precedence.
  pub allow_exit_codes as "allowExitCodes,omitempty": List[Int] = []
  /// Allow this build step to fail without failing the entire build. If false, the entire build will fail if this step fails. Otherwise, the build will succeed, but this step will still have a failure status. Error information will be reported in the failure_detail field.
  pub allow_failure as "allowFailure,omitempty": Bool = false
  /// A list of arguments that will be presented to the step when it is started. If the image used to run the step's container has an entrypoint, the `args` are used as arguments to that entrypoint. If the image does not define an entrypoint, the first element in args is used as the entrypoint, and the remainder will be used as arguments.
  pub args as "args,omitempty": List[Str] = []
  /// Option to include built-in and custom substitutions as env variables for this build step. This option will override the global option in BuildOption.
  pub automap_substitutions as "automapSubstitutions,omitempty": Bool = false
  /// Working directory to use when running this step's container. If this value is a relative path, it is relative to the build's working directory. If this value is absolute, it may be outside the build's working directory, in which case the contents of the path may not be persisted across build step executions, unless a `volume` for that path is specified. If the build specifies a `RepoSource` with `dir` and a step with a `dir`, which specifies an absolute path, the `RepoSource` `dir` is ignored for the step's execution.
  pub dir as "dir,omitempty": Str = ""
  /// Entrypoint to be used instead of the build step image's default entrypoint. If unset, the image's default entrypoint is used.
  pub entrypoint as "entrypoint,omitempty": Str = ""
  /// A list of environment variable definitions to be used when running a step. The elements are of the form "KEY=VALUE" for the environment variable "KEY" being given the value "VALUE".
  pub env as "env,omitempty": List[Str] = []
  /// Output only. Return code from running the step.
  pub exit_code as "exitCode,omitempty": Int = 0
  /// Unique identifier for this build step, used in `wait_for` to reference this build step as a dependency.
  pub id as "id,omitempty": Str = ""
  /// Required. The name of the container image that will run this particular build step. If the image is available in the host's Docker daemon's cache, it will be run directly. If not, the host will attempt to pull the image first, using the builder service account's credentials if necessary. The Docker daemon's cache will already have the latest versions of all of the officially supported build steps ([https://github.com/GoogleCloudPlatform/cloud-builders](https://github.com/GoogleCloudPlatform/cloud-builders)). The Docker daemon will also have cached many of the layers for some popular images, like "ubuntu", "debian", but they will be refreshed at the time you attempt to use them. If you built an image in a previous build step, it will be stored in the host's Docker daemon's cache and is available to use as the name for a later build step.
  pub name as "name,omitempty": Str = ""
  /// Output only. Stores timing information for pulling this build step's builder image only.
  pub pull_timing as "pullTiming,omitempty": GoogleDevtoolsCloudbuildV1TimeSpan? = None
  /// Declaration of results for this build step.
  pub results as "results,omitempty": List[GoogleDevtoolsCloudbuildV1StepResult] = []
  /// A shell script to be executed in the step. When script is provided, the user cannot specify the entrypoint or args.
  pub script as "script,omitempty": Str = ""
  /// A list of environment variables which are encrypted using a Cloud Key Management Service crypto key. These values must be specified in the build's `Secret`.
  pub secret_env as "secretEnv,omitempty": List[Str] = []
  /// Output only. Status of the build step. At this time, build step status is only updated on build completion; step status is not updated in real-time as the build progresses.
  pub status as "status,omitempty": Str = ""
  /// Time limit for executing this build step. If not defined, the step has no time limit and will be allowed to continue to run until either it completes or the build itself times out.
  pub timeout as "timeout,omitempty": Str = ""
  /// Output only. Stores timing information for executing this build step.
  pub timing as "timing,omitempty": GoogleDevtoolsCloudbuildV1TimeSpan? = None
  /// List of volumes to mount into the build step. Each volume is created as an empty volume prior to execution of the build step. Upon completion of the build, volumes and their contents are discarded. Using a named volume in only one step is not valid as it is indicative of a build request with an incorrect configuration.
  pub volumes as "volumes,omitempty": List[GoogleDevtoolsCloudbuildV1Volume] = []
  /// The ID(s) of the step(s) that this build step depends on. This build step will not start until all the build steps in `wait_for` have completed successfully. If `wait_for` is empty, this build step will start when all previous build steps in the `Build.Steps` list have completed successfully.
  pub wait_for as "waitFor,omitempty": List[Str] = []
} derive Json

/// GoogleDevtoolsCloudbuildV1BuildStepResults: Results for a build step.
pub struct GoogleDevtoolsCloudbuildV1BuildStepResults {
  /// Results for a build step.
  pub results as "results,omitempty": Map[Str, Str] = {}
} derive Json

