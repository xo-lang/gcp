  /// Optional. Go module artifacts uploaded to Artifact Registry at the end of the build.
  pub go_modules as "goModules,omitempty": List[GoogleDevtoolsCloudbuildV1UploadedGoModule] = []
  /// Container images that were built as a part of the build.
  pub images as "images,omitempty": List[GoogleDevtoolsCloudbuildV1BuiltImage] = []
  /// Maven artifacts uploaded to Artifact Registry at the end of the build.
  pub maven_artifacts as "mavenArtifacts,omitempty": List[GoogleDevtoolsCloudbuildV1UploadedMavenArtifact] = []
  /// Npm packages uploaded to Artifact Registry at the end of the build.
