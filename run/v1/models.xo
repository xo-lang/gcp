/// GoogleDevtoolsCloudbuildV1Artifacts: Artifacts produced by a build that should be uploaded upon successful completion of all build steps.
pub struct GoogleDevtoolsCloudbuildV1Artifacts {
  /// Optional. A list of generic artifacts to be uploaded to Artifact Registry upon successful completion of all build steps. If any artifacts fail to be pushed, the build is marked FAILURE.
  pub generic_artifacts as "genericArtifacts,omitempty": List[GoogleDevtoolsCloudbuildV1GenericArtifact] = []
  /// Optional. A list of Go modules to be uploaded to Artifact Registry upon successful completion of all build steps. If any objects fail to be pushed, the build is marked FAILURE.
  pub go_modules as "goModules,omitempty": List[GoogleDevtoolsCloudbuildV1GoModule] = []
  /// A list of images to be pushed upon the successful completion of all build steps. The images will be pushed using the builder service account's credentials. The digests of the pushed images will be stored in the Build resource's results field. If any of the images fail to be pushed, the build is marked FAILURE.
  pub images as "images,omitempty": List[Str] = []
  /// A list of Maven artifacts to be uploaded to Artifact Registry upon successful completion of all build steps. Artifacts in the workspace matching specified paths globs will be uploaded to the specified Artifact Registry repository using the builder service account's credentials. If any artifacts fail to be pushed, the build is marked FAILURE.
  pub maven_artifacts as "mavenArtifacts,omitempty": List[GoogleDevtoolsCloudbuildV1MavenArtifact] = []
  /// A list of npm packages to be uploaded to Artifact Registry upon successful completion of all build steps. Npm packages in the specified paths will be uploaded to the specified Artifact Registry repository using the builder service account's credentials. If any packages fail to be pushed, the build is marked FAILURE.
  pub npm_packages as "npmPackages,omitempty": List[GoogleDevtoolsCloudbuildV1NpmPackage] = []
  /// A list of objects to be uploaded to Cloud Storage upon successful completion of all build steps. Files in the workspace matching specified paths globs will be uploaded to the specified Cloud Storage location using the builder service account's credentials. The location and generation of the uploaded objects will be stored in the Build resource's results field. If any objects fail to be pushed, the build is marked FAILURE.
  pub objects as "objects,omitempty": GoogleDevtoolsCloudbuildV1ArtifactObjects? = None
  /// Optional. A list of OCI images to be uploaded to Artifact Registry upon successful completion of all build steps. OCI images in the specified paths will be uploaded to the specified Artifact Registry repository using the builder service account's credentials. If any images fail to be pushed, the build is marked FAILURE.
  pub oci as "oci,omitempty": List[GoogleDevtoolsCloudbuildV1Oci] = []
  /// A list of Python packages to be uploaded to Artifact Registry upon successful completion of all build steps. The build service account credentials will be used to perform the upload. If any objects fail to be pushed, the build is marked FAILURE.
  pub python_packages as "pythonPackages,omitempty": List[GoogleDevtoolsCloudbuildV1PythonPackage] = []
} derive Json

/// GoogleDevtoolsCloudbuildV1Build: A build resource in the Cloud Build API. At a high level, a `Build` describes where to find source code, how to build it (for example, the builder image to run on the source), and where to store the built artifacts. Fields can include the following variables, which will be expanded when the build is created: - $PROJECT_ID: the project ID of the build. - $PROJECT_NUMBER: the project number of the build. - $LOCATION: the location/region of the build. - $BUILD_ID: the autogenerated ID of the build. - $REPO_NAME: the source repository name specified by RepoSource. - $BRANCH_NAME: the branch name specified by RepoSource. - $TAG_NAME: the tag name specified by RepoSource. - $REVISION_ID or $COMMIT_SHA: the commit SHA specified by RepoSource or resolved from the specified branch or tag. - $SHORT_SHA: first 7 characters of $REVISION_ID or $COMMIT_SHA.
pub struct GoogleDevtoolsCloudbuildV1Build {
  /// Output only. Describes this build's approval configuration, status, and result.
  pub approval as "approval,omitempty": GoogleDevtoolsCloudbuildV1BuildApproval? = None
  /// Artifacts produced by the build that should be uploaded upon successful completion of all build steps.
  pub artifacts as "artifacts,omitempty": GoogleDevtoolsCloudbuildV1Artifacts? = None
  /// Secrets and secret environment variables.
  pub available_secrets as "availableSecrets,omitempty": GoogleDevtoolsCloudbuildV1Secrets? = None
  /// Output only. The ID of the `BuildTrigger` that triggered this build, if it was triggered automatically.
  pub build_trigger_id as "buildTriggerId,omitempty": Str = ""
  /// Output only. Time at which the request to create the build was received.
  pub create_time as "createTime,omitempty": Str = ""
  /// Optional. Dependencies that the Cloud Build worker will fetch before executing user steps.
  pub dependencies as "dependencies,omitempty": List[GoogleDevtoolsCloudbuildV1Dependency] = []
  /// Output only. Contains information about the build when status=FAILURE.
  pub failure_info as "failureInfo,omitempty": GoogleDevtoolsCloudbuildV1FailureInfo? = None
  /// Output only. Time at which execution of the build was finished. The difference between finish_time and start_time is the duration of the build's execution.
  pub finish_time as "finishTime,omitempty": Str = ""
  /// Optional. Configuration for git operations.
  pub git_config as "gitConfig,omitempty": GoogleDevtoolsCloudbuildV1GitConfig? = None
  /// Output only. Unique identifier of the build.
  pub id as "id,omitempty": Str = ""
  /// A list of images to be pushed upon the successful completion of all build steps. The images are pushed using the builder service account's credentials. The digests of the pushed images will be stored in the `Build` resource's results field. If any of the images fail to be pushed, the build status is marked `FAILURE`.
  pub images as "images,omitempty": List[Str] = []
  /// Output only. URL to logs for this build in Google Cloud Console.
  pub log_url as "logUrl,omitempty": Str = ""
  /// Cloud Storage bucket where logs should be written (see [Bucket Name Requirements](https://cloud.google.com/storage/docs/bucket-naming#requirements)). Logs file names will be of the format `${logs_bucket}/log-${build_id}.txt`.
  pub logs_bucket as "logsBucket,omitempty": Str = ""
  /// Output only. The 'Build' name with format: `projects/{project}/locations/{location}/builds/{build}`, where {build} is a unique identifier generated by the service.
  pub name as "name,omitempty": Str = ""
  /// Special options for this build.
  pub options as "options,omitempty": GoogleDevtoolsCloudbuildV1BuildOptions? = None
  /// Output only. ID of the project.
  pub project_id as "projectId,omitempty": Str = ""
  /// TTL in queue for this build. If provided and the build is enqueued longer than this value, the build will expire and the build status will be `EXPIRED`. The TTL starts ticking from create_time.
  pub queue_ttl as "queueTtl,omitempty": Str = ""
  /// Output only. Results of the build.
  pub results as "results,omitempty": GoogleDevtoolsCloudbuildV1Results? = None
  /// Secrets to decrypt using Cloud Key Management Service. Note: Secret Manager is the recommended technique for managing sensitive data with Cloud Build. Use `available_secrets` to configure builds to access secrets from Secret Manager. For instructions, see: https://cloud.google.com/cloud-build/docs/securing-builds/use-secrets
  pub secrets as "secrets,omitempty": List[GoogleDevtoolsCloudbuildV1Secret] = []
  /// IAM service account whose credentials will be used at build runtime. Must be of the format `projects/{PROJECT_ID}/serviceAccounts/{ACCOUNT}`. ACCOUNT can be email address or uniqueId of the service account.
  pub service_account as "serviceAccount,omitempty": Str = ""
  /// Optional. The location of the source files to build.
  pub source as "source,omitempty": GoogleDevtoolsCloudbuildV1Source? = None
  /// Output only. A permanent fixed identifier for source.
  pub source_provenance as "sourceProvenance,omitempty": GoogleDevtoolsCloudbuildV1SourceProvenance? = None
  /// Output only. Time at which execution of the build was started.
  pub start_time as "startTime,omitempty": Str = ""
  /// Output only. Status of the build.
  pub status as "status,omitempty": Str = ""
  /// Output only. Customer-readable message about the current status.
  pub status_detail as "statusDetail,omitempty": Str = ""
  /// Required. The operations to be performed on the workspace.
  pub steps as "steps,omitempty": List[GoogleDevtoolsCloudbuildV1BuildStep] = []
  /// Substitutions data for `Build` resource.
  pub substitutions as "substitutions,omitempty": Map[Str, Str] = {}
  /// Tags for annotation of a `Build`. These are not docker tags.
  pub tags as "tags,omitempty": List[Str] = []
  /// Amount of time that this build should be allowed to run, to second granularity. If this amount of time elapses, work on the build will cease and the build status will be `TIMEOUT`. `timeout` starts ticking from `startTime`. Default time is 60 minutes.
  pub timeout as "timeout,omitempty": Str = ""
  /// Output only. Stores timing information for phases of the build. Valid keys are: * BUILD: time to execute all build steps. * PUSH: time to push all artifacts including docker images and non docker artifacts. * FETCHSOURCE: time to fetch source. * SETUPBUILD: time to set up build. If the build does not specify source or images, these keys will not be included.
  pub timing as "timing,omitempty": Map[Str, GoogleDevtoolsCloudbuildV1TimeSpan] = {}
  /// Output only. Non-fatal problems encountered during the execution of the build.
  pub warnings as "warnings,omitempty": List[GoogleDevtoolsCloudbuildV1Warning] = []
} derive Json

