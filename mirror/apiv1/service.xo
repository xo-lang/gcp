/// list: Retrieves a list of timeline items for the authenticated user.
/// (Go's mirror.timeline.list.)
pub fn (r: TimelineService[fx]) list(options: TimelineListOptions = TimelineListOptions{}) -> TimelineListResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.bundle_id {
    q.set("bundleId", v)
  }
  if let Some(v) = options.include_deleted {
    q.set("includeDeleted", "${v}")
  }
  if let Some(v) = options.max_results {
    q.set("maxResults", "${v}")
  }
  if let Some(v) = options.order_by {
    q.set("orderBy", v)
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if let Some(v) = options.pinned_only {
    q.set("pinnedOnly", "${v}")
  }
  if let Some(v) = options.source_item_id {
    q.set("sourceItemId", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "timeline"), {})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[TimelineListResponse](resp)
}

/// TimelineListPages: the pages of TimelineService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct TimelineListPages[fx: Effects] {
  r: TimelineService[fx]
  options: TimelineListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: TimelineService.list's pages, from the first.
pub fn (r: TimelineService[fx]) list_pages(options: TimelineListOptions = TimelineListOptions{}) -> TimelineListPages[fx] {
  TimelineListPages{r: r, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: TimelineListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: TimelineListPages[fx]) next_page() -> TimelineListResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

