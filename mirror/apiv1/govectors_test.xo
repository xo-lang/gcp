  "  H content-type=application/json | x-extra=v1 | x-upload-content-type=text/plain",
  "  B ",
  "  SERVED 200 @H Location=https://www.googleapis.com/upload/session-1 @B ",
  "REQ POST https://www.googleapis.com/upload/session-1",
  "  H content-range=bytes 0-262143/* | content-type=text/plain | x-goog-gcs-idempotency-token=UUID | x-guploader-no-308=yes",
  "  B <262144 bytes> 0123456789abcdef0123456789abcdef...0123456789abcdef0123456789abcdef",
  "  SERVED 200 @H X-Http-Status-Code-Override=308 @B ",
  "REQ POST https://www.googleapis.com/upload/session-1",
  "  H content-range=bytes 262144-262153/262154 | content-type=text/plain | x-goog-gcs-idempotency-token=UUID | x-guploader-no-308=yes",
  "  B 0123456789",
  "  SERVED 200 {\"contentType\":\"s-contenttype\",\"contentUrl\":\"s-contenturl\",\"id\":\"s-id\",\"isProcessingContent\":true}",
  "OUT: {\"contentType\":\"s-contenttype\",\"contentUrl\":\"s-contenturl\",\"id\":\"s-id\",\"isProcessingContent\":true}",
]

test "Go's mirror.timeline.attachments.insert resumable" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "@H Location=https://www.googleapis.com/upload/session-1 @B ")
