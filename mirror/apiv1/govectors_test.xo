test "Go's mirror.timeline.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"bundleId\":\"s-bundleid\",\"canonicalUrl\":\"s-canonicalurl\",\"created\":\"s-created\",\"creator\":{\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"phoneNumber\":\"s-phonenumber\",\"priority\":7,\"source\":\"s-source\",\"speakableName\":\"s-speakablename\",\"type\":\"s-type\"},\"displayTime\":\"s-displaytime\",\"etag\":\"s-etag\",\"html\":\"s-html\",\"id\":\"s-id\",\"inReplyTo\":\"s-inreplyto\",\"isBundleCover\":true,\"isDeleted\":true,\"isPinned\":true,\"kind\":\"s-kind\",\"location\":{\"accuracy\":1.5,\"address\":\"s-address\",\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"latitude\":1.5,\"longitude\":1.5,\"timestamp\":\"s-timestamp\"},\"notification\":{\"deliveryTime\":\"s-deliverytime\",\"level\":\"s-level\"},\"pinScore\":7,\"selfLink\":\"s-selflink\",\"sourceItemId\":\"s-sourceitemid\",\"speakableText\":\"s-speakabletext\",\"speakableType\":\"s-speakabletype\",\"text\":\"s-text\",\"title\":\"s-title\",\"updated\":\"s-updated\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"bundleId\":\"s-bundleid\",\"canonicalUrl\":\"s-canonicalurl\",\"created\":\"s-created\",\"creator\":{\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"phoneNumber\":\"s-phonenumber\",\"priority\":7,\"source\":\"s-source\",\"speakableName\":\"s-speakablename\",\"type\":\"s-type\"},\"displayTime\":\"s-displaytime\",\"etag\":\"s-etag\",\"html\":\"s-html\",\"id\":\"s-id\",\"inReplyTo\":\"s-inreplyto\",\"isBundleCover\":true,\"isDeleted\":true,\"isPinned\":true,\"kind\":\"s-kind\",\"location\":{\"accuracy\":1.5,\"address\":\"s-address\",\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"latitude\":1.5,\"longitude\":1.5,\"timestamp\":\"s-timestamp\"},\"notification\":{\"deliveryTime\":\"s-deliverytime\",\"level\":\"s-level\"},\"pinScore\":7,\"selfLink\":\"s-selflink\",\"sourceItemId\":\"s-sourceitemid\",\"speakableText\":\"s-speakabletext\",\"speakableType\":\"s-speakabletype\",\"text\":\"s-text\",\"title\":\"s-title\",\"updated\":\"s-updated\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL mirror.timeline.list pages")
  var p = svc.timeline.list_pages(options: TimelineListOptions{bundle_id: Some("s-bundleid"), include_deleted: Some(true), max_results: Some(7), order_by: Some("s-orderby"), page_token: Some("s-pagetoken"), pinned_only: Some(true), source_item_id: Some("s-sourceitemid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_20)
}

