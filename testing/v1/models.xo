/// TestMatrix: TestMatrix captures all details about a test. It contains the environment configuration, test specification, test executions and overall state and outcome.
pub struct TestMatrix {
  /// Information about the client which invoked the test.
  pub client_info as "clientInfo,omitempty": ClientInfo? = None
  /// Required. The devices the tests are being executed on.
  pub environment_matrix as "environmentMatrix,omitempty": EnvironmentMatrix? = None
  /// Output only. Details about why a matrix was deemed invalid. If multiple checks can be safely performed, they will be reported but no assumptions should be made about the length of this list.
  pub extended_invalid_matrix_details as "extendedInvalidMatrixDetails,omitempty": List[MatrixErrorDetail] = []
  /// If true, only a single attempt at most will be made to run each execution/shard in the matrix. Flaky test attempts are not affected. Normally, 2 or more attempts are made if a potential infrastructure issue is detected. This feature is for latency sensitive workloads. The incidence of execution failures may be significantly greater for fail-fast matrices and support is more limited because of that expectation.
  pub fail_fast as "failFast,omitempty": Bool = false
  /// The number of times a TestExecution should be re-attempted if one or more of its test cases fail for any reason. The maximum number of reruns allowed is 10. Default is 0, which implies no reruns.
  pub flaky_test_attempts as "flakyTestAttempts,omitempty": Int = 0
  /// Output only. Describes why the matrix is considered invalid. Only useful for matrices in the INVALID state.
  pub invalid_matrix_details as "invalidMatrixDetails,omitempty": Str = ""
  /// Output Only. The overall outcome of the test. Only set when the test matrix state is FINISHED.
  pub outcome_summary as "outcomeSummary,omitempty": Str = ""
  /// The cloud project that owns the test matrix.
  pub project_id as "projectId,omitempty": Str = ""
  /// Required. Where the results for the matrix are written.
  pub result_storage as "resultStorage,omitempty": ResultStorage? = None
  /// Output only. Indicates the current progress of the test matrix.
  pub state as "state,omitempty": Str = ""
  /// Output only. The list of test executions that the service creates for this matrix.
  pub test_executions as "testExecutions,omitempty": List[TestExecution] = []
  /// Output only. Unique id set by the service.
  pub test_matrix_id as "testMatrixId,omitempty": Str = ""
  /// Required. How to run the test.
  pub test_specification as "testSpecification,omitempty": TestSpecification? = None
  /// Output only. The time this test matrix was initially created.
  pub timestamp as "timestamp,omitempty": Str = ""
} derive Json

