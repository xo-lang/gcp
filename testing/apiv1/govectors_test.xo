  match svc.test_environment_catalog.get("id1/ x", options: TestEnvironmentCatalogGetOptions{include_viewable_models: Some(true), project_id: Some("s-projectid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_10)
}
