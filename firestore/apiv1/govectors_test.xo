test "Go's firestore.projects.databases.documents.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"documents\":[{\"createTime\":\"s-createtime\",\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"documents\":[{\"createTime\":\"s-createtime\",\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL firestore.projects.databases.documents.list pages")
  var p = svc.projects.databases.documents.list_pages("id1/ x", "id2/ x", options: ProjectsDatabasesDocumentsListOptions{mask_field_paths: ["s-mask.fieldpaths"], order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), read_time: Some("s-readtime"), recursive: Some(true), request_options_request_tags: ["s-requestoptions.requesttags"], show_missing: Some(true), transaction: Some("s-transaction"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_37)
}

