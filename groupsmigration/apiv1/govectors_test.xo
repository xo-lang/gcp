  "CALL groupsmigration.archive.insert resumable",
  "REQ POST https://groupsmigration.googleapis.com/upload/groups/v1/groups/id1%2F%20x/archive?alt=json&fields=kind%2Cid&prettyPrint=false&uploadType=resumable",
  "  H content-type=application/json | x-extra=v1 | x-upload-content-type=text/plain",
  "  B ",
