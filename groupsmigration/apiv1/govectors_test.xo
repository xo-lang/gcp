test "Go's groupsmigration.archive.insert resumable" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "@H Location=https://groupsmigration.googleapis.com/upload/session-1 @B ")
