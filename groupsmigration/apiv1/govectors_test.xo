  gv_queue(f, "{\"kind\":\"s-kind\",\"responseCode\":\"s-responsecode\"}")
  gv_note(f, "CALL groupsmigration.archive.insert resumable")
  match svc.archive.insert_media(os.clock, os.rand, "id1/ x", media: gensupport.Media{data: gv_big(), content_type: "text/plain", chunk_size: 262144}, options: ArchiveInsertOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
