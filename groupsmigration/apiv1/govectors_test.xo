const GV_HOST: Str = "https://groupsmigration.googleapis.com"

const GO_0: List[Str] = [
  "CALL groupsmigration.archive.insert",
  "REQ POST https://groupsmigration.googleapis.com/groups/v1/groups/id1%2F%20x/archive?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"kind\":\"s-kind\",\"responseCode\":\"s-responsecode\"}",
  "OUT: {\"kind\":\"s-kind\",\"responseCode\":\"s-responsecode\"}",
]

test "Go's groupsmigration.archive.insert" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"kind\":\"s-kind\",\"responseCode\":\"s-responsecode\"}")
  gv_note(f, "CALL groupsmigration.archive.insert")
  match svc.archive.insert("id1/ x", options: ArchiveInsertOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

