  "  B {\"behavior\":\"s-behavior\",\"dnsName\":\"s-dnsname\",\"kind\":\"s-kind\",\"localData\":{\"localDatas\":[{\"kind\":\"s-kind\",\"name\":\"s-name\",\"ttl\":7,\"type\":\"s-type\"}]},\"ruleName\":\"s-rulename\"}",
  "",
  "  SERVED 200 {\"responsePolicyRule\":{\"behavior\":\"s-behavior\",\"dnsName\":\"s-dnsname\",\"kind\":\"s-kind\",\"localData\":{},\"ruleName\":\"s-rulename\"}}",
  "OUT: {\"responsePolicyRule\":{\"behavior\":\"s-behavior\",\"dnsName\":\"s-dnsname\",\"kind\":\"s-kind\",\"localData\":{},\"ruleName\":\"s-rulename\"}}",
]

test "Go's dns.responsePolicyRules.update" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"responsePolicyRule\":{\"behavior\":\"s-behavior\",\"dnsName\":\"s-dnsname\",\"kind\":\"s-kind\",\"localData\":{},\"ruleName\":\"s-rulename\"}}")
  gv_note(f, "CALL dns.responsePolicyRules.update")
  match svc.response_policy_rules.update("id1/ x", "id2/ x", "id3/ x", json.decode_str[ResponsePolicyRule]("{\"behavior\":\"s-behavior\",\"dnsName\":\"s-dnsname\",\"kind\":\"s-kind\",\"localData\":{\"localDatas\":[{\"kind\":\"s-kind\",\"name\":\"s-name\",\"ttl\":7,\"type\":\"s-type\"}]},\"ruleName\":\"s-rulename\"}") ?? e => fault(e.display()), options: ResponsePolicyRulesUpdateOptions{client_operation_id: Some("s-clientoperationid"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_50)
}
