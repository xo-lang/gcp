test "Go's dns.managedZoneOperations.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"operations\":[{\"dnsKeyContext\":{},\"id\":\"s-id\",\"kind\":\"s-kind\",\"startTime\":\"s-starttime\",\"status\":\"s-status\",\"type\":\"s-type\",\"user\":\"s-user\",\"zoneContext\":{}}]}")
  gv_queue(f, "{\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"operations\":[{\"dnsKeyContext\":{},\"id\":\"s-id\",\"kind\":\"s-kind\",\"startTime\":\"s-starttime\",\"status\":\"s-status\",\"type\":\"s-type\",\"user\":\"s-user\",\"zoneContext\":{}}]}")
  gv_note(f, "CALL dns.managedZoneOperations.list pages")
  var p = svc.managed_zone_operations.list_pages("id1/ x", "id2/ x", options: ManagedZoneOperationsListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), sort_by: Some("s-sortby"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_9)
}

