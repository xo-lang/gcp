  "  SERVED 200 {\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"rrsets\":[{\"kind\":\"s-kind\",\"name\":\"s-name\",\"rrdatas\":[\"s-rrdatas\"],\"signatureRrdatas\":[\"s-signaturerrdatas\"],\"ttl\":7,\"type\":\"s-type\"}]}",
  "OUT: {\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"rrsets\":[{\"kind\":\"s-kind\",\"name\":\"s-name\",\"rrdatas\":[\"s-rrdatas\"],\"signatureRrdatas\":[\"s-signaturerrdatas\"],\"ttl\":7,\"type\":\"s-type\"}]}",
  "REQ GET https://dns.googleapis.com/dns/v2beta1/projects/id1%2F%20x/managedZones/id2%2F%20x/rrsets?alt=json&fields=kind%2Cid&maxResults=7&name=s-name&pageToken=s-nextpagetoken&prettyPrint=false&type=s-type",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"rrsets\":[{\"kind\":\"s-kind\",\"name\":\"s-name\",\"rrdatas\":[\"s-rrdatas\"],\"signatureRrdatas\":[\"s-signaturerrdatas\"],\"ttl\":7,\"type\":\"s-type\"}]}",
  "OUT: {\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"rrsets\":[{\"kind\":\"s-kind\",\"name\":\"s-name\",\"rrdatas\":[\"s-rrdatas\"],\"signatureRrdatas\":[\"s-signaturerrdatas\"],\"ttl\":7,\"type\":\"s-type\"}]}",
  "OUT: ok",
]

test "Go's dns.resourceRecordSets.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"rrsets\":[{\"kind\":\"s-kind\",\"name\":\"s-name\",\"rrdatas\":[\"s-rrdatas\"],\"signatureRrdatas\":[\"s-signaturerrdatas\"],\"ttl\":7,\"type\":\"s-type\"}]}")
  gv_queue(f, "{\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"rrsets\":[{\"kind\":\"s-kind\",\"name\":\"s-name\",\"rrdatas\":[\"s-rrdatas\"],\"signatureRrdatas\":[\"s-signaturerrdatas\"],\"ttl\":7,\"type\":\"s-type\"}]}")
  gv_note(f, "CALL dns.resourceRecordSets.list pages")
  var p = svc.resource_record_sets.list_pages("id1/ x", "id2/ x", options: ResourceRecordSetsListOptions{max_results: Some(7), name: Some("s-name"), page_token: Some("s-pagetoken"), type_: Some("s-type"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_26)
}
