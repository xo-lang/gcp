test "Go's dns.managedZones.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"managedZones\":[{\"creationTime\":\"s-creationtime\",\"description\":\"s-description\",\"dnsName\":\"s-dnsname\",\"dnssecConfig\":{\"kind\":\"s-kind\",\"nonExistence\":\"s-nonexistence\",\"state\":\"s-state\"},\"forwardingConfig\":{\"kind\":\"s-kind\"},\"id\":\"7\",\"kind\":\"s-kind\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"nameServerSet\":\"s-nameserverset\",\"nameServers\":[\"s-nameservers\"],\"peeringConfig\":{\"kind\":\"s-kind\"},\"privateVisibilityConfig\":{\"kind\":\"s-kind\"},\"reverseLookupConfig\":{\"kind\":\"s-kind\"},\"visibility\":\"s-visibility\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"managedZones\":[{\"creationTime\":\"s-creationtime\",\"description\":\"s-description\",\"dnsName\":\"s-dnsname\",\"dnssecConfig\":{\"kind\":\"s-kind\",\"nonExistence\":\"s-nonexistence\",\"state\":\"s-state\"},\"forwardingConfig\":{\"kind\":\"s-kind\"},\"id\":\"7\",\"kind\":\"s-kind\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"nameServerSet\":\"s-nameserverset\",\"nameServers\":[\"s-nameservers\"],\"peeringConfig\":{\"kind\":\"s-kind\"},\"privateVisibilityConfig\":{\"kind\":\"s-kind\"},\"reverseLookupConfig\":{\"kind\":\"s-kind\"},\"visibility\":\"s-visibility\"}]}")
  gv_note(f, "CALL dns.managedZones.list pages")
  var p = svc.managed_zones.list_pages("id1/ x", options: ManagedZonesListOptions{dns_name: Some("s-dnsname"), max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_14)
}

