test "Go's dns.policies.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"policies\":[{\"alternativeNameServerConfig\":{\"kind\":\"s-kind\"},\"description\":\"s-description\",\"enableInboundForwarding\":true,\"enableLogging\":true,\"id\":\"7\",\"kind\":\"s-kind\",\"name\":\"s-name\"}]}")
  gv_queue(f, "{\"header\":{\"operationId\":\"s-operationid\"},\"kind\":\"s-kind\",\"policies\":[{\"alternativeNameServerConfig\":{\"kind\":\"s-kind\"},\"description\":\"s-description\",\"enableInboundForwarding\":true,\"enableLogging\":true,\"id\":\"7\",\"kind\":\"s-kind\",\"name\":\"s-name\"}]}")
  gv_note(f, "CALL dns.policies.list pages")
  var p = svc.policies.list_pages("id1/ x", options: PoliciesListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_21)
}

