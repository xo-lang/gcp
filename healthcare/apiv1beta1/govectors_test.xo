  gv_queue(f, "{\"consentArtifacts\":[{\"consentContentVersion\":\"s-consentcontentversion\",\"guardianSignature\":{\"signatureTime\":\"s-signaturetime\",\"userId\":\"s-userid\"},\"metadata\":{\"k1\":\"s-metadata\"},\"name\":\"s-name\",\"userId\":\"s-userid\",\"userSignature\":{\"signatureTime\":\"s-signaturetime\",\"userId\":\"s-userid\"},\"witnessSignature\":{\"signatureTime\":\"s-signaturetime\",\"userId\":\"s-userid\"}}]}")
  gv_note(f, "CALL healthcare.projects.locations.datasets.consentStores.consentArtifacts.list pages")
