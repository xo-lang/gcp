  gv_set(f, "{\"annotationStores\":[{\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"annotationStores\":[{\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\"}]}")
  gv_note(f, "CALL healthcare.projects.locations.datasets.annotationStores.list pages")
  var p = svc.projects.locations.datasets.annotation_stores.list_pages("id1/ x", options: ProjectsLocationsDatasetsAnnotationStoresListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
