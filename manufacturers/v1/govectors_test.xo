test "Go's manufacturers.accounts.products.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"products\":[{\"attributes\":{\"ageGroup\":\"s-agegroup\",\"brand\":\"s-brand\",\"color\":\"s-color\",\"description\":\"s-description\",\"disclosureDate\":\"s-disclosuredate\",\"flavor\":\"s-flavor\",\"format\":\"s-format\",\"gender\":\"s-gender\",\"itemGroupId\":\"s-itemgroupid\",\"material\":\"s-material\",\"mpn\":\"s-mpn\",\"pattern\":\"s-pattern\",\"productLine\":\"s-productline\",\"productName\":\"s-productname\",\"productPageUrl\":\"s-productpageurl\",\"releaseDate\":\"s-releasedate\",\"scent\":\"s-scent\",\"size\":\"s-size\",\"sizeSystem\":\"s-sizesystem\",\"targetClientId\":\"s-targetclientid\",\"theme\":\"s-theme\",\"title\":\"s-title\",\"virtualModelLink\":\"s-virtualmodellink\"},\"contentLanguage\":\"s-contentlanguage\",\"feedLabel\":\"s-feedlabel\",\"name\":\"s-name\",\"parent\":\"s-parent\",\"productId\":\"s-productid\",\"targetCountry\":\"s-targetcountry\"}]}")
  gv_queue(f, "{\"products\":[{\"attributes\":{\"ageGroup\":\"s-agegroup\",\"brand\":\"s-brand\",\"color\":\"s-color\",\"description\":\"s-description\",\"disclosureDate\":\"s-disclosuredate\",\"flavor\":\"s-flavor\",\"format\":\"s-format\",\"gender\":\"s-gender\",\"itemGroupId\":\"s-itemgroupid\",\"material\":\"s-material\",\"mpn\":\"s-mpn\",\"pattern\":\"s-pattern\",\"productLine\":\"s-productline\",\"productName\":\"s-productname\",\"productPageUrl\":\"s-productpageurl\",\"releaseDate\":\"s-releasedate\",\"scent\":\"s-scent\",\"size\":\"s-size\",\"sizeSystem\":\"s-sizesystem\",\"targetClientId\":\"s-targetclientid\",\"theme\":\"s-theme\",\"title\":\"s-title\",\"virtualModelLink\":\"s-virtualmodellink\"},\"contentLanguage\":\"s-contentlanguage\",\"feedLabel\":\"s-feedlabel\",\"name\":\"s-name\",\"parent\":\"s-parent\",\"productId\":\"s-productid\",\"targetCountry\":\"s-targetcountry\"}]}")
  gv_note(f, "CALL manufacturers.accounts.products.list pages")
  var p = svc.accounts.products.list_pages("id1/ x", options: AccountsProductsListOptions{include: ["s-include"], page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_8)
}

