test "Go's manufacturers.accounts.languages.productCertifications.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"productCertifications\":[{\"brand\":\"s-brand\",\"countryCode\":[\"s-countrycode\"],\"mpn\":[\"s-mpn\"],\"name\":\"s-name\",\"productCode\":[\"s-productcode\"],\"productType\":[\"s-producttype\"],\"title\":\"s-title\"}]}")
  gv_queue(f, "{\"productCertifications\":[{\"brand\":\"s-brand\",\"countryCode\":[\"s-countrycode\"],\"mpn\":[\"s-mpn\"],\"name\":\"s-name\",\"productCode\":[\"s-productcode\"],\"productType\":[\"s-producttype\"],\"title\":\"s-title\"}]}")
  gv_note(f, "CALL manufacturers.accounts.languages.productCertifications.list pages")
  var p = svc.accounts.languages.product_certifications.list_pages("id1/ x", options: AccountsLanguagesProductCertificationsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_3)
}

