:\"s-unit\"},\"folateDailyPercentage\":1.5,\"folateFolicAcid\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"folateMcgDfe\":1.5,\"iron\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"ironDailyPercentage\":1.5,\"monounsaturatedFat\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"nutritionFactMeasure\":\"s-nutritionfactmeasure\",\"polyols\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"polyunsaturatedFat\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"potassium\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"potassiumDailyPercentage\":1.5,\"preparedSizeDescription\":\"s-preparedsizedescription\",\"protein\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"proteinDailyPercentage\":1.5,\"saturatedFat\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"saturatedFatDailyPercentage\":1.5,\"servingSizeDescription\":\"s-servingsizedescription\",\"servingSizeMeasure\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"servingsPerContainer\":\"s-servingspercontainer\",\"sodium\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"sodiumDailyPercentage\":1.5,\"starch\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"totalCarbohydrate\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"totalCarbohydrateDailyPercentage\":1.5,\"totalFat\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"totalFatDailyPercentage\":1.5,\"totalSugars\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"totalSugarsDailyPercentage\":1.5,\"transFat\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"transFatDailyPercentage\":1.5,\"vitaminD\":{\"amount\":1.5,\"unit\":\"s-unit\"},\"vitaminDDailyPercentage\":1.5,\"voluntaryNutritionFact\":[{\"dailyPercentage\":1.5,\"name\":\"s-name\"}]},\"pattern\":\"s-pattern\",\"productDetail\":[{\"attributeName\":\"s-attributename\",\"attributeValue\":\"s-attributevalue\",\"sectionName\":\"s-sectionname\"}],\"productHighlight\":[\"s-producthighlight\"],\"productLine\":\"s-productline\",\"productName\":\"s-productname\",\"productPageUrl\":\"s-productpageurl\",\"productType\":[\"s-producttype\"],\"releaseDate\":\"s-releasedate\",\"richProductContent\":[\"s-richproductcontent\"],\"scent\":\"s-scent\",\"size\":\"s-size\",\"sizeSystem\":\"s-sizesystem\",\"sizeType\":[\"s-sizetype\"],\"suggestedRetailPrice\":{\"amount\":\"s-amount\",\"currency\":\"s-currency\"},\"targetClientId\":\"s-targetclientid\",\"theme\":\"s-theme\",\"title\":\"s-title\",\"videoLink\":[\"s-videolink\"],\"virtualModelLink\":\"s-virtualmodellink\"}") ?? e => fault(e.display()), options: AccountsProductsUpdateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
