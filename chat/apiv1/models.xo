  pub card as "card,omitempty": GoogleAppsCardV1Card? = None
  /// An add-on triggers this action when the action needs to open a link. This differs from the `open_link` above in that this needs to talk to server to get the link. Thus some preparation work is required for web client to do before the open link action response comes back. [Google Workspace add-ons](https://developers.google.com/workspace/add-ons):
  pub open_dynamic_link_action as "openDynamicLinkAction,omitempty": GoogleAppsCardV1Action? = None
  /// If specified, this `onClick` triggers an open link action.
  pub open_link as "openLink,omitempty": GoogleAppsCardV1OpenLink? = None
  /// If specified, this `onClick` opens an overflow menu.
  pub overflow_menu as "overflowMenu,omitempty": GoogleAppsCardV1OverflowMenu? = None
} derive Json

/// GoogleAppsCardV1OpenLink: Represents an `onClick` event that opens a hyperlink. [Google Workspace add-ons and Chat apps](https://developers.google.com/workspace/extend):
pub struct GoogleAppsCardV1OpenLink {
