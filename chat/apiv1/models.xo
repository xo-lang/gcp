  pub on_close as "onClose,omitempty": Str = ""
  /// How to open a link. [Google Workspace add-ons](https://developers.google.com/workspace/add-ons):
  pub open_as as "openAs,omitempty": Str = ""
  /// The URL to open. HTTP URLs are converted to HTTPS.
  pub url as "url,omitempty": Str = ""
} derive Json

/// GoogleAppsCardV1OverflowMenu: A widget that presents a pop-up menu with one or more actions that users can invoke. For example, showing non-primary actions in a card. You can use this widget when actions don't fit in the available space. To use, specify this widget in the `OnClick` action of widgets that support it. For example, in a `Button`. [Google Workspace add-ons and Chat apps](https://developers.google.com/workspace/extend):
pub struct GoogleAppsCardV1OverflowMenu {
  /// Required. The list of menu options.
  pub items as "items,omitempty": List[GoogleAppsCardV1OverflowMenuItem] = []
} derive Json

/// GoogleAppsCardV1OverflowMenuItem: An option that users can invoke in an overflow menu. [Google Workspace add-ons and Chat apps](https://developers.google.com/workspace/extend):
pub struct GoogleAppsCardV1OverflowMenuItem {
  /// Whether the menu option is disabled. Defaults to false.
  pub disabled as "disabled,omitempty": Bool = false
  /// Required. The action invoked when a menu option is selected. This `OnClick` cannot contain an `OverflowMenu`, any specified `OverflowMenu` is dropped and the menu item disabled.
  pub on_click as "onClick,omitempty": GoogleAppsCardV1OnClick? = None
  /// The icon displayed in front of the text.
  pub start_icon as "startIcon,omitempty": GoogleAppsCardV1Icon? = None
  /// Required. The text that identifies or describes the item to users.
  pub text as "text,omitempty": Str = ""
} derive Json

/// GoogleAppsCardV1PlatformDataSource: For a `SelectionInput` widget that uses a multiselect menu, a data source from Google Workspace. Used to populate items in a multiselect menu. [Google Chat apps](https://developers.google.com/workspace/chat):
