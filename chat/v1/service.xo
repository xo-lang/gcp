/// SpacesSearchPages: the pages of SpacesService.search (Go's Pages).
/// Call next_page while more() is true.
pub struct SpacesSearchPages[fx: Effects] {
  r: SpacesService[fx]
  options: SpacesSearchOptions
  next_token: Str = ""
  started: Bool = false
}

/// search_pages: SpacesService.search's pages, from the first.
pub fn (r: SpacesService[fx]) search_pages(options: SpacesSearchOptions = SpacesSearchOptions{}) -> SpacesSearchPages[fx] {
  SpacesSearchPages{r: r, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: SpacesSearchPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: SpacesSearchPages[fx]) next_page() -> SearchSpacesResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.search(o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

