test "Go's chat.spaces.messages.delete" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{}")
  gv_note(f, "CALL chat.spaces.messages.delete")
  match svc.spaces.messages.delete("id1/ x", options: SpacesMessagesDeleteOptions{force: Some(true), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_34)
}

