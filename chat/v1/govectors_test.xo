test "Go's chat.spaces.members.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"memberships\":[{\"affiliation\":\"s-affiliation\",\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"groupMember\":{\"name\":\"s-name\"},\"member\":{\"avatarUrl\":\"s-avatarurl\",\"displayName\":\"s-displayname\",\"domainId\":\"s-domainid\",\"email\":\"s-email\",\"isAnonymous\":true,\"name\":\"s-name\",\"type\":\"s-type\"},\"name\":\"s-name\",\"role\":\"s-role\",\"state\":\"s-state\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"memberships\":[{\"affiliation\":\"s-affiliation\",\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"groupMember\":{\"name\":\"s-name\"},\"member\":{\"avatarUrl\":\"s-avatarurl\",\"displayName\":\"s-displayname\",\"domainId\":\"s-domainid\",\"email\":\"s-email\",\"isAnonymous\":true,\"name\":\"s-name\",\"type\":\"s-type\"},\"name\":\"s-name\",\"role\":\"s-role\",\"state\":\"s-state\"}]}")
  gv_note(f, "CALL chat.spaces.members.list pages")
  var p = svc.spaces.members.list_pages("id1/ x", options: SpacesMembersListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), show_groups: Some(true), show_invited: Some(true), use_admin_access: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_27)
}

