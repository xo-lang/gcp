test "Go's chat.spaces.search pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"results\":[{\"space\":{\"adminInstalled\":true,\"createTime\":\"s-createtime\",\"customer\":\"s-customer\",\"displayName\":\"s-displayname\",\"externalUserAllowed\":true,\"importMode\":true,\"importModeExpireTime\":\"s-importmodeexpiretime\",\"lastActiveTime\":\"s-lastactivetime\",\"name\":\"s-name\",\"predefinedPermissionSettings\":\"s-predefinedpermissionsettings\",\"singleUserBotDm\":true,\"spaceHistoryState\":\"s-spacehistorystate\",\"spaceThreadingState\":\"s-spacethreadingstate\",\"spaceType\":\"s-spacetype\",\"spaceUri\":\"s-spaceuri\",\"threaded\":true,\"type\":\"s-type\"}}],\"spaces\":[{\"accessSettings\":{\"accessState\":\"s-accessstate\",\"audience\":\"s-audience\"},\"adminInstalled\":true,\"createTime\":\"s-createtime\",\"customer\":\"s-customer\",\"displayName\":\"s-displayname\",\"externalUserAllowed\":true,\"importMode\":true,\"importModeExpireTime\":\"s-importmodeexpiretime\",\"lastActiveTime\":\"s-lastactivetime\",\"membershipCount\":{\"joinedDirectHumanUserCount\":7,\"joinedGroupCount\":7},\"name\":\"s-name\",\"permissionSettings\":{},\"predefinedPermissionSettings\":\"s-predefinedpermissionsettings\",\"singleUserBotDm\":true,\"spaceDetails\":{\"description\":\"s-description\",\"guidelines\":\"s-guidelines\"},\"spaceHistoryState\":\"s-spacehistorystate\",\"spaceThreadingState\":\"s-spacethreadingstate\",\"spaceType\":\"s-spacetype\",\"spaceUri\":\"s-spaceuri\",\"threaded\":true,\"type\":\"s-type\"}],\"totalSize\":7}")
  gv_queue(f, "{\"results\":[{\"space\":{\"adminInstalled\":true,\"createTime\":\"s-createtime\",\"customer\":\"s-customer\",\"displayName\":\"s-displayname\",\"externalUserAllowed\":true,\"importMode\":true,\"importModeExpireTime\":\"s-importmodeexpiretime\",\"lastActiveTime\":\"s-lastactivetime\",\"name\":\"s-name\",\"predefinedPermissionSettings\":\"s-predefinedpermissionsettings\",\"singleUserBotDm\":true,\"spaceHistoryState\":\"s-spacehistorystate\",\"spaceThreadingState\":\"s-spacethreadingstate\",\"spaceType\":\"s-spacetype\",\"spaceUri\":\"s-spaceuri\",\"threaded\":true,\"type\":\"s-type\"}}],\"spaces\":[{\"accessSettings\":{\"accessState\":\"s-accessstate\",\"audience\":\"s-audience\"},\"adminInstalled\":true,\"createTime\":\"s-createtime\",\"customer\":\"s-customer\",\"displayName\":\"s-displayname\",\"externalUserAllowed\":true,\"importMode\":true,\"importModeExpireTime\":\"s-importmodeexpiretime\",\"lastActiveTime\":\"s-lastactivetime\",\"membershipCount\":{\"joinedDirectHumanUserCount\":7,\"joinedGroupCount\":7},\"name\":\"s-name\",\"permissionSettings\":{},\"predefinedPermissionSettings\":\"s-predefinedpermissionsettings\",\"singleUserBotDm\":true,\"spaceDetails\":{\"description\":\"s-description\",\"guidelines\":\"s-guidelines\"},\"spaceHistoryState\":\"s-spacehistorystate\",\"spaceThreadingState\":\"s-spacethreadingstate\",\"spaceType\":\"s-spacetype\",\"spaceUri\":\"s-spaceuri\",\"threaded\":true,\"type\":\"s-type\"}],\"totalSize\":7}")
  gv_note(f, "CALL chat.spaces.search pages")
  var p = svc.spaces.search_pages(options: SpacesSearchOptions{order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), query: Some("s-query"), use_admin_access: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_21)
}

