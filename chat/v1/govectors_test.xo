test "Go's chat.spaces.messages.search pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"results\":[{\"message\":{\"argumentText\":\"s-argumenttext\",\"clientAssignedMessageId\":\"s-clientassignedmessageid\",\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"fallbackText\":\"s-fallbacktext\",\"formattedText\":\"s-formattedtext\",\"lastUpdateTime\":\"s-lastupdatetime\",\"markupSyntax\":\"s-markupsyntax\",\"name\":\"s-name\",\"silent\":true,\"text\":\"s-text\",\"threadReply\":true},\"read\":true,\"spaceMuteSetting\":\"s-spacemutesetting\"}]}")
  gv_queue(f, "{\"results\":[{\"message\":{\"argumentText\":\"s-argumenttext\",\"clientAssignedMessageId\":\"s-clientassignedmessageid\",\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"fallbackText\":\"s-fallbacktext\",\"formattedText\":\"s-formattedtext\",\"lastUpdateTime\":\"s-lastupdatetime\",\"markupSyntax\":\"s-markupsyntax\",\"name\":\"s-name\",\"silent\":true,\"text\":\"s-text\",\"threadReply\":true},\"read\":true,\"spaceMuteSetting\":\"s-spacemutesetting\"}]}")
  gv_note(f, "CALL chat.spaces.messages.search pages")
  var p = svc.spaces.messages.search_pages("id1/ x", json.decode_str[SearchMessagesRequest]("{\"filter\":\"s-filter\",\"markupSyntax\":\"s-markupsyntax\",\"orderBy\":\"s-orderby\",\"pageSize\":7,\"pageToken\":\"s-pagetoken\",\"view\":\"s-view\"}") ?? e => fault(e.display()), options: SpacesMessagesSearchOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_41)
}

