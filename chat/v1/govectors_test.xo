test "Go's chat.spaces.messages.reactions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"reactions\":[{\"emoji\":{\"unicode\":\"s-unicode\"},\"name\":\"s-name\",\"user\":{\"avatarUrl\":\"s-avatarurl\",\"displayName\":\"s-displayname\",\"domainId\":\"s-domainid\",\"email\":\"s-email\",\"isAnonymous\":true,\"name\":\"s-name\",\"type\":\"s-type\"}}]}")
  gv_queue(f, "{\"reactions\":[{\"emoji\":{\"unicode\":\"s-unicode\"},\"name\":\"s-name\",\"user\":{\"avatarUrl\":\"s-avatarurl\",\"displayName\":\"s-displayname\",\"domainId\":\"s-domainid\",\"email\":\"s-email\",\"isAnonymous\":true,\"name\":\"s-name\",\"type\":\"s-type\"}}]}")
  gv_note(f, "CALL chat.spaces.messages.reactions.list pages")
  var p = svc.spaces.messages.reactions.list_pages("id1/ x", options: SpacesMessagesReactionsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_47)
}

