  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"customEmojis\":[{\"emojiName\":\"s-emojiname\",\"name\":\"s-name\",\"payload\":{\"fileContent\":\"YWI=\",\"filename\":\"s-filename\"},\"temporaryImageUri\":\"s-temporaryimageuri\",\"uid\":\"s-uid\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"customEmojis\":[{\"emojiName\":\"s-emojiname\",\"name\":\"s-name\",\"payload\":{\"fileContent\":\"YWI=\",\"filename\":\"s-filename\"},\"temporaryImageUri\":\"s-temporaryimageuri\",\"uid\":\"s-uid\"}]}")
  gv_note(f, "CALL chat.customEmojis.list pages")
  var p = svc.custom_emojis.list_pages(options: CustomEmojisListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
