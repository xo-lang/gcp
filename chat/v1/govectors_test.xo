  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"spaces\":[{\"accessSettings\":{\"accessState\":\"s-accessstate\",\"audience\":\"s-audience\"},\"adminInstalled\":true,\"createTime\":\"s-createtime\",\"customer\":\"s-customer\",\"displayName\":\"s-displayname\",\"externalUserAllowed\":true,\"importMode\":true,\"importModeExpireTime\":\"s-importmodeexpiretime\",\"lastActiveTime\":\"s-lastactivetime\",\"membershipCount\":{\"joinedDirectHumanUserCount\":7,\"joinedGroupCount\":7},\"name\":\"s-name\",\"permissionSettings\":{},\"predefinedPermissionSettings\":\"s-predefinedpermissionsettings\",\"singleUserBotDm\":true,\"spaceDetails\":{\"description\":\"s-description\",\"guidelines\":\"s-guidelines\"},\"spaceHistoryState\":\"s-spacehistorystate\",\"spaceThreadingState\":\"s-spacethreadingstate\",\"spaceType\":\"s-spacetype\",\"spaceUri\":\"s-spaceuri\",\"threaded\":true,\"type\":\"s-type\"}]}")
  gv_queue(f, "{\"spaces\":[{\"accessSettings\":{\"accessState\":\"s-accessstate\",\"audience\":\"s-audience\"},\"adminInstalled\":true,\"createTime\":\"s-createtime\",\"customer\":\"s-customer\",\"displayName\":\"s-displayname\",\"externalUserAllowed\":true,\"importMode\":true,\"importModeExpireTime\":\"s-importmodeexpiretime\",\"lastActiveTime\":\"s-lastactivetime\",\"membershipCount\":{\"joinedDirectHumanUserCount\":7,\"joinedGroupCount\":7},\"name\":\"s-name\",\"permissionSettings\":{},\"predefinedPermissionSettings\":\"s-predefinedpermissionsettings\",\"singleUserBotDm\":true,\"spaceDetails\":{\"description\":\"s-description\",\"guidelines\":\"s-guidelines\"},\"spaceHistoryState\":\"s-spacehistorystate\",\"spaceThreadingState\":\"s-spacethreadingstate\",\"spaceType\":\"s-spacetype\",\"spaceUri\":\"s-spaceuri\",\"threaded\":true,\"type\":\"s-type\"}]}")
  gv_note(f, "CALL chat.spaces.findGroupChats pages")
  var p = svc.spaces.find_group_chats_pages(options: SpacesFindGroupChatsOptions{page_size: Some(7), page_token: Some("s-pagetoken"), space_view: Some("s-spaceview"), users: ["s-users"], fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
