  gv_queue(f, "{\"messages\":[{\"actionResponse\":{\"type\":\"s-type\",\"url\":\"s-url\"},\"argumentText\":\"s-argumenttext\",\"clientAssignedMessageId\":\"s-clientassignedmessageid\",\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"deletionMetadata\":{\"deletionType\":\"s-deletiontype\"},\"elements\":{},\"fallbackText\":\"s-fallbacktext\",\"formattedText\":\"s-formattedtext\",\"lastUpdateTime\":\"s-lastupdatetime\",\"markupSyntax\":\"s-markupsyntax\",\"matchedUrl\":{\"url\":\"s-url\"},\"name\":\"s-name\",\"privateMessageViewer\":{\"avatarUrl\":\"s-avatarurl\",\"displayName\":\"s-displayname\",\"domainId\":\"s-domainid\",\"email\":\"s-email\",\"isAnonymous\":true,\"name\":\"s-name\",\"type\":\"s-type\"},\"quotedMessageMetadata\":{\"lastUpdateTime\":\"s-lastupdatetime\",\"name\":\"s-name\",\"quoteType\":\"s-quotetype\"},\"sender\":{\"avatarUrl\":\"s-avatarurl\",\"displayName\":\"s-displayname\",\"domainId\":\"s-domainid\",\"email\":\"s-email\",\"isAnonymous\":true,\"name\":\"s-name\",\"type\":\"s-type\"},\"silent\":true,\"slashCommand\":{\"commandId\":\"7\"},\"space\":{\"adminInstalled\":true,\"createTime\":\"s-createtime\",\"customer\":\"s-customer\",\"displayName\":\"s-displayname\",\"externalUserAllowed\":true,\"importMode\":true,\"importModeExpireTime\":\"s-importmodeexpiretime\",\"lastActiveTime\":\"s-lastactivetime\",\"name\":\"s-name\",\"predefinedPermissionSettings\":\"s-predefinedpermissionsettings\",\"singleUserBotDm\":true,\"spaceHistoryState\":\"s-spacehistorystate\",\"spaceThreadingState\":\"s-spacethreadingstate\",\"spaceType\":\"s-spacetype\",\"spaceUri\":\"s-spaceuri\",\"threaded\":true,\"type\":\"s-type\"},\"text\":\"s-text\",\"thread\":{\"name\":\"s-name\",\"threadKey\":\"s-threadkey\"},\"threadReply\":true}]}")
  gv_note(f, "CALL chat.spaces.messages.list pages")
  var p = svc.spaces.messages.list_pages("id1/ x", options: SpacesMessagesListOptions{filter: Some("s-filter"), markup_syntax: Some("s-markupsyntax"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), show_deleted: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_37)
}

