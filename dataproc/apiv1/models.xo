/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: YarnApplication) body_mark(v: json.Value) -> json.Value {
  var o = v
  gensupport.mark(o, m.force_send_fields.map(yarn_application_field_entry), m.null_fields.map(yarn_application_field_entry))
}
