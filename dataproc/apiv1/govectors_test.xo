  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"sparkApplications\":[{\"application\":{\"applicationContextIngestionStatus\":\"s-applicationcontextingestionstatus\",\"applicationId\":\"s-applicationid\",\"coresGranted\":7,\"coresPerExecutor\":7,\"maxCores\":7,\"memoryPerExecutorMb\":7,\"name\":\"s-name\",\"quantileDataStatus\":\"s-quantiledatastatus\"},\"name\":\"s-name\"}]}")
  gv_queue(f, "{\"sparkApplications\":[{\"application\":{\"applicationContextIngestionStatus\":\"s-applicationcontextingestionstatus\",\"applicationId\":\"s-applicationid\",\"coresGranted\":7,\"coresPerExecutor\":7,\"maxCores\":7,\"memoryPerExecutorMb\":7,\"name\":\"s-name\",\"quantileDataStatus\":\"s-quantiledatastatus\"},\"name\":\"s-name\"}]}")
