  gv_queue(f, "{\"sessions\":[{\"createTime\":\"s-createtime\",\"creator\":\"s-creator\",\"environmentConfig\":{},\"jupyterSession\":{\"displayName\":\"s-displayname\",\"kernel\":\"s-kernel\"},\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"runtimeConfig\":{\"cohort\":\"s-cohort\",\"containerImage\":\"s-containerimage\",\"version\":\"s-version\"},\"runtimeInfo\":{\"diagnosticOutputUri\":\"s-diagnosticoutputuri\",\"outputUri\":\"s-outputuri\"},\"sessionTemplate\":\"s-sessiontemplate\",\"sparkConnectSession\":{},\"state\":\"s-state\",\"stateMessage\":\"s-statemessage\",\"stateTime\":\"s-statetime\",\"user\":\"s-user\",\"uuid\":\"s-uuid\"}]}")
