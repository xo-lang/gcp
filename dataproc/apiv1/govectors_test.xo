  var p = svc.projects.locations.batches.spark_applications.search_pages("id1/ x", options: ProjectsLocationsBatchesSparkApplicationsSearchOptions{application_status: Some("s-applicationstatus"), max_end_time: Some("s-maxendtime"), max_time: Some("s-maxtime"), min_end_time: Some("s-minendtime"), min_time: Some("s-mintime"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
