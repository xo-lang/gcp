  gv_note(f, "CALL dataproc.projects.regions.workflowTemplates.update")
  match svc.projects.regions.workflow_templates.update("id1/ x", json.decode_str[WorkflowTemplate]("{\"createTime\":\"s-createtime\",\"dagTimeout\":\"s-dagtimeout\",\"encryptionConfig\":{\"kmsKey\":\"s-kmskey\"},\"id\":\"s-id\",\"jobs\":[{\"flinkJob\":{\"mainClass\":\"s-mainclass\",\"mainJarFileUri\":\"s-mainjarfileuri\",\"savepointUri\":\"s-savepointuri\"},\"hadoopJob\":{\"mainClass\":\"s-mainclass\",\"mainJarFileUri\":\"s-mainjarfileuri\"},\"hiveJob\":{\"continueOnFailure\":true,\"queryFileUri\":\"s-queryfileuri\"},\"labels\":{\"k1\":\"s-labels\"},\"pigJob\":{\"continueOnFailure\":true,\"queryFileUri\":\"s-queryfileuri\"},\"prerequisiteStepIds\":[\"s-prerequisitestepids\"],\"prestoJob\":{\"continueOnFailure\":true,\"outputFormat\":\"s-outputformat\",\"queryFileUri\":\"s-queryfileuri\"},\"pysparkJob\":{\"mainPythonFileUri\":\"s-mainpythonfileuri\"},\"scheduling\":{\"maxFailuresPerHour\":7,\"maxFailuresTotal\":7},\"sparkJob\":{\"mainClass\":\"s-mainclass\",\"mainJarFileUri\":\"s-mainjarfileuri\"},\"sparkRJob\":{\"mainRFileUri\":\"s-mainrfileuri\"},\"sparkSqlJob\":{\"queryFileUri\":\"s-queryfileuri\"},\"stepId\":\"s-stepid\",\"trinoJob\":{\"continueOnFailure\":true,\"outputFormat\":\"s-outputformat\",\"queryFileUri\":\"s-queryfileuri\"}}],\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"parameters\":[{\"description\":\"s-description\",\"fields\":[\"s-fields\"],\"name\":\"s-name\",\"validation\":{}}],\"placement\":{\"clusterSelector\":{\"clusterLabels\":{\"k1\":\"s-clusterlabels\"},\"zone\":\"s-zone\"},\"managedCluster\":{\"clusterName\":\"s-clustername\",\"labels\":{\"k1\":\"s-labels\"}}},\"updateTime\":\"s-updatetime\",\"version\":7}") ?? e => fault(e.display()), options: ProjectsRegionsWorkflowTemplatesUpdateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
