  gv_queue(f, "{\"sessionTemplates\":[{\"createTime\":\"s-createtime\",\"creator\":\"s-creator\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"environmentConfig\":{},\"jupyterSession\":{\"displayName\":\"s-displayname\",\"kernel\":\"s-kernel\"},\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"runtimeConfig\":{\"cohort\":\"s-cohort\",\"containerImage\":\"s-containerimage\",\"version\":\"s-version\"},\"sparkConnectSession\":{},\"updateTime\":\"s-updatetime\",\"uuid\":\"s-uuid\"}]}")
