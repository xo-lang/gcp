  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"clusters\":[{\"clusterName\":\"s-clustername\",\"clusterUuid\":\"s-clusteruuid\",\"config\":{\"clusterTier\":\"s-clustertier\",\"clusterType\":\"s-clustertype\",\"configBucket\":\"s-configbucket\",\"diagnosticBucket\":\"s-diagnosticbucket\",\"engine\":\"s-engine\",\"tempBucket\":\"s-tempbucket\"},\"labels\":{\"k1\":\"s-labels\"},\"metrics\":{},\"projectId\":\"s-projectid\",\"status\":{\"detail\":\"s-detail\",\"state\":\"s-state\",\"stateStartTime\":\"s-statestarttime\",\"substate\":\"s-substate\"},\"virtualClusterConfig\":{\"stagingBucket\":\"s-stagingbucket\"}}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"clusters\":[{\"clusterName\":\"s-clustername\",\"clusterUuid\":\"s-clusteruuid\",\"config\":{\"clusterTier\":\"s-clustertier\",\"clusterType\":\"s-clustertype\",\"configBucket\":\"s-configbucket\",\"diagnosticBucket\":\"s-diagnosticbucket\",\"engine\":\"s-engine\",\"tempBucket\":\"s-tempbucket\"},\"labels\":{\"k1\":\"s-labels\"},\"metrics\":{},\"projectId\":\"s-projectid\",\"status\":{\"detail\":\"s-detail\",\"state\":\"s-state\",\"stateStartTime\":\"s-statestarttime\",\"substate\":\"s-substate\"},\"virtualClusterConfig\":{\"stagingBucket\":\"s-stagingbucket\"}}]}")
