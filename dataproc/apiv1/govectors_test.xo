  gv_queue(f, "{\"batches\":[{\"createTime\":\"s-createtime\",\"creator\":\"s-creator\",\"environmentConfig\":{},\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"operation\":\"s-operation\",\"pysparkBatch\":{\"mainPythonFileUri\":\"s-mainpythonfileuri\"},\"pysparkNotebookBatch\":{\"notebookFileUri\":\"s-notebookfileuri\"},\"runtimeConfig\":{\"cohort\":\"s-cohort\",\"containerImage\":\"s-containerimage\",\"version\":\"s-version\"},\"runtimeInfo\":{\"diagnosticOutputUri\":\"s-diagnosticoutputuri\",\"outputUri\":\"s-outputuri\"},\"sparkBatch\":{\"mainClass\":\"s-mainclass\",\"mainJarFileUri\":\"s-mainjarfileuri\"},\"sparkRBatch\":{\"mainRFileUri\":\"s-mainrfileuri\"},\"sparkSqlBatch\":{\"queryFileUri\":\"s-queryfileuri\"},\"state\":\"s-state\",\"stateMessage\":\"s-statemessage\",\"stateTime\":\"s-statetime\",\"uuid\":\"s-uuid\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL dataproc.projects.locations.batches.list pages")
