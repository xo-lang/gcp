test "Go's dataproc.projects.regions.workflowTemplates.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"templates\":[{\"createTime\":\"s-createtime\",\"dagTimeout\":\"s-dagtimeout\",\"id\":\"s-id\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"placement\":{},\"updateTime\":\"s-updatetime\",\"version\":7}]}")
  gv_queue(f, "{\"templates\":[{\"createTime\":\"s-createtime\",\"dagTimeout\":\"s-dagtimeout\",\"id\":\"s-id\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"placement\":{},\"updateTime\":\"s-updatetime\",\"version\":7}]}")
  gv_note(f, "CALL dataproc.projects.regions.workflowTemplates.list pages")
  var p = svc.projects.regions.workflow_templates.list_pages("id1/ x", options: ProjectsRegionsWorkflowTemplatesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_68)
}

