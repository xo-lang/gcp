  gv_queue(f, "{\"jobs\":[{\"done\":true,\"driverControlFilesUri\":\"s-drivercontrolfilesuri\",\"driverOutputResourceUri\":\"s-driveroutputresourceuri\",\"hadoopJob\":{\"mainClass\":\"s-mainclass\",\"mainJarFileUri\":\"s-mainjarfileuri\"},\"hiveJob\":{\"continueOnFailure\":true,\"queryFileUri\":\"s-queryfileuri\"},\"jobUuid\":\"s-jobuuid\",\"labels\":{\"k1\":\"s-labels\"},\"pigJob\":{\"continueOnFailure\":true,\"queryFileUri\":\"s-queryfileuri\"},\"placement\":{\"clusterName\":\"s-clustername\",\"clusterUuid\":\"s-clusteruuid\"},\"prestoJob\":{\"continueOnFailure\":true,\"outputFormat\":\"s-outputformat\",\"queryFileUri\":\"s-queryfileuri\"},\"pysparkJob\":{\"mainPythonFileUri\":\"s-mainpythonfileuri\"},\"reference\":{\"jobId\":\"s-jobid\",\"projectId\":\"s-projectid\"},\"scheduling\":{\"maxFailuresPerHour\":7,\"maxFailuresTotal\":7},\"sparkJob\":{\"mainClass\":\"s-mainclass\",\"mainJarFileUri\":\"s-mainjarfileuri\"},\"sparkRJob\":{\"mainRFileUri\":\"s-mainrfileuri\"},\"sparkSqlJob\":{\"queryFileUri\":\"s-queryfileuri\"},\"status\":{\"details\":\"s-details\",\"state\":\"s-state\",\"stateStartTime\":\"s-statestarttime\",\"substate\":\"s-substate\"},\"submittedBy\":\"s-submittedby\"}]}")
  gv_note(f, "CALL dataproc.projects.regions.jobs.list pages")
  var p = svc.projects.regions.jobs.list_pages("id1/ x", "id2/ x", options: ProjectsRegionsJobsListOptions{cluster_name: Some("s-clustername"), filter: Some("s-filter"), job_state_matcher: Some("s-jobstatematcher"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_47)
}

