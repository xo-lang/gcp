  match svc.projects.regions.workflow_templates.update("id1/ x", json.decode_str[WorkflowTemplate]("{\"createTime\":\"s-createtime\",\"dagTimeout\":\"s-dagtimeout\",\"id\":\"s-id\",\"jobs\":[{\"hadoopJob\":{\"mainClass\":\"s-mainclass\",\"mainJarFileUri\":\"s-mainjarfileuri\"},\"hiveJob\":{\"continueOnFailure\":true,\"queryFileUri\":\"s-queryfileuri\"},\"labels\":{\"k1\":\"s-labels\"},\"pigJob\":{\"continueOnFailure\":true,\"queryFileUri\":\"s-queryfileuri\"},\"prerequisiteStepIds\":[\"s-prerequisitestepids\"],\"prestoJob\":{\"continueOnFailure\":true,\"outputFormat\":\"s-outputformat\",\"queryFileUri\":\"s-queryfileuri\"},\"pysparkJob\":{\"mainPythonFileUri\":\"s-mainpythonfileuri\"},\"scheduling\":{\"maxFailuresPerHour\":7,\"maxFailuresTotal\":7},\"sparkJob\":{\"mainClass\":\"s-mainclass\",\"mainJarFileUri\":\"s-mainjarfileuri\"},\"sparkRJob\":{\"mainRFileUri\":\"s-mainrfileuri\"},\"sparkSqlJob\":{\"queryFileUri\":\"s-queryfileuri\"},\"stepId\":\"s-stepid\"}],\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"parameters\":[{\"description\":\"s-description\",\"fields\":[\"s-fields\"],\"name\":\"s-name\",\"validation\":{}}],\"placement\":{\"clusterSelector\":{\"clusterLabels\":{\"k1\":\"s-clusterlabels\"},\"zone\":\"s-zone\"},\"managedCluster\":{\"clusterName\":\"s-clustername\",\"labels\":{\"k1\":\"s-labels\"}}},\"updateTime\":\"s-updatetime\",\"version\":7}") ?? e => fault(e.display()), options: ProjectsRegionsWorkflowTemplatesUpdateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_71)
}
