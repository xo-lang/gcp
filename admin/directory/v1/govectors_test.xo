  gv_queue(f, "{\"etag\":\"s-etag\",\"kind\":\"s-kind\",\"trigger_event\":\"s-trigger_event\",\"users\":[{\"addresses\":{\"k\":\"v\"},\"agreedToTerms\":true,\"aliases\":[\"s-aliases\"],\"archivalTime\":\"s-archivaltime\",\"archived\":true,\"changePasswordAtNextLogin\":true,\"creationTime\":\"s-creationtime\",\"customSchemas\":{\"k1\":{\"k\":\"v\"}},\"customerId\":\"s-customerid\",\"deletionTime\":\"s-deletiontime\",\"emails\":{\"k\":\"v\"},\"etag\":\"s-etag\",\"externalIds\":{\"k\":\"v\"},\"gender\":{\"k\":\"v\"},\"guestAccountInfo\":{\"primaryGuestEmail\":\"s-primaryguestemail\"},\"hashFunction\":\"s-hashfunction\",\"id\":\"s-id\",\"ims\":{\"k\":\"v\"},\"includeInGlobalAddressList\":true,\"ipWhitelisted\":true,\"isAdmin\":true,\"isDelegatedAdmin\":true,\"isEnforcedIn2Sv\":true,\"isEnrolledIn2Sv\":true,\"isGuestUser\":true,\"isMailboxSetup\":true,\"keywords\":{\"k\":\"v\"},\"kind\":\"s-kind\",\"languages\":{\"k\":\"v\"},\"lastLoginTime\":\"s-lastlogintime\",\"locations\":{\"k\":\"v\"},\"name\":{\"displayName\":\"s-displayname\",\"familyName\":\"s-familyname\",\"fullName\":\"s-fullname\",\"givenName\":\"s-givenname\"},\"nonEditableAliases\":[\"s-noneditablealiases\"],\"notes\":{\"k\":\"v\"},\"orgUnitPath\":\"s-orgunitpath\",\"organizations\":{\"k\":\"v\"},\"password\":\"s-password\",\"phones\":{\"k\":\"v\"},\"posixAccounts\":{\"k\":\"v\"},\"primaryEmail\":\"s-primaryemail\",\"recoveryEmail\":\"s-recoveryemail\",\"recoveryPhone\":\"s-recoveryphone\",\"relations\":{\"k\":\"v\"},\"sshPublicKeys\":{\"k\":\"v\"},\"suspended\":true,\"suspensionReason\":\"s-suspensionreason\",\"suspensionTime\":\"s-suspensiontime\",\"thumbnailPhotoEtag\":\"s-thumbnailphotoetag\",\"thumbnailPhotoUrl\":\"s-thumbnailphotourl\",\"websites\":{\"k\":\"v\"}}]}")
  gv_note(f, "CALL directory.users.list pages")
  var p = svc.users.list_pages(options: UsersListOptions{custom_field_mask: Some("s-customfieldmask"), customer: Some("s-customer"), domain: Some("s-domain"), event: Some("s-event"), max_results: Some(7), order_by: Some("s-orderby"), page_token: Some("s-pagetoken"), projection: Some("s-projection"), query: Some("s-query"), show_deleted: Some("s-showdeleted"), sort_order: Some("s-sortorder"), view_type: Some("s-viewtype"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_123)
}

