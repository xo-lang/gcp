  match svc.users.photos.update("id1/ x", json.decode_str[UserPhoto]("{\"etag\":\"s-etag\",\"height\":7,\"id\":\"s-id\",\"kind\":\"s-kind\",\"mimeType\":\"s-mimetype\",\"photoData\":\"YWI=\",\"primaryEmail\":\"s-primaryemail\",\"width\":7}") ?? e => fault(e.display()), options: UsersPhotosUpdateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_137)
}

