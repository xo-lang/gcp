  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"buildings\":[{\"address\":{\"administrativeArea\":\"s-administrativearea\",\"languageCode\":\"s-languagecode\",\"locality\":\"s-locality\",\"postalCode\":\"s-postalcode\",\"regionCode\":\"s-regioncode\",\"sublocality\":\"s-sublocality\"},\"buildingId\":\"s-buildingid\",\"buildingName\":\"s-buildingname\",\"coordinates\":{\"latitude\":1.5,\"longitude\":1.5},\"description\":\"s-description\",\"etags\":\"s-etags\",\"floorNames\":[\"s-floornames\"],\"kind\":\"s-kind\"}],\"etag\":\"s-etag\",\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"buildings\":[{\"address\":{\"administrativeArea\":\"s-administrativearea\",\"languageCode\":\"s-languagecode\",\"locality\":\"s-locality\",\"postalCode\":\"s-postalcode\",\"regionCode\":\"s-regioncode\",\"sublocality\":\"s-sublocality\"},\"buildingId\":\"s-buildingid\",\"buildingName\":\"s-buildingname\",\"coordinates\":{\"latitude\":1.5,\"longitude\":1.5},\"description\":\"s-description\",\"etags\":\"s-etags\",\"floorNames\":[\"s-floornames\"],\"kind\":\"s-kind\"}],\"etag\":\"s-etag\",\"kind\":\"s-kind\"}")
  gv_note(f, "CALL directory.resources.buildings.list pages")
  var p = svc.resources.buildings.list_pages("id1/ x", options: ResourcesBuildingsListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_78)
}

