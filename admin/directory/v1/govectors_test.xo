test "Go's directory.members.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"kind\":\"s-kind\",\"members\":[{\"delivery_settings\":\"s-delivery_settings\",\"email\":\"s-email\",\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"role\":\"s-role\",\"status\":\"s-status\",\"type\":\"s-type\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"etag\":\"s-etag\",\"kind\":\"s-kind\",\"members\":[{\"delivery_settings\":\"s-delivery_settings\",\"email\":\"s-email\",\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"role\":\"s-role\",\"status\":\"s-status\",\"type\":\"s-type\"}]}")
  gv_note(f, "CALL directory.members.list pages")
  var p = svc.members.list_pages("id1/ x", options: MembersListOptions{include_derived_membership: Some(true), max_results: Some(7), page_token: Some("s-pagetoken"), roles: Some("s-roles"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_59)
}

