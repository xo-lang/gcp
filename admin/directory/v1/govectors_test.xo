  gv_queue(f, "{\"etag\":\"s-etag\",\"groups\":[{\"adminCreated\":true,\"aliases\":[\"s-aliases\"],\"description\":\"s-description\",\"directMembersCount\":\"7\",\"email\":\"s-email\",\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"nonEditableAliases\":[\"s-noneditablealiases\"]}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL directory.groups.list pages")
  var p = svc.groups.list_pages(options: GroupsListOptions{customer: Some("s-customer"), domain: Some("s-domain"), max_results: Some(7), order_by: Some("s-orderby"), page_token: Some("s-pagetoken"), query: Some("s-query"), sort_order: Some("s-sortorder"), user_key: Some("s-userkey"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_48)
}

