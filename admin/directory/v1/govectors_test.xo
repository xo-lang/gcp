test "Go's admin.customers.chrome.printServers.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"printServers\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"name\":\"s-name\",\"orgUnitId\":\"s-orgunitid\",\"uri\":\"s-uri\"}]}")
  gv_queue(f, "{\"printServers\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"id\":\"s-id\",\"name\":\"s-name\",\"orgUnitId\":\"s-orgunitid\",\"uri\":\"s-uri\"}]}")
  gv_note(f, "CALL admin.customers.chrome.printServers.list pages")
  var p = svc.customers.chrome.print_servers.list_pages("id1/ x", options: CustomersChromePrintServersListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), org_unit_id: Some("s-orgunitid"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_24)
}

