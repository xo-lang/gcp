test "Go's directory.resources.calendars.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"items\":[{\"buildingId\":\"s-buildingid\",\"capacity\":7,\"etags\":\"s-etags\",\"featureInstances\":{\"k\":\"v\"},\"floorName\":\"s-floorname\",\"floorSection\":\"s-floorsection\",\"generatedResourceName\":\"s-generatedresourcename\",\"kind\":\"s-kind\",\"resourceCategory\":\"s-resourcecategory\",\"resourceDescription\":\"s-resourcedescription\",\"resourceEmail\":\"s-resourceemail\",\"resourceId\":\"s-resourceid\",\"resourceName\":\"s-resourcename\",\"resourceType\":\"s-resourcetype\",\"userVisibleDescription\":\"s-uservisibledescription\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"etag\":\"s-etag\",\"items\":[{\"buildingId\":\"s-buildingid\",\"capacity\":7,\"etags\":\"s-etags\",\"featureInstances\":{\"k\":\"v\"},\"floorName\":\"s-floorname\",\"floorSection\":\"s-floorsection\",\"generatedResourceName\":\"s-generatedresourcename\",\"kind\":\"s-kind\",\"resourceCategory\":\"s-resourcecategory\",\"resourceDescription\":\"s-resourcedescription\",\"resourceEmail\":\"s-resourceemail\",\"resourceId\":\"s-resourceid\",\"resourceName\":\"s-resourcename\",\"resourceType\":\"s-resourcetype\",\"userVisibleDescription\":\"s-uservisibledescription\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL directory.resources.calendars.list pages")
  var p = svc.resources.calendars.list_pages("id1/ x", options: ResourcesCalendarsListOptions{max_results: Some(7), order_by: Some("s-orderby"), page_token: Some("s-pagetoken"), query: Some("s-query"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_85)
}

