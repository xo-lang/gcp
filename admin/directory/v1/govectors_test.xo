test "Go's directory.roles.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"items\":[{\"etag\":\"s-etag\",\"isSuperAdminRole\":true,\"isSystemRole\":true,\"kind\":\"s-kind\",\"roleDescription\":\"s-roledescription\",\"roleId\":\"7\",\"roleName\":\"s-rolename\",\"rolePrivileges\":[{\"privilegeName\":\"s-privilegename\",\"serviceId\":\"s-serviceid\"}]}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"etag\":\"s-etag\",\"items\":[{\"etag\":\"s-etag\",\"isSuperAdminRole\":true,\"isSystemRole\":true,\"kind\":\"s-kind\",\"roleDescription\":\"s-roledescription\",\"roleId\":\"7\",\"roleName\":\"s-rolename\",\"rolePrivileges\":[{\"privilegeName\":\"s-privilegename\",\"serviceId\":\"s-serviceid\"}]}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL directory.roles.list pages")
  var p = svc.roles.list_pages("id1/ x", options: RolesListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_105)
}

