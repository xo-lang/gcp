pub fn (var p: RolesListPages[fx]) next_page() -> Roles ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.customer, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

