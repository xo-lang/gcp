/// list_pages: GroupsService.list's pages, from the first.
pub fn (r: GroupsService[fx]) list_pages(options: GroupsListOptions = GroupsListOptions{}) -> GroupsListPages[fx] {
  GroupsListPages{r: r, options: options}
