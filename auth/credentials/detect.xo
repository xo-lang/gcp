// Application Default Credentials, as cloud.google.com/go/auth v0.24.4's
// credentials.DetectDefault (Apache-2.0, Copyright Google LLC;
// NOTICE.md), decision 0009 step 3.

use std/json
use github.com/xo-lang/gcp/auth
use github.com/xo-lang/gcp/compute/metadata
use github.com/xo-lang/gcp/option

/// The variable naming a credential file (Go's GoogleAppCredsEnvVar).
pub const GOOGLE_APP_CREDS_ENV: Str = "GOOGLE_APPLICATION_CREDENTIALS"
/// Where Go's error sends the reader when nothing is found.
pub const ADC_SETUP_URL: Str = "https://cloud.google.com/docs/authentication/external/set-up-adc"

/// What detect_default may read and reach.
pub struct Caps {
  pub env: Env
  pub fs: Fs
  pub net: Net
  pub clock: Clock
  pub rand: Rand
}

/// gcloud's application default credentials file (Go's
/// GetWellKnownFileName): %APPDATA%\gcloud on Windows, else
/// $HOME/.config/gcloud (the user's home directory when HOME is unset).
pub fn well_known_file(env: Env, os: TargetOs = target.os) -> Str uses env {
  let name = "application_default_credentials.json"
  if os is TargetOs.Windows {
    return "${env.get("APPDATA") ?? ""}\\gcloud\\${name}"
  }
  var home = env.get("HOME") ?? ""
  if home == "" {
    home = env.home() ?? _ => ""
  }
  "${home}/.config/gcloud/${name}"
}

struct ClientConfig {
  redirect_uris: List[Str] = []
} derive Json

struct ClientFile {
  web: ClientConfig? = None
  installed: ClientConfig? = None
} derive Json

/// Go's readCredentialsFileJSON: an OAuth client file (`web` or
/// `installed` with redirect URIs) needs an authorization handler, which
/// is not ported; anything else is a credential file.
fn read_json(c: Caps, b: Bytes, opts: DetectOptions) -> Credentials ! auth.AuthErr {
  if let Ok(f) = json.decode[ClientFile](b) {
    let cfg = f.web ?? f.installed
    if let Some(x) = cfg {
      if x.redirect_uris.len() > 0 {
        return Err(auth.AuthErr{msg: "credentials: auth handler must be specified for this credential filetype"})
      }
    }
  }
  from_json(c.net, c.clock, c.rand, b, opts)
}

fn read_file(c: Caps, path: Str, opts: DetectOptions) -> Credentials ! auth.AuthErr uses fs.read {
  let b = c.fs.read(path) ?? e => return Err(auth.AuthErr{msg: "open ${e.display()}"})
  read_json(c, b, opts)
}

/// Application Default Credentials (Go's DetectDefault), the first of:
/// `credentials_json`, `credentials_file`, the file
/// GOOGLE_APPLICATION_CREDENTIALS names, gcloud's well-known file, and,
/// on Google Cloud, the metadata server.
pub fn detect_default(c: Caps, opts: DetectOptions = DetectOptions{}) -> Credentials ! auth.AuthErr uses (env, fs.read, net.dial, clock) {
  validate(opts)?
  if opts.credentials_json.len() > 0 {
    return read_json(c, opts.credentials_json, opts)
  }
  if opts.credentials_file != "" {
    return read_file(c, opts.credentials_file, opts)
  }
  let name = c.env.get(GOOGLE_APP_CREDS_ENV) ?? ""
  if name != "" {
    return read_file(c, name, opts)
  }
  if let Ok(b) = c.fs.read(well_known_file(c.env)) {
    return read_json(c, b, opts)
  }
  if metadata.on_gce(c.env, c.fs, c.net, c.clock) {
    let m = metadata.new_client(c.env, c.net, c.clock, c.rand)
    let p = auth.compute(m, c.clock, scopes: opts.scopes, opts: auth.CachedOptions{expire_early: opts.early_token_refresh, tasks: opts.tasks})
    return Ok(new_creds(p, b"", Source.Metadata(m), Source.Metadata(m)))
  }
  Err(auth.AuthErr{msg: "credentials: could not find default credentials. See ${ADC_SETUP_URL} for more information"})
}

/// Client options that authenticate with `creds` and bill its quota
/// project, as Go's transport does with detected credentials when the
/// options name none.
pub fn client_options(creds: Credentials, env: Env, opts: option.ClientOptions[()] = option.ClientOptions{}) -> option.ClientOptions[()] uses env {
  var o = opts
  if o.credentials.is_none() {
    o.credentials = Some(creds)
  }
  if o.quota_project == "" {
    o.quota_project = creds.quota_project_id(env)
  }
  o
}
