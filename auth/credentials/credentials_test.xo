// Decision 0009 step 2 against the Go oracle's vectors (cloud.google.com/go/
// auth v0.24.4 over a fake token endpoint). The service account key is
// generated per test, so no key is kept in the repository. The fake clock
// fixes iat and exp, so the JWT claims are compared byte for byte in Go's
// field order, and each signature is checked with the key.

use std/base64
use std/crypto
use std/http
use std/json
use std/testing
use std/url
use github.com/xo-lang/gcp/auth

const T0: Int = 1800000000
const GOOD: Str = "{\"access_token\":\"access-one\",\"expires_in\":3600,\"token_type\":\"Bearer\"}"
const FAKE_URL: Str = "https://oauth2.fake/token"

struct Key {
  pem: Str
  public: crypto.PublicKey
}

fn new_key(os: testing.TestOs) -> Key uses rand {
  let k = crypto.generate_key(os.rand, crypto.KeyAlg.Rsa) ?? e => fault(e.display())
  let pem = crypto.pem_encode(crypto.PemBlock{kind: "PRIVATE KEY", headers: {}, bytes: crypto.marshal_private_key(k)}) ?? e => fault(e.display())
  Key{pem: pem, public: k.public_key()}
}

fn sa_json(k: Key, extra: Map[Str, json.Value] = {}, drop: List[Str] = []) -> Bytes {
  var m: Map[Str, json.Value] = {
    "type": json.Value.Str("service_account"),
    "project_id": json.Value.Str("project-one"),
    "private_key_id": json.Value.Str("key-one"),
    "private_key": json.Value.Str(k.pem),
    "client_email": json.Value.Str("robot@example.com"),
    "client_id": json.Value.Str("100000000000000000001"),
    "token_uri": json.Value.Str(FAKE_URL),
  }
  for (key, v) in extra {
    m.put(key, v)
  }
  for key in drop {
    m.remove(key)
  }
  json.encode(json.Value.Object(m.entries()))
}

fn au_json(extra: Map[Str, Str] = {}, drop: List[Str] = []) -> Bytes {
  var m: Map[Str, json.Value] = {
    "type": json.Value.Str("authorized_user"),
    "client_id": json.Value.Str("client-one.apps.fake"),
    "client_secret": json.Value.Str("secret-one"),
    "refresh_token": json.Value.Str("refresh-one"),
  }
  for (key, v) in extra {
    m.put(key, json.Value.Str(v))
  }
  for key in drop {
    m.remove(key)
  }
  json.encode(json.Value.Object(m.entries()))
}

/// A JWT's header and claims JSON, failing when the signature does not
/// verify with `k`.
fn jwt_parts(k: Key, tok: Str) -> (Str, Str) {
  let p = tok.split(".")
  expect(p.len()) == 3
  let h = base64.decode(p[0], base64.Base64.RawUrl) ?? e => fault(e.display())
  let c = base64.decode(p[1], base64.Base64.RawUrl) ?? e => fault(e.display())
  let sig = base64.decode(p[2], base64.Base64.RawUrl) ?? e => fault(e.display())
  expect(crypto.verify(k.public, crypto.Hash.Sha256, "${p[0]}.${p[1]}".bytes(), sig)) == true
  (h.to_str_lossy(), c.to_str_lossy())
}

/// A fake token endpoint at `u` answering `replies` in order (the last
/// repeats); each request's form is logged as sorted `key=value` lines,
/// with the assertion as its header and claims JSON.
fn endpoint(net: testing.FakeNet, k: Key?, u: Str, replies: List[(Int, Str, Str)]) -> Mutex[List[List[Str]]] {
  let log: Mutex[List[List[Str]]] = Mutex[List[List[Str]]].new([])
  let left = Mutex[List[(Int, Str, Str)]].new(replies)
  net.handle("POST ${u}", fn(req: http.Request) -> http.Response {
    let form = url.parse_query(req.body.to_str_lossy()) ?? e => fault(e.display())
    var lines: List[Str] = ["Content-Type: ${req.header("Content-Type") ?? ""}"]
    for key in form.keys().sort() {
      let v = form.get(key) ?? ""
      if key == "assertion" {
        let key_of = k ?? fault("no key for an assertion")
        let (h, c) = jwt_parts(key_of, v)
        lines.push("assertion header ${h}")
        lines.push("assertion claims ${c}")
      } else {
        lines.push("${key}=${v}")
      }
    }
    log.with(fn(var l: List[List[Str]]) { l.push(lines) })
    let r = left.with(fn(var rs: List[(Int, Str, Str)]) -> (Int, Str, Str) {
      let first = rs[0]
      if rs.len() > 1 {
        rs = rs[1..rs.len()]
      }
      first
    })
    let ct = if r.2 == "" { "application/json" } else { r.2 }
    http.Response{status: r.0, headers: {"Content-Type": ct}, body: r.1.bytes()}
  })
  log
}

fn requests(log: Mutex[List[List[Str]]]) -> List[List[Str]] {
  log.with(fn(var l: List[List[Str]]) -> List[List[Str]] { l })
}

fn start(os: testing.TestOs) {
  os.clock.set(Time.from_unix(T0))
}

fn creds(os: testing.TestOs, b: Bytes, o: DetectOptions = DetectOptions{}) -> Credentials ! auth.AuthErr {
  from_json(os.net, os.clock, os.rand, b, o)
}

fn tok(c: Credentials) -> auth.Token uses (net.dial, clock, rand) {
  c.token() ?? e => fault(e.display())
}

fn err_of(r: Result[Credentials, auth.AuthErr]) -> Str {
  match r {
    Ok(_) => "no error"
    Err(e) => e.display()
  }
}

fn token_err(c: Credentials) -> Str uses (net.dial, clock, rand) {
  match c.token() {
    Ok(_) => "no error"
    Err(e) => e.display()
  }
}

fn grant(scope: Str = "", aud: Str = FAKE_URL, sub: Str = "") -> List[Str] {
  let iat = T0 - 10
  let s = if scope == "" { "" } else { ",\"scope\":\"${scope}\"" }
  let su = if sub == "" { "" } else { ",\"sub\":\"${sub}\"" }
  [
    "Content-Type: application/x-www-form-urlencoded",
    "assertion header {\"alg\":\"RS256\",\"typ\":\"JWT\",\"kid\":\"key-one\"}",
    "assertion claims {\"iss\":\"robot@example.com\"${s},\"exp\":${iat + 3600},\"iat\":${iat},\"aud\":\"${aud}\"${su}}",
    "grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer",
  ]
}

const REFRESH: List[Str] = [
  "Content-Type: application/x-www-form-urlencoded",
  "client_id=client-one.apps.fake",
  "client_secret=secret-one",
  "grant_type=refresh_token",
  "refresh_token=refresh-one",
]

fn left_secs(os: testing.TestOs, t: auth.Token) -> Int uses clock {
  let e = t.expiry ?? return -1
  (e.unix_millis() - os.clock.now().unix_millis()) / 1000
}

test "sa_grant: the JWT bearer grant, cached, with the file's project" {
  start(os)
  let k = new_key(os)
  let log = endpoint(os.net, Some(k), FAKE_URL, [(200, GOOD, "")])
  let c = creds(os, sa_json(k), DetectOptions{scopes: ["scope-a", "scope-b"]}) ?? e => fault(e.display())
  for _ in 0..2 {
    let t = tok(c)
    expect(t.value.reveal()) == "access-one"
    expect(t.token_type) == "Bearer"
    expect(left_secs(os, t)) == 3600
  }
  expect(requests(log)) == [grant(scope: "scope-a scope-b")]
  expect(c.project_id(os.env)) == "project-one"
  expect(c.quota_project_id(os.env)) == ""
  expect(c.universe_domain()) == "googleapis.com"
}

test "sa_grant_quota and sa_grant_quota_env: the file's quota project, the variable over it" {
  start(os)
  let k = new_key(os)
  let _ = endpoint(os.net, Some(k), FAKE_URL, [(200, GOOD, "")])
  let c = creds(os, sa_json(k, extra: {"quota_project_id": json.Value.Str("quota-file")}), DetectOptions{scopes: ["scope-a"]}) ?? e => fault(e.display())
  expect(c.quota_project_id(os.env)) == "quota-file"
  os.env.set("GOOGLE_CLOUD_QUOTA_PROJECT", "quota-env")
  expect(c.quota_project_id(os.env)) == "quota-env"
}

test "a service account's project id wins over GOOGLE_CLOUD_PROJECT; a user's does not" {
  start(os)
  let k = new_key(os)
  os.env.set("GOOGLE_CLOUD_PROJECT", "project-env")
  let sa = creds(os, sa_json(k), DetectOptions{scopes: ["scope-a"]}) ?? e => fault(e.display())
  expect(sa.project_id(os.env)) == "project-one"
  let au = creds(os, au_json(extra: {"project_id": "project-file"})) ?? e => fault(e.display())
  expect(au.project_id(os.env)) == "project-env"
  os.env.set("GOOGLE_CLOUD_PROJECT", "")
  expect(au.project_id(os.env)) == "project-file"
}

test "sa_default_token_url: Google's endpoint without token_uri" {
  start(os)
  let k = new_key(os)
  let log = endpoint(os.net, Some(k), auth.GOOGLE_TOKEN_URL, [(200, GOOD, "")])
  let c = creds(os, sa_json(k, drop: ["token_uri"]), DetectOptions{scopes: ["scope-a"]}) ?? e => fault(e.display())
  let _ = tok(c)
  expect(requests(log)) == [grant(scope: "scope-a", aud: auth.GOOGLE_TOKEN_URL)]
}

test "sa_subject and sa_audience_only: sub, and an audience that leaves the grant's aud alone" {
  start(os)
  let k = new_key(os)
  let log = endpoint(os.net, Some(k), FAKE_URL, [(200, GOOD, "")])
  let _ = tok(creds(os, sa_json(k), DetectOptions{scopes: ["scope-a"], subject: "user@example.com"}) ?? e => fault(e.display()))
  let _ = tok(creds(os, sa_json(k), DetectOptions{audience: "https://pubsub.fake/"}) ?? e => fault(e.display()))
  expect(requests(log)) == [grant(scope: "scope-a", sub: "user@example.com"), grant()]
}

test "sa_error and sa_error_text: the status and body, the OAuth code not parsed" {
  start(os)
  let k = new_key(os)
  let _ = endpoint(os.net, Some(k), FAKE_URL, [(400, "{\"error\":\"invalid_grant\",\"error_description\":\"Invalid JWT Signature.\"}", ""), (500, "upstream down", "text/plain")])
  let c = creds(os, sa_json(k), DetectOptions{scopes: ["scope-a"]}) ?? e => fault(e.display())
  expect(token_err(c)) == "auth: cannot fetch token: 400\nResponse: {\"error\":\"invalid_grant\",\"error_description\":\"Invalid JWT Signature.\"}"
  expect(token_err(c)) == "auth: cannot fetch token: 500\nResponse: upstream down"
}

test "sa_selfsigned_scopes: no request, iat now, aud empty, sub the email" {
  start(os)
  let k = new_key(os)
  let log = endpoint(os.net, Some(k), FAKE_URL, [(200, GOOD, "")])
  let c = creds(os, sa_json(k), DetectOptions{scopes: ["scope-a", "scope-b"], use_self_signed_jwt: true}) ?? e => fault(e.display())
  let t = tok(c)
  expect(t.token_type) == "Bearer"
  expect(left_secs(os, t)) == 3600
  expect(jwt_parts(k, t.value.reveal())) == ("{\"alg\":\"RS256\",\"typ\":\"JWT\",\"kid\":\"key-one\"}", "{\"iss\":\"robot@example.com\",\"scope\":\"scope-a scope-b\",\"exp\":${T0 + 3600},\"iat\":${T0},\"aud\":\"\",\"sub\":\"robot@example.com\"}")
  expect(requests(log).len()) == 0
}

test "sa_selfsigned_audience: an audience and no scope" {
  start(os)
  let k = new_key(os)
  let c = creds(os, sa_json(k), DetectOptions{audience: "https://pubsub.fake/", use_self_signed_jwt: true}) ?? e => fault(e.display())
  expect(jwt_parts(k, tok(c).value.reveal()).1) == "{\"iss\":\"robot@example.com\",\"exp\":${T0 + 3600},\"iat\":${T0},\"aud\":\"https://pubsub.fake/\",\"sub\":\"robot@example.com\"}"
}

test "sa_universe: another universe signs its own JWT" {
  start(os)
  let k = new_key(os)
  let log = endpoint(os.net, Some(k), FAKE_URL, [(200, GOOD, "")])
  let c = creds(os, sa_json(k, extra: {"universe_domain": json.Value.Str("example.fake")}), DetectOptions{scopes: ["scope-a"]}) ?? e => fault(e.display())
  expect(jwt_parts(k, tok(c).value.reveal()).1.contains("\"aud\":\"\"")) == true
  expect(c.universe_domain()) == "example.fake"
  expect(requests(log).len()) == 0
}

test "self-signed without scopes or audience is Go's error" {
  start(os)
  let k = new_key(os)
  expect(err_of(creds(os, sa_json(k), DetectOptions{use_self_signed_jwt: true}))) == "credentials: both scopes and audience are empty"
}

test "sa_missing_key and sa_bad_key: Go's texts (the parse error is Go's prefix)" {
  start(os)
  let k = new_key(os)
  expect(err_of(creds(os, sa_json(k, drop: ["private_key"]), DetectOptions{scopes: ["scope-a"]}))) == "auth: private key must be provided"
  let c = creds(os, sa_json(k, extra: {"private_key": json.Value.Str("not a key")}), DetectOptions{scopes: ["scope-a"]}) ?? e => fault(e.display())
  expect(token_err(c).starts_with("failed to parse private key. Tried PKCS8, PKCS1, and EC formats. Errors: [")) == true
}

test "au_refresh: the refresh grant in the form, no scope, cached" {
  start(os)
  let log = endpoint(os.net, None, auth.GOOGLE_TOKEN_URL, [(200, "{\"access_token\":\"access-one\",\"expires_in\":3600,\"token_type\":\"Bearer\",\"refresh_token\":\"refresh-two\"}", "")])
  let c = creds(os, au_json(), DetectOptions{scopes: ["scope-a"]}) ?? e => fault(e.display())
  for _ in 0..2 {
    expect(tok(c).value.reveal()) == "access-one"
  }
  expect(requests(log)) == [REFRESH]
  expect(c.project_id(os.env)) == ""
  expect(c.universe_domain()) == "googleapis.com"
}

test "au_rotate: a new refresh token is used for the next refresh" {
  start(os)
  let log = endpoint(os.net, None, auth.GOOGLE_TOKEN_URL, [(200, "{\"access_token\":\"access-one\",\"expires_in\":100,\"token_type\":\"Bearer\",\"refresh_token\":\"refresh-two\"}", ""), (200, "{\"access_token\":\"access-two\",\"expires_in\":3600,\"token_type\":\"Bearer\"}", "")])
  let c = creds(os, au_json()) ?? e => fault(e.display())
  expect(tok(c).value.reveal()) == "access-one"
  expect(tok(c).value.reveal()) == "access-two"
  let r = requests(log)
  expect(r.len()) == 2
  expect(r[1][4]) == "refresh_token=refresh-two"
}

test "au_form_reply: a form encoded response" {
  start(os)
  let _ = endpoint(os.net, None, auth.GOOGLE_TOKEN_URL, [(200, "access_token=access-one&expires_in=3600&token_type=Bearer", "application/x-www-form-urlencoded")])
  let t = tok(creds(os, au_json()) ?? e => fault(e.display()))
  expect(t.value.reveal()) == "access-one"
  expect(left_secs(os, t)) == 3600
}

test "au_quota and au_token_uri: the file's quota project, another endpoint" {
  start(os)
  let log = endpoint(os.net, None, FAKE_URL, [(200, GOOD, "")])
  let c = creds(os, au_json(extra: {"quota_project_id": "quota-file"}), DetectOptions{token_url: FAKE_URL}) ?? e => fault(e.display())
  let _ = tok(c)
  expect(requests(log)) == [REFRESH]
  expect(c.quota_project_id(os.env)) == "quota-file"
}

test "au_error, au_error_html, au_no_access_token: Go's texts" {
  start(os)
  let _ = endpoint(os.net, None, auth.GOOGLE_TOKEN_URL, [(401, "{\"error\":\"invalid_client\",\"error_description\":\"The OAuth client was not found.\"}", ""), (502, "<html>bad gateway</html>", "text/html"), (200, "{\"expires_in\":3600}", "")])
  let c = creds(os, au_json()) ?? e => fault(e.display())
  expect(token_err(c)) == "auth: \"invalid_client\" \"The OAuth client was not found.\""
  expect(token_err(c)) == "auth: cannot fetch token: 502\nResponse: <html>bad gateway</html>"
  expect(token_err(c)) == "auth: server response missing access_token"
}

test "au_missing_refresh, unknown_type, no_type: Go's texts" {
  expect(err_of(creds(os, au_json(drop: ["refresh_token"])))) == "auth: refresh token must be provided"
  expect(err_of(creds(os, "{\"type\":\"weird\"}".bytes()))) == "credentials: unsupported filetype \"weird\""
  expect(err_of(creds(os, "{}".bytes()))) == "credentials: unsupported unidentified file type"
  expect(err_of(creds(os, "{".bytes())) != "no error") == true
}

test "scopes_and_audience: Go's validate text" {
  expect(err_of(validate(DetectOptions{scopes: ["scope-a"], audience: "aud"}).map(fn(_: ()) -> Credentials { fault("unreachable") }))) == "credentials: both scopes and audience were provided"
}

test "from_json_mismatch, from_json_match, from_file_missing" {
  start(os)
  expect(err_of(new_credentials_from_json(os.net, os.clock, os.rand, CredType.ServiceAccount, au_json(), DetectOptions{scopes: ["scope-a"]}))) == "credentials: expected type \"service_account\", found \"authorized_user\""
  let _ = endpoint(os.net, None, auth.GOOGLE_TOKEN_URL, [(200, GOOD, "")])
  let c = new_credentials_from_json(os.net, os.clock, os.rand, CredType.AuthorizedUser, au_json(), DetectOptions{}) ?? e => fault(e.display())
  expect(tok(c).value.reveal()) == "access-one"
  expect(err_of(new_credentials_from_file(os.fs, os.net, os.clock, os.rand, CredType.ServiceAccount, "/srv/u/none.json", DetectOptions{}))) == "open /srv/u/none.json: no such file or directory"
}
