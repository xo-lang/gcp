// Credentials from Google's credential files, as cloud.google.com/go/auth
// v0.24.4's credentials package (Apache-2.0, Copyright Google LLC;
// NOTICE.md): service_account keys (the JWT bearer grant, or a self-signed
// JWT) and authorized_user refresh tokens, decision 0009 step 2.
// detect_default (Application Default Credentials, step 3) is detect.xo.

use std/crypto
use std/json
use std/task
use github.com/xo-lang/gcp/auth
use github.com/xo-lang/gcp/compute/metadata

/// The universe domain when none is set (Go's universeDomainDefault).
pub const DEFAULT_UNIVERSE_DOMAIN: Str = "googleapis.com"
/// Go's QuotaProjectEnvVar.
pub const QUOTA_PROJECT_ENV: Str = "GOOGLE_CLOUD_QUOTA_PROJECT"
/// Go's projectEnvVar.
pub const PROJECT_ENV: Str = "GOOGLE_CLOUD_PROJECT"

/// A credential file's `type` (Go's CredType).
pub enum CredType {
  ServiceAccount
  AuthorizedUser
  ExternalAccount
  ExternalAccountAuthorizedUser
  ImpersonatedServiceAccount
  GdchServiceAccount
}

/// The `type` value of `t`.
pub fn type_name(t: CredType) -> Str {
  match t {
    ServiceAccount => "service_account"
    AuthorizedUser => "authorized_user"
    ExternalAccount => "external_account"
    ExternalAccountAuthorizedUser => "external_account_authorized_user"
    ImpersonatedServiceAccount => "impersonated_service_account"
    GdchServiceAccount => "gdch_service_account"
  }
}

/// Go's DetectOptions, the fields steps 2 and 3 use.
pub struct DetectOptions {
  pub scopes: List[Str] = []
  /// A self-signed JWT's audience, or the JWT bearer grant's `aud`.
  pub audience: Str = ""
  /// The user a service account acts as (domain-wide delegation).
  pub subject: Str = ""
  /// Go's EarlyTokenRefresh: 0s for 225 seconds.
  pub early_token_refresh: Duration = 0s
  /// Go's default async refresh runs here (`os.tasks`); None refreshes
  /// before returning (Go's DisableAsyncRefresh).
  pub tasks: task.Group? = None
  /// An authorized_user's token endpoint; empty for Google's.
  pub token_url: Str = ""
  pub credentials_json: Bytes = b""
  pub credentials_file: Str = ""
  /// A service account signs its own JWT instead of the grant.
  pub use_self_signed_jwt: Bool = false
  pub universe_domain: Str = ""
}

/// Go's DetectOptions.validate.
pub fn validate(o: DetectOptions) -> () ! auth.AuthErr {
  if o.scopes.len() > 0 && o.audience != "" {
    return Err(auth.AuthErr{msg: "credentials: both scopes and audience were provided"})
  }
  if o.credentials_json.len() > 0 && o.credentials_file != "" {
    return Err(auth.AuthErr{msg: "credentials: both credentials file and JSON were provided"})
  }
  Ok(())
}

/// Where a credential's project id or universe domain comes from (Go's
/// CredentialsPropertyProvider).
enum Source {
  Static(v: Str)
  /// The metadata server (Go's GCE providers).
  Metadata(c: metadata.Client)
}

/// Go's auth.Credentials: a cached token provider, the file it came from,
/// and its project and universe domain.
pub struct Credentials {
  pub token_provider: auth.CachedTokenProvider[()]
  /// The credential file's bytes (Go's JSON()); empty for none.
  pub json: Bytes = b""
  project: Source
  universe: Source
  /// The metadata server's universe domain, read once (Go's
  /// ComputeUniverseDomainProvider and its sync.Once, which keeps an
  /// error too).
  universe_once: Mutex[Result[Str, auth.AuthErr]?]
}

fn new_creds(p: auth.CachedTokenProvider[()], b: Bytes, project: Source, universe: Source) -> Credentials {
  Credentials{token_provider: p, json: b, project: project, universe: universe, universe_once: Mutex[Result[Str, auth.AuthErr]?].new(None)}
}

pub fn (c: Credentials) token() -> auth.Token ! auth.AuthErr uses (net.dial, clock, rand) {
  c.token_provider.token()
}

struct ProjectFields {
  project_id: Str = ""
  project: Str = ""
  quota_project_id: Str = ""
} derive Json

fn md_err(e: metadata.MetadataErr) -> auth.AuthErr {
  auth.AuthErr{msg: e.display()}
}

/// Go's ProjectID: the credential's own (the file's, or the metadata
/// server's), else GOOGLE_CLOUD_PROJECT, else the file's `project_id` (or
/// a GDCH key's `project`).
pub fn (c: Credentials) project_id(env: Env) -> Str ! auth.AuthErr uses (env, net.dial, clock, rand) {
  let own = match c.project {
    Static(v) => v
    Metadata(m) => m.project_id() ?? e => return Err(md_err(e))
  }
  Ok(project_from(c.json, own, env))
}

fn project_from(b: Bytes, own: Str, env: Env) -> Str uses env {
  if own != "" {
    return own
  }
  let e = env.get(PROJECT_ENV) ?? ""
  if e != "" {
    return e
  }
  let f = json.decode[ProjectFields](b) ?? _ => return ""
  if f.project_id != "" { f.project_id } else { f.project }
}

/// Go's QuotaProjectID: GOOGLE_CLOUD_QUOTA_PROJECT, else the file's
/// `quota_project_id`.
pub fn (c: Credentials) quota_project_id(env: Env) -> Str uses env {
  let e = env.get(QUOTA_PROJECT_ENV) ?? ""
  if e != "" {
    return e
  }
  let f = json.decode[ProjectFields](c.json) ?? _ => return ""
  f.quota_project_id
}

/// Go's UniverseDomain: the credential's, else googleapis.com.
pub fn (c: Credentials) universe_domain() -> Str ! auth.AuthErr uses (net.dial, clock, rand) {
  let v = match c.universe {
    Static(v) => v
    Metadata(m) => {
      let r = c.universe_once.with(fn(var once: Result[Str, auth.AuthErr]?) -> Result[Str, auth.AuthErr] uses net.dial, clock, rand {
        if let Some(x) = once {
          return x
        }
        let x = m.universe_domain().map_err(md_err)
        once = Some(x)
        x
      })
      r?
    }
  }
  Ok(if v == "" { DEFAULT_UNIVERSE_DOMAIN } else { v })
}

struct TypeField {
  kind as "type": Str = ""
} derive Json

struct ServiceAccountFile {
  project_id: Str = ""
  private_key_id: Str = ""
  private_key: Str = ""
  client_email: Str = ""
  token_uri: Str = ""
  universe_domain: Str = ""
} derive Json

struct UserCredentialsFile {
  client_id: Str = ""
  client_secret: Str = ""
  refresh_token: Str = ""
  universe_domain: Str = ""
} derive Json

fn json_err(msg: Str) -> auth.AuthErr {
  auth.AuthErr{msg: msg}
}

/// The `type` of a credential file (Go's credsfile.ParseFileType).
pub fn file_type(b: Bytes) -> Str ! auth.AuthErr {
  let f = json.decode[TypeField](b) ?? e => return Err(json_err(e.msg))
  Ok(f.kind)
}

fn resolve_universe(opt: Str, file: Str) -> Str {
  if opt != "" { opt } else { file }
}

fn cache_of[fx: Effects](p: auth.TokenProvider[fx], clock: Clock, o: DetectOptions) -> auth.CachedTokenProvider[fx] {
  auth.cached(p, clock, auth.CachedOptions{expire_early: o.early_token_refresh, tasks: o.tasks})
}

/// Credentials from a credential file's bytes, by its `type` (Go's
/// fileCredentials). Only service_account and authorized_user are
/// ported; the other types are later steps of decision 0009.
pub fn from_json(net: Net, clock: Clock, rand: Rand, b: Bytes, opts: DetectOptions) -> Credentials ! auth.AuthErr {
  let ft = file_type(b)?
  if ft == "" {
    return Err(auth.AuthErr{msg: "credentials: unsupported unidentified file type"})
  }
  if ft == "service_account" {
    let f = json.decode[ServiceAccountFile](b) ?? e => return Err(json_err(e.msg))
    let ud = resolve_universe(opts.universe_domain, f.universe_domain)
    if opts.use_self_signed_jwt || ud != "" && ud != DEFAULT_UNIVERSE_DOMAIN {
      let p = self_signed(clock, rand, f, opts)?
      return Ok(new_creds(cache_of(p, clock, opts), b, Source.Static(f.project_id), Source.Static(ud)))
    }
    let token_url = if f.token_uri == "" { auth.GOOGLE_TOKEN_URL } else { f.token_uri }
    let p = auth.two_legged(net, clock, rand, auth.Options2LO{email: f.client_email, private_key: f.private_key, private_key_id: f.private_key_id, scopes: opts.scopes, token_url: token_url, subject: opts.subject})?
    return Ok(new_creds(cache_of(p, clock, opts), b, Source.Static(f.project_id), Source.Static(ud)))
  }
  if ft == "authorized_user" {
    let f = json.decode[UserCredentialsFile](b) ?? e => return Err(json_err(e.msg))
    let token_url = if opts.token_url == "" { auth.GOOGLE_TOKEN_URL } else { opts.token_url }
    let p = auth.refresh_token(net, clock, auth.Options3LO{client_id: f.client_id, client_secret: f.client_secret, refresh_token: f.refresh_token, token_url: token_url})?
    return Ok(new_creds(cache_of(p, clock, opts), b, Source.Static(""), Source.Static(f.universe_domain)))
  }
  if ft == "external_account" || ft == "external_account_authorized_user" || ft == "impersonated_service_account" || ft == "gdch_service_account" {
    return Err(auth.AuthErr{msg: "credentials: ${ft} credentials are not ported yet (decision 0009)"})
  }
  Err(auth.AuthErr{msg: "credentials: unsupported filetype ${q(ft)}"})
}

fn q(s: Str) -> Str {
  json.encode(s).to_str_lossy()
}

/// Credentials from bytes that must be of type `t` (Go's
/// NewCredentialsFromJSON).
pub fn new_credentials_from_json(net: Net, clock: Clock, rand: Rand, t: CredType, b: Bytes, opts: DetectOptions) -> Credentials ! auth.AuthErr {
  let ft = file_type(b)?
  if ft != type_name(t) {
    return Err(auth.AuthErr{msg: "credentials: expected type ${q(type_name(t))}, found ${q(ft)}"})
  }
  from_json(net, clock, rand, b, opts)
}

/// Credentials from the file at `path`, which must be of type `t` (Go's
/// NewCredentialsFromFile).
pub fn new_credentials_from_file(fs: Fs, net: Net, clock: Clock, rand: Rand, t: CredType, path: Str, opts: DetectOptions) -> Credentials ! auth.AuthErr uses fs.read {
  let b = fs.read(path) ?? e => return Err(auth.AuthErr{msg: "open ${e.display()}"})
  new_credentials_from_json(net, clock, rand, t, b, opts)
}

/// A service account's own JWT as its token, no request (Go's
/// selfSignedTokenProvider): iat now, exp an hour later, sub the email.
pub struct SelfSigned {
  email: Str
  audience: Str
  scopes: List[Str]
  key: Secret[crypto.PrivateKey]
  kid: Str
  clock: Clock
  rand: Rand
}

fn self_signed(clock: Clock, rand: Rand, f: ServiceAccountFile, o: DetectOptions) -> SelfSigned ! auth.AuthErr {
  if o.scopes.len() == 0 && o.audience == "" {
    return Err(auth.AuthErr{msg: "credentials: both scopes and audience are empty"})
  }
  let key = auth.parse_key(f.private_key) ?? e => return Err(auth.AuthErr{msg: "credentials: could not parse key: ${e.msg}"})
  Ok(SelfSigned{email: f.client_email, audience: o.audience, scopes: o.scopes, key: Secret.new(key), kid: f.private_key_id, clock: clock, rand: rand})
}

pub fn (p: SelfSigned) token() -> auth.Token ! auth.AuthErr uses (net.dial, clock, rand) {
  let now = p.clock.now()
  let iat = now.unix()
  let c = auth.Claims{iss: p.email, sub: p.email, aud: p.audience, scope: p.scopes.join(" "), iat: iat, exp: iat + 3600}
  let tok = auth.encode_jws(p.rand, p.key.reveal(), p.kid, c, now) ?? e => return Err(auth.AuthErr{msg: "credentials: could not encode JWT: ${e.msg}"})
  Ok(auth.Token{value: Secret.new(tok), token_type: "Bearer", expiry: Some(Time.from_unix(iat + 3600))})
}
