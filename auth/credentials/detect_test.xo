// Decision 0009 step 3 against the Go oracle's detect_* and md_* vectors:
// DetectDefault's order over MemFs, FakeEnv and FakeNet. The Go oracle's
// paths were a temporary HOME; here /srv/u.

use std/http
use std/testing
use github.com/xo-lang/gcp/auth
use github.com/xo-lang/gcp/compute/metadata
use github.com/xo-lang/gcp/option

fn caps(os: testing.TestOs) -> Caps {
  Caps{env: os.env, fs: os.fs, net: os.net, clock: os.clock, rand: os.rand}
}

fn home(os: testing.TestOs) uses env {
  os.env.set("HOME", "/srv/u")
  os.env.set("GCE_METADATA_HOST", "")
  os.env.set("GOOGLE_APPLICATION_CREDENTIALS", "")
}

fn put(os: testing.TestOs, path: Str, b: Bytes) uses fs.write {
  let cut = path.rfind("/") ?? 0
  os.fs.create_dir_all(path[0..cut]) ?? e => fault(e.display())
  os.fs.write(path, b) ?? e => fault(e.display())
}

const WELL_KNOWN: Str = "/srv/u/.config/gcloud/application_default_credentials.json"

fn detect_err(os: testing.TestOs, o: DetectOptions = DetectOptions{}) -> Str uses (env, fs.read, net.dial, clock) {
  match detect_default(caps(os), o) {
    Ok(_) => "no error"
    Err(e) => e.display()
  }
}

test "detect_env_file and detect_env_over_wellknown: GOOGLE_APPLICATION_CREDENTIALS first" {
  start(os)
  home(os)
  let k = new_key(os)
  put(os, "/srv/u/sa.json", sa_json(k))
  put(os, WELL_KNOWN, au_json())
  os.env.set("GOOGLE_APPLICATION_CREDENTIALS", "/srv/u/sa.json")
  let log = endpoint(os.net, Some(k), FAKE_URL, [(200, GOOD, "")])
  let c = detect_default(caps(os), DetectOptions{scopes: ["scope-a"]}) ?? e => fault(e.display())
  expect(tok(c).value.reveal()) == "access-one"
  expect(requests(log)) == [grant(scope: "scope-a")]
}

test "detect_env_missing: Go's open error" {
  home(os)
  os.env.set("GOOGLE_APPLICATION_CREDENTIALS", "/srv/u/none.json")
  expect(detect_err(os, DetectOptions{scopes: ["scope-a"]})) == "open /srv/u/none.json: no such file or directory"
}

test "detect_wellknown: gcloud's file under HOME, its quota project" {
  start(os)
  home(os)
  put(os, WELL_KNOWN, au_json(extra: {"quota_project_id": "quota-file"}))
  let log = endpoint(os.net, None, auth.GOOGLE_TOKEN_URL, [(200, GOOD, "")])
  let c = detect_default(caps(os)) ?? e => fault(e.display())
  expect(tok(c).value.reveal()) == "access-one"
  expect(requests(log)) == [REFRESH]
  expect(c.quota_project_id(os.env)) == "quota-file"
}

test "detect_wellknown_over_md: the file before the metadata server" {
  start(os)
  home(os)
  os.env.set("GCE_METADATA_HOST", "metadata.fake")
  put(os, WELL_KNOWN, au_json())
  let _ = endpoint(os.net, None, auth.GOOGLE_TOKEN_URL, [(200, GOOD, "")])
  let c = detect_default(caps(os)) ?? e => fault(e.display())
  expect(tok(c).value.reveal()) == "access-one"
  expect(os.net.requests().len()) == 1
}

test "detect_json_over_env and detect_file_option" {
  start(os)
  home(os)
  os.env.set("GOOGLE_APPLICATION_CREDENTIALS", "/srv/u/none.json")
  let log = endpoint(os.net, None, auth.GOOGLE_TOKEN_URL, [(200, GOOD, "")])
  let a = detect_default(caps(os), DetectOptions{credentials_json: au_json()}) ?? e => fault(e.display())
  expect(tok(a).value.reveal()) == "access-one"
  put(os, "/srv/u/au.json", au_json())
  let b = detect_default(caps(os), DetectOptions{credentials_file: "/srv/u/au.json"}) ?? e => fault(e.display())
  expect(tok(b).value.reveal()) == "access-one"
  expect(requests(log).len()) == 2
}

test "detect_wellknown_bad, scopes_and_audience, both json and file" {
  home(os)
  put(os, WELL_KNOWN, "{\"type\":\"weird\"}".bytes())
  expect(detect_err(os)) == "credentials: unsupported filetype \"weird\""
  expect(detect_err(os, DetectOptions{scopes: ["scope-a"], audience: "aud"})) == "credentials: both scopes and audience were provided"
  expect(detect_err(os, DetectOptions{credentials_json: au_json(), credentials_file: "/srv/u/au.json"})) == "credentials: both credentials file and JSON were provided"
}

test "an OAuth client file needs an authorization handler (not ported)" {
  expect(detect_err(os, DetectOptions{credentials_json: "{\"installed\":{\"client_id\":\"c\",\"redirect_uris\":[\"http://localhost\"]}}".bytes()})) == "credentials: auth handler must be specified for this credential filetype"
}

test "md_token through detect: metadata tokens, project and universe (read once)" {
  start(os)
  home(os)
  os.env.set("GCE_METADATA_HOST", "metadata.fake")
  let seen: Mutex[List[Str]] = Mutex[List[Str]].new([])
  os.net.handle("GET http://metadata.fake/{rest...}", fn(req: http.Request) -> http.Response {
    let p = req.escaped_path().trim_prefix("/computeMetadata/v1/")
    let q = req.raw_query()
    seen.with(fn(var l: List[Str]) { l.push(if q == "" { p } else { "${p}?${q}" }) })
    if p == "instance/service-accounts/default/token" {
      return http.Response{status: 200, headers: {}, body: GOOD.bytes()}
    }
    if p == "project/project-id" {
      return http.Response{status: 200, headers: {}, body: b"project-md"}
    }
    http.Response{status: 404, headers: {}, body: b"not found"}
  })
  let c = detect_default(caps(os), DetectOptions{scopes: ["scope-a", "scope-b"]}) ?? e => fault(e.display())
  expect(tok(c).value.reveal()) == "access-one"
  expect(tok(c).value.reveal()) == "access-one"
  expect(c.project_id(os.env) ?? e => fault(e.display())) == "project-md"
  expect(c.quota_project_id(os.env)) == ""
  for _ in 0..2 {
    expect(c.universe_domain() ?? e => fault(e.display())) == "googleapis.com"
  }
  expect(seen.with(fn(var l: List[Str]) -> List[Str] { l })) == ["instance/service-accounts/default/token?scopes=scope-a%2Cscope-b", "project/project-id", "universe/universe-domain"]
}

test "md_quota_env: GOOGLE_CLOUD_QUOTA_PROJECT for metadata credentials" {
  start(os)
  home(os)
  os.env.set("GCE_METADATA_HOST", "metadata.fake")
  os.env.set("GOOGLE_CLOUD_QUOTA_PROJECT", "quota-env")
  let c = detect_default(caps(os)) ?? e => fault(e.display())
  expect(c.quota_project_id(os.env)) == "quota-env"
}

test "nothing found: Go's text, after both probes say no" {
  home(os)
  expect(detect_err(os)) == "credentials: could not find default credentials. See https://cloud.google.com/docs/authentication/external/set-up-adc for more information"
}

test "on_gce: the metadata IP answering Metadata-Flavor: Google" {
  home(os)
  os.net.handle("GET http://169.254.169.254/", fn(req: http.Request) -> http.Response {
    http.Response{status: 200, headers: {"Metadata-Flavor": "Google"}, body: b""}
  })
  expect(metadata.on_gce(os.env, os.fs, os.net, os.clock)) == true
}

test "on_gce: a DMI product name of Google, then both probes false" {
  home(os)
  put(os, "/sys/class/dmi/id/product_name", b"Google Compute Engine\n")
  expect(metadata.system_info_suggests_gce(os.fs)) == true
  expect(metadata.on_gce(os.env, os.fs, os.net, os.clock)) == false
}

test "the well-known file on Windows and without HOME" {
  os.env.set("APPDATA", "C:\\AppData\\Roaming")
  expect(well_known_file(os.env, os: TargetOs.Windows)) == "C:\\AppData\\Roaming\\gcloud\\application_default_credentials.json"
  os.env.set("HOME", "/srv/u")
  expect(well_known_file(os.env, os: TargetOs.Linux)) == "/srv/u/.config/gcloud/application_default_credentials.json"
}

test "client_options: detected credentials and their quota project, the caller's kept" {
  start(os)
  let c = creds(os, au_json(extra: {"quota_project_id": "quota-file"})) ?? e => fault(e.display())
  let o = client_options(c, os.env)
  expect(o.credentials.is_some()) == true
  expect(o.quota_project) == "quota-file"
  expect(client_options(c, os.env, option.ClientOptions{quota_project: "mine"}).quota_project) == "mine"
}
