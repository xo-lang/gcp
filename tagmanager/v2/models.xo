/// Trigger: Represents a Google Tag Manager Trigger
pub struct Trigger {
  /// GTM Account ID.
  pub account_id as "accountId,omitempty": Str = ""
  /// Used in the case of auto event tracking.
  pub auto_event_filter as "autoEventFilter,omitempty": List[Condition] = []
  /// Whether or not we should only fire tags if the form submit or link click event is not cancelled by some other event handler (e.g. because of validation). Only valid for Form Submission and Link Click triggers.
  pub check_validation as "checkValidation,omitempty": Parameter? = None
  /// GTM Container ID.
  pub container_id as "containerId,omitempty": Str = ""
  /// A visibility trigger minimum continuous visible time (in milliseconds). Only valid for AMP Visibility trigger.
  pub continuous_time_min_milliseconds as "continuousTimeMinMilliseconds,omitempty": Parameter? = None
  /// Used in the case of custom event, which is fired iff all Conditions are true.
  pub custom_event_filter as "customEventFilter,omitempty": List[Condition] = []
  /// Name of the GTM event that is fired. Only valid for Timer triggers.
  pub event_name as "eventName,omitempty": Parameter? = None
  /// The trigger will only fire iff all Conditions are true.
  pub filter as "filter,omitempty": List[Condition] = []
  /// The fingerprint of the GTM Trigger as computed at storage time. This value is recomputed whenever the trigger is modified.
  pub fingerprint as "fingerprint,omitempty": Str = ""
  /// List of integer percentage values for scroll triggers. The trigger will fire when each percentage is reached when the view is scrolled horizontally. Only valid for AMP scroll triggers.
  pub horizontal_scroll_percentage_list as "horizontalScrollPercentageList,omitempty": Parameter? = None
  /// Time between triggering recurring Timer Events (in milliseconds). Only valid for Timer triggers.
  pub interval as "interval,omitempty": Parameter? = None
  /// Time between Timer Events to fire (in seconds). Only valid for AMP Timer trigger.
  pub interval_seconds as "intervalSeconds,omitempty": Parameter? = None
  /// Limit of the number of GTM events this Timer Trigger will fire. If no limit is set, we will continue to fire GTM events until the user leaves the page. Only valid for Timer triggers.
  pub limit as "limit,omitempty": Parameter? = None
  /// Max time to fire Timer Events (in seconds). Only valid for AMP Timer trigger.
  pub max_timer_length_seconds as "maxTimerLengthSeconds,omitempty": Parameter? = None
  /// Trigger display name.
  pub name as "name,omitempty": Str = ""
  /// User notes on how to apply this trigger in the container.
  pub notes as "notes,omitempty": Str = ""
  /// Additional parameters.
  pub parameter as "parameter,omitempty": List[Parameter] = []
  /// Parent folder id.
  pub parent_folder_id as "parentFolderId,omitempty": Str = ""
  /// GTM Trigger's API relative path.
  pub path as "path,omitempty": Str = ""
  /// A click trigger CSS selector (i.e. "a", "button" etc.). Only valid for AMP Click trigger.
  pub selector as "selector,omitempty": Parameter? = None
  /// Auto generated link to the tag manager UI
  pub tag_manager_url as "tagManagerUrl,omitempty": Str = ""
  /// A visibility trigger minimum total visible time (in milliseconds). Only valid for AMP Visibility trigger.
  pub total_time_min_milliseconds as "totalTimeMinMilliseconds,omitempty": Parameter? = None
  /// The Trigger ID uniquely identifies the GTM Trigger.
  pub trigger_id as "triggerId,omitempty": Str = ""
  /// Defines the data layer event that causes this trigger.
  pub type_ as "type,omitempty": Str = ""
  /// Globally unique id of the trigger that auto-generates this (a Form Submit, Link Click or Timer listener) if any. Used to make incompatible auto-events work together with trigger filtering based on trigger ids. This value is populated during output generation since the tags implied by triggers don't exist until then. Only valid for Form Submit, Link Click and Timer triggers.
  pub unique_trigger_id as "uniqueTriggerId,omitempty": Parameter? = None
  /// List of integer percentage values for scroll triggers. The trigger will fire when each percentage is reached when the view is scrolled vertically. Only valid for AMP scroll triggers.
  pub vertical_scroll_percentage_list as "verticalScrollPercentageList,omitempty": Parameter? = None
  /// A visibility trigger CSS selector (i.e. "#id"). Only valid for AMP Visibility trigger.
  pub visibility_selector as "visibilitySelector,omitempty": Parameter? = None
  /// A visibility trigger maximum percent visibility. Only valid for AMP Visibility trigger.
  pub visible_percentage_max as "visiblePercentageMax,omitempty": Parameter? = None
  /// A visibility trigger minimum percent visibility. Only valid for AMP Visibility trigger.
  pub visible_percentage_min as "visiblePercentageMin,omitempty": Parameter? = None
  /// Whether or not we should delay the form submissions or link opening until all of the tags have fired (by preventing the default action and later simulating the default action). Only valid for Form Submission and Link Click triggers.
  pub wait_for_tags as "waitForTags,omitempty": Parameter? = None
  /// How long to wait (in milliseconds) for tags to fire when 'waits_for_tags' above evaluates to true. Only valid for Form Submission and Link Click triggers.
  pub wait_for_tags_timeout as "waitForTagsTimeout,omitempty": Parameter? = None
  /// GTM Workspace ID.
  pub workspace_id as "workspaceId,omitempty": Str = ""
} derive Json

/// UserPermission: Represents a user's permissions to an account and its container.
