  /// An error occurred during the synchronization operation.
  pub sync_error as "syncError,omitempty": Bool = false
} derive Json

/// SyncWorkspaceResponse: A response after synchronizing the workspace to the latest container version.
pub struct SyncWorkspaceResponse {
  /// The merge conflict after sync. If this field is not empty, the sync is still treated as successful. But a version cannot be created until all conflicts are resolved.
  pub merge_conflict as "mergeConflict,omitempty": List[MergeConflict] = []
  /// Indicates whether synchronization caused a merge conflict or sync error.
  pub sync_status as "syncStatus,omitempty": SyncStatus? = None
} derive Json

/// Tag: Represents a Google Tag Manager Tag.
pub struct Tag {
  /// GTM Account ID.
  pub account_id as "accountId,omitempty": Str = ""
  /// Blocking trigger IDs. If any of the listed triggers evaluate to true, the tag will not fire.
  pub blocking_trigger_id as "blockingTriggerId,omitempty": List[Str] = []
  /// Consent settings of a tag.
  pub consent_settings as "consentSettings,omitempty": TagConsentSetting? = None
  /// GTM Container ID.
  pub container_id as "containerId,omitempty": Str = ""
  /// The fingerprint of the GTM Tag as computed at storage time. This value is recomputed whenever the tag is modified.
  pub fingerprint as "fingerprint,omitempty": Str = ""
  /// Firing trigger IDs. A tag will fire when any of the listed triggers are true and all of its blockingTriggerIds (if any specified) are false.
  pub firing_trigger_id as "firingTriggerId,omitempty": List[Str] = []
  /// If set to true, this tag will only fire in the live environment (e.g. not in preview or debug mode).
  pub live_only as "liveOnly,omitempty": Bool = false
  /// A map of key-value pairs of tag metadata to be included in the event data for tag monitoring. Notes: - This parameter must be type MAP. - Each parameter in the map are type TEMPLATE, however cannot contain variable references.
  pub monitoring_metadata as "monitoringMetadata,omitempty": Parameter? = None
  /// If non-empty, then the tag display name will be included in the monitoring metadata map using the key specified.
  pub monitoring_metadata_tag_name_key as "monitoringMetadataTagNameKey,omitempty": Str = ""
  /// Tag display name.
  pub name as "name,omitempty": Str = ""
  /// User notes on how to apply this tag in the container.
  pub notes as "notes,omitempty": Str = ""
  /// The tag's parameters.
  pub parameter as "parameter,omitempty": List[Parameter] = []
  /// Parent folder id.
  pub parent_folder_id as "parentFolderId,omitempty": Str = ""
  /// GTM Tag's API relative path.
  pub path as "path,omitempty": Str = ""
  /// Indicates whether the tag is paused, which prevents the tag from firing.
  pub paused as "paused,omitempty": Bool = false
  /// User defined numeric priority of the tag. Tags are fired asynchronously in order of priority. Tags with higher numeric value fire first. A tag's priority can be a positive or negative value. The default value is 0.
  pub priority as "priority,omitempty": Parameter? = None
  /// The end timestamp in milliseconds to schedule a tag.
  pub schedule_end_ms as "scheduleEndMs,omitempty": Str = ""
  /// The start timestamp in milliseconds to schedule a tag.
  pub schedule_start_ms as "scheduleStartMs,omitempty": Str = ""
  /// The list of setup tags. Currently we only allow one.
  pub setup_tag as "setupTag,omitempty": List[SetupTag] = []
  /// Option to fire this tag.
  pub tag_firing_option as "tagFiringOption,omitempty": Str = ""
  /// The Tag ID uniquely identifies the GTM Tag.
  pub tag_id as "tagId,omitempty": Str = ""
  /// Auto generated link to the tag manager UI
  pub tag_manager_url as "tagManagerUrl,omitempty": Str = ""
  /// The list of teardown tags. Currently we only allow one.
  pub teardown_tag as "teardownTag,omitempty": List[TeardownTag] = []
  /// GTM Tag Type.
  pub type_ as "type,omitempty": Str = ""
  /// GTM Workspace ID.
  pub workspace_id as "workspaceId,omitempty": Str = ""
} derive Json

/// TagConsentSetting:
pub struct TagConsentSetting {
  /// The tag's consent status. If set to NEEDED, the runtime will check that the consent types specified by the consent_type field have been granted.
  pub consent_status as "consentStatus,omitempty": Str = ""
  /// The type of consents to check for during tag firing if in the consent NEEDED state. This parameter must be of type LIST where each list item is of type STRING.
  pub consent_type as "consentType,omitempty": Parameter? = None
} derive Json

/// TeardownTag: Represents a tag that fires after another tag in order to tear down dependencies.
pub struct TeardownTag {
  /// If true, fire the teardown tag if and only if the main tag fires successfully. If false, fire the teardown tag regardless of main tag firing status.
  pub stop_teardown_on_failure as "stopTeardownOnFailure,omitempty": Bool = false
  /// The name of the teardown tag.
  pub tag_name as "tagName,omitempty": Str = ""
} derive Json

