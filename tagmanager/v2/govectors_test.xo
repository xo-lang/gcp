test "Go's tagmanager.accounts.containers.workspaces.transformations.update" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"accountId\":\"s-accountid\",\"containerId\":\"s-containerid\",\"fingerprint\":\"s-fingerprint\",\"name\":\"s-name\",\"notes\":\"s-notes\",\"parameter\":[{\"isWeakReference\":true,\"key\":\"s-key\",\"type\":\"s-type\",\"value\":\"s-value\"}],\"parentFolderId\":\"s-parentfolderid\",\"path\":\"s-path\",\"tagManagerUrl\":\"s-tagmanagerurl\",\"transformationId\":\"s-transformationid\",\"type\":\"s-type\",\"workspaceId\":\"s-workspaceid\"}")
  gv_note(f, "CALL tagmanager.accounts.containers.workspaces.transformations.update")
  match svc.accounts.containers.workspaces.transformations.update("id1/ x", json.decode_str[Transformation]("{\"accountId\":\"s-accountid\",\"containerId\":\"s-containerid\",\"fingerprint\":\"s-fingerprint\",\"name\":\"s-name\",\"notes\":\"s-notes\",\"parameter\":[{\"isWeakReference\":true,\"key\":\"s-key\",\"type\":\"s-type\",\"value\":\"s-value\"}],\"parentFolderId\":\"s-parentfolderid\",\"path\":\"s-path\",\"tagManagerUrl\":\"s-tagmanagerurl\",\"transformationId\":\"s-transformationid\",\"type\":\"s-type\",\"workspaceId\":\"s-workspaceid\"}") ?? e => fault(e.display()), options: AccountsContainersWorkspacesTransformationsUpdateOptions{fingerprint: Some("s-fingerprint"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_82)
}

