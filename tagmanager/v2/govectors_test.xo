  gv_note(f, "CALL tagmanager.accounts.containers.versions.publish")
  match svc.accounts.containers.versions.publish("id1/ x", options: AccountsContainersVersionsPublishOptions{fingerprint: Some("s-fingerprint"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
