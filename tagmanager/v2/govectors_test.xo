  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"accountAccess\":{\"permission\":\"s-permission\"},\"accountId\":\"s-accountid\",\"containerAccess\":[{\"containerId\":\"s-containerid\",\"permission\":\"s-permission\"}],\"emailAddress\":\"s-emailaddress\",\"path\":\"s-path\"}")
  gv_note(f, "CALL tagmanager.accounts.user_permissions.get")
  match svc.accounts.user_permissions.get("id1/ x", options: AccountsUserPermissionsGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_103)
}

const GO_104: List[Str] = [
  "CALL tagmanager.accounts.user_permissions.list",
  "REQ GET https://tagmanager.googleapis.com/tagmanager/v2/id1/%20x/user_permissions?alt=json&fields=kind%2Cid&pageToken=s-pagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"nextPageToken\":\"s-nextpagetoken\",\"userPermission\":[{\"accountAccess\":{\"permission\":\"s-permission\"},\"accountId\":\"s-accountid\",\"emailAddress\":\"s-emailaddress\",\"path\":\"s-path\"}]}",
  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"userPermission\":[{\"accountAccess\":{\"permission\":\"s-permission\"},\"accountId\":\"s-accountid\",\"emailAddress\":\"s-emailaddress\",\"path\":\"s-path\"}]}",
]

test "Go's tagmanager.accounts.user_permissions.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"userPermission\":[{\"accountAccess\":{\"permission\":\"s-permission\"},\"accountId\":\"s-accountid\",\"emailAddress\":\"s-emailaddress\",\"path\":\"s-path\"}]}")
  gv_note(f, "CALL tagmanager.accounts.user_permissions.list")
  match svc.accounts.user_permissions.list("id1/ x", options: AccountsUserPermissionsListOptions{page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_104)
}

const GO_105: List[Str] = [
  "CALL tagmanager.accounts.user_permissions.update",
  "REQ PUT https://tagmanager.googleapis.com/tagmanager/v2/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"accountAccess\":{\"permission\":\"s-permission\"},\"accountId\":\"s-accountid\",\"containerAccess\":[{\"containerId\":\"s-containerid\",\"permission\":\"s-permission\"}],\"emailAddress\":\"s-emailaddress\",\"path\":\"s-path\"}",
  "",
  "  SERVED 200 {\"accountAccess\":{\"permission\":\"s-permission\"},\"accountId\":\"s-accountid\",\"containerAccess\":[{\"containerId\":\"s-containerid\",\"permission\":\"s-permission\"}],\"emailAddress\":\"s-emailaddress\",\"path\":\"s-path\"}",
  "OUT: {\"accountAccess\":{\"permission\":\"s-permission\"},\"accountId\":\"s-accountid\",\"containerAccess\":[{\"containerId\":\"s-containerid\",\"permission\":\"s-permission\"}],\"emailAddress\":\"s-emailaddress\",\"path\":\"s-path\"}",
]

test "Go's tagmanager.accounts.user_permissions.update" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"accountAccess\":{\"permission\":\"s-permission\"},\"accountId\":\"s-accountid\",\"containerAccess\":[{\"containerId\":\"s-containerid\",\"permission\":\"s-permission\"}],\"emailAddress\":\"s-emailaddress\",\"path\":\"s-path\"}")
  gv_note(f, "CALL tagmanager.accounts.user_permissions.update")
  match svc.accounts.user_permissions.update("id1/ x", json.decode_str[UserPermission]("{\"accountAccess\":{\"permission\":\"s-permission\"},\"accountId\":\"s-accountid\",\"containerAccess\":[{\"containerId\":\"s-containerid\",\"permission\":\"s-permission\"}],\"emailAddress\":\"s-emailaddress\",\"path\":\"s-path\"}") ?? e => fault(e.display()), options: AccountsUserPermissionsUpdateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_105)
}
