const GO_84: List[Str] = [
  "CALL tagmanager.accounts.containers.workspaces.triggers.delete",
  "REQ DELETE https://tagmanager.googleapis.com/tagmanager/v2/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H x-extra=v1",
  "  B ",
  "  SERVED 200 ",
  "OUT: ok",
]

test "Go's tagmanager.accounts.containers.workspaces.triggers.delete" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "")
  gv_note(f, "CALL tagmanager.accounts.containers.workspaces.triggers.delete")
  match svc.accounts.containers.workspaces.triggers.delete("id1/ x", options: AccountsContainersWorkspacesTriggersDeleteOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(_) => gv_note(f, "OUT: ok")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_84)
}

