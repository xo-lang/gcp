/// ClusterAutoscaling: ClusterAutoscaling contains global, per-cluster information required by Cluster Autoscaler to automatically adjust the size of the cluster and create/delete node pools based on the current needs.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct ClusterAutoscaling {
  /// Autopilot general profile for the cluster, which defines the configuration for the cluster.
  pub autopilot_general_profile as "autopilotGeneralProfile,omitempty": Str = ""
  /// The list of Google Compute Engine [zones](https://cloud.google.com/compute/docs/zones#available) in which the NodePool's nodes can be created by NAP.
  pub autoprovisioning_locations as "autoprovisioningLocations,omitempty": List[Str] = []
  /// AutoprovisioningNodePoolDefaults contains defaults for a node pool created by NAP.
  pub autoprovisioning_node_pool_defaults as "autoprovisioningNodePoolDefaults,omitempty": AutoprovisioningNodePoolDefaults? = None
  /// Optional. Configures restrictions related to autoprovisioning settings.
  pub autoprovisioning_restriction_config as "autoprovisioningRestrictionConfig,omitempty": AutoprovisioningRestrictionConfig? = None
  /// Defines autoscaling behaviour.
  pub autoscaling_profile as "autoscalingProfile,omitempty": Str = ""
  /// Default compute class is a configuration for default compute class.
  pub default_compute_class_config as "defaultComputeClassConfig,omitempty": DefaultComputeClassConfig? = None
  /// Enables automatic node pool creation and deletion.
  pub enable_node_autoprovisioning as "enableNodeAutoprovisioning,omitempty": Bool = false
  /// Contains global constraints regarding minimum and maximum amount of resources in the cluster.
  pub resource_limits as "resourceLimits,omitempty": List[ResourceLimit] = []
  pub force_send_fields as "-": List[ClusterAutoscalingField] = []
  pub null_fields as "-": List[ClusterAutoscalingField] = []
} derive Json

/// ClusterAutoscalingField: ClusterAutoscaling's fields, for force_send_fields and null_fields.
pub enum ClusterAutoscalingField {
  AutopilotGeneralProfile
  AutoprovisioningLocations
  AutoprovisioningNodePoolDefaults
  AutoprovisioningRestrictionConfig
  AutoscalingProfile
  DefaultComputeClassConfig
  EnableNodeAutoprovisioning
  ResourceLimits
}

fn cluster_autoscaling_field_entry(f: ClusterAutoscalingField) -> Str {
  match f {
    AutopilotGeneralProfile => "autopilotGeneralProfile=\"\""
    AutoprovisioningLocations => "autoprovisioningLocations=[]"
    AutoprovisioningNodePoolDefaults => "autoprovisioningNodePoolDefaults"
    AutoprovisioningRestrictionConfig => "autoprovisioningRestrictionConfig"
    AutoscalingProfile => "autoscalingProfile=\"\""
    DefaultComputeClassConfig => "defaultComputeClassConfig"
