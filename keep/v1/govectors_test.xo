use std/json

const GV_HOST: Str = "https://keep.googleapis.com"

const GO_0: List[Str] = [
  "CALL keep.media.download",
  "REQ GET https://keep.googleapis.com/v1/id1/%20x?alt=json&fields=kind%2Cid&mimeType=s-mimetype&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"mimeType\":[\"s-mimetype\"],\"name\":\"s-name\"}",
  "OUT: {\"mimeType\":[\"s-mimetype\"],\"name\":\"s-name\"}",
]

test "Go's keep.media.download" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"mimeType\":[\"s-mimetype\"],\"name\":\"s-name\"}")
  gv_note(f, "CALL keep.media.download")
  match svc.media.download("id1/ x", options: MediaDownloadOptions{mime_type: Some("s-mimetype"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

