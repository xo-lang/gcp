test "Go's youtube.liveChatBans.insert" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"snippet\":{\"banDurationSeconds\":\"7\",\"bannedUserDetails\":{\"channelId\":\"s-channelid\",\"channelUrl\":\"s-channelurl\",\"displayName\":\"s-displayname\",\"profileImageUrl\":\"s-profileimageurl\"},\"liveChatId\":\"s-livechatid\",\"type\":\"s-type\"}}")
  gv_note(f, "CALL youtube.liveChatBans.insert")
  match svc.live_chat_bans.insert(["s-part"], json.decode_str[LiveChatBan]("{\"etag\":\"s-etag\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"snippet\":{\"banDurationSeconds\":\"7\",\"bannedUserDetails\":{\"channelId\":\"s-channelid\",\"channelUrl\":\"s-channelurl\",\"displayName\":\"s-displayname\",\"profileImageUrl\":\"s-profileimageurl\"},\"liveChatId\":\"s-livechatid\",\"type\":\"s-type\"}}") ?? e => fault(e.display()), options: LiveChatBansInsertOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_32)
}

