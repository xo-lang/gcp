test "Go's youtube.videos.reportAbuse" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "")
  gv_note(f, "CALL youtube.videos.reportAbuse")
  match svc.videos.report_abuse(json.decode_str[VideoAbuseReport]("{\"comments\":\"s-comments\",\"language\":\"s-language\",\"reasonId\":\"s-reasonid\",\"secondaryReasonId\":\"s-secondaryreasonid\",\"videoId\":\"s-videoid\"}") ?? e => fault(e.display()), options: VideosReportAbuseOptions{on_behalf_of_content_owner: Some("s-onbehalfofcontentowner"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(_) => gv_note(f, "OUT: ok")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_78)
}

