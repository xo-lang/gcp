test "Go's youtube.liveChatMessages.delete" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "")
  gv_note(f, "CALL youtube.liveChatMessages.delete")
  match svc.live_chat_messages.delete("s-id", options: LiveChatMessagesDeleteOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(_) => gv_note(f, "OUT: ok")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_33)
}

