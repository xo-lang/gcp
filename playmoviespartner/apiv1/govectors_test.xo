  "OUT: {\"audioTracks\":[\"s-audiotracks\"],\"country\":\"s-country\",\"editLevelEidr\":\"s-editleveleidr\",\"episodeNumber\":\"s-episodenumber\",\"hasAudio51\":true,\"hasEstOffer\":true,\"hasHdOffer\":true,\"hasInfoCards\":true,\"hasSdOffer\":true,\"hasVodOffer\":true,\"liveTime\":\"s-livetime\",\"mid\":\"s-mid\",\"name\":\"s-name\",\"pphNames\":[\"s-pphnames\"],\"seasonId\":\"s-seasonid\",\"seasonName\":\"s-seasonname\",\"seasonNumber\":\"s-seasonnumber\",\"showId\":\"s-showid\",\"showName\":\"s-showname\",\"studioName\":\"s-studioname\",\"subtitles\":[\"s-subtitles\"],\"titleLevelEidr\":\"s-titleleveleidr\",\"trailerId\":\"s-trailerid\",\"type\":\"s-type\",\"videoId\":\"s-videoid\"}",
]

test "Go's playmoviespartner.accounts.storeInfos.country.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"audioTracks\":[\"s-audiotracks\"],\"country\":\"s-country\",\"editLevelEidr\":\"s-editleveleidr\",\"episodeNumber\":\"s-episodenumber\",\"hasAudio51\":true,\"hasEstOffer\":true,\"hasHdOffer\":true,\"hasInfoCards\":true,\"hasSdOffer\":true,\"hasVodOffer\":true,\"liveTime\":\"s-livetime\",\"mid\":\"s-mid\",\"name\":\"s-name\",\"pphNames\":[\"s-pphnames\"],\"seasonId\":\"s-seasonid\",\"seasonName\":\"s-seasonname\",\"seasonNumber\":\"s-seasonnumber\",\"showId\":\"s-showid\",\"showName\":\"s-showname\",\"studioName\":\"s-studioname\",\"subtitles\":[\"s-subtitles\"],\"titleLevelEidr\":\"s-titleleveleidr\",\"trailerId\":\"s-trailerid\",\"type\":\"s-type\",\"videoId\":\"s-videoid\"}")
  gv_note(f, "CALL playmoviespartner.accounts.storeInfos.country.get")
  match svc.accounts.store_infos.country.get("id1/ x", "id2/ x", "id3/ x", options: AccountsStoreInfosCountryGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_8)
}
