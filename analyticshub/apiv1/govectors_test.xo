test "Go's analyticshub.projects.locations.subscriptions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"subscriptions\":[{\"commercialInfo\":{},\"creationTime\":\"s-creationtime\",\"dataExchange\":\"s-dataexchange\",\"destinationDataset\":{\"description\":\"s-description\",\"friendlyName\":\"s-friendlyname\",\"location\":\"s-location\"},\"lastModifyTime\":\"s-lastmodifytime\",\"listing\":\"s-listing\",\"logLinkedDatasetQueryUserEmail\":true,\"name\":\"s-name\",\"organizationDisplayName\":\"s-organizationdisplayname\",\"organizationId\":\"s-organizationid\",\"resourceType\":\"s-resourcetype\",\"state\":\"s-state\",\"subscriberContact\":\"s-subscribercontact\"}]}")
  gv_queue(f, "{\"subscriptions\":[{\"commercialInfo\":{},\"creationTime\":\"s-creationtime\",\"dataExchange\":\"s-dataexchange\",\"destinationDataset\":{\"description\":\"s-description\",\"friendlyName\":\"s-friendlyname\",\"location\":\"s-location\"},\"lastModifyTime\":\"s-lastmodifytime\",\"listing\":\"s-listing\",\"logLinkedDatasetQueryUserEmail\":true,\"name\":\"s-name\",\"organizationDisplayName\":\"s-organizationdisplayname\",\"organizationId\":\"s-organizationid\",\"resourceType\":\"s-resourcetype\",\"state\":\"s-state\",\"subscriberContact\":\"s-subscribercontact\"}]}")
  gv_note(f, "CALL analyticshub.projects.locations.subscriptions.list pages")
  var p = svc.projects.locations.subscriptions.list_pages("id1/ x", options: ProjectsLocationsSubscriptionsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_38)
}

