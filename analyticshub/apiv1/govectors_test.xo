  gv_queue(f, "{\"sharedResourceSubscriptions\":[{\"commercialInfo\":{},\"creationTime\":\"s-creationtime\",\"dataExchange\":\"s-dataexchange\",\"destinationDataset\":{\"description\":\"s-description\",\"friendlyName\":\"s-friendlyname\",\"location\":\"s-location\"},\"lastModifyTime\":\"s-lastmodifytime\",\"listing\":\"s-listing\",\"logLinkedDatasetQueryUserEmail\":true,\"name\":\"s-name\",\"organizationDisplayName\":\"s-organizationdisplayname\",\"organizationId\":\"s-organizationid\",\"resourceType\":\"s-resourcetype\",\"state\":\"s-state\",\"subscriberContact\":\"s-subscribercontact\"}]}")
