/// Subscription: A subscription represents a subscribers' access to a particular set of published data. It contains references to associated listings, data exchanges, and linked datasets.
pub struct Subscription {
  /// Output only. This is set if this is a commercial subscription i.e. if this subscription was created from subscribing to a commercial listing.
  pub commercial_info as "commercialInfo,omitempty": GoogleCloudBigqueryAnalyticshubV1SubscriptionCommercialInfo? = None
  /// Output only. Timestamp when the subscription was created.
  pub creation_time as "creationTime,omitempty": Str = ""
  /// Output only. Resource name of the source Data Exchange. e.g. projects/123/locations/us/dataExchanges/456
  pub data_exchange as "dataExchange,omitempty": Str = ""
  /// Optional. BigQuery destination dataset to create for the subscriber.
  pub destination_dataset as "destinationDataset,omitempty": DestinationDataset? = None
  /// Output only. Timestamp when the subscription was last modified.
  pub last_modify_time as "lastModifyTime,omitempty": Str = ""
  /// Output only. Map of listing resource names to associated linked resource, e.g. projects/123/locations/us/dataExchanges/456/listings/789 -> projects/123/datasets/my_dataset For listing-level subscriptions, this is a map of size 1. Only contains values if state == STATE_ACTIVE.
  pub linked_dataset_map as "linkedDatasetMap,omitempty": Map[Str, LinkedResource] = {}
  /// Output only. Linked resources created in the subscription. Only contains values if state = STATE_ACTIVE.
  pub linked_resources as "linkedResources,omitempty": List[LinkedResource] = []
  /// Output only. Resource name of the source Listing. e.g. projects/123/locations/us/dataExchanges/456/listings/789
  pub listing as "listing,omitempty": Str = ""
  /// Output only. By default, false. If true, the Subscriber agreed to the email sharing mandate that is enabled for DataExchange/Listing.
  pub log_linked_dataset_query_user_email as "logLinkedDatasetQueryUserEmail,omitempty": Bool = false
  /// Output only. The resource name of the subscription. e.g. `projects/myproject/locations/us/subscriptions/123`.
  pub name as "name,omitempty": Str = ""
  /// Output only. Display name of the project of this subscription.
  pub organization_display_name as "organizationDisplayName,omitempty": Str = ""
  /// Output only. Organization of the project this subscription belongs to.
  pub organization_id as "organizationId,omitempty": Str = ""
  /// Output only. Listing shared asset type.
  pub resource_type as "resourceType,omitempty": Str = ""
  /// Output only. Current state of the subscription.
  pub state as "state,omitempty": Str = ""
  /// Output only. Email of the subscriber.
  pub subscriber_contact as "subscriberContact,omitempty": Str = ""
} derive Json

