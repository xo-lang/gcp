test "Go's compute.zoneVmExtensionPolicies.update" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"clientOperationId\":\"s-clientoperationid\",\"creationTimestamp\":\"s-creationtimestamp\",\"description\":\"s-description\",\"details\":{\"data\":{\"k\":\"v\"},\"message\":\"s-message\"},\"endTime\":\"s-endtime\",\"error\":{\"errors\":[{\"code\":\"s-code\",\"errorDetails\":[{}],\"location\":\"s-location\",\"message\":\"s-message\"}]},\"getHealthOperationMetadata\":{\"healthInfo\":{\"availabilitySloStatus\":\"s-availabilityslostatus\",\"healthStatus\":\"s-healthstatus\",\"repairCategory\":\"s-repaircategory\",\"unhealthyReason\":\"s-unhealthyreason\",\"updateTime\":\"s-updatetime\"}},\"getVersionOperationMetadata\":{\"inlineSbomInfo\":{\"currentComponentVersions\":{\"k1\":\"s-currentcomponentversions\"},\"targetComponentVersions\":{\"k1\":\"s-targetcomponentversions\"}}},\"httpErrorMessage\":\"s-httperrormessage\",\"httpErrorStatusCode\":7,\"id\":\"7\",\"insertTime\":\"s-inserttime\",\"instancesBulkInsertOperationMetadata\":{\"perLocationStatus\":{\"k1\":{\"createdVmCount\":7,\"deletedVmCount\":7,\"failedToCreateVmCount\":7,\"status\":\"s-status\",\"targetVmCount\":7}}},\"instancesTroubleshootOperationMetadata\":{\"troubleshootOutput\":\"s-troubleshootoutput\"},\"kind\":\"s-kind\",\"name\":\"s-name\",\"operationGroupId\":\"s-operationgroupid\",\"operationType\":\"s-operationtype\",\"progress\":7,\"region\":\"s-region\",\"selfLink\":\"s-selflink\",\"setCommonInstanceMetadataOperationMetadata\":{\"clientOperationId\":\"s-clientoperationid\",\"perLocationOperations\":{\"k1\":{\"state\":\"s-state\"}}},\"startTime\":\"s-starttime\",\"status\":\"s-status\",\"statusMessage\":\"s-statusmessage\",\"targetId\":\"7\",\"targetLink\":\"s-targetlink\",\"user\":\"s-user\",\"warnings\":[{\"code\":\"s-code\",\"data\":[{\"key\":\"s-key\",\"value\":\"s-value\"}],\"message\":\"s-message\"}],\"zone\":\"s-zone\"}")
  gv_note(f, "CALL compute.zoneVmExtensionPolicies.update")
  match svc.zone_vm_extension_policies.update("id1/ x", "id2/ x", "id3/ x", json.decode_str[VmExtensionPolicy]("{\"creationTimestamp\":\"s-creationtimestamp\",\"description\":\"s-description\",\"extensionPolicies\":{\"k1\":{\"pinnedVersion\":\"s-pinnedversion\",\"stringConfig\":\"s-stringconfig\"}},\"globalResourceLink\":\"s-globalresourcelink\",\"id\":\"7\",\"instanceSelectors\":[{\"labelSelector\":{}}],\"kind\":\"s-kind\",\"managedByGlobal\":true,\"name\":\"s-name\",\"priority\":7,\"selfLink\":\"s-selflink\",\"selfLinkWithId\":\"s-selflinkwithid\",\"state\":\"s-state\",\"updateTimestamp\":\"s-updatetimestamp\"}") ?? e => fault(e.display()), options: ZoneVmExtensionPoliciesUpdateOptions{request_id: Some("s-requestid"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_1089)
}

