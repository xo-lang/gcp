  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"id\":\"s-id\",\"items\":[{\"architecture\":\"s-architecture\",\"autoCreated\":true,\"chainName\":\"s-chainname\",\"creationSizeBytes\":\"7\",\"creationTimestamp\":\"s-creationtimestamp\",\"description\":\"s-description\",\"diskSizeGb\":\"7\",\"downloadBytes\":\"7\",\"enableConfidentialCompute\":true,\"guestFlush\":true,\"id\":\"7\",\"kind\":\"s-kind\",\"labelFingerprint\":\"YWI=\",\"labels\":{\"k1\":\"s-labels\"},\"licenseCodes\":[\"7\"],\"licenses\":[\"s-licenses\"],\"locationHint\":\"s-locationhint\",\"name\":\"s-name\",\"params\":{},\"region\":\"s-region\",\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"selfLink\":\"s-selflink\",\"snapshotEncryptionKey\":{\"kmsKeyName\":\"s-kmskeyname\",\"kmsKeyServiceAccount\":\"s-kmskeyserviceaccount\",\"rawKey\":\"s-rawkey\",\"rsaEncryptedKey\":\"s-rsaencryptedkey\",\"sha256\":\"s-sha256\"},\"snapshotGroupId\":\"s-snapshotgroupid\",\"snapshotGroupName\":\"s-snapshotgroupname\",\"snapshotType\":\"s-snapshottype\",\"sourceDisk\":\"s-sourcedisk\",\"sourceDiskEncryptionKey\":{\"kmsKeyName\":\"s-kmskeyname\",\"kmsKeyServiceAccount\":\"s-kmskeyserviceaccount\",\"rawKey\":\"s-rawkey\",\"rsaEncryptedKey\":\"s-rsaencryptedkey\",\"sha256\":\"s-sha256\"},\"sourceDiskForRecoveryCheckpoint\":\"s-sourcediskforrecoverycheckpoint\",\"sourceDiskId\":\"s-sourcediskid\",\"sourceInstantSnapshot\":\"s-sourceinstantsnapshot\",\"sourceInstantSnapshotEncryptionKey\":{\"kmsKeyName\":\"s-kmskeyname\",\"kmsKeyServiceAccount\":\"s-kmskeyserviceaccount\",\"rawKey\":\"s-rawkey\",\"rsaEncryptedKey\":\"s-rsaencryptedkey\",\"sha256\":\"s-sha256\"},\"sourceInstantSnapshotId\":\"s-sourceinstantsnapshotid\",\"sourceSnapshotSchedulePolicy\":\"s-sourcesnapshotschedulepolicy\",\"sourceSnapshotSchedulePolicyId\":\"s-sourcesnapshotschedulepolicyid\",\"status\":\"s-status\",\"storageBytes\":\"7\",\"storageBytesStatus\":\"s-storagebytesstatus\",\"storageLocations\":[\"s-storagelocations\"]}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"selfLink\":\"s-selflink\",\"warning\":{\"code\":\"s-code\",\"data\":[{\"key\":\"s-key\",\"value\":\"s-value\"}],\"message\":\"s-message\"}}")
  gv_note(f, "CALL compute.snapshots.list")
  match svc.snapshots.list("id1/ x", options: SnapshotsListOptions{filter: Some("s-filter"), max_results: Some(7), order_by: Some("s-orderby"), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_936)
}

