  gv_set(f, "{\"availableCpuPlatforms\":[\"s-availablecpuplatforms\"],\"creationTimestamp\":\"s-creationtimestamp\",\"deprecated\":{\"deleted\":\"s-deleted\",\"deprecated\":\"s-deprecated\",\"obsolete\":\"s-obsolete\",\"replacement\":\"s-replacement\",\"state\":\"s-state\"},\"description\":\"s-description\",\"id\":\"7\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"region\":\"s-region\",\"resourceStatus\":{\"upcomingMaintenances\":[{\"subType\":\"s-subtype\",\"targetResource\":\"s-targetresource\",\"type\":\"s-type\"}]},\"selfLink\":\"s-selflink\",\"status\":\"s-status\",\"supportsPzs\":true}")
  gv_note(f, "CALL compute.zones.get")
  match svc.zones.get("id1/ x", "id2/ x", options: ZonesGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
