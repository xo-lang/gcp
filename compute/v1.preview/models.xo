  pub grpc_health_check as "grpcHealthCheck,omitempty": GRPCHealthCheck? = None
  pub grpc_tls_health_check as "grpcTlsHealthCheck,omitempty": GRPCTLSHealthCheck? = None
  /// A so-far unhealthy instance will be marked healthy after this
  /// many consecutive successes. The default value is 2.
  pub healthy_threshold as "healthyThreshold,omitempty": Int = 0
  pub http2_health_check as "http2HealthCheck,omitempty": HTTP2HealthCheck? = None
  pub http_health_check as "httpHealthCheck,omitempty": HTTPHealthCheck? = None
  pub https_health_check as "httpsHealthCheck,omitempty": HTTPSHealthCheck? = None
