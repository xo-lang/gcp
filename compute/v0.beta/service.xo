  if let Some(v) = options.no_graceful_shutdown {
    q.set("noGracefulShutdown", "${v}")
  }
  if let Some(v) = options.request_id {
    q.set("requestId", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "projects/{project}/zones/{zone}/instances/{instance}/stop"), {"project": project, "zone": zone, "instance": instance})
