/// DisksListPages: the pages of DisksService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct DisksListPages[fx: Effects] {
  r: DisksService[fx]
  project: Str
  zone: Str
  options: DisksListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: DisksService.list's pages, from the first.
pub fn (r: DisksService[fx]) list_pages(project: Str, zone: Str, options: DisksListOptions = DisksListOptions{}) -> DisksListPages[fx] {
  DisksListPages{r: r, project: project, zone: zone, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: DisksListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: DisksListPages[fx]) next_page() -> DiskList ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.project, p.zone, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

