  project: Str
  options: RoutesListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: RoutesService.list's pages, from the first.
pub fn (r: RoutesService[fx]) list_pages(project: Str, options: RoutesListOptions = RoutesListOptions{}) -> RoutesListPages[fx] {
  RoutesListPages{r: r, project: project, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: RoutesListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: RoutesListPages[fx]) next_page() -> RouteList ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.project, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

