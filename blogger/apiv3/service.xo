/// list: Lists posts.
/// (Go's blogger.posts.list.)
pub fn (r: PostsService[fx]) list(blog_id: Str, options: PostsListOptions = PostsListOptions{}) -> PostList ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.end_date {
    q.set("endDate", v)
  }
  if let Some(v) = options.fetch_bodies {
    q.set("fetchBodies", "${v}")
  }
  if let Some(v) = options.fetch_images {
    q.set("fetchImages", "${v}")
  }
  if let Some(v) = options.labels {
    q.set("labels", v)
  }
  if let Some(v) = options.max_results {
    q.set("maxResults", "${v}")
  }
  if let Some(v) = options.order_by {
    q.set("orderBy", v)
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if let Some(v) = options.sort_option {
    q.set("sortOption", v)
  }
  if let Some(v) = options.start_date {
    q.set("startDate", v)
  }
  for v in options.status {
    q.add("status", v)
  }
  if let Some(v) = options.view {
    q.set("view", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v3/blogs/{blogId}/posts"), {"blogId": blog_id})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[PostList](resp)
}

/// PostsListPages: the pages of PostsService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct PostsListPages[fx: Effects] {
  r: PostsService[fx]
  blog_id: Str
  options: PostsListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: PostsService.list's pages, from the first.
pub fn (r: PostsService[fx]) list_pages(blog_id: Str, options: PostsListOptions = PostsListOptions{}) -> PostsListPages[fx] {
  PostsListPages{r: r, blog_id: blog_id, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: PostsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: PostsListPages[fx]) next_page() -> PostList ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.blog_id, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

