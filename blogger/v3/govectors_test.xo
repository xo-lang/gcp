use std/json

const GV_HOST: Str = "https://blogger.googleapis.com"

const GO_0: List[Str] = [
  "CALL blogger.blogUserInfos.get",
  "REQ GET https://blogger.googleapis.com/v3/users/id1%2F%20x/blogs/id2%2F%20x?alt=json&fields=kind%2Cid&maxPosts=7&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
