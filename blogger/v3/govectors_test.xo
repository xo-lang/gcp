test "Go's blogger.blogUserInfos.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"blog\":{\"customMetaData\":\"s-custommetadata\",\"description\":\"s-description\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"locale\":{\"country\":\"s-country\",\"language\":\"s-language\",\"variant\":\"s-variant\"},\"name\":\"s-name\",\"pages\":{\"selfLink\":\"s-selflink\",\"totalItems\":7},\"posts\":{\"selfLink\":\"s-selflink\",\"totalItems\":7},\"published\":\"s-published\",\"selfLink\":\"s-selflink\",\"status\":\"s-status\",\"updated\":\"s-updated\",\"url\":\"s-url\"},\"blog_user_info\":{\"blogId\":\"s-blogid\",\"hasAdminAccess\":true,\"kind\":\"s-kind\",\"photosAlbumKey\":\"s-photosalbumkey\",\"role\":\"s-role\",\"userId\":\"s-userid\"},\"kind\":\"s-kind\"}")
  gv_note(f, "CALL blogger.blogUserInfos.get")
  match svc.blog_user_infos.get("id1/ x", "id2/ x", options: BlogUserInfosGetOptions{max_posts: Some(7), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
