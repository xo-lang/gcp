  gv_set(f, "{\"cacheCapabilities\":{\"actionCacheUpdateCapabilities\":{\"updateEnabled\":true},\"cachePriorityCapabilities\":{},\"digestFunction\":[\"s-digestfunction\"],\"maxBatchTotalSizeBytes\":\"7\",\"supportedCompressor\":[\"s-supportedcompressor\"],\"symlinkAbsolutePathStrategy\":\"s-symlinkabsolutepathstrategy\"},\"deprecatedApiVersion\":{\"major\":7,\"minor\":7,\"patch\":7,\"prerelease\":\"s-prerelease\"},\"executionCapabilities\":{\"digestFunction\":\"s-digestfunction\",\"execEnabled\":true,\"executionPriorityCapabilities\":{},\"supportedNodeProperties\":[\"s-supportednodeproperties\"]},\"highApiVersion\":{\"major\":7,\"minor\":7,\"patch\":7,\"prerelease\":\"s-prerelease\"},\"lowApiVersion\":{\"major\":7,\"minor\":7,\"patch\":7,\"prerelease\":\"s-prerelease\"}}")
