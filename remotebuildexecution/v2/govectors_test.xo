  gv_note(f, "CALL remotebuildexecution.operations.waitExecution")
  match svc.operations.wait_execution("id1/ x", json.decode_str[BuildBazelRemoteExecutionV2WaitExecutionRequest]("{}") ?? e => fault(e.display()), options: OperationsWaitExecutionOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_7)
}

