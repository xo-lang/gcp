// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 civicinfo/v2 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://civicinfo.googleapis.com"

const GO_0: List[Str] = [
  "CALL civicinfo.divisions.queryDivisionByAddress",
  "REQ GET https://civicinfo.googleapis.com/civicinfo/v2/divisionsByAddress?address=s-address&alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"divisions\":{\"k1\":{\"alsoKnownAs\":[\"s-alsoknownas\"],\"name\":\"s-name\",\"officeIndices\":[7]}},\"normalizedInput\":{\"addressLine\":[\"s-addressline\"],\"city\":\"s-city\",\"line1\":\"s-line1\",\"line2\":\"s-line2\",\"line3\":\"s-line3\",\"locationName\":\"s-locationname\",\"state\":\"s-state\",\"zip\":\"s-zip\"}}",
  "OUT: {\"divisions\":{\"k1\":{\"alsoKnownAs\":[\"s-alsoknownas\"],\"name\":\"s-name\",\"officeIndices\":[7]}},\"normalizedInput\":{\"addressLine\":[\"s-addressline\"],\"city\":\"s-city\",\"line1\":\"s-line1\",\"line2\":\"s-line2\",\"line3\":\"s-line3\",\"locationName\":\"s-locationname\",\"state\":\"s-state\",\"zip\":\"s-zip\"}}",
]

test "Go's civicinfo.divisions.queryDivisionByAddress" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"divisions\":{\"k1\":{\"alsoKnownAs\":[\"s-alsoknownas\"],\"name\":\"s-name\",\"officeIndices\":[7]}},\"normalizedInput\":{\"addressLine\":[\"s-addressline\"],\"city\":\"s-city\",\"line1\":\"s-line1\",\"line2\":\"s-line2\",\"line3\":\"s-line3\",\"locationName\":\"s-locationname\",\"state\":\"s-state\",\"zip\":\"s-zip\"}}")
  gv_note(f, "CALL civicinfo.divisions.queryDivisionByAddress")
  match svc.divisions.query_division_by_address(options: DivisionsQueryDivisionByAddressOptions{address: Some("s-address"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

