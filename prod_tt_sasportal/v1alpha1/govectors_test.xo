  gv_set(f, "{\"devices\":[{\"activeConfig\":{\"callSign\":\"s-callsign\",\"category\":\"s-category\",\"isSigned\":true,\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"userId\":\"s-userid\"},\"deviceMetadata\":{\"antennaModel\":\"s-antennamodel\",\"commonChannelGroup\":\"s-commonchannelgroup\",\"interferenceCoordinationGroup\":\"s-interferencecoordinationgroup\",\"nrqzValidated\":true},\"displayName\":\"s-displayname\",\"fccId\":\"s-fccid\",\"name\":\"s-name\",\"preloadedConfig\":{\"callSign\":\"s-callsign\",\"category\":\"s-category\",\"isSigned\":true,\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"userId\":\"s-userid\"},\"serialNumber\":\"s-serialnumber\",\"state\":\"s-state\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"devices\":[{\"activeConfig\":{\"callSign\":\"s-callsign\",\"category\":\"s-category\",\"isSigned\":true,\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"userId\":\"s-userid\"},\"deviceMetadata\":{\"antennaModel\":\"s-antennamodel\",\"commonChannelGroup\":\"s-commonchannelgroup\",\"interferenceCoordinationGroup\":\"s-interferencecoordinationgroup\",\"nrqzValidated\":true},\"displayName\":\"s-displayname\",\"fccId\":\"s-fccid\",\"name\":\"s-name\",\"preloadedConfig\":{\"callSign\":\"s-callsign\",\"category\":\"s-category\",\"isSigned\":true,\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"userId\":\"s-userid\"},\"serialNumber\":\"s-serialnumber\",\"state\":\"s-state\"}]}")
  gv_note(f, "CALL prod_tt_sasportal.nodes.devices.list pages")
  var p = svc.nodes.devices.list_pages("id1/ x", options: NodesDevicesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_72)
}

