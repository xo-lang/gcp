test "Go's prod_tt_sasportal.customers.nodes.nodes.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"nodes\":[{\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"sasUserIds\":[\"s-sasuserids\"]}]}")
  gv_queue(f, "{\"nodes\":[{\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"sasUserIds\":[\"s-sasuserids\"]}]}")
  gv_note(f, "CALL prod_tt_sasportal.customers.nodes.nodes.list pages")
  var p = svc.customers.nodes.nodes.list_pages("id1/ x", options: CustomersNodesNodesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_46)
}

