  match svc.policies.test_(json.decode_str[SasPortalTestPermissionsRequest]("{\"permissions\":[\"s-permissions\"],\"resource\":\"s-resource\"}") ?? e => fault(e.display()), options: PoliciesTestOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_96)
}
