  /// Total rows returned by this query (across different pages).
  pub total_rows as "totalRows,omitempty": Int = 0
} derive Json

/// Segment: The segment definition, if the report needs to be segmented. A Segment is a subset of the Analytics data. For example, of the entire set of users, one Segment might be users from a particular country or city.
pub struct Segment {
  /// A dynamic segment definition in the request.
  pub dynamic_segment as "dynamicSegment,omitempty": DynamicSegment? = None
  /// The segment ID of a built-in or custom segment, for example `gaid::-3`.
  pub segment_id as "segmentId,omitempty": Str = ""
} derive Json

/// SegmentDefinition: SegmentDefinition defines the segment to be a set of SegmentFilters which are combined together with a logical `AND` operation.
pub struct SegmentDefinition {
  /// A segment is defined by a set of segment filters which are combined together with a logical `AND` operation.
  pub segment_filters as "segmentFilters,omitempty": List[SegmentFilter] = []
} derive Json

/// SegmentDimensionFilter: Dimension filter specifies the filtering options on a dimension.
pub struct SegmentDimensionFilter {
  /// Should the match be case sensitive, ignored for `IN_LIST` operator.
  pub case_sensitive as "caseSensitive,omitempty": Bool = false
  /// Name of the dimension for which the filter is being applied.
  pub dimension_name as "dimensionName,omitempty": Str = ""
  /// The list of expressions, only the first element is used for all operators
  pub expressions as "expressions,omitempty": List[Str] = []
  /// Maximum comparison values for `BETWEEN` match type.
  pub max_comparison_value as "maxComparisonValue,omitempty": Str = ""
  /// Minimum comparison values for `BETWEEN` match type.
  pub min_comparison_value as "minComparisonValue,omitempty": Str = ""
  /// The operator to use to match the dimension with the expressions.
  pub operator as "operator,omitempty": Str = ""
} derive Json

/// SegmentFilter: SegmentFilter defines the segment to be either a simple or a sequence segment. A simple segment condition contains dimension and metric conditions to select the sessions or users. A sequence segment condition can be used to select users or sessions based on sequential conditions.
pub struct SegmentFilter {
  /// If true, match the complement of simple or sequence segment. For example, to match all visits not from "New York", we can define the segment as follows: "sessionSegment": { "segmentFilters": [{ "simpleSegment" :{ "orFiltersForSegment": [{ "segmentFilterClauses":[{ "dimensionFilter": { "dimensionName": "ga:city", "expressions": ["New York"] } }] }] }, "not": "True" }] },
  pub not as "not,omitempty": Bool = false
  /// Sequence conditions consist of one or more steps, where each step is defined by one or more dimension/metric conditions. Multiple steps can be combined with special sequence operators.
  pub sequence_segment as "sequenceSegment,omitempty": SequenceSegment? = None
  /// A Simple segment conditions consist of one or more dimension/metric conditions that can be combined
  pub simple_segment as "simpleSegment,omitempty": SimpleSegment? = None
} derive Json

/// SegmentFilterClause: Filter Clause to be used in a segment definition, can be wither a metric or a dimension filter.
pub struct SegmentFilterClause {
  /// Dimension Filter for the segment definition.
  pub dimension_filter as "dimensionFilter,omitempty": SegmentDimensionFilter? = None
  /// Metric Filter for the segment definition.
  pub metric_filter as "metricFilter,omitempty": SegmentMetricFilter? = None
  /// Matches the complement (`!`) of the filter.
  pub not as "not,omitempty": Bool = false
} derive Json

/// SegmentMetricFilter: Metric filter to be used in a segment filter clause.
pub struct SegmentMetricFilter {
  /// The value to compare against. If the operator is `BETWEEN`, this value is treated as minimum comparison value.
  pub comparison_value as "comparisonValue,omitempty": Str = ""
  /// Max comparison value is only used for `BETWEEN` operator.
  pub max_comparison_value as "maxComparisonValue,omitempty": Str = ""
  /// The metric that will be filtered on. A `metricFilter` must contain a metric name.
  pub metric_name as "metricName,omitempty": Str = ""
  /// Specifies is the operation to perform to compare the metric. The default is `EQUAL`.
  pub operator as "operator,omitempty": Str = ""
  /// Scope for a metric defines the level at which that metric is defined. The specified metric scope must be equal to or greater than its primary scope as defined in the data model. The primary scope is defined by if the segment is selecting users or sessions.
  pub scope as "scope,omitempty": Str = ""
} derive Json

/// SegmentSequenceStep: A segment sequence definition.
pub struct SegmentSequenceStep {
  /// Specifies if the step immediately precedes or can be any time before the next step.
  pub match_type as "matchType,omitempty": Str = ""
  /// A sequence is specified with a list of Or grouped filters which are combined with `AND` operator.
  pub or_filters_for_segment as "orFiltersForSegment,omitempty": List[OrFiltersForSegment] = []
} derive Json

/// SequenceSegment: Sequence conditions consist of one or more steps, where each step is defined by one or more dimension/metric conditions. Multiple steps can be combined with special sequence operators.
pub struct SequenceSegment {
  /// If set, first step condition must match the first hit of the visitor (in the date range).
  pub first_step_should_match_first_hit as "firstStepShouldMatchFirstHit,omitempty": Bool = false
  /// The list of steps in the sequence.
  pub segment_sequence_steps as "segmentSequenceSteps,omitempty": List[SegmentSequenceStep] = []
} derive Json

/// SimpleSegment: A Simple segment conditions consist of one or more dimension/metric conditions that can be combined.
pub struct SimpleSegment {
  /// A list of segment filters groups which are combined with logical `AND` operator.
  pub or_filters_for_segment as "orFiltersForSegment,omitempty": List[OrFiltersForSegment] = []
} derive Json

/// TransactionData: Represents details collected when the visitor performs a transaction on the page.
pub struct TransactionData {
  /// The transaction ID, supplied by the e-commerce tracking method, for the purchase in the shopping cart.
  pub transaction_id as "transactionId,omitempty": Str = ""
  /// The total sale revenue (excluding shipping and tax) of the transaction.
  pub transaction_revenue as "transactionRevenue,omitempty": Float = 0.0
  /// Total cost of shipping.
  pub transaction_shipping as "transactionShipping,omitempty": Float = 0.0
  /// Total tax for the transaction.
  pub transaction_tax as "transactionTax,omitempty": Float = 0.0
} derive Json

/// User: Contains information to identify a particular user uniquely.
pub struct User {
  /// Type of the user in the request. The field `userId` is associated with this type.
  pub type_ as "type,omitempty": Str = ""
  /// Unique Id of the user for which the data is being requested.
  pub user_id as "userId,omitempty": Str = ""
} derive Json

/// UserActivitySession: This represents a user session performed on a specific device at a certain time over a period of time.
pub struct UserActivitySession {
  /// Represents a detailed view into each of the activity in this session.
  pub activities as "activities,omitempty": List[Activity] = []
  /// The data source of a hit. By default, hits sent from analytics.js are reported as "web" and hits sent from the mobile SDKs are reported as "app". These values can be overridden in the Measurement Protocol.
  pub data_source as "dataSource,omitempty": Str = ""
  /// The type of device used: "mobile", "tablet" etc.
  pub device_category as "deviceCategory,omitempty": Str = ""
  /// Platform on which the activity happened: "android", "ios" etc.
  pub platform as "platform,omitempty": Str = ""
  /// Date of this session in ISO-8601 format.
  pub session_date as "sessionDate,omitempty": Str = ""
  /// Unique ID of the session.
  pub session_id as "sessionId,omitempty": Str = ""
} derive Json
