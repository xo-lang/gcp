  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"policies\":[{\"alternate\":{\"launch\":\"s-launch\"},\"dryRunSpec\":{\"etag\":\"s-etag\",\"inheritFromParent\":true,\"reset\":true,\"updateTime\":\"s-updatetime\"},\"etag\":\"s-etag\",\"name\":\"s-name\",\"spec\":{\"etag\":\"s-etag\",\"inheritFromParent\":true,\"reset\":true,\"updateTime\":\"s-updatetime\"}}]}")
  gv_queue(f, "{\"policies\":[{\"alternate\":{\"launch\":\"s-launch\"},\"dryRunSpec\":{\"etag\":\"s-etag\",\"inheritFromParent\":true,\"reset\":true,\"updateTime\":\"s-updatetime\"},\"etag\":\"s-etag\",\"name\":\"s-name\",\"spec\":{\"etag\":\"s-etag\",\"inheritFromParent\":true,\"reset\":true,\"updateTime\":\"s-updatetime\"}}]}")
  gv_note(f, "CALL orgpolicy.organizations.policies.list pages")
  var p = svc.organizations.policies.list_pages("id1/ x", options: OrganizationsPoliciesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_22)
}

