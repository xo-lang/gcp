test "Go's orgpolicy.projects.policies.patch" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"alternate\":{\"launch\":\"s-launch\",\"spec\":{\"etag\":\"s-etag\",\"inheritFromParent\":true,\"reset\":true,\"updateTime\":\"s-updatetime\"}},\"dryRunSpec\":{\"etag\":\"s-etag\",\"inheritFromParent\":true,\"reset\":true,\"rules\":[{\"allowAll\":true,\"denyAll\":true,\"enforce\":true,\"parameters\":{\"k\":\"v\"}}],\"updateTime\":\"s-updatetime\"},\"etag\":\"s-etag\",\"name\":\"s-name\",\"spec\":{\"etag\":\"s-etag\",\"inheritFromParent\":true,\"reset\":true,\"rules\":[{\"allowAll\":true,\"denyAll\":true,\"enforce\":true,\"parameters\":{\"k\":\"v\"}}],\"updateTime\":\"s-updatetime\"}}")
  gv_note(f, "CALL orgpolicy.projects.policies.patch")
  match svc.projects.policies.patch("id1/ x", json.decode_str[GoogleCloudOrgpolicyV2Policy]("{\"alternate\":{\"launch\":\"s-launch\",\"spec\":{\"etag\":\"s-etag\",\"inheritFromParent\":true,\"reset\":true,\"updateTime\":\"s-updatetime\"}},\"dryRunSpec\":{\"etag\":\"s-etag\",\"inheritFromParent\":true,\"reset\":true,\"rules\":[{\"allowAll\":true,\"denyAll\":true,\"enforce\":true,\"parameters\":{\"k\":\"v\"}}],\"updateTime\":\"s-updatetime\"},\"etag\":\"s-etag\",\"name\":\"s-name\",\"spec\":{\"etag\":\"s-etag\",\"inheritFromParent\":true,\"reset\":true,\"rules\":[{\"allowAll\":true,\"denyAll\":true,\"enforce\":true,\"parameters\":{\"k\":\"v\"}}],\"updateTime\":\"s-updatetime\"}}") ?? e => fault(e.display()), options: ProjectsPoliciesPatchOptions{update_mask: Some("s-updatemask"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_32)
}
