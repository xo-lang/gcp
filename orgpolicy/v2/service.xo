  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v2/{+name}"), {"name": name})
  let resp = r.core.client.send(gensupport.Request{method: "PATCH", url: u, query: q, headers: hs, body: gensupport.json_body(googlecloudorgpolicyv2policy, data_wrapper: false)})?
  gensupport.check(resp)?
  gensupport.decode[GoogleCloudOrgpolicyV2Policy](resp)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
  new_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
