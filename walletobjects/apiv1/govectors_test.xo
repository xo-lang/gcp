const GO_101: List[Str] = [
  "CALL walletobjects.walletobjects.v1.privateContent.setPassUpdateNotice",
  "REQ POST https://walletobjects.googleapis.com/walletobjects/v1/privateContent/setPassUpdateNotice?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"externalPassId\":\"s-externalpassid\",\"updateUri\":\"s-updateuri\",\"updatedPassJwtSignature\":\"s-updatedpassjwtsignature\"}",
  "",
  "  SERVED 200 {}",
  "OUT: {}",
]

test "Go's walletobjects.walletobjects.v1.privateContent.setPassUpdateNotice" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{}")
  gv_note(f, "CALL walletobjects.walletobjects.v1.privateContent.setPassUpdateNotice")
  match svc.walletobjects.v1.private_content.set_pass_update_notice(json.decode_str[SetPassUpdateNoticeRequest]("{\"externalPassId\":\"s-externalpassid\",\"updateUri\":\"s-updateuri\",\"updatedPassJwtSignature\":\"s-updatedpassjwtsignature\"}") ?? e => fault(e.display()), options: WalletobjectsV1PrivateContentSetPassUpdateNoticeOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_101)
}
