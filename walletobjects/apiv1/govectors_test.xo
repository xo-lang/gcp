  "REQ POST https://walletobjects.googleapis.com/walletobjects/v1/smartTap?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"id\":\"s-id\",\"infos\":[{\"action\":\"s-action\",\"signUpInfo\":{\"classId\":\"s-classid\"},\"url\":\"s-url\",\"value\":\"s-value\"}],\"kind\":\"s-kind\",\"merchantId\":\"7\"}",
  "",
  "  SERVED 200 {\"id\":\"s-id\",\"infos\":[{\"action\":\"s-action\",\"signUpInfo\":{\"classId\":\"s-classid\"},\"url\":\"s-url\",\"value\":\"s-value\"}],\"kind\":\"s-kind\",\"merchantId\":\"7\"}",
  "OUT: {\"id\":\"s-id\",\"infos\":[{\"action\":\"s-action\",\"signUpInfo\":{\"classId\":\"s-classid\"},\"url\":\"s-url\",\"value\":\"s-value\"}],\"kind\":\"s-kind\",\"merchantId\":\"7\"}",
]

test "Go's walletobjects.smarttap.insert" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"id\":\"s-id\",\"infos\":[{\"action\":\"s-action\",\"signUpInfo\":{\"classId\":\"s-classid\"},\"url\":\"s-url\",\"value\":\"s-value\"}],\"kind\":\"s-kind\",\"merchantId\":\"7\"}")
  gv_note(f, "CALL walletobjects.smarttap.insert")
  match svc.smarttap.insert(json.decode_str[SmartTap]("{\"id\":\"s-id\",\"infos\":[{\"action\":\"s-action\",\"signUpInfo\":{\"classId\":\"s-classid\"},\"url\":\"s-url\",\"value\":\"s-value\"}],\"kind\":\"s-kind\",\"merchantId\":\"7\"}") ?? e => fault(e.display()), options: SmarttapInsertOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_88)
}

