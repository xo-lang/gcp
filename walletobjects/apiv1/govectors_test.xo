data\",\"diffObjectVersion\":\"s-diffobjectversion\",\"finalStatus\":7,\"notificationType\":\"s-notificationtype\",\"physicalHeaders\":\"YWI=\",\"requestId\":\"s-requestid\",\"requestReceivedParamsServingInfo\":\"YWI=\",\"totalBytes\":\"7\",\"totalBytesIsEstimated\":true}}") ?? e => fault(e.display()), media: gensupport.Media{data: "hello media".bytes(), content_type: "text/plain"}, options: MediaUploadOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
