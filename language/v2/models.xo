pub struct XPSTablesConfidenceMetricsEntry {
  /// The confidence threshold value used to compute the metrics.
  pub confidence_threshold as "confidenceThreshold,omitempty": Float = 0.0
  /// The harmonic mean of recall and precision. (2 * precision * recall) / (precision + recall)
  pub f1_score as "f1Score,omitempty": Float = 0.0
  /// False negative count.
  pub false_negative_count as "falseNegativeCount,omitempty": Str = ""
  /// False positive count.
  pub false_positive_count as "falsePositiveCount,omitempty": Str = ""
  /// FPR = #false positives / (#false positives + #true negatives)
  pub false_positive_rate as "falsePositiveRate,omitempty": Float = 0.0
  /// Precision = #true positives / (#true positives + #false positives).
  pub precision as "precision,omitempty": Float = 0.0
  /// Recall = #true positives / (#true positives + #false negatives).
  pub recall as "recall,omitempty": Float = 0.0
  /// True negative count.
  pub true_negative_count as "trueNegativeCount,omitempty": Str = ""
  /// True positive count.
  pub true_positive_count as "truePositiveCount,omitempty": Str = ""
  /// TPR = #true positives / (#true positives + #false negatvies)
  pub true_positive_rate as "truePositiveRate,omitempty": Float = 0.0
} derive Json

