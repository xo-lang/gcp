  /// Model parameters for the trial.
  pub model_structure as "modelStructure,omitempty": XPSTablesModelStructure? = None
  /// The optimization objective evaluation of the eval split data.
  pub training_objective_point as "trainingObjectivePoint,omitempty": XPSTrainingObjectivePoint? = None
} derive Json

/// XPSVideoActionMetricsEntry: The Evaluation metrics entry given a specific precision_window_length.
pub struct XPSVideoActionMetricsEntry {
  /// Metrics for each label-match confidence_threshold from 0.05,0.10,...,0.95,0.96,0.97,0.98,0.99.
  pub confidence_metrics_entries as "confidenceMetricsEntries,omitempty": List[XPSVideoActionMetricsEntryConfidenceMetricsEntry] = []
  /// The mean average precision.
  pub mean_average_precision as "meanAveragePrecision,omitempty": Float = 0.0
  /// This VideoActionMetricsEntry is calculated based on this prediction window length. If the predicted action's timestamp is inside the time window whose center is the ground truth action's timestamp with this specific length, the prediction result is treated as a true positive.
  pub precision_window_length as "precisionWindowLength,omitempty": Str = ""
} derive Json

/// XPSVideoActionMetricsEntryConfidenceMetricsEntry: Metrics for a single confidence threshold.
pub struct XPSVideoActionMetricsEntryConfidenceMetricsEntry {
  /// Output only. The confidence threshold value used to compute the metrics.
  pub confidence_threshold as "confidenceThreshold,omitempty": Float = 0.0
  /// Output only. The harmonic mean of recall and precision.
  pub f1_score as "f1Score,omitempty": Float = 0.0
  /// Output only. Precision for the given confidence threshold.
  pub precision as "precision,omitempty": Float = 0.0
  /// Output only. Recall for the given confidence threshold.
  pub recall as "recall,omitempty": Float = 0.0
} derive Json

/// XPSVideoActionRecognitionEvaluationMetrics: Model evaluation metrics for video action recognition.
pub struct XPSVideoActionRecognitionEvaluationMetrics {
  /// Output only. The number of ground truth actions used to create this evaluation.
  pub evaluated_action_count as "evaluatedActionCount,omitempty": Int = 0
  /// Output only. The metric entries for precision window lengths: 1s,2s,3s,4s, 5s.
  pub video_action_metrics_entries as "videoActionMetricsEntries,omitempty": List[XPSVideoActionMetricsEntry] = []
} derive Json

