pub struct RunDetails {
  pub builder as "builder,omitempty": ProvenanceBuilder? = None
  pub byproducts as "byproducts,omitempty": List[ResourceDescriptor] = []
  pub metadata as "metadata,omitempty": BuildMetadata? = None
} derive Json

/// SBOMReferenceOccurrence: The occurrence representing an SBOM reference as applied to a specific resource. The occurrence follows the DSSE specification. See https://github.com/secure-systems-lab/dsse/blob/master/envelope.md for more details.
pub struct SBOMReferenceOccurrence {
  /// The actual payload that contains the SBOM reference data.
  pub payload as "payload,omitempty": SbomReferenceIntotoPayload? = None
  /// The kind of payload that SbomReferenceIntotoPayload takes. Since it's in the intoto format, this value is expected to be 'application/vnd.in-toto+json'.
  pub payload_type as "payloadType,omitempty": Str = ""
  /// The signatures over the payload.
  pub signatures as "signatures,omitempty": List[EnvelopeSignature] = []
} derive Json

/// SBOMStatus: The status of an SBOM generation.
pub struct SBOMStatus {
  /// If there was an error generating an SBOM, this will indicate what that error was.
  pub error as "error,omitempty": Str = ""
  /// The progress of the SBOM generation.
  pub sbom_state as "sbomState,omitempty": Str = ""
} derive Json

/// SbomReferenceIntotoPayload: The actual payload that contains the SBOM Reference data. The payload follows the intoto statement specification. See https://github.com/in-toto/attestation/blob/main/spec/v1.0/statement.md for more details.
pub struct SbomReferenceIntotoPayload {
  /// Identifier for the schema of the Statement.
  pub type_ as "_type,omitempty": Str = ""
  /// Additional parameters of the Predicate. Includes the actual data about the SBOM.
  pub predicate as "predicate,omitempty": SbomReferenceIntotoPredicate? = None
  /// URI identifying the type of the Predicate.
  pub predicate_type as "predicateType,omitempty": Str = ""
  /// Set of software artifacts that the attestation applies to. Each element represents a single software artifact.
  pub subject as "subject,omitempty": List[Subject] = []
} derive Json

/// SbomReferenceIntotoPredicate: A predicate which describes the SBOM being referenced.
pub struct SbomReferenceIntotoPredicate {
  /// A map of algorithm to digest of the contents of the SBOM.
  pub digest as "digest,omitempty": Map[Str, Str] = {}
  /// The location of the SBOM.
  pub location as "location,omitempty": Str = ""
  /// The mime type of the SBOM.
  pub mime_type as "mimeType,omitempty": Str = ""
  /// The person or system referring this predicate to the consumer.
  pub referrer_id as "referrerId,omitempty": Str = ""
} derive Json

/// SecretLocation: The location of the secret.
pub struct SecretLocation {
  /// The secret is found from a file.
  pub file_location as "fileLocation,omitempty": GrafeasV1FileLocation? = None
} derive Json

/// SecretOccurrence: The occurrence provides details of a secret.
pub struct SecretOccurrence {
  /// Required. Type of secret.
  pub kind as "kind,omitempty": Str = ""
  /// Optional. Locations where the secret is detected.
  pub locations as "locations,omitempty": List[SecretLocation] = []
  /// Optional. Status of the secret.
  pub statuses as "statuses,omitempty": List[SecretStatus] = []
} derive Json

/// SecretStatus: The status of the secret with a timestamp.
pub struct SecretStatus {
  /// Optional. Optional message about the status code.
  pub message as "message,omitempty": Str = ""
  /// Optional. The status of the secret.
  pub status as "status,omitempty": Str = ""
  /// Optional. The time the secret status was last updated.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

/// Signature: Verifiers (e.g. Kritis implementations) MUST verify signatures with respect to the trust anchors defined in policy (e.g. a Kritis policy). Typically this means that the verifier has been configured with a map from `public_key_id` to public key material (and any required parameters, e.g. signing algorithm). In particular, verification implementations MUST NOT treat the signature `public_key_id` as anything more than a key lookup hint. The `public_key_id` DOES NOT validate or authenticate a public key; it only provides a mechanism for quickly selecting a public key ALREADY CONFIGURED on the verifier through a trusted channel. Verification implementations MUST reject signatures in any of the following circumstances: * The `public_key_id` is not recognized by the verifier. * The public key that `public_key_id` refers to does not verify the signature with respect to the payload. The `signature` contents SHOULD NOT be "attached" (where the payload is included with the serialized `signature` bytes). Verifiers MUST ignore any "attached" payload and only verify signatures with respect to explicitly provided payload (e.g. a `payload` field on the proto message that holds this Signature, or the canonical serialization of the proto message that holds this signature).
pub struct Signature {
  /// The identifier for the public key that verifies this signature. * The `public_key_id` is required. * The `public_key_id` SHOULD be an RFC3986 conformant URI. * When possible, the `public_key_id` SHOULD be an immutable reference, such as a cryptographic digest. Examples of valid `public_key_id`s: OpenPGP V4 public key fingerprint: * "openpgp4fpr:74FAF3B861BDA0870C7B6DEF607E48D2A663AEEA" See https://www.iana.org/assignments/uri-schemes/prov/openpgp4fpr for more details on this scheme. RFC6920 digest-named SubjectPublicKeyInfo (digest of the DER serialization): * "ni:///sha-256;cD9o9Cq6LG3jD0iKXqEi_vdjJGecm_iXkbqVoScViaU" * "nih:///sha-256;703f68f42aba2c6de30f488a5ea122fef76324679c9bf89791ba95a1271589a5"
  pub public_key_id as "publicKeyId,omitempty": Str = ""
  /// The content of the signature, an opaque bytestring. The payload that this signature verifies MUST be unambiguously provided with the Signature during verification. A wrapper message might provide the payload explicitly. Alternatively, a message might have a canonical serialization that can always be unambiguously computed to derive the payload.
  pub signature as "signature,omitempty": Str = ""
} derive Json

/// SlsaBuilder:
pub struct SlsaBuilder {
  pub id as "id,omitempty": Str = ""
} derive Json

/// SlsaCompleteness: Indicates that the builder claims certain fields in this message to be complete.
pub struct SlsaCompleteness {
  /// If true, the builder claims that recipe.arguments is complete, meaning that all external inputs are properly captured in the recipe.
  pub arguments as "arguments,omitempty": Bool = false
  /// If true, the builder claims that recipe.environment is claimed to be complete.
  pub environment as "environment,omitempty": Bool = false
  /// If true, the builder claims that materials are complete, usually through some controls to prevent network access. Sometimes called "hermetic".
  pub materials as "materials,omitempty": Bool = false
} derive Json

/// SlsaMetadata: Other properties of the build.
pub struct SlsaMetadata {
  /// The timestamp of when the build completed.
  pub build_finished_on as "buildFinishedOn,omitempty": Str = ""
  /// Identifies the particular build invocation, which can be useful for finding associated logs or other ad-hoc analysis. The value SHOULD be globally unique, per in-toto Provenance spec.
  pub build_invocation_id as "buildInvocationId,omitempty": Str = ""
  /// The timestamp of when the build started.
  pub build_started_on as "buildStartedOn,omitempty": Str = ""
  /// Indicates that the builder claims certain fields in this message to be complete.
  pub completeness as "completeness,omitempty": SlsaCompleteness? = None
  /// If true, the builder claims that running the recipe on materials will produce bit-for-bit identical output.
  pub reproducible as "reproducible,omitempty": Bool = false
} derive Json

/// SlsaProvenance:
pub struct SlsaProvenance {
  /// required
  pub builder as "builder,omitempty": SlsaBuilder? = None
  /// The collection of artifacts that influenced the build including sources, dependencies, build tools, base images, and so on. This is considered to be incomplete unless metadata.completeness.materials is true. Unset or null is equivalent to empty.
  pub materials as "materials,omitempty": List[Material] = []
  pub metadata as "metadata,omitempty": SlsaMetadata? = None
  /// Identifies the configuration used for the build. When combined with materials, this SHOULD fully describe the build, such that re-running this recipe results in bit-for-bit identical output (if the build is reproducible). required
  pub recipe as "recipe,omitempty": SlsaRecipe? = None
} derive Json

/// SlsaProvenanceV1: Keep in sync with schema at https://github.com/slsa-framework/slsa/blob/main/docs/provenance/schema/v1/provenance.proto Builder renamed to ProvenanceBuilder because of Java conflicts.
pub struct SlsaProvenanceV1 {
  pub build_definition as "buildDefinition,omitempty": BuildDefinition? = None
  pub run_details as "runDetails,omitempty": RunDetails? = None
} derive Json

/// SlsaProvenanceZeroTwo: See full explanation of fields at slsa.dev/provenance/v0.2.
pub struct SlsaProvenanceZeroTwo {
  pub build_config as "buildConfig,omitempty": json.Value? = None
  pub build_type as "buildType,omitempty": Str = ""
  pub builder as "builder,omitempty": GrafeasV1SlsaProvenanceZeroTwoSlsaBuilder? = None
  pub invocation as "invocation,omitempty": GrafeasV1SlsaProvenanceZeroTwoSlsaInvocation? = None
  pub materials as "materials,omitempty": List[GrafeasV1SlsaProvenanceZeroTwoSlsaMaterial] = []
  pub metadata as "metadata,omitempty": GrafeasV1SlsaProvenanceZeroTwoSlsaMetadata? = None
} derive Json

/// SlsaRecipe: Steps taken to build the artifact. For a TaskRun, typically each container corresponds to one step in the recipe.
pub struct SlsaRecipe {
  /// Collection of all external inputs that influenced the build on top of recipe.definedInMaterial and recipe.entryPoint. For example, if the recipe type were "make", then this might be the flags passed to make aside from the target, which is captured in recipe.entryPoint. Depending on the recipe Type, the structure may be different.
  pub arguments as "arguments,omitempty": json.Value? = None
  /// Index in materials containing the recipe steps that are not implied by recipe.type. For example, if the recipe type were "make", then this would point to the source containing the Makefile, not the make program itself. Set to -1 if the recipe doesn't come from a material, as zero is default unset value for int64.
  pub defined_in_material as "definedInMaterial,omitempty": Str = ""
  /// String identifying the entry point into the build. This is often a path to a configuration file and/or a target label within that file. The syntax and meaning are defined by recipe.type. For example, if the recipe type were "make", then this would reference the directory in which to run make as well as which target to use.
  pub entry_point as "entryPoint,omitempty": Str = ""
  /// Any other builder-controlled inputs necessary for correctly evaluating the recipe. Usually only needed for reproducing the build but not evaluated as part of policy. Depending on the recipe Type, the structure may be different.
  pub environment as "environment,omitempty": json.Value? = None
  /// URI indicating what type of recipe was performed. It determines the meaning of recipe.entryPoint, recipe.arguments, recipe.environment, and materials.
  pub type_ as "type,omitempty": Str = ""
} derive Json

/// Source: Source describes the location of the source used for the build.
pub struct Source {
  /// If provided, some of the source code used for the build may be found in these locations, in the case where the source repository had multiple remotes or submodules. This list will not include the context specified in the context field.
  pub additional_contexts as "additionalContexts,omitempty": List[SourceContext] = []
  /// If provided, the input binary artifacts for the build came from this location.
  pub artifact_storage_source_uri as "artifactStorageSourceUri,omitempty": Str = ""
  /// If provided, the source code used for the build came from this location.
  pub context as "context,omitempty": SourceContext? = None
  /// Hash(es) of the build source, which can be used to verify that the original source integrity was maintained in the build. The keys to this map are file paths used as build source and the values contain the hash values for those files. If the build source came in a single package such as a gzipped tarfile (.tar.gz), the FileHash will be for the single path to that file.
  pub file_hashes as "fileHashes,omitempty": Map[Str, FileHashes] = {}
} derive Json

/// SourceContext: A SourceContext is a reference to a tree of files. A SourceContext together with a path point to a unique revision of a single file or directory.
pub struct SourceContext {
  /// A SourceContext referring to a revision in a Google Cloud Source Repo.
  pub cloud_repo as "cloudRepo,omitempty": CloudRepoSourceContext? = None
  /// A SourceContext referring to a Gerrit project.
  pub gerrit as "gerrit,omitempty": GerritSourceContext? = None
  /// A SourceContext referring to any third party Git repo (e.g., GitHub).
  pub git as "git,omitempty": GitSourceContext? = None
  /// Labels with user defined metadata.
  pub labels as "labels,omitempty": Map[Str, Str] = {}
} derive Json

/// Status: The `Status` type defines a logical error model that is suitable for different programming environments, including REST APIs and RPC APIs. It is used by [gRPC](https://github.com/grpc). Each `Status` message contains three pieces of data: error code, error message, and error details. You can find out more about this error model and how to work with it in the [API Design Guide](https://cloud.google.com/apis/design/errors).
pub struct Status {
  /// The status code, which should be an enum value of google.rpc.Code.
  pub code as "code,omitempty": Int = 0
  /// A list of messages that carry the error details. There is a common set of message types for APIs to use.
  pub details as "details,omitempty": List[json.Value] = []
  /// A developer-facing error message, which should be in English. Any user-facing error message should be localized and sent in the google.rpc.Status.details field, or localized by the client.
  pub message as "message,omitempty": Str = ""
} derive Json

/// Subject:
pub struct Subject {
  /// `"": ""` Algorithms can be e.g. sha256, sha512 See https://github.com/in-toto/attestation/blob/main/spec/field_types.md#DigestSet
  pub digest as "digest,omitempty": Map[Str, Str] = {}
  pub name as "name,omitempty": Str = ""
} derive Json

/// TokenUsage: Token usage associated with an AI scan.
pub struct TokenUsage {
  /// Cache matched tokens for implicit cache.
  pub cache_count as "cacheCount,omitempty": Str = ""
  /// Tokens in the model response.
  pub candidate_count as "candidateCount,omitempty": Str = ""
  /// Tokens in the user request.
  pub prompt_count as "promptCount,omitempty": Str = ""
  /// Tokens in the thinking output.
  pub thinking_count as "thinkingCount,omitempty": Str = ""
  /// Prompt tokens for using tools.
  pub tool_use_prompt_count as "toolUsePromptCount,omitempty": Str = ""
} derive Json

/// UpgradeDistribution: The Upgrade Distribution represents metadata about the Upgrade for each operating system (CPE). Some distributions have additional metadata around updates, classifying them into various categories and severities.
pub struct UpgradeDistribution {
  /// The operating system classification of this Upgrade, as specified by the upstream operating system upgrade feed. For Windows the classification is one of the category_ids listed at https://docs.microsoft.com/en-us/previous-versions/windows/desktop/ff357803(v=vs.85)
  pub classification as "classification,omitempty": Str = ""
  /// Required - The specific operating system this metadata applies to. See https://cpe.mitre.org/specification/.
  pub cpe_uri as "cpeUri,omitempty": Str = ""
  /// The cve tied to this Upgrade.
  pub cve as "cve,omitempty": List[Str] = []
  /// The severity as specified by the upstream operating system.
  pub severity as "severity,omitempty": Str = ""
} derive Json

/// UpgradeOccurrence: An Upgrade Occurrence represents that a specific resource_url could install a specific upgrade. This presence is supplied via local sources (i.e. it is present in the mirror and the running system has noticed its availability). For Windows, both distribution and windows_update contain information for the Windows update.
pub struct UpgradeOccurrence {
  /// Metadata about the upgrade for available for the specific operating system for the resource_url. This allows efficient filtering, as well as making it easier to use the occurrence.
  pub distribution as "distribution,omitempty": UpgradeDistribution? = None
  /// Required for non-Windows OS. The package this Upgrade is for.
  pub package as "package,omitempty": Str = ""
  /// Required for non-Windows OS. The version of the package in a machine + human readable form.
  pub parsed_version as "parsedVersion,omitempty": Version? = None
  /// Required for Windows OS. Represents the metadata about the Windows update.
  pub windows_update as "windowsUpdate,omitempty": WindowsUpdate? = None
} derive Json

/// Version: Version contains structured information about the version of a package.
pub struct Version {
  /// Used to correct mistakes in the version numbering scheme.
  pub epoch as "epoch,omitempty": Int = 0
  /// Human readable version string. This string is of the form :- and is only set when kind is NORMAL.
  pub full_name as "fullName,omitempty": Str = ""
  /// Whether this version is specifying part of an inclusive range. Grafeas does not have the capability to specify version ranges; instead we have fields that specify start version and end versions. At times this is insufficient - we also need to specify whether the version is included in the range or is excluded from the range. This boolean is expected to be set to true when the version is included in a range.
  pub inclusive as "inclusive,omitempty": Bool = false
  /// Required. Distinguishes between sentinel MIN/MAX versions and normal versions.
  pub kind as "kind,omitempty": Str = ""
  /// Required only when version kind is NORMAL. The main part of the version name.
  pub name as "name,omitempty": Str = ""
  /// The iteration of the package build from the above version.
  pub revision as "revision,omitempty": Str = ""
} derive Json

/// VexAssessment: VexAssessment provides all publisher provided Vex information that is related to this vulnerability.
pub struct VexAssessment {
  /// Holds the MITRE standard Common Vulnerabilities and Exposures (CVE) tracking number for the vulnerability. Deprecated: Use vulnerability_id instead to denote CVEs.
  pub cve as "cve,omitempty": Str = ""
  /// Contains information about the impact of this vulnerability, this will change with time.
  pub impacts as "impacts,omitempty": List[Str] = []
  /// Justification provides the justification when the state of the assessment if NOT_AFFECTED.
  pub justification as "justification,omitempty": Justification? = None
  /// The VulnerabilityAssessment note from which this VexAssessment was generated. This will be of the form: `projects/[PROJECT_ID]/notes/[NOTE_ID]`.
  pub note_name as "noteName,omitempty": Str = ""
  /// Holds a list of references associated with this vulnerability item and assessment.
  pub related_uris as "relatedUris,omitempty": List[RelatedUrl] = []
  /// Specifies details on how to handle (and presumably, fix) a vulnerability.
  pub remediations as "remediations,omitempty": List[Remediation] = []
  /// Provides the state of this Vulnerability assessment.
  pub state as "state,omitempty": Str = ""
  /// The vulnerability identifier for this Assessment. Will hold one of common identifiers e.g. CVE, GHSA etc.
  pub vulnerability_id as "vulnerabilityId,omitempty": Str = ""
} derive Json

/// VulnerabilityOccurrence: An occurrence of a severity vulnerability on a resource.
pub struct VulnerabilityOccurrence {
  /// Output only. The CVSS score of this vulnerability. CVSS score is on a scale of 0 - 10 where 0 indicates low severity and 10 indicates high severity.
  pub cvss_score as "cvssScore,omitempty": Float = 0.0
  /// The cvss v2 score for the vulnerability.
  pub cvss_v2 as "cvssV2,omitempty": CVSS? = None
  /// The cvss v4 score for the vulnerability.
  pub cvss_v4 as "cvssV4,omitempty": CVSS? = None
  /// Output only. CVSS version used to populate cvss_score and severity.
  pub cvss_version as "cvssVersion,omitempty": Str = ""
  /// The cvss v3 score for the vulnerability.
  pub cvssv3 as "cvssv3,omitempty": CVSS? = None
  /// The distro assigned severity for this vulnerability when it is available, otherwise this is the note provider assigned severity. When there are multiple PackageIssues for this vulnerability, they can have different effective severities because some might be provided by the distro while others are provided by the language ecosystem for a language pack. For this reason, it is advised to use the effective severity on the PackageIssue level. In the case where multiple PackageIssues have differing effective severities, this field should be the highest severity for any of the PackageIssues.
  pub effective_severity as "effectiveSeverity,omitempty": Str = ""
  /// Output only. Rollup of exploitability across all PackageIssues in this occurrence.
  pub exploitability as "exploitability,omitempty": Exploitability? = None
  /// Occurrence-specific extra details about the vulnerability.
  pub extra_details as "extraDetails,omitempty": Str = ""
  /// Output only. Whether at least one of the affected packages has a fix available.
  pub fix_available as "fixAvailable,omitempty": Bool = false
  /// Output only. A detailed description of this vulnerability.
  pub long_description as "longDescription,omitempty": Str = ""
  /// Required. The set of affected locations and their fixes (if available) within the associated resource.
  pub package_issue as "packageIssue,omitempty": List[PackageIssue] = []
  /// Output only. URLs related to this vulnerability.
  pub related_urls as "relatedUrls,omitempty": List[RelatedUrl] = []
  /// Risk information about the vulnerability, such as CISA, EPSS, etc.
  pub risk as "risk,omitempty": Risk? = None
  /// Output only. The note provider assigned severity of this vulnerability.
  pub severity as "severity,omitempty": Str = ""
  /// Output only. A one sentence description of this vulnerability.
  pub short_description as "shortDescription,omitempty": Str = ""
  /// The type of package; whether native or non native (e.g., ruby gems, node.js packages, etc.).
  pub type_ as "type,omitempty": Str = ""
  pub vex_assessment as "vexAssessment,omitempty": VexAssessment? = None
} derive Json

/// WindowsUpdate: Windows Update represents the metadata about the update for the Windows operating system. The fields in this message come from the Windows Update API documented at https://docs.microsoft.com/en-us/windows/win32/api/wuapi/nn-wuapi-iupdate.
pub struct WindowsUpdate {
  /// The list of categories to which the update belongs.
  pub categories as "categories,omitempty": List[Category] = []
  /// The localized description of the update.
  pub description as "description,omitempty": Str = ""
  /// Required - The unique identifier for the update.
  pub identity as "identity,omitempty": Identity? = None
  /// The Microsoft Knowledge Base article IDs that are associated with the update.
  pub kb_article_ids as "kbArticleIds,omitempty": List[Str] = []
  /// The last published timestamp of the update.
  pub last_published_timestamp as "lastPublishedTimestamp,omitempty": Str = ""
  /// The hyperlink to the support information for the update.
  pub support_url as "supportUrl,omitempty": Str = ""
  /// The localized title of the update.
  pub title as "title,omitempty": Str = ""
} derive Json

/// WorkspacePolicyResult: Result of Workspace Policy scan.
pub struct WorkspacePolicyResult {
  /// Status of the scan.
  pub scan_status as "scanStatus,omitempty": Str = ""
  /// Verdict of the scan.
  pub verdict as "verdict,omitempty": Str = ""
} derive Json
