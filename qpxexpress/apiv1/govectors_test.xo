// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 qpxexpress/v1 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://www.googleapis.com"

const GO_0: List[Str] = [
  "CALL qpxExpress.trips.search",
  "REQ POST https://www.googleapis.com/qpxExpress/v1/trips/search?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"request\":{\"maxPrice\":\"s-maxprice\",\"passengers\":{\"adultCount\":7,\"childCount\":7,\"infantInLapCount\":7,\"infantInSeatCount\":7,\"kind\":\"s-kind\",\"seniorCount\":7},\"refundable\":true,\"saleCountry\":\"s-salecountry\",\"slice\":[{\"alliance\":\"s-alliance\",\"date\":\"s-date\",\"destination\":\"s-destination\",\"kind\":\"s-kind\",\"maxConnectionDuration\":7,\"maxStops\":7,\"origin\":\"s-origin\",\"preferredCabin\":\"s-preferredcabin\"}],\"solutions\":7,\"ticketingCountry\":\"s-ticketingcountry\"}}",
  "",
  "  SERVED 200 {\"kind\":\"s-kind\",\"trips\":{\"data\":{\"kind\":\"s-kind\"},\"kind\":\"s-kind\",\"requestId\":\"s-requestid\",\"tripOption\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"saleTotal\":\"s-saletotal\"}]}}",
  "OUT: {\"kind\":\"s-kind\",\"trips\":{\"data\":{\"kind\":\"s-kind\"},\"kind\":\"s-kind\",\"requestId\":\"s-requestid\",\"tripOption\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"saleTotal\":\"s-saletotal\"}]}}",
]

test "Go's qpxExpress.trips.search" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"kind\":\"s-kind\",\"trips\":{\"data\":{\"kind\":\"s-kind\"},\"kind\":\"s-kind\",\"requestId\":\"s-requestid\",\"tripOption\":[{\"id\":\"s-id\",\"kind\":\"s-kind\",\"saleTotal\":\"s-saletotal\"}]}}")
  gv_note(f, "CALL qpxExpress.trips.search")
  match svc.trips.search(json.decode_str[TripsSearchRequest]("{\"request\":{\"maxPrice\":\"s-maxprice\",\"passengers\":{\"adultCount\":7,\"childCount\":7,\"infantInLapCount\":7,\"infantInSeatCount\":7,\"kind\":\"s-kind\",\"seniorCount\":7},\"refundable\":true,\"saleCountry\":\"s-salecountry\",\"slice\":[{\"alliance\":\"s-alliance\",\"date\":\"s-date\",\"destination\":\"s-destination\",\"kind\":\"s-kind\",\"maxConnectionDuration\":7,\"maxStops\":7,\"origin\":\"s-origin\",\"preferredCabin\":\"s-preferredcabin\"}],\"solutions\":7,\"ticketingCountry\":\"s-ticketingcountry\"}}") ?? e => fault(e.display()), options: TripsSearchOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
