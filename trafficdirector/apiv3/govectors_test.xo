// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 trafficdirector/v3 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://trafficdirector.googleapis.com"

const GO_0: List[Str] = [
  "CALL trafficdirector.discovery.client_status",
  "REQ POST https://trafficdirector.googleapis.com/v3/discovery:client_status?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"excludeResourceContents\":true,\"node\":{\"clientFeatures\":[\"s-clientfeatures\"],\"cluster\":\"s-cluster\",\"dynamicParameters\":{\"k1\":{}},\"extensions\":[{\"category\":\"s-category\",\"disabled\":true,\"name\":\"s-name\",\"typeDescriptor\":\"s-typedescriptor\"}],\"id\":\"s-id\",\"listeningAddresses\":[{}],\"locality\":{\"region\":\"s-region\",\"subZone\":\"s-subzone\",\"zone\":\"s-zone\"},\"metadata\":{\"k\":\"v\"},\"userAgentBuildVersion\":{\"metadata\":{\"k\":\"v\"}},\"userAgentName\":\"s-useragentname\",\"userAgentVersion\":\"s-useragentversion\"},\"nodeMatchers\":[{\"nodeId\":{\"contains\":\"s-contains\",\"exact\":\"s-exact\",\"ignoreCase\":true,\"prefix\":\"s-prefix\",\"suffix\":\"s-suffix\"}}]}",
  "",
  "  SERVED 200 {\"config\":[{\"clientScope\":\"s-clientscope\",\"node\":{\"cluster\":\"s-cluster\",\"id\":\"s-id\",\"metadata\":{\"k\":\"v\"},\"userAgentName\":\"s-useragentname\",\"userAgentVersion\":\"s-useragentversion\"}}]}",
  "OUT: {\"config\":[{\"clientScope\":\"s-clientscope\",\"node\":{\"cluster\":\"s-cluster\",\"id\":\"s-id\",\"metadata\":{\"k\":\"v\"},\"userAgentName\":\"s-useragentname\",\"userAgentVersion\":\"s-useragentversion\"}}]}",
]

test "Go's trafficdirector.discovery.client_status" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"config\":[{\"clientScope\":\"s-clientscope\",\"node\":{\"cluster\":\"s-cluster\",\"id\":\"s-id\",\"metadata\":{\"k\":\"v\"},\"userAgentName\":\"s-useragentname\",\"userAgentVersion\":\"s-useragentversion\"}}]}")
  gv_note(f, "CALL trafficdirector.discovery.client_status")
  match svc.discovery.client_status(json.decode_str[ClientStatusRequest]("{\"excludeResourceContents\":true,\"node\":{\"clientFeatures\":[\"s-clientfeatures\"],\"cluster\":\"s-cluster\",\"dynamicParameters\":{\"k1\":{}},\"extensions\":[{\"category\":\"s-category\",\"disabled\":true,\"name\":\"s-name\",\"typeDescriptor\":\"s-typedescriptor\"}],\"id\":\"s-id\",\"listeningAddresses\":[{}],\"locality\":{\"region\":\"s-region\",\"subZone\":\"s-subzone\",\"zone\":\"s-zone\"},\"metadata\":{\"k\":\"v\"},\"userAgentBuildVersion\":{\"metadata\":{\"k\":\"v\"}},\"userAgentName\":\"s-useragentname\",\"userAgentVersion\":\"s-useragentversion\"},\"nodeMatchers\":[{\"nodeId\":{\"contains\":\"s-contains\",\"exact\":\"s-exact\",\"ignoreCase\":true,\"prefix\":\"s-prefix\",\"suffix\":\"s-suffix\"}}]}") ?? e => fault(e.display()), options: DiscoveryClientStatusOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
