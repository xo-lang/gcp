// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 trafficdirector/v2 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://trafficdirector.googleapis.com"

const GO_0: List[Str] = [
  "CALL trafficdirector.discovery.client_status",
  "REQ POST https://trafficdirector.googleapis.com/v2/discovery:client_status?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"nodeMatchers\":[{\"nodeId\":{\"exact\":\"s-exact\",\"ignoreCase\":true,\"prefix\":\"s-prefix\",\"regex\":\"s-regex\",\"suffix\":\"s-suffix\"}}]}",
  "",
  "  SERVED 200 {\"config\":[{\"node\":{\"buildVersion\":\"s-buildversion\",\"cluster\":\"s-cluster\",\"id\":\"s-id\",\"metadata\":{\"k\":\"v\"},\"userAgentName\":\"s-useragentname\",\"userAgentVersion\":\"s-useragentversion\"}}]}",
  "OUT: {\"config\":[{\"node\":{\"buildVersion\":\"s-buildversion\",\"cluster\":\"s-cluster\",\"id\":\"s-id\",\"metadata\":{\"k\":\"v\"},\"userAgentName\":\"s-useragentname\",\"userAgentVersion\":\"s-useragentversion\"}}]}",
]

test "Go's trafficdirector.discovery.client_status" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"config\":[{\"node\":{\"buildVersion\":\"s-buildversion\",\"cluster\":\"s-cluster\",\"id\":\"s-id\",\"metadata\":{\"k\":\"v\"},\"userAgentName\":\"s-useragentname\",\"userAgentVersion\":\"s-useragentversion\"}}]}")
  gv_note(f, "CALL trafficdirector.discovery.client_status")
  match svc.discovery.client_status(json.decode_str[ClientStatusRequest]("{\"nodeMatchers\":[{\"nodeId\":{\"exact\":\"s-exact\",\"ignoreCase\":true,\"prefix\":\"s-prefix\",\"regex\":\"s-regex\",\"suffix\":\"s-suffix\"}}]}") ?? e => fault(e.display()), options: DiscoveryClientStatusOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
