test "Go's networksecurity.projects.locations.urlLists.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"unreachable\":[\"s-unreachable\"],\"urlLists\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"name\":\"s-name\",\"updateTime\":\"s-updatetime\",\"values\":[\"s-values\"]}]}")
  gv_queue(f, "{\"unreachable\":[\"s-unreachable\"],\"urlLists\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"name\":\"s-name\",\"updateTime\":\"s-updatetime\",\"values\":[\"s-values\"]}]}")
  gv_note(f, "CALL networksecurity.projects.locations.urlLists.list pages")
  var p = svc.projects.locations.url_lists.list_pages("id1/ x", options: ProjectsLocationsUrlListsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_226)
}

