  gv_queue(f, "{\"dnsThreatDetectors\":[{\"createTime\":\"s-createtime\",\"excludedNetworks\":[\"s-excludednetworks\"],\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"provider\":\"s-provider\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
