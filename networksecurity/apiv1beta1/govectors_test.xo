  gv_queue(f, "{\"interceptDeploymentGroups\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"network\":\"s-network\",\"reconciling\":true,\"state\":\"s-state\",\"updateTime\":\"s-updatetime\"}]}")
