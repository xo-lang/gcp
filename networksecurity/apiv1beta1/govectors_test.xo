  gv_queue(f, "{\"clientTlsPolicies\":[{\"clientCertificate\":{},\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"sni\":\"s-sni\",\"updateTime\":\"s-updatetime\"}]}")
