  "REQ POST https://workstations.googleapis.com/v1/id1/%20x:suspend?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"etag\":\"s-etag\",\"validateOnly\":true}",
  "",
  "  SERVED 200 {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}",
  "OUT: {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}",
]

test "Go's workstations.projects.locations.workstationClusters.workstationConfigs.workstations.suspend" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}")
  gv_note(f, "CALL workstations.projects.locations.workstationClusters.workstationConfigs.workstations.suspend")
  match svc.projects.locations.workstation_clusters.workstation_configs.workstations.suspend("id1/ x", json.decode_str[SuspendWorkstationRequest]("{\"etag\":\"s-etag\",\"validateOnly\":true}") ?? e => fault(e.display()), options: ProjectsLocationsWorkstationClustersWorkstationConfigsWorkstationsSuspendOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_31)
}

