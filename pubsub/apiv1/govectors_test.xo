test "Go's pubsub.projects.topics.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"topics\":[{\"ingestionDataSourceSettings\":{},\"kmsKeyName\":\"s-kmskeyname\",\"labels\":{\"k1\":\"s-labels\"},\"messageRetentionDuration\":\"s-messageretentionduration\",\"messageStoragePolicy\":{\"enforceInTransit\":true},\"name\":\"s-name\",\"satisfiesPzs\":true,\"schemaSettings\":{\"encoding\":\"s-encoding\",\"firstRevisionId\":\"s-firstrevisionid\",\"lastRevisionId\":\"s-lastrevisionid\",\"schema\":\"s-schema\"},\"state\":\"s-state\",\"tags\":{\"k1\":\"s-tags\"}}]}")
  gv_queue(f, "{\"topics\":[{\"ingestionDataSourceSettings\":{},\"kmsKeyName\":\"s-kmskeyname\",\"labels\":{\"k1\":\"s-labels\"},\"messageRetentionDuration\":\"s-messageretentionduration\",\"messageStoragePolicy\":{\"enforceInTransit\":true},\"name\":\"s-name\",\"satisfiesPzs\":true,\"schemaSettings\":{\"encoding\":\"s-encoding\",\"firstRevisionId\":\"s-firstrevisionid\",\"lastRevisionId\":\"s-lastrevisionid\",\"schema\":\"s-schema\"},\"state\":\"s-state\",\"tags\":{\"k1\":\"s-tags\"}}]}")
  gv_note(f, "CALL pubsub.projects.topics.list pages")
  var p = svc.projects.topics.list_pages("id1/ x", options: ProjectsTopicsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_44)
}

