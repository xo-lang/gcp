  if let Some(c) = m.push_config {
    o = gensupport.mark_field(o, "pushConfig", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  gensupport.mark(o, m.force_send_fields.map(subscription_field_entry), m.null_fields.map(subscription_field_entry))
}

/// Topic: A topic resource.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct Topic {
  /// Name of the topic.
  pub name as "name,omitempty": Str = ""
  pub force_send_fields as "-": List[TopicField] = []
  pub null_fields as "-": List[TopicField] = []
} derive Json

/// TopicField: Topic's fields, for force_send_fields and null_fields.
pub enum TopicField {
  Name
}

fn topic_field_entry(f: TopicField) -> Str {
  match f {
    Name => "name=\"\""
  }
}

/// body_marked: whether m, or a model in it, sets force_send_fields or
/// null_fields (decision 0013; the service's request bodies ask).
pub fn (m: Topic) body_marked() -> Bool {
  if m.force_send_fields.len() > 0 || m.null_fields.len() > 0 {
    return true
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: Topic) body_mark(v: json.Value) -> json.Value {
  var o = v
  gensupport.mark(o, m.force_send_fields.map(topic_field_entry), m.null_fields.map(topic_field_entry))
}
