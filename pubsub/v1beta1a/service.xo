pub fn (r: TopicsService[fx]) publish_batch(publishbatchrequest: PublishBatchRequest, options: TopicsPublishBatchOptions = TopicsPublishBatchOptions{}) -> PublishBatchResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs.push(("Content-Type", "application/json"))
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v1beta1a/topics/publishBatch"), {})
  let resp = r.core.client.send(gensupport.Request{method: "POST", url: u, query: q, headers: hs, body: gensupport.json_body(publishbatchrequest, data_wrapper: false)})?
  gensupport.check(resp)?
  gensupport.decode[PublishBatchResponse](resp)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
  new_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
