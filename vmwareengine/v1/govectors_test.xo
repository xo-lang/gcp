  gv_queue(f, "{\"datastores\":[{\"clusters\":[\"s-clusters\"],\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"nfsDatastore\":{},\"state\":\"s-state\",\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL vmwareengine.projects.locations.datastores.list pages")
  var p = svc.projects.locations.datastores.list_pages("id1/ x", options: ProjectsLocationsDatastoresListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), request_id: Some("s-requestid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
