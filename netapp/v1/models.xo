/// Volume: Volume provides a filesystem that you can mount.
pub struct Volume {
  /// Output only. Specifies the ActiveDirectory name of a SMB volume.
  pub active_directory as "activeDirectory,omitempty": Str = ""
  /// BackupConfig of the volume.
  pub backup_config as "backupConfig,omitempty": BackupConfig? = None
  /// Optional. Block devices for the volume. Currently, only one block device is permitted per Volume.
  pub block_devices as "blockDevices,omitempty": List[BlockDevice] = []
  /// Optional. Cache parameters for the volume.
  pub cache_parameters as "cacheParameters,omitempty": CacheParameters? = None
  /// Required. Capacity in GIB of the volume
  pub capacity_gib as "capacityGib,omitempty,string": Int = 0
  /// Output only. If this volume is a clone, this field contains details about the clone.
  pub clone_details as "cloneDetails,omitempty": CloneDetails? = None
  /// Output only. Size of the volume cold tier data rounded down to the nearest GiB.
  pub cold_tier_size_gib as "coldTierSizeGib,omitempty,string": Int = 0
  /// Output only. Create time of the volume
  pub create_time as "createTime,omitempty": Str = ""
  /// Optional. Description of the volume
  pub description as "description,omitempty": Str = ""
  /// Output only. Specified the current volume encryption key source.
  pub encryption_type as "encryptionType,omitempty": Str = ""
  /// Optional. Export policy of the volume
  pub export_policy as "exportPolicy,omitempty": ExportPolicy? = None
  /// Output only. Indicates whether the volume is part of a replication relationship.
  pub has_replication as "hasReplication,omitempty": Bool = false
  /// Output only. Total hot tier data rounded down to the nearest GiB used by the Volume. This field is only used for flex Service Level
  pub hot_tier_size_used_gib as "hotTierSizeUsedGib,omitempty,string": Int = 0
  /// Optional. The Hybrid Replication parameters for the volume.
  pub hybrid_replication_parameters as "hybridReplicationParameters,omitempty": HybridReplicationParameters? = None
  /// Optional. Flag indicating if the volume is a kerberos volume or not, export policy rules control kerberos security modes (krb5, krb5i, krb5p).
  pub kerberos_enabled as "kerberosEnabled,omitempty": Bool = false
  /// Output only. Specifies the KMS config to be used for volume encryption.
  pub kms_config as "kmsConfig,omitempty": Str = ""
  /// Optional. Labels as key value pairs
  pub labels as "labels,omitempty": Map[Str, Str] = {}
  /// Optional. Flag indicating if the volume will be a large capacity volume or a regular volume. This field is used for legacy FILE pools. For Unified pools, use the `large_capacity_config` field instead. This field and `large_capacity_config` are mutually exclusive.
  pub large_capacity as "largeCapacity,omitempty": Bool = false
  /// Optional. Large capacity config for the volume. Enables and configures large capacity for volumes in Unified pools with File protocols. Not applicable for Block protocols in Unified pools. This field and the legacy `large_capacity` boolean field are mutually exclusive.
  pub large_capacity_config as "largeCapacityConfig,omitempty": LargeCapacityConfig? = None
  /// Output only. Flag indicating if the volume is NFS LDAP enabled or not.
  pub ldap_enabled as "ldapEnabled,omitempty": Bool = false
  /// Output only. Mount options of this volume
  pub mount_options as "mountOptions,omitempty": List[MountOption] = []
  /// Optional. Flag indicating if the volume will have an IP address per node for volumes supporting multiple IP endpoints. Only the volume with large_capacity will be allowed to have multiple endpoints.
  pub multiple_endpoints as "multipleEndpoints,omitempty": Bool = false
  /// Identifier. Name of the volume
  pub name as "name,omitempty": Str = ""
  /// Output only. VPC Network name. Format: projects/{project}/global/networks/{network}
  pub network as "network,omitempty": Str = ""
  /// Required. Protocols required for the volume
  pub protocols as "protocols,omitempty": List[Str] = []
  /// Output only. This field is not implemented. The values provided in this field are ignored.
  pub psa_range as "psaRange,omitempty": Str = ""
  /// Output only. Specifies the replica zone for regional volume.
  pub replica_zone as "replicaZone,omitempty": Str = ""
  /// Optional. Specifies the source of the volume to be created from.
  pub restore_parameters as "restoreParameters,omitempty": RestoreParameters? = None
  /// Optional. List of actions that are restricted on this volume.
  pub restricted_actions as "restrictedActions,omitempty": List[Str] = []
  /// Optional. Security Style of the Volume
  pub security_style as "securityStyle,omitempty": Str = ""
  /// Output only. Service level of the volume
  pub service_level as "serviceLevel,omitempty": Str = ""
  /// Required. Share name of the volume
  pub share_name as "shareName,omitempty": Str = ""
  /// Optional. SMB share settings for the volume.
  pub smb_settings as "smbSettings,omitempty": List[Str] = []
  /// Optional. Snap_reserve specifies percentage of volume storage reserved for snapshot storage. Default is 0 percent.
  pub snap_reserve as "snapReserve,omitempty": Float = 0.0
  /// Optional. Snapshot_directory if enabled (true) the volume will contain a read-only .snapshot directory which provides access to each of the volume's snapshots.
  pub snapshot_directory as "snapshotDirectory,omitempty": Bool = false
  /// Optional. SnapshotPolicy for a volume.
  pub snapshot_policy as "snapshotPolicy,omitempty": SnapshotPolicy? = None
  /// Output only. State of the volume
  pub state as "state,omitempty": Str = ""
  /// Output only. State details of the volume
  pub state_details as "stateDetails,omitempty": Str = ""
  /// Required. StoragePool name of the volume
  pub storage_pool as "storagePool,omitempty": Str = ""
  /// Optional. Throughput of the volume (in MiB/s)
  pub throughput_mibps as "throughputMibps,omitempty": Float = 0.0
  /// Tiering policy for the volume.
  pub tiering_policy as "tieringPolicy,omitempty": TieringPolicy? = None
  /// Optional. Default unix style permission (e.g. 777) the mount point will be created with. Applicable for NFS protocol types only.
  pub unix_permissions as "unixPermissions,omitempty": Str = ""
  /// Output only. Used capacity in GIB of the volume. This is computed periodically and it does not represent the realtime usage.
  pub used_gib as "usedGib,omitempty,string": Int = 0
  /// Output only. Specifies the active zone for regional volume.
  pub zone as "zone,omitempty": Str = ""
} derive Json

/// VolumeBackupConfig: Backup configuration for a volume in a pool.
pub struct VolumeBackupConfig {
  /// Backup configuration for the volume.
  pub backup_config as "backupConfig,omitempty": BackupConfig? = None
  /// Provides the Ontap UUID of the volume within the pool.
  pub volume_uuid as "volumeUuid,omitempty": Str = ""
} derive Json

/// WeeklySchedule: Make a snapshot every week e.g. at Monday 04:00, Wednesday 05:20, Sunday 23:50
pub struct WeeklySchedule {
  /// Set the day or days of the week to make a snapshot. Accepts a comma separated days of the week. Defaults to 'Sunday'.
  pub day as "day,omitempty": Str = ""
  /// Set the hour to start the snapshot (0-23), defaults to midnight (0).
  pub hour as "hour,omitempty": Float = 0.0
  /// Set the minute of the hour to start the snapshot (0-59), defaults to the top of the hour (0).
  pub minute as "minute,omitempty": Float = 0.0
  /// The maximum number of Snapshots to keep for the hourly schedule
  pub snapshots_to_keep as "snapshotsToKeep,omitempty": Float = 0.0
} derive Json
