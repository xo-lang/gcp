/// TieringPolicy: Defines tiering policy for the volume.
pub struct TieringPolicy {
  /// Optional. Time in days to mark the volume's data block as cold and make it eligible for tiering, can be range from 2-183. Default is 31.
  pub cooling_threshold_days as "coolingThresholdDays,omitempty": Int = 0
  /// Optional. Flag indicating that the hot tier bypass mode is enabled. Default is false. This is only applicable to Flex service level.
  pub hot_tier_bypass_mode_enabled as "hotTierBypassModeEnabled,omitempty": Bool = false
  /// Optional. Flag indicating if the volume has tiering policy enable/pause. Default is PAUSED.
  pub tier_action as "tierAction,omitempty": Str = ""
} derive Json

/// TransferStats: TransferStats reports all statistics related to replication transfer.
pub struct TransferStats {
  /// Lag duration indicates the duration by which Destination region volume content lags behind the primary region volume content.
  pub lag_duration as "lagDuration,omitempty": Str = ""
  /// Last transfer size in bytes.
  pub last_transfer_bytes as "lastTransferBytes,omitempty,string": Int = 0
  /// Time taken during last transfer.
  pub last_transfer_duration as "lastTransferDuration,omitempty": Str = ""
  /// Time when last transfer completed.
  pub last_transfer_end_time as "lastTransferEndTime,omitempty": Str = ""
  /// A message describing the cause of the last transfer failure.
  pub last_transfer_error as "lastTransferError,omitempty": Str = ""
  /// Cumulative time taken across all transfers for the replication relationship.
  pub total_transfer_duration as "totalTransferDuration,omitempty": Str = ""
  /// Cumulative bytes transferred so far for the replication relationship.
  pub transfer_bytes as "transferBytes,omitempty,string": Int = 0
  /// Time when progress was updated last.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

