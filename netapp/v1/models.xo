  pub global_access_allowed as "globalAccessAllowed,omitempty": Bool = false
  /// Optional. Total hot tier capacity for the Storage Pool. It is applicable only to Flex service level. It should be less than the minimum storage pool size and cannot be more than the current storage pool size. It cannot be decreased once set.
  pub hot_tier_size_gib as "hotTierSizeGib,omitempty,string": Int = 0
  /// Output only. Total hot tier data rounded down to the nearest GiB used by the storage pool.
  pub hot_tier_size_used_gib as "hotTierSizeUsedGib,omitempty,string": Int = 0
  /// Optional. Specifies the KMS config to be used for volume encryption.
  pub kms_config as "kmsConfig,omitempty": Str = ""
  /// Optional. Labels as key value pairs
  pub labels as "labels,omitempty": Map[Str, Str] = {}
  /// Optional. Flag indicating if the pool is NFS LDAP enabled or not.
  pub ldap_enabled as "ldapEnabled,omitempty": Bool = false
  /// Optional. Mode of the storage pool. This field is used to control whether the user can perform ONTAP operations on the storage pool using the GCNV ONTAP Mode APIs. If not specified during creation, it defaults to `DEFAULT`.
  pub mode as "mode,omitempty": Str = ""
  /// Identifier. Name of the storage pool
  pub name as "name,omitempty": Str = ""
  /// Required. VPC Network name. Format: projects/{project}/global/networks/{network}
  pub network as "network,omitempty": Str = ""
  /// Optional. This field is not implemented. The values provided in this field are ignored.
  pub psa_range as "psaRange,omitempty": Str = ""
  /// Optional. QoS (Quality of Service) Type of the storage pool
  pub qos_type as "qosType,omitempty": Str = ""
  /// Optional. Specifies the replica zone for regional storagePool.
  pub replica_zone as "replicaZone,omitempty": Str = ""
  /// Output only. Reserved for future use
  pub satisfies_pzi as "satisfiesPzi,omitempty": Bool = false
  /// Output only. Reserved for future use
  pub satisfies_pzs as "satisfiesPzs,omitempty": Bool = false
  /// Optional. The scale type of the storage pool. Defaults to `SCALE_TYPE_DEFAULT` if not specified.
  pub scale_type as "scaleType,omitempty": Str = ""
  /// Required. Service level of the storage pool
  pub service_level as "serviceLevel,omitempty": Str = ""
  /// Output only. State of the storage pool
  pub state as "state,omitempty": Str = ""
  /// Output only. State details of the storage pool
  pub state_details as "stateDetails,omitempty": Str = ""
  /// Optional. Custom Performance Total IOPS of the pool if not provided, it will be calculated based on the total_throughput_mibps
  pub total_iops as "totalIops,omitempty,string": Int = 0
  /// Optional. Custom Performance Total Throughput of the pool (in MiBps)
  pub total_throughput_mibps as "totalThroughputMibps,omitempty,string": Int = 0
  /// Optional. Type of the storage pool. This field is used to control whether the pool supports `FILE` based volumes only or `UNIFIED` (both `FILE` and `BLOCK`) volumes. If not specified during creation, it defaults to `FILE`.
  pub type_ as "type,omitempty": Str = ""
  /// Output only. Allocated size of all volumes in GIB in the storage pool
  pub volume_capacity_gib as "volumeCapacityGib,omitempty,string": Int = 0
  /// Output only. Volume count of the storage pool
  pub volume_count as "volumeCount,omitempty": Int = 0
  /// Optional. Specifies the active zone for regional storagePool.
  pub zone as "zone,omitempty": Str = ""
} derive Json

