  gv_queue(f, "{\"repositories\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"format\":\"s-format\",\"kmsKeyName\":\"s-kmskeyname\",\"labels\":{\"k1\":\"s-labels\"},\"mavenConfig\":{\"allowSnapshotOverwrites\":true,\"versionPolicy\":\"s-versionpolicy\"},\"name\":\"s-name\",\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"sizeBytes\":\"7\",\"updateTime\":\"s-updatetime\"}]}")
