test "Go's artifactregistry.projects.locations.repositories.files.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"files\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"createTime\":\"s-createtime\",\"fetchTime\":\"s-fetchtime\",\"name\":\"s-name\",\"owner\":\"s-owner\",\"sizeBytes\":\"7\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"files\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"createTime\":\"s-createtime\",\"fetchTime\":\"s-fetchtime\",\"name\":\"s-name\",\"owner\":\"s-owner\",\"sizeBytes\":\"7\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL artifactregistry.projects.locations.repositories.files.list pages")
  var p = svc.projects.locations.repositories.files.list_pages("id1/ x", options: ProjectsLocationsRepositoriesFilesListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_41)
}

