  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"rules\":[{\"action\":\"s-action\",\"condition\":{\"description\":\"s-description\",\"expression\":\"s-expression\",\"location\":\"s-location\",\"title\":\"s-title\"},\"name\":\"s-name\",\"operation\":\"s-operation\",\"packageId\":\"s-packageid\"}]}")
  gv_queue(f, "{\"rules\":[{\"action\":\"s-action\",\"condition\":{\"description\":\"s-description\",\"expression\":\"s-expression\",\"location\":\"s-location\",\"title\":\"s-title\"},\"name\":\"s-name\",\"operation\":\"s-operation\",\"packageId\":\"s-packageid\"}]}")
  gv_note(f, "CALL artifactregistry.projects.locations.repositories.rules.list pages")
  var p = svc.projects.locations.repositories.rules.list_pages("id1/ x", options: ProjectsLocationsRepositoriesRulesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_91)
}

