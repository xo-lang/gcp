  var hs: List[(Str, Str)] = []
  hs.push(("Content-Type", "application/json"))
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v1beta2/{+parent}/yumArtifacts:create"), {"parent": parent})
  let mu = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "/upload/v1beta2/{+parent}/yumArtifacts:create"), {"parent": parent})
  let resp = r.core.client.upload(clock, rand, gensupport.Request{method: "POST", url: u, query: q, headers: hs, body: gensupport.json_body(uploadyumartifactrequest, data_wrapper: false)}, mu, media)?
  gensupport.check(resp)?
  gensupport.decode[UploadYumArtifactMediaResponse](resp)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
  new_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
