use std/json

const GV_HOST: Str = "https://pollen.googleapis.com"

const GO_0: List[Str] = [
  "CALL pollen.forecast.lookup",
  "REQ GET https://pollen.googleapis.com/v1/forecast:lookup?alt=json&days=7&fields=kind%2Cid&languageCode=s-languagecode&location.latitude=1.5&location.longitude=1.5&pageSize=7&pageToken=s-pagetoken&plantsDescription=true&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"dailyInfo\":[{\"date\":{\"day\":7,\"month\":7,\"year\":7}}],\"nextPageToken\":\"s-nextpagetoken\",\"regionCode\":\"s-regioncode\"}",
  "OUT: {\"dailyInfo\":[{\"date\":{\"day\":7,\"month\":7,\"year\":7}}],\"nextPageToken\":\"s-nextpagetoken\",\"regionCode\":\"s-regioncode\"}",
]

test "Go's pollen.forecast.lookup" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"dailyInfo\":[{\"date\":{\"day\":7,\"month\":7,\"year\":7}}],\"nextPageToken\":\"s-nextpagetoken\",\"regionCode\":\"s-regioncode\"}")
  gv_note(f, "CALL pollen.forecast.lookup")
  match svc.forecast.lookup(options: ForecastLookupOptions{days: Some(7), language_code: Some("s-languagecode"), location_latitude: Some(1.5), location_longitude: Some(1.5), page_size: Some(7), page_token: Some("s-pagetoken"), plants_description: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

const GO_1: List[Str] = [
  "CALL pollen.forecast.lookup pages",
  "REQ GET https://pollen.googleapis.com/v1/forecast:lookup?alt=json&days=7&fields=kind%2Cid&languageCode=s-languagecode&location.latitude=1.5&location.longitude=1.5&pageSize=7&pageToken=s-pagetoken&plantsDescription=true&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"dailyInfo\":[{\"date\":{\"day\":7,\"month\":7,\"year\":7}}],\"nextPageToken\":\"s-nextpagetoken\",\"regionCode\":\"s-regioncode\"}",
  "OUT: {\"dailyInfo\":[{\"date\":{\"day\":7,\"month\":7,\"year\":7}}],\"nextPageToken\":\"s-nextpagetoken\",\"regionCode\":\"s-regioncode\"}",
  "REQ GET https://pollen.googleapis.com/v1/forecast:lookup?alt=json&days=7&fields=kind%2Cid&languageCode=s-languagecode&location.latitude=1.5&location.longitude=1.5&pageSize=7&pageToken=s-nextpagetoken&plantsDescription=true&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"dailyInfo\":[{\"date\":{\"day\":7,\"month\":7,\"year\":7}}],\"regionCode\":\"s-regioncode\"}",
  "OUT: {\"dailyInfo\":[{\"date\":{\"day\":7,\"month\":7,\"year\":7}}],\"regionCode\":\"s-regioncode\"}",
  "OUT: ok",
]

test "Go's pollen.forecast.lookup pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"dailyInfo\":[{\"date\":{\"day\":7,\"month\":7,\"year\":7}}],\"nextPageToken\":\"s-nextpagetoken\",\"regionCode\":\"s-regioncode\"}")
  gv_queue(f, "{\"dailyInfo\":[{\"date\":{\"day\":7,\"month\":7,\"year\":7}}],\"regionCode\":\"s-regioncode\"}")
  gv_note(f, "CALL pollen.forecast.lookup pages")
  var p = svc.forecast.lookup_pages(options: ForecastLookupOptions{days: Some(7), language_code: Some("s-languagecode"), location_latitude: Some(1.5), location_longitude: Some(1.5), page_size: Some(7), page_token: Some("s-pagetoken"), plants_description: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_1)
}

