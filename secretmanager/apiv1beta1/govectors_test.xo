const GO_19: List[Str] = [
  "CALL secretmanager.projects.secrets.versions.list pages",
  "REQ GET https://secretmanager.googleapis.com/v1beta1/id1/%20x/versions?alt=json&fields=kind%2Cid&pageSize=7&pageToken=s-pagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"nextPageToken\":\"s-nextpagetoken\",\"totalSize\":7,\"versions\":[{\"createTime\":\"s-createtime\",\"destroyTime\":\"s-destroytime\",\"name\":\"s-name\",\"state\":\"s-state\"}]}",
  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"totalSize\":7,\"versions\":[{\"createTime\":\"s-createtime\",\"destroyTime\":\"s-destroytime\",\"name\":\"s-name\",\"state\":\"s-state\"}]}",
  "REQ GET https://secretmanager.googleapis.com/v1beta1/id1/%20x/versions?alt=json&fields=kind%2Cid&pageSize=7&pageToken=s-nextpagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"totalSize\":7,\"versions\":[{\"createTime\":\"s-createtime\",\"destroyTime\":\"s-destroytime\",\"name\":\"s-name\",\"state\":\"s-state\"}]}",
  "OUT: {\"totalSize\":7,\"versions\":[{\"createTime\":\"s-createtime\",\"destroyTime\":\"s-destroytime\",\"name\":\"s-name\",\"state\":\"s-state\"}]}",
  "OUT: ok",
]

test "Go's secretmanager.projects.secrets.versions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"totalSize\":7,\"versions\":[{\"createTime\":\"s-createtime\",\"destroyTime\":\"s-destroytime\",\"name\":\"s-name\",\"state\":\"s-state\"}]}")
  gv_queue(f, "{\"totalSize\":7,\"versions\":[{\"createTime\":\"s-createtime\",\"destroyTime\":\"s-destroytime\",\"name\":\"s-name\",\"state\":\"s-state\"}]}")
  gv_note(f, "CALL secretmanager.projects.secrets.versions.list pages")
  var p = svc.projects.secrets.versions.list_pages("id1/ x", options: ProjectsSecretsVersionsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_19)
}
