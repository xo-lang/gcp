  "OUT: {\"testers\":[{\"displayName\":\"s-displayname\",\"groups\":[\"s-groups\"],\"lastActivityTime\":\"s-lastactivitytime\",\"name\":\"s-name\"}]}",
  "OUT: ok",
]

test "Go's firebaseappdistribution.projects.testers.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"testers\":[{\"displayName\":\"s-displayname\",\"groups\":[\"s-groups\"],\"lastActivityTime\":\"s-lastactivitytime\",\"name\":\"s-name\"}]}")
  gv_queue(f, "{\"testers\":[{\"displayName\":\"s-displayname\",\"groups\":[\"s-groups\"],\"lastActivityTime\":\"s-lastactivitytime\",\"name\":\"s-name\"}]}")
  gv_note(f, "CALL firebaseappdistribution.projects.testers.list pages")
  var p = svc.projects.testers.list_pages("id1/ x", options: ProjectsTestersListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_31)
}

const GO_32: List[Str] = [
  "CALL firebaseappdistribution.projects.testers.patch",
  "REQ PATCH https://firebaseappdistribution.googleapis.com/v1/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false&updateMask=s-updatemask",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"displayName\":\"s-displayname\",\"groups\":[\"s-groups\"],\"lastActivityTime\":\"s-lastactivitytime\",\"name\":\"s-name\"}",
  "",
  "  SERVED 200 {\"displayName\":\"s-displayname\",\"groups\":[\"s-groups\"],\"lastActivityTime\":\"s-lastactivitytime\",\"name\":\"s-name\"}",
  "OUT: {\"displayName\":\"s-displayname\",\"groups\":[\"s-groups\"],\"lastActivityTime\":\"s-lastactivitytime\",\"name\":\"s-name\"}",
]

test "Go's firebaseappdistribution.projects.testers.patch" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"displayName\":\"s-displayname\",\"groups\":[\"s-groups\"],\"lastActivityTime\":\"s-lastactivitytime\",\"name\":\"s-name\"}")
  gv_note(f, "CALL firebaseappdistribution.projects.testers.patch")
  match svc.projects.testers.patch("id1/ x", json.decode_str[GoogleFirebaseAppdistroV1Tester]("{\"displayName\":\"s-displayname\",\"groups\":[\"s-groups\"],\"lastActivityTime\":\"s-lastactivitytime\",\"name\":\"s-name\"}") ?? e => fault(e.display()), options: ProjectsTestersPatchOptions{update_mask: Some("s-updatemask"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_32)
}
