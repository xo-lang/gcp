test "Go's firebaseappdistribution.projects.testers.getUdids" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"testerUdids\":[{\"name\":\"s-name\",\"platform\":\"s-platform\",\"udid\":\"s-udid\"}]}")
  gv_note(f, "CALL firebaseappdistribution.projects.testers.getUdids")
  match svc.projects.testers.get_udids("id1/ x", options: ProjectsTestersGetUdidsOptions{mobilesdk_app_id: Some("s-mobilesdkappid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_22)
}
