test "Go's firebaseappdistribution.projects.apps.testCases.patch" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"aiInstructions\":{\"steps\":[{\"assertion\":\"s-assertion\",\"goal\":\"s-goal\",\"hint\":\"s-hint\",\"successCriteria\":\"s-successcriteria\",\"testCase\":\"s-testcase\"}]},\"createTime\":\"s-createtime\",\"dependentTestCases\":[\"s-dependenttestcases\"],\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"prerequisiteTestCase\":\"s-prerequisitetestcase\"}")
  gv_note(f, "CALL firebaseappdistribution.projects.apps.testCases.patch")
  match svc.projects.apps.test_cases.patch("id1/ x", json.decode_str[GoogleFirebaseAppdistroV1alphaTestCase]("{\"aiInstructions\":{\"steps\":[{\"assertion\":\"s-assertion\",\"goal\":\"s-goal\",\"hint\":\"s-hint\",\"successCriteria\":\"s-successcriteria\",\"testCase\":\"s-testcase\"}]},\"createTime\":\"s-createtime\",\"dependentTestCases\":[\"s-dependenttestcases\"],\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"prerequisiteTestCase\":\"s-prerequisitetestcase\"}") ?? e => fault(e.display()), options: ProjectsAppsTestCasesPatchOptions{allow_missing: Some(true), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_21)
}

