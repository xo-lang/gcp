  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"aiInstructions\":{\"steps\":[{\"assertion\":\"s-assertion\",\"goal\":\"s-goal\",\"hint\":\"s-hint\",\"successCriteria\":\"s-successcriteria\",\"testCase\":\"s-testcase\"}]},\"createTime\":\"s-createtime\",\"dependentTestCases\":[\"s-dependenttestcases\"],\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"prerequisiteTestCase\":\"s-prerequisitetestcase\"}")
  gv_note(f, "CALL firebaseappdistribution.projects.apps.testCases.get")
  match svc.projects.apps.test_cases.get("id1/ x", options: ProjectsAppsTestCasesGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_19)
}

