// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 urlshortener/v1 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://www.googleapis.com"

const GO_0: List[Str] = [
  "CALL urlshortener.url.get",
  "REQ GET https://www.googleapis.com/urlshortener/v1/url?alt=json&fields=kind%2Cid&prettyPrint=false&projection=s-projection&shortUrl=s-shorturl",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"analytics\":{\"allTime\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"day\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"month\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"twoHours\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"week\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"}},\"created\":\"s-created\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"longUrl\":\"s-longurl\",\"status\":\"s-status\"}",
  "OUT: {\"analytics\":{\"allTime\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"day\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"month\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"twoHours\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"week\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"}},\"created\":\"s-created\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"longUrl\":\"s-longurl\",\"status\":\"s-status\"}",
]

test "Go's urlshortener.url.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"analytics\":{\"allTime\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"day\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"month\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"twoHours\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"},\"week\":{\"longUrlClicks\":\"7\",\"shortUrlClicks\":\"7\"}},\"created\":\"s-created\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"longUrl\":\"s-longurl\",\"status\":\"s-status\"}")
  gv_note(f, "CALL urlshortener.url.get")
  match svc.url.get("s-shorturl", options: UrlGetOptions{projection: Some("s-projection"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

