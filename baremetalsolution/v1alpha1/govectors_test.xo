test "Go's baremetalsolution.projects.provisioningQuotas.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"provisioningQuotas\":[{\"instanceQuota\":{\"availableMachineCount\":7,\"instanceType\":\"s-instancetype\",\"location\":\"s-location\"}}]}")
  gv_queue(f, "{\"provisioningQuotas\":[{\"instanceQuota\":{\"availableMachineCount\":7,\"instanceType\":\"s-instancetype\",\"location\":\"s-location\"}}]}")
  gv_note(f, "CALL baremetalsolution.projects.provisioningQuotas.list pages")
  var p = svc.projects.provisioning_quotas.list_pages("id1/ x", options: ProjectsProvisioningQuotasListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_2)
}
