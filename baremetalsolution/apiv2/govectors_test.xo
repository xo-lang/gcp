  gv_queue(f, "{\"luns\":[{\"bootLun\":true,\"expireTime\":\"s-expiretime\",\"id\":\"s-id\",\"instances\":[\"s-instances\"],\"multiprotocolType\":\"s-multiprotocoltype\",\"name\":\"s-name\",\"shareable\":true,\"sizeGb\":\"7\",\"state\":\"s-state\",\"storageType\":\"s-storagetype\",\"storageVolume\":\"s-storagevolume\",\"wwid\":\"s-wwid\"}],\"unreachable\":[\"s-unreachable\"]}")
