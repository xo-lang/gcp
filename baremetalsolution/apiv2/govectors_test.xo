  gv_queue(f, "{\"osImages\":[{\"applicableInstanceTypes\":[\"s-applicableinstancetypes\"],\"code\":\"s-code\",\"description\":\"s-description\",\"name\":\"s-name\",\"supportedNetworkTemplates\":[\"s-supportednetworktemplates\"]}]}")
