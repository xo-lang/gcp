  var p = svc.projects.locations.os_images.list_pages("id1/ x", options: ProjectsLocationsOsImagesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
