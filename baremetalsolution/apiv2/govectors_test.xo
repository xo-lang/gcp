  gv_queue(f, "{\"instances\":[{\"createTime\":\"s-createtime\",\"firmwareVersion\":\"s-firmwareversion\",\"hyperthreadingEnabled\":true,\"id\":\"s-id\",\"interactiveSerialConsoleEnabled\":true,\"kmsKeyVersion\":\"s-kmskeyversion\",\"labels\":{\"k1\":\"s-labels\"},\"loginInfo\":\"s-logininfo\",\"machineType\":\"s-machinetype\",\"name\":\"s-name\",\"networkTemplate\":\"s-networktemplate\",\"osImage\":\"s-osimage\",\"pod\":\"s-pod\",\"sshKeys\":[\"s-sshkeys\"],\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"workloadProfile\":\"s-workloadprofile\"}],\"unreachable\":[\"s-unreachable\"]}")
