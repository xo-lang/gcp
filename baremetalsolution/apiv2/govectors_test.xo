  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"nfsShares\":[{\"id\":\"s-id\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"nfsShareId\":\"s-nfsshareid\",\"pod\":\"s-pod\",\"requestedSizeGib\":\"7\",\"state\":\"s-state\",\"storageType\":\"s-storagetype\",\"volume\":\"s-volume\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"nfsShares\":[{\"id\":\"s-id\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"nfsShareId\":\"s-nfsshareid\",\"pod\":\"s-pod\",\"requestedSizeGib\":\"7\",\"state\":\"s-state\",\"storageType\":\"s-storagetype\",\"volume\":\"s-volume\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL baremetalsolution.projects.locations.nfsShares.list pages")
  var p = svc.projects.locations.nfs_shares.list_pages("id1/ x", options: ProjectsLocationsNfsSharesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_28)
}

