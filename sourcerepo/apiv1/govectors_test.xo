  "OUT: {\"permissions\":[\"s-permissions\"]}",
]

test "Go's sourcerepo.projects.repos.testIamPermissions" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"permissions\":[\"s-permissions\"]}")
  gv_note(f, "CALL sourcerepo.projects.repos.testIamPermissions")
  match svc.projects.repos.test_iam_permissions("id1/ x", json.decode_str[TestIamPermissionsRequest]("{\"permissions\":[\"s-permissions\"]}") ?? e => fault(e.display()), options: ProjectsReposTestIamPermissionsOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_11)
}
