test "Go's dataflow.projects.locations.jobs.getExecutionDetails pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"stages\":[{\"endTime\":\"s-endtime\",\"progress\":{\"currentProgress\":1.5},\"stageId\":\"s-stageid\",\"startTime\":\"s-starttime\",\"state\":\"s-state\",\"stragglerSummary\":{\"totalStragglerCount\":\"7\"}}]}")
  gv_queue(f, "{\"stages\":[{\"endTime\":\"s-endtime\",\"progress\":{\"currentProgress\":1.5},\"stageId\":\"s-stageid\",\"startTime\":\"s-starttime\",\"state\":\"s-state\",\"stragglerSummary\":{\"totalStragglerCount\":\"7\"}}]}")
  gv_note(f, "CALL dataflow.projects.locations.jobs.getExecutionDetails pages")
  var p = svc.projects.locations.jobs.get_execution_details_pages("id1/ x", "id2/ x", "id3/ x", options: ProjectsLocationsJobsGetExecutionDetailsOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
