  gv_note(f, "CALL dataflow.projects.jobs.list pages")
  var p = svc.projects.jobs.list_pages("id1/ x", options: ProjectsJobsListOptions{create_time_range_end_time: Some("s-createtimerange.endtime"), create_time_range_start_time: Some("s-createtimerange.starttime"), filter: Some("s-filter"), location: Some("s-location"), name: Some("s-name"), page_size: Some(7), page_token: Some("s-pagetoken"), regional_fanout_requested: Some(true), termination_time_range_end_time: Some("s-terminationtimerange.endtime"), termination_time_range_start_time: Some("s-terminationtimerange.starttime"), view: Some("s-view"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
