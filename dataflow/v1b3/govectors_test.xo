test "Go's dataflow.projects.jobs.messages.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"autoscalingEvents\":[{\"currentNumWorkers\":\"7\",\"description\":{\"messageKey\":\"s-messagekey\",\"messageText\":\"s-messagetext\"},\"eventType\":\"s-eventtype\",\"targetNumWorkers\":\"7\",\"time\":\"s-time\",\"workerPool\":\"s-workerpool\"}],\"jobMessages\":[{\"id\":\"s-id\",\"messageImportance\":\"s-messageimportance\",\"messageText\":\"s-messagetext\",\"time\":\"s-time\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"autoscalingEvents\":[{\"currentNumWorkers\":\"7\",\"description\":{\"messageKey\":\"s-messagekey\",\"messageText\":\"s-messagetext\"},\"eventType\":\"s-eventtype\",\"targetNumWorkers\":\"7\",\"time\":\"s-time\",\"workerPool\":\"s-workerpool\"}],\"jobMessages\":[{\"id\":\"s-id\",\"messageImportance\":\"s-messageimportance\",\"messageText\":\"s-messagetext\",\"time\":\"s-time\"}]}")
  gv_note(f, "CALL dataflow.projects.jobs.messages.list pages")
  var p = svc.projects.jobs.messages.list_pages("id1/ x", "id2/ x", options: ProjectsJobsMessagesListOptions{end_time: Some("s-endtime"), location: Some("s-location"), minimum_importance: Some("s-minimumimportance"), page_size: Some(7), page_token: Some("s-pagetoken"), start_time: Some("s-starttime"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_26)
}

