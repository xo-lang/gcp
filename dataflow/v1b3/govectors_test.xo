  gv_note(f, "CALL dataflow.projects.locations.configStoreSettings.list pages")
  var p = svc.projects.locations.config_store_settings.list_pages("id1/ x", options: ProjectsLocationsConfigStoreSettingsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
