} derive Json

/// SourceSplitRequest: Represents the operation to split a high-level Source specification into bundles (parts for parallel processing). At a high level, splitting of a source into bundles happens as follows: SourceSplitRequest is applied to the source. If it returns SOURCE_SPLIT_OUTCOME_USE_CURRENT, no further splitting happens and the source is used "as is". Otherwise, splitting is applied recursively to each produced DerivedSource. As an optimization, for any Source, if its does_not_need_splitting is true, the framework assumes that splitting this source would return SOURCE_SPLIT_OUTCOME_USE_CURRENT, and doesn't initiate a SourceSplitRequest. This applies both to the initial source being split and to bundles produced from it.
pub struct SourceSplitRequest {
  /// Hints for tuning the splitting process.
  pub options as "options,omitempty": SourceSplitOptions? = None
  /// Specification of the source to be split.
  pub source as "source,omitempty": Source? = None
} derive Json

/// SourceSplitResponse: The response to a SourceSplitRequest.
pub struct SourceSplitResponse {
  /// If outcome is SPLITTING_HAPPENED, then this is a list of bundles into which the source was split. Otherwise this field is ignored. This list can be empty, which means the source represents an empty input.
  pub bundles as "bundles,omitempty": List[DerivedSource] = []
  /// Indicates whether splitting happened and produced a list of bundles. If this is USE_CURRENT_SOURCE_AS_IS, the current source should be processed "as is" without splitting. "bundles" is ignored in this case. If this is SPLITTING_HAPPENED, then "bundles" contains a list of bundles into which the source was split.
  pub outcome as "outcome,omitempty": Str = ""
  /// DEPRECATED in favor of bundles.
  pub shards as "shards,omitempty": List[SourceSplitShard] = []
} derive Json

