test "Go's appstate.states.clear" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"currentStateVersion\":\"s-currentstateversion\",\"kind\":\"s-kind\",\"stateKey\":7}")
