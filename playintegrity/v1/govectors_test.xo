test "Go's playintegrity.deviceRecall.write" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{}")
  gv_note(f, "CALL playintegrity.deviceRecall.write")
  match svc.device_recall.write("id1/ x", json.decode_str[WriteDeviceRecallRequest]("{\"integrityToken\":\"s-integritytoken\",\"newValues\":{\"bitFirst\":true,\"bitSecond\":true,\"bitThird\":true}}") ?? e => fault(e.display()), options: DeviceRecallWriteOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
