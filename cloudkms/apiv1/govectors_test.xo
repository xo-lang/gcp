  gv_queue(f, "{\"keyRings\":[{\"createTime\":\"s-createtime\",\"name\":\"s-name\"}],\"totalSize\":7}")
  gv_note(f, "CALL cloudkms.projects.locations.keyRings.list pages")
  var p = svc.projects.locations.key_rings.list_pages("id1/ x", options: ProjectsLocationsKeyRingsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
