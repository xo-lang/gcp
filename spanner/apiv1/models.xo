  pub field_mask as "fieldMask,omitempty": Str = ""
  /// Required. The instance to update, which must always include the instance name. Otherwise, only fields mentioned in field_mask need be included.
  pub instance as "instance,omitempty": Instance? = None
  pub force_send_fields as "~forceSendFields,omitempty": List[UpdateInstanceRequestField] = []
  pub null_fields as "~nullFields,omitempty": List[UpdateInstanceRequestField] = []
} derive Json

/// UpdateInstanceRequestField: UpdateInstanceRequest's fields, for force_send_fields and null_fields.
pub enum UpdateInstanceRequestField {
  FieldMask as "fieldMask=\"\""
  Instance as "instance"
} derive Json

/// VisualizationData:
pub struct VisualizationData {
  /// The token signifying the end of a data_source.
  pub data_source_end_token as "dataSourceEndToken,omitempty": Str = ""
  /// The token delimiting a datasource name from the rest of a key in a data_source.
  pub data_source_separator_token as "dataSourceSeparatorToken,omitempty": Str = ""
  /// The list of messages (info, alerts, ...)
  pub diagnostic_messages as "diagnosticMessages,omitempty": List[DiagnosticMessage] = []
  /// We discretize the entire keyspace into buckets. Assuming each bucket has an inclusive keyrange and covers keys from k(i) ... k(n). In this case k(n) would be an end key for a given range. end_key_string is the collection of all such end keys
  pub end_key_strings as "endKeyStrings,omitempty": List[Str] = []
  /// Whether this scan contains PII.
  pub has_pii as "hasPii,omitempty": Bool = false
  /// Keys of key ranges that contribute significantly to a given metric Can be thought of as heavy hitters.
  pub indexed_keys as "indexedKeys,omitempty": List[Str] = []
  /// The token delimiting the key prefixes.
  pub key_separator as "keySeparator,omitempty": Str = ""
  /// The unit for the key: e.g. 'key' or 'chunk'.
  pub key_unit as "keyUnit,omitempty": Str = ""
  /// The list of data objects for each metric.
  pub metrics as "metrics,omitempty": List[Metric] = []
  /// The list of extracted key prefix nodes used in the key prefix hierarchy.
  pub prefix_nodes as "prefixNodes,omitempty": List[PrefixNode] = []
} derive Json

/// Write: Arguments to insert, update, insert_or_update, and replace operations.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct Write {
  /// The names of the columns in table to be written. The list of columns must contain enough columns to allow Cloud Spanner to derive values for all primary key columns in the row(s) to be modified.
  pub columns as "columns,omitempty": List[Str] = []
  /// Required. The table whose rows will be written.
  pub table as "table,omitempty": Str = ""
  /// The values to be written. `values` can contain more than one list of values. If it does, then multiple rows are written, one for each entry in `values`. Each list in `values` must have exactly as many entries as there are entries in columns above. Sending multiple lists is equivalent to sending multiple `Mutation`s, each containing one `values` entry and repeating table and columns. Individual values in each list are encoded as described here.
  pub values as "values,omitempty": List[List[json.Value]] = []
  pub force_send_fields as "~forceSendFields,omitempty": List[WriteField] = []
  pub null_fields as "~nullFields,omitempty": List[WriteField] = []
} derive Json

/// WriteField: Write's fields, for force_send_fields and null_fields.
pub enum WriteField {
  Columns as "columns=[]"
  Table as "table=\"\""
  Values as "values=[]"
} derive Json
