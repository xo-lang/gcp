/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct KeyRange {
  /// If the end is closed, then the range includes all rows whose first `len(end_closed)` key columns exactly match `end_closed`.
  pub end_closed as "endClosed,omitempty": List[json.Value] = []
  /// If the end is open, then the range excludes rows whose first `len(end_open)` key columns exactly match `end_open`.
  pub end_open as "endOpen,omitempty": List[json.Value] = []
  /// If the start is closed, then the range includes all rows whose first `len(start_closed)` key columns exactly match `start_closed`.
  pub start_closed as "startClosed,omitempty": List[json.Value] = []
  /// If the start is open, then the range excludes rows whose first `len(start_open)` key columns exactly match `start_open`.
