test "Go's developerknowledge.documents.searchDocumentChunks pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"results\":[{\"content\":\"s-content\",\"document\":{\"content\":\"s-content\",\"contentLengthBytes\":7,\"dataSource\":\"s-datasource\",\"description\":\"s-description\",\"name\":\"s-name\",\"title\":\"s-title\",\"updateTime\":\"s-updatetime\",\"uri\":\"s-uri\",\"view\":\"s-view\"},\"id\":\"s-id\",\"parent\":\"s-parent\",\"relevanceScore\":1.5}]}")
  gv_queue(f, "{\"results\":[{\"content\":\"s-content\",\"document\":{\"content\":\"s-content\",\"contentLengthBytes\":7,\"dataSource\":\"s-datasource\",\"description\":\"s-description\",\"name\":\"s-name\",\"title\":\"s-title\",\"updateTime\":\"s-updatetime\",\"uri\":\"s-uri\",\"view\":\"s-view\"},\"id\":\"s-id\",\"parent\":\"s-parent\",\"relevanceScore\":1.5}]}")
  gv_note(f, "CALL developerknowledge.documents.searchDocumentChunks pages")
  var p = svc.documents.search_document_chunks_pages(options: DocumentsSearchDocumentChunksOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), query: Some("s-query"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_3)
}

