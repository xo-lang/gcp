// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 acceleratedmobilepageurl/v1 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://acceleratedmobilepageurl.googleapis.com"

const GO_0: List[Str] = [
  "CALL acceleratedmobilepageurl.ampUrls.batchGet",
  "REQ POST https://acceleratedmobilepageurl.googleapis.com/v1/ampUrls:batchGet?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"lookupStrategy\":\"s-lookupstrategy\",\"urls\":[\"s-urls\"]}",
  "",
  "  SERVED 200 {\"ampUrls\":[{\"ampUrl\":\"s-ampurl\",\"cdnAmpUrl\":\"s-cdnampurl\",\"originalUrl\":\"s-originalurl\"}],\"urlErrors\":[{\"errorCode\":\"s-errorcode\",\"errorMessage\":\"s-errormessage\",\"originalUrl\":\"s-originalurl\"}]}",
  "OUT: {\"ampUrls\":[{\"ampUrl\":\"s-ampurl\",\"cdnAmpUrl\":\"s-cdnampurl\",\"originalUrl\":\"s-originalurl\"}],\"urlErrors\":[{\"errorCode\":\"s-errorcode\",\"errorMessage\":\"s-errormessage\",\"originalUrl\":\"s-originalurl\"}]}",
]

test "Go's acceleratedmobilepageurl.ampUrls.batchGet" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"ampUrls\":[{\"ampUrl\":\"s-ampurl\",\"cdnAmpUrl\":\"s-cdnampurl\",\"originalUrl\":\"s-originalurl\"}],\"urlErrors\":[{\"errorCode\":\"s-errorcode\",\"errorMessage\":\"s-errormessage\",\"originalUrl\":\"s-originalurl\"}]}")
  gv_note(f, "CALL acceleratedmobilepageurl.ampUrls.batchGet")
  match svc.amp_urls.batch_get(json.decode_str[BatchGetAmpUrlsRequest]("{\"lookupStrategy\":\"s-lookupstrategy\",\"urls\":[\"s-urls\"]}") ?? e => fault(e.display()), options: AmpUrlsBatchGetOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
