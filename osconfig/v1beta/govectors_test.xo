  "",
  "  SERVED 200 {\"packageRepositories\":[{\"packageRepository\":{},\"source\":\"s-source\"}],\"packages\":[{\"package\":{\"desiredState\":\"s-desiredstate\",\"manager\":\"s-manager\",\"name\":\"s-name\"},\"source\":\"s-source\"}],\"softwareRecipes\":[{\"softwareRecipe\":{\"desiredState\":\"s-desiredstate\",\"name\":\"s-name\",\"version\":\"s-version\"},\"source\":\"s-source\"}]}",
  "OUT: {\"packageRepositories\":[{\"packageRepository\":{},\"source\":\"s-source\"}],\"packages\":[{\"package\":{\"desiredState\":\"s-desiredstate\",\"manager\":\"s-manager\",\"name\":\"s-name\"},\"source\":\"s-source\"}],\"softwareRecipes\":[{\"softwareRecipe\":{\"desiredState\":\"s-desiredstate\",\"name\":\"s-name\",\"version\":\"s-version\"},\"source\":\"s-source\"}]}",
]

test "Go's osconfig.projects.zones.instances.lookupEffectiveGuestPolicy" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"packageRepositories\":[{\"packageRepository\":{},\"source\":\"s-source\"}],\"packages\":[{\"package\":{\"desiredState\":\"s-desiredstate\",\"manager\":\"s-manager\",\"name\":\"s-name\"},\"source\":\"s-source\"}],\"softwareRecipes\":[{\"softwareRecipe\":{\"desiredState\":\"s-desiredstate\",\"name\":\"s-name\",\"version\":\"s-version\"},\"source\":\"s-source\"}]}")
  gv_note(f, "CALL osconfig.projects.zones.instances.lookupEffectiveGuestPolicy")
  match svc.projects.zones.instances.lookup_effective_guest_policy("id1/ x", json.decode_str[LookupEffectiveGuestPolicyRequest]("{\"osArchitecture\":\"s-osarchitecture\",\"osShortName\":\"s-osshortname\",\"osVersion\":\"s-osversion\"}") ?? e => fault(e.display()), options: ProjectsZonesInstancesLookupEffectiveGuestPolicyOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_17)
}
