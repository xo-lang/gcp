test "Go's osconfig.projects.patchDeployments.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"patchDeployments\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"duration\":\"s-duration\",\"instanceFilter\":{\"all\":true},\"lastExecuteTime\":\"s-lastexecutetime\",\"name\":\"s-name\",\"oneTimeSchedule\":{\"executeTime\":\"s-executetime\"},\"patchConfig\":{\"migInstancesAllowed\":true,\"rebootConfig\":\"s-rebootconfig\",\"skipUnpatchableVms\":true},\"recurringSchedule\":{\"endTime\":\"s-endtime\",\"frequency\":\"s-frequency\",\"lastExecuteTime\":\"s-lastexecutetime\",\"nextExecuteTime\":\"s-nextexecutetime\",\"startTime\":\"s-starttime\"},\"rollout\":{\"mode\":\"s-mode\"},\"state\":\"s-state\",\"updateTime\":\"s-updatetime\"}]}")
  gv_queue(f, "{\"patchDeployments\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"duration\":\"s-duration\",\"instanceFilter\":{\"all\":true},\"lastExecuteTime\":\"s-lastexecutetime\",\"name\":\"s-name\",\"oneTimeSchedule\":{\"executeTime\":\"s-executetime\"},\"patchConfig\":{\"migInstancesAllowed\":true,\"rebootConfig\":\"s-rebootconfig\",\"skipUnpatchableVms\":true},\"recurringSchedule\":{\"endTime\":\"s-endtime\",\"frequency\":\"s-frequency\",\"lastExecuteTime\":\"s-lastexecutetime\",\"nextExecuteTime\":\"s-nextexecutetime\",\"startTime\":\"s-starttime\"},\"rollout\":{\"mode\":\"s-mode\"},\"state\":\"s-state\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL osconfig.projects.patchDeployments.list pages")
  var p = svc.projects.patch_deployments.list_pages("id1/ x", options: ProjectsPatchDeploymentsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_25)
}

