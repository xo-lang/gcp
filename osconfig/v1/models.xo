  pub name as "name,omitempty": Str = ""
  /// Set PatchAndConfigFeatureSet for the project.
  pub patch_and_config_feature_set as "patchAndConfigFeatureSet,omitempty": Str = ""
} derive Json

/// RecurringSchedule: Sets the time for recurring patch deployments.
pub struct RecurringSchedule {
  /// Optional. The end time at which a recurring patch deployment schedule is no longer active.
  pub end_time as "endTime,omitempty": Str = ""
  /// Required. The frequency unit of this recurring schedule.
  pub frequency as "frequency,omitempty": Str = ""
  /// Output only. The time the last patch job ran successfully.
  pub last_execute_time as "lastExecuteTime,omitempty": Str = ""
  /// Required. Schedule with monthly executions.
  pub monthly as "monthly,omitempty": MonthlySchedule? = None
  /// Output only. The time the next patch job is scheduled to run.
  pub next_execute_time as "nextExecuteTime,omitempty": Str = ""
  /// Optional. The time that the recurring schedule becomes effective. Defaults to `create_time` of the patch deployment.
  pub start_time as "startTime,omitempty": Str = ""
  /// Required. Time of the day to run a recurring deployment.
  pub time_of_day as "timeOfDay,omitempty": TimeOfDay? = None
  /// Required. Defines the time zone that `time_of_day` is relative to. The rules for daylight saving time are determined by the chosen time zone.
  pub time_zone as "timeZone,omitempty": TimeZone? = None
  /// Required. Schedule with weekly executions.
  pub weekly as "weekly,omitempty": WeeklySchedule? = None
} derive Json

/// ResumePatchDeploymentRequest: A request message for resuming a patch deployment.
pub struct ResumePatchDeploymentRequest {} derive Json

/// Status: The `Status` type defines a logical error model that is suitable for different programming environments, including REST APIs and RPC APIs. It is used by [gRPC](https://github.com/grpc). Each `Status` message contains three pieces of data: error code, error message, and error details. You can find out more about this error model and how to work with it in the [API Design Guide](https://cloud.google.com/apis/design/errors).
pub struct Status {
  /// The status code, which should be an enum value of google.rpc.Code.
  pub code as "code,omitempty": Int = 0
  /// A list of messages that carry the error details. There is a common set of message types for APIs to use.
  pub details as "details,omitempty": List[json.Value] = []
  /// A developer-facing error message, which should be in English. Any user-facing error message should be localized and sent in the google.rpc.Status.details field, or localized by the client.
  pub message as "message,omitempty": Str = ""
} derive Json

/// StatusProto: Wire-format for a Status object
pub struct StatusProto {
  /// copybara:strip_begin(b/383363683) copybara:strip_end_and_replace optional int32 canonical_code = 6;
  pub canonical_code as "canonicalCode,omitempty": Int = 0
  /// Numeric code drawn from the space specified below. Often, this is the canonical error space, and code is drawn from google3/util/task/codes.proto copybara:strip_begin(b/383363683) copybara:strip_end_and_replace optional int32 code = 1;
  pub code as "code,omitempty": Int = 0
  /// Detail message copybara:strip_begin(b/383363683) copybara:strip_end_and_replace optional string message = 3;
  pub message as "message,omitempty": Str = ""
  /// message_set associates an arbitrary proto message with the status. copybara:strip_begin(b/383363683) copybara:strip_end_and_replace optional proto2.bridge.MessageSet message_set = 5;
  pub message_set as "messageSet,omitempty": MessageSet? = None
  /// copybara:strip_begin(b/383363683) Space to which this status belongs copybara:strip_end_and_replace optional string space = 2; // Space to which this status belongs
  pub space as "space,omitempty": Str = ""
} derive Json

/// TimeOfDay: Represents a time of day. The date and time zone are either not significant or are specified elsewhere. An API may choose to allow leap seconds. Related types are google.type.Date and `google.protobuf.Timestamp`.
pub struct TimeOfDay {
  /// Hours of a day in 24 hour format. Must be greater than or equal to 0 and typically must be less than or equal to 23. An API may choose to allow the value "24:00:00" for scenarios like business closing time.
  pub hours as "hours,omitempty": Int = 0
  /// Minutes of an hour. Must be greater than or equal to 0 and less than or equal to 59.
  pub minutes as "minutes,omitempty": Int = 0
  /// Fractions of seconds, in nanoseconds. Must be greater than or equal to 0 and less than or equal to 999,999,999.
  pub nanos as "nanos,omitempty": Int = 0
  /// Seconds of a minute. Must be greater than or equal to 0 and typically must be less than or equal to 59. An API may allow the value 60 if it allows leap-seconds.
  pub seconds as "seconds,omitempty": Int = 0
} derive Json

/// TimeZone: Represents a time zone from the [IANA Time Zone Database](https://www.iana.org/time-zones).
pub struct TimeZone {
  /// IANA Time Zone Database time zone. For example "America/New_York".
  pub id as "id,omitempty": Str = ""
  /// Optional. IANA Time Zone Database version number. For example "2019a".
  pub version as "version,omitempty": Str = ""
} derive Json

/// VulnerabilityReport: This API resource represents the vulnerability report for a specified Compute Engine virtual machine (VM) instance at a given point in time. For more information, see [Vulnerability reports](https://cloud.google.com/compute/docs/instances/os-inventory-management#vulnerability-reports).
pub struct VulnerabilityReport {
  /// Output only. Highest level of severity among all the upgradable vulnerabilities with CVEs attached.
  pub highest_upgradable_cve_severity as "highestUpgradableCveSeverity,omitempty": Str = ""
  /// Output only. The `vulnerabilityReport` API resource name. Format: `projects/{project_number}/locations/{location}/instances/{instance_id}/vulnerabilityReport`
  pub name as "name,omitempty": Str = ""
  /// Output only. The timestamp for when the last vulnerability report was generated for the VM.
  pub update_time as "updateTime,omitempty": Str = ""
  /// Output only. List of vulnerabilities affecting the VM.
  pub vulnerabilities as "vulnerabilities,omitempty": List[VulnerabilityReportVulnerability] = []
} derive Json

/// VulnerabilityReportVulnerability: A vulnerability affecting the VM instance.
pub struct VulnerabilityReportVulnerability {
  /// Corresponds to the `AVAILABLE_PACKAGE` inventory item on the VM. If the vulnerability report was not updated after the VM inventory update, these values might not display in VM inventory. If there is no available fix, the field is empty. The `inventory_item` value specifies the latest `SoftwarePackage` available to the VM that fixes the vulnerability.
  pub available_inventory_item_ids as "availableInventoryItemIds,omitempty": List[Str] = []
  /// The timestamp for when the vulnerability was first detected.
  pub create_time as "createTime,omitempty": Str = ""
  /// Contains metadata as per the upstream feed of the operating system and NVD.
  pub details as "details,omitempty": VulnerabilityReportVulnerabilityDetails? = None
  /// Corresponds to the `INSTALLED_PACKAGE` inventory item on the VM. This field displays the inventory items affected by this vulnerability. If the vulnerability report was not updated after the VM inventory update, these values might not display in VM inventory. For some distros, this field may be empty.
  pub installed_inventory_item_ids as "installedInventoryItemIds,omitempty": List[Str] = []
  /// List of items affected by the vulnerability.
  pub items as "items,omitempty": List[VulnerabilityReportVulnerabilityItem] = []
  /// The timestamp for when the vulnerability was last modified.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

/// VulnerabilityReportVulnerabilityDetails: Contains metadata information for the vulnerability. This information is collected from the upstream feed of the operating system.
pub struct VulnerabilityReportVulnerabilityDetails {
  /// The CVE of the vulnerability. CVE cannot be empty and the combination of should be unique across vulnerabilities for a VM.
  pub cve as "cve,omitempty": Str = ""
  /// The CVSS V2 score of this vulnerability. CVSS V2 score is on a scale of 0 - 10 where 0 indicates low severity and 10 indicates high severity.
  pub cvss_v2_score as "cvssV2Score,omitempty": Float = 0.0
  /// The full description of the CVSSv3 for this vulnerability from NVD.
  pub cvss_v3 as "cvssV3,omitempty": CVSSv3? = None
  /// The note or description describing the vulnerability from the distro.
  pub description as "description,omitempty": Str = ""
  /// Corresponds to the references attached to the `VulnerabilityDetails`.
  pub references as "references,omitempty": List[VulnerabilityReportVulnerabilityDetailsReference] = []
  /// Assigned severity/impact ranking from the distro.
  pub severity as "severity,omitempty": Str = ""
} derive Json

/// VulnerabilityReportVulnerabilityDetailsReference: A reference for this vulnerability.
pub struct VulnerabilityReportVulnerabilityDetailsReference {
  /// The source of the reference e.g. NVD.
  pub source as "source,omitempty": Str = ""
  /// The url of the reference.
  pub url as "url,omitempty": Str = ""
} derive Json

/// VulnerabilityReportVulnerabilityItem: OS inventory item that is affected by a vulnerability or fixed as a result of a vulnerability.
pub struct VulnerabilityReportVulnerabilityItem {
  /// Corresponds to the `AVAILABLE_PACKAGE` inventory item on the VM. If the vulnerability report was not updated after the VM inventory update, these values might not display in VM inventory. If there is no available fix, the field is empty. The `inventory_item` value specifies the latest `SoftwarePackage` available to the VM that fixes the vulnerability.
  pub available_inventory_item_id as "availableInventoryItemId,omitempty": Str = ""
  /// The recommended [CPE URI](https://cpe.mitre.org/specification/) update that contains a fix for this vulnerability.
  pub fixed_cpe_uri as "fixedCpeUri,omitempty": Str = ""
  /// Corresponds to the `INSTALLED_PACKAGE` inventory item on the VM. This field displays the inventory items affected by this vulnerability. If the vulnerability report was not updated after the VM inventory update, these values might not display in VM inventory. For some operating systems, this field might be empty.
  pub installed_inventory_item_id as "installedInventoryItemId,omitempty": Str = ""
  /// The upstream OS patch, packages or KB that fixes the vulnerability.
  pub upstream_fix as "upstreamFix,omitempty": Str = ""
} derive Json

/// WeekDayOfMonth: Represents one week day in a month. An example is "the 4th Sunday".
pub struct WeekDayOfMonth {
  /// Required. A day of the week.
  pub day_of_week as "dayOfWeek,omitempty": Str = ""
  /// Optional. Represents the number of days before or after the given week day of month that the patch deployment is scheduled for. For example if `week_ordinal` and `day_of_week` values point to the second Tuesday of the month and the `day_offset` value is set to `3`, patch deployment takes place three days after the second Tuesday of the month. If this value is negative, for example -5, patches are deployed five days before the second Tuesday of the month. Allowed values are in range [-30, 30].
  pub day_offset as "dayOffset,omitempty": Int = 0
  /// Required. Week number in a month. 1-4 indicates the 1st to 4th week of the month. -1 indicates the last week of the month.
  pub week_ordinal as "weekOrdinal,omitempty": Int = 0
} derive Json

/// WeeklySchedule: Represents a weekly schedule.
pub struct WeeklySchedule {
  /// Required. Day of the week.
  pub day_of_week as "dayOfWeek,omitempty": Str = ""
} derive Json

/// WindowsUpdateSettings: Windows patching is performed using the Windows Update Agent.
pub struct WindowsUpdateSettings {
  /// Only apply updates of these windows update classifications. If empty, all updates are applied.
  pub classifications as "classifications,omitempty": List[Str] = []
  /// List of KBs to exclude from update.
  pub excludes as "excludes,omitempty": List[Str] = []
  /// An exclusive list of kbs to be updated. These are the only patches that will be updated. This field must not be used with other patch configurations.
  pub exclusive_patches as "exclusivePatches,omitempty": List[Str] = []
} derive Json

/// YumSettings: Yum patching is performed by executing `yum update`. Additional options can be set to control how this is executed. Note that not all settings are supported on all platforms.
pub struct YumSettings {
  /// List of packages to exclude from update. These packages are excluded by using the yum `--exclude` flag.
  pub excludes as "excludes,omitempty": List[Str] = []
  /// An exclusive list of packages to be updated. These are the only packages that will be updated. If these packages are not installed, they will be ignored. This field must not be specified with any other patch configuration fields.
  pub exclusive_packages as "exclusivePackages,omitempty": List[Str] = []
  /// Will cause patch to run `yum update-minimal` instead.
  pub minimal as "minimal,omitempty": Bool = false
  /// Adds the `--security` flag to `yum update`. Not supported on all platforms.
  pub security as "security,omitempty": Bool = false
} derive Json

/// ZypperSettings: Zypper patching is performed by running `zypper patch`. See also https://en.opensuse.org/SDB:Zypper_manual.
pub struct ZypperSettings {
  /// Install only patches with these categories. Common categories include security, recommended, and feature.
  pub categories as "categories,omitempty": List[Str] = []
  /// List of patches to exclude from update.
  pub excludes as "excludes,omitempty": List[Str] = []
  /// An exclusive list of patches to be updated. These are the only patches that will be installed using 'zypper patch patch:' command. This field must not be used with any other patch configuration fields.
  pub exclusive_patches as "exclusivePatches,omitempty": List[Str] = []
  /// Install only patches with these severities. Common severities include critical, important, moderate, and low.
  pub severities as "severities,omitempty": List[Str] = []
  /// Adds the `--with-optional` flag to `zypper patch`.
  pub with_optional as "withOptional,omitempty": Bool = false
  /// Adds the `--with-update` flag, to `zypper patch`.
  pub with_update as "withUpdate,omitempty": Bool = false
} derive Json
