  pub create_time as "createTime,omitempty": Str = ""
  /// Optional. Description of the patch deployment. Length of the description is limited to 1024 characters.
  pub description as "description,omitempty": Str = ""
  /// Optional. Duration of the patch. After the duration ends, the patch times out.
  pub duration as "duration,omitempty": Str = ""
  /// Required. VM instances to patch.
  pub instance_filter as "instanceFilter,omitempty": PatchInstanceFilter? = None
  /// Output only. The last time a patch job was started by this deployment. Timestamp is in [RFC3339](https://www.ietf.org/rfc/rfc3339.txt) text format.
  pub last_execute_time as "lastExecuteTime,omitempty": Str = ""
  /// Unique name for the patch deployment resource in a project. The patch deployment name is in the form: `projects/{project_id}/patchDeployments/{patch_deployment_id}`. This field is ignored when you create a new patch deployment.
  pub name as "name,omitempty": Str = ""
  /// Required. Schedule a one-time execution.
  pub one_time_schedule as "oneTimeSchedule,omitempty": OneTimeSchedule? = None
  /// Optional. Patch configuration that is applied.
  pub patch_config as "patchConfig,omitempty": PatchConfig? = None
  /// Required. Schedule recurring executions.
  pub recurring_schedule as "recurringSchedule,omitempty": RecurringSchedule? = None
  /// Optional. Rollout strategy of the patch job.
  pub rollout as "rollout,omitempty": PatchRollout? = None
  /// Output only. Current state of the patch deployment.
  pub state as "state,omitempty": Str = ""
  /// Output only. Time the patch deployment was last updated. Timestamp is in [RFC3339](https://www.ietf.org/rfc/rfc3339.txt) text format.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

/// PatchInstanceFilter: A filter to target VM instances for patching. The targeted VMs must meet all criteria specified. So if both labels and zones are specified, the patch job targets only VMs with those labels and in those zones.
pub struct PatchInstanceFilter {
  /// Target all VM instances in the project. If true, no other criteria is permitted.
  pub all as "all,omitempty": Bool = false
  /// Targets VM instances matching ANY of these GroupLabels. This allows targeting of disparate groups of VM instances.
  pub group_labels as "groupLabels,omitempty": List[PatchInstanceFilterGroupLabel] = []
  /// Targets VMs whose name starts with one of these prefixes. Similar to labels, this is another way to group VMs when targeting configs, for example prefix="prod-".
  pub instance_name_prefixes as "instanceNamePrefixes,omitempty": List[Str] = []
  /// Targets any of the VM instances specified. Instances are specified by their URI in the form `zones/[ZONE]/instances/[INSTANCE_NAME]`, `projects/[PROJECT_ID]/zones/[ZONE]/instances/[INSTANCE_NAME]`, or `https://www.googleapis.com/compute/v1/projects/[PROJECT_ID]/zones/[ZONE]/instances/[INSTANCE_NAME]`
  pub instances as "instances,omitempty": List[Str] = []
  /// Targets VM instances in ANY of these zones. Leave empty to target VM instances in any zone.
  pub zones as "zones,omitempty": List[Str] = []
} derive Json

/// PatchInstanceFilterGroupLabel: Targets a group of VM instances by using their [assigned labels](https://cloud.google.com/compute/docs/labeling-resources). Labels are key-value pairs. A `GroupLabel` is a combination of labels that is used to target VMs for a patch job. For example, a patch job can target VMs that have the following `GroupLabel`: `{"env":"test", "app":"web"}`. This means that the patch job is applied to VMs that have both the labels `env=test` and `app=web`.
pub struct PatchInstanceFilterGroupLabel {
  /// Compute Engine instance labels that must be present for a VM instance to be targeted by this filter.
  pub labels as "labels,omitempty": Map[Str, Str] = {}
} derive Json

/// PatchJob: A high level representation of a patch job that is either in progress or has completed. Instance details are not included in the job. To paginate through instance details, use `ListPatchJobInstanceDetails`. For more information about patch jobs, see [Creating patch jobs](https://cloud.google.com/compute/docs/os-patch-management/create-patch-job).
pub struct PatchJob {
  /// Time this patch job was created.
  pub create_time as "createTime,omitempty": Str = ""
  /// Description of the patch job. Length of the description is limited to 1024 characters.
  pub description as "description,omitempty": Str = ""
  /// Display name for this patch job. This is not a unique identifier.
  pub display_name as "displayName,omitempty": Str = ""
  /// If this patch job is a dry run, the agent reports that it has finished without running any updates on the VM instance.
  pub dry_run as "dryRun,omitempty": Bool = false
  /// Duration of the patch job. After the duration ends, the patch job times out.
  pub duration as "duration,omitempty": Str = ""
  /// If this patch job failed, this message provides information about the failure.
  pub error_message as "errorMessage,omitempty": Str = ""
  /// Summary of instance details.
  pub instance_details_summary as "instanceDetailsSummary,omitempty": PatchJobInstanceDetailsSummary? = None
  /// Instances to patch.
  pub instance_filter as "instanceFilter,omitempty": PatchInstanceFilter? = None
  /// Unique identifier for this patch job in the form `projects/*/patchJobs/*`
  pub name as "name,omitempty": Str = ""
  /// Patch configuration being applied.
  pub patch_config as "patchConfig,omitempty": PatchConfig? = None
  /// Output only. Name of the patch deployment that created this patch job.
  pub patch_deployment as "patchDeployment,omitempty": Str = ""
  /// Reflects the overall progress of the patch job in the range of 0.0 being no progress to 100.0 being complete.
  pub percent_complete as "percentComplete,omitempty": Float = 0.0
  /// Rollout strategy being applied.
  pub rollout as "rollout,omitempty": PatchRollout? = None
  /// The current state of the PatchJob.
  pub state as "state,omitempty": Str = ""
  /// Last time this patch job was updated.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

/// PatchJobInstanceDetails: Patch details for a VM instance. For more information about reviewing VM instance details, see [Listing all VM instance details for a specific patch job](https://cloud.google.com/compute/docs/os-patch-management/manage-patch-jobs#list-instance-details).
pub struct PatchJobInstanceDetails {
  /// The number of times the agent that the agent attempts to apply the patch.
  pub attempt_count as "attemptCount,omitempty,string": Int = 0
  /// If the patch fails, this field provides the reason.
  pub failure_reason as "failureReason,omitempty": Str = ""
  /// The unique identifier for the instance. This identifier is defined by the server.
  pub instance_system_id as "instanceSystemId,omitempty": Str = ""
  /// The instance name in the form `projects/*/zones/*/instances/*`
  pub name as "name,omitempty": Str = ""
  /// Current state of instance patch.
  pub state as "state,omitempty": Str = ""
} derive Json

/// PatchJobInstanceDetailsSummary: A summary of the current patch state across all instances that this patch job affects. Contains counts of instances in different states. These states map to `InstancePatchState`. List patch job instance details to see the specific states of each instance.
pub struct PatchJobInstanceDetailsSummary {
  /// Number of instances that have acked and will start shortly.
  pub acked_instance_count as "ackedInstanceCount,omitempty,string": Int = 0
  /// Number of instances that are applying patches.
  pub applying_patches_instance_count as "applyingPatchesInstanceCount,omitempty,string": Int = 0
  /// Number of instances that are downloading patches.
  pub downloading_patches_instance_count as "downloadingPatchesInstanceCount,omitempty,string": Int = 0
  /// Number of instances that failed.
  pub failed_instance_count as "failedInstanceCount,omitempty,string": Int = 0
  /// Number of instances that are inactive.
  pub inactive_instance_count as "inactiveInstanceCount,omitempty,string": Int = 0
  /// Number of instances that do not appear to be running the agent. Check to ensure that the agent is installed, running, and able to communicate with the service.
  pub no_agent_detected_instance_count as "noAgentDetectedInstanceCount,omitempty,string": Int = 0
  /// Number of instances notified about patch job.
  pub notified_instance_count as "notifiedInstanceCount,omitempty,string": Int = 0
  /// Number of instances pending patch job.
  pub pending_instance_count as "pendingInstanceCount,omitempty,string": Int = 0
  /// Number of instances that are running the post-patch step.
  pub post_patch_step_instance_count as "postPatchStepInstanceCount,omitempty,string": Int = 0
  /// Number of instances that are running the pre-patch step.
  pub pre_patch_step_instance_count as "prePatchStepInstanceCount,omitempty,string": Int = 0
  /// Number of instances rebooting.
  pub rebooting_instance_count as "rebootingInstanceCount,omitempty,string": Int = 0
  /// Number of instances that were skipped during patching.
  pub skipped_instance_count as "skippedInstanceCount,omitempty,string": Int = 0
  /// Number of instances that have started.
  pub started_instance_count as "startedInstanceCount,omitempty,string": Int = 0
  /// Number of instances that have completed successfully.
  pub succeeded_instance_count as "succeededInstanceCount,omitempty,string": Int = 0
  /// Number of instances that require reboot.
  pub succeeded_reboot_required_instance_count as "succeededRebootRequiredInstanceCount,omitempty,string": Int = 0
  /// Number of instances that exceeded the time out while applying the patch.
  pub timed_out_instance_count as "timedOutInstanceCount,omitempty,string": Int = 0
} derive Json

/// PatchRollout: Patch rollout configuration specifications. Contains details on the concurrency control when applying patch(es) to all targeted VMs.
pub struct PatchRollout {
  /// The maximum number (or percentage) of VMs per zone to disrupt at any given moment. The number of VMs calculated from multiplying the percentage by the total number of VMs in a zone is rounded up. During patching, a VM is considered disrupted from the time the agent is notified to begin until patching has completed. This disruption time includes the time to complete reboot and any post-patch steps. A VM contributes to the disruption budget if its patching operation fails either when applying the patches, running pre or post patch steps, or if it fails to respond with a success notification before timing out. VMs that are not running or do not have an active agent do not count toward this disruption budget. For zone-by-zone rollouts, if the disruption budget in a zone is exceeded, the patch job stops, because continuing to the next zone requires completion of the patch process in the previous zone. For example, if the disruption budget has a fixed value of `10`, and 8 VMs fail to patch in the current zone, the patch job continues to patch 2 VMs at a time until the zone is completed. When that zone is completed successfully, patching begins with 10 VMs at a time in the next zone. If 10 VMs in the next zone fail to patch, the patch job stops.
  pub disruption_budget as "disruptionBudget,omitempty": FixedOrPercent? = None
  /// Mode of the patch rollout.
  pub mode as "mode,omitempty": Str = ""
} derive Json

/// PausePatchDeploymentRequest: A request message for pausing a patch deployment.
pub struct PausePatchDeploymentRequest {} derive Json

/// ProjectFeatureSettings: ProjectFeatureSettings represents the VM Manager feature settings in a project. For more information, see Enable full VM Manager functionality.
pub struct ProjectFeatureSettings {
