  /// List of inventory filters for the resource group. The resources in this resource group are applied to the target VM if it satisfies at least one of the following inventory filters. For example, to apply this resource group to VMs running either `RHEL` or `CentOS` operating systems, specify 2 items for the list with following values: inventory_filters[0].os_short_name='rhel' and inventory_filters[1].os_short_name='centos' If the list is empty, this resource group will be applied to the target VM unconditionally.
  pub inventory_filters as "inventoryFilters,omitempty": List[OSPolicyInventoryFilter] = []
  /// Required. List of resources configured for this resource group. The resources are executed in the exact order specified here.
  pub resources as "resources,omitempty": List[OSPolicyResource] = []
} derive Json

/// OSPolicyResourcePackageResource: A resource that manages a system package.
pub struct OSPolicyResourcePackageResource {
  /// A package managed by Apt.
  pub apt as "apt,omitempty": OSPolicyResourcePackageResourceAPT? = None
  /// A deb package file.
  pub deb as "deb,omitempty": OSPolicyResourcePackageResourceDeb? = None
  /// Required. The desired state the agent should maintain for this package.
  pub desired_state as "desiredState,omitempty": Str = ""
  /// A package managed by GooGet.
  pub googet as "googet,omitempty": OSPolicyResourcePackageResourceGooGet? = None
  /// An MSI package.
  pub msi as "msi,omitempty": OSPolicyResourcePackageResourceMSI? = None
  /// An rpm package file.
  pub rpm as "rpm,omitempty": OSPolicyResourcePackageResourceRPM? = None
  /// A package managed by YUM.
  pub yum as "yum,omitempty": OSPolicyResourcePackageResourceYUM? = None
  /// A package managed by Zypper.
  pub zypper as "zypper,omitempty": OSPolicyResourcePackageResourceZypper? = None
} derive Json

/// OSPolicyResourcePackageResourceAPT: A package managed by APT. - install: `apt-get update && apt-get -y install [name]` - remove: `apt-get -y remove [name]`
pub struct OSPolicyResourcePackageResourceAPT {
  /// Required. Package name.
  pub name as "name,omitempty": Str = ""
} derive Json

/// OSPolicyResourcePackageResourceDeb: A deb package file. dpkg packages only support INSTALLED state.
pub struct OSPolicyResourcePackageResourceDeb {
  /// Whether dependencies should also be installed. - install when false: `dpkg -i package` - install when true: `apt-get update && apt-get -y install package.deb`
  pub pull_deps as "pullDeps,omitempty": Bool = false
  /// Required. A deb package.
  pub source as "source,omitempty": OSPolicyResourceFile? = None
} derive Json

/// OSPolicyResourcePackageResourceGooGet: A package managed by GooGet. - install: `googet -noconfirm install package` - remove: `googet -noconfirm remove package`
pub struct OSPolicyResourcePackageResourceGooGet {
  /// Required. Package name.
  pub name as "name,omitempty": Str = ""
} derive Json

/// OSPolicyResourcePackageResourceMSI: An MSI package. MSI packages only support INSTALLED state.
pub struct OSPolicyResourcePackageResourceMSI {
  /// Additional properties to use during installation. This should be in the format of Property=Setting. Appended to the defaults of `ACTION=INSTALL REBOOT=ReallySuppress`.
  pub properties as "properties,omitempty": List[Str] = []
  /// Required. The MSI package.
  pub source as "source,omitempty": OSPolicyResourceFile? = None
} derive Json

/// OSPolicyResourcePackageResourceRPM: An RPM package file. RPM packages only support INSTALLED state.
pub struct OSPolicyResourcePackageResourceRPM {
  /// Whether dependencies should also be installed. - install when false: `rpm --upgrade --replacepkgs package.rpm` - install when true: `yum -y install package.rpm` or `zypper -y install package.rpm`
  pub pull_deps as "pullDeps,omitempty": Bool = false
  /// Required. An rpm package.
  pub source as "source,omitempty": OSPolicyResourceFile? = None
} derive Json

/// OSPolicyResourcePackageResourceYUM: A package managed by YUM. - install: `yum -y install package` - remove: `yum -y remove package`
pub struct OSPolicyResourcePackageResourceYUM {
  /// Required. Package name.
  pub name as "name,omitempty": Str = ""
} derive Json

/// OSPolicyResourcePackageResourceZypper: A package managed by Zypper. - install: `zypper -y install package` - remove: `zypper -y rm package`
pub struct OSPolicyResourcePackageResourceZypper {
  /// Required. Package name.
  pub name as "name,omitempty": Str = ""
} derive Json

/// OSPolicyResourceRepositoryResource: A resource that manages a package repository.
pub struct OSPolicyResourceRepositoryResource {
  /// An Apt Repository.
  pub apt as "apt,omitempty": OSPolicyResourceRepositoryResourceAptRepository? = None
  /// A Goo Repository.
  pub goo as "goo,omitempty": OSPolicyResourceRepositoryResourceGooRepository? = None
  /// A Yum Repository.
  pub yum as "yum,omitempty": OSPolicyResourceRepositoryResourceYumRepository? = None
  /// A Zypper Repository.
  pub zypper as "zypper,omitempty": OSPolicyResourceRepositoryResourceZypperRepository? = None
} derive Json

/// OSPolicyResourceRepositoryResourceAptRepository: Represents a single apt package repository. These will be added to a repo file that will be managed at `/etc/apt/sources.list.d/google_osconfig.list`.
pub struct OSPolicyResourceRepositoryResourceAptRepository {
  /// Required. Type of archive files in this repository.
  pub archive_type as "archiveType,omitempty": Str = ""
  /// Required. List of components for this repository. Must contain at least one item.
  pub components as "components,omitempty": List[Str] = []
  /// Required. Distribution of this repository.
  pub distribution as "distribution,omitempty": Str = ""
  /// URI of the key file for this repository. The agent maintains a keyring at `/etc/apt/trusted.gpg.d/osconfig_agent_managed.gpg`.
  pub gpg_key as "gpgKey,omitempty": Str = ""
  /// Required. URI for this repository.
  pub uri as "uri,omitempty": Str = ""
} derive Json

/// OSPolicyResourceRepositoryResourceGooRepository: Represents a Goo package repository. These are added to a repo file that is managed at `C:/ProgramData/GooGet/repos/google_osconfig.repo`.
pub struct OSPolicyResourceRepositoryResourceGooRepository {
  /// Required. The name of the repository.
  pub name as "name,omitempty": Str = ""
  /// Required. The url of the repository.
  pub url as "url,omitempty": Str = ""
} derive Json

/// OSPolicyResourceRepositoryResourceYumRepository: Represents a single yum package repository. These are added to a repo file that is managed at `/etc/yum.repos.d/google_osconfig.repo`.
pub struct OSPolicyResourceRepositoryResourceYumRepository {
  /// Required. The location of the repository directory.
  pub base_url as "baseUrl,omitempty": Str = ""
  /// The display name of the repository.
  pub display_name as "displayName,omitempty": Str = ""
  /// URIs of GPG keys.
  pub gpg_keys as "gpgKeys,omitempty": List[Str] = []
  /// Required. A one word, unique name for this repository. This is the `repo id` in the yum config file and also the `display_name` if `display_name` is omitted. This id is also used as the unique identifier when checking for resource conflicts.
  pub id as "id,omitempty": Str = ""
} derive Json

/// OSPolicyResourceRepositoryResourceZypperRepository: Represents a single zypper package repository. These are added to a repo file that is managed at `/etc/zypp/repos.d/google_osconfig.repo`.
pub struct OSPolicyResourceRepositoryResourceZypperRepository {
  /// Required. The location of the repository directory.
  pub base_url as "baseUrl,omitempty": Str = ""
  /// The display name of the repository.
  pub display_name as "displayName,omitempty": Str = ""
  /// URIs of GPG keys.
  pub gpg_keys as "gpgKeys,omitempty": List[Str] = []
  /// Required. A one word, unique name for this repository. This is the `repo id` in the zypper config file and also the `display_name` if `display_name` is omitted. This id is also used as the unique identifier when checking for GuestPolicy conflicts.
  pub id as "id,omitempty": Str = ""
} derive Json

/// Operation: This resource represents a long-running operation that is the result of a network API call.
pub struct Operation {
  /// If the value is `false`, it means the operation is still in progress. If `true`, the operation is completed, and either `error` or `response` is available.
  pub done as "done,omitempty": Bool = false
  /// The error result of the operation in case of failure or cancellation.
  pub error as "error,omitempty": Status? = None
  /// Service-specific metadata associated with the operation. It typically contains progress information and common metadata such as create time. Some services might not provide such metadata. Any method that returns a long-running operation should document the metadata type, if any.
  pub metadata as "metadata,omitempty": json.Value? = None
  /// The server-assigned name, which is only unique within the same service that originally returns it. If you use the default HTTP mapping, the `name` should be a resource name ending with `operations/{unique_id}`.
  pub name as "name,omitempty": Str = ""
  /// The normal, successful response of the operation. If the original method returns no data on success, such as `Delete`, the response is `google.protobuf.Empty`. If the original method is standard `Get`/`Create`/`Update`, the response should be the resource. For other methods, the response should have the type `XxxResponse`, where `Xxx` is the original method name. For example, if the original method name is `TakeSnapshot()`, the inferred response type is `TakeSnapshotResponse`.
  pub response as "response,omitempty": json.Value? = None
} derive Json

/// Status: The `Status` type defines a logical error model that is suitable for different programming environments, including REST APIs and RPC APIs. It is used by [gRPC](https://github.com/grpc). Each `Status` message contains three pieces of data: error code, error message, and error details. You can find out more about this error model and how to work with it in the [API Design Guide](https://cloud.google.com/apis/design/errors).
pub struct Status {
  /// The status code, which should be an enum value of google.rpc.Code.
  pub code as "code,omitempty": Int = 0
  /// A list of messages that carry the error details. There is a common set of message types for APIs to use.
  pub details as "details,omitempty": List[json.Value] = []
  /// A developer-facing error message, which should be in English. Any user-facing error message should be localized and sent in the google.rpc.Status.details field, or localized by the client.
  pub message as "message,omitempty": Str = ""
} derive Json

