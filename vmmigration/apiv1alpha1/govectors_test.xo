  match svc.projects.locations.target_projects.patch("id1/ x", json.decode_str[TargetProject]("{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"name\":\"s-name\",\"project\":\"s-project\",\"updateTime\":\"s-updatetime\"}") ?? e => fault(e.display()), options: ProjectsLocationsTargetProjectsPatchOptions{request_id: Some("s-requestid"), update_mask: Some("s-updatemask"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_83)
}
