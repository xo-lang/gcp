  gv_queue(f, "{\"datacenterConnectors\":[{\"applianceInfrastructureVersion\":\"s-applianceinfrastructureversion\",\"applianceSoftwareVersion\":\"s-appliancesoftwareversion\",\"availableVersions\":{},\"bucket\":\"s-bucket\",\"createTime\":\"s-createtime\",\"error\":{\"code\":7,\"message\":\"s-message\"},\"name\":\"s-name\",\"registrationId\":\"s-registrationid\",\"serviceAccount\":\"s-serviceaccount\",\"state\":\"s-state\",\"stateTime\":\"s-statetime\",\"updateTime\":\"s-updatetime\",\"upgradeStatus\":{\"previousVersion\":\"s-previousversion\",\"startTime\":\"s-starttime\",\"state\":\"s-state\",\"version\":\"s-version\"},\"version\":\"s-version\"}],\"unreachable\":[\"s-unreachable\"]}")
