  "  B {\"permissions\":[\"s-permissions\"]}",
  "",
  "  SERVED 200 {\"permissions\":[\"s-permissions\"]}",
  "OUT: {\"permissions\":[\"s-permissions\"]}",
]

test "Go's bigquerydatapolicy.projects.locations.dataPolicies.testIamPermissions" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"permissions\":[\"s-permissions\"]}")
  gv_note(f, "CALL bigquerydatapolicy.projects.locations.dataPolicies.testIamPermissions")
  match svc.projects.locations.data_policies.test_iam_permissions("id1/ x", json.decode_str[TestIamPermissionsRequest]("{\"permissions\":[\"s-permissions\"]}") ?? e => fault(e.display()), options: ProjectsLocationsDataPoliciesTestIamPermissionsOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_9)
}
