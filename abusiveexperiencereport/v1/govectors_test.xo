use std/json

const GV_HOST: Str = "https://abusiveexperiencereport.googleapis.com"

const GO_0: List[Str] = [
  "CALL abusiveexperiencereport.sites.get",
  "REQ GET https://abusiveexperiencereport.googleapis.com/v1/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"abusiveStatus\":\"s-abusivestatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"reportUrl\":\"s-reporturl\",\"reviewedSite\":\"s-reviewedsite\",\"underReview\":true}",
  "OUT: {\"abusiveStatus\":\"s-abusivestatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"reportUrl\":\"s-reporturl\",\"reviewedSite\":\"s-reviewedsite\",\"underReview\":true}",
]

test "Go's abusiveexperiencereport.sites.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"abusiveStatus\":\"s-abusivestatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"reportUrl\":\"s-reporturl\",\"reviewedSite\":\"s-reviewedsite\",\"underReview\":true}")
  gv_note(f, "CALL abusiveexperiencereport.sites.get")
  match svc.sites.get("id1/ x", options: SitesGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

