  gv_queue(f, "{\"agentPools\":[{\"bandwidthLimit\":{\"limitMbps\":\"7\"},\"displayName\":\"s-displayname\",\"name\":\"s-name\",\"state\":\"s-state\"}]}")
  gv_note(f, "CALL storagetransfer.projects.agentPools.list pages")
  var p = svc.projects.agent_pools.list_pages("id1/ x", options: ProjectsAgentPoolsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
