test "Go's storagetransfer.transferJobs.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"transferJobs\":[{\"creationTime\":\"s-creationtime\",\"deletionTime\":\"s-deletiontime\",\"description\":\"s-description\",\"eventStream\":{\"eventStreamExpirationTime\":\"s-eventstreamexpirationtime\",\"eventStreamStartTime\":\"s-eventstreamstarttime\",\"name\":\"s-name\"},\"lastModificationTime\":\"s-lastmodificationtime\",\"latestOperationName\":\"s-latestoperationname\",\"loggingConfig\":{\"enableOnpremGcsTransferLogs\":true},\"name\":\"s-name\",\"notificationConfig\":{\"payloadFormat\":\"s-payloadformat\",\"pubsubTopic\":\"s-pubsubtopic\"},\"projectId\":\"s-projectid\",\"replicationSpec\":{},\"schedule\":{\"repeatInterval\":\"s-repeatinterval\"},\"serviceAccount\":\"s-serviceaccount\",\"status\":\"s-status\",\"transferSpec\":{\"sinkAgentPoolName\":\"s-sinkagentpoolname\",\"sourceAgentPoolName\":\"s-sourceagentpoolname\"}}]}")
  gv_queue(f, "{\"transferJobs\":[{\"creationTime\":\"s-creationtime\",\"deletionTime\":\"s-deletiontime\",\"description\":\"s-description\",\"eventStream\":{\"eventStreamExpirationTime\":\"s-eventstreamexpirationtime\",\"eventStreamStartTime\":\"s-eventstreamstarttime\",\"name\":\"s-name\"},\"lastModificationTime\":\"s-lastmodificationtime\",\"latestOperationName\":\"s-latestoperationname\",\"loggingConfig\":{\"enableOnpremGcsTransferLogs\":true},\"name\":\"s-name\",\"notificationConfig\":{\"payloadFormat\":\"s-payloadformat\",\"pubsubTopic\":\"s-pubsubtopic\"},\"projectId\":\"s-projectid\",\"replicationSpec\":{},\"schedule\":{\"repeatInterval\":\"s-repeatinterval\"},\"serviceAccount\":\"s-serviceaccount\",\"status\":\"s-status\",\"transferSpec\":{\"sinkAgentPoolName\":\"s-sinkagentpoolname\",\"sourceAgentPoolName\":\"s-sourceagentpoolname\"}}]}")
  gv_note(f, "CALL storagetransfer.transferJobs.list pages")
  var p = svc.transfer_jobs.list_pages("s-filter", options: TransferJobsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_11)
}

