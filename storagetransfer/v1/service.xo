}

/// list_pages: TransferOperationsService.list's pages, from the first.
pub fn (r: TransferOperationsService[fx]) list_pages(name: Str, filter: Str, options: TransferOperationsListOptions = TransferOperationsListOptions{}) -> TransferOperationsListPages[fx] {
  TransferOperationsListPages{r: r, name: name, filter: filter, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: TransferOperationsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: TransferOperationsListPages[fx]) next_page() -> ListOperationsResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.name, p.filter, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

