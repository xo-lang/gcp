/// Schedule: Transfers can be scheduled to recur or to run just once.
pub struct Schedule {
  /// The time in UTC that no further transfer operations are scheduled. Combined with schedule_end_date, `end_time_of_day` specifies the end date and time for starting new transfer operations. This field must be greater than or equal to the timestamp corresponding to the combination of schedule_start_date and start_time_of_day, and is subject to the following: * If `end_time_of_day` is not set and `schedule_end_date` is set, then a default value of `23:59:59` is used for `end_time_of_day`. * If `end_time_of_day` is set and `schedule_end_date` is not set, then INVALID_ARGUMENT is returned.
  pub end_time_of_day as "endTimeOfDay,omitempty": TimeOfDay? = None
  /// Interval between the start of each scheduled TransferOperation. If unspecified, the default value is 24 hours. This value may not be less than 1 hour.
  pub repeat_interval as "repeatInterval,omitempty": Str = ""
  /// The last day a transfer runs. Date boundaries are determined relative to UTC time. A job runs once per 24 hours within the following guidelines: * If `schedule_end_date` and schedule_start_date are the same and in the future relative to UTC, the transfer is executed only one time. * If `schedule_end_date` is later than `schedule_start_date` and `schedule_end_date` is in the future relative to UTC, the job runs each day at start_time_of_day through `schedule_end_date`.
  pub schedule_end_date as "scheduleEndDate,omitempty": Date? = None
  /// Required. The start date of a transfer. Date boundaries are determined relative to UTC time. If `schedule_start_date` and start_time_of_day are in the past relative to the job's creation time, the transfer starts the day after you schedule the transfer request. **Note:** When starting jobs at or near midnight UTC it is possible that a job starts later than expected. For example, if you send an outbound request on June 1 one millisecond prior to midnight UTC and the Storage Transfer Service server receives the request on June 2, then it creates a TransferJob with `schedule_start_date` set to June 2 and a `start_time_of_day` set to midnight UTC. The first scheduled TransferOperation takes place on June 3 at midnight UTC.
  pub schedule_start_date as "scheduleStartDate,omitempty": Date? = None
  /// The time in UTC that a transfer job is scheduled to run. Transfers may start later than this time. If `start_time_of_day` is not specified: * One-time transfers run immediately. * Recurring transfers run immediately, and each day at midnight UTC, through schedule_end_date. If `start_time_of_day` is specified: * One-time transfers run at the specified time. * Recurring transfers run at the specified time each day, through `schedule_end_date`.
  pub start_time_of_day as "startTimeOfDay,omitempty": TimeOfDay? = None
} derive Json

/// Status: The `Status` type defines a logical error model that is suitable for different programming environments, including REST APIs and RPC APIs. It is used by [gRPC](https://github.com/grpc). Each `Status` message contains three pieces of data: error code, error message, and error details. You can find out more about this error model and how to work with it in the [API Design Guide](https://cloud.google.com/apis/design/errors).
pub struct Status {
  /// The status code, which should be an enum value of google.rpc.Code.
  pub code as "code,omitempty": Int = 0
  /// A list of messages that carry the error details. There is a common set of message types for APIs to use.
  pub details as "details,omitempty": List[json.Value] = []
  /// A developer-facing error message, which should be in English. Any user-facing error message should be localized and sent in the google.rpc.Status.details field, or localized by the client.
  pub message as "message,omitempty": Str = ""
} derive Json

/// TimeOfDay: Represents a time of day. The date and time zone are either not significant or are specified elsewhere. An API may choose to allow leap seconds. Related types are google.type.Date and `google.protobuf.Timestamp`.
pub struct TimeOfDay {
  /// Hours of a day in 24 hour format. Must be greater than or equal to 0 and typically must be less than or equal to 23. An API may choose to allow the value "24:00:00" for scenarios like business closing time.
  pub hours as "hours,omitempty": Int = 0
  /// Minutes of an hour. Must be greater than or equal to 0 and less than or equal to 59.
  pub minutes as "minutes,omitempty": Int = 0
  /// Fractions of seconds, in nanoseconds. Must be greater than or equal to 0 and less than or equal to 999,999,999.
  pub nanos as "nanos,omitempty": Int = 0
  /// Seconds of a minute. Must be greater than or equal to 0 and typically must be less than or equal to 59. An API may allow the value 60 if it allows leap-seconds.
  pub seconds as "seconds,omitempty": Int = 0
} derive Json

/// TransferCounters: A collection of counters that report the progress of a transfer operation.
pub struct TransferCounters {
  /// Bytes that are copied to the data sink.
  pub bytes_copied_to_sink as "bytesCopiedToSink,omitempty,string": Int = 0
  /// Bytes that are deleted from the data sink.
  pub bytes_deleted_from_sink as "bytesDeletedFromSink,omitempty,string": Int = 0
  /// Bytes that are deleted from the data source.
  pub bytes_deleted_from_source as "bytesDeletedFromSource,omitempty,string": Int = 0
  /// Bytes that failed to be deleted from the data sink.
  pub bytes_failed_to_delete_from_sink as "bytesFailedToDeleteFromSink,omitempty,string": Int = 0
  /// Bytes found in the data source that are scheduled to be transferred, excluding any that are filtered based on object conditions or skipped due to sync.
  pub bytes_found_from_source as "bytesFoundFromSource,omitempty,string": Int = 0
  /// Bytes found only in the data sink that are scheduled to be deleted.
  pub bytes_found_only_from_sink as "bytesFoundOnlyFromSink,omitempty,string": Int = 0
  /// Bytes in the data source that failed to be transferred or that failed to be deleted after being transferred.
  pub bytes_from_source_failed as "bytesFromSourceFailed,omitempty,string": Int = 0
  /// Bytes in the data source that are not transferred because they already exist in the data sink.
  pub bytes_from_source_skipped_by_sync as "bytesFromSourceSkippedBySync,omitempty,string": Int = 0
  /// For transfers involving PosixFilesystem only. Number of listing failures for each directory found at the source. Potential failures when listing a directory include permission failure or block failure. If listing a directory fails, no files in the directory are transferred.
  pub directories_failed_to_list_from_source as "directoriesFailedToListFromSource,omitempty,string": Int = 0
  /// For transfers involving PosixFilesystem only. Number of directories found while listing. For example, if the root directory of the transfer is `base/` and there are two other directories, `a/` and `b/` under this directory, the count after listing `base/`, `base/a/` and `base/b/` is 3.
  pub directories_found_from_source as "directoriesFoundFromSource,omitempty,string": Int = 0
  /// For transfers involving PosixFilesystem only. Number of successful listings for each directory found at the source.
  pub directories_successfully_listed_from_source as "directoriesSuccessfullyListedFromSource,omitempty,string": Int = 0
  /// Number of successfully cleaned up intermediate objects.
  pub intermediate_objects_cleaned_up as "intermediateObjectsCleanedUp,omitempty,string": Int = 0
  /// Number of intermediate objects failed cleaned up.
  pub intermediate_objects_failed_cleaned_up as "intermediateObjectsFailedCleanedUp,omitempty,string": Int = 0
  /// Objects that are copied to the data sink.
  pub objects_copied_to_sink as "objectsCopiedToSink,omitempty,string": Int = 0
  /// Objects that are deleted from the data sink.
  pub objects_deleted_from_sink as "objectsDeletedFromSink,omitempty,string": Int = 0
  /// Objects that are deleted from the data source.
  pub objects_deleted_from_source as "objectsDeletedFromSource,omitempty,string": Int = 0
  /// Objects that failed to be deleted from the data sink.
  pub objects_failed_to_delete_from_sink as "objectsFailedToDeleteFromSink,omitempty,string": Int = 0
  /// Objects found in the data source that are scheduled to be transferred, excluding any that are filtered based on object conditions or skipped due to sync.
  pub objects_found_from_source as "objectsFoundFromSource,omitempty,string": Int = 0
  /// Objects found only in the data sink that are scheduled to be deleted.
  pub objects_found_only_from_sink as "objectsFoundOnlyFromSink,omitempty,string": Int = 0
  /// Objects in the data source that failed to be transferred or that failed to be deleted after being transferred.
  pub objects_from_source_failed as "objectsFromSourceFailed,omitempty,string": Int = 0
  /// Objects in the data source that are not transferred because they already exist in the data sink.
  pub objects_from_source_skipped_by_sync as "objectsFromSourceSkippedBySync,omitempty,string": Int = 0
  /// Number of unrestored deep archive objects skipped.
  pub unrestored_deep_archive_objects_skipped_count as "unrestoredDeepArchiveObjectsSkippedCount,omitempty,string": Int = 0
  /// Number of glacier objects skipped, glacier objects are unsupported by default regardless of the restore status. Allowlist the project to copy glacier objects if needed.
  pub unsupported_s3_glacier_objects_skipped_count as "unsupportedS3GlacierObjectsSkippedCount,omitempty,string": Int = 0
} derive Json

/// TransferJob: This resource represents the configuration of a transfer job that runs periodically.
pub struct TransferJob {
  /// Output only. The time that the transfer job was created.
  pub creation_time as "creationTime,omitempty": Str = ""
  /// Output only. The time that the transfer job was deleted.
  pub deletion_time as "deletionTime,omitempty": Str = ""
  /// A description provided by the user for the job. Its max length is 1024 bytes when Unicode-encoded.
  pub description as "description,omitempty": Str = ""
  /// Specifies the event stream for the transfer job for event-driven transfers. When EventStream is specified, the Schedule fields are ignored.
  pub event_stream as "eventStream,omitempty": EventStream? = None
  /// Output only. The time that the transfer job was last modified.
  pub last_modification_time as "lastModificationTime,omitempty": Str = ""
  /// The name of the most recently started TransferOperation of this JobConfig. Present if a TransferOperation has been created for this JobConfig.
  pub latest_operation_name as "latestOperationName,omitempty": Str = ""
  /// Logging configuration.
  pub logging_config as "loggingConfig,omitempty": LoggingConfig? = None
  /// A unique name (within the transfer project) assigned when the job is created. If this field is empty in a CreateTransferJobRequest, Storage Transfer Service assigns a unique name. Otherwise, the specified name is used as the unique name for this job. If the specified name is in use by a job, the creation request fails with an ALREADY_EXISTS error. This name must start with `"transferJobs/"` prefix and end with a letter or a number, and should be no more than 128 characters. For transfers involving PosixFilesystem, this name must start with `transferJobs/OPI` specifically. For all other transfer types, this name must not start with `transferJobs/OPI`. Non-PosixFilesystem example: `"transferJobs/^(?!OPI)[A-Za-z0-9-._~]*[A-Za-z0-9]$"` PosixFilesystem example: `"transferJobs/OPI^[A-Za-z0-9-._~]*[A-Za-z0-9]$"` Applications must not rely on the enforcement of naming requirements involving OPI. Invalid job names fail with an INVALID_ARGUMENT error.
  pub name as "name,omitempty": Str = ""
  /// Notification configuration.
  pub notification_config as "notificationConfig,omitempty": NotificationConfig? = None
  /// The ID of the Google Cloud project that owns the job.
  pub project_id as "projectId,omitempty": Str = ""
  /// Replication specification.
  pub replication_spec as "replicationSpec,omitempty": ReplicationSpec? = None
  /// Specifies schedule for the transfer job. This is an optional field. When the field is not set, the job never executes a transfer, unless you invoke RunTransferJob or update the job to have a non-empty schedule.
  pub schedule as "schedule,omitempty": Schedule? = None
  /// Optional. The user-managed service account to which to delegate service agent permissions. You can grant Cloud Storage bucket permissions to this service account instead of to the Transfer Service service agent. Either the service account email (`SERVICE_ACCOUNT_NAME@PROJECT_ID.iam.gserviceaccount.com`) or the unique ID (`123456789012345678901`) are accepted. See https://docs.cloud.google.com/storage-transfer/docs/delegate-service-agent-permissions for required permissions.
  pub service_account as "serviceAccount,omitempty": Str = ""
  /// Status of the job. This value MUST be specified for `CreateTransferJobRequests`. **Note:** The effect of the new job status takes place during a subsequent job run. For example, if you change the job status from ENABLED to DISABLED, and an operation spawned by the transfer is running, the status change would not affect the current operation.
  pub status as "status,omitempty": Str = ""
  /// Transfer specification.
  pub transfer_spec as "transferSpec,omitempty": TransferSpec? = None
} derive Json

