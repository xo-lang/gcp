  /// Optional. A Cloud Storage data source.
  pub gcs_data_source as "gcsDataSource,omitempty": GcsData? = None
  /// For transfers between file systems, specifies a Cloud Storage bucket to be used as an intermediate location through which to transfer data. See [Transfer data between file systems](https://cloud.google.com/storage-transfer/docs/file-to-file) for more information.
  pub gcs_intermediate_data_location as "gcsIntermediateDataLocation,omitempty": GcsData? = None
  /// Optional. An HDFS cluster data source.
  pub hdfs_data_source as "hdfsDataSource,omitempty": HdfsData? = None
  /// Optional. An HTTP URL data source.
  pub http_data_source as "httpDataSource,omitempty": HttpData? = None
  /// Only objects that satisfy these object conditions are included in the set of data source and data sink objects. Object conditions based on objects' "last modification time" do not exclude objects in a data sink.
  pub object_conditions as "objectConditions,omitempty": ObjectConditions? = None
  /// Optional. A POSIX Filesystem data sink.
  pub posix_data_sink as "posixDataSink,omitempty": PosixFilesystem? = None
  /// Optional. A POSIX Filesystem data source.
  pub posix_data_source as "posixDataSource,omitempty": PosixFilesystem? = None
  /// Specifies the agent pool name associated with the posix data sink. When unspecified, the default name is used.
  pub sink_agent_pool_name as "sinkAgentPoolName,omitempty": Str = ""
  /// Specifies the agent pool name associated with the posix data source. When unspecified, the default name is used.
  pub source_agent_pool_name as "sourceAgentPoolName,omitempty": Str = ""
  /// A manifest file provides a list of objects to be transferred from the data source. This field points to the location of the manifest file. Otherwise, the entire source bucket is used. ObjectConditions still apply.
  pub transfer_manifest as "transferManifest,omitempty": TransferManifest? = None
  /// If the option delete_objects_unique_in_sink is `true` and time-based object conditions such as 'last modification time' are specified, the request fails with an INVALID_ARGUMENT error.
  pub transfer_options as "transferOptions,omitempty": TransferOptions? = None
} derive Json

