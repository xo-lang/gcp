/// TransferOptions: TransferOptions define the actions to be performed on objects in a transfer.
pub struct TransferOptions {
  /// Whether objects should be deleted from the source after they are transferred to the sink. **Note:** This option and delete_objects_unique_in_sink are mutually exclusive.
  pub delete_objects_from_source_after_transfer as "deleteObjectsFromSourceAfterTransfer,omitempty": Bool = false
  /// Whether objects that exist only in the sink should be deleted from the sink. **Note:** This option and delete_objects_from_source_after_transfer are mutually exclusive.
  pub delete_objects_unique_in_sink as "deleteObjectsUniqueInSink,omitempty": Bool = false
  /// Represents the selected metadata options for a transfer job.
  pub metadata_options as "metadataOptions,omitempty": MetadataOptions? = None
  /// When to overwrite objects that already exist in the sink. The default is that only objects that are different from the source are overwritten. If true, all objects in the sink whose name matches an object in the source are overwritten with the source object.
  pub overwrite_objects_already_existing_in_sink as "overwriteObjectsAlreadyExistingInSink,omitempty": Bool = false
  /// When to overwrite objects that already exist in the sink. If not set, overwrite behavior is determined by overwrite_objects_already_existing_in_sink.
  pub overwrite_when as "overwriteWhen,omitempty": Str = ""
} derive Json

/// TransferSpec: Configuration for running a transfer.
pub struct TransferSpec {
  /// Optional. An AWS S3 compatible data source.
