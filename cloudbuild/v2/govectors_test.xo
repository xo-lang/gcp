  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"refNames\":[\"s-refnames\"]}")
  gv_queue(f, "{\"refNames\":[\"s-refnames\"]}")
  gv_note(f, "CALL cloudbuild.projects.locations.connections.repositories.fetchGitRefs pages")
  var p = svc.projects.locations.connections.repositories.fetch_git_refs_pages("id1/ x", options: ProjectsLocationsConnectionsRepositoriesFetchGitRefsOptions{page_size: Some(7), page_token: Some("s-pagetoken"), ref_type: Some("s-reftype"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_21)
}

