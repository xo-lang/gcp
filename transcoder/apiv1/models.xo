  pub mode as "mode,omitempty": Str = ""
  /// The picture field parity assumed for the input interlaced video. The default is `auto`. Supported values: - `tff`: Assume the top field is first - `bff`: Assume the bottom field is first - `auto`: Enable automatic detection of field parity
  pub parity as "parity,omitempty": Str = ""
  pub force_send_fields as "-": List[YadifConfigField] = []
  pub null_fields as "-": List[YadifConfigField] = []
} derive Json

/// YadifConfigField: YadifConfig's fields, for force_send_fields and null_fields.
pub enum YadifConfigField {
  DeinterlaceAllFrames
  DisableSpatialInterlacing
  Mode
  Parity
}

fn yadif_config_field_entry(f: YadifConfigField) -> Str {
  match f {
    DeinterlaceAllFrames => "deinterlaceAllFrames=false"
    DisableSpatialInterlacing => "disableSpatialInterlacing=false"
    Mode => "mode=\"\""
    Parity => "parity=\"\""
  }
}

/// body_marked: whether m, or a model in it, sets force_send_fields or
/// null_fields (decision 0013; the service's request bodies ask).
pub fn (m: YadifConfig) body_marked() -> Bool {
  if m.force_send_fields.len() > 0 || m.null_fields.len() > 0 {
    return true
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: YadifConfig) body_mark(v: json.Value) -> json.Value {
  var o = v
  gensupport.mark(o, m.force_send_fields.map(yadif_config_field_entry), m.null_fields.map(yadif_config_field_entry))
}
