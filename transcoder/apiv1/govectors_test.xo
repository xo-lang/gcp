test "Go's transcoder.projects.locations.jobs.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"jobs\":[{\"batchModePriority\":7,\"config\":{},\"createTime\":\"s-createtime\",\"endTime\":\"s-endtime\",\"error\":{\"code\":7,\"message\":\"s-message\"},\"fillContentGaps\":true,\"inputUri\":\"s-inputuri\",\"labels\":{\"k1\":\"s-labels\"},\"mode\":\"s-mode\",\"name\":\"s-name\",\"optimization\":\"s-optimization\",\"outputUri\":\"s-outputuri\",\"startTime\":\"s-starttime\",\"state\":\"s-state\",\"templateId\":\"s-templateid\",\"ttlAfterCompletionDays\":7}],\"nextPageToken\":\"s-nextpagetoken\",\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"jobs\":[{\"batchModePriority\":7,\"config\":{},\"createTime\":\"s-createtime\",\"endTime\":\"s-endtime\",\"error\":{\"code\":7,\"message\":\"s-message\"},\"fillContentGaps\":true,\"inputUri\":\"s-inputuri\",\"labels\":{\"k1\":\"s-labels\"},\"mode\":\"s-mode\",\"name\":\"s-name\",\"optimization\":\"s-optimization\",\"outputUri\":\"s-outputuri\",\"startTime\":\"s-starttime\",\"state\":\"s-state\",\"templateId\":\"s-templateid\",\"ttlAfterCompletionDays\":7}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL transcoder.projects.locations.jobs.list pages")
  var p = svc.projects.locations.jobs.list_pages("id1/ x", options: ProjectsLocationsJobsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_9)
}
