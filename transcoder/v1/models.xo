  /// Output only. An error object that describes the reason for the failure. This property is always present when ProcessingState is `FAILED`.
  pub error as "error,omitempty": Status? = None
  /// Optional. Insert silence and duplicate frames when timestamp gaps are detected in a given stream.
  pub fill_content_gaps as "fillContentGaps,omitempty": Bool = false
  /// Input only. Specify the `input_uri` to populate empty `uri` fields in each element of `Job.config.inputs` or `JobTemplate.config.inputs` when using template. URI of the media. Input files must be at least 5 seconds in duration and stored in Cloud Storage (for example, `gs://bucket/inputs/file.mp4`). See [Supported input and output formats](https://cloud.google.com/transcoder/docs/concepts/supported-input-and-output-formats).
  pub input_uri as "inputUri,omitempty": Str = ""
  /// The labels associated with this job. You can use these to organize and group your jobs.
  pub labels as "labels,omitempty": Map[Str, Str] = {}
  /// The processing mode of the job. The default is `PROCESSING_MODE_INTERACTIVE`.
  pub mode as "mode,omitempty": Str = ""
  /// The resource name of the job. Format: `projects/{project_number}/locations/{location}/jobs/{job}`
  pub name as "name,omitempty": Str = ""
  /// Optional. The optimization strategy of the job. The default is `AUTODETECT`.
  pub optimization as "optimization,omitempty": Str = ""
  /// Input only. Specify the `output_uri` to populate an empty `Job.config.output.uri` or `JobTemplate.config.output.uri` when using template. URI for the output file(s). For example, `gs://my-bucket/outputs/`. See [Supported input and output formats](https://cloud.google.com/transcoder/docs/concepts/supported-input-and-output-formats).
  pub output_uri as "outputUri,omitempty": Str = ""
  /// Output only. The time the transcoding started.
  pub start_time as "startTime,omitempty": Str = ""
  /// Output only. The current state of the job.
  pub state as "state,omitempty": Str = ""
  /// Input only. Specify the `template_id` to use for populating `Job.config`. The default is `preset/web-hd`, which is the only supported preset. User defined JobTemplate: `{job_template_id}`
  pub template_id as "templateId,omitempty": Str = ""
  /// Job time to live value in days, which will be effective after job completion. Job should be deleted automatically after the given TTL. Enter a value between 1 and 90. The default is 30.
  pub ttl_after_completion_days as "ttlAfterCompletionDays,omitempty": Int = 0
} derive Json

