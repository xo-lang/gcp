test "Go's securitycenter.folders.sources.findings.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"listFindingsResults\":[{\"finding\":{\"canonicalName\":\"s-canonicalname\",\"category\":\"s-category\",\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"eventTime\":\"s-eventtime\",\"externalUri\":\"s-externaluri\",\"findingClass\":\"s-findingclass\",\"moduleName\":\"s-modulename\",\"mute\":\"s-mute\",\"muteInitiator\":\"s-muteinitiator\",\"muteUpdateTime\":\"s-muteupdatetime\",\"name\":\"s-name\",\"nextSteps\":\"s-nextsteps\",\"parent\":\"s-parent\",\"parentDisplayName\":\"s-parentdisplayname\",\"resourceName\":\"s-resourcename\",\"severity\":\"s-severity\",\"sourceProperties\":{\"k\":\"v\"},\"state\":\"s-state\"},\"resource\":{\"cloudProvider\":\"s-cloudprovider\",\"displayName\":\"s-displayname\",\"location\":\"s-location\",\"name\":\"s-name\",\"organization\":\"s-organization\",\"parentDisplayName\":\"s-parentdisplayname\",\"parentName\":\"s-parentname\",\"projectDisplayName\":\"s-projectdisplayname\",\"projectName\":\"s-projectname\",\"resourcePathString\":\"s-resourcepathstring\",\"service\":\"s-service\",\"type\":\"s-type\"},\"stateChange\":\"s-statechange\"}],\"nextPageToken\":\"s-nextpagetoken\",\"readTime\":\"s-readtime\",\"totalSize\":7}")
  gv_note(f, "CALL securitycenter.folders.sources.findings.list")
  match svc.folders.sources.findings.list("id1/ x", options: FoldersSourcesFindingsListOptions{compare_duration: Some("s-compareduration"), field_mask: Some("s-fieldmask"), filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), read_time: Some("s-readtime"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_42)
}

