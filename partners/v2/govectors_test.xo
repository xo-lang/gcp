  var p = svc.analytics.list_pages(options: AnalyticsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), request_metadata_experiment_ids: ["s-requestmetadata.experimentids"], request_metadata_locale: Some("s-requestmetadata.locale"), request_metadata_partners_session_id: Some("s-requestmetadata.partnerssessionid"), request_metadata_traffic_source_traffic_source_id: Some("s-requestmetadata.trafficsource.trafficsourceid"), request_metadata_traffic_source_traffic_sub_id: Some("s-requestmetadata.trafficsource.trafficsubid"), request_metadata_user_overrides_ip_address: Some("s-requestmetadata.useroverrides.ipaddress"), request_metadata_user_overrides_user_id: Some("s-requestmetadata.useroverrides.userid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
