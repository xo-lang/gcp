  match svc.v2.update_leads(json.decode_str[Lead]("{\"adwordsCustomerId\":\"7\",\"comments\":\"s-comments\",\"createTime\":\"s-createtime\",\"email\":\"s-email\",\"familyName\":\"s-familyname\",\"givenName\":\"s-givenname\",\"gpsMotivations\":[\"s-gpsmotivations\"],\"id\":\"s-id\",\"languageCode\":\"s-languagecode\",\"marketingOptIn\":true,\"minMonthlyBudget\":{\"currencyCode\":\"s-currencycode\",\"nanos\":7,\"units\":\"7\"},\"phoneNumber\":\"s-phonenumber\",\"state\":\"s-state\",\"type\":\"s-type\",\"websiteUrl\":\"s-websiteurl\"}") ?? e => fault(e.display()), options: V2UpdateLeadsOptions{request_metadata_experiment_ids: ["s-requestmetadata.experimentids"], request_metadata_locale: Some("s-requestmetadata.locale"), request_metadata_partners_session_id: Some("s-requestmetadata.partnerssessionid"), request_metadata_traffic_source_traffic_source_id: Some("s-requestmetadata.trafficsource.trafficsourceid"), request_metadata_traffic_source_traffic_sub_id: Some("s-requestmetadata.trafficsource.trafficsubid"), request_metadata_user_overrides_ip_address: Some("s-requestmetadata.useroverrides.ipaddress"), request_metadata_user_overrides_user_id: Some("s-requestmetadata.useroverrides.userid"), update_mask: Some("s-updatemask"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_20)
}
