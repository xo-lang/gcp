  match svc.projects.export("id1/ x", json.decode_str[GoogleDatastoreAdminV1beta1ExportEntitiesRequest]("{\"entityFilter\":{\"kinds\":[\"s-kinds\"],\"namespaceIds\":[\"s-namespaceids\"]},\"labels\":{\"k1\":\"s-labels\"},\"outputUrlPrefix\":\"s-outputurlprefix\"}") ?? e => fault(e.display()), options: ProjectsExportOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
