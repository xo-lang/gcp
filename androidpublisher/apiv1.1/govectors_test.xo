// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 androidpublisher/v1.1 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://www.googleapis.com"

const GO_0: List[Str] = [
  "CALL androidpublisher.inapppurchases.get",
  "REQ GET https://www.googleapis.com/androidpublisher/v1.1/applications/id1%2F%20x/inapp/id2%2F%20x/purchases/id3%2F%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"consumptionState\":7,\"developerPayload\":\"s-developerpayload\",\"kind\":\"s-kind\",\"orderId\":\"s-orderid\",\"purchaseState\":7,\"purchaseTime\":\"7\",\"purchaseType\":7}",
  "OUT: {\"consumptionState\":7,\"developerPayload\":\"s-developerpayload\",\"kind\":\"s-kind\",\"orderId\":\"s-orderid\",\"purchaseState\":7,\"purchaseTime\":\"7\",\"purchaseType\":7}",
]

test "Go's androidpublisher.inapppurchases.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"consumptionState\":7,\"developerPayload\":\"s-developerpayload\",\"kind\":\"s-kind\",\"orderId\":\"s-orderid\",\"purchaseState\":7,\"purchaseTime\":\"7\",\"purchaseType\":7}")
  gv_note(f, "CALL androidpublisher.inapppurchases.get")
  match svc.inapppurchases.get("id1/ x", "id2/ x", "id3/ x", options: InapppurchasesGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
