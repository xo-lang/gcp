  "OUT: {\"pageInfo\":{\"resultPerPage\":7,\"startIndex\":7,\"totalResults\":7},\"tokenPagination\":{\"nextPageToken\":\"s-nextpagetoken\",\"previousPageToken\":\"s-previouspagetoken\"},\"voidedPurchases\":[{\"kind\":\"s-kind\",\"purchaseTimeMillis\":\"7\",\"purchaseToken\":\"s-purchasetoken\",\"voidedTimeMillis\":\"7\"}]}",
]

test "Go's androidpublisher.purchases.voidedpurchases.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"pageInfo\":{\"resultPerPage\":7,\"startIndex\":7,\"totalResults\":7},\"tokenPagination\":{\"nextPageToken\":\"s-nextpagetoken\",\"previousPageToken\":\"s-previouspagetoken\"},\"voidedPurchases\":[{\"kind\":\"s-kind\",\"purchaseTimeMillis\":\"7\",\"purchaseToken\":\"s-purchasetoken\",\"voidedTimeMillis\":\"7\"}]}")
  gv_note(f, "CALL androidpublisher.purchases.voidedpurchases.list")
  match svc.purchases.voidedpurchases.list("id1/ x", options: PurchasesVoidedpurchasesListOptions{end_time: Some("7"), max_results: Some(7), start_index: Some(7), start_time: Some("7"), token: Some("s-token"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
