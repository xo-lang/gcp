// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://www.googleapis.com"

const GO_0: List[Str] = [
  "CALL androidpublisher.purchases.products.get",
  "REQ GET https://www.googleapis.com/androidpublisher/v2/applications/id1%2F%20x/purchases/products/id2%2F%20x/tokens/id3%2F%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"consumptionState\":7,\"developerPayload\":\"s-developerpayload\",\"kind\":\"s-kind\",\"orderId\":\"s-orderid\",\"purchaseState\":7,\"purchaseTimeMillis\":\"7\",\"purchaseType\":7}",
  "OUT: {\"consumptionState\":7,\"developerPayload\":\"s-developerpayload\",\"kind\":\"s-kind\",\"orderId\":\"s-orderid\",\"purchaseState\":7,\"purchaseTimeMillis\":\"7\",\"purchaseType\":7}",
]

test "Go's androidpublisher.purchases.products.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"consumptionState\":7,\"developerPayload\":\"s-developerpayload\",\"kind\":\"s-kind\",\"orderId\":\"s-orderid\",\"purchaseState\":7,\"purchaseTimeMillis\":\"7\",\"purchaseType\":7}")
  gv_note(f, "CALL androidpublisher.purchases.products.get")
  match svc.purchases.products.get("id1/ x", "id2/ x", "id3/ x", options: PurchasesProductsGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

const GO_1: List[Str] = [
  "CALL androidpublisher.purchases.voidedpurchases.list",
  "REQ GET https://www.googleapis.com/androidpublisher/v2/applications/id1%2F%20x/purchases/voidedpurchases?alt=json&endTime=7&fields=kind%2Cid&maxResults=7&prettyPrint=false&startIndex=7&startTime=7&token=s-token",
