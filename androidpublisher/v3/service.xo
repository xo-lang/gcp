/// UsersListPages: the pages of UsersService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct UsersListPages[fx: Effects] {
  r: UsersService[fx]
  parent: Str
  options: UsersListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: UsersService.list's pages, from the first.
pub fn (r: UsersService[fx]) list_pages(parent: Str, options: UsersListOptions = UsersListOptions{}) -> UsersListPages[fx] {
  UsersListPages{r: r, parent: parent, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: UsersListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: UsersListPages[fx]) next_page() -> ListUsersResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.parent, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

