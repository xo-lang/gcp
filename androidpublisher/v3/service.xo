  /// Optional. Specify how the API should behave if there are changes currently in review. If this value is not set, it will default to "CANCEL_IN_REVIEW_AND_SUBMIT", which will cancel the changes in review and then send all the changes for publishing.
  pub changes_in_review_behavior: Str? = None
  /// When a rejection happens, the parameter will make sure that the changes in this edit won't be reviewed until they are explicitly sent for review from within the Google Play Console UI. These changes will be added to any other changes that are not yet sent for review.
  pub changes_not_sent_for_review: Bool? = None
  /// The fields of the result to return (Go's Fields), joined with commas.
  pub fields: List[Str] = []
  /// More request headers (Go's Header).
  pub headers: List[(Str, Str)] = []
}

/// commit: Commits an app edit.
/// (Go's androidpublisher.edits.commit.)
pub fn (r: EditsService[fx]) commit(package_name: Str, edit_id: Str, options: EditsCommitOptions = EditsCommitOptions{}) -> AppEdit ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.changes_in_review_behavior {
    q.set("changesInReviewBehavior", v)
  }
  if let Some(v) = options.changes_not_sent_for_review {
    q.set("changesNotSentForReview", "${v}")
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "androidpublisher/v3/applications/{packageName}/edits/{editId}:commit"), {"packageName": package_name, "editId": edit_id})
  let resp = r.core.client.send(gensupport.Request{method: "POST", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[AppEdit](resp)
}

