} derive Json

/// RetrySettingsFlakyTestRetryStrategy: Default retry strategy. It will retry on test failures for up to flaky_test_attempts (including the initial run). It also retries on infra issues for up to 2 attempts (including the initial run). So in total, an execution can run up to flaky_test_attempts * 2 times in the worst case.
pub struct RetrySettingsFlakyTestRetryStrategy {
  /// Required. The total attempts for flaky tests, including the initial run. Default value: 1 (no retry). Range: [1, 5].
  pub flaky_test_attempts as "flakyTestAttempts,omitempty": Int = 0
  /// Optional. Whether to retry the test failures in parallel. By default, the test is retried sequentially. If true, when the initial attempt fails, (flaky_test_attempts - 1) attempts will be triggered at the same time to run in parallel.
  pub parallel_retry as "parallelRetry,omitempty": Bool = false
  /// Optional. The mode of test reduction for retry. If the test runner doesn't support the specified test reduction mode, the request will be rejected with an `INVALID_ARGUMENT` error.
  pub test_reduction_mode as "testReductionMode,omitempty": Str = ""
} derive Json

