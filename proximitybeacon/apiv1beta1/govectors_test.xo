  gv_queue(f, "{\"beacons\":[{\"advertisedId\":{\"id\":\"YWI=\",\"type\":\"s-type\"},\"beaconName\":\"s-beaconname\",\"description\":\"s-description\",\"ephemeralIdRegistration\":{\"beaconEcdhPublicKey\":\"YWI=\",\"beaconIdentityKey\":\"YWI=\",\"initialClockValue\":\"7\",\"initialEid\":\"YWI=\",\"rotationPeriodExponent\":7,\"serviceEcdhPublicKey\":\"YWI=\"},\"expectedStability\":\"s-expectedstability\",\"indoorLevel\":{\"name\":\"s-name\"},\"latLng\":{\"latitude\":1.5,\"longitude\":1.5},\"placeId\":\"s-placeid\",\"properties\":{\"k1\":\"s-properties\"},\"provisioningKey\":\"YWI=\",\"status\":\"s-status\"}],\"totalCount\":\"7\"}")
  gv_note(f, "CALL proximitybeacon.beacons.list pages")
  var p = svc.beacons.list_pages(options: BeaconsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), project_id: Some("s-projectid"), q: Some("s-q"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_7)
}

