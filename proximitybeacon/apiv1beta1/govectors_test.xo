  "CALL proximitybeacon.beacons.diagnostics.list pages",
  "REQ GET https://proximitybeacon.googleapis.com/v1beta1/id1/%20x/diagnostics?alertFilter=s-alertfilter&alt=json&fields=kind%2Cid&pageSize=7&pageToken=s-pagetoken&prettyPrint=false&projectId=s-projectid",
