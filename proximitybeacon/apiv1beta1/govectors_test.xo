  "OUT: {\"diagnostics\":[{\"alerts\":[\"s-alerts\"],\"beaconName\":\"s-beaconname\",\"estimatedLowBatteryDate\":{\"day\":7,\"month\":7,\"year\":7}}],\"nextPageToken\":\"s-nextpagetoken\"}",
  "REQ GET https://proximitybeacon.googleapis.com/v1beta1/id1/%20x/diagnostics?alertFilter=s-alertfilter&alt=json&fields=kind%2Cid&pageSize=7&pageToken=s-nextpagetoken&prettyPrint=false&projectId=s-projectid",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"diagnostics\":[{\"alerts\":[\"s-alerts\"],\"beaconName\":\"s-beaconname\",\"estimatedLowBatteryDate\":{\"day\":7,\"month\":7,\"year\":7}}]}",
  "OUT: {\"diagnostics\":[{\"alerts\":[\"s-alerts\"],\"beaconName\":\"s-beaconname\",\"estimatedLowBatteryDate\":{\"day\":7,\"month\":7,\"year\":7}}]}",
  "OUT: ok",
]

test "Go's proximitybeacon.beacons.diagnostics.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"diagnostics\":[{\"alerts\":[\"s-alerts\"],\"beaconName\":\"s-beaconname\",\"estimatedLowBatteryDate\":{\"day\":7,\"month\":7,\"year\":7}}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"diagnostics\":[{\"alerts\":[\"s-alerts\"],\"beaconName\":\"s-beaconname\",\"estimatedLowBatteryDate\":{\"day\":7,\"month\":7,\"year\":7}}]}")
  gv_note(f, "CALL proximitybeacon.beacons.diagnostics.list pages")
  var p = svc.beacons.diagnostics.list_pages("id1/ x", options: BeaconsDiagnosticsListOptions{alert_filter: Some("s-alertfilter"), page_size: Some(7), page_token: Some("s-pagetoken"), project_id: Some("s-projectid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_15)
}

