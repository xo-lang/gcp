  gv_set(f, "{\"recaptchaEnforcementState\":[{\"enforcementState\":\"s-enforcementstate\",\"provider\":\"s-provider\"}],\"recaptchaKey\":\"s-recaptchakey\",\"useSmsBotScore\":true,\"useSmsTollFraudProtection\":true}")
  gv_note(f, "CALL identitytoolkit.getRecaptchaConfig")
  match svc.v2.get_recaptcha_config(options: V2GetRecaptchaConfigOptions{client_type: Some("s-clienttype"), tenant_id: Some("s-tenantid"), version: Some("s-version"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_57)
}
