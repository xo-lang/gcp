  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"defaultSupportedIdps\":[{\"description\":\"s-description\",\"idpId\":\"s-idpid\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"defaultSupportedIdps\":[{\"description\":\"s-description\",\"idpId\":\"s-idpid\"}]}")
  gv_note(f, "CALL identitytoolkit.defaultSupportedIdps.list pages")
  var p = svc.default_supported_idps.list_pages(options: DefaultSupportedIdpsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_7)
}

