  gv_queue(f, "{\"tenants\":[{\"allowPasswordSignup\":true,\"autodeleteAnonymousUsers\":true,\"client\":{},\"disableAuth\":true,\"displayName\":\"s-displayname\",\"emailPrivacyConfig\":{\"enableImprovedEmailPrivacy\":true},\"enableAnonymousUser\":true,\"enableEmailLinkSignin\":true,\"hashConfig\":{\"algorithm\":\"s-algorithm\",\"memoryCost\":7,\"rounds\":7,\"saltSeparator\":\"s-saltseparator\",\"signerKey\":\"s-signerkey\"},\"inheritance\":{\"emailSendingConfig\":true},\"mfaConfig\":{\"state\":\"s-state\"},\"mobileLinksConfig\":{\"domain\":\"s-domain\"},\"monitoring\":{},\"name\":\"s-name\",\"passwordPolicyConfig\":{\"forceUpgradeOnSignin\":true,\"lastUpdateTime\":\"s-lastupdatetime\",\"passwordPolicyEnforcementState\":\"s-passwordpolicyenforcementstate\"},\"recaptchaConfig\":{\"emailPasswordEnforcementState\":\"s-emailpasswordenforcementstate\",\"phoneEnforcementState\":\"s-phoneenforcementstate\",\"useAccountDefender\":true,\"useSmsBotScore\":true,\"useSmsTollFraudProtection\":true},\"smsRegionConfig\":{},\"testPhoneNumbers\":{\"k1\":\"s-testphonenumbers\"}}]}")
  gv_note(f, "CALL identitytoolkit.projects.tenants.list pages")
  var p = svc.projects.tenants.list_pages("id1/ x", options: ProjectsTenantsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_34)
}

