test "Go's identitytoolkit.projects.oauthIdpConfigs.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"oauthIdpConfigs\":[{\"clientId\":\"s-clientid\",\"clientSecret\":\"s-clientsecret\",\"displayName\":\"s-displayname\",\"enabled\":true,\"issuer\":\"s-issuer\",\"name\":\"s-name\",\"responseType\":{\"code\":true,\"idToken\":true,\"token\":true}}]}")
  gv_queue(f, "{\"oauthIdpConfigs\":[{\"clientId\":\"s-clientid\",\"clientSecret\":\"s-clientsecret\",\"displayName\":\"s-displayname\",\"enabled\":true,\"issuer\":\"s-issuer\",\"name\":\"s-name\",\"responseType\":{\"code\":true,\"idToken\":true,\"token\":true}}]}")
  gv_note(f, "CALL identitytoolkit.projects.oauthIdpConfigs.list pages")
  var p = svc.projects.oauth_idp_configs.list_pages("id1/ x", options: ProjectsOauthIdpConfigsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_27)
}

