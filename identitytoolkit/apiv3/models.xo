  /// The first name of the user.
  pub first_name as "firstName,omitempty": Str = ""
  /// The full name of the user.
  pub full_name as "fullName,omitempty": Str = ""
  /// The ID token.
  pub id_token as "idToken,omitempty": Str = ""
  /// It's the identifier param in the createAuthUri request if the identifier is an email. It can be used to check whether the user input email is different from the asserted email.
  pub input_email as "inputEmail,omitempty": Str = ""
  /// True if it's a new user sign-in, false if it's a returning user.
  pub is_new_user as "isNewUser,omitempty": Bool = false
  /// The fixed string "identitytoolkit#VerifyAssertionResponse".
  pub kind as "kind,omitempty": Str = ""
  /// The language preference of the user.
  pub language as "language,omitempty": Str = ""
  /// The last name of the user.
  pub last_name as "lastName,omitempty": Str = ""
  /// The RP local ID if it's already been mapped to the IdP account identified by the federated ID.
