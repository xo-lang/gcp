test "Go's identitytoolkit.getProjects" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"allowPasswordUser\":true,\"apiKey\":\"s-apikey\",\"authorizedDomains\":[\"s-authorizeddomains\"],\"changeEmailTemplate\":{\"body\":\"s-body\",\"customized\":true,\"disabled\":true,\"format\":\"s-format\",\"from\":\"s-from\",\"fromDisplayName\":\"s-fromdisplayname\",\"fromLocalPart\":\"s-fromlocalpart\",\"locale\":\"s-locale\",\"replyTo\":\"s-replyto\",\"subject\":\"s-subject\"},\"dynamicLinksDomain\":\"s-dynamiclinksdomain\",\"enableAnonymousUser\":true,\"idpConfig\":[{\"clientId\":\"s-clientid\",\"enabled\":true,\"experimentPercent\":7,\"provider\":\"s-provider\",\"secret\":\"s-secret\",\"whitelistedAudiences\":[\"s-whitelistedaudiences\"]}],\"legacyResetPasswordTemplate\":{\"body\":\"s-body\",\"customized\":true,\"disabled\":true,\"format\":\"s-format\",\"from\":\"s-from\",\"fromDisplayName\":\"s-fromdisplayname\",\"fromLocalPart\":\"s-fromlocalpart\",\"locale\":\"s-locale\",\"replyTo\":\"s-replyto\",\"subject\":\"s-subject\"},\"projectId\":\"s-projectid\",\"resetPasswordTemplate\":{\"body\":\"s-body\",\"customized\":true,\"disabled\":true,\"format\":\"s-format\",\"from\":\"s-from\",\"fromDisplayName\":\"s-fromdisplayname\",\"fromLocalPart\":\"s-fromlocalpart\",\"locale\":\"s-locale\",\"replyTo\":\"s-replyto\",\"subject\":\"s-subject\"},\"revertSecondFactorAdditionTemplate\":{\"body\":\"s-body\",\"customized\":true,\"disabled\":true,\"format\":\"s-format\",\"from\":\"s-from\",\"fromDisplayName\":\"s-fromdisplayname\",\"fromLocalPart\":\"s-fromlocalpart\",\"locale\":\"s-locale\",\"replyTo\":\"s-replyto\",\"subject\":\"s-subject\"},\"useEmailSending\":true,\"verifyEmailTemplate\":{\"body\":\"s-body\",\"customized\":true,\"disabled\":true,\"format\":\"s-format\",\"from\":\"s-from\",\"fromDisplayName\":\"s-fromdisplayname\",\"fromLocalPart\":\"s-fromlocalpart\",\"locale\":\"s-locale\",\"replyTo\":\"s-replyto\",\"subject\":\"s-subject\"}}")
  gv_note(f, "CALL identitytoolkit.getProjects")
  match svc.v1.get_projects(options: V1GetProjectsOptions{android_package_name: Some("s-androidpackagename"), client_id: Some("s-clientid"), delegated_project_number: Some("7"), firebase_app_id: Some("s-firebaseappid"), ios_bundle_id: Some("s-iosbundleid"), project_number: Some("7"), return_dynamic_link: Some(true), sha1_cert: Some("s-sha1cert"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_37)
}

