  pub product_fixes as "productFixes,omitempty": List[ProductFix] = []
  /// Optional. List of public exploits.
  pub public_exploits as "publicExploits,omitempty": List[PublicExploit] = []
  /// Output only. Whether a publicly available exploit exists.
  pub publicly_available_exploit as "publiclyAvailableExploit,omitempty": Bool = false
  /// Required. The risk rating of the vulnerability.
  pub risk_rating as "riskRating,omitempty": Str = ""
  /// Required. All technologies affected by the vulnerability, using the vendor and product names of its affected products, optionally followed by a version. Ex: `Apache Struts 2.2.3`.
  pub technologies as "technologies,omitempty": List[Str] = []
} derive Json
