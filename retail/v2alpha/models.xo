/// GoogleCloudRetailV2alphaCompletionConfig: Catalog level autocomplete config for customers to customize autocomplete feature's settings.
pub struct GoogleCloudRetailV2alphaCompletionConfig {
  /// Output only. The source data for the latest import of the autocomplete allowlist phrases.
  pub allowlist_input_config as "allowlistInputConfig,omitempty": GoogleCloudRetailV2alphaCompletionDataInputConfig? = None
