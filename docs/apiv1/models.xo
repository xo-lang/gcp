/// Response: A single response from an update.
pub struct Response {
  /// The result of adding a reply to a comment or suggestion.
  pub add_comment_reply as "addCommentReply,omitempty": AddCommentReplyResponse? = None
  /// The result of adding a document tab.
  pub add_document_tab as "addDocumentTab,omitempty": AddDocumentTabResponse? = None
  /// The result of creating a dropdown definition.
  pub create_dropdown_definition as "createDropdownDefinition,omitempty": CreateDropdownDefinitionResponse? = None
  /// The result of creating a footer.
  pub create_footer as "createFooter,omitempty": CreateFooterResponse? = None
  /// The result of creating a footnote.
  pub create_footnote as "createFootnote,omitempty": CreateFootnoteResponse? = None
  /// The result of creating a header.
  pub create_header as "createHeader,omitempty": CreateHeaderResponse? = None
  /// The result of creating a named range.
  pub create_named_range as "createNamedRange,omitempty": CreateNamedRangeResponse? = None
  /// The result of inserting a comment.
  pub insert_comment as "insertComment,omitempty": InsertCommentResponse? = None
  /// The result of inserting a dropdown.
  pub insert_dropdown as "insertDropdown,omitempty": InsertDropdownResponse? = None
  /// The result of inserting an inline image.
  pub insert_inline_image as "insertInlineImage,omitempty": InsertInlineImageResponse? = None
  /// The result of inserting an inline Google Sheets chart.
  pub insert_inline_sheets_chart as "insertInlineSheetsChart,omitempty": InsertInlineSheetsChartResponse? = None
  /// The result of replacing text.
  pub replace_all_text as "replaceAllText,omitempty": ReplaceAllTextResponse? = None
} derive Json

/// RgbColor: An RGB color.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct RgbColor {
  /// The blue component of the color, from 0.0 to 1.0.
  pub blue as "blue,omitempty": Float = 0.0
  /// The green component of the color, from 0.0 to 1.0.
  pub green as "green,omitempty": Float = 0.0
  /// The red component of the color, from 0.0 to 1.0.
  pub red as "red,omitempty": Float = 0.0
  pub force_send_fields as "-": List[RgbColorField] = []
  pub null_fields as "-": List[RgbColorField] = []
} derive Json

/// RgbColorField: RgbColor's fields, for force_send_fields and null_fields.
pub enum RgbColorField {
  Blue
  Green
  Red
}

fn rgb_color_field_entry(f: RgbColorField) -> Str {
  match f {
    Blue => "blue=0"
    Green => "green=0"
    Red => "red=0"
  }
}

/// body_marked: whether m, or a model in it, sets force_send_fields or
/// null_fields (decision 0013; the service's request bodies ask).
pub fn (m: RgbColor) body_marked() -> Bool {
  if m.force_send_fields.len() > 0 || m.null_fields.len() > 0 {
    return true
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: RgbColor) body_mark(v: json.Value) -> json.Value {
  var o = v
  gensupport.mark(o, m.force_send_fields.map(rgb_color_field_entry), m.null_fields.map(rgb_color_field_entry))
}

/// RichLink: A link to a Google resource (such as a file in Drive, a YouTube video, or a Calendar event).
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct RichLink {
  /// Output only. The ID of this link.
  pub rich_link_id as "richLinkId,omitempty": Str = ""
  /// Output only. The properties of this RichLink. This field is always present.
  pub rich_link_properties as "richLinkProperties,omitempty": RichLinkProperties? = None
