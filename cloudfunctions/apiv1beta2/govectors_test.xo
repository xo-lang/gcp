test "Go's cloudfunctions.projects.locations.functions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"functions\":[{\"availableMemoryMb\":7,\"entryPoint\":\"s-entrypoint\",\"environmentVariables\":{\"k1\":\"s-environmentvariables\"},\"eventTrigger\":{\"eventType\":\"s-eventtype\",\"resource\":\"s-resource\",\"service\":\"s-service\"},\"httpsTrigger\":{\"url\":\"s-url\"},\"labels\":{\"k1\":\"s-labels\"},\"latestOperation\":\"s-latestoperation\",\"maxInstances\":7,\"name\":\"s-name\",\"network\":\"s-network\",\"runtime\":\"s-runtime\",\"serviceAccount\":\"s-serviceaccount\",\"sourceArchiveUrl\":\"s-sourcearchiveurl\",\"sourceRepository\":{\"branch\":\"s-branch\",\"deployedRevision\":\"s-deployedrevision\",\"repositoryUrl\":\"s-repositoryurl\",\"revision\":\"s-revision\",\"sourcePath\":\"s-sourcepath\",\"tag\":\"s-tag\"},\"sourceRepositoryUrl\":\"s-sourcerepositoryurl\",\"sourceUploadUrl\":\"s-sourceuploadurl\",\"status\":\"s-status\",\"timeout\":\"s-timeout\",\"updateTime\":\"s-updatetime\",\"versionId\":\"7\",\"vpcConnector\":\"s-vpcconnector\"}],\"nextPageToken\":\"s-nextpagetoken\",\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"functions\":[{\"availableMemoryMb\":7,\"entryPoint\":\"s-entrypoint\",\"environmentVariables\":{\"k1\":\"s-environmentvariables\"},\"eventTrigger\":{\"eventType\":\"s-eventtype\",\"resource\":\"s-resource\",\"service\":\"s-service\"},\"httpsTrigger\":{\"url\":\"s-url\"},\"labels\":{\"k1\":\"s-labels\"},\"latestOperation\":\"s-latestoperation\",\"maxInstances\":7,\"name\":\"s-name\",\"network\":\"s-network\",\"runtime\":\"s-runtime\",\"serviceAccount\":\"s-serviceaccount\",\"sourceArchiveUrl\":\"s-sourcearchiveurl\",\"sourceRepository\":{\"branch\":\"s-branch\",\"deployedRevision\":\"s-deployedrevision\",\"repositoryUrl\":\"s-repositoryurl\",\"revision\":\"s-revision\",\"sourcePath\":\"s-sourcepath\",\"tag\":\"s-tag\"},\"sourceRepositoryUrl\":\"s-sourcerepositoryurl\",\"sourceUploadUrl\":\"s-sourceuploadurl\",\"status\":\"s-status\",\"timeout\":\"s-timeout\",\"updateTime\":\"s-updatetime\",\"versionId\":\"7\",\"vpcConnector\":\"s-vpcconnector\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL cloudfunctions.projects.locations.functions.list pages")
  var p = svc.projects.locations.functions.list_pages("id1/ x", options: ProjectsLocationsFunctionsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_12)
}

