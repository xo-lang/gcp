/// list: List all host URL channels in the host AdSense account.
/// (Go's adsensehost.urlchannels.list.)
pub fn (r: UrlchannelsService[fx]) list(ad_client_id: Str, options: UrlchannelsListOptions = UrlchannelsListOptions{}) -> UrlChannels ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.max_results {
    q.set("maxResults", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "adclients/{adClientId}/urlchannels"), {"adClientId": ad_client_id})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[UrlChannels](resp)
}

/// UrlchannelsListPages: the pages of UrlchannelsService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct UrlchannelsListPages[fx: Effects] {
  r: UrlchannelsService[fx]
  ad_client_id: Str
  options: UrlchannelsListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: UrlchannelsService.list's pages, from the first.
pub fn (r: UrlchannelsService[fx]) list_pages(ad_client_id: Str, options: UrlchannelsListOptions = UrlchannelsListOptions{}) -> UrlchannelsListPages[fx] {
  UrlchannelsListPages{r: r, ad_client_id: ad_client_id, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: UrlchannelsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: UrlchannelsListPages[fx]) next_page() -> UrlChannels ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.ad_client_id, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
  new_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
