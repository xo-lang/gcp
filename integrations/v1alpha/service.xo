  let resp = r.core.client.send(gensupport.Request{method: "PATCH", url: u, query: q, headers: hs, body: gensupport.json_body(googlecloudintegrationsv1alphasfdcchannel, data_wrapper: false)})?
  gensupport.check(resp)?
