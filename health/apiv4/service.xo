  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: UsersDataTypesDataPointsDailyRollUpPages[fx]) next_page() -> DailyRollUpDataPointsResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let b = if p.started { p.dailyrollupdatapointsrequest with {page_token: p.next_token} } else { p.dailyrollupdatapointsrequest }
  let v = p.r.daily_roll_up(p.parent, b, p.options)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

