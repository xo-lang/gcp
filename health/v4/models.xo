  /// Optional. The serving information for the logged food.
  pub serving as "serving,omitempty": Serving? = None
  /// Optional. The total carbohydrate content, measured in grams.
  pub total_carbohydrate as "totalCarbohydrate,omitempty": WeightQuantity? = None
  /// Optional. The total fat content, measured in grams.
  pub total_fat as "totalFat,omitempty": WeightQuantity? = None
} derive Json

