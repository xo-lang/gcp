}

/// X509: An X.509-type identity provider represents a CA. It is trusted to assert a client identity if the client has a certificate that chains up to this CA.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct X509 {
  /// Required. A TrustStore. Use this trust store as a wrapper to config the trust anchor and optional intermediate cas to help build the trust chain for the incoming end entity certificate. Follow the X.509 guidelines to define those PEM encoded certs. Only one trust store is currently supported.
  pub trust_store as "trustStore,omitempty": TrustStore? = None
  pub force_send_fields as "-": List[X509Field] = []
  pub null_fields as "-": List[X509Field] = []
} derive Json

/// X509Field: X509's fields, for force_send_fields and null_fields.
pub enum X509Field {
  TrustStore
}

fn x509_field_entry(f: X509Field) -> Str {
  match f {
    TrustStore => "trustStore"
  }
}

/// body_marked: whether m, or a model in it, sets force_send_fields or
/// null_fields (decision 0013; the service's request bodies ask).
pub fn (m: X509) body_marked() -> Bool {
  if m.force_send_fields.len() > 0 || m.null_fields.len() > 0 {
    return true
  }
  if let Some(c) = m.trust_store {
    if c.body_marked() {
      return true
    }
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: X509) body_mark(v: json.Value) -> json.Value {
  var o = v
  if let Some(c) = m.trust_store {
    o = gensupport.mark_field(o, "trustStore", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  gensupport.mark(o, m.force_send_fields.map(x509_field_entry), m.null_fields.map(x509_field_entry))
}
