test "Go's cloudtrace.projects.traces.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"traces\":[{\"projectId\":\"s-projectid\",\"traceId\":\"s-traceid\"}]}")
  gv_queue(f, "{\"traces\":[{\"projectId\":\"s-projectid\",\"traceId\":\"s-traceid\"}]}")
  gv_note(f, "CALL cloudtrace.projects.traces.list pages")
  var p = svc.projects.traces.list_pages("id1/ x", options: ProjectsTracesListOptions{end_time: Some("s-endtime"), filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), start_time: Some("s-starttime"), view: Some("s-view"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_3)
}
