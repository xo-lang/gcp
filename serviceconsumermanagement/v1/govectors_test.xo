const GO_13: List[Str] = [
  "CALL serviceconsumermanagement.services.tenancyUnits.undeleteProject",
  "REQ POST https://serviceconsumermanagement.googleapis.com/v1/id1/%20x:undeleteProject?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"tag\":\"s-tag\"}",
  "",
  "  SERVED 200 {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}",
  "OUT: {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}",
]

test "Go's serviceconsumermanagement.services.tenancyUnits.undeleteProject" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"metadata\":{\"k\":\"v\"},\"name\":\"s-name\",\"response\":{\"k\":\"v\"}}")
  gv_note(f, "CALL serviceconsumermanagement.services.tenancyUnits.undeleteProject")
  match svc.services.tenancy_units.undelete_project("id1/ x", json.decode_str[UndeleteTenantProjectRequest]("{\"tag\":\"s-tag\"}") ?? e => fault(e.display()), options: ServicesTenancyUnitsUndeleteProjectOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
