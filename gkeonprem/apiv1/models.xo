  /// The IP Blocks to be used by the Seesaw load balancer
  pub ip_blocks as "ipBlocks,omitempty": List[VmwareIpBlock] = []
  /// MasterIP is the IP announced by the master of Seesaw group.
  pub master_ip as "masterIp,omitempty": Str = ""
  /// Name to be used by Stackdriver.
  pub stackdriver_name as "stackdriverName,omitempty": Str = ""
  /// Names of the VMs created for this Seesaw group.
  pub vms as "vms,omitempty": List[Str] = []
} derive Json

