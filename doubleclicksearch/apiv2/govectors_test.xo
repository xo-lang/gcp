test "Go's doubleclicksearch.savedColumns.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"kind\":\"s-kind\",\"savedColumnName\":\"s-savedcolumnname\",\"type\":\"s-type\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL doubleclicksearch.savedColumns.list")
  match svc.saved_columns.list(7, 7, options: SavedColumnsListOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_12)
}
