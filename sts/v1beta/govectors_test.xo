// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 sts/v1beta with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://sts.googleapis.com"

const GO_0: List[Str] = [
  "CALL sts.token",
  "REQ POST https://sts.googleapis.com/v1beta/token?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"audience\":\"s-audience\",\"grantType\":\"s-granttype\",\"options\":\"s-options\",\"requestedTokenType\":\"s-requestedtokentype\",\"scope\":\"s-scope\",\"subjectToken\":\"s-subjecttoken\",\"subjectTokenType\":\"s-subjecttokentype\"}",
  "",
  "  SERVED 200 {\"access_token\":\"s-access_token\",\"expires_in\":7,\"issued_token_type\":\"s-issued_token_type\",\"token_type\":\"s-token_type\"}",
  "OUT: {\"access_token\":\"s-access_token\",\"expires_in\":7,\"issued_token_type\":\"s-issued_token_type\",\"token_type\":\"s-token_type\"}",
]

test "Go's sts.token" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"access_token\":\"s-access_token\",\"expires_in\":7,\"issued_token_type\":\"s-issued_token_type\",\"token_type\":\"s-token_type\"}")
  gv_note(f, "CALL sts.token")
  match svc.v1beta.token(json.decode_str[GoogleIdentityStsV1betaExchangeTokenRequest]("{\"audience\":\"s-audience\",\"grantType\":\"s-granttype\",\"options\":\"s-options\",\"requestedTokenType\":\"s-requestedtokentype\",\"scope\":\"s-scope\",\"subjectToken\":\"s-subjecttoken\",\"subjectTokenType\":\"s-subjecttokentype\"}") ?? e => fault(e.display()), options: V1betaTokenOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
