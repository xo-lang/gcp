  match svc.v1.token(json.decode_str[GoogleIdentityStsV1ExchangeTokenRequest]("{\"actorToken\":\"s-actortoken\",\"actorTokenType\":\"s-actortokentype\",\"audience\":\"s-audience\",\"grantType\":\"s-granttype\",\"options\":\"s-options\",\"requestedTokenType\":\"s-requestedtokentype\",\"scope\":\"s-scope\",\"subjectToken\":\"s-subjecttoken\",\"subjectTokenType\":\"s-subjecttokentype\"}") ?? e => fault(e.display()), options: V1TokenOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
