  "REQ GET https://speech.googleapis.com/v1p1beta1/id1/%20x/phraseSets?alt=json&fields=kind%2Cid&pageSize=7&pageToken=s-pagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"nextPageToken\":\"s-nextpagetoken\",\"phraseSets\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"boost\":1.5,\"deleteTime\":\"s-deletetime\",\"displayName\":\"s-displayname\",\"etag\":\"s-etag\",\"expireTime\":\"s-expiretime\",\"kmsKeyName\":\"s-kmskeyname\",\"kmsKeyVersionName\":\"s-kmskeyversionname\",\"name\":\"s-name\",\"reconciling\":true,\"state\":\"s-state\",\"uid\":\"s-uid\"}]}",
  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"phraseSets\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"boost\":1.5,\"deleteTime\":\"s-deletetime\",\"displayName\":\"s-displayname\",\"etag\":\"s-etag\",\"expireTime\":\"s-expiretime\",\"kmsKeyName\":\"s-kmskeyname\",\"kmsKeyVersionName\":\"s-kmskeyversionname\",\"name\":\"s-name\",\"reconciling\":true,\"state\":\"s-state\",\"uid\":\"s-uid\"}]}",
]

test "Go's speech.projects.locations.phraseSets.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"phraseSets\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"boost\":1.5,\"deleteTime\":\"s-deletetime\",\"displayName\":\"s-displayname\",\"etag\":\"s-etag\",\"expireTime\":\"s-expiretime\",\"kmsKeyName\":\"s-kmskeyname\",\"kmsKeyVersionName\":\"s-kmskeyversionname\",\"name\":\"s-name\",\"reconciling\":true,\"state\":\"s-state\",\"uid\":\"s-uid\"}]}")
  gv_note(f, "CALL speech.projects.locations.phraseSets.list")
  match svc.projects.locations.phrase_sets.list("id1/ x", options: ProjectsLocationsPhraseSetsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_10)
}

