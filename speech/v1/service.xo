pub fn (r: ProjectsLocationsPhraseSetsService[fx]) patch(name: Str, phraseset: PhraseSet, options: ProjectsLocationsPhraseSetsPatchOptions = ProjectsLocationsPhraseSetsPatchOptions{}) -> PhraseSet ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.update_mask {
    q.set("updateMask", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs.push(("Content-Type", "application/json"))
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v1/{+name}"), {"name": name})
  let resp = r.core.client.send(gensupport.Request{method: "PATCH", url: u, query: q, headers: hs, body: gensupport.json_body(phraseset, data_wrapper: false)})?
  gensupport.check(resp)?
  gensupport.decode[PhraseSet](resp)
}

