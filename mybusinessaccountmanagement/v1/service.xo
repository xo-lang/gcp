pub fn (r: LocationsAdminsService[fx]) list(parent: Str, options: LocationsAdminsListOptions = LocationsAdminsListOptions{}) -> ListLocationAdminsResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v1/{+parent}/admins"), {"parent": parent})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[ListLocationAdminsResponse](resp)
}

/// LocationsAdminsPatchOptions: the optional parameters of LocationsAdminsService.patch.
pub struct LocationsAdminsPatchOptions {
  /// Required. The specific fields that should be updated. The only editable field is role.
  pub update_mask: Str? = None
  /// The fields of the result to return (Go's Fields), joined with commas.
  pub fields: List[Str] = []
  /// More request headers (Go's Header).
  pub headers: List[(Str, Str)] = []
}

/// patch: Updates the Admin for the specified location. Only the AdminRole of the Admin can be updated.
/// (Go's mybusinessaccountmanagement.locations.admins.patch.)
pub fn (r: LocationsAdminsService[fx]) patch(name: Str, admin: Admin, options: LocationsAdminsPatchOptions = LocationsAdminsPatchOptions{}) -> Admin ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.update_mask {
    q.set("updateMask", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs.push(("Content-Type", "application/json"))
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v1/{+name}"), {"name": name})
  let resp = r.core.client.send(gensupport.Request{method: "PATCH", url: u, query: q, headers: hs, body: gensupport.json_body(admin, data_wrapper: false)})?
  gensupport.check(resp)?
  gensupport.decode[Admin](resp)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
  new_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
