/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct WorkdayProfile {
  /// Required. Host for the Workday connection. Must be a valid hostname (e.g., `wd3-impl-services1.workday.com`).
  pub host as "host,omitempty": Str = ""
  /// Required. Credentials for authenticating with the Workday API. OAuth Refresh Token credentials for authenticating with the Workday API.
  pub oauth_refresh_token_credentials as "oauthRefreshTokenCredentials,omitempty": OauthRefreshTokenCredentials? = None
  /// Required. Tenant for the Workday connection (e.g., `google12`).
  pub tenant as "tenant,omitempty": Str = ""
  pub force_send_fields as "~forceSendFields,omitempty": List[WorkdayProfileField] = []
  pub null_fields as "~nullFields,omitempty": List[WorkdayProfileField] = []
} derive Json

/// WorkdayProfileField: WorkdayProfile's fields, for force_send_fields and null_fields.
pub enum WorkdayProfileField {
  Host as "host=\"\""
  OauthRefreshTokenCredentials as "oauthRefreshTokenCredentials"
  Tenant as "tenant=\"\""
} derive Json

/// WorkdaySourceConfig: Configuration for syncing data from a Workday source.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct WorkdaySourceConfig {
  /// Optional. The objects to exclude from the stream.
  pub exclude_objects as "excludeObjects,omitempty": SourceCatalog? = None
  /// Optional. The objects to retrieve from the source.
  pub include_objects as "includeObjects,omitempty": SourceCatalog? = None
  /// Required. Incremental sync polling interval for all objects. If not set, a default value of `5 minutes` is used. The duration must be from `5 minutes` to `24 hours`, inclusive.
  pub polling_interval as "pollingInterval,omitempty": Str = ""
  pub force_send_fields as "~forceSendFields,omitempty": List[WorkdaySourceConfigField] = []
  pub null_fields as "~nullFields,omitempty": List[WorkdaySourceConfigField] = []
} derive Json

/// WorkdaySourceConfigField: WorkdaySourceConfig's fields, for force_send_fields and null_fields.
pub enum WorkdaySourceConfigField {
  ExcludeObjects as "excludeObjects"
  IncludeObjects as "includeObjects"
  PollingInterval as "pollingInterval=\"\""
} derive Json
