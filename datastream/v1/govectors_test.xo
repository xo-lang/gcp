  match svc.projects.locations.streams.objects.stop_backfill_job("id1/ x", json.decode_str[StopBackfillJobRequest]("{}") ?? e => fault(e.display()), options: ProjectsLocationsStreamsObjectsStopBackfillJobOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
