  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"runtimeVersions\":[{\"name\":\"s-name\",\"version\":\"s-version\"}],\"unreachable\":[\"s-unreachable\"]}",
]

test "Go's tpu.projects.locations.runtimeVersions.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"runtimeVersions\":[{\"name\":\"s-name\",\"version\":\"s-version\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL tpu.projects.locations.runtimeVersions.list")
  match svc.projects.locations.runtime_versions.list("id1/ x", options: ProjectsLocationsRuntimeVersionsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_28)
}
