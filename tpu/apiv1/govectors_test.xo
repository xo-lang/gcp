  "  SERVED 200 {\"nextPageToken\":\"s-nextpagetoken\",\"tensorflowVersions\":[{\"name\":\"s-name\",\"version\":\"s-version\"}],\"unreachable\":[\"s-unreachable\"]}",
  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"tensorflowVersions\":[{\"name\":\"s-name\",\"version\":\"s-version\"}],\"unreachable\":[\"s-unreachable\"]}",
  "REQ GET https://tpu.googleapis.com/v1/id1/%20x/tensorflowVersions?alt=json&fields=kind%2Cid&filter=s-filter&orderBy=s-orderby&pageSize=7&pageToken=s-nextpagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"tensorflowVersions\":[{\"name\":\"s-name\",\"version\":\"s-version\"}],\"unreachable\":[\"s-unreachable\"]}",
  "OUT: {\"tensorflowVersions\":[{\"name\":\"s-name\",\"version\":\"s-version\"}],\"unreachable\":[\"s-unreachable\"]}",
  "OUT: ok",
]

test "Go's tpu.projects.locations.tensorflowVersions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"tensorflowVersions\":[{\"name\":\"s-name\",\"version\":\"s-version\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"tensorflowVersions\":[{\"name\":\"s-name\",\"version\":\"s-version\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL tpu.projects.locations.tensorflowVersions.list pages")
  var p = svc.projects.locations.tensorflow_versions.list_pages("id1/ x", options: ProjectsLocationsTensorflowVersionsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_21)
}
