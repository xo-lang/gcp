  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"permissions\":[\"s-permissions\"]}")
  gv_note(f, "CALL beyondcorp.projects.locations.securityGateways.applications.testIamPermissions")
  match svc.projects.locations.security_gateways.applications.test_iam_permissions("id1/ x", json.decode_str[GoogleIamV1TestIamPermissionsRequest]("{\"permissions\":[\"s-permissions\"]}") ?? e => fault(e.display()), options: ProjectsLocationsSecurityGatewaysApplicationsTestIamPermissionsOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_92)
}
