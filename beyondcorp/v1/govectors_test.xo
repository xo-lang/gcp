test "Go's beyondcorp.projects.locations.appConnectors.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"appConnectors\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"principalInfo\":{},\"resourceInfo\":{\"id\":\"s-id\",\"resource\":{\"k\":\"v\"},\"status\":\"s-status\",\"time\":\"s-time\"},\"state\":\"s-state\",\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\",\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"appConnectors\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"principalInfo\":{},\"resourceInfo\":{\"id\":\"s-id\",\"resource\":{\"k\":\"v\"},\"status\":\"s-status\",\"time\":\"s-time\"},\"state\":\"s-state\",\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL beyondcorp.projects.locations.appConnectors.list pages")
  var p = svc.projects.locations.app_connectors.list_pages("id1/ x", options: ProjectsLocationsAppConnectorsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_21)
}

