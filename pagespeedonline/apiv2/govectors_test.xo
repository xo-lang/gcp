  "OUT: {\"captchaResult\":\"s-captcharesult\",\"formattedResults\":{\"locale\":\"s-locale\",\"ruleResults\":{\"k1\":{\"groups\":[\"s-groups\"],\"localizedRuleName\":\"s-localizedrulename\",\"ruleImpact\":1.5,\"summary\":{\"format\":\"s-format\"},\"urlBlocks\":[{}]}}},\"id\":\"s-id\",\"invalidRules\":[\"s-invalidrules\"],\"kind\":\"s-kind\",\"pageStats\":{\"cssResponseBytes\":\"7\",\"flashResponseBytes\":\"7\",\"htmlResponseBytes\":\"7\",\"imageResponseBytes\":\"7\",\"javascriptResponseBytes\":\"7\",\"numberCssResources\":7,\"numberHosts\":7,\"numberJsResources\":7,\"numberResources\":7,\"numberStaticResources\":7,\"otherResponseBytes\":\"7\",\"textResponseBytes\":\"7\",\"totalRequestBytes\":\"7\"},\"responseCode\":7,\"ruleGroups\":{\"k1\":{\"score\":7}},\"screenshot\":{\"data\":\"YWI=\",\"height\":7,\"key\":\"s-key\",\"mime_type\":\"s-mime_type\",\"page_rect\":{\"height\":7,\"left\":7,\"top\":7,\"width\":7},\"width\":7},\"title\":\"s-title\",\"version\":{\"major\":7,\"minor\":7}}",
]

test "Go's pagespeedonline.pagespeedapi.runpagespeed" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"captchaResult\":\"s-captcharesult\",\"formattedResults\":{\"locale\":\"s-locale\",\"ruleResults\":{\"k1\":{\"groups\":[\"s-groups\"],\"localizedRuleName\":\"s-localizedrulename\",\"ruleImpact\":1.5,\"summary\":{\"format\":\"s-format\"},\"urlBlocks\":[{}]}}},\"id\":\"s-id\",\"invalidRules\":[\"s-invalidrules\"],\"kind\":\"s-kind\",\"pageStats\":{\"cssResponseBytes\":\"7\",\"flashResponseBytes\":\"7\",\"htmlResponseBytes\":\"7\",\"imageResponseBytes\":\"7\",\"javascriptResponseBytes\":\"7\",\"numberCssResources\":7,\"numberHosts\":7,\"numberJsResources\":7,\"numberResources\":7,\"numberStaticResources\":7,\"otherResponseBytes\":\"7\",\"textResponseBytes\":\"7\",\"totalRequestBytes\":\"7\"},\"responseCode\":7,\"ruleGroups\":{\"k1\":{\"score\":7}},\"screenshot\":{\"data\":\"YWI=\",\"height\":7,\"key\":\"s-key\",\"mime_type\":\"s-mime_type\",\"page_rect\":{\"height\":7,\"left\":7,\"top\":7,\"width\":7},\"width\":7},\"title\":\"s-title\",\"version\":{\"major\":7,\"minor\":7}}")
