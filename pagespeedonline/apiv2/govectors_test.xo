  match svc.pagespeedapi.runpagespeed("s-url", options: PagespeedapiRunpagespeedOptions{filter_third_party_resources: Some(true), locale: Some("s-locale"), rule: ["s-rule"], screenshot: Some(true), strategy: Some("s-strategy"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
