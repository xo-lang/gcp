  "OUT: {\"analysisUTCTimestamp\":\"s-analysisutctimestamp\",\"captchaResult\":\"s-captcharesult\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"lighthouseResult\":{\"audits\":{\"k1\":{\"description\":\"s-description\",\"details\":{\"k\":\"v\"},\"displayValue\":\"s-displayvalue\",\"errorMessage\":\"s-errormessage\",\"explanation\":\"s-explanation\",\"id\":\"s-id\",\"numericUnit\":\"s-numericunit\",\"numericValue\":1.5,\"score\":{\"k\":\"v\"},\"scoreDisplayMode\":\"s-scoredisplaymode\",\"title\":\"s-title\",\"warnings\":{\"k\":\"v\"}}},\"categories\":{},\"categoryGroups\":{\"k1\":{\"description\":\"s-description\",\"title\":\"s-title\"}},\"configSettings\":{\"channel\":\"s-channel\",\"emulatedFormFactor\":\"s-emulatedformfactor\",\"formFactor\":\"s-formfactor\",\"locale\":\"s-locale\",\"onlyCategories\":{\"k\":\"v\"}},\"entities\":[{\"category\":\"s-category\",\"homepage\":\"s-homepage\",\"isFirstParty\":true,\"isUnrecognized\":true,\"name\":\"s-name\"}],\"environment\":{\"benchmarkIndex\":1.5,\"credits\":{\"k1\":\"s-credits\"},\"hostUserAgent\":\"s-hostuseragent\",\"networkUserAgent\":\"s-networkuseragent\"},\"fetchTime\":\"s-fetchtime\",\"finalDisplayedUrl\":\"s-finaldisplayedurl\",\"finalUrl\":\"s-finalurl\",\"fullPageScreenshot\":{\"k\":\"v\"},\"i18n\":{},\"lighthouseVersion\":\"s-lighthouseversion\",\"mainDocumentUrl\":\"s-maindocumenturl\",\"requestedUrl\":\"s-requestedurl\",\"runWarnings\":[{\"k\":\"v\"}],\"runtimeError\":{\"code\":\"s-code\",\"message\":\"s-message\"},\"stackPacks\":[{\"iconDataURL\":\"s-icondataurl\",\"id\":\"s-id\",\"title\":\"s-title\"}],\"timing\":{\"total\":1.5},\"userAgent\":\"s-useragent\"},\"loadingExperience\":{\"id\":\"s-id\",\"initial_url\":\"s-initial_url\",\"metrics\":{\"k1\":{\"category\":\"s-category\",\"formFactor\":\"s-formfactor\",\"median\":7,\"metricId\":\"s-metricid\",\"percentile\":7}},\"origin_fallback\":true,\"overall_category\":\"s-overall_category\"},\"originLoadingExperience\":{\"id\":\"s-id\",\"initial_url\":\"s-initial_ur