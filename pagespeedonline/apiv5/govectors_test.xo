const GV_HOST: Str = "https://pagespeedonline.googleapis.com"

const GO_0: List[Str] = [
  "CALL pagespeedonline.pagespeedapi.runpagespeed",
  "REQ GET https://pagespeedonline.googleapis.com/pagespeedonline/v5/runPagespeed?alt=json&captchaToken=s-captchatoken&category=s-category&fields=kind%2Cid&locale=s-locale&prettyPrint=false&strategy=s-strategy&url=s-url&utm_campaign=s-utm_campaign&utm_source=s-utm_source",
