  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"productSuites\":[{\"logicalProducts\":[\"s-logicalproducts\"],\"name\":\"s-name\",\"replaced\":true,\"replacement\":\"s-replacement\",\"title\":\"s-title\"}]}")
  gv_queue(f, "{\"productSuites\":[{\"logicalProducts\":[\"s-logicalproducts\"],\"name\":\"s-name\",\"replaced\":true,\"replacement\":\"s-replacement\",\"title\":\"s-title\"}]}")
  gv_note(f, "CALL cloudproductregistry.productSuites.list pages")
  var p = svc.product_suites.list_pages(options: ProductSuitesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_10)
}

const GO_11: List[Str] = [
  "CALL cloudproductregistry.productSuites.lookupEntity",
  "REQ GET https://cloudproductregistry.googleapis.com/v1/id1/%20x:lookupEntity?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"logicalProduct\":{\"lifecycleState\":\"s-lifecyclestate\",\"name\":\"s-name\",\"productSuite\":\"s-productsuite\",\"replaced\":true,\"replacement\":\"s-replacement\",\"title\":\"s-title\",\"variants\":[\"s-variants\"]},\"logicalProductVariant\":{\"lifecycleState\":\"s-lifecyclestate\",\"name\":\"s-name\",\"replaced\":true,\"replacement\":\"s-replacement\",\"title\":\"s-title\"},\"productSuite\":{\"logicalProducts\":[\"s-logicalproducts\"],\"name\":\"s-name\",\"replaced\":true,\"replacement\":\"s-replacement\",\"title\":\"s-title\"}}",
  "OUT: {\"logicalProduct\":{\"lifecycleState\":\"s-lifecyclestate\",\"name\":\"s-name\",\"productSuite\":\"s-productsuite\",\"replaced\":true,\"replacement\":\"s-replacement\",\"title\":\"s-title\",\"variants\":[\"s-variants\"]},\"logicalProductVariant\":{\"lifecycleState\":\"s-lifecyclestate\",\"name\":\"s-name\",\"replaced\":true,\"replacement\":\"s-replacement\",\"title\":\"s-title\"},\"productSuite\":{\"logicalProducts\":[\"s-logicalproducts\"],\"name\":\"s-name\",\"replaced\":true,\"replacement\":\"s-replacement\",\"title\":\"s-title\"}}",
]

test "Go's cloudproductregistry.productSuites.lookupEntity" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"logicalProduct\":{\"lifecycleState\":\"s-lifecyclestate\",\"name\":\"s-name\",\"productSuite\":\"s-productsuite\",\"replaced\":true,\"replacement\":\"s-replacement\",\"title\":\"s-title\",\"variants\":[\"s-variants\"]},\"logicalProductVariant\":{\"lifecycleState\":\"s-lifecyclestate\",\"name\":\"s-name\",\"replaced\":true,\"replacement\":\"s-replacement\",\"title\":\"s-title\"},\"productSuite\":{\"logicalProducts\":[\"s-logicalproducts\"],\"name\":\"s-name\",\"replaced\":true,\"replacement\":\"s-replacement\",\"title\":\"s-title\"}}")
  gv_note(f, "CALL cloudproductregistry.productSuites.lookupEntity")
  match svc.product_suites.lookup_entity("id1/ x", options: ProductSuitesLookupEntityOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_11)
}
