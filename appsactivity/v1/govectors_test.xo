// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 appsactivity/v1 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://www.googleapis.com"

const GO_0: List[Str] = [
  "CALL appsactivity.activities.list",
  "REQ GET https://www.googleapis.com/appsactivity/v1/activities?alt=json&drive.ancestorId=s-drive.ancestorid&drive.fileId=s-drive.fileid&fields=kind%2Cid&groupingStrategy=s-groupingstrategy&pageSize=7&pageToken=s-pagetoken&prettyPrint=false&source=s-source&userId=s-userid",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"activities\":[{\"combinedEvent\":{\"eventTimeMillis\":\"7\",\"fromUserDeletion\":true,\"primaryEventType\":\"s-primaryeventtype\"}}],\"nextPageToken\":\"s-nextpagetoken\"}",
  "OUT: {\"activities\":[{\"combinedEvent\":{\"eventTimeMillis\":\"7\",\"fromUserDeletion\":true,\"primaryEventType\":\"s-primaryeventtype\"}}],\"nextPageToken\":\"s-nextpagetoken\"}",
]

test "Go's appsactivity.activities.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"activities\":[{\"combinedEvent\":{\"eventTimeMillis\":\"7\",\"fromUserDeletion\":true,\"primaryEventType\":\"s-primaryeventtype\"}}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_note(f, "CALL appsactivity.activities.list")
  match svc.activities.list(options: ActivitiesListOptions{drive_ancestor_id: Some("s-drive.ancestorid"), drive_file_id: Some("s-drive.fileid"), grouping_strategy: Some("s-groupingstrategy"), page_size: Some(7), page_token: Some("s-pagetoken"), source: Some("s-source"), user_id: Some("s-userid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
