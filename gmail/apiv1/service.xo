  started: Bool = false
}

/// list_pages: UsersThreadsService.list's pages, from the first.
pub fn (r: UsersThreadsService[fx]) list_pages(user_id: Str, options: UsersThreadsListOptions = UsersThreadsListOptions{}) -> UsersThreadsListPages[fx] {
  UsersThreadsListPages{r: r, user_id: user_id, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: UsersThreadsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: UsersThreadsListPages[fx]) next_page() -> ListThreadsResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.user_id, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

