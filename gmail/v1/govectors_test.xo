test "Go's gmail.users.history.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"history\":[{\"id\":\"7\"}],\"historyId\":\"7\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"history\":[{\"id\":\"7\"}],\"historyId\":\"7\"}")
  gv_note(f, "CALL gmail.users.history.list pages")
  var p = svc.users.history.list_pages("id1/ x", options: UsersHistoryListOptions{history_types: ["s-historytypes"], label_id: Some("s-labelid"), max_results: Some(7), page_token: Some("s-pagetoken"), start_history_id: Some(7), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_17)
}

