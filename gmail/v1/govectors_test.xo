  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"resultSizeEstimate\":7,\"threads\":[{\"historyId\":\"7\",\"id\":\"s-id\",\"snippet\":\"s-snippet\"}]}")
  gv_queue(f, "{\"resultSizeEstimate\":7,\"threads\":[{\"historyId\":\"7\",\"id\":\"s-id\",\"snippet\":\"s-snippet\"}]}")
  gv_note(f, "CALL gmail.users.threads.list pages")
  var p = svc.users.threads.list_pages("id1/ x", options: UsersThreadsListOptions{include_spam_trash: Some(true), label_ids: ["s-labelids"], max_results: Some(7), page_token: Some("s-pagetoken"), q: Some("s-q"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_93)
}

