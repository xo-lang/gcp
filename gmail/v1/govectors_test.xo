test "Go's gmail.users.drafts.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"drafts\":[{\"id\":\"s-id\",\"message\":{\"historyId\":\"7\",\"id\":\"s-id\",\"internalDate\":\"7\",\"raw\":\"YWI=\",\"sizeEstimate\":7,\"snippet\":\"s-snippet\",\"threadId\":\"s-threadid\"}}],\"nextPageToken\":\"s-nextpagetoken\",\"resultSizeEstimate\":7}")
  gv_queue(f, "{\"drafts\":[{\"id\":\"s-id\",\"message\":{\"historyId\":\"7\",\"id\":\"s-id\",\"internalDate\":\"7\",\"raw\":\"YWI=\",\"sizeEstimate\":7,\"snippet\":\"s-snippet\",\"threadId\":\"s-threadid\"}}],\"resultSizeEstimate\":7}")
  gv_note(f, "CALL gmail.users.drafts.list pages")
  var p = svc.users.drafts.list_pages("id1/ x", options: UsersDraftsListOptions{include_spam_trash: Some(true), max_results: Some(7), page_token: Some("s-pagetoken"), q: Some("s-q"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_9)
}

