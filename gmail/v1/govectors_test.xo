test "Go's gmail.users.messages.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"messages\":[{\"historyId\":\"7\",\"id\":\"s-id\",\"internalDate\":\"7\",\"labelIds\":[\"s-labelids\"],\"payload\":{\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"partId\":\"s-partid\"},\"raw\":\"YWI=\",\"sizeEstimate\":7,\"snippet\":\"s-snippet\",\"threadId\":\"s-threadid\"}],\"nextPageToken\":\"s-nextpagetoken\",\"resultSizeEstimate\":7}")
  gv_queue(f, "{\"messages\":[{\"historyId\":\"7\",\"id\":\"s-id\",\"internalDate\":\"7\",\"labelIds\":[\"s-labelids\"],\"payload\":{\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"partId\":\"s-partid\"},\"raw\":\"YWI=\",\"sizeEstimate\":7,\"snippet\":\"s-snippet\",\"threadId\":\"s-threadid\"}],\"resultSizeEstimate\":7}")
  gv_note(f, "CALL gmail.users.messages.list pages")
  var p = svc.users.messages.list_pages("id1/ x", options: UsersMessagesListOptions{include_spam_trash: Some(true), label_ids: ["s-labelids"], max_results: Some(7), page_token: Some("s-pagetoken"), q: Some("s-q"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_35)
}

