test "Go's gmail.users.settings.cse.keypairs.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"cseKeyPairs\":[{\"disableTime\":\"s-disabletime\",\"enablementState\":\"s-enablementstate\",\"keyPairId\":\"s-keypairid\",\"pem\":\"s-pem\",\"pkcs7\":\"s-pkcs7\",\"subjectEmailAddresses\":[\"s-subjectemailaddresses\"]}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"cseKeyPairs\":[{\"disableTime\":\"s-disabletime\",\"enablementState\":\"s-enablementstate\",\"keyPairId\":\"s-keypairid\",\"pem\":\"s-pem\",\"pkcs7\":\"s-pkcs7\",\"subjectEmailAddresses\":[\"s-subjectemailaddresses\"]}]}")
  gv_note(f, "CALL gmail.users.settings.cse.keypairs.list pages")
  var p = svc.users.settings.cse.keypairs.list_pages("id1/ x", options: UsersSettingsCseKeypairsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_64)
}

