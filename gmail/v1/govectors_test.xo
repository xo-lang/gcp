  "  SERVED 200 {\"historyId\":\"7\",\"id\":\"s-id\",\"messages\":[{\"historyId\":\"7\",\"id\":\"s-id\",\"internalDate\":\"7\",\"labelIds\":[\"s-labelids\"],\"payload\":{\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"partId\":\"s-partid\"},\"raw\":\"YWI=\",\"sizeEstimate\":7,\"snippet\":\"s-snippet\",\"threadId\":\"s-threadid\"}],\"snippet\":\"s-snippet\"}",
  "OUT: {\"historyId\":\"7\",\"id\":\"s-id\",\"messages\":[{\"historyId\":\"7\",\"id\":\"s-id\",\"internalDate\":\"7\",\"labelIds\":[\"s-labelids\"],\"payload\":{\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"partId\":\"s-partid\"},\"raw\":\"YWI=\",\"sizeEstimate\":7,\"snippet\":\"s-snippet\",\"threadId\":\"s-threadid\"}],\"snippet\":\"s-snippet\"}",
]

test "Go's gmail.users.threads.trash" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"historyId\":\"7\",\"id\":\"s-id\",\"messages\":[{\"historyId\":\"7\",\"id\":\"s-id\",\"internalDate\":\"7\",\"labelIds\":[\"s-labelids\"],\"payload\":{\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"partId\":\"s-partid\"},\"raw\":\"YWI=\",\"sizeEstimate\":7,\"snippet\":\"s-snippet\",\"threadId\":\"s-threadid\"}],\"snippet\":\"s-snippet\"}")
  gv_note(f, "CALL gmail.users.threads.trash")
  match svc.users.threads.trash("id1/ x", "id2/ x", options: UsersThreadsTrashOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_95)
}

const GO_96: List[Str] = [
  "CALL gmail.users.threads.untrash",
  "REQ POST https://gmail.googleapis.com/gmail/v1/users/id1%2F%20x/threads/id2%2F%20x/untrash?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H x-extra=v1",
  "  B ",
  "  SERVED 200 {\"historyId\":\"7\",\"id\":\"s-id\",\"messages\":[{\"historyId\":\"7\",\"id\":\"s-id\",\"internalDate\":\"7\",\"labelIds\":[\"s-labelids\"],\"payload\":{\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"partId\":\"s-partid\"},\"raw\":\"YWI=\",\"sizeEstimate\":7,\"snippet\":\"s-snippet\",\"threadId\":\"s-threadid\"}],\"snippet\":\"s-snippet\"}",
  "OUT: {\"historyId\":\"7\",\"id\":\"s-id\",\"messages\":[{\"historyId\":\"7\",\"id\":\"s-id\",\"internalDate\":\"7\",\"labelIds\":[\"s-labelids\"],\"payload\":{\"filename\":\"s-filename\",\"mimeType\":\"s-mimetype\",\"partId\":\"s-partid\"},\"raw\":\"YWI=\",\"sizeEstimate\":7,\"snippet\":\"s-snippet\",\"threadId\":\"s-threadid\"}],\"snippet\":\"s-snippet\"}",
]

