  "OUT: {\"versions\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"scriptId\":\"s-scriptid\",\"versionNumber\":7}]}",
  "OUT: ok",
]

test "Go's script.projects.versions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"versions\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"scriptId\":\"s-scriptid\",\"versionNumber\":7}]}")
  gv_queue(f, "{\"versions\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"scriptId\":\"s-scriptid\",\"versionNumber\":7}]}")
  gv_note(f, "CALL script.projects.versions.list pages")
  var p = svc.projects.versions.list_pages("id1/ x", options: ProjectsVersionsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_18)
}

const GO_19: List[Str] = [
  "CALL script.scripts.run",
  "REQ POST https://script.googleapis.com/v1/scripts/id1%2F%20x:run?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"devMode\":true,\"function\":\"s-function\",\"parameters\":[{\"k\":\"v\"}],\"sessionState\":\"s-sessionstate\"}",
  "",
  "  SERVED 200 {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"response\":{\"k\":\"v\"}}",
  "OUT: {\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"response\":{\"k\":\"v\"}}",
]

test "Go's script.scripts.run" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"done\":true,\"error\":{\"code\":7,\"details\":[{\"k\":\"v\"}],\"message\":\"s-message\"},\"response\":{\"k\":\"v\"}}")
  gv_note(f, "CALL script.scripts.run")
  match svc.scripts.run("id1/ x", json.decode_str[ExecutionRequest]("{\"devMode\":true,\"function\":\"s-function\",\"parameters\":[{\"k\":\"v\"}],\"sessionState\":\"s-sessionstate\"}") ?? e => fault(e.display()), options: ScriptsRunOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_19)
}
