test "Go's script.projects.deployments.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"deployments\":[{\"deploymentConfig\":{\"description\":\"s-description\",\"manifestFileName\":\"s-manifestfilename\",\"scriptId\":\"s-scriptid\",\"versionNumber\":7},\"deploymentId\":\"s-deploymentid\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"deployments\":[{\"deploymentConfig\":{\"description\":\"s-description\",\"manifestFileName\":\"s-manifestfilename\",\"scriptId\":\"s-scriptid\",\"versionNumber\":7},\"deploymentId\":\"s-deploymentid\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL script.projects.deployments.list pages")
  var p = svc.projects.deployments.list_pages("id1/ x", options: ProjectsDeploymentsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_13)
}

