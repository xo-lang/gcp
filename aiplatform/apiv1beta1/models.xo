  /// A range of values for a numerical feature. Example: `{"range":{"low":10000.0,"high":50000.0}}` will capture 12345 and 23334 in the slice.
  pub range as "range,omitempty": GoogleCloudAiplatformV1beta1ModelEvaluationSliceSliceSliceSpecRange? = None
  /// A unique specific value for a given feature. Example: `{ "value": { "string_value": "12345" } }`
  pub value as "value,omitempty": GoogleCloudAiplatformV1beta1ModelEvaluationSliceSliceSliceSpecValue? = None
