  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"endpoints\":[{\"clientConnectionConfig\":{\"inferenceTimeout\":\"s-inferencetimeout\"},\"createTime\":\"s-createtime\",\"dedicatedEndpointDns\":\"s-dedicatedendpointdns\",\"dedicatedEndpointEnabled\":true,\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"enablePrivateServiceConnect\":true,\"encryptionSpec\":{\"kmsKeyName\":\"s-kmskeyname\"},\"etag\":\"s-etag\",\"gdcConfig\":{\"zone\":\"s-zone\"},\"genAiAdvancedFeaturesConfig\":{},\"labels\":{\"k1\":\"s-labels\"},\"modelDeploymentMonitoringJob\":\"s-modeldeploymentmonitoringjob\",\"name\":\"s-name\",\"network\":\"s-network\",\"predictRequestResponseLoggingConfig\":{\"enabled\":true,\"samplingRate\":1.5},\"privateServiceConnectConfig\":{\"enablePrivateServiceConnect\":true,\"serviceAttachment\":\"s-serviceattachment\"},\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"trafficSplit\":{\"k1\":7},\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"endpoints\":[{\"clientConnectionConfig\":{\"inferenceTimeout\":\"s-inferencetimeout\"},\"createTime\":\"s-createtime\",\"dedicatedEndpointDns\":\"s-dedicatedendpointdns\",\"dedicatedEndpointEnabled\":true,\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"enablePrivateServiceConnect\":true,\"encryptionSpec\":{\"kmsKeyName\":\"s-kmskeyname\"},\"etag\":\"s-etag\",\"gdcConfig\":{\"zone\":\"s-zone\"},\"genAiAdvancedFeaturesConfig\":{},\"labels\":{\"k1\":\"s-labels\"},\"modelDeploymentMonitoringJob\":\"s-modeldeploymentmonitoringjob\",\"name\":\"s-name\",\"network\":\"s-network\",\"predictRequestResponseLoggingConfig\":{\"enabled\":true,\"samplingRate\":1.5},\"privateServiceConnectConfig\":{\"enablePrivateServiceConnect\":true,\"serviceAttachment\":\"s-serviceattachment\"},\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"trafficSplit\":{\"k1\":7},\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL aiplatform.projects.locations.endpoints.list pages")
  var p = svc.projects.locations.endpoints.list_pages("id1/ x", options: ProjectsLocationsEndpointsListOptions{filter: Some("s-filter"), gdc_zone: Some("s-gdczone"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), read_mask: Some("s-readmask"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_393)
}

