  var p = svc.projects.locations.rag_engine_config.operations.list_pages("id1/ x", options: ProjectsLocationsRagEngineConfigOperationsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), return_partial_success: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
