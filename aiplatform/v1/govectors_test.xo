  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"tuningJobs\":[{\"baseModel\":\"s-basemodel\",\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"encryptionSpec\":{\"kmsKeyName\":\"s-kmskeyname\"},\"endTime\":\"s-endtime\",\"error\":{\"code\":7,\"message\":\"s-message\"},\"experiment\":\"s-experiment\",\"gcsMetricsUri\":\"s-gcsmetricsuri\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"preTunedModel\":{\"baseModel\":\"s-basemodel\",\"checkpointId\":\"s-checkpointid\",\"tunedModelName\":\"s-tunedmodelname\"},\"preferenceOptimizationSpec\":{\"exportLastCheckpointOnly\":true,\"trainingDatasetUri\":\"s-trainingdataseturi\",\"validationDatasetUri\":\"s-validationdataseturi\"},\"serviceAccount\":\"s-serviceaccount\",\"startTime\":\"s-starttime\",\"state\":\"s-state\",\"supervisedTuningSpec\":{\"exportLastCheckpointOnly\":true,\"trainingDatasetUri\":\"s-trainingdataseturi\",\"validationDatasetUri\":\"s-validationdataseturi\"},\"tunedModel\":{\"endpoint\":\"s-endpoint\",\"model\":\"s-model\"},\"tunedModelDisplayName\":\"s-tunedmodeldisplayname\",\"tuningDataStats\":{},\"updateTime\":\"s-updatetime\"}]}")
  gv_queue(f, "{\"tuningJobs\":[{\"baseModel\":\"s-basemodel\",\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"encryptionSpec\":{\"kmsKeyName\":\"s-kmskeyname\"},\"endTime\":\"s-endtime\",\"error\":{\"code\":7,\"message\":\"s-message\"},\"experiment\":\"s-experiment\",\"gcsMetricsUri\":\"s-gcsmetricsuri\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"preTunedModel\":{\"baseModel\":\"s-basemodel\",\"checkpointId\":\"s-checkpointid\",\"tunedModelName\":\"s-tunedmodelname\"},\"preferenceOptimizationSpec\":{\"exportLastCheckpointOnly\":true,\"trainingDatasetUri\":\"s-trainingdataseturi\",\"validationDatasetUri\":\"s-validationdataseturi\"},\"serviceAccount\":\"s-serviceaccount\",\"startTime\":\"s-starttime\",\"state\":\"s-state\",\"supervisedTuningSpec\":{\"exportLastCheckpointOnly\":true,\"trainingDatasetUri\":\"s-trainingdataseturi\",\"validationDatasetUri\":\"s-validationdataseturi\"},\"tunedModel\":{\"endpoint\":\"s-endpoint\",\"model\":\"s-model\"},\"tunedModelDisplayName\":\"s-tunedmodeldisplayname\",\"tuningDataStats\":{},\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL aiplatform.projects.locations.tuningJobs.list pages")
  var p = svc.projects.locations.tuning_jobs.list_pages("id1/ x", options: ProjectsLocationsTuningJobsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_1161)
}

