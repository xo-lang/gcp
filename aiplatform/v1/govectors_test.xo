  gv_queue(f, "{\"cachedContents\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"encryptionSpec\":{\"kmsKeyName\":\"s-kmskeyname\"},\"expireTime\":\"s-expiretime\",\"model\":\"s-model\",\"name\":\"s-name\",\"systemInstruction\":{\"role\":\"s-role\"},\"toolConfig\":{},\"ttl\":\"s-ttl\",\"updateTime\":\"s-updatetime\",\"usageMetadata\":{\"audioDurationSeconds\":7,\"imageCount\":7,\"textCount\":7,\"totalTokenCount\":7,\"videoDurationSeconds\":7}}]}")
