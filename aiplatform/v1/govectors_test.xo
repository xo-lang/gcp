  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"schedules\":[{\"allowQueueing\":true,\"catchUp\":true,\"createNotebookExecutionJobRequest\":{\"notebookExecutionJobId\":\"s-notebookexecutionjobid\",\"parent\":\"s-parent\"},\"createPipelineJobRequest\":{\"parent\":\"s-parent\",\"pipelineJobId\":\"s-pipelinejobid\"},\"createTime\":\"s-createtime\",\"cron\":\"s-cron\",\"displayName\":\"s-displayname\",\"endTime\":\"s-endtime\",\"lastPauseTime\":\"s-lastpausetime\",\"lastResumeTime\":\"s-lastresumetime\",\"lastScheduledRunResponse\":{\"runResponse\":\"s-runresponse\",\"scheduledRunTime\":\"s-scheduledruntime\"},\"maxConcurrentActiveRunCount\":\"7\",\"maxConcurrentRunCount\":\"7\",\"maxRunCount\":\"7\",\"name\":\"s-name\",\"nextRunTime\":\"s-nextruntime\",\"startTime\":\"s-starttime\",\"startedRunCount\":\"7\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\"}]}")
  gv_queue(f, "{\"schedules\":[{\"allowQueueing\":true,\"catchUp\":true,\"createNotebookExecutionJobRequest\":{\"notebookExecutionJobId\":\"s-notebookexecutionjobid\",\"parent\":\"s-parent\"},\"createPipelineJobRequest\":{\"parent\":\"s-parent\",\"pipelineJobId\":\"s-pipelinejobid\"},\"createTime\":\"s-createtime\",\"cron\":\"s-cron\",\"displayName\":\"s-displayname\",\"endTime\":\"s-endtime\",\"lastPauseTime\":\"s-lastpausetime\",\"lastResumeTime\":\"s-lastresumetime\",\"lastScheduledRunResponse\":{\"runResponse\":\"s-runresponse\",\"scheduledRunTime\":\"s-scheduledruntime\"},\"maxConcurrentActiveRunCount\":\"7\",\"maxConcurrentRunCount\":\"7\",\"maxRunCount\":\"7\",\"name\":\"s-name\",\"nextRunTime\":\"s-nextruntime\",\"startTime\":\"s-starttime\",\"startedRunCount\":\"7\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL aiplatform.projects.locations.schedules.list pages")
  var p = svc.projects.locations.schedules.list_pages("id1/ x", options: ProjectsLocationsSchedulesListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_998)
}

