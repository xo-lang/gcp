test "Go's aiplatform.datasets.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"datasets\":[{\"createTime\":\"s-createtime\",\"dataItemCount\":\"7\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"encryptionSpec\":{\"kmsKeyName\":\"s-kmskeyname\"},\"etag\":\"s-etag\",\"labels\":{\"k1\":\"s-labels\"},\"metadata\":{\"k\":\"v\"},\"metadataArtifact\":\"s-metadataartifact\",\"metadataSchemaUri\":\"s-metadataschemauri\",\"modelReference\":\"s-modelreference\",\"name\":\"s-name\",\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"datasets\":[{\"createTime\":\"s-createtime\",\"dataItemCount\":\"7\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"encryptionSpec\":{\"kmsKeyName\":\"s-kmskeyname\"},\"etag\":\"s-etag\",\"labels\":{\"k1\":\"s-labels\"},\"metadata\":{\"k\":\"v\"},\"metadataArtifact\":\"s-metadataartifact\",\"metadataSchemaUri\":\"s-metadataschemauri\",\"modelReference\":\"s-modelreference\",\"name\":\"s-name\",\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL aiplatform.datasets.list pages")
  var p = svc.datasets.list_pages(options: DatasetsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), parent: Some("s-parent"), read_mask: Some("s-readmask"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_20)
}

