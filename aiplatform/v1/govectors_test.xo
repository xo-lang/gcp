test "Go's aiplatform.reasoningEngines.sandboxEnvironmentSnapshots.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"sandboxEnvironmentSnapshots\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"expireTime\":\"s-expiretime\",\"name\":\"s-name\",\"owner\":\"s-owner\",\"parentSnapshot\":\"s-parentsnapshot\",\"postSnapshotAction\":\"s-postsnapshotaction\",\"sizeBytes\":\"7\",\"sourceSandboxEnvironment\":\"s-sourcesandboxenvironment\",\"ttl\":\"s-ttl\",\"updateTime\":\"s-updatetime\"}]}")
  gv_queue(f, "{\"sandboxEnvironmentSnapshots\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"expireTime\":\"s-expiretime\",\"name\":\"s-name\",\"owner\":\"s-owner\",\"parentSnapshot\":\"s-parentsnapshot\",\"postSnapshotAction\":\"s-postsnapshotaction\",\"sizeBytes\":\"7\",\"sourceSandboxEnvironment\":\"s-sourcesandboxenvironment\",\"ttl\":\"s-ttl\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL aiplatform.reasoningEngines.sandboxEnvironmentSnapshots.list pages")
  var p = svc.reasoning_engines.sandbox_environment_snapshots.list_pages("id1/ x", options: ReasoningEnginesSandboxEnvironmentSnapshotsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_1223)
}

