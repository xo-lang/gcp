test "Go's aiplatform.projects.locations.studies.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"studies\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"inactiveReason\":\"s-inactivereason\",\"name\":\"s-name\",\"state\":\"s-state\",\"studySpec\":{\"algorithm\":\"s-algorithm\",\"measurementSelectionType\":\"s-measurementselectiontype\",\"observationNoise\":\"s-observationnoise\"}}]}")
  gv_queue(f, "{\"studies\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"inactiveReason\":\"s-inactivereason\",\"name\":\"s-name\",\"state\":\"s-state\",\"studySpec\":{\"algorithm\":\"s-algorithm\",\"measurementSelectionType\":\"s-measurementselectiontype\",\"observationNoise\":\"s-observationnoise\"}}]}")
  gv_note(f, "CALL aiplatform.projects.locations.studies.list pages")
  var p = svc.projects.locations.studies.list_pages("id1/ x", options: ProjectsLocationsStudiesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_1055)
}

