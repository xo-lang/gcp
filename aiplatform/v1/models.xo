  pub inputs as "inputs,omitempty": Map[Str, GoogleCloudAiplatformV1ExplanationMetadataOverrideInputMetadataOverride] = {}
} derive Json

/// GoogleCloudAiplatformV1ExplanationMetadataOverrideInputMetadataOverride: The input metadata entries to be overridden.
pub struct GoogleCloudAiplatformV1ExplanationMetadataOverrideInputMetadataOverride {
  /// Baseline inputs for this feature. This overrides the `input_baseline` field of the ExplanationMetadata.InputMetadata object of the corresponding feature's input metadata. If it's not specified, the original baselines are not overridden.
  pub input_baselines as "inputBaselines,omitempty": List[json.Value] = []
} derive Json

/// GoogleCloudAiplatformV1ExplanationParameters: Parameters to configure explaining for Model's predictions.
pub struct GoogleCloudAiplatformV1ExplanationParameters {
  /// Example-based explanations that returns the nearest neighbors from the provided dataset.
  pub examples as "examples,omitempty": GoogleCloudAiplatformV1Examples? = None
  /// An attribution method that computes Aumann-Shapley values taking advantage of the model's fully differentiable structure. Refer to this paper for more details: https://arxiv.org/abs/1703.01365
  pub integrated_gradients_attribution as "integratedGradientsAttribution,omitempty": GoogleCloudAiplatformV1IntegratedGradientsAttribution? = None
  /// If populated, only returns attributions that have output_index contained in output_indices. It must be an ndarray of integers, with the same shape of the output it's explaining. If not populated, returns attributions for top_k indices of outputs. If neither top_k nor output_indices is populated, returns the argmax index of the outputs. Only applicable to Models that predict multiple outputs (e,g, multi-class Models that predict multiple classes).
  pub output_indices as "outputIndices,omitempty": List[json.Value] = []
  /// An attribution method that approximates Shapley values for features that contribute to the label being predicted. A sampling strategy is used to approximate the value rather than considering all subsets of features. Refer to this paper for model details: https://arxiv.org/abs/1306.4265.
  pub sampled_shapley_attribution as "sampledShapleyAttribution,omitempty": GoogleCloudAiplatformV1SampledShapleyAttribution? = None
  /// If populated, returns attributions for top K indices of outputs (defaults to 1). Only applies to Models that predicts more than one outputs (e,g, multi-class Models). When set to -1, returns explanations for all outputs.
  pub top_k as "topK,omitempty": Int = 0
  /// An attribution method that redistributes Integrated Gradients attribution to segmented regions, taking advantage of the model's fully differentiable structure. Refer to this paper for more details: https://arxiv.org/abs/1906.02825 XRAI currently performs better on natural images, like a picture of a house or an animal. If the images are taken in artificial environments, like a lab or manufacturing line, or from diagnostic equipment, like x-rays or quality-control cameras, use Integrated Gradients instead.
  pub xrai_attribution as "xraiAttribution,omitempty": GoogleCloudAiplatformV1XraiAttribution? = None
} derive Json

/// GoogleCloudAiplatformV1ExplanationSpec: Specification of Model explanation.
pub struct GoogleCloudAiplatformV1ExplanationSpec {
  /// Optional. Metadata describing the Model's input and output for explanation.
  pub metadata as "metadata,omitempty": GoogleCloudAiplatformV1ExplanationMetadata? = None
  /// Required. Parameters that configure explaining of the Model's predictions.
  pub parameters as "parameters,omitempty": GoogleCloudAiplatformV1ExplanationParameters? = None
} derive Json

/// GoogleCloudAiplatformV1ExplanationSpecOverride: The ExplanationSpec entries that can be overridden at online explanation time.
pub struct GoogleCloudAiplatformV1ExplanationSpecOverride {
  /// The example-based explanations parameter overrides.
  pub examples_override as "examplesOverride,omitempty": GoogleCloudAiplatformV1ExamplesOverride? = None
  /// The metadata to be overridden. If not specified, no metadata is overridden.
