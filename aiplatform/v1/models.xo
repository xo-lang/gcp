/// GoogleCloudAiplatformV1EvaluationRunEvaluationConfig: The Evalution configuration used for the evaluation run.
pub struct GoogleCloudAiplatformV1EvaluationRunEvaluationConfig {
  /// Optional. Allows the evaluation run to use cross region models. When this flag is set, the service may route traffic to other regions if a model is unavailable in the current region (e.g., to a `global` endpoint). If a fully-qualified model endpoint resource name with a different region than the run location is provided elsewhere in the run config, this flag must be set to true or the request will fail.
  pub allow_cross_region_model as "allowCrossRegionModel,omitempty": Bool = false
  /// Optional. The autorater config for the evaluation run.
  pub autorater_config as "autoraterConfig,omitempty": GoogleCloudAiplatformV1EvaluationRunEvaluationConfigAutoraterConfig? = None
  /// Optional. Configuration for exporting evaluation results to Cloud Logging.
  pub cloud_logging_config as "cloudLoggingConfig,omitempty": GoogleCloudAiplatformV1CloudLoggingConfig? = None
  /// Optional. Specifications for custom dataset-level aggregations.
  pub dataset_custom_metrics as "datasetCustomMetrics,omitempty": List[GoogleCloudAiplatformV1DatasetCustomMetric] = []
  /// Optional. Specifications for loss analysis. Each config can be specified for one metric.
  pub loss_analysis_config as "lossAnalysisConfig,omitempty": List[GoogleCloudAiplatformV1LossAnalysisConfig] = []
  /// Optional. The metrics to be calculated in the evaluation run. Required when analysis_configs is not set.
  pub metrics as "metrics,omitempty": List[GoogleCloudAiplatformV1EvaluationRunMetric] = []
  /// Optional. The output config for the evaluation run.
  pub output_config as "outputConfig,omitempty": GoogleCloudAiplatformV1EvaluationRunEvaluationConfigOutputConfig? = None
  /// The prompt template used for inference. The values for variables in the prompt template are defined in EvaluationItem.EvaluationPrompt.PromptTemplateData.values.
  pub prompt_template as "promptTemplate,omitempty": GoogleCloudAiplatformV1EvaluationRunEvaluationConfigPromptTemplate? = None
  /// Optional. The rubric configs for the evaluation run. They are used to generate rubrics which can be used by rubric-based metrics. Multiple rubric configs can be specified for rubric generation but only one rubric config can be used for a rubric-based metric. If more than one rubric config is provided, the evaluation metric must specify a rubric group key. Note that if a generation spec is specified on both a rubric config and an evaluation metric, the rubrics generated for the metric will be used for evaluation.
  pub rubric_configs as "rubricConfigs,omitempty": List[GoogleCloudAiplatformV1EvaluationRubricConfig] = []
} derive Json

/// GoogleCloudAiplatformV1EvaluationRunEvaluationConfigAutoraterConfig: The autorater config used for the evaluation run.
pub struct GoogleCloudAiplatformV1EvaluationRunEvaluationConfigAutoraterConfig {
  /// Optional. The fully qualified name of the publisher model or tuned autorater endpoint to use. Publisher model format: `projects/{project}/locations/{location}/publishers/*/models/*` Tuned model endpoint format: `projects/{project}/locations/{location}/endpoints/{endpoint}`
  pub autorater_model as "autoraterModel,omitempty": Str = ""
  /// Optional. Configuration options for model generation and outputs.
  pub generation_config as "generationConfig,omitempty": GoogleCloudAiplatformV1GenerationConfig? = None
  /// Optional. Number of samples for each instance in the dataset. If not specified, the default is 4. Minimum value is 1, maximum value is 32.
  pub sample_count as "sampleCount,omitempty": Int = 0
} derive Json

/// GoogleCloudAiplatformV1EvaluationRunEvaluationConfigOutputConfig: The output config for the evaluation run.
pub struct GoogleCloudAiplatformV1EvaluationRunEvaluationConfigOutputConfig {
  /// BigQuery destination for evaluation output.
  pub bigquery_destination as "bigqueryDestination,omitempty": GoogleCloudAiplatformV1BigQueryDestination? = None
  /// Cloud Storage destination for evaluation output.
  pub gcs_destination as "gcsDestination,omitempty": GoogleCloudAiplatformV1GcsDestination? = None
} derive Json

/// GoogleCloudAiplatformV1EvaluationRunEvaluationConfigPromptTemplate: Prompt template used for inference.
pub struct GoogleCloudAiplatformV1EvaluationRunEvaluationConfigPromptTemplate {
  /// Prompt template stored in Cloud Storage. Format: "gs://my-bucket/file-name.txt".
  pub gcs_uri as "gcsUri,omitempty": Str = ""
  /// Inline prompt template. Template variables should be in the format "{var_name}". Example: "Translate the following from {source_lang} to {target_lang}: {text}"
  pub prompt_template as "promptTemplate,omitempty": Str = ""
} derive Json

/// GoogleCloudAiplatformV1EvaluationRunInferenceConfig: Defines the configuration for a candidate model or agent being evaluated. `InferenceConfig` encapsulates all the necessary information to invoke or scrape the candidate during the evaluation run. This includes direct model inference parameters, agent execution settings, and multi-turn scraping configurations (such as user simulators). It serves as the primary representation of the candidate across different stages of the evaluation process.
pub struct GoogleCloudAiplatformV1EvaluationRunInferenceConfig {
  /// Optional. Agent run config.
  pub agent_run_config as "agentRunConfig,omitempty": GoogleCloudAiplatformV1EvaluationRunInferenceConfigAgentRunConfig? = None
  /// Optional. Contains the static configurations for each agent in the system. Key: agent_id (matches the `author` field in events). Value: The static configuration of the agent.
  pub agents as "agents,omitempty": Map[Str, GoogleCloudAiplatformV1AgentConfig] = {}
  /// Optional. Generation config.
  pub generation_config as "generationConfig,omitempty": GoogleCloudAiplatformV1GenerationConfig? = None
  /// Optional. The fully qualified name of the publisher model or endpoint to use. Anthropic and Llama third-party models are also supported through Model Garden. Publisher model format: `projects/{project}/locations/{location}/publishers/*/models/*` Third-party model formats: `projects/{project}/locations/{location}/publishers/anthropic/models/{model}` or `projects/{project}/locations/{location}/publishers/llama/models/{model}` Endpoint format: `projects/{project}/locations/{location}/endpoints/{endpoint}`
  pub model as "model,omitempty": Str = ""
  /// Optional. The parallelism of the evaluation run for the inference step. If not specified, the default parallelism will be used.
  pub parallelism as "parallelism,omitempty": Int = 0
  /// Optional. The prompt template used for inference. The values for variables in the prompt template are defined in EvaluationItem.EvaluationPrompt.PromptTemplateData.values. If not specified, the prompt template in the EvaluationConfig will be used.
  pub prompt_template as "promptTemplate,omitempty": GoogleCloudAiplatformV1EvaluationRunEvaluationConfigPromptTemplate? = None
} derive Json

/// GoogleCloudAiplatformV1EvaluationRunInferenceConfigAgentRunConfig: Configuration for Agent Run.
pub struct GoogleCloudAiplatformV1EvaluationRunInferenceConfigAgentRunConfig {
  /// Optional. The resource name of the Agent Engine. Format: projects/{project}/locations/{location}/reasoningEngines/{reasoning_engine} For example: projects/123/locations/us-central1/reasoningEngines/456
  pub agent_engine as "agentEngine,omitempty": Str = ""
  /// Optional. Config for scraping a Gemini Agent via the Interactions API. The scraping service creates interactions against the agent and returns the resulting interaction traces for evaluation.
  pub gemini_agent_config as "geminiAgentConfig,omitempty": GoogleCloudAiplatformV1GeminiAgentConfig? = None
  /// Optional. The session input to get agent running results.
  pub session_input as "sessionInput,omitempty": GoogleCloudAiplatformV1EvaluationRunInferenceConfigSessionInput? = None
  /// The configuration for a user simulator that uses an LLM to generate messages on behalf of the user.
  pub user_simulator_config as "userSimulatorConfig,omitempty": GoogleCloudAiplatformV1EvaluationRunInferenceConfigAgentRunConfigUserSimulatorConfig? = None
} derive Json

/// GoogleCloudAiplatformV1EvaluationRunInferenceConfigAgentRunConfigUserSimulatorConfig: Used for multi-turn agent scraping. Contains configuration for a user simulator that uses an LLM to generate messages on behalf of the user.
pub struct GoogleCloudAiplatformV1EvaluationRunInferenceConfigAgentRunConfigUserSimulatorConfig {
  /// Maximum number of invocations allowed by the multi-turn agent scraping. This property allows us to stop a run-off conversation, where the agent and the user simulator get into a never ending loop. The initial fixed prompt is also counted as an invocation.
  pub max_turn as "maxTurn,omitempty": Int = 0
  /// The configuration for the model.
  pub model_config as "modelConfig,omitempty": GoogleCloudAiplatformV1GenerationConfig? = None
  /// The model name to use for multi-turn agent scraping to get next user message, e.g. "gemini-3-flash-preview".
  pub model_name as "modelName,omitempty": Str = ""
} derive Json

/// GoogleCloudAiplatformV1EvaluationRunInferenceConfigSessionInput: Session input to run an Agent.
pub struct GoogleCloudAiplatformV1EvaluationRunInferenceConfigSessionInput {
  /// Optional. Additional parameters for the session, like app_name, etc. For example, {"app_name": "my-app"}.
