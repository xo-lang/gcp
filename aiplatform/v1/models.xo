/// GoogleCloudAiplatformV1ModelDeploymentMonitoringJob: Represents a job that runs periodically to monitor the deployed models in an endpoint. It will analyze the logged training & prediction data to detect any abnormal behaviors.
pub struct GoogleCloudAiplatformV1ModelDeploymentMonitoringJob {
  /// YAML schema file uri describing the format of a single instance that you want Tensorflow Data Validation (TFDV) to analyze. If this field is empty, all the feature data types are inferred from predict_instance_schema_uri, meaning that TFDV will use the data in the exact format(data type) as prediction request/response. If there are any data type differences between predict instance and TFDV instance, this field can be used to override the schema. For models trained with Vertex AI, this field must be set as all the fields in predict instance formatted as string.
  pub analysis_instance_schema_uri as "analysisInstanceSchemaUri,omitempty": Str = ""
  /// Output only. The created bigquery tables for the job under customer project. Customer could do their own query & analysis. There could be 4 log tables in maximum: 1. Training data logging predict request/response 2. Serving data logging predict request/response
  pub bigquery_tables as "bigqueryTables,omitempty": List[GoogleCloudAiplatformV1ModelDeploymentMonitoringBigQueryTable] = []
  /// Output only. Timestamp when this ModelDeploymentMonitoringJob was created.
  pub create_time as "createTime,omitempty": Str = ""
  /// Required. The user-defined name of the ModelDeploymentMonitoringJob. The name can be up to 128 characters long and can consist of any UTF-8 characters. Display name of a ModelDeploymentMonitoringJob.
  pub display_name as "displayName,omitempty": Str = ""
  /// If true, the scheduled monitoring pipeline logs are sent to Google Cloud Logging, including pipeline status and anomalies detected. Please note the logs incur cost, which are subject to [Cloud Logging pricing](https://cloud.google.com/logging#pricing).
  pub enable_monitoring_pipeline_logs as "enableMonitoringPipelineLogs,omitempty": Bool = false
  /// Customer-managed encryption key spec for a ModelDeploymentMonitoringJob. If set, this ModelDeploymentMonitoringJob and all sub-resources of this ModelDeploymentMonitoringJob will be secured by this key.
  pub encryption_spec as "encryptionSpec,omitempty": GoogleCloudAiplatformV1EncryptionSpec? = None
  /// Required. Endpoint resource name. Format: `projects/{project}/locations/{location}/endpoints/{endpoint}`
  pub endpoint as "endpoint,omitempty": Str = ""
  /// Output only. Only populated when the job's state is `JOB_STATE_FAILED` or `JOB_STATE_CANCELLED`.
  pub error as "error,omitempty": GoogleRpcStatus? = None
  /// The labels with user-defined metadata to organize your ModelDeploymentMonitoringJob. Label keys and values can be no longer than 64 characters (Unicode codepoints), can only contain lowercase letters, numeric characters, underscores and dashes. International characters are allowed. See https://goo.gl/xmQnxf for more information and examples of labels.
  pub labels as "labels,omitempty": Map[Str, Str] = {}
  /// Output only. Latest triggered monitoring pipeline metadata.
  pub latest_monitoring_pipeline_metadata as "latestMonitoringPipelineMetadata,omitempty": GoogleCloudAiplatformV1ModelDeploymentMonitoringJobLatestMonitoringPipelineMetadata? = None
  /// The TTL of BigQuery tables in user projects which stores logs. A day is the basic unit of the TTL and we take the ceil of TTL/86400(a day). e.g. { second: 3600} indicates ttl = 1 day.
  pub log_ttl as "logTtl,omitempty": Str = ""
  /// Required. Sample Strategy for logging.
  pub logging_sampling_strategy as "loggingSamplingStrategy,omitempty": GoogleCloudAiplatformV1SamplingStrategy? = None
  /// Required. The config for monitoring objectives. This is a per DeployedModel config. Each DeployedModel needs to be configured separately.
  pub model_deployment_monitoring_objective_configs as "modelDeploymentMonitoringObjectiveConfigs,omitempty": List[GoogleCloudAiplatformV1ModelDeploymentMonitoringObjectiveConfig] = []
  /// Required. Schedule config for running the monitoring job.
  pub model_deployment_monitoring_schedule_config as "modelDeploymentMonitoringScheduleConfig,omitempty": GoogleCloudAiplatformV1ModelDeploymentMonitoringScheduleConfig? = None
  /// Alert config for model monitoring.
  pub model_monitoring_alert_config as "modelMonitoringAlertConfig,omitempty": GoogleCloudAiplatformV1ModelMonitoringAlertConfig? = None
  /// Output only. Resource name of a ModelDeploymentMonitoringJob.
  pub name as "name,omitempty": Str = ""
  /// Output only. Timestamp when this monitoring pipeline will be scheduled to run for the next round.
  pub next_schedule_time as "nextScheduleTime,omitempty": Str = ""
  /// YAML schema file uri describing the format of a single instance, which are given to format this Endpoint's prediction (and explanation). If not set, we will generate predict schema from collected predict requests.
  pub predict_instance_schema_uri as "predictInstanceSchemaUri,omitempty": Str = ""
  /// Sample Predict instance, same format as PredictRequest.instances, this can be set as a replacement of ModelDeploymentMonitoringJob.predict_instance_schema_uri. If not set, we will generate predict schema from collected predict requests.
  pub sample_predict_instance as "samplePredictInstance,omitempty": json.Value? = None
  /// Output only. Reserved for future use.
  pub satisfies_pzi as "satisfiesPzi,omitempty": Bool = false
  /// Output only. Reserved for future use.
  pub satisfies_pzs as "satisfiesPzs,omitempty": Bool = false
  /// Output only. Schedule state when the monitoring job is in Running state.
  pub schedule_state as "scheduleState,omitempty": Str = ""
  /// Output only. The detailed state of the monitoring job. When the job is still creating, the state will be 'PENDING'. Once the job is successfully created, the state will be 'RUNNING'. Pause the job, the state will be 'PAUSED'. Resume the job, the state will return to 'RUNNING'.
  pub state as "state,omitempty": Str = ""
  /// Stats anomalies base folder path.
  pub stats_anomalies_base_directory as "statsAnomaliesBaseDirectory,omitempty": GoogleCloudAiplatformV1GcsDestination? = None
  /// Output only. Timestamp when this ModelDeploymentMonitoringJob was updated most recently.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

