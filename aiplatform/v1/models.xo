  pub bigquery_source as "bigquerySource,omitempty": GoogleCloudAiplatformV1BigQuerySource? = None
  /// The Cloud Storage location for the input instances.
  pub gcs_source as "gcsSource,omitempty": GoogleCloudAiplatformV1GcsSource? = None
  /// Required. The format in which instances are given, must be one of the Model's supported_input_storage_formats.
  pub instances_format as "instancesFormat,omitempty": Str = ""
  /// A Vertex Managed Dataset. Currently, only datasets of type Multimodal are supported.
  pub vertex_multimodal_dataset_source as "vertexMultimodalDatasetSource,omitempty": GoogleCloudAiplatformV1VertexMultimodalDatasetSource? = None
