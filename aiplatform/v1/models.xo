/// GoogleCloudAiplatformV1UsageMetadata: Usage metadata about the content generation request and response. This message provides a detailed breakdown of token usage and other relevant metrics.
pub struct GoogleCloudAiplatformV1UsageMetadata {
  /// Output only. A detailed breakdown of the token count for each modality in the cached content.
  pub cache_tokens_details as "cacheTokensDetails,omitempty": List[GoogleCloudAiplatformV1ModalityTokenCount] = []
  /// Output only. The number of tokens in the cached content that was used for this request.
  pub cached_content_token_count as "cachedContentTokenCount,omitempty": Int = 0
  /// The total number of tokens in the generated candidates.
  pub candidates_token_count as "candidatesTokenCount,omitempty": Int = 0
  /// Output only. A detailed breakdown of the token count for each modality in the generated candidates.
  pub candidates_tokens_details as "candidatesTokensDetails,omitempty": List[GoogleCloudAiplatformV1ModalityTokenCount] = []
  /// The total number of tokens in the prompt. This includes any text, images, or other media provided in the request. When `cached_content` is set, this also includes the number of tokens in the cached content.
  pub prompt_token_count as "promptTokenCount,omitempty": Int = 0
  /// Output only. A detailed breakdown of the token count for each modality in the prompt.
  pub prompt_tokens_details as "promptTokensDetails,omitempty": List[GoogleCloudAiplatformV1ModalityTokenCount] = []
  /// Output only. The number of tokens that were part of the model's generated "thoughts" output, if applicable.
  pub thoughts_token_count as "thoughtsTokenCount,omitempty": Int = 0
  /// Output only. The number of tokens in the results from tool executions, which are provided back to the model as input, if applicable.
  pub tool_use_prompt_token_count as "toolUsePromptTokenCount,omitempty": Int = 0
  /// Output only. A detailed breakdown by modality of the token counts from the results of tool executions, which are provided back to the model as input.
  pub tool_use_prompt_tokens_details as "toolUsePromptTokensDetails,omitempty": List[GoogleCloudAiplatformV1ModalityTokenCount] = []
  /// The total number of tokens for the entire request. This is the sum of `prompt_token_count`, `candidates_token_count`, `tool_use_prompt_token_count`, and `thoughts_token_count`.
  pub total_token_count as "totalTokenCount,omitempty": Int = 0
  /// Output only. The traffic type for this request.
  pub traffic_type as "trafficType,omitempty": Str = ""
} derive Json

