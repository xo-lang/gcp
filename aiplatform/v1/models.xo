  /// The pre-tuned model for continuous tuning.
  pub pre_tuned_model as "preTunedModel,omitempty": GoogleCloudAiplatformV1PreTunedModel? = None
  /// Tuning Spec for Preference Optimization.
  pub preference_optimization_spec as "preferenceOptimizationSpec,omitempty": GoogleCloudAiplatformV1PreferenceOptimizationSpec? = None
  /// The service account that the tuningJob workload runs as. If not specified, the Vertex AI Secure Fine-Tuned Service Agent in the project will be used. See https://cloud.google.com/iam/docs/service-agents#vertex-ai-secure-fine-tuning-service-agent Users starting the pipeline must have the `iam.serviceAccounts.actAs` permission on this service account.
  pub service_account as "serviceAccount,omitempty": Str = ""
  /// Output only. Time when the TuningJob for the first time entered the `JOB_STATE_RUNNING` state.
  pub start_time as "startTime,omitempty": Str = ""
  /// Output only. The detailed state of the job.
  pub state as "state,omitempty": Str = ""
  /// Tuning Spec for Supervised Fine Tuning.
