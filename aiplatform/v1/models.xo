  /// Optional. Input only. Immutable. A list of `Tools` the model may use to generate the next response
  pub tools as "tools,omitempty": List[GoogleCloudAiplatformV1Tool] = []
  /// Input only. The TTL for this resource. The expiration time is computed: now + TTL.
  pub ttl as "ttl,omitempty": Str = ""
  /// Output only. When the cache entry was last updated in UTC time.
  pub update_time as "updateTime,omitempty": Str = ""
  /// Output only. Metadata on the usage of the cached content.
  pub usage_metadata as "usageMetadata,omitempty": GoogleCloudAiplatformV1CachedContentUsageMetadata? = None
} derive Json

