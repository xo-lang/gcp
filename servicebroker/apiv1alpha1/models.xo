/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct GoogleTypeExpr {
  /// An optional description of the expression. This is a longer text which
  /// describes the expression, e.g. when hovered over it in a UI.
  pub description as "description,omitempty": Str = ""
  /// Textual representation of an expression in
  /// Common Expression Language syntax.
  ///
  /// The application context of the containing message determines which
  /// well-known feature set of CEL is supported.
  pub expression as "expression,omitempty": Str = ""
  /// An optional string indicating the location of the expression for error
  /// reporting, e.g. a file name and a position in the file.
  pub location as "location,omitempty": Str = ""
  /// An optional title for the expression, i.e. a short string describing
  /// its purpose. This can be used e.g. in UIs which allow to enter the
  /// expression.
  pub title as "title,omitempty": Str = ""
  pub force_send_fields as "~forceSendFields,omitempty": List[GoogleTypeExprField] = []
  pub null_fields as "~nullFields,omitempty": List[GoogleTypeExprField] = []
} derive Json

/// GoogleTypeExprField: GoogleTypeExpr's fields, for force_send_fields and null_fields.
pub enum GoogleTypeExprField {
  Description as "description=\"\""
  Expression as "expression=\"\""
  Location as "location=\"\""
  Title as "title=\"\""
} derive Json
