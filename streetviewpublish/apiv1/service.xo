/// PhotosListPages: the pages of PhotosService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct PhotosListPages[fx: Effects] {
  r: PhotosService[fx]
  options: PhotosListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: PhotosService.list's pages, from the first.
pub fn (r: PhotosService[fx]) list_pages(options: PhotosListOptions = PhotosListOptions{}) -> PhotosListPages[fx] {
  PhotosListPages{r: r, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: PhotosListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: PhotosListPages[fx]) next_page() -> ListPhotosResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
  new_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
