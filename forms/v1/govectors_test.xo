]

test "Go's forms.forms.watches.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"watches\":[{\"createTime\":\"s-createtime\",\"errorType\":\"s-errortype\",\"eventType\":\"s-eventtype\",\"expireTime\":\"s-expiretime\",\"id\":\"s-id\",\"state\":\"s-state\",\"target\":{}}]}")
  gv_note(f, "CALL forms.forms.watches.list")
  match svc.forms.watches.list("id1/ x", options: FormsWatchesListOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_9)
}

const GO_10: List[Str] = [
  "CALL forms.forms.watches.renew",
  "REQ POST https://forms.googleapis.com/v1/forms/id1%2F%20x/watches/id2%2F%20x:renew?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {}",
  "",
  "  SERVED 200 {\"createTime\":\"s-createtime\",\"errorType\":\"s-errortype\",\"eventType\":\"s-eventtype\",\"expireTime\":\"s-expiretime\",\"id\":\"s-id\",\"state\":\"s-state\",\"target\":{\"topic\":{\"topicName\":\"s-topicname\"}}}",
  "OUT: {\"createTime\":\"s-createtime\",\"errorType\":\"s-errortype\",\"eventType\":\"s-eventtype\",\"expireTime\":\"s-expiretime\",\"id\":\"s-id\",\"state\":\"s-state\",\"target\":{\"topic\":{\"topicName\":\"s-topicname\"}}}",
]

test "Go's forms.forms.watches.renew" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"createTime\":\"s-createtime\",\"errorType\":\"s-errortype\",\"eventType\":\"s-eventtype\",\"expireTime\":\"s-expiretime\",\"id\":\"s-id\",\"state\":\"s-state\",\"target\":{\"topic\":{\"topicName\":\"s-topicname\"}}}")
  gv_note(f, "CALL forms.forms.watches.renew")
  match svc.forms.watches.renew("id1/ x", "id2/ x", json.decode_str[RenewWatchRequest]("{}") ?? e => fault(e.display()), options: FormsWatchesRenewOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_10)
}
