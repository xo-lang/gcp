// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 translate/v2 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://translation.googleapis.com"

const GO_0: List[Str] = [
  "CALL language.detections.detect",
  "REQ POST https://translation.googleapis.com/language/translate/v2/detect?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"data\": {\"q\":[\"s-q\"]}",
  "}",
  "  SERVED 200 {\"data\":{\"detections\":[[{\"confidence\":1.5,\"isReliable\":true,\"language\":\"s-language\"}]]}}",
  "OUT: {\"detections\":[[{\"confidence\":1.5,\"isReliable\":true,\"language\":\"s-language\"}]]}",
]

test "Go's language.detections.detect" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"data\":{\"detections\":[[{\"confidence\":1.5,\"isReliable\":true,\"language\":\"s-language\"}]]}}")
  gv_note(f, "CALL language.detections.detect")
  match svc.detections.detect(json.decode_str[DetectLanguageRequest]("{\"q\":[\"s-q\"]}") ?? e => fault(e.display()), options: DetectionsDetectOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

