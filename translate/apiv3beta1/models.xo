  pub enable_shadow_removal_native_pdf as "enableShadowRemovalNativePdf,omitempty": Bool = false
  /// Optional. Glossary to be applied. The glossary must be within the same region (have the same location-id) as the model, otherwise an INVALID_ARGUMENT (400) error is returned.
  pub glossary_config as "glossaryConfig,omitempty": TranslateTextGlossaryConfig? = None
  /// Optional. is_translate_native_pdf_only field for external customers. If true, the page limit of online native pdf translation is 300 and only native pdf pages will be translated.
  pub is_translate_native_pdf_only as "isTranslateNativePdfOnly,omitempty": Bool = false
  /// Optional. The labels with user-defined metadata for the request. Label keys and values can be no longer than 63 characters (Unicode codepoints), can only contain lowercase letters, numeric characters, underscores and dashes. International characters are allowed. Label values are optional. Label keys must start with a letter. See https://cloud.google.com/translate/docs/advanced/labels for more information.
  pub labels as "labels,omitempty": Map[Str, Str] = {}
