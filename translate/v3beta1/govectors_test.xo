  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"glossaries\":[{\"endTime\":\"s-endtime\",\"entryCount\":7,\"inputConfig\":{},\"languageCodesSet\":{},\"languagePair\":{\"sourceLanguageCode\":\"s-sourcelanguagecode\",\"targetLanguageCode\":\"s-targetlanguagecode\"},\"name\":\"s-name\",\"submitTime\":\"s-submittime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"glossaries\":[{\"endTime\":\"s-endtime\",\"entryCount\":7,\"inputConfig\":{},\"languageCodesSet\":{},\"languagePair\":{\"sourceLanguageCode\":\"s-sourcelanguagecode\",\"targetLanguageCode\":\"s-targetlanguagecode\"},\"name\":\"s-name\",\"submitTime\":\"s-submittime\"}]}")
  gv_note(f, "CALL translate.projects.locations.glossaries.list pages")
  var p = svc.projects.locations.glossaries.list_pages("id1/ x", options: ProjectsLocationsGlossariesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
