  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"acl\":{\"aclInheritanceType\":\"s-aclinheritancetype\",\"inheritAclFrom\":\"s-inheritaclfrom\"},\"content\":{\"contentFormat\":\"s-contentformat\",\"hash\":\"s-hash\",\"inlineContent\":\"YWI=\"},\"itemType\":\"s-itemtype\",\"metadata\":{\"containerName\":\"s-containername\",\"contentLanguage\":\"s-contentlanguage\",\"createTime\":\"s-createtime\",\"hash\":\"s-hash\",\"mimeType\":\"s-mimetype\",\"objectType\":\"s-objecttype\",\"sourceRepositoryUrl\":\"s-sourcerepositoryurl\",\"title\":\"s-title\",\"updateTime\":\"s-updatetime\"},\"name\":\"s-name\",\"payload\":\"YWI=\",\"queue\":\"s-queue\",\"status\":{\"code\":\"s-code\"},\"structuredData\":{\"hash\":\"s-hash\"},\"version\":\"YWI=\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"acl\":{\"aclInheritanceType\":\"s-aclinheritancetype\",\"inheritAclFrom\":\"s-inheritaclfrom\"},\"content\":{\"contentFormat\":\"s-contentformat\",\"hash\":\"s-hash\",\"inlineContent\":\"YWI=\"},\"itemType\":\"s-itemtype\",\"metadata\":{\"containerName\":\"s-containername\",\"contentLanguage\":\"s-contentlanguage\",\"createTime\":\"s-createtime\",\"hash\":\"s-hash\",\"mimeType\":\"s-mimetype\",\"objectType\":\"s-objecttype\",\"sourceRepositoryUrl\":\"s-sourcerepositoryurl\",\"title\":\"s-title\",\"updateTime\":\"s-updatetime\"},\"name\":\"s-name\",\"payload\":\"YWI=\",\"queue\":\"s-queue\",\"status\":{\"code\":\"s-code\"},\"structuredData\":{\"hash\":\"s-hash\"},\"version\":\"YWI=\"}]}")
  gv_note(f, "CALL cloudsearch.indexing.datasources.items.list pages")
  var p = svc.indexing.datasources.items.list_pages("id1/ x", options: IndexingDatasourcesItemsListOptions{brief: Some(true), connector_name: Some("s-connectorname"), debug_options_enable_debugging: Some(true), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_17)
}

