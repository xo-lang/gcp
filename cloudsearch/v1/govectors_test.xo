test "Go's cloudsearch.settings.searchapplications.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"searchApplications\":[{\"defaultSortOptions\":{\"operatorName\":\"s-operatorname\",\"sortOrder\":\"s-sortorder\"},\"displayName\":\"s-displayname\",\"enableAuditLog\":true,\"name\":\"s-name\",\"operationIds\":[\"s-operationids\"],\"queryInterpretationConfig\":{\"forceDisableSupplementalResults\":true,\"forceVerbatimMode\":true},\"returnResultThumbnailUrls\":true,\"scoringConfig\":{\"disableFreshness\":true,\"disablePersonalization\":true}}]}")
  gv_queue(f, "{\"searchApplications\":[{\"defaultSortOptions\":{\"operatorName\":\"s-operatorname\",\"sortOrder\":\"s-sortorder\"},\"displayName\":\"s-displayname\",\"enableAuditLog\":true,\"name\":\"s-name\",\"operationIds\":[\"s-operationids\"],\"queryInterpretationConfig\":{\"forceDisableSupplementalResults\":true,\"forceVerbatimMode\":true},\"returnResultThumbnailUrls\":true,\"scoringConfig\":{\"disableFreshness\":true,\"disablePersonalization\":true}}]}")
  gv_note(f, "CALL cloudsearch.settings.searchapplications.list pages")
  var p = svc.settings.searchapplications.list_pages(options: SettingsSearchapplicationsListOptions{debug_options_enable_debugging: Some(true), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_44)
}

