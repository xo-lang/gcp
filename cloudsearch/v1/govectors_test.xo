test "Go's cloudsearch.debug.identitysources.unmappedids.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"unmappedIdentities\":[{\"externalIdentity\":{\"groupResourceName\":\"s-groupresourcename\",\"userResourceName\":\"s-userresourcename\"},\"resolutionStatusCode\":\"s-resolutionstatuscode\"}]}")
  gv_queue(f, "{\"unmappedIdentities\":[{\"externalIdentity\":{\"groupResourceName\":\"s-groupresourcename\",\"userResourceName\":\"s-userresourcename\"},\"resolutionStatusCode\":\"s-resolutionstatuscode\"}]}")
  gv_note(f, "CALL cloudsearch.debug.identitysources.unmappedids.list pages")
  var p = svc.debug.identitysources.unmappedids.list_pages("id1/ x", options: DebugIdentitysourcesUnmappedidsListOptions{debug_options_enable_debugging: Some(true), page_size: Some(7), page_token: Some("s-pagetoken"), resolution_status_code: Some("s-resolutionstatuscode"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_8)
}

