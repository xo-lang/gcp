test "Go's cloudsearch.settings.datasources.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"sources\":[{\"disableModifications\":true,\"disableServing\":true,\"displayName\":\"s-displayname\",\"indexingServiceAccounts\":[\"s-indexingserviceaccounts\"],\"name\":\"s-name\",\"operationIds\":[\"s-operationids\"],\"returnThumbnailUrls\":true,\"shortName\":\"s-shortname\"}]}")
  gv_queue(f, "{\"sources\":[{\"disableModifications\":true,\"disableServing\":true,\"displayName\":\"s-displayname\",\"indexingServiceAccounts\":[\"s-indexingserviceaccounts\"],\"name\":\"s-name\",\"operationIds\":[\"s-operationids\"],\"returnThumbnailUrls\":true,\"shortName\":\"s-shortname\"}]}")
  gv_note(f, "CALL cloudsearch.settings.datasources.list pages")
  var p = svc.settings.datasources.list_pages(options: SettingsDatasourcesListOptions{debug_options_enable_debugging: Some(true), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_37)
}

