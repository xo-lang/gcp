  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"backups\":[{\"backupType\":\"s-backuptype\",\"cluster\":\"s-cluster\",\"clusterUid\":\"s-clusteruid\",\"createTime\":\"s-createtime\",\"encryptionInfo\":{\"encryptionType\":\"s-encryptiontype\",\"kmsKeyPrimaryState\":\"s-kmskeyprimarystate\",\"lastUpdateTime\":\"s-lastupdatetime\"},\"engineVersion\":\"s-engineversion\",\"expireTime\":\"s-expiretime\",\"name\":\"s-name\",\"nodeType\":\"s-nodetype\",\"replicaCount\":7,\"shardCount\":7,\"state\":\"s-state\",\"totalSizeBytes\":\"7\",\"uid\":\"s-uid\"}],\"nextPageToken\":\"s-nextpagetoken\",\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"backups\":[{\"backupType\":\"s-backuptype\",\"cluster\":\"s-cluster\",\"clusterUid\":\"s-clusteruid\",\"createTime\":\"s-createtime\",\"encryptionInfo\":{\"encryptionType\":\"s-encryptiontype\",\"kmsKeyPrimaryState\":\"s-kmskeyprimarystate\",\"lastUpdateTime\":\"s-lastupdatetime\"},\"engineVersion\":\"s-engineversion\",\"expireTime\":\"s-expiretime\",\"name\":\"s-name\",\"nodeType\":\"s-nodetype\",\"replicaCount\":7,\"shardCount\":7,\"state\":\"s-state\",\"totalSizeBytes\":\"7\",\"uid\":\"s-uid\"}],\"unreachable\":[\"s-unreachable\"]}")
