  "  B {\"partition\":\"7\",\"target\":{\"eventTime\":\"s-eventtime\",\"publishTime\":\"s-publishtime\"}}",
  "",
  "  SERVED 200 {\"cursor\":{\"offset\":\"7\"}}",
  "OUT: {\"cursor\":{\"offset\":\"7\"}}",
]

test "Go's pubsublite.topicStats.projects.locations.topics.computeTimeCursor" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"cursor\":{\"offset\":\"7\"}}")
  gv_note(f, "CALL pubsublite.topicStats.projects.locations.topics.computeTimeCursor")
  match svc.topic_stats.projects.locations.topics.compute_time_cursor("id1/ x", json.decode_str[ComputeTimeCursorRequest]("{\"partition\":\"7\",\"target\":{\"eventTime\":\"s-eventtime\",\"publishTime\":\"s-publishtime\"}}") ?? e => fault(e.display()), options: TopicStatsProjectsLocationsTopicsComputeTimeCursorOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_27)
}
