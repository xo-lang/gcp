/// InstancesListPages: the pages of InstancesService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct InstancesListPages[fx: Effects] {
  r: InstancesService[fx]
  project: Str
  options: InstancesListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: InstancesService.list's pages, from the first.
pub fn (r: InstancesService[fx]) list_pages(project: Str, options: InstancesListOptions = InstancesListOptions{}) -> InstancesListPages[fx] {
  InstancesListPages{r: r, project: project, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: InstancesListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: InstancesListPages[fx]) next_page() -> InstancesListResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.project, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

