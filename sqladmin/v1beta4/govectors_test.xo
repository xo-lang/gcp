test "Go's sql.backups.listBackups pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"backups\":[{\"backupInterval\":{\"endTime\":\"s-endtime\",\"startTime\":\"s-starttime\"},\"backupKind\":\"s-backupkind\",\"backupRun\":\"s-backuprun\",\"databaseVersion\":\"s-databaseversion\",\"description\":\"s-description\",\"error\":{\"code\":\"s-code\",\"kind\":\"s-kind\",\"message\":\"s-message\"},\"expiryTime\":\"s-expirytime\",\"instance\":\"s-instance\",\"instanceDeletionTime\":\"s-instancedeletiontime\",\"instanceSettings\":{\"backendType\":\"s-backendtype\",\"connectionName\":\"s-connectionname\",\"createTime\":\"s-createtime\",\"currentDiskSize\":\"7\",\"databaseCenterIntegration\":\"s-databasecenterintegration\",\"databaseCenterIntegrationEnabled\":true,\"databaseInstalledVersion\":\"s-databaseinstalledversion\",\"databaseVersion\":\"s-databaseversion\",\"dnsName\":\"s-dnsname\",\"etag\":\"s-etag\",\"gceZone\":\"s-gcezone\",\"includeReplicasForMajorVersionUpgrade\":true,\"instanceType\":\"s-instancetype\",\"ipv6Address\":\"s-ipv6address\",\"kind\":\"s-kind\",\"maintenanceVersion\":\"s-maintenanceversion\",\"masterInstanceName\":\"s-masterinstancename\",\"maxDiskSize\":\"7\",\"name\":\"s-name\",\"nodeCount\":7,\"primaryDnsName\":\"s-primarydnsname\",\"project\":\"s-project\",\"pscServiceAttachmentLink\":\"s-pscserviceattachmentlink\",\"region\":\"s-region\",\"rootPassword\":\"s-rootpassword\",\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"secondaryGceZone\":\"s-secondarygcezone\",\"selfLink\":\"s-selflink\",\"serviceAccountEmailAddress\":\"s-serviceaccountemailaddress\",\"skipPrecheck\":true,\"sqlNetworkArchitecture\":\"s-sqlnetworkarchitecture\",\"state\":\"s-state\",\"switchTransactionLogsToCloudStorageEnabled\":true,\"writeEndpoint\":\"s-writeendpoint\"},\"kind\":\"s-kind\",\"kmsKey\":\"s-kmskey\",\"kmsKeyVersion\":\"s-kmskeyversion\",\"location\":\"s-location\",\"maxChargeableBytes\":\"7\",\"name\":\"s-name\",\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"selfLink\":\"s-selflink\",\"state\":\"s-state\",\"timeZone\":\"s-timezone\",\"ttlDays\":\"7\",\"type\":\"s-type\"}],\"nextPageToken\":\"s-nextpagetoken\",\"warnings\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"region\":\"s-region\"}]}")
  gv_queue(f, "{\"backups\":[{\"backupInterval\":{\"endTime\":\"s-endtime\",\"startTime\":\"s-starttime\"},\"backupKind\":\"s-backupkind\",\"backupRun\":\"s-backuprun\",\"databaseVersion\":\"s-databaseversion\",\"description\":\"s-description\",\"error\":{\"code\":\"s-code\",\"kind\":\"s-kind\",\"message\":\"s-message\"},\"expiryTime\":\"s-expirytime\",\"instance\":\"s-instance\",\"instanceDeletionTime\":\"s-instancedeletiontime\",\"instanceSettings\":{\"backendType\":\"s-backendtype\",\"connectionName\":\"s-connectionname\",\"createTime\":\"s-createtime\",\"currentDiskSize\":\"7\",\"databaseCenterIntegration\":\"s-databasecenterintegration\",\"databaseCenterIntegrationEnabled\":true,\"databaseInstalledVersion\":\"s-databaseinstalledversion\",\"databaseVersion\":\"s-databaseversion\",\"dnsName\":\"s-dnsname\",\"etag\":\"s-etag\",\"gceZone\":\"s-gcezone\",\"includeReplicasForMajorVersionUpgrade\":true,\"instanceType\":\"s-instancetype\",\"ipv6Address\":\"s-ipv6address\",\"kind\":\"s-kind\",\"maintenanceVersion\":\"s-maintenanceversion\",\"masterInstanceName\":\"s-masterinstancename\",\"maxDiskSize\":\"7\",\"name\":\"s-name\",\"nodeCount\":7,\"primaryDnsName\":\"s-primarydnsname\",\"project\":\"s-project\",\"pscServiceAttachmentLink\":\"s-pscserviceattachmentlink\",\"region\":\"s-region\",\"rootPassword\":\"s-rootpassword\",\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"secondaryGceZone\":\"s-secondarygcezone\",\"selfLink\":\"s-selflink\",\"serviceAccountEmailAddress\":\"s-serviceaccountemailaddress\",\"skipPrecheck\":true,\"sqlNetworkArchitecture\":\"s-sqlnetworkarchitecture\",\"state\":\"s-state\",\"switchTransactionLogsToCloudStorageEnabled\":true,\"writeEndpoint\":\"s-writeendpoint\"},\"kind\":\"s-kind\",\"kmsKey\":\"s-kmskey\",\"kmsKeyVersion\":\"s-kmskeyversion\",\"location\":\"s-location\",\"maxChargeableBytes\":\"7\",\"name\":\"s-name\",\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"selfLink\":\"s-selflink\",\"state\":\"s-state\",\"timeZone\":\"s-timezone\",\"ttlDays\":\"7\",\"type\":\"s-type\"}],\"warnings\":[{\"code\":\"s-code\",\"message\":\"s-message\",\"region\":\"s-region\"}]}")
  gv_note(f, "CALL sql.backups.listBackups pages")
  var p = svc.backups.list_backups_pages("id1/ x", options: BackupsListBackupsOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_9)
}

