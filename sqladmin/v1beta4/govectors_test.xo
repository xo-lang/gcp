  "REQ GET https://sqladmin.googleapis.com/sql/v1beta4/projects/id1%2F%20x/instances/id2%2F%20x/databases?alt=json&fields=kind%2Cid&location=s-location&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"items\":[{\"charset\":\"s-charset\",\"collation\":\"s-collation\",\"etag\":\"s-etag\",\"instance\":\"s-instance\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"project\":\"s-project\",\"selfLink\":\"s-selflink\",\"sqlserverDatabaseDetails\":{\"compatibilityLevel\":7,\"recoveryModel\":\"s-recoverymodel\"}}],\"kind\":\"s-kind\"}",
  "OUT: {\"items\":[{\"charset\":\"s-charset\",\"collation\":\"s-collation\",\"etag\":\"s-etag\",\"instance\":\"s-instance\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"project\":\"s-project\",\"selfLink\":\"s-selflink\",\"sqlserverDatabaseDetails\":{\"compatibilityLevel\":7,\"recoveryModel\":\"s-recoverymodel\"}}],\"kind\":\"s-kind\"}",
]

test "Go's sql.databases.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"charset\":\"s-charset\",\"collation\":\"s-collation\",\"etag\":\"s-etag\",\"instance\":\"s-instance\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"project\":\"s-project\",\"selfLink\":\"s-selflink\",\"sqlserverDatabaseDetails\":{\"compatibilityLevel\":7,\"recoveryModel\":\"s-recoverymodel\"}}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL sql.databases.list")
  match svc.databases.list("id1/ x", "id2/ x", options: DatabasesListOptions{location: Some("s-location"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_23)
}

