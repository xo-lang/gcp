test "Go's sql.backupRuns.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"backupKind\":\"s-backupkind\",\"databaseVersion\":\"s-databaseversion\",\"description\":\"s-description\",\"diskEncryptionConfiguration\":{\"cmekSourceLogEncryptionEnforced\":true,\"confidentialMode\":true,\"kind\":\"s-kind\",\"kmsKeyName\":\"s-kmskeyname\"},\"diskEncryptionStatus\":{\"kind\":\"s-kind\",\"kmsKeyVersionName\":\"s-kmskeyversionname\"},\"endTime\":\"s-endtime\",\"enqueuedTime\":\"s-enqueuedtime\",\"error\":{\"code\":\"s-code\",\"kind\":\"s-kind\",\"message\":\"s-message\"},\"id\":\"7\",\"instance\":\"s-instance\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"maxChargeableBytes\":\"7\",\"selfLink\":\"s-selflink\",\"startTime\":\"s-starttime\",\"status\":\"s-status\",\"timeZone\":\"s-timezone\",\"type\":\"s-type\",\"windowStartTime\":\"s-windowstarttime\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"backupKind\":\"s-backupkind\",\"databaseVersion\":\"s-databaseversion\",\"description\":\"s-description\",\"diskEncryptionConfiguration\":{\"cmekSourceLogEncryptionEnforced\":true,\"confidentialMode\":true,\"kind\":\"s-kind\",\"kmsKeyName\":\"s-kmskeyname\"},\"diskEncryptionStatus\":{\"kind\":\"s-kind\",\"kmsKeyVersionName\":\"s-kmskeyversionname\"},\"endTime\":\"s-endtime\",\"enqueuedTime\":\"s-enqueuedtime\",\"error\":{\"code\":\"s-code\",\"kind\":\"s-kind\",\"message\":\"s-message\"},\"id\":\"7\",\"instance\":\"s-instance\",\"kind\":\"s-kind\",\"location\":\"s-location\",\"maxChargeableBytes\":\"7\",\"selfLink\":\"s-selflink\",\"startTime\":\"s-starttime\",\"status\":\"s-status\",\"timeZone\":\"s-timezone\",\"type\":\"s-type\",\"windowStartTime\":\"s-windowstarttime\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL sql.backupRuns.list pages")
  var p = svc.backup_runs.list_pages("id1/ x", "id2/ x", options: BackupRunsListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_4)
}

