test "Go's sql.blueGreenDeployments.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"blueGreenDeployments\":[{\"createTime\":\"s-createtime\",\"deploymentTasks\":{},\"description\":\"s-description\",\"errorDetail\":\"s-errordetail\",\"name\":\"s-name\",\"requestedConfig\":{\"databaseVersion\":\"s-databaseversion\"},\"sourceInstance\":\"s-sourceinstance\",\"state\":\"s-state\",\"switchoverTargetInstance\":\"s-switchovertargetinstance\",\"targetConfig\":{\"databaseVersion\":\"s-databaseversion\"}}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"blueGreenDeployments\":[{\"createTime\":\"s-createtime\",\"deploymentTasks\":{},\"description\":\"s-description\",\"errorDetail\":\"s-errordetail\",\"name\":\"s-name\",\"requestedConfig\":{\"databaseVersion\":\"s-databaseversion\"},\"sourceInstance\":\"s-sourceinstance\",\"state\":\"s-state\",\"switchoverTargetInstance\":\"s-switchovertargetinstance\",\"targetConfig\":{\"databaseVersion\":\"s-databaseversion\"}}]}")
  gv_note(f, "CALL sql.blueGreenDeployments.list pages")
  var p = svc.blue_green_deployments.list_pages("id1/ x", options: BlueGreenDeploymentsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
