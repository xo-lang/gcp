]

test "Go's sql.instances.listServerCas" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"activeVersion\":\"s-activeversion\",\"certs\":[{\"cert\":\"s-cert\",\"certSerialNumber\":\"s-certserialnumber\",\"commonName\":\"s-commonname\",\"createTime\":\"s-createtime\",\"expirationTime\":\"s-expirationtime\",\"instance\":\"s-instance\",\"kind\":\"s-kind\",\"selfLink\":\"s-selflink\",\"sha1Fingerprint\":\"s-sha1fingerprint\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL sql.instances.listServerCas")
  match svc.instances.list_server_cas("id1/ x", "id2/ x", options: InstancesListServerCasOptions{location: Some("s-location"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_47)
}

