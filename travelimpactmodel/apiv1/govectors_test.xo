  "OUT: {\"flightsWithDetailedEmissions\":[{\"emissionsMetadata\":{\"timWebsiteEmissionsCalculatorUrl\":\"s-timwebsiteemissionscalculatorurl\"},\"flight\":{\"destination\":\"s-destination\",\"flightNumber\":7,\"operatingCarrierCode\":\"s-operatingcarriercode\",\"origin\":\"s-origin\"},\"flightEmissionsDetails\":{\"contrailsImpactBucket\":\"s-contrailsimpactbucket\",\"source\":\"s-source\"}}],\"modelVersion\":{\"dated\":\"s-dated\",\"major\":7,\"minor\":7,\"patch\":7}}",
]

test "Go's travelimpactmodel.flights.computeDetailedFlightEmissions" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"flightsWithDetailedEmissions\":[{\"emissionsMetadata\":{\"timWebsiteEmissionsCalculatorUrl\":\"s-timwebsiteemissionscalculatorurl\"},\"flight\":{\"destination\":\"s-destination\",\"flightNumber\":7,\"operatingCarrierCode\":\"s-operatingcarriercode\",\"origin\":\"s-origin\"},\"flightEmissionsDetails\":{\"contrailsImpactBucket\":\"s-contrailsimpactbucket\",\"source\":\"s-source\"}}],\"modelVersion\":{\"dated\":\"s-dated\",\"major\":7,\"minor\":7,\"patch\":7}}")
  gv_note(f, "CALL travelimpactmodel.flights.computeDetailedFlightEmissions")
  match svc.flights.compute_detailed_flight_emissions(json.decode_str[ComputeDetailedFlightEmissionsRequest]("{\"flights\":[{\"departureDate\":{\"day\":7,\"month\":7,\"year\":7},\"destination\":\"s-destination\",\"flightNumber\":7,\"operatingCarrierCode\":\"s-operatingcarriercode\",\"origin\":\"s-origin\"}]}") ?? e => fault(e.display()), options: FlightsComputeDetailedFlightEmissionsOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

