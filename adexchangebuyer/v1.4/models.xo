  /// The revision number of the product that the deal was created from (readonly, except on create)
  pub product_revision_number as "productRevisionNumber,omitempty": Str = ""
  /// Specifies the creative source for programmatic deals, PUBLISHER means creative is provided by seller and ADVERTISR means creative is provided by buyer. (buyer-readonly)
  pub programmatic_creative_source as "programmaticCreativeSource,omitempty": Str = ""
  pub proposal_id as "proposalId,omitempty": Str = ""
  /// Optional Seller contact information for the deal (buyer-readonly)
  pub seller_contacts as "sellerContacts,omitempty": List[ContactInformation] = []
  /// The shared targeting visible to buyers and sellers. Each shared targeting entity is AND'd together. (updatable)
  pub shared_targetings as "sharedTargetings,omitempty": List[SharedTargeting] = []
  /// The syndication product associated with the deal. (readonly, except on create)
  pub syndication_product as "syndicationProduct,omitempty": Str = ""
  /// The negotiable terms of the deal. (updatable)
  pub terms as "terms,omitempty": DealTerms? = None
  pub web_property_code as "webPropertyCode,omitempty": Str = ""
} derive Json

