  /// List must contain exactly one of PRETARGETING_CREATIVE_TYPE_HTML or PRETARGETING_CREATIVE_TYPE_VIDEO.
  pub creative_type as "creativeType,omitempty": List[Str] = []
  /// Requests which allow one of these (width, height) pairs will match. All pairs must be supported ad dimensions.
  pub dimensions as "dimensions,omitempty": List[PretargetingConfigDimensions] = []
  /// Requests with any of these content labels will not match. Values are from content-labels.txt in the downloadable files section.
  pub excluded_content_labels as "excludedContentLabels,omitempty": List[Str] = []
  /// Requests containing any of these geo criteria ids will not match.
  pub excluded_geo_criteria_ids as "excludedGeoCriteriaIds,omitempty": List[Str] = []
  /// Requests containing any of these placements will not match.
  pub excluded_placements as "excludedPlacements,omitempty": List[PretargetingConfigExcludedPlacements] = []
  /// Requests containing any of these users list ids will not match.
  pub excluded_user_lists as "excludedUserLists,omitempty": List[Str] = []
  /// Requests containing any of these vertical ids will not match. Values are from the publisher-verticals.txt file in the downloadable files section.
  pub excluded_verticals as "excludedVerticals,omitempty": List[Str] = []
  /// Requests containing any of these geo criteria ids will match.
  pub geo_criteria_ids as "geoCriteriaIds,omitempty": List[Str] = []
  /// Whether this config is active. Required for all requests.
  pub is_active as "isActive,omitempty": Bool = false
  /// The kind of the resource, i.e. "adexchangebuyer#pretargetingConfig".
  pub kind as "kind,omitempty": Str = ""
  /// Request containing any of these language codes will match.
  pub languages as "languages,omitempty": List[Str] = []
  /// The maximum QPS allocated to this pretargeting configuration, used for pretargeting-level QPS limits. By default, this is not set, which indicates that there is no QPS limit at the configuration level (a global or account-level limit may still be imposed).
  pub maximum_qps as "maximumQps,omitempty": Str = ""
  /// Requests where the predicted viewability is below the specified decile will not match. E.g. if the buyer sets this value to 5, requests from slots where the predicted viewability is below 50% will not match. If the predicted viewability is unknown this field will be ignored.
  pub minimum_viewability_decile as "minimumViewabilityDecile,omitempty": Int = 0
  /// Requests containing any of these mobile carrier ids will match. Values are from mobile-carriers.csv in the downloadable files section.
  pub mobile_carriers as "mobileCarriers,omitempty": List[Str] = []
  /// Requests containing any of these mobile device ids will match. Values are from mobile-devices.csv in the downloadable files section.
  pub mobile_devices as "mobileDevices,omitempty": List[Str] = []
  /// Requests containing any of these mobile operating system version ids will match. Values are from mobile-os.csv in the downloadable files section.
  pub mobile_operating_system_versions as "mobileOperatingSystemVersions,omitempty": List[Str] = []
  /// Requests containing any of these placements will match.
  pub placements as "placements,omitempty": List[PretargetingConfigPlacements] = []
  /// Requests matching any of these platforms will match. Possible values are PRETARGETING_PLATFORM_MOBILE, PRETARGETING_PLATFORM_DESKTOP, and PRETARGETING_PLATFORM_TABLET.
  pub platforms as "platforms,omitempty": List[Str] = []
  /// Creative attributes should be declared here if all creatives corresponding to this pretargeting configuration have that creative attribute. Values are from pretargetable-creative-attributes.txt in the downloadable files section.
  pub supported_creative_attributes as "supportedCreativeAttributes,omitempty": List[Str] = []
  /// Requests containing the specified type of user data will match. Possible values are HOSTED_MATCH_DATA, which means the request is cookie-targetable and has a match in the buyer's hosted match table, and COOKIE_OR_IDFA, which means the request has either a targetable cookie or an iOS IDFA.
  pub user_identifier_data_required as "userIdentifierDataRequired,omitempty": List[Str] = []
  /// Requests containing any of these user list ids will match.
  pub user_lists as "userLists,omitempty": List[Str] = []
  /// Requests that allow any of these vendor ids will match. Values are from vendors.txt in the downloadable files section.
  pub vendor_types as "vendorTypes,omitempty": List[Str] = []
  /// Requests containing any of these vertical ids will match.
  pub verticals as "verticals,omitempty": List[Str] = []
  /// Video requests satisfying any of these player size constraints will match.
