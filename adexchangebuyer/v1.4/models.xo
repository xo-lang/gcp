/// Product: A product is segment of inventory that a seller wishes to sell. It is associated with certain terms and targeting information which helps buyer know more about the inventory. Each field in a product can have one of the following setting:
///
/// (readonly) - It is an error to try and set this field. (buyer-readonly) - Only the seller can set this field. (seller-readonly) - Only the buyer can set this field. (updatable) - The field is updatable at all times by either buyer or the seller.
pub struct Product {
  /// The billed buyer corresponding to the buyer that created the offer. (readonly, except on create)
  pub billed_buyer as "billedBuyer,omitempty": Buyer? = None
  /// The buyer that created the offer if this is a buyer initiated offer (readonly, except on create)
  pub buyer as "buyer,omitempty": Buyer? = None
  /// Creation time in ms. since epoch (readonly)
  pub creation_time_ms as "creationTimeMs,omitempty": Str = ""
  /// Optional contact information for the creator of this product. (buyer-readonly)
  pub creator_contacts as "creatorContacts,omitempty": List[ContactInformation] = []
  /// The role that created the offer. Set to BUYER for buyer initiated offers.
  pub creator_role as "creatorRole,omitempty": Str = ""
  /// The set of fields around delivery control that are interesting for a buyer to see but are non-negotiable. These are set by the publisher. This message is assigned an id of 100 since some day we would want to model this as a protobuf extension.
  pub delivery_control as "deliveryControl,omitempty": DeliveryControl? = None
  /// The proposed end time for the deal (ms since epoch) (buyer-readonly)
  pub flight_end_time_ms as "flightEndTimeMs,omitempty": Str = ""
  /// Inventory availability dates. (times are in ms since epoch) The granularity is generally in the order of seconds. (buyer-readonly)
  pub flight_start_time_ms as "flightStartTimeMs,omitempty": Str = ""
  /// If the creator has already signed off on the product, then the buyer can finalize the deal by accepting the product as is. When copying to a proposal, if any of the terms are changed, then auto_finalize is automatically set to false.
  pub has_creator_signed_off as "hasCreatorSignedOff,omitempty": Bool = false
  /// What exchange will provide this inventory (readonly, except on create).
  pub inventory_source as "inventorySource,omitempty": Str = ""
  /// Identifies what kind of resource this is. Value: the fixed string "adexchangebuyer#product".
  pub kind as "kind,omitempty": Str = ""
  /// Optional List of labels for the product (optional, buyer-readonly).
  pub labels as "labels,omitempty": List[MarketplaceLabel] = []
  /// Time of last update in ms. since epoch (readonly)
  pub last_update_time_ms as "lastUpdateTimeMs,omitempty": Str = ""
  /// Optional legacy offer id if this offer is a preferred deal offer.
  pub legacy_offer_id as "legacyOfferId,omitempty": Str = ""
  /// Marketplace publisher profile Id. This Id differs from the regular publisher_profile_id in that 1. This is a new id, the old Id will be deprecated in 2017. 2. This id uniquely identifies a publisher profile by itself.
  pub marketplace_publisher_profile_id as "marketplacePublisherProfileId,omitempty": Str = ""
  /// The name for this product as set by the seller. (buyer-readonly)
  pub name as "name,omitempty": Str = ""
  /// Optional private auction id if this offer is a private auction offer.
  pub private_auction_id as "privateAuctionId,omitempty": Str = ""
  /// The unique id for the product (readonly)
  pub product_id as "productId,omitempty": Str = ""
  /// Id of the publisher profile for a given seller. A (seller.account_id, publisher_profile_id) pair uniquely identifies a publisher profile. Buyers can call the PublisherProfiles::List endpoint to get a list of publisher profiles for a given seller.
  pub publisher_profile_id as "publisherProfileId,omitempty": Str = ""
  /// Publisher self-provided forecast information.
  pub publisher_provided_forecast as "publisherProvidedForecast,omitempty": PublisherProvidedForecast? = None
  /// The revision number of the product. (readonly)
  pub revision_number as "revisionNumber,omitempty": Str = ""
  /// Information about the seller that created this product (readonly, except on create)
  pub seller as "seller,omitempty": Seller? = None
  /// Targeting that is shared between the buyer and the seller. Each targeting criteria has a specified key and for each key there is a list of inclusion value or exclusion values. (buyer-readonly)
  pub shared_targetings as "sharedTargetings,omitempty": List[SharedTargeting] = []
  /// The state of the product. (buyer-readonly)
  pub state as "state,omitempty": Str = ""
  /// The syndication product associated with the deal. (readonly, except on create)
  pub syndication_product as "syndicationProduct,omitempty": Str = ""
  /// The negotiable terms of the deal (buyer-readonly)
  pub terms as "terms,omitempty": DealTerms? = None
  /// The web property code for the seller. This field is meant to be copied over as is when creating deals.
  pub web_property_code as "webPropertyCode,omitempty": Str = ""
} derive Json

/// Proposal: Represents a proposal in the marketplace. A proposal is the unit of negotiation between a seller and a buyer and contains deals which are served. Each field in a proposal can have one of the following setting:
///
/// (readonly) - It is an error to try and set this field. (buyer-readonly) - Only the seller can set this field. (seller-readonly) - Only the buyer can set this field. (updatable) - The field is updatable at all times by either buyer or the seller.
pub struct Proposal {
  /// Reference to the buyer that will get billed for this proposal. (readonly)
  pub billed_buyer as "billedBuyer,omitempty": Buyer? = None
  /// Reference to the buyer on the proposal. (readonly, except on create)
  pub buyer as "buyer,omitempty": Buyer? = None
  /// Optional contact information of the buyer. (seller-readonly)
