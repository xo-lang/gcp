  "  SERVED 200 {\"items\":[{\"HTMLSnippet\":\"s-htmlsnippet\",\"accountId\":7,\"advertiserId\":[\"7\"],\"advertiserName\":\"s-advertisername\",\"agencyId\":\"7\",\"apiUploadTimestamp\":\"s-apiuploadtimestamp\",\"attribute\":[7],\"buyerCreativeId\":\"s-buyercreativeid\",\"clickThroughUrl\":[\"s-clickthroughurl\"],\"corrections\":[{\"reason\":\"s-reason\"}],\"disapprovalReasons\":[{\"reason\":\"s-reason\"}],\"filteringReasons\":{\"date\":\"s-date\"},\"height\":7,\"impressionTrackingUrl\":[\"s-impressiontrackingurl\"],\"kind\":\"s-kind\",\"productCategories\":[7],\"restrictedCategories\":[7],\"sensitiveCategories\":[7],\"status\":\"s-status\",\"vendorType\":[7],\"version\":7,\"videoURL\":\"s-videourl\",\"width\":7}],\"kind\":\"s-kind\"}",
  "OUT: {\"items\":[{\"HTMLSnippet\":\"s-htmlsnippet\",\"accountId\":7,\"advertiserId\":[\"7\"],\"advertiserName\":\"s-advertisername\",\"agencyId\":\"7\",\"apiUploadTimestamp\":\"s-apiuploadtimestamp\",\"attribute\":[7],\"buyerCreativeId\":\"s-buyercreativeid\",\"clickThroughUrl\":[\"s-clickthroughurl\"],\"corrections\":[{\"reason\":\"s-reason\"}],\"disapprovalReasons\":[{\"reason\":\"s-reason\"}],\"filteringReasons\":{\"date\":\"s-date\"},\"height\":7,\"impressionTrackingUrl\":[\"s-impressiontrackingurl\"],\"kind\":\"s-kind\",\"productCategories\":[7],\"restrictedCategories\":[7],\"sensitiveCategories\":[7],\"status\":\"s-status\",\"vendorType\":[7],\"version\":7,\"videoURL\":\"s-videourl\",\"width\":7}],\"kind\":\"s-kind\"}",
  "OUT: ok",
]

test "Go's adexchangebuyer.creatives.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"HTMLSnippet\":\"s-htmlsnippet\",\"accountId\":7,\"advertiserId\":[\"7\"],\"advertiserName\":\"s-advertisername\",\"agencyId\":\"7\",\"apiUploadTimestamp\":\"s-apiuploadtimestamp\",\"attribute\":[7],\"buyerCreativeId\":\"s-buyercreativeid\",\"clickThroughUrl\":[\"s-clickthroughurl\"],\"corrections\":[{\"reason\":\"s-reason\"}],\"disapprovalReasons\":[{\"reason\":\"s-reason\"}],\"filteringReasons\":{\"date\":\"s-date\"},\"height\":7,\"impressionTrackingUrl\":[\"s-impressiontrackingurl\"],\"kind\":\"s-kind\",\"productCategories\":[7],\"restrictedCategories\":[7],\"sensitiveCategories\":[7],\"status\":\"s-status\",\"vendorType\":[7],\"version\":7,\"videoURL\":\"s-videourl\",\"width\":7}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"HTMLSnippet\":\"s-htmlsnippet\",\"accountId\":7,\"advertiserId\":[\"7\"],\"advertiserName\":\"s-advertisername\",\"agencyId\":\"7\",\"apiUploadTimestamp\":\"s-apiuploadtimestamp\",\"attribute\":[7],\"buyerCreativeId\":\"s-buyercreativeid\",\"clickThroughUrl\":[\"s-clickthroughurl\"],\"corrections\":[{\"reason\":\"s-reason\"}],\"disapprovalReasons\":[{\"reason\":\"s-reason\"}],\"filteringReasons\":{\"date\":\"s-date\"},\"height\":7,\"impressionTrackingUrl\":[\"s-impressiontrackingurl\"],\"kind\":\"s-kind\",\"productCategories\":[7],\"restrictedCategories\":[7],\"sensitiveCategories\":[7],\"status\":\"s-status\",\"vendorType\":[7],\"version\":7,\"videoURL\":\"s-videourl\",\"width\":7}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL adexchangebuyer.creatives.list pages")
  var p = svc.creatives.list_pages(options: CreativesListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), status_filter: Some("s-statusfilter"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_7)
}
