  /// Identifies what kind of resource this is. Value: the fixed string "adexchangebuyer#product".
  pub kind as "kind,omitempty": Str = ""
  /// Optional List of labels for the product (optional, buyer-readonly).
  pub labels as "labels,omitempty": List[MarketplaceLabel] = []
  /// Time of last update in ms. since epoch (readonly)
  pub last_update_time_ms as "lastUpdateTimeMs,omitempty,string": Int = 0
