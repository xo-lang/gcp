test "Go's bigquerydatatransfer.projects.transferConfigs.runs.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"transferRuns\":[{\"dataSourceId\":\"s-datasourceid\",\"destinationDatasetId\":\"s-destinationdatasetid\",\"emailPreferences\":{\"enableFailureEmail\":true},\"endTime\":\"s-endtime\",\"errorStatus\":{\"code\":7,\"message\":\"s-message\"},\"name\":\"s-name\",\"notificationPubsubTopic\":\"s-notificationpubsubtopic\",\"parameterConfig\":{},\"params\":{\"k\":\"v\"},\"runTime\":\"s-runtime\",\"schedule\":\"s-schedule\",\"scheduleTime\":\"s-scheduletime\",\"startTime\":\"s-starttime\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"userId\":\"7\"}]}")
  gv_queue(f, "{\"transferRuns\":[{\"dataSourceId\":\"s-datasourceid\",\"destinationDatasetId\":\"s-destinationdatasetid\",\"emailPreferences\":{\"enableFailureEmail\":true},\"endTime\":\"s-endtime\",\"errorStatus\":{\"code\":7,\"message\":\"s-message\"},\"name\":\"s-name\",\"notificationPubsubTopic\":\"s-notificationpubsubtopic\",\"parameterConfig\":{},\"params\":{\"k\":\"v\"},\"runTime\":\"s-runtime\",\"schedule\":\"s-schedule\",\"scheduleTime\":\"s-scheduletime\",\"startTime\":\"s-starttime\",\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"userId\":\"7\"}]}")
  gv_note(f, "CALL bigquerydatatransfer.projects.transferConfigs.runs.list pages")
  var p = svc.projects.transfer_configs.runs.list_pages("id1/ x", options: ProjectsTransferConfigsRunsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), run_attempt: Some("s-runattempt"), states: ["s-states"], fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_42)
}

