  gv_queue(f, "{\"transferConfigs\":[{\"dataRefreshWindowDays\":7,\"dataSourceId\":\"s-datasourceid\",\"datasetRegion\":\"s-datasetregion\",\"destinationDatasetId\":\"s-destinationdatasetid\",\"disabled\":true,\"displayName\":\"s-displayname\",\"emailPreferences\":{\"enableFailureEmail\":true},\"encryptionConfiguration\":{\"kmsKeyName\":\"s-kmskeyname\"},\"error\":{\"code\":7,\"message\":\"s-message\"},\"managedTableType\":\"s-managedtabletype\",\"metadataDestination\":{},\"name\":\"s-name\",\"nextRunTime\":\"s-nextruntime\",\"notificationPubsubTopic\":\"s-notificationpubsubtopic\",\"ownerInfo\":{\"email\":\"s-email\"},\"paramConfig\":{},\"params\":{\"k\":\"v\"},\"schedule\":\"s-schedule\",\"scheduleOptions\":{\"disableAutoScheduling\":true,\"endTime\":\"s-endtime\",\"startTime\":\"s-starttime\"},\"scheduleOptionsV2\":{},\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"userId\":\"7\"}]}")
  gv_note(f, "CALL bigquerydatatransfer.projects.locations.transferConfigs.list pages")
  var p = svc.projects.locations.transfer_configs.list_pages("id1/ x", options: ProjectsLocationsTransferConfigsListOptions{data_source_ids: ["s-datasourceids"], page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_18)
}

