  match svc.locations.questions.answers.upsert("id1/ x", json.decode_str[UpsertAnswerRequest]("{\"answer\":{\"author\":{\"displayName\":\"s-displayname\",\"profilePhotoUri\":\"s-profilephotouri\",\"type\":\"s-type\"},\"createTime\":\"s-createtime\",\"name\":\"s-name\",\"text\":\"s-text\",\"updateTime\":\"s-updatetime\",\"upvoteCount\":7}}") ?? e => fault(e.display()), options: LocationsQuestionsAnswersUpsertOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_8)
}
