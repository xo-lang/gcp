// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 adexperiencereport/v1 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://adexperiencereport.googleapis.com"

const GO_0: List[Str] = [
  "CALL adexperiencereport.sites.get",
  "REQ GET https://adexperiencereport.googleapis.com/v1/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"desktopSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"region\":[\"s-region\"],\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"mobileSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"region\":[\"s-region\"],\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"reviewedSite\":\"s-reviewedsite\"}",
  "OUT: {\"desktopSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"region\":[\"s-region\"],\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"mobileSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"region\":[\"s-region\"],\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"reviewedSite\":\"s-reviewedsite\"}",
]

test "Go's adexperiencereport.sites.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"desktopSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"region\":[\"s-region\"],\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"mobileSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"region\":[\"s-region\"],\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"reviewedSite\":\"s-reviewedsite\"}")
  gv_note(f, "CALL adexperiencereport.sites.get")
  match svc.sites.get("id1/ x", options: SitesGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

const GO_1: List[Str] = [
  "CALL adexperiencereport.violatingSites.list",
  "REQ GET https://adexperiencereport.googleapis.com/v1/violatingSites?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"violatingSites\":[{\"desktopSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"mobileSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"reviewedSite\":\"s-reviewedsite\"}]}",
  "OUT: {\"violatingSites\":[{\"desktopSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"mobileSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"reviewedSite\":\"s-reviewedsite\"}]}",
]

test "Go's adexperiencereport.violatingSites.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"violatingSites\":[{\"desktopSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"mobileSummary\":{\"betterAdsStatus\":\"s-betteradsstatus\",\"enforcementTime\":\"s-enforcementtime\",\"filterStatus\":\"s-filterstatus\",\"lastChangeTime\":\"s-lastchangetime\",\"reportUrl\":\"s-reporturl\",\"underReview\":true},\"reviewedSite\":\"s-reviewedsite\"}]}")
  gv_note(f, "CALL adexperiencereport.violatingSites.list")
  match svc.violating_sites.list(options: ViolatingSitesListOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_1)
}
