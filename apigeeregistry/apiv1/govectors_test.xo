  "REQ GET https://apigeeregistry.googleapis.com/v1/id1/%20x:getIamPolicy?alt=json&fields=kind%2Cid&options.requestedPolicyVersion=7&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"bindings\":[{\"condition\":{\"description\":\"s-description\",\"expression\":\"s-expression\",\"location\":\"s-location\",\"title\":\"s-title\"},\"members\":[\"s-members\"],\"role\":\"s-role\"}],\"etag\":\"YWI=\",\"version\":7}",
  "OUT: {\"bindings\":[{\"condition\":{\"description\":\"s-description\",\"expression\":\"s-expression\",\"location\":\"s-location\",\"title\":\"s-title\"},\"members\":[\"s-members\"],\"role\":\"s-role\"}],\"etag\":\"YWI=\",\"version\":7}",
]

test "Go's apigeeregistry.projects.locations.runtime.getIamPolicy" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"bindings\":[{\"condition\":{\"description\":\"s-description\",\"expression\":\"s-expression\",\"location\":\"s-location\",\"title\":\"s-title\"},\"members\":[\"s-members\"],\"role\":\"s-role\"}],\"etag\":\"YWI=\",\"version\":7}")
  gv_note(f, "CALL apigeeregistry.projects.locations.runtime.getIamPolicy")
  match svc.projects.locations.runtime.get_iam_policy("id1/ x", options: ProjectsLocationsRuntimeGetIamPolicyOptions{options_requested_policy_version: Some(7), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_111)
}

