  gv_queue(f, "{\"artifacts\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"contents\":\"YWI=\",\"createTime\":\"s-createtime\",\"hash\":\"s-hash\",\"labels\":{\"k1\":\"s-labels\"},\"mimeType\":\"s-mimetype\",\"name\":\"s-name\",\"sizeBytes\":7,\"updateTime\":\"s-updatetime\"}]}")
