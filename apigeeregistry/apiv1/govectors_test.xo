test "Go's apigeeregistry.projects.locations.apis.deployments.artifacts.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"artifacts\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"contents\":\"YWI=\",\"createTime\":\"s-createtime\",\"hash\":\"s-hash\",\"labels\":{\"k1\":\"s-labels\"},\"mimeType\":\"s-mimetype\",\"name\":\"s-name\",\"sizeBytes\":7,\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"artifacts\":[{\"annotations\":{\"k1\":\"s-annotations\"},\"contents\":\"YWI=\",\"createTime\":\"s-createtime\",\"hash\":\"s-hash\",\"labels\":{\"k1\":\"s-labels\"},\"mimeType\":\"s-mimetype\",\"name\":\"s-name\",\"sizeBytes\":7,\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL apigeeregistry.projects.locations.apis.deployments.artifacts.list pages")
  var p = svc.projects.locations.apis.deployments.artifacts.list_pages("id1/ x", options: ProjectsLocationsApisDeploymentsArtifactsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_41)
}

