// The generator's command, run from the repository root:
//   xo run ./codegen/cmd/gen -- <api module dir> <module dir>... | all
// <api module dir> is google.golang.org/api at codegen/services.toml's
// go_version in the Go module cache. For each module it reads the row's
// Discovery document there and writes the module into its directory.
// What the generator does not handle is printed, never dropped silently.

use std/json
use std/toml
use github.com/xo-lang/gcp/codegen/gen

struct Service {
  pub dir: Str
  pub package: Str
  pub doc: Str
} derive Json

struct Services {
  pub go_version: Str
  pub service: List[Service]
} derive Json

fn main(os: Os) -> () ! Error {
  let args = os.env.args()
  if args.len() < 2 {
    os.stdio.println("usage: gen <google.golang.org/api dir> <module dir>... | all")
    return Err("usage")
  }
  let api_dir = args[0]
  let services = toml.decode[Services](os.fs.read_text("codegen/services.toml")?)?
  let wanted = args[1..args.len()]
  let rows = if wanted == ["all"] { services.service } else { services.service.filter(fn(s: Service) -> Bool { wanted.contains(s.dir) }) }
  if rows.len() != wanted.len() && wanted != ["all"] {
    return Err("a module is not in codegen/services.toml")
  }
  var failed = 0
  for svc in rows {
    let text = os.fs.read_text("${api_dir}/${svc.dir}/${svc.doc}")?
    let doc = json.parse_value(text) ?? e => {
      os.stdio.println("${svc.dir}: ${e.display()}")
      failed = failed + 1
      continue
    }
    let header = "// Code generated by xo-lang/gcp codegen from google.golang.org/api ${services.go_version} ${svc.dir}/${svc.doc}; BSD-3-Clause, Copyright (c) 2011 Google Inc. (NOTICE.md).\n// DO NOT EDIT.\n"
    let m = gen.generate(doc, header)
    os.fs.create_dir_all(svc.dir)?
    os.fs.write("${svc.dir}/xo.mod", "module github.com/xo-lang/gcp/${svc.dir}\nedition preview\n\nrequire github.com/xo-lang/gcp v0.1.0\n".bytes())?
    os.fs.write("${svc.dir}/models.xo", m.models.bytes())?
    os.fs.write("${svc.dir}/service.xo", m.service.bytes())?
    os.stdio.println("${svc.dir}: ${m.methods} methods, ${m.schemas} types")
    for r in m.report {
      os.stdio.println("  not handled: ${r}")
    }
  }
  if failed > 0 {
    return Err("${failed} documents did not parse")
  }
  Ok(())
}
