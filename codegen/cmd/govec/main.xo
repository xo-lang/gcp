// The Go vectors' command, run from the repository root:
//   xo run ./codegen/cmd/govec -- go <google.golang.org/api dir> <module dir> <out dir>
// writes the Go program for a module (main.go, go.mod) into <out dir>;
//   xo run ./codegen/cmd/govec -- xo <google.golang.org/api dir> <module dir> <go output>
// writes <module dir>/govectors_test.xo from that program's output
// (codegen/gen/vectors.xo).

use std/json
use std/toml
use github.com/xo-lang/gcp/codegen/gen

struct Service {
  pub dir: Str
  pub package: Str
  pub doc: Str
  pub blocked: Str = ""
} derive Json

struct Services {
  pub go_version: Str
  pub service: List[Service]
} derive Json

fn main(os: Os) -> () ! Error {
  let args = os.env.args()
  if args.len() != 4 || (args[0] != "go" && args[0] != "xo") {
    return Err("usage: govec go|xo <google.golang.org/api dir> <module dir> <out dir | go output>")
  }
  let services = toml.decode[Services](os.fs.read_text("codegen/services.toml")?)?
  let dir = args[2]
  let svc = services.service.filter(fn(s: Service) -> Bool { s.dir == dir }).get(0) ?? return Err("no row for ${dir} in codegen/services.toml")
  let doc = json.parse_value(os.fs.read_text("${args[1]}/${svc.dir}/${svc.doc}")?) ?? e => return Err(e.display())
  let m = gen.generate(doc, "")
  let calls = gen.vector_calls(m)
  // Go's generated source, for the methods and options it has
  var go_src = ""
  for f in os.fs.walk("${args[1]}/${svc.dir}")? {
    if !f.is_dir && f.name.ends_with("-gen.go") && f.path == "${args[1]}/${svc.dir}/${f.name}" {
      // every file: compute/v1 is compute-gen.go, compute2-gen.go, ...
      go_src = go_src + os.fs.read_text(f.path)?
    }
  }
  if args[0] == "go" {
    let out = args[3]
    os.fs.create_dir_all(out)?
    let header = "// Code generated by xo-lang/gcp codegen/cmd/govec for google.golang.org/api ${services.go_version} ${svc.dir}; DO NOT EDIT.\n"
    os.fs.write("${out}/main.go", gen.go_program(doc, m, "google.golang.org/api/${svc.dir}", header, os.fs.read_text("codegen/govec/prelude.go.txt")?, go_src).bytes())?
    os.fs.write("${out}/go.mod", "module govectors\n\ngo 1.25.0\n\nrequire google.golang.org/api ${services.go_version}\n".bytes())?
    let missing = calls.filter(fn(i: gen.MInfo) -> Bool { !gen.go_has(go_src, i) }).map(fn(i: gen.MInfo) -> Str { i.id })
    os.stdio.println("${svc.dir}: ${calls.len() - missing.len()} calls of ${m.infos.len()} methods")
    if !missing.is_empty() {
      os.stdio.println("${svc.dir}: not in Go's package: ${missing.join(", ")}")
    }
    return Ok(())
  }
  if calls.is_empty() {
    // nothing to call: no test (a module of models only)
    os.stdio.println("${svc.dir}: 0 vector tests")
    return Ok(())
  }
  let go_out = os.fs.read_text(args[3])?
  let root = gen.str_of(doc.get("rootUrl"))
  let base = if root != "" { root } else { gen.str_of(doc.get("baseUrl")) }
  let header = "// Generated from the output of a local Go program that calls every\n// method of google.golang.org/api ${services.go_version} ${svc.dir} with every argument and\n// optional parameter set, against a fake transport (no network); do not\n// edit (codegen/cmd/govec). Each test makes the same call here and\n// compares the request, the response served and the result.\n"
  os.fs.write("${dir}/govectors_test.xo", gen.vectors_test(doc, m, go_out, header, base, go_src).bytes())?
  os.stdio.println("${svc.dir}: ${calls.len()} vector tests")
  Ok(())
}
