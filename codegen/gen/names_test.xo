test "Go's depunct, initialCap and validGoIdentifer" {
  expect(initial_cap("bucketAccessControls")) == "BucketAccessControls"
  expect(initial_cap(".projects.locationsService")) == "ProjectsLocationsService"
  expect(initial_cap("Bucket.lifecycle.rule")) == "BucketLifecycleRule"
  expect(initial_cap("x-goog-foo_bar")) == "XGoogFooBar"
  expect(initial_cap("a__b")) == "A__b"
  expect(initial_cap("\$ref")) == "Ref"
  expect(valid_go_ident("type")) == "type_"
  expect(valid_go_ident("project")) == "project"
}

test "names in Xo style" {
  expect(snake("IfMetagenerationMatch")) == "if_metageneration_match"
  expect(snake("IPAddress")) == "ip_address"
  expect(snake("maxResults")) == "max_results"
  expect(snake("VirtualMachineScaleSetVMs")) == "virtual_machine_scale_set_vms"
  expect(snake("X509Cert")) == "x509_cert"
  expect(snake("Type")) == "type_"
  expect(snake("1x1")) == "n1x1"
  expect(type_name("Bucket")) == "Bucket"
  expect(type_name("Status")) == "Status"
  expect(type_name("Duration")) == "DurationModel"
  expect(type_name("Value")) == "ValueModel"
}

test "the name pool" {
  var p = Pool{}
  expect(p.get("Call")) == "Call"
  expect(p.get("Call")) == "Call1"
  expect(p.get("Call")) == "Call2"
}
