test "Go's curationpartners.curators.curatedPackages.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"curatedPackages\":[{\"accessSettings\":{},\"createTime\":\"s-createtime\",\"curationFeeVisibility\":\"s-curationfeevisibility\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"feeCpm\":{\"currencyCode\":\"s-currencycode\",\"nanos\":7,\"units\":\"7\"},\"floorPriceCpm\":{\"currencyCode\":\"s-currencycode\",\"nanos\":7,\"units\":\"7\"},\"millipercentOfMediaFee\":\"7\",\"name\":\"s-name\",\"state\":\"s-state\",\"targeting\":{\"includedAcceleratedMobilePageType\":\"s-includedacceleratedmobilepagetype\",\"includedCreativeFormat\":\"s-includedcreativeformat\",\"includedEnvironment\":\"s-includedenvironment\",\"includedRewardedType\":\"s-includedrewardedtype\",\"minimumPredictedClickThroughRatePercentageMillis\":\"7\",\"minimumPredictedViewabilityPercentage\":\"7\"},\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"curatedPackages\":[{\"accessSettings\":{},\"createTime\":\"s-createtime\",\"curationFeeVisibility\":\"s-curationfeevisibility\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"feeCpm\":{\"currencyCode\":\"s-currencycode\",\"nanos\":7,\"units\":\"7\"},\"floorPriceCpm\":{\"currencyCode\":\"s-currencycode\",\"nanos\":7,\"units\":\"7\"},\"millipercentOfMediaFee\":\"7\",\"name\":\"s-name\",\"state\":\"s-state\",\"targeting\":{\"includedAcceleratedMobilePageType\":\"s-includedacceleratedmobilepagetype\",\"includedCreativeFormat\":\"s-includedcreativeformat\",\"includedEnvironment\":\"s-includedenvironment\",\"includedRewardedType\":\"s-includedrewardedtype\",\"minimumPredictedClickThroughRatePercentageMillis\":\"7\",\"minimumPredictedViewabilityPercentage\":\"7\"},\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL curationpartners.curators.curatedPackages.list pages")
  var p = svc.curators.curated_packages.list_pages("id1/ x", options: CuratorsCuratedPackagesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_5)
}

