test "Go's firebasehosting.sites.releases.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"releases\":[{\"message\":\"s-message\",\"name\":\"s-name\",\"releaseTime\":\"s-releasetime\",\"releaseUser\":{\"email\":\"s-email\",\"imageUrl\":\"s-imageurl\"},\"type\":\"s-type\",\"version\":{\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"fileCount\":\"7\",\"finalizeTime\":\"s-finalizetime\",\"name\":\"s-name\",\"status\":\"s-status\",\"versionBytes\":\"7\"}}]}")
  gv_queue(f, "{\"releases\":[{\"message\":\"s-message\",\"name\":\"s-name\",\"releaseTime\":\"s-releasetime\",\"releaseUser\":{\"email\":\"s-email\",\"imageUrl\":\"s-imageurl\"},\"type\":\"s-type\",\"version\":{\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"fileCount\":\"7\",\"finalizeTime\":\"s-finalizetime\",\"name\":\"s-name\",\"status\":\"s-status\",\"versionBytes\":\"7\"}}]}")
  gv_note(f, "CALL firebasehosting.sites.releases.list pages")
  var p = svc.sites.releases.list_pages("id1/ x", options: SitesReleasesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_70)
}

