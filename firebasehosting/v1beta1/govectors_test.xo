  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"channels\":[{\"createTime\":\"s-createtime\",\"expireTime\":\"s-expiretime\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"release\":{\"message\":\"s-message\",\"name\":\"s-name\",\"releaseTime\":\"s-releasetime\",\"type\":\"s-type\"},\"retainedReleaseCount\":7,\"ttl\":\"s-ttl\",\"updateTime\":\"s-updatetime\",\"url\":\"s-url\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"channels\":[{\"createTime\":\"s-createtime\",\"expireTime\":\"s-expiretime\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"release\":{\"message\":\"s-message\",\"name\":\"s-name\",\"releaseTime\":\"s-releasetime\",\"type\":\"s-type\"},\"retainedReleaseCount\":7,\"ttl\":\"s-ttl\",\"updateTime\":\"s-updatetime\",\"url\":\"s-url\"}]}")
  gv_note(f, "CALL firebasehosting.projects.sites.channels.list pages")
  var p = svc.projects.sites.channels.list_pages("id1/ x", options: ProjectsSitesChannelsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
