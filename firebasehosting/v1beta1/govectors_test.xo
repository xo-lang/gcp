test "Go's firebasehosting.projects.sites.versions.files.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"files\":[{\"hash\":\"s-hash\",\"path\":\"s-path\",\"status\":\"s-status\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"files\":[{\"hash\":\"s-hash\",\"path\":\"s-path\",\"status\":\"s-status\"}]}")
  gv_note(f, "CALL firebasehosting.projects.sites.versions.files.list pages")
  var p = svc.projects.sites.versions.files.list_pages("id1/ x", options: ProjectsSitesVersionsFilesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), status: Some("s-status"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_48)
}

