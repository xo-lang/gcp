use std/json

const GV_HOST: Str = "https://appsmarket.googleapis.com"

const GO_0: List[Str] = [
  "CALL appsmarket.customerLicense.get",
  "REQ GET https://appsmarket.googleapis.com/appsmarket/v2/customerLicense/id1%2F%20x/id2%2F%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"applicationId\":\"s-applicationid\",\"customerId\":\"s-customerid\",\"editions\":[{\"assignedSeats\":7,\"editionId\":\"s-editionid\",\"seatCount\":7}],\"id\":\"s-id\",\"kind\":\"s-kind\",\"state\":\"s-state\"}",
  "OUT: {\"applicationId\":\"s-applicationid\",\"customerId\":\"s-customerid\",\"editions\":[{\"assignedSeats\":7,\"editionId\":\"s-editionid\",\"seatCount\":7}],\"id\":\"s-id\",\"kind\":\"s-kind\",\"state\":\"s-state\"}",
]

test "Go's appsmarket.customerLicense.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"applicationId\":\"s-applicationid\",\"customerId\":\"s-customerid\",\"editions\":[{\"assignedSeats\":7,\"editionId\":\"s-editionid\",\"seatCount\":7}],\"id\":\"s-id\",\"kind\":\"s-kind\",\"state\":\"s-state\"}")
  gv_note(f, "CALL appsmarket.customerLicense.get")
  match svc.customer_license.get("id1/ x", "id2/ x", options: CustomerLicenseGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

