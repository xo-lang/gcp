  gv_note(f, "CALL libraryagent.shelves.list pages")
  var p = svc.shelves.list_pages(options: ShelvesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
