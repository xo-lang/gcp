test "Go's analyticsadmin.properties.keyEvents.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"keyEvents\":[{\"countingMethod\":\"s-countingmethod\",\"createTime\":\"s-createtime\",\"custom\":true,\"defaultValue\":{\"currencyCode\":\"s-currencycode\",\"numericValue\":1.5},\"deletable\":true,\"eventName\":\"s-eventname\",\"name\":\"s-name\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"keyEvents\":[{\"countingMethod\":\"s-countingmethod\",\"createTime\":\"s-createtime\",\"custom\":true,\"defaultValue\":{\"currencyCode\":\"s-currencycode\",\"numericValue\":1.5},\"deletable\":true,\"eventName\":\"s-eventname\",\"name\":\"s-name\"}]}")
  gv_note(f, "CALL analyticsadmin.properties.keyEvents.list pages")
  var p = svc.properties.key_events.list_pages("id1/ x", options: PropertiesKeyEventsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_65)
}

