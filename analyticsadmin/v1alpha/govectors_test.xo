test "Go's analyticsadmin.properties.audiences.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"audiences\":[{\"adsPersonalizationEnabled\":true,\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"eventTrigger\":{\"eventName\":\"s-eventname\",\"logCondition\":\"s-logcondition\"},\"exclusionDurationMode\":\"s-exclusiondurationmode\",\"membershipDurationDays\":7,\"name\":\"s-name\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"audiences\":[{\"adsPersonalizationEnabled\":true,\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"eventTrigger\":{\"eventName\":\"s-eventname\",\"logCondition\":\"s-logcondition\"},\"exclusionDurationMode\":\"s-exclusiondurationmode\",\"membershipDurationDays\":7,\"name\":\"s-name\"}]}")
  gv_note(f, "CALL analyticsadmin.properties.audiences.list pages")
  var p = svc.properties.audiences.list_pages("id1/ x", options: PropertiesAudiencesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_61)
}

