test "Go's analyticsadmin.properties.dataStreams.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"dataStreams\":[{\"androidAppStreamData\":{\"firebaseAppId\":\"s-firebaseappid\",\"packageName\":\"s-packagename\"},\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"iosAppStreamData\":{\"bundleId\":\"s-bundleid\",\"firebaseAppId\":\"s-firebaseappid\"},\"name\":\"s-name\",\"type\":\"s-type\",\"updateTime\":\"s-updatetime\",\"webStreamData\":{\"defaultUri\":\"s-defaulturi\",\"firebaseAppId\":\"s-firebaseappid\",\"measurementId\":\"s-measurementid\"}}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"dataStreams\":[{\"androidAppStreamData\":{\"firebaseAppId\":\"s-firebaseappid\",\"packageName\":\"s-packagename\"},\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"iosAppStreamData\":{\"bundleId\":\"s-bundleid\",\"firebaseAppId\":\"s-firebaseappid\"},\"name\":\"s-name\",\"type\":\"s-type\",\"updateTime\":\"s-updatetime\",\"webStreamData\":{\"defaultUri\":\"s-defaulturi\",\"firebaseAppId\":\"s-firebaseappid\",\"measurementId\":\"s-measurementid\"}}]}")
  gv_note(f, "CALL analyticsadmin.properties.dataStreams.list pages")
  var p = svc.properties.data_streams.list_pages("id1/ x", options: PropertiesDataStreamsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_106)
}

