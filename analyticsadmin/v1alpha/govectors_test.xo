  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"properties\":[{\"account\":\"s-account\",\"createTime\":\"s-createtime\",\"currencyCode\":\"s-currencycode\",\"deleteTime\":\"s-deletetime\",\"displayName\":\"s-displayname\",\"expireTime\":\"s-expiretime\",\"industryCategory\":\"s-industrycategory\",\"name\":\"s-name\",\"parent\":\"s-parent\",\"propertyType\":\"s-propertytype\",\"serviceLevel\":\"s-servicelevel\",\"timeZone\":\"s-timezone\",\"updateTime\":\"s-updatetime\"}]}")
  gv_queue(f, "{\"properties\":[{\"account\":\"s-account\",\"createTime\":\"s-createtime\",\"currencyCode\":\"s-currencycode\",\"deleteTime\":\"s-deletetime\",\"displayName\":\"s-displayname\",\"expireTime\":\"s-expiretime\",\"industryCategory\":\"s-industrycategory\",\"name\":\"s-name\",\"parent\":\"s-parent\",\"propertyType\":\"s-propertytype\",\"serviceLevel\":\"s-servicelevel\",\"timeZone\":\"s-timezone\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL analyticsadmin.properties.list pages")
  var p = svc.properties.list_pages(options: PropertiesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), show_deleted: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_33)
}

