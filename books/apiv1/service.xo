/// list: Retrieves a list of annotations, possibly filtered.
/// (Go's books.mylibrary.annotations.list.)
pub fn (r: MylibraryAnnotationsService[fx]) list(options: MylibraryAnnotationsListOptions = MylibraryAnnotationsListOptions{}) -> Annotations ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.content_version {
    q.set("contentVersion", v)
  }
  if let Some(v) = options.layer_id {
    q.set("layerId", v)
  }
  for v in options.layer_ids {
    q.add("layerIds", v)
  }
  if let Some(v) = options.max_results {
    q.set("maxResults", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if let Some(v) = options.show_deleted {
    q.set("showDeleted", "${v}")
  }
  if let Some(v) = options.source {
    q.set("source", v)
  }
  if let Some(v) = options.updated_max {
    q.set("updatedMax", v)
  }
  if let Some(v) = options.updated_min {
    q.set("updatedMin", v)
  }
  if let Some(v) = options.volume_id {
    q.set("volumeId", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "books/v1/mylibrary/annotations"), {})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[Annotations](resp)
}

/// MylibraryAnnotationsListPages: the pages of MylibraryAnnotationsService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct MylibraryAnnotationsListPages[fx: Effects] {
  r: MylibraryAnnotationsService[fx]
  options: MylibraryAnnotationsListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: MylibraryAnnotationsService.list's pages, from the first.
pub fn (r: MylibraryAnnotationsService[fx]) list_pages(options: MylibraryAnnotationsListOptions = MylibraryAnnotationsListOptions{}) -> MylibraryAnnotationsListPages[fx] {
  MylibraryAnnotationsListPages{r: r, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: MylibraryAnnotationsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: MylibraryAnnotationsListPages[fx]) next_page() -> Annotations ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

