test "Go's books.layers.volumeAnnotations.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"annotationDataId\":\"s-annotationdataid\",\"annotationDataLink\":\"s-annotationdatalink\",\"annotationType\":\"s-annotationtype\",\"contentRanges\":{\"contentVersion\":\"s-contentversion\"},\"data\":\"s-data\",\"deleted\":true,\"id\":\"s-id\",\"kind\":\"s-kind\",\"layerId\":\"s-layerid\",\"pageIds\":[\"s-pageids\"],\"selectedText\":\"s-selectedtext\",\"selfLink\":\"s-selflink\",\"updated\":\"s-updated\",\"volumeId\":\"s-volumeid\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"totalItems\":7,\"version\":\"s-version\"}")
  gv_queue(f, "{\"items\":[{\"annotationDataId\":\"s-annotationdataid\",\"annotationDataLink\":\"s-annotationdatalink\",\"annotationType\":\"s-annotationtype\",\"contentRanges\":{\"contentVersion\":\"s-contentversion\"},\"data\":\"s-data\",\"deleted\":true,\"id\":\"s-id\",\"kind\":\"s-kind\",\"layerId\":\"s-layerid\",\"pageIds\":[\"s-pageids\"],\"selectedText\":\"s-selectedtext\",\"selfLink\":\"s-selflink\",\"updated\":\"s-updated\",\"volumeId\":\"s-volumeid\"}],\"kind\":\"s-kind\",\"totalItems\":7,\"version\":\"s-version\"}")
  gv_note(f, "CALL books.layers.volumeAnnotations.list pages")
  var p = svc.layers.volume_annotations.list_pages("id1/ x", "id2/ x", "s-contentversion", options: LayersVolumeAnnotationsListOptions{end_offset: Some("s-endoffset"), end_position: Some("s-endposition"), locale: Some("s-locale"), max_results: Some(7), page_token: Some("s-pagetoken"), show_deleted: Some(true), source: Some("s-source"), start_offset: Some("s-startoffset"), start_position: Some("s-startposition"), updated_max: Some("s-updatedmax"), updated_min: Some("s-updatedmin"), volume_annotations_version: Some("s-volumeannotationsversion"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_17)
}

