  "REQ POST https://books.googleapis.com/books/v1/promooffer/dismiss?alt=json&androidId=s-androidid&device=s-device&fields=kind%2Cid&manufacturer=s-manufacturer&model=s-model&offerId=s-offerid&prettyPrint=false&product=s-product&serial=s-serial",
  "  H x-extra=v1",
  "  B ",
  "  SERVED 200 {}",
  "OUT: {}",
]

test "Go's books.promooffer.dismiss" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{}")
  gv_note(f, "CALL books.promooffer.dismiss")
  match svc.promooffer.dismiss(options: PromoofferDismissOptions{android_id: Some("s-androidid"), device: Some("s-device"), manufacturer: Some("s-manufacturer"), model: Some("s-model"), offer_id: Some("s-offerid"), product: Some("s-product"), serial: Some("s-serial"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_44)
}

