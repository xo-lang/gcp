test "Go's books.layers.annotationData.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"annotationType\":\"s-annotationtype\",\"data\":{\"kind\":\"s-kind\"},\"encodedData\":\"YWI=\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"layerId\":\"s-layerid\",\"selfLink\":\"s-selflink\",\"updated\":\"s-updated\",\"volumeId\":\"s-volumeid\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"totalItems\":7}")
  gv_queue(f, "{\"items\":[{\"annotationType\":\"s-annotationtype\",\"data\":{\"kind\":\"s-kind\"},\"encodedData\":\"YWI=\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"layerId\":\"s-layerid\",\"selfLink\":\"s-selflink\",\"updated\":\"s-updated\",\"volumeId\":\"s-volumeid\"}],\"kind\":\"s-kind\",\"totalItems\":7}")
  gv_note(f, "CALL books.layers.annotationData.list pages")
  var p = svc.layers.annotation_data.list_pages("id1/ x", "id2/ x", "s-contentversion", options: LayersAnnotationDataListOptions{annotation_data_id: ["s-annotationdataid"], h: Some(7), locale: Some("s-locale"), max_results: Some(7), page_token: Some("s-pagetoken"), scale: Some(7), source: Some("s-source"), updated_max: Some("s-updatedmax"), updated_min: Some("s-updatedmin"), w: Some(7), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_14)
}

