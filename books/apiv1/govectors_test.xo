const GO_53: List[Str] = [
  "CALL books.volumes.recommended.rate",
  "REQ POST https://books.googleapis.com/books/v1/volumes/recommended/rate?alt=json&fields=kind%2Cid&locale=s-locale&prettyPrint=false&rating=s-rating&source=s-source&volumeId=s-volumeid",
  "  H x-extra=v1",
  "  B ",
  "  SERVED 200 {\"consistency_token\":\"s-consistency_token\"}",
  "OUT: {\"consistency_token\":\"s-consistency_token\"}",
]

test "Go's books.volumes.recommended.rate" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"consistency_token\":\"s-consistency_token\"}")
  gv_note(f, "CALL books.volumes.recommended.rate")
  match svc.volumes.recommended.rate("s-rating", "s-volumeid", options: VolumesRecommendedRateOptions{locale: Some("s-locale"), source: Some("s-source"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_53)
}

