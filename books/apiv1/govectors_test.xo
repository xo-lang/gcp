  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"afterSelectedText\":\"s-afterselectedtext\",\"beforeSelectedText\":\"s-beforeselectedtext\",\"clientVersionRanges\":{\"contentVersion\":\"s-contentversion\"},\"created\":\"s-created\",\"currentVersionRanges\":{\"contentVersion\":\"s-contentversion\"},\"data\":\"s-data\",\"deleted\":true,\"highlightStyle\":\"s-highlightstyle\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"layerId\":\"s-layerid\",\"layerSummary\":{\"allowedCharacterCount\":7,\"limitType\":\"s-limittype\",\"remainingCharacterCount\":7},\"pageIds\":[\"s-pageids\"],\"selectedText\":\"s-selectedtext\",\"selfLink\":\"s-selflink\",\"updated\":\"s-updated\",\"volumeId\":\"s-volumeid\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"totalItems\":7}")
  gv_queue(f, "{\"items\":[{\"afterSelectedText\":\"s-afterselectedtext\",\"beforeSelectedText\":\"s-beforeselectedtext\",\"clientVersionRanges\":{\"contentVersion\":\"s-contentversion\"},\"created\":\"s-created\",\"currentVersionRanges\":{\"contentVersion\":\"s-contentversion\"},\"data\":\"s-data\",\"deleted\":true,\"highlightStyle\":\"s-highlightstyle\",\"id\":\"s-id\",\"kind\":\"s-kind\",\"layerId\":\"s-layerid\",\"layerSummary\":{\"allowedCharacterCount\":7,\"limitType\":\"s-limittype\",\"remainingCharacterCount\":7},\"pageIds\":[\"s-pageids\"],\"selectedText\":\"s-selectedtext\",\"selfLink\":\"s-selflink\",\"updated\":\"s-updated\",\"volumeId\":\"s-volumeid\"}],\"kind\":\"s-kind\",\"totalItems\":7}")
  gv_note(f, "CALL books.mylibrary.annotations.list pages")
  var p = svc.mylibrary.annotations.list_pages(options: MylibraryAnnotationsListOptions{content_version: Some("s-contentversion"), layer_id: Some("s-layerid"), layer_ids: ["s-layerids"], max_results: Some(7), page_token: Some("s-pagetoken"), show_deleted: Some(true), source: Some("s-source"), updated_max: Some("s-updatedmax"), updated_min: Some("s-updatedmin"), volume_id: Some("s-volumeid"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_26)
}

