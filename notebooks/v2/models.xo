  /// API version used to start the operation.
  pub api_version as "apiVersion,omitempty": Str = ""
  /// The time the operation was created.
  pub create_time as "createTime,omitempty": Str = ""
  /// The time the operation finished running.
  pub end_time as "endTime,omitempty": Str = ""
  /// API endpoint name of this operation.
  pub endpoint as "endpoint,omitempty": Str = ""
  /// Identifies whether the user has requested cancellation of the operation. Operations that have successfully been cancelled have google.longrunning.Operation.error value with a google.rpc.Status.code of `1`, corresponding to `Code.CANCELLED`.
  pub requested_cancellation as "requestedCancellation,omitempty": Bool = false
  /// Human-readable status of the operation, if any.
  pub status_message as "statusMessage,omitempty": Str = ""
  /// Server-defined resource path for the target of the operation.
  pub target_ as "target,omitempty": Str = ""
  /// Name of the verb executed by the operation.
  pub verb as "verb,omitempty": Str = ""
} derive Json

/// Policy: An Identity and Access Management (IAM) policy, which specifies access controls for Google Cloud resources. A `Policy` is a collection of `bindings`. A `binding` binds one or more `members`, or principals, to a single `role`. Principals can be user accounts, service accounts, Google groups, and domains (such as G Suite). A `role` is a named list of permissions; each `role` can be an IAM predefined role or a user-created custom role. For some types of Google Cloud resources, a `binding` can also specify a `condition`, which is a logical expression that allows access to a resource only if the expression evaluates to `true`. A condition can add constraints based on attributes of the request, the resource, or both. To learn which resources support conditions in their IAM policies, see the [IAM documentation](https://cloud.google.com/iam/help/conditions/resource-policies). **JSON example:** ``` { "bindings": [ { "role": "roles/resourcemanager.organizationAdmin", "members": [ "user:mike@example.com", "group:admins@example.com", "domain:google.com", "serviceAccount:my-project-id@appspot.gserviceaccount.com" ] }, { "role": "roles/resourcemanager.organizationViewer", "members": [ "user:eve@example.com" ], "condition": { "title": "expirable access", "description": "Does not grant access after Sep 2020", "expression": "request.time < timestamp('2020-10-01T00:00:00.000Z')", } } ], "etag": "BwWWja0YfJA=", "version": 3 } ``` **YAML example:** ``` bindings: - members: - user:mike@example.com - group:admins@example.com - domain:google.com - serviceAccount:my-project-id@appspot.gserviceaccount.com role: roles/resourcemanager.organizationAdmin - members: - user:eve@example.com role: roles/resourcemanager.organizationViewer condition: title: expirable access description: Does not grant access after Sep 2020 expression: request.time < timestamp('2020-10-01T00:00:00.000Z') etag: BwWWja0YfJA= version: 3 ``` For a description of IAM and its features, see the [IAM documentation](https://cloud.google.com/iam/docs/).
pub struct Policy {
  /// Associates a list of `members`, or principals, with a `role`. Optionally, may specify a `condition` that determines how and when the `bindings` are applied. Each of the `bindings` must contain at least one principal. The `bindings` in a `Policy` can refer to up to 1,500 principals; up to 250 of these principals can be Google groups. Each occurrence of a principal counts towards these limits. For example, if the `bindings` grant 50 different roles to `user:alice@example.com`, and not to any other principal, then you can add another 1,450 principals to the `bindings` in the `Policy`.
  pub bindings as "bindings,omitempty": List[Binding] = []
  /// `etag` is used for optimistic concurrency control as a way to help prevent simultaneous updates of a policy from overwriting each other. It is strongly suggested that systems make use of the `etag` in the read-modify-write cycle to perform policy updates in order to avoid race conditions: An `etag` is returned in the response to `getIamPolicy`, and systems are expected to put that etag in the request to `setIamPolicy` to ensure that their change will be applied to the same version of the policy. **Important:** If you use IAM Conditions, you must include the `etag` field whenever you call `setIamPolicy`. If you omit this field, then IAM allows you to overwrite a version `3` policy with a version `1` policy, and all of the conditions in the version `3` policy are lost.
  pub etag as "etag,omitempty": Str = ""
  /// Specifies the format of the policy. Valid values are `0`, `1`, and `3`. Requests that specify an invalid value are rejected. Any operation that affects conditional role bindings must specify version `3`. This requirement applies to the following operations: * Getting a policy that includes a conditional role binding * Adding a conditional role binding to a policy * Changing a conditional role binding in a policy * Removing any role binding, with or without a condition, from a policy that includes conditions **Important:** If you use IAM Conditions, you must include the `etag` field whenever you call `setIamPolicy`. If you omit this field, then IAM allows you to overwrite a version `3` policy with a version `1` policy, and all of the conditions in the version `3` policy are lost. If a policy does not include any conditions, operations on that policy may specify any valid version or leave the field unset. To learn which resources support conditions in their IAM policies, see the [IAM documentation](https://cloud.google.com/iam/help/conditions/resource-policies).
  pub version as "version,omitempty": Int = 0
} derive Json

/// ReportInstanceInfoSystemRequest: Request for notebook instances to report information to Notebooks API.
pub struct ReportInstanceInfoSystemRequest {
  /// Required. The Event to be reported.
  pub event as "event,omitempty": Event? = None
  /// Required. The VM hardware token for authenticating the VM. https://cloud.google.com/compute/docs/instances/verifying-instance-identity
  pub vm_id as "vmId,omitempty": Str = ""
} derive Json

/// ReservationAffinity: A reservation that an instance can consume from.
pub struct ReservationAffinity {
  /// Required. Specifies the type of reservation from which this instance can consume resources: RESERVATION_ANY (default), RESERVATION_SPECIFIC, or RESERVATION_NONE. See Consuming reserved instances for examples.
  pub consume_reservation_type as "consumeReservationType,omitempty": Str = ""
  /// Optional. Corresponds to the label key of a reservation resource. To target a RESERVATION_SPECIFIC by name, use compute.googleapis.com/reservation-name as the key and specify the name of your reservation as its value.
  pub key as "key,omitempty": Str = ""
  /// Optional. Corresponds to the label values of a reservation resource. This can be either a name to a reservation in the same project or "projects/different-project/reservations/some-reservation-name" to target a shared reservation in the same zone but in a different project.
  pub values as "values,omitempty": List[Str] = []
} derive Json

/// ResetInstanceRequest: Request for resetting a notebook instance
pub struct ResetInstanceRequest {} derive Json

/// ResizeDiskRequest: Request for resizing the notebook instance disks
pub struct ResizeDiskRequest {
  /// Required. The boot disk to be resized. Only disk_size_gb will be used.
  pub boot_disk as "bootDisk,omitempty": BootDisk? = None
  /// Required. The data disk to be resized. Only disk_size_gb will be used.
  pub data_disk as "dataDisk,omitempty": DataDisk? = None
} derive Json

/// RestoreInstanceRequest: Request for restoring the notebook instance from a BackupSource.
pub struct RestoreInstanceRequest {
  /// Snapshot to be used for restore.
  pub snapshot as "snapshot,omitempty": Snapshot? = None
} derive Json

/// RollbackInstanceRequest: Request for rollbacking a notebook instance
pub struct RollbackInstanceRequest {
  /// Required. Output only. Revision Id
  pub revision_id as "revisionId,omitempty": Str = ""
  /// Required. The snapshot for rollback. Example: "projects/test-project/global/snapshots/krwlzipynril".
  pub target_snapshot as "targetSnapshot,omitempty": Str = ""
} derive Json

/// ServiceAccount: A service account that acts as an identity.
pub struct ServiceAccount {
  /// Optional. Email address of the service account.
  pub email as "email,omitempty": Str = ""
  /// Output only. The list of scopes to be made available for this service account. Set by the CLH to https://www.googleapis.com/auth/cloud-platform
  pub scopes as "scopes,omitempty": List[Str] = []
} derive Json

/// SetIamPolicyRequest: Request message for `SetIamPolicy` method.
pub struct SetIamPolicyRequest {
  /// REQUIRED: The complete policy to be applied to the `resource`. The size of the policy is limited to a few 10s of KB. An empty policy is a valid policy but certain Google Cloud services (such as Projects) might reject them.
  pub policy as "policy,omitempty": Policy? = None
} derive Json

/// ShieldedInstanceConfig: A set of Shielded Instance options. See [Images using supported Shielded VM features](https://cloud.google.com/compute/docs/instances/modifying-shielded-vm). Not all combinations are valid.
pub struct ShieldedInstanceConfig {
  /// Optional. Defines whether the VM instance has integrity monitoring enabled. Enables monitoring and attestation of the boot integrity of the VM instance. The attestation is performed against the integrity policy baseline. This baseline is initially derived from the implicitly trusted boot image when the VM instance is created.
  pub enable_integrity_monitoring as "enableIntegrityMonitoring,omitempty": Bool = false
  /// Optional. Defines whether the VM instance has Secure Boot enabled. Secure Boot helps ensure that the system only runs authentic software by verifying the digital signature of all boot components, and halting the boot process if signature verification fails. Disabled by default.
  pub enable_secure_boot as "enableSecureBoot,omitempty": Bool = false
  /// Optional. Defines whether the VM instance has the vTPM enabled.
  pub enable_vtpm as "enableVtpm,omitempty": Bool = false
} derive Json

/// Snapshot: Snapshot represents the snapshot of the data disk used to restore the Workbench Instance from. Refers to: compute/v1/projects/{project_id}/global/snapshots/{snapshot_id}
pub struct Snapshot {
  /// Required. The project ID of the snapshot.
  pub project_id as "projectId,omitempty": Str = ""
  /// Required. The ID of the snapshot.
  pub snapshot_id as "snapshotId,omitempty": Str = ""
} derive Json

/// StartInstanceRequest: Request for starting a notebook instance
pub struct StartInstanceRequest {} derive Json

/// Status: The `Status` type defines a logical error model that is suitable for different programming environments, including REST APIs and RPC APIs. It is used by [gRPC](https://github.com/grpc). Each `Status` message contains three pieces of data: error code, error message, and error details. You can find out more about this error model and how to work with it in the [API Design Guide](https://cloud.google.com/apis/design/errors).
pub struct Status {
  /// The status code, which should be an enum value of google.rpc.Code.
  pub code as "code,omitempty": Int = 0
  /// A list of messages that carry the error details. There is a common set of message types for APIs to use.
  pub details as "details,omitempty": List[json.Value] = []
  /// A developer-facing error message, which should be in English. Any user-facing error message should be localized and sent in the google.rpc.Status.details field, or localized by the client.
  pub message as "message,omitempty": Str = ""
} derive Json

/// StopInstanceRequest: Request for stopping a notebook instance
pub struct StopInstanceRequest {} derive Json

/// SupportedValues: SupportedValues represents the values supported by the configuration.
pub struct SupportedValues {
  /// Output only. The accelerator types supported by WbI.
  pub accelerator_types as "acceleratorTypes,omitempty": List[Str] = []
  /// Output only. The machine types supported by WbI.
  pub machine_types as "machineTypes,omitempty": List[Str] = []
} derive Json

/// TestIamPermissionsRequest: Request message for `TestIamPermissions` method.
pub struct TestIamPermissionsRequest {
  /// The set of permissions to check for the `resource`. Permissions with wildcards (such as `*` or `storage.*`) are not allowed. For more information see [IAM Overview](https://cloud.google.com/iam/docs/overview#permissions).
  pub permissions as "permissions,omitempty": List[Str] = []
} derive Json

/// TestIamPermissionsResponse: Response message for `TestIamPermissions` method.
pub struct TestIamPermissionsResponse {
  /// A subset of `TestPermissionsRequest.permissions` that the caller is allowed.
  pub permissions as "permissions,omitempty": List[Str] = []
} derive Json

/// UpgradeHistoryEntry: The entry of VM image upgrade history.
pub struct UpgradeHistoryEntry {
  /// Optional. Action. Rolloback or Upgrade.
  pub action as "action,omitempty": Str = ""
  /// Optional. The container image before this instance upgrade.
  pub container_image as "containerImage,omitempty": Str = ""
  /// Immutable. The time that this instance upgrade history entry is created.
  pub create_time as "createTime,omitempty": Str = ""
  /// Optional. The framework of this notebook instance.
  pub framework as "framework,omitempty": Str = ""
  /// Optional. The snapshot of the boot disk of this notebook instance before upgrade.
  pub snapshot as "snapshot,omitempty": Str = ""
  /// Output only. The state of this instance upgrade history entry.
  pub state as "state,omitempty": Str = ""
  /// Optional. Target VM Version, like m63.
  pub target_version as "targetVersion,omitempty": Str = ""
  /// Optional. The version of the notebook instance before this upgrade.
  pub version as "version,omitempty": Str = ""
  /// Optional. The VM image before this instance upgrade.
  pub vm_image as "vmImage,omitempty": Str = ""
} derive Json

/// UpgradeInstanceRequest: Request for upgrading a notebook instance
pub struct UpgradeInstanceRequest {
  /// Optional. The Compute Engine image family resource name to upgrade to. Format: `projects/{project_id}/global/images/family/{image_family}` If specified, the instance will be upgraded to the latest image in the specified image family, allowing upgrades across image families. If not specified, the instance will be upgraded to the latest image in its current image family.
  pub image_family as "imageFamily,omitempty": Str = ""
} derive Json

/// UpgradeInstanceSystemRequest: Request for upgrading a notebook instance from within the VM
pub struct UpgradeInstanceSystemRequest {
  /// Required. The VM hardware token for authenticating the VM. https://cloud.google.com/compute/docs/instances/verifying-instance-identity
  pub vm_id as "vmId,omitempty": Str = ""
} derive Json

/// VmImage: Definition of a custom Compute Engine virtual machine image for starting a notebook instance with the environment installed directly on the VM.
pub struct VmImage {
  /// Optional. Use this VM image family to find the image; the newest image in this family will be used.
  pub family as "family,omitempty": Str = ""
  /// Output only. A human-readable description of the image running on the instance (for example, "Debian 11, Python 3.10"), derived at read time from the image release configuration (the source of truth). Set to "Custom" for unrecognized boot-disk images.
  pub image_description as "imageDescription,omitempty": Str = ""
  /// Output only. The ID of the specific Compute Engine VM image the instance is currently running (for example, "workbench-instances-2603-20260918-2130-rc0").
  pub image_id as "imageId,omitempty": Str = ""
  /// Optional. Use VM image name to find the image.
  pub name as "name,omitempty": Str = ""
  /// Required. The name of the Google Cloud project that this VM image belongs to. Format: `{project_id}`
  pub project as "project,omitempty": Str = ""
} derive Json
