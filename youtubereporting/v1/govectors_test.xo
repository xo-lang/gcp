  "  B ",
  "  SERVED 200 {\"nextPageToken\":\"s-nextpagetoken\",\"reportTypes\":[{\"deprecateTime\":\"s-deprecatetime\",\"id\":\"s-id\",\"name\":\"s-name\",\"systemManaged\":true}]}",
  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"reportTypes\":[{\"deprecateTime\":\"s-deprecatetime\",\"id\":\"s-id\",\"name\":\"s-name\",\"systemManaged\":true}]}",
]

test "Go's youtubereporting.reportTypes.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"reportTypes\":[{\"deprecateTime\":\"s-deprecatetime\",\"id\":\"s-id\",\"name\":\"s-name\",\"systemManaged\":true}]}")
  gv_note(f, "CALL youtubereporting.reportTypes.list")
  match svc.report_types.list(options: ReportTypesListOptions{include_system_managed: Some(true), on_behalf_of_content_owner: Some("s-onbehalfofcontentowner"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_7)
}
