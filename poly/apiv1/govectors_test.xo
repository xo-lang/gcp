test "Go's poly.users.likedassets.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"assets\":[{\"authorName\":\"s-authorname\",\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isCurated\":true,\"license\":\"s-license\",\"metadata\":\"s-metadata\",\"name\":\"s-name\",\"presentationParams\":{\"backgroundColor\":\"s-backgroundcolor\",\"colorSpace\":\"s-colorspace\"},\"remixInfo\":{},\"thumbnail\":{\"contentType\":\"s-contenttype\",\"relativePath\":\"s-relativepath\",\"url\":\"s-url\"},\"updateTime\":\"s-updatetime\",\"visibility\":\"s-visibility\"}],\"nextPageToken\":\"s-nextpagetoken\",\"totalSize\":7}")
  gv_queue(f, "{\"assets\":[{\"authorName\":\"s-authorname\",\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"isCurated\":true,\"license\":\"s-license\",\"metadata\":\"s-metadata\",\"name\":\"s-name\",\"presentationParams\":{\"backgroundColor\":\"s-backgroundcolor\",\"colorSpace\":\"s-colorspace\"},\"remixInfo\":{},\"thumbnail\":{\"contentType\":\"s-contenttype\",\"relativePath\":\"s-relativepath\",\"url\":\"s-url\"},\"updateTime\":\"s-updatetime\",\"visibility\":\"s-visibility\"}],\"totalSize\":7}")
  gv_note(f, "CALL poly.users.likedassets.list pages")
  var p = svc.users.likedassets.list_pages("id1/ x", options: UsersLikedassetsListOptions{format: Some("s-format"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_6)
}
