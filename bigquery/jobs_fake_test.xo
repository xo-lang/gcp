// Step 3's printing (jobs, statuses, configurations, rows) as the Go
// oracle prints it (~/xo-lead/notes/aws-43/bigqueryjobs/cases.go).

use std/testing
use github.com/xo-lang/gcp/option

fn err_line(f: Fake, e: BqErr) {
  note(f, "  error ${ids(e.display())}")
  if let Some(a) = e.api() {
    note(f, "  googleapi code=${a.code}")
  }
}

fn tm(t: Time?) -> Str {
  match t {
    Some(x) => rfc3339_nano(x)
    None => "zero"
  }
}

fn names(s: List[FieldSchema]) -> Str { "[${s.map(fn(x) -> Str { "${x.name}:${x.type_}" }).join(" ")}]" }

/// Go's %v of a []string.
fn strs_v(xs: List[Str]) -> Str { "[${xs.join(" ")}]" }

/// Go's %v of a map[string]string.
fn map_v(m: Map[Str, Str]) -> Str { "map[${m.keys().sort().map(fn(k) -> Str { "${k}:${m.get_or_fault(k, "a key")}" }).join(" ")}]" }

fn state_name(s: State) -> Str {
  match s {
    Unspecified => "Unspecified"
    Pending => "Pending"
    Running => "Running"
    Done => "Done"
  }
}

fn fq(t: TableRef) -> Str { "${t.project_id}:${t.dataset_id}.${t.table_id}" }

fn job_line(f: Fake, r: Result[Job[()], BqErr]) -> Job[()]? {
  match r {
    Ok(j) => {
      note(f, "  job ${j.project_id()} ${ids(j.id())} ${j.location()} ${j.email().quote()}")
      status_line(f, Ok(j.last_status()))
      Some(j)
    }
    Err(e) => {
      err_line(f, e)
      None
    }
  }
}

fn status_line(f: Fake, r: Result[JobStatus?, BqErr]) {
  let s = match r {
    Ok(Some(s)) => s
    Ok(None) => {
      note(f, "  status none")
      return
    }
    Err(e) => {
      err_line(f, e)
      return
    }
  }
  let e = match s.err {
    Some(x) => x.display()
    None => "<nil>"
  }
  note(f, "  status ${state_name(s.state)} done=${s.done()} err=${e}")
  for x in s.errors {
    note(f, "  job error ${x.display()}")
  }
  let st = s.statistics ?? return
  note(f, "  stats created=${tm(st.creation_time)} start=${tm(st.start_time)} end=${tm(st.end_time)} bytes=${st.total_bytes_processed} slotms=${st.total_slot_duration.millis()} children=${st.num_child_jobs} parent=${st.parent_job_id.quote()} ratio=${show_f(st.completion_ratio)} reservation=${st.reservation_id.quote()}")
  if let Some(sid) = st.session_id {
    note(f, "  session ${sid}")
  }
  match st.details {
    Some(Statistics.Query(d)) => {
      let ddl = match d.ddl_target_table {
        Some(t) => fq(t)
        None => ""
      }
      note(f, "  query tier=${d.billing_tier} cache=${d.cache_hit} type=${d.statement_type} billed=${d.total_bytes_billed} processed=${d.total_bytes_processed} accuracy=${d.total_bytes_processed_accuracy} dml=${d.num_dml_affected_rows} slotms=${d.slot_millis} schema=${names(d.schema)} tables=${strs_v(d.referenced_tables.map(fq))} undeclared=${strs_v(d.undeclared_query_parameter_names)} ddl=${d.ddl_operation_performed.quote()} ddltable=${ddl.quote()}")
      if let Some(m) = d.dml_stats {
        note(f, "  dml inserted=${m.inserted_row_count} deleted=${m.deleted_row_count} updated=${m.updated_row_count}")
      }
    }
    Some(Statistics.Load(d)) => note(f, "  load bytes=${d.input_file_bytes} files=${d.input_files} outbytes=${d.output_bytes} outrows=${d.output_rows}")
    Some(Statistics.Extract(d)) => note(f, "  extract [${d.destination_uri_file_counts.map(fn(n) -> Str { "${n}" }).join(" ")}]")
    None => {}
  }
}

fn config_line(f: Fake, j: Job[()]) {
  match j.config() {
    Ok(Some(JobConfig.Query(q))) => {
      let dst = match q.dst {
        Some(t) => fq(t)
        None => ""
      }
      note(f, "  config query ${q.q.quote()} legacy=${q.use_legacy_sql} standard=${q.use_standard_sql} dry=${q.dry_run} cache_off=${q.disable_query_cache} billed=${q.max_bytes_billed} priority=${q.priority.quote()} default=${q.default_project_id}.${q.default_dataset_id} dst=${dst.quote()} create=${q.create_disposition.quote()} write=${q.write_disposition.quote()} timeoutms=${q.job_timeout.millis()} labels=${map_v(q.labels)} params=${q.parameters.len()} session=${q.create_session}")
    }
    Ok(Some(JobConfig.Copy(c))) => {
      let kms = match c.destination_encryption_config {
        Some(e) => e.kms_key_name
        None => "none"
      }
      note(f, "  config copy srcs=[${c.srcs.map(fq).join(" ")}] dst=${fq(c.dst)} create=${c.create_disposition.quote()} write=${c.write_disposition.quote()} op=${c.operation_type.quote()} kms=${kms} timeoutms=${c.job_timeout.millis()} reservation=${c.reservation.quote()} slots=${c.max_slots} labels=${map_v(c.labels)}")
    }
    Ok(Some(JobConfig.Extract(e))) => {
      let src = match e.src {
        Some(t) => fq(t)
        None => "none"
      }
      let model = match e.src_model {
        Some(m) => "${m.project_id}:${m.dataset_id}.${m.model_id}"
        None => ""
      }
      note(f, "  config extract src=${src} model=${model.quote()} uris=[${e.dst.uris.join(" ")}] compression=${e.dst.compression.quote()} format=${e.dst.destination_format.quote()} delim=${e.dst.file_config.csv.field_delimiter.quote()} noheader=${e.disable_header} avro=${e.use_avro_logical_types} timeoutms=${e.job_timeout.millis()} reservation=${e.reservation.quote()} slots=${e.max_slots} labels=${map_v(e.labels)}")
    }
    Ok(Some(JobConfig.Load(l))) => load_lines(f, l)
    Ok(Some(JobConfig.Other(c))) => note(f, if c.load.is_some() { "  config *bigquery.LoadConfig" } else if c.copy.is_some() { "  config *bigquery.CopyConfig" } else { "  config *bigquery.ExtractConfig" })
    Ok(None) => note(f, "  config none")
    Err(e) => err_line(f, e)
  }
}

/// The iterator read to its end, a row a line (the oracle's rows).
fn rows_line(f: Fake, r: Result[RowIterator[()], BqErr], as_map: Bool = false) {
  var it = match r {
    Ok(it) => it
    Err(e) => {
      err_line(f, e)
      return
    }
  }
  while true {
    let shown = if as_map {
      var vm = ValueMap{}
      match it.next_into(vm) {
        Ok(true) => show(Value.Map(vm.m))
        Ok(false) => break
        Err(e) => {
          err_line(f, e)
          return
        }
      }
    } else {
      match it.next() {
        Ok(Some(vs)) => show(Value.List(vs))
        Ok(None) => break
        Err(e) => {
          err_line(f, e)
          return
        }
      }
    }
    note(f, "  row ${shown}")
  }
  let src = match it.source_job() {
    Some(j) => "${j.project_id()}/${ids(j.id())}/${j.location()}"
    None => ""
  }
  note(f, "  done total=${it.total_rows} schema=${names(it.schema ?? [])} job=${src.quote()} query=${it.query_id().quote()}")
}

fn ok_line(f: Fake, r: Result[(), BqErr]) {
  match r {
    Ok(_) => note(f, "  ok")
    Err(e) => err_line(f, e)
  }
}

fn vsv(id: Int, name: Str) -> ValuesSaver {
  ValuesSaver{schema: [FieldSchema{name: "id", type_: "INTEGER"}, FieldSchema{name: "name", type_: "STRING"}], row: [Value.Int(id), Value.Str(name)]}
}

fn with_id(s: ValuesSaver, id: Str) -> ValuesSaver {
  var x = s
  x.insert_id = id
  x
}

fn row(id: Str, name: Str, at: Str) -> Str { "{\"f\":[{\"v\":\"${id}\"},{\"v\":\"${name}\"},{\"v\":\"${at}\"}]}" }

fn complete(extra: Str) -> Str { "{\"kind\":\"bigquery#queryResponse\",\"jobComplete\":true,\"schema\":${SCHEMA_JSON},\"totalRows\":\"3\",${extra}}" }

fn insert_err(i: Int, reasons: List[Str]) -> Str {
  "{\"index\":${i},\"errors\":[${reasons.map(fn(r) -> Str { "{\"reason\":\"${r}\",\"location\":\"name\",\"message\":\"bad ${r}\"}" }).join(",")}]}"
}

fn rows12() -> Str { "${row("1", "a", "1700000000000000")},${row("2", "b", "1700000000500000")}" }

fn rows3() -> Str { row("3", "c", "1700000001000000") }

fn job_done() -> Str { "{\"kind\":\"bigquery#job\",\"id\":\"p1:US.job1\",${JOB_REF},${QUERY_CONF},\"status\":{\"state\":\"DONE\"},${query_stats()},\"user_email\":\"a@example.com\"}" }

fn job_running() -> Str { "{\"kind\":\"bigquery#job\",${JOB_REF},\"configuration\":{\"query\":{\"query\":\"SELECT 1\"}},\"status\":{\"state\":\"RUNNING\"},\"statistics\":{\"creationTime\":\"1700000000000\"}}" }

fn query_stats() -> Str { "\"statistics\":{\"creationTime\":\"1700000000000\",\"startTime\":\"1700000001000\",\"endTime\":\"1700000002500\",\"totalBytesProcessed\":\"2048\",\"totalSlotMs\":\"1500\",\"completionRatio\":1,\"reservation_id\":\"res1\",\"sessionInfo\":{\"sessionId\":\"s1\"},\"query\":{\"billingTier\":1,\"cacheHit\":true,\"statementType\":\"SELECT\",\"totalBytesBilled\":\"10485760\",\"totalBytesProcessed\":\"2048\",\"totalBytesProcessedAccuracy\":\"PRECISE\",\"numDmlAffectedRows\":\"3\",\"totalSlotMs\":\"1500\",\"schema\":${SCHEMA_JSON},\"referencedTables\":[{\"projectId\":\"p1\",\"datasetId\":\"d1\",\"tableId\":\"t1\"}],\"undeclaredQueryParameters\":[{\"name\":\"x\",\"parameterType\":{\"type\":\"INT64\"}}],\"ddlOperationPerformed\":\"CREATE\",\"ddlTargetTable\":{\"projectId\":\"p1\",\"datasetId\":\"d1\",\"tableId\":\"t9\"},\"dmlStats\":{\"insertedRowCount\":\"3\",\"deletedRowCount\":\"0\",\"updatedRowCount\":\"1\"}}}" }

const SCHEMA_JSON: Str = "{\"fields\":[{\"name\":\"id\",\"type\":\"INTEGER\"},{\"name\":\"name\",\"type\":\"STRING\"},{\"name\":\"at\",\"type\":\"TIMESTAMP\"}]}"
const JOB_REF: Str = "\"jobReference\":{\"projectId\":\"p1\",\"jobId\":\"job1\",\"location\":\"US\"}"
const QUERY_CONF: Str = "\"configuration\":{\"query\":{\"query\":\"SELECT 1\",\"useLegacySql\":false,\"useQueryCache\":false,\"maximumBytesBilled\":\"1000\",\"priority\":\"BATCH\",\"defaultDataset\":{\"projectId\":\"p2\",\"datasetId\":\"d2\"},\"destinationTable\":{\"projectId\":\"p1\",\"datasetId\":\"d1\",\"tableId\":\"out\"},\"createDisposition\":\"CREATE_IF_NEEDED\",\"writeDisposition\":\"WRITE_APPEND\",\"createSession\":true},\"labels\":{\"k\":\"v\"},\"jobTimeoutMs\":\"90000\",\"dryRun\":false}"
const JOB_FAILED: Str = "{\"jobReference\":{\"projectId\":\"p2\",\"jobId\":\"j2\",\"location\":\"EU\"},\"configuration\":{\"query\":{\"query\":\"SELECT x\"}},\"status\":{\"state\":\"DONE\",\"errorResult\":{\"reason\":\"invalidQuery\",\"location\":\"query\",\"message\":\"Unrecognized name: x\"},\"errors\":[{\"reason\":\"invalidQuery\",\"location\":\"query\",\"message\":\"Unrecognized name: x\"},{\"reason\":\"stopped\",\"message\":\"stopped\"}]}}"
const LOAD_RUNNING: Str = "{\"jobReference\":{\"projectId\":\"p1\",\"jobId\":\"l1\",\"location\":\"US\"},\"configuration\":{\"load\":{\"destinationTable\":{\"projectId\":\"p1\",\"datasetId\":\"d1\",\"tableId\":\"t1\"},\"sourceUris\":[\"gs://b/o\"]}},\"status\":{\"state\":\"RUNNING\"}}"
const LOAD_STATUS: Str = "{\"status\":{\"state\":\"RUNNING\"},\"statistics\":{\"creationTime\":\"1700000000000\",\"load\":{\"inputFileBytes\":\"100\",\"inputFiles\":\"1\",\"outputBytes\":\"90\",\"outputRows\":\"5\"}}}"
const LOAD_DONE: Str = "{\"status\":{\"state\":\"DONE\"},\"statistics\":{\"creationTime\":\"1700000000000\",\"endTime\":\"1700000009000\",\"load\":{\"inputFileBytes\":\"100\",\"inputFiles\":\"1\",\"outputBytes\":\"90\",\"outputRows\":\"5\"}}}"
const JOB_RATE_LIMITED: Str = "{\"error\":{\"code\":400,\"message\":\"Job exceeded rate limits\",\"errors\":[{\"message\":\"Job exceeded rate limits\",\"domain\":\"global\",\"reason\":\"jobRateLimitExceeded\"}]}}"
const INVALID_QUERY: Str = "{\"error\":{\"code\":400,\"message\":\"Syntax error: Unexpected end of script at [1:7]\",\"errors\":[{\"message\":\"Syntax error: Unexpected end of script at [1:7]\",\"domain\":\"global\",\"reason\":\"invalidQuery\",\"location\":\"q\",\"locationType\":\"parameter\"}],\"status\":\"INVALID_ARGUMENT\"}}"
const TABLE_NOT_FOUND: Str = "{\"error\":{\"code\":404,\"message\":\"Not found: Table p1:d1.t1\",\"errors\":[{\"message\":\"Not found: Table p1:d1.t1\",\"domain\":\"global\",\"reason\":\"notFound\"}],\"status\":\"NOT_FOUND\"}}"
const INTERNAL_ERR: Str = "{\"error\":{\"code\":500,\"message\":\"x\",\"errors\":[{\"message\":\"x\",\"domain\":\"global\",\"reason\":\"internalError\"}]}}"

/// The client of a step 3 case: every pause short.
fn jobs_client(os: testing.TestOs, project: Str = "p1") -> Client[()] {
  new_client(os.net, os.clock, os.rand, project, ClientOptions{service: option.ClientOptions{endpoint: "https://bigquery.fake/bigquery/v2/", without_authentication: true}, backoff: FAST, query_poll: FAST, status_poll: FAST})
}

fn go_list(xs: List[Str]) -> Str { "[${xs.join(" ")}]" }

/// The oracle's config line of a load and its file line.
fn load_lines(f: Fake, l: LoadConfig) {
  let (src, fc) = match l.src {
    LoadSource.Gcs(g) => ("gcs${go_list(g.uris)}", g.file_config)
    LoadSource.Reader(r) => ("reader", r.file_config)
  }
  let tp = match l.time_partitioning {
    Some(p) => "${p.type_}/${p.field}/${p.expiration.millis()}/${p.require_partition_filter}"
    None => "none"
  }
  let rp = match l.range_partitioning {
    Some(p) => match p.range {
      Some(r) => "${p.field}[${r.start},${r.end},${r.interval}]"
      None => p.field
    }
    None => "none"
  }
  let cl = match l.clustering {
    Some(c) => go_list(c.fields)
    None => "none"
  }
  let kms = match l.destination_encryption_config {
    Some(e) => e.kms_key_name
    None => "none"
  }
  let hive = match l.hive_partitioning_options {
    Some(h) => "${h.mode}/${h.source_uri_prefix}/${h.require_partition_filter}"
    None => "none"
  }
  let conn = go_list(l.connection_properties.map(fn(p) -> Str { "${p.key}=${p.value}" }))
  note(f, "  config load src=${src} dst=${fq(l.dst)} create=${l.create_disposition.quote()} write=${l.write_disposition.quote()} time=${tp} range=${rp} cluster=${cl} kms=${kms} update=${go_list(l.schema_update_options)} projection=${go_list(l.projection_fields)} hive=${hive} decimal=${go_list(l.decimal_target_types)} timeoutms=${l.job_timeout.millis()} refschema=${l.reference_file_schema_uri.quote()} session=${l.create_session} conn=${conn} colmap=${l.column_name_character_map.quote()} reservation=${l.reservation.quote()} slots=${l.max_slots} avro=${l.use_avro_logical_types} labels=${map_v(l.labels)}")
  let names = match fc.schema {
    Some(s) => s.map(fn(x) -> Str { "${x.name}:${x.type_}" })
    None => []
  }
  let o = fc.csv
  note(f, "  file format=${fc.source_format.quote()} auto=${fc.auto_detect} maxbad=${fc.max_bad_records} ignore=${fc.ignore_unknown_values} schema=${go_list(names)} skip=${o.skip_leading_rows} jagged=${o.allow_jagged_rows} qnl=${o.allow_quoted_newlines} enc=${o.encoding.quote()} delim=${o.field_delimiter.quote()} quote=${o.quote.quote()} zeroquote=${o.force_zero_quote} null=${o.null_marker.quote()} nulls=${go_list(o.null_markers)} match=${o.source_column_match.quote()} ascii=${o.preserve_ascii_control_characters} tz=${fc.time_zone.quote()} date=${fc.date_format.quote()} datetime=${fc.datetime_format.quote()} time=${fc.time_format.quote()} timestamp=${fc.timestamp_format.quote()} parquet=${fc.parquet_options.is_some()} avro=${fc.avro_options.is_some()}")
}

/// The oracle's jobsOf: each listed job and its config, then "done".
fn jobs_lines(f: Fake, from: JobIterator[()]) {
  var it = from
  while true {
    match it.next() {
      Ok(Some(j)) => {
        job_line(f, Ok(j))
        config_line(f, j)
      }
      Ok(None) => {
        note(f, "  done")
        return
      }
      Err(e) => {
        err_line(f, e)
        return
      }
    }
  }
}

/// Go's %q of a string holding any bytes: valid UTF-8 as Str.quote, else
/// each byte outside printable ASCII as \xNN.
fn go_quote_bytes(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s.quote()
  }
  var out = StrBuilder.new()
  out.write("\"")
  for x in b {
    let n = Int(x)
    if n >= 32 && n < 127 && n != 34 && n != 92 {
      var one = BytesBuilder.new()
      one.write_byte(x)
      out.write(one.freeze().to_str_lossy())
    } else {
      let h = n.to_str_base(16)
      out.write("\\x${if h.len() < 2 { "0" + h } else { h }}")
    }
  }
  out.write("\"")
  out.freeze()
}

/// The oracle's ext: an external data configuration and its options.
fn ext_lines(f: Fake, name: Str, cfg: ExternalDataConfig?) {
  let e = cfg ?? {
    note(f, "  ext ${name} none")
    return
  }
  let sch = match e.schema {
    Some(s) => s.map(fn(x) -> Str { "${x.name}:${x.type_}" })
    None => []
  }
  let hive = match e.hive_partitioning_options {
    Some(h) => "${h.mode}/${h.source_uri_prefix}/${h.require_partition_filter}"
    None => "none"
  }
  note(f, "  ext ${name} format=${e.source_format.quote()} uris=${go_list(e.source_uris)} schema=${go_list(sch)} nilschema=${e.schema.is_none()} auto=${e.auto_detect} compression=${e.compression.quote()} ignore=${e.ignore_unknown_values} maxbad=${e.max_bad_records} hive=${hive} decimal=${go_list(e.decimal_target_types)} conn=${e.connection_id.quote()} refschema=${e.reference_file_schema_uri.quote()} cache=${e.metadata_cache_mode.quote()} tz=${e.time_zone.quote()} date=${e.date_format.quote()} datetime=${e.datetime_format.quote()} time=${e.time_format.quote()} timestamp=${e.timestamp_format.quote()} fileset=${e.file_set_spec_type.quote()} jsonext=${e.json_extension.quote()} objmeta=${e.object_metadata.quote()} precision=${go_list(e.timestamp_target_precision.map(fn(n) -> Str { "${n}" }))}")
  match e.options {
    None => note(f, "    options none")
    Some(ExternalDataConfigOptions.Avro(o)) => note(f, "    avro logical=${o.use_avro_logical_types}")
    Some(ExternalDataConfigOptions.Csv(o)) => note(f, "    csv jagged=${o.allow_jagged_rows} qnl=${o.allow_quoted_newlines} enc=${o.encoding.quote()} delim=${o.field_delimiter.quote()} quote=${o.quote.quote()} zeroquote=${o.force_zero_quote} skip=${o.skip_leading_rows} null=${o.null_marker.quote()} nulls=${go_list(o.null_markers)} match=${o.source_column_match.quote()} ascii=${o.preserve_ascii_control_characters}")
    Some(ExternalDataConfigOptions.Json(o)) => note(f, "    json enc=${o.encoding.quote()}")
    Some(ExternalDataConfigOptions.GoogleSheets(o)) => note(f, "    sheets skip=${o.skip_leading_rows} range=${o.range.quote()}")
    Some(ExternalDataConfigOptions.Bigtable(o)) => {
      note(f, "    bigtable ignore=${o.ignore_unspecified_column_families} rowkey=${o.read_rowkey_as_string} families=${o.column_families.len()}")
      for fam in o.column_families {
        note(f, "    family ${fam.family_id.quote()} enc=${fam.encoding.quote()} latest=${fam.only_read_latest} type=${fam.type_.quote()}")
        for c in fam.columns {
          note(f, "    column ${go_quote_bytes(c.qualifier)} field=${c.field_name.quote()} latest=${c.only_read_latest} enc=${c.encoding.quote()} type=${c.type_.quote()}")
        }
      }
    }
    Some(ExternalDataConfigOptions.Parquet(o)) => note(f, "    parquet enum=${o.enum_as_string} list=${o.enable_list_inference}")
  }
}

/// The oracle's tableMeta: a table's external data configuration.
fn table_meta(f: Fake, r: Result[TableMetadata, BqErr]) {
  match r {
    Ok(md) => ext_lines(f, "table", md.external_data_config)
    Err(e) => err_line(f, e)
  }
}

/// The oracle's defs: a fetched query job's table definitions by name.
fn defs_lines(f: Fake, j: Job[()]?) {
  let job = j ?? return
  match job.config() {
    Ok(Some(JobConfig.Query(q))) => {
      let n = match q.table_definitions {
        Some(m) => m.len()
        None => 0
      }
      note(f, "  defs nil=${q.table_definitions.is_none()} n=${n}")
      if let Some(m) = q.table_definitions {
        for name in m.keys().sort() {
          match m.get_or_fault(name, "a key") {
            ExternalData.Config(c) => ext_lines(f, name, Some(c))
            ExternalData.Gcs(_) => note(f, "  ext ${name} gcs")
          }
        }
      }
    }
    Ok(_) => {}
    Err(e) => err_line(f, e)
  }
}
