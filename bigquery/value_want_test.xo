// Generated by ~/xo-lead/notes/aws-43/bigqueryvals/gen_want.py from the
// Go oracle's output (bigqueryvals.out): Go's lines for each case, the
// decision 0011 departures put in, "error ~" where Go's error text
// comes from strconv, time, base64 or encoding/json. Not ported:
// parameters Xo's types rule out (nil, uint64, maps).

fn want_lines(name: Str) -> List[Str] {
  match name {
    "scalar STRING" => ["  cell STRING \"abc\"", "  row [str \"abc\"]", "  done", "  cell STRING \"\"", "  row [str \"\"]", "  done", "  cell STRING null", "  row [null]", "  done"]
    "scalar BYTES" => ["  cell BYTES \"aGk=\"", "  row [bytes \"hi\"]", "  done", "  cell BYTES \"\"", "  row [bytes \"\"]", "  done", "  cell BYTES \"!!\"", "  error ~"]
    "scalar INTEGER" => ["  cell INTEGER \"42\"", "  row [int 42]", "  done", "  cell INTEGER \"-9223372036854775808\"", "  row [int -9223372036854775808]", "  done", "  cell INTEGER \"9223372036854775808\"", "  error strconv.ParseInt: parsing \"9223372036854775808\": value out of range", "  cell INTEGER \"1.5\"", "  error strconv.ParseInt: parsing \"1.5\": invalid syntax"]
    "scalar INT64" => ["  cell INT64 \"7\"", "  error unrecognized type: INT64"]
    "scalar FLOAT" => ["  cell FLOAT \"1.5\"", "  row [float 1.5]", "  done", "  cell FLOAT \"-0.25\"", "  row [float -0.25]", "  done", "  cell FLOAT \"1e10\"", "  row [float 1e+10]", "  done", "  cell FLOAT \"NaN\"", "  row [float NaN]", "  done", "  cell FLOAT \"Infinity\"", "  row [float +Inf]", "  done", "  cell FLOAT \"-Infinity\"", "  row [float -Inf]", "  done", "  cell FLOAT \"x\"", "  error strconv.ParseFloat: parsing \"x\": invalid syntax"]
    "scalar BOOLEAN" => ["  cell BOOLEAN \"true\"", "  row [bool true]", "  done", "  cell BOOLEAN \"false\"", "  row [bool false]", "  done", "  cell BOOLEAN \"1\"", "  row [bool true]", "  done", "  cell BOOLEAN \"T\"", "  row [bool true]", "  done", "  cell BOOLEAN \"yes\"", "  error strconv.ParseBool: parsing \"yes\": invalid syntax"]
    "scalar TIMESTAMP" => ["  cell TIMESTAMP \"1700000000123456\"", "  row [ts 1700000000123456 UTC]", "  done", "  cell TIMESTAMP \"0\"", "  row [ts 0 UTC]", "  done", "  cell TIMESTAMP \"-1\"", "  row [ts -1 UTC]", "  done", "  cell TIMESTAMP \"1.7e9\"", "  error strconv.ParseInt: parsing \"1.7e9\": invalid syntax", "  cell TIMESTAMP \"-62135596800000000\"", "  error bigquery: TIMESTAMP \"-62135596800000000\" is outside the years a Time holds (1677 to 2262)", "  cell TIMESTAMP \"253402300799999999\"", "  error bigquery: TIMESTAMP \"253402300799999999\" is outside the years a Time holds (1677 to 2262)"]
    "scalar DATE" => ["  cell DATE \"2026-11-11\"", "  row [date 2026-11-11]", "  done", "  cell DATE \"0001-01-01\"", "  row [date 1-1-1]", "  done", "  cell DATE \"2026-1-2\"", "  row [date 2026-1-2]", "  done", "  cell DATE \"2026-13-01\"", "  error ~"]
    "scalar TIME" => ["  cell TIME \"03:04:05\"", "  row [time 3:4:5.0]", "  done", "  cell TIME \"23:59:59.999999\"", "  row [time 23:59:59.999999000]", "  done", "  cell TIME \"03:04:05.1\"", "  row [time 3:4:5.100000000]", "  done", "  cell TIME \"24:00:00\"", "  error ~"]
    "scalar DATETIME" => ["  cell DATETIME \"2026-11-11T03:04:05\"", "  row [datetime 2026-11-11 3:4:5.0]", "  done", "  cell DATETIME \"2026-11-11T03:04:05.000006\"", "  row [datetime 2026-11-11 3:4:5.6000]", "  done", "  cell DATETIME \"2026-11-11 03:04:05\"", "  error ~"]
    "scalar GEOGRAPHY JSON" => ["  cell GEOGRAPHY \"POINT(1 2)\"", "  row [str \"POINT(1 2)\"]", "  done", "  cell JSON \"{\\\"a\\\":1}\"", "  row [str \"{\\\"a\\\":1}\"]", "  done"]
    "scalar INTERVAL" => ["  cell INTERVAL \"1-2 3 4:5:6.5\"", "  row [interval 1 2 3 4 5 6 500000000]", "  done", "  cell INTERVAL \"-1-2 -3 -4:5:6\"", "  row [interval -1 -2 -3 -4 -5 -6 0]", "  done", "  cell INTERVAL \"0-0 0 0:0:0\"", "  row [interval 0 0 0 0 0 0 0]", "  done", "  cell INTERVAL \"bad\"", "  error bigquery: invalid INTERVAL value \"bad\""]
    "scalar unknown type" => ["  cell WIBBLE \"1\"", "  error unrecognized type: WIBBLE"]
    "cell not a string" => ["  cell INTEGER 5", "  error got value 5; expected a value of type INTEGER", "  cell INTEGER true", "  error got value true; expected a value of type INTEGER"]
    "repeated" => ["  row [[int 1, int 2]]", "  row [[]]", "  done"]
    "record" => ["  row [[str \"x\", int 3], bool true]", "  row [null, null]", "  done"]
    "record as map" => ["  row {n: bool true, r: {a: str \"x\", b: null}}", "  row {n: null, r: null}", "  done"]
    "repeated record" => ["  row [[[str \"p\"], [str \"q\"]]]", "  done"]
    "repeated record as map" => ["  row {r: [{a: str \"p\"}, {a: str \"q\"}]}", "  row {r: []}", "  done"]
    "record length mismatch" => ["  error schema length does not match record length"]
    "row length mismatch" => ["  error schema length does not match row length"]
    "range" => ["  row [range(date 2026-1-1, date 2026-2-1)]", "  row [range(null, date 2026-2-1)]", "  row [range(date 2026-1-1, null)]", "  row [null]", "  done", "  row [range(datetime 2026-1-1 1:2:3.0, null)]", "  done", "  row [range(ts 1700000000000000 UTC, ts 1700000000000001 UTC)]", "  done"]
    "range bad" => ["  error bigquery: invalid RANGE element type \"INTEGER\"", "  error bigquery: invalid RANGE value \"(2026-01-01, 2026-02-01)\"", "  error bigquery: invalid RANGE value \"2026-01-01,2026-02-01\"", "  error bigquery: invalid RANGE start value \"x\"", "  error bigquery: invalid RANGE end value \"y\"", "  error bigquery: incomplete range schema for conversion"]
    "range repeated" => ["  row [[range(date 2026-1-1, date 2026-2-1), null]]", "  done"]
    "civil strings" => ["  time 3:4:5.0: 03:04:05", "  time 3:4:5.6000: 03:04:05.000006", "  time 3:4:5.1499: 03:04:05.000001", "  time 3:4:5.999999500: 03:04:05.999999", "  time 23:59:59.123456789: 23:59:59.123457", "  datetime 2026-11-11 3:4:5.7000: 2026-11-11 03:04:05.000007", "  datetime 7-1-2 0:0:0.0: 0007-01-02 00:00:00"]
    "interval parse" => ["  parse \"1-2 3 4:5:6.5\": interval 1 2 3 4 5 6 500000000 canonical true string \"1-2 3 4:5:6.5\" canon interval 1 2 3 4 5 6 500000000", "  parse \"-1-2 -3 -4:5:6.000001\": interval -1 -2 -3 -4 -5 -6 -1000 canonical true string \"-1-2 -3 -4:5:6.000001\" canon interval -1 -2 -3 -4 -5 -6 -1000", "  parse \"0-0 0 0:0:0\": interval 0 0 0 0 0 0 0 canonical true string \"0-0 0 0:0:0\" canon interval 0 0 0 0 0 0 0", "  parse \"+1-2 +3 +4:5:6\": interval 1 2 3 4 5 6 0 canonical true string \"1-2 3 4:5:6\" canon interval 1 2 3 4 5 6 0", "  parse \"1-14 3 4:75:6\": interval 1 14 3 4 75 6 0 canonical false string \"2-2 3 5:15:6\" canon interval 2 2 3 5 15 6 0", "  parse \"10-0 0 0:0:0.123456789\": interval 10 0 0 0 0 0 123456789 canonical true string \"10-0 0 0:0:0.123456789\" canon interval 10 0 0 0 0 0 123456789", "  parse \"1-2 3\": error no value parsed for part HOURS", "  parse \"1-2 3 4:5\": error no value parsed for part SECONDS", "  parse \"\": error no value parsed for part YEARS", "  parse \"x-2 3 4:5:6\": error no value parsed for part YEARS", "  parse \"1-2 3 4:5:6.\": interval 1 2 3 4 5 6 0 canonical true string \"1-2 3 4:5:6\" canon interval 1 2 3 4 5 6 0", "  parse \"99999999999-0 0 0:0:0\": error error parsing value 99999999999 for YEARS: strconv.ParseInt: parsing \"99999999999\": value out of range", "  parse \"-0-5 0 0:0:0\": interval 0 -5 0 0 0 0 0 canonical true string \"-0-5 0 0:0:0\" canon interval 0 -5 0 0 0 0 0", "  parse \"0-0 0 -0:30:0\": interval 0 0 0 0 -30 0 0 canonical true string \"0-0 0 -0:30:0\" canon interval 0 0 0 0 -30 0 0", "  parse \"1-2 3 4:5:6  \": interval 1 2 3 4 5 6 0 canonical true string \"1-2 3 4:5:6\" canon interval 1 2 3 4 5 6 0"]
    "interval values" => ["  interval 1 -2 0 0 0 0 0: canonical false string \"0-10 0 0:0:0\" canon interval 0 10 0 0 0 0 0", "  interval 0 25 0 0 0 0 0: canonical false string \"2-1 0 0:0:0\" canon interval 2 1 0 0 0 0 0", "  interval 0 -25 0 0 0 0 0: canonical false string \"-2-1 0 0:0:0\" canon interval -2 -1 0 0 0 0 0", "  interval 0 0 0 1 -30 0 0: canonical false string \"0-0 0 0:30:0\" canon interval 0 0 0 0 30 0 0", "  interval 0 0 0 0 125 70 0: canonical false string \"0-0 0 2:6:10\" canon interval 0 0 0 2 6 10 0", "  interval 0 0 0 0 0 -61 -500: canonical false string \"0-0 0 -0:1:1.0000005\" canon interval 0 0 0 0 -1 -1 -500", "  interval 0 0 400 30 0 0 0: canonical true string \"0-0 400 30:0:0\" canon interval 0 0 400 30 0 0 0", "  interval 0 0 0 0 0 0 1500000000: canonical false string \"0-0 0 0:0:1.5\" canon interval 0 0 0 0 0 1 500000000", "  interval 0 -5 0 0 0 0 0: canonical true string \"-0-5 0 0:0:0\" canon interval 0 -5 0 0 0 0 0", "  interval 0 0 0 0 -30 0 0: canonical true string \"0-0 0 -0:30:0\" canon interval 0 0 0 0 -30 0 0"]
    "interval durations" => ["  from 0: interval 0 0 0 0 0 0 0", "  from 3723000000004: interval 0 0 0 1 2 3 4", "  from -90000000000001: interval 0 0 0 -25 0 0 -1", "  from 5400000000000: interval 0 0 0 1 30 0 0", "  to interval 1 0 0 0 0 0 0: 31104000000000000", "  to interval 0 1 1 1 1 1 0: 2682061000000000", "  to interval 0 0 -2 0 0 0 0: -172800000000000", "  to interval 0 0 0 0 0 1 1: 1000000001", "  to interval 0 0 0 0 0 0 500000000: 500000000"]
    "values saver" => ["  id \"id1\" json {\"b\":true,\"f\":1.25,\"i\":-3,\"s\":\"a\\\"\\u003cb\\u003e\",\"y\":\"aGk=\"}", "  id \"\" json {\"b\":null,\"f\":null,\"i\":null,\"s\":null,\"y\":null}", "  error schema does not match length of row to be inserted", "  id \"\" error json: unsupported value: NaN", "  id \"\" json {\"f\":1e+21}"]
    "values saver civil" => ["  id \"\" json {\"d\":\"2026-11-11\",\"dt\":\"2026-01-02 03:04:05\",\"g\":\"POINT(1 2)\",\"iv\":\"1-2 3 4:5:6\",\"j\":\"{\\\"a\\\":1}\",\"t\":\"03:04:05.000006\",\"ts\":\"2023-11-14T22:13:20.123456Z\"}", "  id \"\" json {\"d\":\"0001-01-01\",\"dt\":\"0000-00-00 00:00:00\",\"g\":\"\",\"iv\":\"2-1 0 0:0:0\",\"j\":\"\",\"t\":\"00:00:00\",\"ts\":\"1970-01-01T00:00:00Z\"}"]
    "values saver repeated" => ["  id \"\" json {\"e\":[],\"ts\":[\"01:00:00\",\"02:00:00.000001\"],\"xs\":[1,2]}", "  id \"\" json {\"e\":null,\"ts\":null,\"xs\":[]}"]
    "values saver record" => ["  id \"\" json {\"r\":{\"a\":\"x\",\"t\":\"09:00:00\"},\"rr\":[{\"b\":1},{\"b\":2}]}", "  id \"\" json {\"r\":null,\"rr\":[]}", "  error schema does not match length of row to be inserted", "  error nested record is not a []Value", "  error nested record in slice is not a []Value"]
    "values saver range" => ["  id \"\" json {\"g\":{\"start\":\"2026-01-01\",\"end\":null}}"]
    "null json" => ["  json [5,null,\"a\",null,true,\"POINT(1 2)\",\"{\\\"a\\\":1}\"]", "  json [1.5,\"NaN\",\"Infinity\",\"-Infinity\",null]", "  json [\"2023-11-14T22:13:20.123456Z\",\"2026-11-11\",\"03:04:05.000006\",\"2026-01-02 03:00:00\",null,null,null,null]"]
    "null string" => ["  \"5\"", "  \"NULL\"", "  \"1.5\"", "  \"false\"", "  \"a\"", "  \"2023-11-14 22:13:20.123456 +0000 UTC\"", "  \"2026-11-11\"", "  \"03:04:05.000006\"", "  \"2026-01-02 03:00:00\"", "  \"<null>\""]
    "null unmarshal" => ["  from 5: 5 5", "  from null: NULL null", "  from \"5\": error ~", "  from 1.5: 1.5 1.5", "  from \"NaN\": NaN \"NaN\"", "  from \"Infinity\": +Inf \"Infinity\"", "  from \"-Infinity\": -Inf \"-Infinity\"", "  from \"x\": error ~", "  from true: true true", "  from \"a\": a \"a\"", "  from null: NULL null", "  from \"2026-11-11T03:04:05.123456Z\": 2026-11-11 03:04:05.123456 +0000 UTC \"2026-11-11T03:04:05.123456Z\"", "  from \"2026-11-11\": 2026-11-11 \"2026-11-11\"", "  from \"03:04:05.000006\": 03:04:05.000006 \"03:04:05.000006\"", "  from \"25:00:00\": error ~", "  from \"2026-01-02 03:04:05\": 2026-01-02 03:04:05 \"2026-01-02 03:04:05\"", "  from \"2026-01-02T03:04:05\": error ~"]
    "params scalar" => ["  param [{\"name\":\"i\",\"parameterType\":{\"type\":\"INT64\"},\"parameterValue\":{\"value\":\"-5\"}}]", "  param [{\"name\":\"f\",\"parameterType\":{\"type\":\"FLOAT64\"},\"parameterValue\":{\"value\":\"1.5\"}}]", "  param [{\"name\":\"b\",\"parameterType\":{\"type\":\"BOOL\"},\"parameterValue\":{\"value\":\"false\"}}]", "  param [{\"name\":\"s\",\"parameterType\":{\"type\":\"STRING\"},\"parameterValue\":{\"value\":\"x\"}}]", "  param [{\"name\":\"e\",\"parameterType\":{\"type\":\"STRING\"},\"parameterValue\":{\"value\":\"\"}}]", "  param [{\"name\":\"y\",\"parameterType\":{\"type\":\"BYTES\"},\"parameterValue\":{\"value\":\"aGk=\"}}]", "  param [{\"name\":\"ts\",\"parameterType\":{\"type\":\"TIMESTAMP\"},\"parameterValue\":{\"value\":\"2023-11-14 22:13:20.123456+00:00\"}}]", "  param [{\"name\":\"ts2\",\"parameterType\":{\"type\":\"TIMESTAMP\"},\"parameterValue\":{\"value\":\"2026-01-02 10:04:05+00:00\"}}]", "  param [{\"name\":\"d\",\"parameterType\":{\"type\":\"DATE\"},\"parameterValue\":{\"value\":\"2026-11-11\"}}]", "  param [{\"name\":\"t\",\"parameterType\":{\"type\":\"TIME\"},\"parameterValue\":{\"value\":\"03:04:05.000006\"}}]", "  param [{\"name\":\"dt\",\"parameterType\":{\"type\":\"DATETIME\"},\"parameterValue\":{\"value\":\"2026-01-02 03:00:00\"}}]", "  param [{\"name\":\"iv\",\"parameterType\":{\"type\":\"INTERVAL\"},\"parameterValue\":{\"value\":\"1-2 3 4:5:6\"}}]"]
    "params null" => ["  param [{\"name\":\"ni\",\"parameterType\":{\"type\":\"INT64\"},\"parameterValue\":{\"value\":null}}]", "  param [{\"name\":\"ni5\",\"parameterType\":{\"type\":\"INT64\"},\"parameterValue\":{\"value\":\"5\"}}]", "  param [{\"name\":\"ns\",\"parameterType\":{\"type\":\"STRING\"},\"parameterValue\":{\"value\":null}}]", "  param [{\"name\":\"nse\",\"parameterType\":{\"type\":\"STRING\"},\"parameterValue\":{\"value\":\"\"}}]", "  param [{\"name\":\"nf\",\"parameterType\":{\"type\":\"FLOAT64\"},\"parameterValue\":{\"value\":null}}]", "  param [{\"name\":\"nb\",\"parameterType\":{\"type\":\"BOOL\"},\"parameterValue\":{\"value\":null}}]", "  param [{\"name\":\"ng\",\"parameterType\":{\"type\":\"GEOGRAPHY\"},\"parameterValue\":{\"value\":\"POINT(1 2)\"}}]", "  param [{\"name\":\"nj\",\"parameterType\":{\"type\":\"JSON\"},\"parameterValue\":{\"value\":null}}]", "  param [{\"name\":\"nts\",\"parameterType\":{\"type\":\"TIMESTAMP\"},\"parameterValue\":{\"value\":null}}]", "  param [{\"name\":\"nd\",\"parameterType\":{\"type\":\"DATE\"},\"parameterValue\":{\"value\":\"2026-01-02\"}}]", "  param [{\"name\":\"nt\",\"parameterType\":{\"type\":\"TIME\"},\"parameterValue\":{\"value\":null}}]", "  param [{\"name\":\"ndt\",\"parameterType\":{\"type\":\"DATETIME\"},\"parameterValue\":{\"value\":null}}]"]
    "params array" => ["  param [{\"name\":\"a\",\"parameterType\":{\"arrayType\":{\"type\":\"INT64\"},\"type\":\"ARRAY\"},\"parameterValue\":{\"arrayValues\":[{\"value\":\"1\"},{\"value\":\"2\"}]}}]", "  param [{\"name\":\"ae\",\"parameterType\":{\"arrayType\":{\"type\":\"STRING\"},\"type\":\"ARRAY\"},\"parameterValue\":{}}]", "  param [{\"name\":\"aa\",\"parameterType\":{\"arrayType\":{\"type\":\"STRING\"},\"type\":\"ARRAY\"},\"parameterValue\":{\"arrayValues\":[{\"value\":\"x\"},{\"value\":null}]}}]"]
    "params struct" => ["  param [{\"name\":\"st\",\"parameterType\":{\"structTypes\":[{\"name\":\"A\",\"type\":{\"type\":\"INT64\"}},{\"name\":\"I\",\"type\":{\"structTypes\":[{\"name\":\"B\",\"type\":{\"type\":\"STRING\"}}],\"type\":\"STRUCT\"}},{\"name\":\"L\",\"type\":{\"arrayType\":{\"type\":\"FLOAT64\"},\"type\":\"ARRAY\"}}],\"type\":\"STRUCT\"},\"parameterValue\":{\"structValues\":{\"A\":{\"value\":\"1\"},\"I\":{\"structValues\":{\"B\":{\"value\":\"z\"}}},\"L\":{\"arrayValues\":[{\"value\":\"0.5\"}]}}}}]"]
    "params range" => ["  param [{\"name\":\"r\",\"parameterType\":{\"rangeElementType\":{\"type\":\"DATE\"},\"type\":\"RANGE\"},\"parameterValue\":{\"rangeValue\":{\"end\":{\"value\":\"2026-02-01\"},\"start\":{\"value\":\"2026-01-01\"}}}}]", "  param [{\"name\":\"ru\",\"parameterType\":{\"rangeElementType\":{\"type\":\"TIMESTAMP\"},\"type\":\"RANGE\"},\"parameterValue\":{\"rangeValue\":{\"end\":{\"value\":\"2023-11-14 22:13:20+00:00\"}}}}]", "  error unable to determine range element type from RangeValue without a non-nil start or end value"]
    "params explicit" => ["  param [{\"name\":\"x\",\"parameterType\":{\"type\":\"BIGNUMERIC\"},\"parameterValue\":{\"value\":\"1.5\"}}]", "  param [{\"name\":\"xa\",\"parameterType\":{\"arrayType\":{\"type\":\"STRING\"},\"type\":\"ARRAY\"},\"parameterValue\":{\"arrayValues\":[{\"value\":\"a\"},{\"value\":\"b\"}]}}]", "  param [{\"name\":\"xs\",\"parameterType\":{\"structTypes\":[{\"name\":\"n\",\"type\":{\"type\":\"INT64\"}}],\"type\":\"STRUCT\"},\"parameterValue\":{\"structValues\":{\"n\":{\"value\":\"42\"}}}}]"]
    _ => fault("no case ${name}")
  }
}

