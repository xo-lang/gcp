test "oracle: dataset update" {
  let f = new_fake(os.net, [(200, DATASET_JSON)])
  let c = fake_client(os)
  var u = DatasetMetadataToUpdate{description: Some("new"), name: Some(""), default_table_expiration: Some(0s), default_partition_expiration: Some(3h), max_time_travel: Some(48h), storage_billing_model: Some("LOGICAL"), default_collation: Some(""), is_case_insensitive: Some(false), access: Some([AccessEntry{role: WRITER_ROLE, entity_type: EntityType.GroupEmail, entity: "g@example.com"}]), default_encryption_config: Some(EncryptionConfig{kms_key_name: "k2"})}
  u.set_label("a", "1")
  u.delete_label("env")
  ds(f, c.dataset("d1").update(u, "e1"))
