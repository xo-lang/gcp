test "oracle: table iam policy" {
  let f = new_fake(os.net, [(200, "{\"version\":1,\"etag\":\"BwU=\",\"bindings\":[{\"role\":\"roles/bigquery.dataViewer\",\"members\":[\"user:a@example.com\"]}]}"), (200, "{\"version\":1,\"etag\":\"BwY=\",\"bindings\":[{\"role\":\"roles/bigquery.dataViewer\",\"members\":[\"user:a@example.com\",\"group:g@example.com\"]}]}"), (200, "{\"permissions\":[\"bigquery.tables.get\"]}")])
  let c = fake_client(os)
  let h = c.dataset("d1").table("t1").iam()
  match h.policy() {
    Ok(p0) => {
      var p = p0
      note(f, "  members [${p.members("roles/bigquery.dataViewer").join(" ")}]")
      p.add("group:g@example.com", "roles/bigquery.dataViewer")
      unit(f, h.set_policy(p))
      strs(f, h.test_permissions(["bigquery.tables.get", "bigquery.tables.delete"]))
    }
    Err(e) => unit(f, Err(e))
  }
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/t1:getIamPolicy?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"options\":{\"requestedPolicyVersion\":1}}", "  members [user:a@example.com]", "  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/t1:setIamPolicy?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"policy\":{\"bindings\":[{\"members\":[\"user:a@example.com\",\"group:g@example.com\"],\"role\":\"roles/bigquery.dataViewer\"}],\"etag\":\"BwU=\",\"version\":1}}", "  ok", "  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/t1:testIamPermissions?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"permissions\":[\"bigquery.tables.get\",\"bigquery.tables.delete\"]}", "  ok [\"bigquery.tables.get\"]"]
}

