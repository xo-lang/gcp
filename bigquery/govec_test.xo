test "oracle: client, project and location" {
  let f = new_fake(os.net, [])
  let c = fake_client(os)
  let d = c.dataset("d1")
  note(f, "  project ${c.project_id()}")
  note(f, "  dataset ${d.project_id} ${d.dataset_id}")
  for x in [IdentifierFormat.LegacySql, IdentifierFormat.StandardSql, IdentifierFormat.StorageApiResource] {
    note(f, "  table id ${id_line(d.table("t1").identifier(x))}")
    note(f, "  dataset id ${id_line(d.identifier(x))}")
  }
  note(f, "  fq ${d.table("t1").fully_qualified_name()} ${d.routine("r1").fully_qualified_name()} ${d.model("m1").fully_qualified_name()}")
  expect(lines(f)) == ["  project p1", "  dataset p1 d1", "  table id \"p1:d1.t1\" <nil>", "  dataset id \"p1:d1\" <nil>", "  table id \"p1.d1.t1\" <nil>", "  dataset id \"p1.d1\" <nil>", "  table id \"projects/p1/datasets/d1/tables/t1\" <nil>", "  dataset id \"\" unknown identifier format", "  fq p1:d1.t1 p1.d1.r1 p1:d1.m1"]
}

