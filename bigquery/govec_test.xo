test "oracle: dataset create" {
  let f = new_fake(os.net, [(200, DATASET_JSON)])
  var c = fake_client(os)
  c.location = "EU"
  unit(f, c.dataset("d1").create(Some(DatasetMetadata{name: "D one", description: "a dataset", default_table_expiration: 1h, default_partition_expiration: 2h, labels: {"env": "test"}, max_time_travel: 96h, storage_billing_model: "PHYSICAL", default_collation: "und:ci", access: [AccessEntry{role: OWNER_ROLE, entity_type: EntityType.UserEmail, entity: "a@example.com"}, AccessEntry{role: READER_ROLE, entity_type: EntityType.SpecialGroup, entity: "projectReaders"}, AccessEntry{entity_type: EntityType.View, view: Some(c.dataset("d2").table("v1").ref())}, AccessEntry{role: READER_ROLE, entity_type: EntityType.IamMember, entity: "allUsers"}, AccessEntry{entity_type: EntityType.Routine, routine: Some(c.dataset("d1").routine("r1").ref())}], default_encryption_config: Some(EncryptionConfig{kms_key_name: "k1"}), is_case_insensitive: true})))
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"access\":[{\"role\":\"OWNER\",\"userByEmail\":\"a@example.com\"},{\"role\":\"READER\",\"specialGroup\":\"projectReaders\"},{\"view\":{\"datasetId\":\"d2\",\"projectId\":\"p1\",\"tableId\":\"v1\"}},{\"iamMember\":\"allUsers\",\"role\":\"READER\"},{\"routine\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"routineId\":\"r1\"}}],\"datasetReference\":{\"datasetId\":\"d1\"},\"defaultCollation\":\"und:ci\",\"defaultEncryptionConfiguration\":{\"kmsKeyName\":\"k1\"},\"defaultPartitionExpirationMs\":\"7200000\",\"defaultTableExpirationMs\":\"3600000\",\"description\":\"a dataset\",\"friendlyName\":\"D one\",\"isCaseInsensitive\":true,\"labels\":{\"env\":\"test\"},\"location\":\"EU\",\"maxTimeTravelHours\":\"96\",\"storageBillingModel\":\"PHYSICAL\"}", "  ok"]
}

