test "oracle: schema from json and back" {
  let f = new_fake(os.net, [])
  match schema_from_json("[{\"name\":\"id\",\"type\":\"INTEGER\",\"mode\":\"REQUIRED\"},{\"name\":\"r\",\"type\":\"RECORD\",\"mode\":\"REPEATED\",\"fields\":[{\"name\":\"x\",\"type\":\"FLOAT\"},{\"name\":\"g\",\"type\":\"GEOGRAPHY\"}]},{\"name\":\"j\",\"type\":\"JSON\",\"description\":\"d\"},{\"name\":\"b\",\"type\":\"BIGNUMERIC\",\"precision\":\"40\",\"scale\":\"10\"}]".bytes()) {
    Ok(sc) => {
      sch(f, Ok(sc))
      note(f, "  fields ${canon_text(to_json_fields(sc))} <nil>")
      sch(f, Ok(relax(sc)))
    }
    Err(e) => sch(f, Err(e))
  }
  expect(lines(f)) == ["  ok [{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"\",\"MaxLength\":0,\"Name\":\"id\",\"PolicyTags\":null,\"Precision\":0,\"RangeElementType\":null,\"Repeated\":false,\"Required\":true,\"RoundingMode\":\"\",\"Scale\":0,\"Schema\":null,\"TimestampPrecision\":0,\"Type\":\"INTEGER\"},{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"\",\"MaxLength\":0,\"Name\":\"r\",\"PolicyTags\":null,\"Precision\":0,\"RangeElementType\":null,\"Repeated\":true,\"Required\":false,\"RoundingMode\":\"\",\"Scale\":0,\"Schema\":[{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"\",\"MaxLength\":0,\"Name\":\"x\",\"PolicyTags\":null,\"Precision\":0,\"RangeElementType\":null,\"Repeated\":false,\"Required\":false,\"RoundingMode\":\"\",\"Scale\":0,\"Schema\":null,\"TimestampPrecision\":0,\"Type\":\"FLOAT\"},{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"\",\"MaxLength\":0,\"Name\":\"g\",\"PolicyTags\":null,\"Precision\":0,\"RangeElementType\":null,\"Repeated\":false,\"Required\":false,\"RoundingMode\":\"\",\"Scale\":0,\"Schema\":null,\"TimestampPrecision\":0,\"Type\":\"GEOGRAPHY\"}],\"TimestampPrecision\":0,\"Type\":\"RECORD\"},{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"d\",\"MaxLength\":0,\"Name\":\"j\",\"PolicyTags\":null,\"Precision\":0,\"RangeElementType\":null,\"Repeated\":false,\"Required\":false,\"RoundingMode\":\"\",\"Scale\":0,\"Schema\":null,\"TimestampPrecision\":0,\"Type\":\"JSON\"},{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"\",\"MaxLength\":0,\"Name\":\"b\",\"PolicyTags\":null,\"Precision\":40,\"RangeElementType\":null,\"Repeated\":false,\"Required\":false,\"RoundingMode\":\"\",\"Scale\":10,\"Schema\":null,\"TimestampPrecision\":0,\"Type\":\"BIGNUMERIC\"}]", "  fields [{\"mode\":\"REQUIRED\",\"name\":\"id\",\"type\":\"INTEGER\"},{\"fields\":[{\"name\":\"x\",\"type\":\"FLOAT\"},{\"name\":\"g\",\"type\":\"GEOGRAPHY\"}],\"mode\":\"REPEATED\",\"name\":\"r\",\"type\":\"RECORD\"},{\"description\":\"d\",\"name\":\"j\",\"type\":\"JSON\"},{\"name\":\"b\",\"precision\":\"40\",\"scale\":\"10\",\"type\":\"BIGNUMERIC\"}] <nil>", "  ok [{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"\",\"MaxLength\":0,\"Name\":\"id\",\"PolicyTags\":null,\"Precision\":0,\"RangeElementType\":null,\"Repeated\":false,\"Required\":false,\"RoundingMode\":\"\",\"Scale\":0,\"Schema\":null,\"TimestampPrecision\":0,\"Type\":\"INTEGER\"},{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"\",\"MaxLength\":0,\"Name\":\"r\",\"PolicyTags\":null,\"Precision\":0,\"RangeElementType\":null,\"Repeated\":true,\"Required\":false,\"RoundingMode\":\"\",\"Scale\":0,\"Schema\":[{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"\",\"MaxLength\":0,\"Name\":\"x\",\"PolicyTags\":null,\"Precision\":0,\"RangeElementType\":null,\"Repeated\":false,\"Required\":false,\"RoundingMode\":\"\",\"Scale\":0,\"Schema\":null,\"TimestampPrecision\":0,\"Type\":\"FLOAT\"},{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"\",\"MaxLength\":0,\"Name\":\"g\",\"PolicyTags\":null,\"Precision\":0,\"RangeElementType\":null,\"Repeated\":false,\"Required\":false,\"RoundingMode\":\"\",\"Scale\":0,\"Schema\":null,\"TimestampPrecision\":0,\"Type\":\"GEOGRAPHY\"}],\"TimestampPrecision\":0,\"Type\":\"RECORD\"},{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"d\",\"MaxLength\":0,\"Name\":\"j\",\"PolicyTags\":null,\"Precision\":0,\"RangeElementType\":null,\"Repeated\":false,\"Required\":false,\"RoundingMode\":\"\",\"Scale\":0,\"Schema\":null,\"TimestampPrecision\":0,\"Type\":\"JSON\"},{\"Collation\":\"\",\"DefaultValueExpression\":\"\",\"Description\":\"\",\"MaxLength\":0,\"Name\":\"b\",\"PolicyTags\":null,\"Precision\":0,\"RangeElementType\":null,\"Repeated\":false,\"Required\":false,\"RoundingMode\":\"\",\"Scale\":0,\"Schema\":null,\"TimestampPrecision\":0,\"Type\":\"BIGNUMERIC\"}]"]
}

test "oracle: schema from json, bad" {
  let f = new_fake(os.net, [])
  sch(f, schema_from_json("{\"name\":\"x\"}".bytes()))
  sch(f, schema_from_json("[{\"name\":\"x\",\"type\":\"NOPE\"}]".bytes()))
  expect(lines(f)) == ["  error at \$: expected array", "  error unknown field type (NOPE)"]
}
