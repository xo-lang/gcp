pub fn (r: TablesService[fx]) list(project_id: Str, dataset_id: Str, options: TablesListOptions = TablesListOptions{}) -> TableList ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.max_results {
    q.set("maxResults", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "projects/{+projectId}/datasets/{+datasetId}/tables"), {"projectId": project_id, "datasetId": dataset_id})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[TableList](resp)
}

/// TablesListPages: the pages of TablesService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct TablesListPages[fx: Effects] {
  r: TablesService[fx]
  project_id: Str
  dataset_id: Str
  options: TablesListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: TablesService.list's pages, from the first.
pub fn (r: TablesService[fx]) list_pages(project_id: Str, dataset_id: Str, options: TablesListOptions = TablesListOptions{}) -> TablesListPages[fx] {
  TablesListPages{r: r, project_id: project_id, dataset_id: dataset_id, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: TablesListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: TablesListPages[fx]) next_page() -> TableList ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.project_id, p.dataset_id, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

/// TablesPatchOptions: the optional parameters of TablesService.patch.
pub struct TablesPatchOptions {
  /// Optional.  When true will autodetect schema, else will keep original schema
  pub autodetect_schema: Bool? = None
  /// The fields of the result to return (Go's Fields), joined with commas.
  pub fields: List[Str] = []
  /// More request headers (Go's Header).
  pub headers: List[(Str, Str)] = []
}

/// patch: Updates information in an existing table. The update method replaces the entire table resource, whereas the patch method only replaces fields that are provided in the submitted table resource. This method supports RFC5789 patch semantics. # IAM Permissions Requires the following IAM permission(s) on the table: - `bigquery.tables.update` - `bigquery.tables.get`
/// (Go's bigquery.tables.patch.)
pub fn (r: TablesService[fx]) patch(project_id: Str, dataset_id: Str, table_id: Str, table: Table, options: TablesPatchOptions = TablesPatchOptions{}) -> Table ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.autodetect_schema {
    q.set("autodetect_schema", "${v}")
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs.push(("Content-Type", "application/json"))
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "projects/{+projectId}/datasets/{+datasetId}/tables/{+tableId}"), {"projectId": project_id, "datasetId": dataset_id, "tableId": table_id})
  let resp = r.core.client.send(gensupport.Request{method: "PATCH", url: u, query: q, headers: hs, body: gensupport.json_body(table, data_wrapper: false, marks: if table.body_marked() { Some(table.body_mark(gensupport.body_value(table))) } else { None })})?
  gensupport.check(resp)?
  gensupport.decode[Table](resp)
}

