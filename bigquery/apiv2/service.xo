/// (Go's bigquery.tables.update.)
pub fn (r: TablesService[fx]) update(project_id: Str, dataset_id: Str, table_id: Str, table: Table, options: TablesUpdateOptions = TablesUpdateOptions{}) -> Table ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
