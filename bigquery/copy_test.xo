}

test "jobs 4 oracle: copy run, restore and clone, rate limit retried" {
  let f = new_fake(os.net, [(400, JOB_RATE_LIMITED), (200, job_running()), (200, job_running())])
  let c = jobs_client(os)
  var cp = c.dataset("d1").table("out").copier_from([c.dataset("d1").table("snap")])
  cp.config.operation_type = RESTORE_OPERATION
  cp.config.write_disposition = WRITE_EMPTY
  job_line(f, cp.run())
  var cl = c.dataset("d1").table("out2").copier_from([c.dataset("d1").table("a")])
  cl.config.operation_type = CLONE_OPERATION
  job_line(f, cl.run())
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"copy\":{\"destinationTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"out\"},\"operationType\":\"RESTORE\",\"sourceTables\":[{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"snap\"}],\"writeDisposition\":\"WRITE_EMPTY\"}},\"jobReference\":{\"jobId\":\"RANDOMID\",\"projectId\":\"p1\"}}", "  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"copy\":{\"destinationTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"out\"},\"operationType\":\"RESTORE\",\"sourceTables\":[{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"snap\"}],\"writeDisposition\":\"WRITE_EMPTY\"}},\"jobReference\":{\"jobId\":\"RANDOMID\",\"projectId\":\"p1\"}}", "  job p1 job1 US \"\"", "  status Running done=false err=<nil>", "  stats created=2023-11-14T22:13:20Z start=zero end=zero bytes=0 slotms=0 children=0 parent=\"\" ratio=0 reservation=\"\"", "  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"copy\":{\"destinationTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"out2\"},\"operationType\":\"CLONE\",\"sourceTables\":[{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"a\"}]}},\"jobReference\":{\"jobId\":\"RANDOMID\",\"projectId\":\"p1\"}}", "  job p1 job1 US \"\"", "  status Running done=false err=<nil>", "  stats created=2023-11-14T22:13:20Z start=zero end=zero bytes=0 slotms=0 children=0 parent=\"\" ratio=0 reservation=\"\""]
}

