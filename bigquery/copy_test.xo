test "jobs 4 oracle: query run, table definitions" {
  let f = new_fake(os.net, [(200, job_running()), (200, job_running())])
  let c = jobs_client(os)
  var g = new_gcs_reference(["gs://b/g.csv"])
  g.file_config.csv.field_delimiter = ";"
  g.file_config.csv.skip_leading_rows = 1
  g.file_config.schema = Some([FieldSchema{name: "a", type_: STRING_FIELD_TYPE}])
  var a = new_gcs_reference(["gs://b/a.avro"])
  a.file_config.source_format = AVRO
  a.file_config.avro_options = Some(AvroOptions{use_avro_logical_types: true})
  a.file_config.csv.field_delimiter = "ignored"
  a.compression = GZIP
  var q = c.query("SELECT * FROM e, g, a")
  q.config.table_definitions = Some({"e": ExternalData.Config(ExternalDataConfig{source_format: JSON, source_uris: ["gs://b/e.json"], options: Some(ExternalDataConfigOptions.Json(JSONOptions{encoding: ISO_8859_1}))}), "g": ExternalData.Gcs(g), "a": ExternalData.Gcs(a)})
  job_line(f, q.run())
  var q2 = c.query("SELECT 1")
  q2.config.table_definitions = Some({})
  job_line(f, q2.run())
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"query\":{\"query\":\"SELECT * FROM e, g, a\",\"tableDefinitions\":{\"a\":{\"avroOptions\":{\"useAvroLogicalTypes\":true},\"compression\":\"GZIP\",\"sourceFormat\":\"AVRO\",\"sourceUris\":[\"gs://b/a.avro\"]},\"e\":{\"jsonOptions\":{\"encoding\":\"ISO-8859-1\"},\"sourceFormat\":\"NEWLINE_DELIMITED_JSON\",\"sourceUris\":[\"gs://b/e.json\"]},\"g\":{\"csvOptions\":{\"fieldDelimiter\":\";\",\"skipLeadingRows\":\"1\"},\"schema\":{\"fields\":[{\"name\":\"a\",\"type\":\"STRING\"}]},\"sourceFormat\":\"CSV\",\"sourceUris\":[\"gs://b/g.csv\"]}},\"useLegacySql\":false}},\"jobReference\":{\"jobId\":\"RANDOMID\",\"projectId\":\"p1\"}}", "  job p1 job1 US \"\"", "  status Running done=false err=<nil>", "  stats created=2023-11-14T22:13:20Z start=zero end=zero bytes=0 slotms=0 children=0 parent=\"\" ratio=0 reservation=\"\"", "  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"query\":{\"query\":\"SELECT 1\",\"useLegacySql\":false}},\"jobReference\":{\"jobId\":\"RANDOMID\",\"projectId\":\"p1\"}}", "  job p1 job1 US \"\"", "  status Running done=false err=<nil>", "  stats created=2023-11-14T22:13:20Z start=zero end=zero bytes=0 slotms=0 children=0 parent=\"\" ratio=0 reservation=\"\""]
}

