const COPY_JOB: Str = "{\"kind\":\"bigquery#job\",\"jobReference\":{\"projectId\":\"p1\",\"jobId\":\"c1\",\"location\":\"EU\"},\"configuration\":{\"copy\":{\"sourceTables\":[{\"projectId\":\"p1\",\"datasetId\":\"d1\",\"tableId\":\"a\"},{\"projectId\":\"p2\",\"datasetId\":\"d2\",\"tableId\":\"b\"}],\"destinationTable\":{\"projectId\":\"p1\",\"datasetId\":\"d1\",\"tableId\":\"out\"},\"createDisposition\":\"CREATE_NEVER\",\"writeDisposition\":\"WRITE_TRUNCATE\",\"operationType\":\"SNAPSHOT\",\"destinationEncryptionConfiguration\":{\"kmsKeyName\":\"k1\"}},\"labels\":{\"k\":\"v\"},\"jobTimeoutMs\":\"90000\",\"reservation\":\"r1\",\"maxSlots\":7},\"status\":{\"state\":\"RUNNING\"},\"statistics\":{\"creationTime\":\"1700000000000\"}}"
const EXTRACT_JOB: Str = "{\"kind\":\"bigquery#job\",\"jobReference\":{\"projectId\":\"p1\",\"jobId\":\"e1\",\"location\":\"US\"},\"configuration\":{\"extract\":{\"sourceTable\":{\"projectId\":\"p1\",\"datasetId\":\"d1\",\"tableId\":\"t1\"},\"destinationUris\":[\"gs://b/a-*.csv\",\"gs://b/b-*.csv\"],\"compression\":\"GZIP\",\"destinationFormat\":\"CSV\",\"fieldDelimiter\":\"|\",\"printHeader\":false,\"useAvroLogicalTypes\":true},\"labels\":{\"k\":\"v\"},\"jobTimeoutMs\":\"60000\",\"reservation\":\"r2\",\"maxSlots\":3},\"status\":{\"state\":\"DONE\"},\"statistics\":{\"creationTime\":\"1700000000000\",\"endTime\":\"1700000005000\",\"extract\":{\"destinationUriFileCounts\":[\"2\",\"1\"]}}}"
const MODEL_EXTRACT_JOB: Str = "{\"jobReference\":{\"projectId\":\"p1\",\"jobId\":\"m1\",\"location\":\"US\"},\"configuration\":{\"extract\":{\"sourceModel\":{\"projectId\":\"p1\",\"datasetId\":\"d1\",\"modelId\":\"m\"},\"destinationUris\":[\"gs://b/model\"],\"destinationFormat\":\"ML_TF_SAVED_MODEL\"}},\"status\":{\"state\":\"PENDING\"}}"
const PLAIN_EXTRACT_JOB: Str = "{\"jobReference\":{\"projectId\":\"p1\",\"jobId\":\"e2\",\"location\":\"US\"},\"configuration\":{\"extract\":{\"sourceTable\":{\"projectId\":\"p1\",\"datasetId\":\"d1\",\"tableId\":\"t1\"},\"destinationUris\":[\"gs://b/o.json\"],\"printHeader\":true}},\"status\":{\"state\":\"RUNNING\"}}"

test "copy and extract oracle: copy run, every option" {
  let f = new_fake(os.net, [(200, COPY_JOB)])
  let c = jobs_client(os)
  let d = c.dataset("d1")
  var cp = d.table("out").copier_from([d.table("a"), c.dataset_in_project("p2", "d2").table("b")])
  cp.config.create_disposition = CREATE_NEVER
  cp.config.write_disposition = WRITE_TRUNCATE
  cp.config.operation_type = SNAPSHOT_OPERATION
  cp.config.destination_encryption_config = Some(EncryptionConfig{kms_key_name: "k1"})
  cp.config.labels = {"k": "v"}
  cp.config.job_timeout = 90s
  cp.config.reservation = "r1"
  cp.config.max_slots = 7
  cp.id.job_id = "c1"
  cp.id.location = "EU"
  if let Some(j) = job_line(f, cp.run()) {
    config_line(f, j)
  }
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"copy\":{\"createDisposition\":\"CREATE_NEVER\",\"destinationEncryptionConfiguration\":{\"kmsKeyName\":\"k1\"},\"destinationTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"out\"},\"operationType\":\"SNAPSHOT\",\"sourceTables\":[{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"a\"},{\"datasetId\":\"d2\",\"projectId\":\"p2\",\"tableId\":\"b\"}],\"writeDisposition\":\"WRITE_TRUNCATE\"},\"jobTimeoutMs\":\"90000\",\"labels\":{\"k\":\"v\"},\"maxSlots\":7,\"reservation\":\"r1\"},\"jobReference\":{\"jobId\":\"c1\",\"location\":\"EU\",\"projectId\":\"p1\"}}", "  job p1 c1 EU \"\"", "  status Running done=false err=<nil>", "  stats created=2023-11-14T22:13:20Z start=zero end=zero bytes=0 slotms=0 children=0 parent=\"\" ratio=0 reservation=\"\"", "  config copy srcs=[p1:d1.a p2:d2.b] dst=p1:d1.out create=\"CREATE_NEVER\" write=\"WRITE_TRUNCATE\" op=\"SNAPSHOT\" kms=k1 timeoutms=90000 reservation=\"r1\" slots=7 labels=map[k:v]"]
}

test "copy and extract oracle: copy run, defaults" {
  let f = new_fake(os.net, [(200, job_running())])
  var c = jobs_client(os)
  c.location = "asia-east1"
  var cp = c.dataset("d1").table("out").copier_from([c.dataset("d1").table("a")])
  cp.id.job_id = "pre"
  cp.id.add_job_id_suffix = true
  job_line(f, cp.run())
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"copy\":{\"destinationTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"out\"},\"sourceTables\":[{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"a\"}]}},\"jobReference\":{\"jobId\":\"pre-RANDOMID\",\"location\":\"asia-east1\",\"projectId\":\"p1\"}}", "  job p1 job1 US \"\"", "  status Running done=false err=<nil>", "  stats created=2023-11-14T22:13:20Z start=zero end=zero bytes=0 slotms=0 children=0 parent=\"\" ratio=0 reservation=\"\""]
}

test "copy and extract oracle: copy run, restore and clone, rate limit retried" {
  let f = new_fake(os.net, [(400, JOB_RATE_LIMITED), (200, job_running()), (200, job_running())])
  let c = jobs_client(os)
  var cp = c.dataset("d1").table("out").copier_from([c.dataset("d1").table("snap")])
  cp.config.operation_type = RESTORE_OPERATION
  cp.config.write_disposition = WRITE_EMPTY
  job_line(f, cp.run())
  var cl = c.dataset("d1").table("out2").copier_from([c.dataset("d1").table("a")])
  cl.config.operation_type = CLONE_OPERATION
  job_line(f, cl.run())
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"copy\":{\"destinationTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"out\"},\"operationType\":\"RESTORE\",\"sourceTables\":[{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"snap\"}],\"writeDisposition\":\"WRITE_EMPTY\"}},\"jobReference\":{\"jobId\":\"RANDOMID\",\"projectId\":\"p1\"}}", "  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"copy\":{\"destinationTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"out\"},\"operationType\":\"RESTORE\",\"sourceTables\":[{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"snap\"}],\"writeDisposition\":\"WRITE_EMPTY\"}},\"jobReference\":{\"jobId\":\"RANDOMID\",\"projectId\":\"p1\"}}", "  job p1 job1 US \"\"", "  status Running done=false err=<nil>", "  stats created=2023-11-14T22:13:20Z start=zero end=zero bytes=0 slotms=0 children=0 parent=\"\" ratio=0 reservation=\"\"", "  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"copy\":{\"destinationTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"out2\"},\"operationType\":\"CLONE\",\"sourceTables\":[{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"a\"}]}},\"jobReference\":{\"jobId\":\"RANDOMID\",\"projectId\":\"p1\"}}", "  job p1 job1 US \"\"", "  status Running done=false err=<nil>", "  stats created=2023-11-14T22:13:20Z start=zero end=zero bytes=0 slotms=0 children=0 parent=\"\" ratio=0 reservation=\"\""]
}

