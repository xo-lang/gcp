test "copy and extract oracle: extract run, every option" {
  let f = new_fake(os.net, [(200, EXTRACT_JOB)])
  var g = new_gcs_reference(["gs://b/a-*.csv", "gs://b/b-*.csv"])
  g.compression = GZIP
  g.destination_format = CSV
  g.file_config.csv.field_delimiter = "|"
  var e = jobs_client(os).dataset("d1").table("t1").extractor_to(g)
  e.config.disable_header = true
  e.config.use_avro_logical_types = true
  e.config.labels = {"k": "v"}
  e.config.job_timeout = 1m
  e.config.reservation = "r2"
  e.config.max_slots = 3
  e.id.job_id = "e1"
  if let Some(j) = job_line(f, e.run()) {
    config_line(f, j)
  }
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"extract\":{\"compression\":\"GZIP\",\"destinationFormat\":\"CSV\",\"destinationUris\":[\"gs://b/a-*.csv\",\"gs://b/b-*.csv\"],\"fieldDelimiter\":\"|\",\"printHeader\":false,\"sourceTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"t1\"},\"useAvroLogicalTypes\":true},\"jobTimeoutMs\":\"60000\",\"labels\":{\"k\":\"v\"},\"maxSlots\":3,\"reservation\":\"r2\"},\"jobReference\":{\"jobId\":\"e1\",\"projectId\":\"p1\"}}", "  job p1 e1 US \"\"", "  status Done done=true err=<nil>", "  stats created=2023-11-14T22:13:20Z start=zero end=2023-11-14T22:13:25Z bytes=0 slotms=0 children=0 parent=\"\" ratio=0 reservation=\"\"", "  extract [2 1]", "  config extract src=p1:d1.t1 model=\"\" uris=[gs://b/a-*.csv gs://b/b-*.csv] compression=\"GZIP\" format=\"CSV\" delim=\"|\" noheader=true avro=true timeoutms=60000 reservation=\"r2\" slots=3 labels=map[k:v]"]
}

