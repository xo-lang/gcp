test "copy and extract oracle: extract run, 503 retried, then not found" {
  let f = new_fake(os.net, [(503, BACKEND_ERR), (404, TABLE_NOT_FOUND)])
  job_line(f, jobs_client(os).dataset("d1").table("t1").extractor_to(new_gcs_reference(["gs://b/o"])).run())
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"extract\":{\"destinationUris\":[\"gs://b/o\"],\"sourceTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"t1\"}}},\"jobReference\":{\"jobId\":\"RANDOMID\",\"projectId\":\"p1\"}}", "  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"extract\":{\"destinationUris\":[\"gs://b/o\"],\"sourceTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"t1\"}}},\"jobReference\":{\"jobId\":\"RANDOMID\",\"projectId\":\"p1\"}}", "  error googleapi: Error 404: Not found: Table p1:d1.t1, notFound", "  googleapi code=404"]
