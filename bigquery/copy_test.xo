test "jobs 4 oracle: load run from gcs, every option" {
  let f = new_fake(os.net, [(200, LOAD_FULL_JOB)])
  var g = new_gcs_reference(["gs://b/x-*.csv"])
  g.file_config.source_format = CSV
  g.file_config.auto_detect = true
  g.file_config.max_bad_records = 3
  g.file_config.ignore_unknown_values = true
  g.file_config.schema = Some([FieldSchema{name: "id", type_: INTEGER_FIELD_TYPE}, FieldSchema{name: "name", type_: STRING_FIELD_TYPE}])
  g.file_config.csv.skip_leading_rows = 1
  g.file_config.csv.allow_jagged_rows = true
  g.file_config.csv.allow_quoted_newlines = true
  g.file_config.csv.encoding = ISO_8859_1
  g.file_config.csv.field_delimiter = ";"
  g.file_config.csv.quote = "'"
  g.file_config.csv.null_marker = "NA"
  g.file_config.csv.null_markers = ["NA", "-"]
  g.file_config.csv.source_column_match = SOURCE_COLUMN_MATCH_NAME
  g.file_config.csv.preserve_ascii_control_characters = true
  g.file_config.time_zone = "UTC"
  g.file_config.date_format = "YYYY-MM-DD"
  g.file_config.datetime_format = "YYYY-MM-DD HH24:MI:SS"
  g.file_config.time_format = "HH24:MI:SS"
  g.file_config.timestamp_format = "YYYY-MM-DD HH24:MI:SS"
  g.file_config.parquet_options = Some(ParquetOptions{enum_as_string: true})
  g.file_config.avro_options = Some(AvroOptions{use_avro_logical_types: true})
  var l = jobs_client(os).dataset("d1").table("t1").loader_from(LoadSource.Gcs(g))
  l.config.create_disposition = CREATE_IF_NEEDED
  l.config.write_disposition = WRITE_APPEND
  l.config.time_partitioning = Some(TimePartitioning{field: "at", expiration: 48h})
  l.config.range_partitioning = Some(RangePartitioning{field: "n", range: Some(RangePartitioningRange{start: 0, end: 100, interval: 10})})
  l.config.clustering = Some(Clustering{fields: ["name"]})
  l.config.destination_encryption_config = Some(EncryptionConfig{kms_key_name: "k1"})
  l.config.schema_update_options = ["ALLOW_FIELD_ADDITION"]
  l.config.projection_fields = ["a"]
  l.config.hive_partitioning_options = Some(HivePartitioningOptions{mode: AUTO_HIVE_PARTITIONING_MODE, source_uri_prefix: "gs://b/", require_partition_filter: true})
  l.config.decimal_target_types = [NUMERIC_TARGET_TYPE, STRING_TARGET_TYPE]
  l.config.reference_file_schema_uri = "gs://b/ref"
  l.config.create_session = true
  l.config.connection_properties = [ConnectionProperty{key: "time_zone", value: "UTC"}]
  l.config.column_name_character_map = V2_COLUMN_NAME_CHARACTER_MAP
  l.config.labels = {"k": "v"}
  l.config.job_timeout = 30s
  l.config.reservation = "r3"
  l.config.max_slots = 5
  l.id.job_id = "l2"
  if let Some(j) = job_line(f, l.run()) {
    config_line(f, j)
  }
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"jobTimeoutMs\":\"30000\",\"labels\":{\"k\":\"v\"},\"load\":{\"allowJaggedRows\":true,\"allowQuotedNewlines\":true,\"autodetect\":true,\"clustering\":{\"fields\":[\"name\"]},\"columnNameCharacterMap\":\"V2\",\"connectionProperties\":[{\"key\":\"time_zone\",\"value\":\"UTC\"}],\"createDisposition\":\"CREATE_IF_NEEDED\",\"createSession\":true,\"dateFormat\":\"YYYY-MM-DD\",\"datetimeFormat\":\"YYYY-MM-DD HH24:MI:SS\",\"decimalTargetTypes\":[\"NUMERIC\",\"STRING\"],\"destinationEncryptionConfiguration\":{\"kmsKeyName\":\"k1\"},\"destinationTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"t1\"},\"encoding\":\"ISO-8859-1\",\"fieldDelimiter\":\";\",\"hivePartitioningOptions\":{\"mode\":\"AUTO\",\"requirePartitionFilter\":true,\"sourceUriPrefix\":\"gs://b/\"},\"ignoreUnknownValues\":true,\"maxBadRecords\":3,\"nullMarker\":\"NA\",\"nullMarkers\":[\"NA\",\"-\"],\"parquetOptions\":{\"enumAsString\":true},\"preserveAsciiControlCharacters\":true,\"projectionFields\":[\"a\"],\"quote\":\"'\",\"rangePartitioning\":{\"field\":\"n\",\"range\":{\"end\":\"100\",\"interval\":\"10\",\"start\":\"0\"}},\"referenceFileSchemaUri\":\"gs://b/ref\",\"schema\":{\"fields\":[{\"name\":\"id\",\"type\":\"INTEGER\"},{\"name\":\"name\",\"type\":\"STRING\"}]},\"schemaUpdateOptions\":[\"ALLOW_FIELD_ADDITION\"],\"skipLeadingRows\":1,\"sourceColumnMatch\":\"NAME\",\"sourceFormat\":\"CSV\",\"sourceUris\":[\"gs://b/x-*.csv\"],\"timeFormat\":\"HH24:MI:SS\",\"timePartitioning\":{\"expirationMs\":\"172800000\",\"field\":\"at\",\"type\":\"DAY\"},\"timeZone\":\"UTC\",\"timestampFormat\":\"YYYY-MM-DD HH24:MI:SS\",\"useAvroLogicalTypes\":true,\"writeDisposition\":\"WRITE_APPEND\"},\"maxSlots\":5,\"reservation\":\"r3\"},\"jobReference\":{\"jobId\":\"l2\",\"projectId\":\"p1\"}}", "  job p1 l2 US \"\"", "  status Running done=false err=<nil>", "  config load src=gcs[gs://b/x-*.csv] dst=p1:d1.t1 create=\"CREATE_IF_NEEDED\" write=\"WRITE_APPEND\" time=DAY/at/172800000/false range=n[0,100,10] cluster=[name] kms=k1 update=[ALLOW_FIELD_ADDITION] projection=[a] hive=AUTO/gs://b//true decimal=[NUMERIC STRING] timeoutms=30000 refschema=\"gs://b/ref\" session=true conn=[time_zone=UTC] colmap=\"V2\" reservation=\"r3\" slots=5 avro=true labels=map[k:v]", "  file format=\"CSV\" auto=true maxbad=3 ignore=true schema=[id:INTEGER name:STRING] skip=1 jagged=true qnl=true enc=\"ISO-8859-1\" delim=\";\" quote=\"'\" zeroquote=false null=\"NA\" nulls=[NA -] match=\"NAME\" ascii=true tz=\"UTC\" date=\"YYYY-MM-DD\" datetime=\"YYYY-MM-DD HH24:MI:SS\" time=\"HH24:MI:SS\" timestamp=\"YYYY-MM-DD HH24:MI:SS\" parquet=false avro=false"]
}

