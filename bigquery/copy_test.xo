test "copy, extract and load oracle: copy run, every option" {
  let f = new_fake(os.net, [(200, COPY_JOB)])
  let c = jobs_client(os)
  let d = c.dataset("d1")
  var cp = d.table("out").copier_from([d.table("a"), c.dataset_in_project("p2", "d2").table("b")])
  cp.config.create_disposition = CREATE_NEVER
  cp.config.write_disposition = WRITE_TRUNCATE
  cp.config.operation_type = SNAPSHOT_OPERATION
  cp.config.destination_encryption_config = Some(EncryptionConfig{kms_key_name: "k1"})
  cp.config.labels = {"k": "v"}
  cp.config.job_timeout = 90s
  cp.config.reservation = "r1"
  cp.config.max_slots = 7
  cp.id.job_id = "c1"
  cp.id.location = "EU"
  if let Some(j) = job_line(f, cp.run()) {
    config_line(f, j)
  }
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"copy\":{\"createDisposition\":\"CREATE_NEVER\",\"destinationEncryptionConfiguration\":{\"kmsKeyName\":\"k1\"},\"destinationTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"out\"},\"operationType\":\"SNAPSHOT\",\"sourceTables\":[{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"a\"},{\"datasetId\":\"d2\",\"projectId\":\"p2\",\"tableId\":\"b\"}],\"writeDisposition\":\"WRITE_TRUNCATE\"},\"jobTimeoutMs\":\"90000\",\"labels\":{\"k\":\"v\"},\"maxSlots\":7,\"reservation\":\"r1\"},\"jobReference\":{\"jobId\":\"c1\",\"location\":\"EU\",\"projectId\":\"p1\"}}", "  job p1 c1 EU \"\"", "  status Running done=false err=<nil>", "  stats created=2023-11-14T22:13:20Z start=zero end=zero bytes=0 slotms=0 children=0 parent=\"\" ratio=0 reservation=\"\"", "  config copy srcs=[p1:d1.a p2:d2.b] dst=p1:d1.out create=\"CREATE_NEVER\" write=\"WRITE_TRUNCATE\" op=\"SNAPSHOT\" kms=k1 timeoutms=90000 reservation=\"r1\" slots=7 labels=map[k:v]"]
}

