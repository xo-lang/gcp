}

test "jobs 4 oracle: table create, external data with every option" {
  let f = new_fake(os.net, [(200, EXT_TABLE)])
  let e = ExternalDataConfig{source_format: CSV, source_uris: ["gs://b/e-*.csv"], schema: Some([FieldSchema{name: "id", type_: INTEGER_FIELD_TYPE}]), auto_detect: true, compression: GZIP, ignore_unknown_values: true, max_bad_records: 2, hive_partitioning_options: Some(HivePartitioningOptions{mode: CUSTOM_HIVE_PARTITIONING_MODE, source_uri_prefix: "gs://b/{a:STRING}", require_partition_filter: true}), decimal_target_types: [BIGNUMERIC_TARGET_TYPE], connection_id: "p1.us.c1", reference_file_schema_uri: "gs://b/ref", metadata_cache_mode: AUTOMATIC_METADATA_CACHE_MODE, time_zone: "UTC", date_format: "YYYY-MM-DD", datetime_format: "YYYY-MM-DD HH24:MI", time_format: "HH24:MI", timestamp_format: "YYYY-MM-DD HH24:MI:SS", file_set_spec_type: FILE_SET_SPEC_TYPE_NEW_LINE_DELIMITED_MANIFEST, json_extension: JSON_EXTENSION_GEO_JSON, object_metadata: OBJECT_METADATA_SIMPLE, timestamp_target_precision: [6, 12], options: Some(ExternalDataConfigOptions.Csv(CSVOptions{allow_jagged_rows: true, allow_quoted_newlines: true, encoding: UTF_8, field_delimiter: "|", force_zero_quote: true, skip_leading_rows: 1, null_marker: "N", null_markers: ["N", "-"], source_column_match: SOURCE_COLUMN_MATCH_POSITION, preserve_ascii_control_characters: true}))}
  if let Err(x) = jobs_client(os).dataset("d1").table("x").create(Some(TableMetadata{external_data_config: Some(e)})) {
    err_line(f, x)
  }
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"externalDataConfiguration\":{\"autodetect\":true,\"compression\":\"GZIP\",\"connectionId\":\"p1.us.c1\",\"csvOptions\":{\"allowJaggedRows\":true,\"allowQuotedNewlines\":true,\"encoding\":\"UTF-8\",\"fieldDelimiter\":\"|\",\"nullMarker\":\"N\",\"nullMarkers\":[\"N\",\"-\"],\"preserveAsciiControlCharacters\":true,\"quote\":\"\",\"skipLeadingRows\":\"1\",\"sourceColumnMatch\":\"POSITION\"},\"dateFormat\":\"YYYY-MM-DD\",\"datetimeFormat\":\"YYYY-MM-DD HH24:MI\",\"decimalTargetTypes\":[\"BIGNUMERIC\"],\"fileSetSpecType\":\"FILE_SET_SPEC_TYPE_NEW_LINE_DELIMITED_MANIFEST\",\"hivePartitioningOptions\":{\"mode\":\"CUSTOM\",\"requirePartitionFilter\":true,\"sourceUriPrefix\":\"gs://b/{a:STRING}\"},\"ignoreUnknownValues\":true,\"jsonExtension\":\"GEOJSON\",\"maxBadRecords\":2,\"metadataCacheMode\":\"AUTOMATIC\",\"objectMetadata\":\"SIMPLE\",\"referenceFileSchemaUri\":\"gs://b/ref\",\"schema\":{\"fields\":[{\"name\":\"id\",\"type\":\"INTEGER\"}]},\"sourceFormat\":\"CSV\",\"sourceUris\":[\"gs://b/e-*.csv\"],\"timeFormat\":\"HH24:MI\",\"timeZone\":\"UTC\",\"timestampFormat\":\"YYYY-MM-DD HH24:MI:SS\",\"timestampTargetPrecision\":[6,12]},\"tableReference\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"x\"}}"]
}

test "jobs 4 oracle: table create, external bigtable, json, sheets, avro" {
  let f = new_fake(os.net, [(200, EXT_BIGTABLE), (200, EXT_JSON), (200, EXT_SHEETS), (200, EXT_KINDS)])
  let d = jobs_client(os).dataset("d1")
  let bt = BigtableOptions{ignore_unspecified_column_families: true, read_rowkey_as_string: true, column_families: [BigtableColumnFamily{family_id: "f1", encoding: "BINARY", only_read_latest: true, type_: "STRING", columns: [BigtableColumn{qualifier: "q1".bytes(), field_name: "q", only_read_latest: true, encoding: "TEXT", type_: "INTEGER"}, BigtableColumn{qualifier: b"\xff", field_name: "raw"}]}]}
  for o in [ExternalDataConfigOptions.Bigtable(bt), ExternalDataConfigOptions.Json(JSONOptions{encoding: UTF_8}), ExternalDataConfigOptions.GoogleSheets(GoogleSheetsOptions{skip_leading_rows: 2, range: "s1!A1:B9"}), ExternalDataConfigOptions.Avro(AvroOptions{use_avro_logical_types: true})] {
    if let Err(x) = d.table("k").create(Some(TableMetadata{external_data_config: Some(ExternalDataConfig{source_format: BIGTABLE, options: Some(o)})})) {
      err_line(f, x)
    }
  }
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"externalDataConfiguration\":{\"bigtableOptions\":{\"columnFamilies\":[{\"columns\":[{\"encoding\":\"TEXT\",\"fieldName\":\"q\",\"onlyReadLatest\":true,\"qualifierString\":\"q1\",\"type\":\"INTEGER\"},{\"fieldName\":\"raw\",\"qualifierEncoded\":\"/w\"}],\"encoding\":\"BINARY\",\"familyId\":\"f1\",\"onlyReadLatest\":true,\"type\":\"STRING\"}],\"ignoreUnspecifiedColumnFamilies\":true,\"readRowkeyAsString\":true},\"sourceFormat\":\"BIGTABLE\"},\"tableReference\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"k\"}}", "  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"externalDataConfiguration\":{\"jsonOptions\":{\"encoding\":\"UTF-8\"},\"sourceFormat\":\"BIGTABLE\"},\"tableReference\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"k\"}}", "  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"externalDataConfiguration\":{\"googleSheetsOptions\":{\"range\":\"s1!A1:B9\",\"skipLeadingRows\":\"2\"},\"sourceFormat\":\"BIGTABLE\"},\"tableReference\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"k\"}}", "  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"externalDataConfiguration\":{\"avroOptions\":{\"useAvroLogicalTypes\":true},\"sourceFormat\":\"BIGTABLE\"},\"tableReference\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"k\"}}"]
}

test "jobs 4 oracle: table get, external data of each kind" {
  let f = new_fake(os.net, [(200, EXT_TABLE), (200, EXT_BIGTABLE), (200, EXT_KINDS), (200, EXT_JSON), (200, EXT_SHEETS), (200, EXT_PARQUET), (200, EXT_NONE), (200, "{\"tableReference\":{\"projectId\":\"p1\",\"datasetId\":\"d1\",\"tableId\":\"k\"}}")])
  let t = jobs_client(os).dataset("d1").table("k")
  for _ in 0..8 {
    table_meta(f, t.metadata())
  }
  expect(lines(f)) == ["  GET https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/k?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "  ext table format=\"CSV\" uris=[gs://b/e-*.csv] schema=[id:INTEGER] nilschema=false auto=true compression=\"GZIP\" ignore=true maxbad=2 hive=CUSTOM/gs://b/{a:STRING}/true decimal=[BIGNUMERIC] conn=\"p1.us.c1\" refschema=\"gs://b/ref\" cache=\"AUTOMATIC\" tz=\"UTC\" date=\"YYYY-MM-DD\" datetime=\"YYYY-MM-DD HH24:MI\" time=\"HH24:MI\" timestamp=\"YYYY-MM-DD HH24:MI:SS\" fileset=\"FILE_SET_SPEC_TYPE_NEW_LINE_DELIMITED_MANIFEST\" jsonext=\"GEOJSON\" objmeta=\"SIMPLE\" precision=[6 12]", "    csv jagged=true qnl=true enc=\"UTF-8\" delim=\"|\" quote=\"\" zeroquote=true skip=1 null=\"N\" nulls=[N -] match=\"POSITION\" ascii=true", "  GET https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/k?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "  ext table format=\"BIGTABLE\" uris=[https://googleapis.com/bigtable/projects/p/instances/i/tables/t] schema=[] nilschema=true auto=false compression=\"\" ignore=false maxbad=0 hive=none decimal=[] conn=\"\" refschema=\"\" cache=\"\" tz=\"\" date=\"\" datetime=\"\" time=\"\" timestamp=\"\" fileset=\"\" jsonext=\"\" objmeta=\"\" precision=[]", "    bigtable ignore=true rowkey=true families=1", "    family \"f1\" enc=\"BINARY\" latest=true type=\"STRING\"", "    column \"q1\" field=\"q\" latest=true enc=\"TEXT\" type=\"INTEGER\"", "    column \"\\xff\" field=\"raw\" latest=false enc=\"\" type=\"\"", "  GET https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/k?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "  ext table format=\"AVRO\" uris=[] schema=[] nilschema=true auto=false compression=\"\" ignore=false maxbad=0 hive=none decimal=[] conn=\"\" refschema=\"\" cache=\"\" tz=\"\" date=\"\" datetime=\"\" time=\"\" timestamp=\"\" fileset=\"\" jsonext=\"\" objmeta=\"\" precision=[]", "    avro logical=true", "  GET https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/k?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "  ext table format=\"NEWLINE_DELIMITED_JSON\" uris=[] schema=[] nilschema=true auto=false compression=\"\" ignore=false maxbad=0 hive=none decimal=[] conn=\"\" refschema=\"\" cache=\"\" tz=\"\" date=\"\" datetime=\"\" time=\"\" timestamp=\"\" fileset=\"\" jsonext=\"\" objmeta=\"\" precision=[]", "    json enc=\"UTF-8\"", "  GET https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/k?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "  ext table format=\"GOOGLE_SHEETS\" uris=[] schema=[] nilschema=true auto=false compression=\"\" ignore=false maxbad=0 hive=none decimal=[] conn=\"\" refschema=\"\" cache=\"\" tz=\"\" date=\"\" datetime=\"\" time=\"\" timestamp=\"\" fileset=\"\" jsonext=\"\" objmeta=\"\" precision=[]", "    sheets skip=2 range=\"s1!A1:B9\"", "  GET https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/k?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "  ext table format=\"PARQUET\" uris=[] schema=[] nilschema=true auto=false compression=\"\" ignore=false maxbad=0 hive=none decimal=[] conn=\"\" refschema=\"\" cache=\"\" tz=\"\" date=\"\" datetime=\"\" time=\"\" timestamp=\"\" fileset=\"\" jsonext=\"\" objmeta=\"\" precision=[]", "    parquet enum=true list=true", "  GET https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/k?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "  ext table format=\"ORC\" uris=[] schema=[] nilschema=true auto=false compression=\"\" ignore=false maxbad=0 hive=none decimal=[] conn=\"\" refschema=\"\" cache=\"\" tz=\"\" date=\"\" datetime=\"\" time=\"\" timestamp=\"\" fileset=\"\" jsonext=\"\" objmeta=\"\" precision=[]", "    options none", "  GET https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/k?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "