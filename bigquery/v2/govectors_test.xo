  "OUT: {\"auditConfigs\":[{\"service\":\"s-service\"}],\"bindings\":[{\"condition\":{\"description\":\"s-description\",\"expression\":\"s-expression\",\"location\":\"s-location\",\"title\":\"s-title\"},\"members\":[\"s-members\"],\"role\":\"s-role\"}],\"etag\":\"YWI=\",\"version\":7}",
