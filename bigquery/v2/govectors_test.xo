  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"creationTime\":\"s-creationtime\",\"etag\":\"s-etag\",\"filterPredicate\":\"s-filterpredicate\",\"grantees\":[\"s-grantees\"],\"lastModifiedTime\":\"s-lastmodifiedtime\",\"rowAccessPolicyReference\":{\"datasetId\":\"s-datasetid\",\"policyId\":\"s-policyid\",\"projectId\":\"s-projectid\",\"tableId\":\"s-tableid\"}}")
  gv_note(f, "CALL bigquery.rowAccessPolicies.update")
  match svc.row_access_policies.update("id1/ x", "id2/ x", "id3/ x", "id4/ x", json.decode_str[RowAccessPolicy]("{\"creationTime\":\"s-creationtime\",\"etag\":\"s-etag\",\"filterPredicate\":\"s-filterpredicate\",\"grantees\":[\"s-grantees\"],\"lastModifiedTime\":\"s-lastmodifiedtime\",\"rowAccessPolicyReference\":{\"datasetId\":\"s-datasetid\",\"policyId\":\"s-policyid\",\"projectId\":\"s-projectid\",\"tableId\":\"s-tableid\"}}") ?? e => fault(e.display()), options: RowAccessPoliciesUpdateOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_35)
}

