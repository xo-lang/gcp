use std/json

const GV_HOST: Str = "https://bigquery.googleapis.com"

const GO_0: List[Str] = [
  "CALL bigquery.datasets.delete",
  "REQ DELETE https://bigquery.googleapis.com/bigquery/v2/projects/id1/%20x/datasets/id2/%20x?alt=json&deleteContents=true&fields=kind%2Cid&prettyPrint=false",
  "  H x-extra=v1",
  "  B ",
  "  SERVED 200 ",
  "OUT: ok",
]

test "Go's bigquery.datasets.delete" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "")
  gv_note(f, "CALL bigquery.datasets.delete")
  match svc.datasets.delete("id1/ x", "id2/ x", options: DatasetsDeleteOptions{delete_contents: Some(true), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(_) => gv_note(f, "OUT: ok")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

