test "Go's bigquery.tables.getIamPolicy" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"auditConfigs\":[{\"service\":\"s-service\"}],\"bindings\":[{\"condition\":{\"description\":\"s-description\",\"expression\":\"s-expression\",\"location\":\"s-location\",\"title\":\"s-title\"},\"members\":[\"s-members\"],\"role\":\"s-role\"}],\"etag\":\"YWI=\",\"version\":7}")
  gv_note(f, "CALL bigquery.tables.getIamPolicy")
  match svc.tables.get_iam_policy("id1/ x", json.decode_str[GetIamPolicyRequest]("{\"options\":{\"requestedPolicyVersion\":7}}") ?? e => fault(e.display()), options: TablesGetIamPolicyOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_40)
}

