} derive Json

/// PythonOptions: Options for a user-defined Python function.
pub struct PythonOptions {
  /// Required. The name of the function defined in Python code as the entry point when the Python UDF is invoked.
  pub entry_point as "entryPoint,omitempty": Str = ""
  /// Optional. A list of Python package names along with versions to be installed. Example: ["pandas>=2.1", "google-cloud-translate==3.11"]. For more information, see [Use third-party packages](https://cloud.google.com/bigquery/docs/user-defined-functions-python#third-party-packages).
  pub packages as "packages,omitempty": List[Str] = []
} derive Json

/// QueryInfo: Query optimization information for a QUERY job.
pub struct QueryInfo {
  /// Output only. Information about query optimizations.
  pub optimization_details as "optimizationDetails,omitempty": json.Value? = None
} derive Json

/// QueryParameter: A parameter given to a query.
pub struct QueryParameter {
  /// Optional. If unset, this is a positional parameter. Otherwise, should be unique within a query.
  pub name as "name,omitempty": Str = ""
  /// Required. The type of this parameter.
  pub parameter_type as "parameterType,omitempty": QueryParameterType? = None
  /// Required. The value of this parameter.
  pub parameter_value as "parameterValue,omitempty": QueryParameterValue? = None
} derive Json

/// QueryParameterType: The type of a query parameter.
pub struct QueryParameterType {
  /// Optional. The type of the array's elements, if this is an array.
