/// TrainingOptions: Options used in model training.
pub struct TrainingOptions {
  /// Activation function of the neural nets.
  pub activation_fn as "activationFn,omitempty": Str = ""
  /// If true, detect step changes and make data adjustment in the input time series.
  pub adjust_step_changes as "adjustStepChanges,omitempty": Bool = false
  /// Whether to use approximate feature contribution method in XGBoost model explanation for global explain.
  pub approx_global_feature_contrib as "approxGlobalFeatureContrib,omitempty": Bool = false
  /// Whether to enable auto ARIMA or not.
  pub auto_arima as "autoArima,omitempty": Bool = false
  /// The max value of the sum of non-seasonal p and q.
  pub auto_arima_max_order as "autoArimaMaxOrder,omitempty": Str = ""
  /// The min value of the sum of non-seasonal p and q.
  pub auto_arima_min_order as "autoArimaMinOrder,omitempty": Str = ""
  /// Whether to calculate class weights automatically based on the popularity of each label.
  pub auto_class_weights as "autoClassWeights,omitempty": Bool = false
  /// Batch size for dnn models.
  pub batch_size as "batchSize,omitempty": Str = ""
  /// Booster type for boosted tree models.
  pub booster_type as "boosterType,omitempty": Str = ""
  /// Budget in hours for AutoML training.
  pub budget_hours as "budgetHours,omitempty": Float = 0.0
  /// Whether or not p-value test should be computed for this model. Only available for linear and logistic regression models.
  pub calculate_p_values as "calculatePValues,omitempty": Bool = false
  /// Categorical feature encoding method.
  pub category_encoding_method as "categoryEncodingMethod,omitempty": Str = ""
  /// If true, clean spikes and dips in the input time series.
  pub clean_spikes_and_dips as "cleanSpikesAndDips,omitempty": Bool = false
  /// Enums for color space, used for processing images in Object Table. See more details at https://www.tensorflow.org/io/tutorials/colorspace.
  pub color_space as "colorSpace,omitempty": Str = ""
  /// Subsample ratio of columns for each level for boosted tree models.
  pub colsample_bylevel as "colsampleBylevel,omitempty": Float = 0.0
  /// Subsample ratio of columns for each node(split) for boosted tree models.
  pub colsample_bynode as "colsampleBynode,omitempty": Float = 0.0
  /// Subsample ratio of columns when constructing each tree for boosted tree models.
  pub colsample_bytree as "colsampleBytree,omitempty": Float = 0.0
  /// The contribution metric. Applies to contribution analysis models. Allowed formats supported are for summable and summable ratio contribution metrics. These include expressions such as `SUM(x)` or `SUM(x)/SUM(y)`, where x and y are column names from the base table.
  pub contribution_metric as "contributionMetric,omitempty": Str = ""
  /// Type of normalization algorithm for boosted tree models using dart booster.
  pub dart_normalize_type as "dartNormalizeType,omitempty": Str = ""
  /// The data frequency of a time series.
  pub data_frequency as "dataFrequency,omitempty": Str = ""
  /// The column to split data with. This column won't be used as a feature. 1. When data_split_method is CUSTOM, the corresponding column should be boolean. The rows with true value tag are eval data, and the false are training data. 2. When data_split_method is SEQ, the first DATA_SPLIT_EVAL_FRACTION rows (from smallest to largest) in the corresponding column are used as training data, and the rest are eval data. It respects the order in Orderable data types: https://cloud.google.com/bigquery/docs/reference/standard-sql/data-types#data_type_properties
  pub data_split_column as "dataSplitColumn,omitempty": Str = ""
  /// The fraction of evaluation data over the whole input data. The rest of data will be used as training data. The format should be double. Accurate to two decimal places. Default value is 0.2.
  pub data_split_eval_fraction as "dataSplitEvalFraction,omitempty": Float = 0.0
  /// The data split type for training and evaluation, e.g. RANDOM.
  pub data_split_method as "dataSplitMethod,omitempty": Str = ""
  /// If true, perform decompose time series and save the results.
  pub decompose_time_series as "decomposeTimeSeries,omitempty": Bool = false
  /// Optional. Names of the columns to slice on. Applies to contribution analysis models.
  pub dimension_id_columns as "dimensionIdColumns,omitempty": List[Str] = []
  /// Distance type for clustering models.
  pub distance_type as "distanceType,omitempty": Str = ""
  /// Dropout probability for dnn models.
  pub dropout as "dropout,omitempty": Float = 0.0
  /// Whether to stop early when the loss doesn't improve significantly any more (compared to min_relative_progress). Used only for iterative training algorithms.
  pub early_stop as "earlyStop,omitempty": Bool = false
  /// If true, enable global explanation during training.
  pub enable_global_explain as "enableGlobalExplain,omitempty": Bool = false
  /// The idle TTL of the endpoint before the resources get destroyed. The default value is 6.5 hours.
  pub endpoint_idle_ttl as "endpointIdleTtl,omitempty": Str = ""
  /// Feedback type that specifies which algorithm to run for matrix factorization.
  pub feedback_type as "feedbackType,omitempty": Str = ""
  /// Whether the model should include intercept during model training.
  pub fit_intercept as "fitIntercept,omitempty": Bool = false
  /// The forecast limit lower bound that was used during ARIMA model training with limits. To see more details of the algorithm: https://otexts.com/fpp2/limits.html
  pub forecast_limit_lower_bound as "forecastLimitLowerBound,omitempty": Float = 0.0
  /// The forecast limit upper bound that was used during ARIMA model training with limits.
  pub forecast_limit_upper_bound as "forecastLimitUpperBound,omitempty": Float = 0.0
  /// Hidden units for dnn models.
  pub hidden_units as "hiddenUnits,omitempty": List[Str] = []
  /// The geographical region based on which the holidays are considered in time series modeling. If a valid value is specified, then holiday effects modeling is enabled.
  pub holiday_region as "holidayRegion,omitempty": Str = ""
  /// A list of geographical regions that are used for time series modeling.
  pub holiday_regions as "holidayRegions,omitempty": List[Str] = []
  /// The number of periods ahead that need to be forecasted.
  pub horizon as "horizon,omitempty": Str = ""
  /// The target evaluation metrics to optimize the hyperparameters for.
  pub hparam_tuning_objectives as "hparamTuningObjectives,omitempty": List[Str] = []
  /// The id of a Hugging Face model. For example, `google/gemma-2-2b-it`.
  pub hugging_face_model_id as "huggingFaceModelId,omitempty": Str = ""
  /// Include drift when fitting an ARIMA model.
  pub include_drift as "includeDrift,omitempty": Bool = false
  /// Specifies the initial learning rate for the line search learn rate strategy.
  pub initial_learn_rate as "initialLearnRate,omitempty": Float = 0.0
  /// Name of input label columns in training data.
  pub input_label_columns as "inputLabelColumns,omitempty": List[Str] = []
  /// Name of the instance weight column for training data. This column isn't be used as a feature.
  pub instance_weight_column as "instanceWeightColumn,omitempty": Str = ""
  /// Number of integral steps for the integrated gradients explain method.
  pub integrated_gradients_num_steps as "integratedGradientsNumSteps,omitempty": Str = ""
  /// Name of the column used to determine the rows corresponding to control and test. Applies to contribution analysis models.
  pub is_test_column as "isTestColumn,omitempty": Str = ""
  /// Item column specified for matrix factorization models.
  pub item_column as "itemColumn,omitempty": Str = ""
  /// The column used to provide the initial centroids for kmeans algorithm when kmeans_initialization_method is CUSTOM.
  pub kmeans_initialization_column as "kmeansInitializationColumn,omitempty": Str = ""
  /// The method used to initialize the centroids for kmeans algorithm.
  pub kmeans_initialization_method as "kmeansInitializationMethod,omitempty": Str = ""
  /// L1 regularization coefficient to activations.
  pub l1_reg_activation as "l1RegActivation,omitempty": Float = 0.0
  /// L1 regularization coefficient.
  pub l1_regularization as "l1Regularization,omitempty": Float = 0.0
  /// L2 regularization coefficient.
  pub l2_regularization as "l2Regularization,omitempty": Float = 0.0
  /// Weights associated with each label class, for rebalancing the training data. Only applicable for classification models.
  pub label_class_weights as "labelClassWeights,omitempty": Map[Str, Float] = {}
  /// Learning rate in training. Used only for iterative training algorithms.
  pub learn_rate as "learnRate,omitempty": Float = 0.0
  /// The strategy to determine learn rate for the current iteration.
  pub learn_rate_strategy as "learnRateStrategy,omitempty": Str = ""
  /// Type of loss function used during training run.
  pub loss_type as "lossType,omitempty": Str = ""
  /// The type of the machine used to deploy and serve the model.
  pub machine_type as "machineType,omitempty": Str = ""
  /// The maximum number of iterations in training. Used only for iterative training algorithms.
  pub max_iterations as "maxIterations,omitempty": Str = ""
  /// Maximum number of trials to run in parallel.
  pub max_parallel_trials as "maxParallelTrials,omitempty": Str = ""
  /// The maximum number of machine replicas that will be deployed on an endpoint. The default value is equal to min_replica_count.
  pub max_replica_count as "maxReplicaCount,omitempty": Str = ""
  /// The maximum number of time points in a time series that can be used in modeling the trend component of the time series. Don't use this option with the `timeSeriesLengthFraction` or `minTimeSeriesLength` options.
  pub max_time_series_length as "maxTimeSeriesLength,omitempty": Str = ""
  /// Maximum depth of a tree for boosted tree models.
  pub max_tree_depth as "maxTreeDepth,omitempty": Str = ""
  /// The apriori support minimum. Applies to contribution analysis models.
  pub min_apriori_support as "minAprioriSupport,omitempty": Float = 0.0
  /// When early_stop is true, stops training when accuracy improvement is less than 'min_relative_progress'. Used only for iterative training algorithms.
  pub min_relative_progress as "minRelativeProgress,omitempty": Float = 0.0
  /// The minimum number of machine replicas that will be always deployed on an endpoint. This value must be greater than or equal to 1. The default value is 1.
  pub min_replica_count as "minReplicaCount,omitempty": Str = ""
  /// Minimum split loss for boosted tree models.
  pub min_split_loss as "minSplitLoss,omitempty": Float = 0.0
  /// The minimum number of time points in a time series that are used in modeling the trend component of the time series. If you use this option you must also set the `timeSeriesLengthFraction` option. This training option ensures that enough time points are available when you use `timeSeriesLengthFraction` in trend modeling. This is particularly important when forecasting multiple time series in a single query using `timeSeriesIdColumn`. If the total number of time points is less than the `minTimeSeriesLength` value, then the query uses all available time points.
  pub min_time_series_length as "minTimeSeriesLength,omitempty": Str = ""
  /// Minimum sum of instance weight needed in a child for boosted tree models.
  pub min_tree_child_weight as "minTreeChildWeight,omitempty": Str = ""
  /// The name of a Vertex model garden publisher model. Format is `publishers/{publisher}/models/{model}@{optional_version_id}`.
  pub model_garden_model_name as "modelGardenModelName,omitempty": Str = ""
  /// The model registry.
  pub model_registry as "modelRegistry,omitempty": Str = ""
  /// Google Cloud Storage URI from which the model was imported. Only applicable for imported models.
  pub model_uri as "modelUri,omitempty": Str = ""
  /// A specification of the non-seasonal part of the ARIMA model: the three components (p, d, q) are the AR order, the degree of differencing, and the MA order.
  pub non_seasonal_order as "nonSeasonalOrder,omitempty": ArimaOrder? = None
  /// Number of clusters for clustering models.
  pub num_clusters as "numClusters,omitempty": Str = ""
  /// Num factors specified for matrix factorization models.
  pub num_factors as "numFactors,omitempty": Str = ""
  /// Number of parallel trees constructed during each iteration for boosted tree models.
  pub num_parallel_tree as "numParallelTree,omitempty": Str = ""
  /// Number of principal components to keep in the PCA model. Must be <= the number of features.
  pub num_principal_components as "numPrincipalComponents,omitempty": Str = ""
  /// Number of trials to run this hyperparameter tuning job.
  pub num_trials as "numTrials,omitempty": Str = ""
  /// Optimization strategy for training linear regression models.
  pub optimization_strategy as "optimizationStrategy,omitempty": Str = ""
  /// Optimizer used for training the neural nets.
  pub optimizer as "optimizer,omitempty": Str = ""
  /// The minimum ratio of cumulative explained variance that needs to be given by the PCA model.
  pub pca_explained_variance_ratio as "pcaExplainedVarianceRatio,omitempty": Float = 0.0
  /// The solver for PCA.
  pub pca_solver as "pcaSolver,omitempty": Str = ""
  /// Corresponds to the label key of a reservation resource used by Vertex AI. To target a SPECIFIC_RESERVATION by name, use `compute.googleapis.com/reservation-name` as the key and specify the name of your reservation as its value.
  pub reservation_affinity_key as "reservationAffinityKey,omitempty": Str = ""
  /// Specifies the reservation affinity type used to configure a Vertex AI resource. The default value is `NO_RESERVATION`.
  pub reservation_affinity_type as "reservationAffinityType,omitempty": Str = ""
  /// Corresponds to the label values of a reservation resource used by Vertex AI. This must be the full resource name of the reservation or reservation block.
  pub reservation_affinity_values as "reservationAffinityValues,omitempty": List[Str] = []
  /// Number of paths for the sampled Shapley explain method.
  pub sampled_shapley_num_paths as "sampledShapleyNumPaths,omitempty": Str = ""
  /// If true, scale the feature values by dividing the feature standard deviation. Currently only apply to PCA.
  pub scale_features as "scaleFeatures,omitempty": Bool = false
  /// Whether to standardize numerical features. Default to true.
  pub standardize_features as "standardizeFeatures,omitempty": Bool = false
  /// Subsample fraction of the training data to grow tree to prevent overfitting for boosted tree models.
  pub subsample as "subsample,omitempty": Float = 0.0
  /// Based on the selected TF version, the corresponding docker image is used to train external models.
  pub tf_version as "tfVersion,omitempty": Str = ""
  /// Column to be designated as time series data for ARIMA model.
  pub time_series_data_column as "timeSeriesDataColumn,omitempty": Str = ""
  /// The time series id column that was used during ARIMA model training.
  pub time_series_id_column as "timeSeriesIdColumn,omitempty": Str = ""
  /// The time series id columns that were used during ARIMA model training.
  pub time_series_id_columns as "timeSeriesIdColumns,omitempty": List[Str] = []
  /// The fraction of the interpolated length of the time series that's used to model the time series trend component. All of the time points of the time series are used to model the non-trend component. This training option accelerates modeling training without sacrificing much forecasting accuracy. You can use this option with `minTimeSeriesLength` but not with `maxTimeSeriesLength`.
  pub time_series_length_fraction as "timeSeriesLengthFraction,omitempty": Float = 0.0
  /// Column to be designated as time series timestamp for ARIMA model.
  pub time_series_timestamp_column as "timeSeriesTimestampColumn,omitempty": Str = ""
  /// Tree construction algorithm for boosted tree models.
  pub tree_method as "treeMethod,omitempty": Str = ""
  /// Smoothing window size for the trend component. When a positive value is specified, a center moving average smoothing is applied on the history trend. When the smoothing window is out of the boundary at the beginning or the end of the trend, the first element or the last element is padded to fill the smoothing window before the average is applied.
  pub trend_smoothing_window_size as "trendSmoothingWindowSize,omitempty": Str = ""
  /// User column specified for matrix factorization models.
  pub user_column as "userColumn,omitempty": Str = ""
  /// The version aliases to apply in Vertex AI model registry. Always overwrite if the version aliases exists in a existing model.
  pub vertex_ai_model_version_aliases as "vertexAiModelVersionAliases,omitempty": List[Str] = []
  /// Hyperparameter for matrix factoration when implicit feedback type is specified.
  pub wals_alpha as "walsAlpha,omitempty": Float = 0.0
  /// Whether to train a model from the last checkpoint.
  pub warm_start as "warmStart,omitempty": Bool = false
  /// User-selected XGBoost versions for training of XGBoost models.
  pub xgboost_version as "xgboostVersion,omitempty": Str = ""
} derive Json

/// TrainingRun: Information about a single training query run for the model.
pub struct TrainingRun {
  /// Output only. Global explanation contains the explanation of top features on the class level. Applies to classification models only.
  pub class_level_global_explanations as "classLevelGlobalExplanations,omitempty": List[GlobalExplanation] = []
  /// Output only. Data split result of the training run. Only set when the input data is actually split.
  pub data_split_result as "dataSplitResult,omitempty": DataSplitResult? = None
  /// Output only. The evaluation metrics over training/eval data that were computed at the end of training.
  pub evaluation_metrics as "evaluationMetrics,omitempty": EvaluationMetrics? = None
  /// Output only. Global explanation contains the explanation of top features on the model level. Applies to both regression and classification models.
  pub model_level_global_explanation as "modelLevelGlobalExplanation,omitempty": GlobalExplanation? = None
  /// Output only. Output of each iteration run, results.size() <= max_iterations.
  pub results as "results,omitempty": List[IterationResult] = []
  /// Output only. The start time of this training run.
  pub start_time as "startTime,omitempty": Str = ""
  /// Output only. Options that were used for this training run, includes user specified and default options that were used.
  pub training_options as "trainingOptions,omitempty": TrainingOptions? = None
  /// Output only. The start time of this training run, in milliseconds since epoch.
  pub training_start_time as "trainingStartTime,omitempty": Str = ""
  /// The model id in the [Vertex AI Model Registry](https://cloud.google.com/vertex-ai/docs/model-registry/introduction) for this training run.
  pub vertex_ai_model_id as "vertexAiModelId,omitempty": Str = ""
  /// Output only. The model version in the [Vertex AI Model Registry](https://cloud.google.com/vertex-ai/docs/model-registry/introduction) for this training run.
  pub vertex_ai_model_version as "vertexAiModelVersion,omitempty": Str = ""
} derive Json

/// TransactionInfo: [Alpha] Information of a multi-statement transaction.
pub struct TransactionInfo {
  /// Output only. [Alpha] Id of the transaction.
  pub transaction_id as "transactionId,omitempty": Str = ""
} derive Json

/// TransformColumn: Information about a single transform column.
pub struct TransformColumn {
  /// Output only. Name of the column.
  pub name as "name,omitempty": Str = ""
  /// Output only. The SQL expression used in the column transform.
  pub transform_sql as "transformSql,omitempty": Str = ""
  /// Output only. Data type of the column after the transform.
  pub type_ as "type,omitempty": StandardSqlDataType? = None
} derive Json

/// UndeleteDatasetRequest: Request format for undeleting a dataset.
pub struct UndeleteDatasetRequest {
  /// Optional. The exact time when the dataset was deleted. If not specified, the most recently deleted version is undeleted. Undeleting a dataset using deletion time is not supported.
  pub deletion_time as "deletionTime,omitempty": Str = ""
} derive Json

/// UserDefinedFunctionResource:  This is used for defining User Defined Function (UDF) resources only when using legacy SQL. Users of GoogleSQL should leverage either DDL (e.g. CREATE [TEMPORARY] FUNCTION ... ) or the Routines API to define UDF resources. For additional information on migrating, see: https://cloud.google.com/bigquery/docs/reference/standard-sql/migrating-from-legacy-sql#differences_in_user-defined_javascript_functions
pub struct UserDefinedFunctionResource {
  /// [Pick one] An inline resource that contains code for a user-defined function (UDF). Providing a inline code resource is equivalent to providing a URI for a file containing the same code.
  pub inline_code as "inlineCode,omitempty": Str = ""
  /// [Pick one] A code resource to load from a Google Cloud Storage URI (gs://bucket/path).
  pub resource_uri as "resourceUri,omitempty": Str = ""
} derive Json

/// VectorSearchStatistics: Statistics for a vector search query. Populated as part of JobStatistics2.
pub struct VectorSearchStatistics {
  /// When `indexUsageMode` is `UNUSED` or `PARTIALLY_USED`, this field explains why indexes were not used in all or part of the vector search query. If `indexUsageMode` is `FULLY_USED`, this field is not populated.
  pub index_unused_reasons as "indexUnusedReasons,omitempty": List[IndexUnusedReason] = []
  /// Specifies the index usage mode for the query.
  pub index_usage_mode as "indexUsageMode,omitempty": Str = ""
  /// Specifies the usage of stored columns in the query when stored columns are used in the query.
  pub stored_columns_usages as "storedColumnsUsages,omitempty": List[StoredColumnsUsage] = []
} derive Json

/// ViewDefinition: Describes the definition of a logical view.
pub struct ViewDefinition {
  /// Optional. Foreign view representations.
  pub foreign_definitions as "foreignDefinitions,omitempty": List[ForeignViewDefinition] = []
  /// Optional. Specifies the privacy policy for the view.
  pub privacy_policy as "privacyPolicy,omitempty": PrivacyPolicy? = None
  /// Required. A query that BigQuery executes when the view is referenced.
  pub query as "query,omitempty": Str = ""
  /// True if the column names are explicitly specified. For example by using the 'CREATE VIEW v(c1, c2) AS ...' syntax. Can only be set for GoogleSQL views.
  pub use_explicit_column_names as "useExplicitColumnNames,omitempty": Bool = false
  /// Specifies whether to use BigQuery's legacy SQL for this view. The default value is true. If set to false, the view uses BigQuery's [GoogleSQL](https://docs.cloud.google.com/bigquery/docs/introduction-sql). Queries and views that reference this view must use the same flag value. A wrapper is used here because the default value is True.
  pub use_legacy_sql as "useLegacySql,omitempty": Bool = false
  /// Describes user-defined function resources used in the query.
  pub user_defined_function_resources as "userDefinedFunctionResources,omitempty": List[UserDefinedFunctionResource] = []
} derive Json
