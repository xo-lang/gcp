} derive Json

/// QueryTimelineSample: Summary of the state of query execution at a given time.
pub struct QueryTimelineSample {
  /// Total number of active workers. This does not correspond directly to slot usage. This is the largest value observed since the last sample.
  pub active_units as "activeUnits,omitempty": Str = ""
  /// Total parallel units of work completed by this query.
  pub completed_units as "completedUnits,omitempty": Str = ""
  /// Milliseconds elapsed since the start of query execution.
  pub elapsed_ms as "elapsedMs,omitempty": Str = ""
  /// Units of work that can be scheduled immediately. Providing additional slots for these units of work will accelerate the query, if no other query in the reservation needs additional slots.
  pub estimated_runnable_units as "estimatedRunnableUnits,omitempty": Str = ""
  /// Total units of work remaining for the query. This number can be revised (increased or decreased) while the query is running.
  pub pending_units as "pendingUnits,omitempty": Str = ""
  /// Total shuffle usage ratio in shuffle RAM per reservation of this query. This will be provided for reservation customers only.
  pub shuffle_ram_usage_ratio as "shuffleRamUsageRatio,omitempty": Float = 0.0
  /// Cumulative slot-ms consumed by the query.
  pub total_slot_ms as "totalSlotMs,omitempty": Str = ""
} derive Json

/// RangePartitioning:
pub struct RangePartitioning {
  /// Required. The name of the column to partition the table on. It must be a top-level, INT64 column whose mode is NULLABLE or REQUIRED.
  pub field as "field,omitempty": Str = ""
  /// [Experimental] Defines the ranges for range partitioning.
  pub range as "range,omitempty": RangePartitioningRange? = None
} derive Json

/// RangePartitioningRange: [Experimental] Defines the ranges for range partitioning.
pub struct RangePartitioningRange {
  /// [Experimental] The end of range partitioning, exclusive.
  pub end as "end,omitempty": Str = ""
  /// [Experimental] The width of each interval.
  pub interval as "interval,omitempty": Str = ""
  /// [Experimental] The start of range partitioning, inclusive.
  pub start as "start,omitempty": Str = ""
} derive Json

/// RangeValue: Represents the value of a range.
pub struct RangeValue {
  /// Optional. The end value of the range. A missing value represents an unbounded end.
  pub end as "end,omitempty": QueryParameterValue? = None
  /// Optional. The start value of the range. A missing value represents an unbounded start.
  pub start as "start,omitempty": QueryParameterValue? = None
} derive Json

/// RankingMetrics: Evaluation metrics used by weighted-ALS models specified by feedback_type=implicit.
pub struct RankingMetrics {
  /// Determines the goodness of a ranking by computing the percentile rank from the predicted confidence and dividing it by the original rank.
  pub average_rank as "averageRank,omitempty": Float = 0.0
  /// Calculates a precision per user for all the items by ranking them and then averages all the precisions across all the users.
  pub mean_average_precision as "meanAveragePrecision,omitempty": Float = 0.0
  /// Similar to the mean squared error computed in regression and explicit recommendation models except instead of computing the rating directly, the output from evaluate is computed against a preference which is 1 or 0 depending on if the rating exists or not.
  pub mean_squared_error as "meanSquaredError,omitempty": Float = 0.0
  /// A metric to determine the goodness of a ranking calculated from the predicted confidence by comparing it to an ideal rank measured by the original ratings.
  pub normalized_discounted_cumulative_gain as "normalizedDiscountedCumulativeGain,omitempty": Float = 0.0
} derive Json

/// RegressionMetrics: Evaluation metrics for regression and explicit feedback type matrix factorization models.
pub struct RegressionMetrics {
  /// Mean absolute error.
  pub mean_absolute_error as "meanAbsoluteError,omitempty": Float = 0.0
  /// Mean squared error.
  pub mean_squared_error as "meanSquaredError,omitempty": Float = 0.0
  /// Mean squared log error.
  pub mean_squared_log_error as "meanSquaredLogError,omitempty": Float = 0.0
  /// Median absolute error.
  pub median_absolute_error as "medianAbsoluteError,omitempty": Float = 0.0
  /// R^2 score. This corresponds to r2_score in ML.EVALUATE.
  pub r_squared as "rSquared,omitempty": Float = 0.0
} derive Json

/// RemoteFunctionOptions: Options for a remote user-defined function.
pub struct RemoteFunctionOptions {
  /// Fully qualified name of the user-provided connection object which holds the authentication information to send requests to the remote service. Format: ```"projects/{projectId}/locations/{locationId}/connections/{connectionId}"```
  pub connection as "connection,omitempty": Str = ""
  /// Endpoint of the user-provided remote service, e.g. ```https://us-east1-my_gcf_project.cloudfunctions.net/remote_add```
  pub endpoint as "endpoint,omitempty": Str = ""
  /// Max number of rows in each batch sent to the remote service. If absent or if 0, BigQuery dynamically decides the number of rows in a batch.
  pub max_batching_rows as "maxBatchingRows,omitempty": Str = ""
  /// User-defined context as a set of key/value pairs, which will be sent as function invocation context together with batched arguments in the requests to the remote service. The total number of bytes of keys and values must be less than 8KB.
  pub user_defined_context as "userDefinedContext,omitempty": Map[Str, Str] = {}
} derive Json

/// RemoteModelInfo: Remote Model Info
pub struct RemoteModelInfo {
  /// Output only. Fully qualified name of the user-provided connection object of the remote model. Format: ```"projects/{project_id}/locations/{location_id}/connections/{connection_id}"```
  pub connection as "connection,omitempty": Str = ""
  /// Output only. The endpoint for remote model.
  pub endpoint as "endpoint,omitempty": Str = ""
  /// Output only. Max number of rows in each batch sent to the remote service. If unset, the number of rows in each batch is set dynamically.
  pub max_batching_rows as "maxBatchingRows,omitempty": Str = ""
  /// Output only. The model version for LLM.
  pub remote_model_version as "remoteModelVersion,omitempty": Str = ""
  /// Output only. The remote service type for remote model.
  pub remote_service_type as "remoteServiceType,omitempty": Str = ""
  /// Output only. The name of the speech recognizer to use for speech recognition. The expected format is `projects/{project}/locations/{location}/recognizers/{recognizer}`. Customers can specify this field at model creation. If not specified, a default recognizer `projects/{model project}/locations/global/recognizers/_` will be used. See more details at [recognizers](https://cloud.google.com/speech-to-text/v2/docs/reference/rest/v2/projects.locations.recognizers)
  pub speech_recognizer as "speechRecognizer,omitempty": Str = ""
} derive Json

/// RestrictionConfig:
pub struct RestrictionConfig {
  /// Output only. Specifies the type of dataset/table restriction.
  pub type_ as "type,omitempty": Str = ""
} derive Json

/// Routine: A user-defined function or a stored procedure.
pub struct Routine {
  /// Optional.
  pub arguments as "arguments,omitempty": List[Argument] = []
  /// Output only. The build status of the routine. This field is only applicable to Python UDFs. [Preview](https://cloud.google.com/products/#product-launch-stages)
  pub build_status as "buildStatus,omitempty": RoutineBuildStatus? = None
  /// Output only. The time when this routine was created, in milliseconds since the epoch.
  pub creation_time as "creationTime,omitempty": Str = ""
  /// Optional. If set to `DATA_MASKING`, the function is validated and made available as a masking function. For more information, see [Create custom masking routines](https://cloud.google.com/bigquery/docs/user-defined-functions#custom-mask).
  pub data_governance_type as "dataGovernanceType,omitempty": Str = ""
  /// Required. The body of the routine. For functions, this is the expression in the AS clause. If `language = "SQL"`, it is the substring inside (but excluding) the parentheses. For example, for the function created with the following statement: `CREATE FUNCTION JoinLines(x string, y string) as (concat(x, "\n", y))` The definition_body is `concat(x, "\n", y)` (\n is not replaced with linebreak). If `language="JAVASCRIPT"`, it is the evaluated string in the AS clause. For example, for the function created with the following statement: `CREATE FUNCTION f() RETURNS STRING LANGUAGE js AS 'return "\n";\n'` The definition_body is `return "\n";\n` Note that both \n are replaced with linebreaks. If `definition_body` references another routine, then that routine must be fully qualified with its project ID.
  pub definition_body as "definitionBody,omitempty": Str = ""
  /// Optional. The description of the routine, if defined.
  pub description as "description,omitempty": Str = ""
  /// Optional. The determinism level of the JavaScript UDF, if defined.
  pub determinism_level as "determinismLevel,omitempty": Str = ""
  /// Output only. A hash of this resource.
  pub etag as "etag,omitempty": Str = ""
  /// Optional. Options for the runtime of the external system executing the routine. This field is only applicable for Python UDFs. [Preview](https://cloud.google.com/products/#product-launch-stages)
  pub external_runtime_options as "externalRuntimeOptions,omitempty": ExternalRuntimeOptions? = None
  /// Optional. If language = "JAVASCRIPT", this field stores the path of the imported JAVASCRIPT libraries.
  pub imported_libraries as "importedLibraries,omitempty": List[Str] = []
  /// Optional. Defaults to "SQL" if remote_function_options field is absent, not set otherwise.
  pub language as "language,omitempty": Str = ""
  /// Output only. The time when this routine was last modified, in milliseconds since the epoch.
  pub last_modified_time as "lastModifiedTime,omitempty": Str = ""
  /// Optional. Options for the Python UDF. [Preview](https://cloud.google.com/products/#product-launch-stages)
  pub python_options as "pythonOptions,omitempty": PythonOptions? = None
  /// Optional. Remote function specific options.
  pub remote_function_options as "remoteFunctionOptions,omitempty": RemoteFunctionOptions? = None
  /// Optional. Can be set only if routine_type = "TABLE_VALUED_FUNCTION". If absent, the return table type is inferred from definition_body at query time in each query that references this routine. If present, then the columns in the evaluated table result will be cast to match the column types specified in return table type, at query time.
  pub return_table_type as "returnTableType,omitempty": StandardSqlTableType? = None
  /// Optional if language = "SQL"; required otherwise. Cannot be set if routine_type = "TABLE_VALUED_FUNCTION". If absent, the return type is inferred from definition_body at query time in each query that references this routine. If present, then the evaluated result will be cast to the specified returned type at query time. For example, for the functions created with the following statements: * `CREATE FUNCTION Add(x FLOAT64, y FLOAT64) RETURNS FLOAT64 AS (x + y);` * `CREATE FUNCTION Increment(x FLOAT64) AS (Add(x, 1));` * `CREATE FUNCTION Decrement(x FLOAT64) RETURNS FLOAT64 AS (Add(x, -1));` The return_type is `{type_kind: "FLOAT64"}` for `Add` and `Decrement`, and is absent for `Increment` (inferred as FLOAT64 at query time). Suppose the function `Add` is replaced by `CREATE OR REPLACE FUNCTION Add(x INT64, y INT64) AS (x + y);` Then the inferred return type of `Increment` is automatically changed to INT64 at query time, while the return type of `Decrement` remains FLOAT64.
  pub return_type as "returnType,omitempty": StandardSqlDataType? = None
  /// Required. Reference describing the ID of this routine.
  pub routine_reference as "routineReference,omitempty": RoutineReference? = None
  /// Required. The type of routine.
  pub routine_type as "routineType,omitempty": Str = ""
  /// Optional. The security mode of the routine, if defined. If not defined, the security mode is automatically determined from the routine's configuration.
  pub security_mode as "securityMode,omitempty": Str = ""
  /// Optional. Spark specific options.
  pub spark_options as "sparkOptions,omitempty": SparkOptions? = None
  /// Optional. Use this option to catch many common errors. Error checking is not exhaustive, and successfully creating a procedure doesn't guarantee that the procedure will successfully execute at runtime. If `strictMode` is set to `TRUE`, the procedure body is further checked for errors such as non-existent tables or columns. The `CREATE PROCEDURE` statement fails if the body fails any of these checks. If `strictMode` is set to `FALSE`, the procedure body is checked only for syntax. For procedures that invoke themselves recursively, specify `strictMode=FALSE` to avoid non-existent procedure errors during validation. Default value is `TRUE`.
  pub strict_mode as "strictMode,omitempty": Bool = false
} derive Json

/// RoutineBuildStatus: The status of a routine build.
pub struct RoutineBuildStatus {
  /// Output only. The time taken for the image build. Populated only after the build succeeds or fails.
  pub build_duration as "buildDuration,omitempty": Str = ""
  /// Output only. The current build state of the routine.
  pub build_state as "buildState,omitempty": Str = ""
  /// Output only. The time when the build state was updated last.
  pub build_state_update_time as "buildStateUpdateTime,omitempty": Str = ""
  /// Output only. A result object that will be present only if the build has failed.
  pub error_result as "errorResult,omitempty": ErrorProto? = None
  /// Output only. The size of the image in bytes. Populated only after the build succeeds.
  pub image_size_bytes as "imageSizeBytes,omitempty": Str = ""
} derive Json

/// RoutineReference: Id path of a routine.
pub struct RoutineReference {
  /// Required. The ID of the dataset containing this routine.
  pub dataset_id as "datasetId,omitempty": Str = ""
  /// Required. The ID of the project containing this routine.
  pub project_id as "projectId,omitempty": Str = ""
  /// Required. The ID of the routine. The ID must contain only letters (a-z, A-Z), numbers (0-9), or underscores (_). The maximum length is 256 characters.
  pub routine_id as "routineId,omitempty": Str = ""
} derive Json

/// Row: A single row in the confusion matrix.
pub struct Row {
  /// The original label of this row.
  pub actual_label as "actualLabel,omitempty": Str = ""
  /// Info describing predicted label distribution.
  pub entries as "entries,omitempty": List[Entry] = []
