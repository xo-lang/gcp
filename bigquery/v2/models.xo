  /// Milliseconds the slowest shard spent on CPU-bound tasks.
  pub compute_ms_max as "computeMsMax,omitempty": Str = ""
  /// Relative amount of time the average shard spent on CPU-bound tasks.
  pub compute_ratio_avg as "computeRatioAvg,omitempty": Float = 0.0
  /// Relative amount of time the slowest shard spent on CPU-bound tasks.
  pub compute_ratio_max as "computeRatioMax,omitempty": Float = 0.0
  /// Stage end time represented as milliseconds since the epoch.
  pub end_ms as "endMs,omitempty": Str = ""
  /// Unique ID for the stage within the plan.
  pub id as "id,omitempty": Str = ""
  /// IDs for stages that are inputs to this stage.
  pub input_stages as "inputStages,omitempty": List[Str] = []
  /// Human-readable name for the stage.
  pub name as "name,omitempty": Str = ""
  /// Number of parallel input segments to be processed
  pub parallel_inputs as "parallelInputs,omitempty": Str = ""
  /// Milliseconds the average shard spent reading input.
  pub read_ms_avg as "readMsAvg,omitempty": Str = ""
  /// Milliseconds the slowest shard spent reading input.
  pub read_ms_max as "readMsMax,omitempty": Str = ""
  /// Relative amount of time the average shard spent reading input.
  pub read_ratio_avg as "readRatioAvg,omitempty": Float = 0.0
  /// Relative amount of time the slowest shard spent reading input.
  pub read_ratio_max as "readRatioMax,omitempty": Float = 0.0
  /// Number of records read into the stage.
  pub records_read as "recordsRead,omitempty": Str = ""
  /// Number of records written by the stage.
  pub records_written as "recordsWritten,omitempty": Str = ""
  /// Total number of bytes written to shuffle.
  pub shuffle_output_bytes as "shuffleOutputBytes,omitempty": Str = ""
  /// Total number of bytes written to shuffle and spilled to disk.
  pub shuffle_output_bytes_spilled as "shuffleOutputBytesSpilled,omitempty": Str = ""
  /// Slot-milliseconds used by the stage.
  pub slot_ms as "slotMs,omitempty": Str = ""
  /// Stage start time represented as milliseconds since the epoch.
  pub start_ms as "startMs,omitempty": Str = ""
  /// Current status for this stage.
  pub status as "status,omitempty": Str = ""
  /// List of operations within the stage in dependency order (approximately chronological).
  pub steps as "steps,omitempty": List[ExplainQueryStep] = []
  /// Milliseconds the average shard spent waiting to be scheduled.
  pub wait_ms_avg as "waitMsAvg,omitempty": Str = ""
  /// Milliseconds the slowest shard spent waiting to be scheduled.
