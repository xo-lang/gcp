test "jobs oracle: inserter put, four row errors" {
  let f = new_fake(os.net, [(200, "{\"insertErrors\":[${insert_err(0, ["a"])},${insert_err(1, ["b"])},${insert_err(2, ["c"])},${insert_err(3, [])}]}")])
