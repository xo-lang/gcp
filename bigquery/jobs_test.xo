test "jobs oracle: query read, fast path, every option" {
  let f = new_fake(os.net, [(200, complete("\"rows\":[${rows3()}]"))])
  var c = jobs_client(os)
  c.location = "asia-east1"
  var q = c.query("SELECT @x")
  q.config.parameters = [QueryParameter{name: "x", value: Param.Array(elem: StandardSqlDataType{type_kind: "STRING"}, items: [Param.Str("a"), Param.Str("b")])}]
  q.id.location = "EU"
  q.config.create_session = true
  q.config.max_bytes_billed = 99
  q.config.disable_query_cache = true
  q.config.labels = {"a": "b"}
  q.config.default_project_id = "p2"
  q.config.default_dataset_id = "d2"
  q.config.reservation = "r1"
  q.config.max_slots = 3
  q.config.job_creation_mode = JOB_CREATION_MODE_OPTIONAL
  q.config.priority = INTERACTIVE_PRIORITY
  rows_line(f, q.read())
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/queries?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"createSession\":true,\"defaultDataset\":{\"datasetId\":\"d2\",\"projectId\":\"p2\"},\"formatOptions\":{\"useInt64Timestamp\":true},\"jobCreationMode\":\"JOB_CREATION_OPTIONAL\",\"labels\":{\"a\":\"b\"},\"location\":\"EU\",\"maxSlots\":3,\"maximumBytesBilled\":\"99\",\"query\":\"SELECT @x\",\"queryParameters\":[{\"name\":\"x\",\"parameterType\":{\"arrayType\":{\"type\":\"STRING\"},\"type\":\"ARRAY\"},\"parameterValue\":{\"arrayValues\":[{\"value\":\"a\"},{\"value\":\"b\"}]}}],\"requestId\":\"REQUESTID\",\"reservation\":\"r1\",\"useLegacySql\":false,\"useQueryCache\":false}", "  row [int 3, str \"c\", ts 1700000001000000 UTC]", "  done total=3 schema=[id:INTEGER name:STRING at:TIMESTAMP] job=\"\" query=\"\""]
}

