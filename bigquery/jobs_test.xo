  for i in 0..4 {
    rows.push(with_id(vsv(i, "n"), "i${i}"))
  }
  ok_line(f, jobs_client(os).dataset("d1").table("t1").inserter().put(rows))
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/t1/insertAll?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"rows\":[{\"insertId\":\"i0\",\"json\":{\"id\":0,\"name\":\"n\"}},{\"insertId\":\"i1\",\"json\":{\"id\":1,\"name\":\"n\"}},{\"insertId\":\"i2\",\"json\":{\"id\":2,\"name\":\"n\"}},{\"insertId\":\"i3\",\"json\":{\"id\":3,\"name\":\"n\"}}]}", "  error 4 row insertions failed (insertion of row [insertID: \"i0\"; insertIndex: 0] failed with error: {Location: \"name\"; Message: \"bad a\"; Reason: \"a\"}, insertion of row [insertID: \"i1\"; insertIndex: 1] failed with error: {Location: \"name\"; Message: \"bad b\"; Reason: \"b\"}, insertion of row [insertID: \"i2\"; insertIndex: 2] failed with error: {Location: \"name\"; Message: \"bad c\"; Reason: \"c\"}, ...)"]
}

test "jobs oracle: inserter put, bad index" {
  let f = new_fake(os.net, [(200, "{\"insertErrors\":[${insert_err(9, ["x"])}]}")])
  let rows: List[ValueSaver] = [vsv(1, "a")]
  ok_line(f, jobs_client(os).dataset("d1").table("t1").inserter().put(rows))
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/t1/insertAll?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"rows\":[{\"insertId\":\"RANDOMID\",\"json\":{\"id\":1,\"name\":\"a\"}}]}", "  error internal error: unexpected row index: 9"]
}

test "jobs oracle: inserter put, 503 retried, then 400" {
  let f = new_fake(os.net, [(503, BACKEND_ERR), (400, INVALID_QUERY)])
  let rows: List[ValueSaver] = [vsv(1, "a")]
  ok_line(f, jobs_client(os).dataset("d1").table("t1").inserter().put(rows))
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/t1/insertAll?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"rows\":[{\"insertId\":\"RANDOMID\",\"json\":{\"id\":1,\"name\":\"a\"}}]}", "  POST https://bigquery.fake/bigquery/v2/projects/p1/datasets/d1/tables/t1/insertAll?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"rows\":[{\"insertId\":\"RANDOMID\",\"json\":{\"id\":1,\"name\":\"a\"}}]}", "  error googleapi: Error 400: Syntax error: Unexpected end of script at [1:7], invalidQuery", "  googleapi code=400"]
}

test "jobs oracle: inserter put, a saver error" {
  let f = new_fake(os.net, [])
  var s = vsv(1, "a")
  s.row = [Value.Int(1)]
  let rows: List[ValueSaver] = [s]
  ok_line(f, jobs_client(os).dataset("d1").table("t1").inserter().put(rows))
  expect(lines(f)) == ["  error schema does not match length of row to be inserted"]
}
