}

test "jobs oracle: query run, destination and table options" {
  let f = new_fake(os.net, [(200, job_running())])
  var q = jobs_client(os).query("SELECT 1")
  q.config.dst = Some(TableRef{project_id: "p1", dataset_id: "d1", table_id: "out"})
  q.config.create_disposition = CREATE_IF_NEEDED
  q.config.write_disposition = WRITE_TRUNCATE
  q.config.time_partitioning = Some(TimePartitioning{type_: DAY_PARTITIONING_TYPE, field: "at", expiration: 48h})
  q.config.clustering = Some(Clustering{fields: ["name"]})
  q.config.allow_large_results = true
  q.config.disable_flattened_results = true
  q.config.max_billing_tier = 2
  q.config.use_legacy_sql = true
  q.config.schema_update_options = ["ALLOW_FIELD_ADDITION"]
  q.config.create_session = true
  q.config.connection_properties = [ConnectionProperty{key: "time_zone", value: "UTC"}]
  q.config.destination_encryption_config = Some(EncryptionConfig{kms_key_name: "k1"})
  q.config.continuous = true
  job_line(f, q.run())
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"query\":{\"allowLargeResults\":true,\"clustering\":{\"fields\":[\"name\"]},\"connectionProperties\":[{\"key\":\"time_zone\",\"value\":\"UTC\"}],\"continuous\":true,\"createDisposition\":\"CREATE_IF_NEEDED\",\"createSession\":true,\"destinationEncryptionConfiguration\":{\"kmsKeyName\":\"k1\"},\"destinationTable\":{\"datasetId\":\"d1\",\"projectId\":\"p1\",\"tableId\":\"out\"},\"flattenResults\":false,\"maximumBillingTier\":2,\"query\":\"SELECT 1\",\"schemaUpdateOptions\":[\"ALLOW_FIELD_ADDITION\"],\"timePartitioning\":{\"expirationMs\":\"172800000\",\"field\":\"at\",\"type\":\"DAY\"},\"useLegacySql\":true,\"writeDisposition\":\"WRITE_TRUNCATE\"}},\"jobReference\":{\"jobId\":\"RANDOMID\",\"projectId\":\"p1\"}}", "  job p1 job1 US \"\"", "  status Running done=false err=<nil>", "  stats created=2023-11-14T22:13:20Z start=zero end=zero bytes=0 slotms=0 children=0 parent=\"\" ratio=0 reservation=\"\""]
}

test "jobs oracle: query run, refused" {
  let f = new_fake(os.net, [])
  let c = jobs_client(os)
  var q = c.query("SELECT 1")
  q.config.use_legacy_sql = true
  q.config.use_standard_sql = true
  job_line(f, q.run())
  q = c.query("SELECT @x")
  q.config.use_legacy_sql = true
  q.config.parameters = [QueryParameter{name: "x", value: Param.Int(1)}]
  job_line(f, q.run())
  q = c.query("SELECT @x")
  q.config.parameters = [QueryParameter{name: "x", value: Param.Range(start: None, end: None)}]
  job_line(f, q.run())
  expect(lines(f)) == ["  error bigquery: cannot provide both UseStandardSQL and UseLegacySQL", "  error bigquery: cannot provide both Parameters (implying standard SQL) and UseLegacySQL", "  error unable to determine range element type from RangeValue without a non-nil start or end value"]
}

