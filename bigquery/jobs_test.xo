// Generated by gen_jobs_test.py from the Go oracle's output
// (~/xo-lead/notes/aws-43/bigqueryjobs): each test does what the
// case does against the fake and expects the lines Go printed.

test "jobs oracle: query run, every option" {
  let f = new_fake(os.net, [(200, job_done())])
  var q = jobs_client(os).query("SELECT @x, @y")
  q.config.parameters = [QueryParameter{name: "x", value: Param.Int(1)}, QueryParameter{name: "y", value: Param.Str("s")}]
  q.config.labels = {"k": "v"}
  q.config.default_project_id = "p2"
  q.config.default_dataset_id = "d2"
  q.config.disable_query_cache = true
  q.config.max_bytes_billed = 1000
  q.config.job_timeout = 90s
  q.config.priority = BATCH_PRIORITY
  q.id.job_id = "myjob"
  q.id.location = "EU"
  q.config.reservation = "r1"
  q.config.max_slots = 7
  if let Some(j) = job_line(f, q.run()) {
    config_line(f, j)
  }
  expect(lines(f)) == ["  POST https://bigquery.fake/bigquery/v2/projects/p1/jobs?alt=json&prettyPrint=false", "    X-Goog-Api-Client: gl-go/GO gccl/V", "    Content-Type: application/json", "    body {\"configuration\":{\"jobTimeoutMs\":\"90000\",\"labels\":{\"k\":\"v\"},\"maxSlots\":7,\"query\":{\"defaultDataset\":{\"datasetId\":\"d2\",\"projectId\":\"p2\"},\"maximumBytesBilled\":\"1000\",\"priority\":\"BATCH\",\"query\":\"SELECT @x, @y\",\"queryParameters\":[{\"name\":\"x\",\"parameterType\":{\"type\":\"INT64\"},\"parameterValue\":{\"value\":\"1\"}},{\"name\":\"y\",\"parameterType\":{\"type\":\"STRING\"},\"parameterValue\":{\"value\":\"s\"}}],\"useLegacySql\":false,\"useQueryCache\":false},\"reservation\":\"r1\"},\"jobReference\":{\"jobId\":\"myjob\",\"location\":\"EU\",\"projectId\":\"p1\"}}", "  job p1 job1 US \"a@example.com\"", "  status Done done=true err=<nil>", "  stats created=2023-11-14T22:13:20Z start=2023-11-14T22:13:21Z end=2023-11-14T22:13:22.5Z bytes=2048 slotms=1500 children=0 parent=\"\" ratio=1 reservation=\"res1\"", "  session s1", "  query tier=1 cache=true type=SELECT billed=10485760 processed=2048 accuracy=PRECISE dml=3 slotms=1500 schema=[id:INTEGER name:STRING at:TIMESTAMP] tables=[p1:d1.t1] undeclared=[x] ddl=\"CREATE\" ddltable=\"p1:d1.t9\"", "  dml inserted=3 deleted=0 updated=1", "  config query \"SELECT 1\" legacy=false standard=true dry=false cache_off=true billed=1000 priority=\"BATCH\" default=p2.d2 dst=\"p1:d1.out\" create=\"CREATE_IF_NEEDED\" write=\"WRITE_APPEND\" timeoutms=90000 labels=map[k:v] params=0 session=true"]
}

test "jobs oracle: query run, random job id, client location, suffix" {
  let f = new_fake(os.net, [(200, job_running()), (200, job_running())])
  var c = jobs_client(os)
  c.location = "asia-east1"
  var q = c.query("SELECT 1")
  q.id.job_id = "pre"
  q.id.add_job_id_suffix = true
  q.id.project_id = "p3"
