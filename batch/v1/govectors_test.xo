  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"defaultReportInterval\":\"s-defaultreportinterval\",\"minReportInterval\":\"s-minreportinterval\",\"tasks\":[{\"agentTaskSpec\":{\"maxRunDuration\":\"s-maxrunduration\"},\"intendedState\":\"s-intendedstate\",\"reachedBarrier\":\"7\",\"spec\":{\"maxRetryCount\":7,\"maxRunDuration\":\"s-maxrunduration\"},\"status\":{\"state\":\"s-state\"},\"task\":\"s-task\",\"taskSource\":\"s-tasksource\"}],\"useBatchMonitoredResource\":true}")
  gv_note(f, "CALL batch.projects.locations.state.report")
  match svc.projects.locations.state.report("id1/ x", json.decode_str[ReportAgentStateRequest]("{\"agentInfo\":{\"jobId\":\"s-jobid\",\"reportTime\":\"s-reporttime\",\"state\":\"s-state\",\"taskGroupId\":\"s-taskgroupid\",\"tasks\":[{\"runnable\":\"7\",\"taskId\":\"s-taskid\"}]},\"agentTimingInfo\":{\"agentStartupTime\":\"s-agentstartuptime\",\"bootTime\":\"s-boottime\",\"scriptStartupTime\":\"s-scriptstartuptime\"},\"metadata\":{\"creationTime\":\"s-creationtime\",\"creator\":\"s-creator\",\"imageVersion\":\"s-imageversion\",\"instance\":\"s-instance\",\"instanceId\":\"7\",\"instancePreemptionNoticeReceived\":true,\"machineType\":\"s-machinetype\",\"osRelease\":{\"k1\":\"s-osrelease\"},\"version\":\"s-version\",\"zone\":\"s-zone\"}}") ?? e => fault(e.display()), options: ProjectsLocationsStateReportOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_17)
}
