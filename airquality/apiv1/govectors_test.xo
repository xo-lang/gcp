  gv_queue(f, "{\"hourlyForecasts\":[{\"dateTime\":\"s-datetime\",\"healthRecommendations\":{\"athletes\":\"s-athletes\",\"children\":\"s-children\",\"elderly\":\"s-elderly\",\"generalPopulation\":\"s-generalpopulation\",\"heartDiseasePopulation\":\"s-heartdiseasepopulation\",\"lungDiseasePopulation\":\"s-lungdiseasepopulation\",\"pregnantWomen\":\"s-pregnantwomen\"}}],\"regionCode\":\"s-regioncode\"}")
  gv_note(f, "CALL airquality.forecast.lookup pages")
  var p = svc.forecast.lookup_pages(json.decode_str[LookupForecastRequest]("{\"customLocalAqis\":[{\"aqi\":\"s-aqi\",\"regionCode\":\"s-regioncode\"}],\"dateTime\":\"s-datetime\",\"extraComputations\":[\"s-extracomputations\"],\"languageCode\":\"s-languagecode\",\"location\":{\"latitude\":1.5,\"longitude\":1.5},\"pageSize\":7,\"pageToken\":\"s-pagetoken\",\"period\":{\"endTime\":\"s-endtime\",\"startTime\":\"s-starttime\"},\"uaqiColorPalette\":\"s-uaqicolorpalette\",\"universalAqi\":true}") ?? e => fault(e.display()), options: ForecastLookupOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]})
