test "Go's cloudscheduler.projects.locations.jobs.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"jobs\":[{\"appEngineHttpTarget\":{\"body\":\"YWI=\",\"httpMethod\":\"s-httpmethod\",\"relativeUri\":\"s-relativeuri\"},\"attemptDeadline\":\"s-attemptdeadline\",\"description\":\"s-description\",\"httpTarget\":{\"body\":\"YWI=\",\"httpMethod\":\"s-httpmethod\",\"uri\":\"s-uri\"},\"lastAttemptTime\":\"s-lastattempttime\",\"legacyAppEngineCron\":true,\"name\":\"s-name\",\"pubsubTarget\":{\"data\":\"YWI=\",\"topicName\":\"s-topicname\"},\"retryConfig\":{\"maxBackoffDuration\":\"s-maxbackoffduration\",\"maxDoublings\":7,\"maxRetryDuration\":\"s-maxretryduration\",\"minBackoffDuration\":\"s-minbackoffduration\",\"retryCount\":7},\"satisfiesPzs\":true,\"schedule\":\"s-schedule\",\"scheduleTime\":\"s-scheduletime\",\"state\":\"s-state\",\"status\":{\"code\":7,\"message\":\"s-message\"},\"timeZone\":\"s-timezone\",\"userUpdateTime\":\"s-userupdatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"jobs\":[{\"appEngineHttpTarget\":{\"body\":\"YWI=\",\"httpMethod\":\"s-httpmethod\",\"relativeUri\":\"s-relativeuri\"},\"attemptDeadline\":\"s-attemptdeadline\",\"description\":\"s-description\",\"httpTarget\":{\"body\":\"YWI=\",\"httpMethod\":\"s-httpmethod\",\"uri\":\"s-uri\"},\"lastAttemptTime\":\"s-lastattempttime\",\"legacyAppEngineCron\":true,\"name\":\"s-name\",\"pubsubTarget\":{\"data\":\"YWI=\",\"topicName\":\"s-topicname\"},\"retryConfig\":{\"maxBackoffDuration\":\"s-maxbackoffduration\",\"maxDoublings\":7,\"maxRetryDuration\":\"s-maxretryduration\",\"minBackoffDuration\":\"s-minbackoffduration\",\"retryCount\":7},\"satisfiesPzs\":true,\"schedule\":\"s-schedule\",\"scheduleTime\":\"s-scheduletime\",\"state\":\"s-state\",\"status\":{\"code\":7,\"message\":\"s-message\"},\"timeZone\":\"s-timezone\",\"userUpdateTime\":\"s-userupdatetime\"}]}")
  gv_note(f, "CALL cloudscheduler.projects.locations.jobs.list pages")
  var p = svc.projects.locations.jobs.list_pages("id1/ x", options: ProjectsLocationsJobsListOptions{filter: Some("s-filter"), legacy_app_engine_cron: Some(true), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_7)
}

