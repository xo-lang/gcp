test "Go's fusiontables.table.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"attribution\":\"s-attribution\",\"attributionLink\":\"s-attributionlink\",\"baseTableIds\":[\"s-basetableids\"],\"description\":\"s-description\",\"isExportable\":true,\"kind\":\"s-kind\",\"name\":\"s-name\",\"sql\":\"s-sql\",\"tableId\":\"s-tableid\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"items\":[{\"attribution\":\"s-attribution\",\"attributionLink\":\"s-attributionlink\",\"baseTableIds\":[\"s-basetableids\"],\"description\":\"s-description\",\"isExportable\":true,\"kind\":\"s-kind\",\"name\":\"s-name\",\"sql\":\"s-sql\",\"tableId\":\"s-tableid\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL fusiontables.table.list pages")
  var p = svc.table.list_pages(options: TableListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_29)
}

