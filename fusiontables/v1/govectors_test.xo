  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"baseColumn\":{\"columnId\":7,\"tableIndex\":7},\"columnId\":7,\"description\":\"s-description\",\"graph_predicate\":\"s-graph_predicate\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"type\":\"s-type\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"totalItems\":7}")
  gv_queue(f, "{\"items\":[{\"baseColumn\":{\"columnId\":7,\"tableIndex\":7},\"columnId\":7,\"description\":\"s-description\",\"graph_predicate\":\"s-graph_predicate\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"type\":\"s-type\"}],\"kind\":\"s-kind\",\"totalItems\":7}")
  gv_note(f, "CALL fusiontables.column.list pages")
  var p = svc.column.list_pages("id1/ x", options: ColumnListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_4)
}

