test "Go's fusiontables.style.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"kind\":\"s-kind\",\"markerOptions\":{\"iconName\":\"s-iconname\"},\"name\":\"s-name\",\"polygonOptions\":{\"fillColor\":\"s-fillcolor\",\"fillOpacity\":1.5,\"strokeColor\":\"s-strokecolor\",\"strokeOpacity\":1.5,\"strokeWeight\":7},\"polylineOptions\":{\"strokeColor\":\"s-strokecolor\",\"strokeOpacity\":1.5,\"strokeWeight\":7},\"styleId\":7,\"tableId\":\"s-tableid\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"totalItems\":7}")
  gv_queue(f, "{\"items\":[{\"kind\":\"s-kind\",\"markerOptions\":{\"iconName\":\"s-iconname\"},\"name\":\"s-name\",\"polygonOptions\":{\"fillColor\":\"s-fillcolor\",\"fillOpacity\":1.5,\"strokeColor\":\"s-strokecolor\",\"strokeOpacity\":1.5,\"strokeWeight\":7},\"polylineOptions\":{\"strokeColor\":\"s-strokecolor\",\"strokeOpacity\":1.5,\"strokeWeight\":7},\"styleId\":7,\"tableId\":\"s-tableid\"}],\"kind\":\"s-kind\",\"totalItems\":7}")
  gv_note(f, "CALL fusiontables.style.list pages")
  var p = svc.style.list_pages("id1/ x", options: StyleListOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_15)
}

