/// TableListPages: the pages of TableService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct TableListPages[fx: Effects] {
  r: TableService[fx]
  options: TableListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: TableService.list's pages, from the first.
pub fn (r: TableService[fx]) list_pages(options: TableListOptions = TableListOptions{}) -> TableListPages[fx] {
  TableListPages{r: r, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: TableListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: TableListPages[fx]) next_page() -> TableList ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

