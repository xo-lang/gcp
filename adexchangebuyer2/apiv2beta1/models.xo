/// OperatingSystemTargeting: Represents targeting information for operating systems.
pub struct OperatingSystemTargeting {
  /// IDs of operating systems to be included/excluded.
  pub operating_system_criteria as "operatingSystemCriteria,omitempty": CriteriaTargeting? = None
  /// IDs of operating system versions to be included/excluded.
  pub operating_system_version_criteria as "operatingSystemVersionCriteria,omitempty": CriteriaTargeting? = None
} derive Json

/// PauseProposalDealsRequest: Request message to pause serving for finalized deals.
pub struct PauseProposalDealsRequest {
  /// The external_deal_id's of the deals to be paused. If empty, all the deals in the proposal will be paused.
  pub external_deal_ids as "externalDealIds,omitempty": List[Str] = []
  /// The reason why the deals are being paused. This human readable message will be displayed in the seller's UI. (Max length: 1000 unicode code units.)
  pub reason as "reason,omitempty": Str = ""
} derive Json

/// PauseProposalRequest: Request message to pause serving for an already-finalized proposal.
pub struct PauseProposalRequest {
  /// The reason why the proposal is being paused. This human readable message will be displayed in the seller's UI. (Max length: 1000 unicode code units.)
  pub reason as "reason,omitempty": Str = ""
} derive Json

/// PlacementTargeting: Represents targeting about where the ads can appear, for example, certain sites or mobile applications. Different placement targeting types will be logically OR'ed.
pub struct PlacementTargeting {
  /// Mobile application targeting information in a deal. This doesn't apply to Auction Packages.
  pub mobile_application_targeting as "mobileApplicationTargeting,omitempty": MobileApplicationTargeting? = None
  /// URLs to be included/excluded.
  pub url_targeting as "urlTargeting,omitempty": UrlTargeting? = None
} derive Json

/// PlatformContext: Output only. The type of platform the restriction applies to.
pub struct PlatformContext {
  /// The platforms this restriction applies to.
  pub platforms as "platforms,omitempty": List[Str] = []
} derive Json

/// Price: Represents a price and a pricing type for a product / deal.
pub struct Price {
  /// The actual price with currency specified.
  pub amount as "amount,omitempty": Money? = None
  /// The pricing type for the deal/product. (default: CPM)
  pub pricing_type as "pricingType,omitempty": Str = ""
} derive Json

/// PricePerBuyer: Used to specify pricing rules for buyers/advertisers. Each PricePerBuyer in a product can become 0 or 1 deals. To check if there is a PricePerBuyer for a particular buyer or buyer/advertiser pair, we look for the most specific matching rule - we first look for a rule matching the buyer and advertiser, next a rule with the buyer but an empty advertiser list, and otherwise look for a matching rule where no buyer is set.
pub struct PricePerBuyer {
  /// The list of advertisers for this price when associated with this buyer. If empty, all advertisers with this buyer pay this price.
  pub advertiser_ids as "advertiserIds,omitempty": List[Str] = []
  /// The buyer who will pay this price. If unset, all buyers can pay this price (if the advertisers match, and there's no more specific rule matching the buyer).
  pub buyer as "buyer,omitempty": Buyer? = None
  /// The specified price.
  pub price as "price,omitempty": Price? = None
} derive Json

/// PrivateData: Buyers are allowed to store certain types of private data in a proposal/deal.
pub struct PrivateData {
  /// A buyer or seller specified reference ID. This can be queried in the list operations (max-length: 1024 unicode code units).
  pub reference_id as "referenceId,omitempty": Str = ""
} derive Json

/// Product: A product is a segment of inventory that a seller wants to sell. It is associated with certain terms and targeting information which helps the buyer know more about the inventory.
pub struct Product {
  /// The proposed end time for the deal. The field will be truncated to the order of seconds during serving.
  pub available_end_time as "availableEndTime,omitempty": Str = ""
  /// Inventory availability dates. The start time will be truncated to seconds during serving. Thus, a field specified as 3:23:34.456 (HH:mm:ss.SSS) will be truncated to 3:23:34 when serving.
  pub available_start_time as "availableStartTime,omitempty": Str = ""
  /// Creation time.
  pub create_time as "createTime,omitempty": Str = ""
  /// Optional contact information for the creator of this product.
  pub creator_contacts as "creatorContacts,omitempty": List[ContactInformation] = []
  /// The display name for this product as set by the seller.
  pub display_name as "displayName,omitempty": Str = ""
  /// If the creator has already signed off on the product, then the buyer can finalize the deal by accepting the product as is. When copying to a proposal, if any of the terms are changed, then auto_finalize is automatically set to false.
  pub has_creator_signed_off as "hasCreatorSignedOff,omitempty": Bool = false
  /// The unique ID for the product.
  pub product_id as "productId,omitempty": Str = ""
  /// The revision number of the product (auto-assigned by Marketplace).
  pub product_revision as "productRevision,omitempty,string": Int = 0
  /// An ID which can be used by the Publisher Profile API to get more information about the seller that created this product.
  pub publisher_profile_id as "publisherProfileId,omitempty": Str = ""
  /// Information about the seller that created this product.
  pub seller as "seller,omitempty": Seller? = None
  /// The syndication product associated with the deal.
  pub syndication_product as "syndicationProduct,omitempty": Str = ""
  /// Targeting that is shared between the buyer and the seller. Each targeting criterion has a specified key and for each key there is a list of inclusion value or exclusion values.
  pub targeting_criterion as "targetingCriterion,omitempty": List[TargetingCriteria] = []
  /// The negotiable terms of the deal.
  pub terms as "terms,omitempty": DealTerms? = None
  /// Time of last update.
  pub update_time as "updateTime,omitempty": Str = ""
  /// The web-property code for the seller. This needs to be copied as is when adding a new deal to a proposal.
  pub web_property_code as "webPropertyCode,omitempty": Str = ""
} derive Json

/// Proposal: Represents a proposal in the Marketplace. A proposal is the unit of negotiation between a seller and a buyer and contains deals which are served. Note: You can't update, create, or otherwise modify Private Auction deals through the API. Fields are updatable unless noted otherwise.
pub struct Proposal {
  /// Output only. Reference to the buyer that will get billed for this proposal.
  pub billed_buyer as "billedBuyer,omitempty": Buyer? = None
  /// Reference to the buyer on the proposal. Note: This field may be set only when creating the resource. Modifying this field while updating the resource will result in an error.
  pub buyer as "buyer,omitempty": Buyer? = None
  /// Contact information for the buyer.
  pub buyer_contacts as "buyerContacts,omitempty": List[ContactInformation] = []
  /// Private data for buyer. (hidden from seller).
  pub buyer_private_data as "buyerPrivateData,omitempty": PrivateData? = None
  /// The deals associated with this proposal. For Private Auction proposals (whose deals have NonGuaranteedAuctionTerms), there will only be one deal.
  pub deals as "deals,omitempty": List[Deal] = []
  /// The name for the proposal.
  pub display_name as "displayName,omitempty": Str = ""
  /// Output only. True if the proposal is being renegotiated.
  pub is_renegotiating as "isRenegotiating,omitempty": Bool = false
  /// Output only. True, if the buyside inventory setup is complete for this proposal.
  pub is_setup_complete as "isSetupComplete,omitempty": Bool = false
  /// Output only. The role of the last user that either updated the proposal or left a comment.
  pub last_updater_or_commentor_role as "lastUpdaterOrCommentorRole,omitempty": Str = ""
  /// Output only. The notes associated with this proposal.
  pub notes as "notes,omitempty": List[Note] = []
  /// Output only. Indicates whether the buyer/seller created the proposal.
  pub originator_role as "originatorRole,omitempty": Str = ""
  /// Output only. Private auction ID if this proposal is a private auction proposal.
  pub private_auction_id as "privateAuctionId,omitempty": Str = ""
  /// Output only. The unique ID of the proposal.
  pub proposal_id as "proposalId,omitempty": Str = ""
  /// Output only. The revision number for the proposal. Each update to the proposal or the deal causes the proposal revision number to auto-increment. The buyer keeps track of the last revision number they know of and pass it in when making an update. If the head revision number on the server has since incremented, then an ABORTED error is returned during the update operation to let the buyer know that a subsequent update was made.
  pub proposal_revision as "proposalRevision,omitempty,string": Int = 0
  /// Output only. The current state of the proposal.
  pub proposal_state as "proposalState,omitempty": Str = ""
  /// Reference to the seller on the proposal. Note: This field may be set only when creating the resource. Modifying this field while updating the resource will result in an error.
  pub seller as "seller,omitempty": Seller? = None
  /// Output only. Contact information for the seller.
  pub seller_contacts as "sellerContacts,omitempty": List[ContactInformation] = []
  /// Output only. The terms and conditions set by the publisher for this proposal.
  pub terms_and_conditions as "termsAndConditions,omitempty": Str = ""
  /// Output only. The time when the proposal was last revised.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

/// PublisherProfile: Represents a publisher profile (https://support.google.com/admanager/answer/6035806) in Marketplace. All fields are read only. All string fields are free-form text entered by the publisher unless noted otherwise.
pub struct PublisherProfile {
  /// Description on the publisher's audience.
  pub audience_description as "audienceDescription,omitempty": Str = ""
  /// Statement explaining what's unique about publisher's business, and why buyers should partner with the publisher.
  pub buyer_pitch_statement as "buyerPitchStatement,omitempty": Str = ""
  /// Contact information for direct reservation deals. This is free text entered by the publisher and may include information like names, phone numbers and email addresses.
  pub direct_deals_contact as "directDealsContact,omitempty": Str = ""
  /// Name of the publisher profile.
  pub display_name as "displayName,omitempty": Str = ""
  /// The list of domains represented in this publisher profile. Empty if this is a parent profile. These are top private domains, meaning that these will not contain a string like "photos.google.co.uk/123", but will instead contain "google.co.uk".
  pub domains as "domains,omitempty": List[Str] = []
  /// URL to publisher's Google+ page.
  pub google_plus_url as "googlePlusUrl,omitempty": Str = ""
  /// Indicates if this profile is the parent profile of the seller. A parent profile represents all the inventory from the seller, as opposed to child profile that is created to brand a portion of inventory. One seller should have only one parent publisher profile, and can have multiple child profiles. Publisher profiles for the same seller will have same value of field google.ads.adexchange.buyer.v2beta1.PublisherProfile.seller. See https://support.google.com/admanager/answer/6035806 for details.
  pub is_parent as "isParent,omitempty": Bool = false
  /// A Google public URL to the logo for this publisher profile. The logo is stored as a PNG, JPG, or GIF image.
  pub logo_url as "logoUrl,omitempty": Str = ""
  /// URL to additional marketing and sales materials.
  pub media_kit_url as "mediaKitUrl,omitempty": Str = ""
  /// The list of apps represented in this publisher profile. Empty if this is a parent profile.
  pub mobile_apps as "mobileApps,omitempty": List[PublisherProfileMobileApplication] = []
  /// Overview of the publisher.
  pub overview as "overview,omitempty": Str = ""
  /// Contact information for programmatic deals. This is free text entered by the publisher and may include information like names, phone numbers and email addresses.
  pub programmatic_deals_contact as "programmaticDealsContact,omitempty": Str = ""
  /// Unique ID for publisher profile.
  pub publisher_profile_id as "publisherProfileId,omitempty": Str = ""
  /// URL to a publisher rate card.
  pub rate_card_info_url as "rateCardInfoUrl,omitempty": Str = ""
  /// URL to a sample content page.
  pub sample_page_url as "samplePageUrl,omitempty": Str = ""
  /// Seller of the publisher profile.
  pub seller as "seller,omitempty": Seller? = None
  /// Up to three key metrics and rankings. Max 100 characters each. For example "#1 Mobile News Site for 20 Straight Months".
  pub top_headlines as "topHeadlines,omitempty": List[Str] = []
} derive Json

/// PublisherProfileMobileApplication: A mobile application that contains a external app ID, name, and app store.
pub struct PublisherProfileMobileApplication {
  /// The app store the app belongs to.
  pub app_store as "appStore,omitempty": Str = ""
  /// The external ID for the app from its app store.
  pub external_app_id as "externalAppId,omitempty": Str = ""
  /// The name of the app.
  pub name as "name,omitempty": Str = ""
} derive Json

/// RealtimeTimeRange: An open-ended realtime time range specified by the start timestamp. For filter sets that specify a realtime time range RTB metrics continue to be aggregated throughout the lifetime of the filter set.
pub struct RealtimeTimeRange {
  /// The start timestamp of the real-time RTB metrics aggregation.
  pub start_timestamp as "startTimestamp,omitempty": Str = ""
} derive Json

/// RelativeDateRange: A relative date range, specified by an offset and a duration. The supported range of dates begins 30 days before today and ends today, for example, the limits for these values are: offset_days >= 0 duration_days >= 1 offset_days + duration_days <= 30
pub struct RelativeDateRange {
  /// The number of days in the requested date range, for example, for a range spanning today: 1. For a range spanning the last 7 days: 7.
  pub duration_days as "durationDays,omitempty": Int = 0
  /// The end date of the filter set, specified as the number of days before today, for example, for a range where the last date is today: 0.
  pub offset_days as "offsetDays,omitempty": Int = 0
} derive Json

