/// ServingContext: The serving context for this restriction.
pub struct ServingContext {
  /// Matches all contexts.
  pub all as "all,omitempty": Str = ""
  /// Matches impressions for a particular app type.
  pub app_type as "appType,omitempty": AppContext? = None
  /// Matches impressions for a particular auction type.
  pub auction_type as "auctionType,omitempty": AuctionContext? = None
  /// Matches impressions coming from users *or* publishers in a specific location.
  pub location as "location,omitempty": LocationContext? = None
  /// Matches impressions coming from a particular platform.
  pub platform as "platform,omitempty": PlatformContext? = None
  /// Matches impressions for a particular security type.
  pub security_type as "securityType,omitempty": SecurityContext? = None
} derive Json

/// ServingRestriction: Output only. A representation of the status of an ad in a specific context. A context here relates to where something ultimately serves (for example, a user or publisher geo, a platform, an HTTPS versus HTTP request, or the type of auction).
pub struct ServingRestriction {
  /// The contexts for the restriction.
  pub contexts as "contexts,omitempty": List[ServingContext] = []
  /// Disapproval bound to this restriction. Only present if status=DISAPPROVED. Can be used to filter the response of the creatives.list method.
  pub disapproval as "disapproval,omitempty": Disapproval? = None
  /// Any disapprovals bound to this restriction. Only present if status=DISAPPROVED. Can be used to filter the response of the creatives.list method. Deprecated; use disapproval field instead.
  pub disapproval_reasons as "disapprovalReasons,omitempty": List[Disapproval] = []
  /// The status of the creative in this context (for example, it has been explicitly disapproved or is pending review).
  pub status as "status,omitempty": Str = ""
} derive Json

/// Size: Message depicting the size of the creative. The units of width and height depend on the type of the targeting.
pub struct Size {
  /// The height of the creative.
  pub height as "height,omitempty": Int = 0
  /// The width of the creative
  pub width as "width,omitempty": Int = 0
} derive Json

/// StopWatchingCreativeRequest: A request for stopping notifications for changes to creative Status.
pub struct StopWatchingCreativeRequest {} derive Json

/// TargetingCriteria: Advertisers can target different attributes of an ad slot. For example, they can choose to show ads only if the user is in the U.S. Such targeting criteria can be specified as part of Shared Targeting.
pub struct TargetingCriteria {
  /// The list of values to exclude from targeting. Each value is AND'd together.
  pub exclusions as "exclusions,omitempty": List[TargetingValue] = []
  /// The list of value to include as part of the targeting. Each value is OR'd together.
  pub inclusions as "inclusions,omitempty": List[TargetingValue] = []
  /// The key representing the shared targeting criterion. Targeting criteria defined by Google ad servers will begin with GOOG_. Third parties may define their own keys. A list of permissible keys along with the acceptable values will be provided as part of the external documentation.
  pub key as "key,omitempty": Str = ""
} derive Json

/// TargetingValue: A polymorphic targeting value used as part of Shared Targeting.
pub struct TargetingValue {
  /// The creative size value to include/exclude. Filled in when key = GOOG_CREATIVE_SIZE
  pub creative_size_value as "creativeSizeValue,omitempty": CreativeSize? = None
  /// The daypart targeting to include / exclude. Filled in when the key is GOOG_DAYPART_TARGETING. The definition of this targeting is derived from the structure used by Ad Manager.
  pub day_part_targeting_value as "dayPartTargetingValue,omitempty": DayPartTargeting? = None
  /// The long value to include/exclude.
  pub long_value as "longValue,omitempty,string": Int = 0
  /// The string value to include/exclude.
  pub string_value as "stringValue,omitempty": Str = ""
} derive Json

/// TechnologyTargeting: Represents targeting about various types of technology.
pub struct TechnologyTargeting {
  /// IDs of device capabilities to be included/excluded.
  pub device_capability_targeting as "deviceCapabilityTargeting,omitempty": CriteriaTargeting? = None
  /// IDs of device categories to be included/excluded.
  pub device_category_targeting as "deviceCategoryTargeting,omitempty": CriteriaTargeting? = None
  /// Operating system related targeting information.
  pub operating_system_targeting as "operatingSystemTargeting,omitempty": OperatingSystemTargeting? = None
} derive Json

/// TimeInterval: An interval of time, with an absolute start and end.
pub struct TimeInterval {
  /// The timestamp marking the end of the range (exclusive) for which data is included.
  pub end_time as "endTime,omitempty": Str = ""
  /// The timestamp marking the start of the range (inclusive) for which data is included.
  pub start_time as "startTime,omitempty": Str = ""
} derive Json

/// TimeOfDay: Represents a time of day. The date and time zone are either not significant or are specified elsewhere. An API may choose to allow leap seconds. Related types are google.type.Date and `google.protobuf.Timestamp`.
pub struct TimeOfDay {
  /// Hours of a day in 24 hour format. Must be greater than or equal to 0 and typically must be less than or equal to 23. An API may choose to allow the value "24:00:00" for scenarios like business closing time.
  pub hours as "hours,omitempty": Int = 0
  /// Minutes of an hour. Must be greater than or equal to 0 and less than or equal to 59.
  pub minutes as "minutes,omitempty": Int = 0
  /// Fractions of seconds, in nanoseconds. Must be greater than or equal to 0 and less than or equal to 999,999,999.
  pub nanos as "nanos,omitempty": Int = 0
  /// Seconds of a minute. Must be greater than or equal to 0 and typically must be less than or equal to 59. An API may allow the value 60 if it allows leap-seconds.
  pub seconds as "seconds,omitempty": Int = 0
} derive Json

/// UrlTargeting: Represents a list of targeted and excluded URLs (for example, google.com). For Private Auction and AdX Preferred Deals, URLs are either included or excluded. For Programmatic Guaranteed and Preferred Deals, this doesn't apply.
pub struct UrlTargeting {
  /// A list of URLs to be excluded.
  pub excluded_urls as "excludedUrls,omitempty": List[Str] = []
  /// A list of URLs to be included.
  pub targeted_urls as "targetedUrls,omitempty": List[Str] = []
} derive Json

/// VideoContent: Video content for a creative.
pub struct VideoContent {
  /// The URL to fetch a video ad.
  pub video_url as "videoUrl,omitempty": Str = ""
  /// The contents of a VAST document for a video ad. This document should conform to the VAST 2.0 or 3.0 standard.
  pub video_vast_xml as "videoVastXml,omitempty": Str = ""
} derive Json

/// VideoTargeting: Represents targeting information about video.
pub struct VideoTargeting {
  /// A list of video positions to be excluded. Position types can either be included or excluded (XOR).
  pub excluded_position_types as "excludedPositionTypes,omitempty": List[Str] = []
  /// A list of video positions to be included. When the included list is present, the excluded list must be empty. When the excluded list is present, the included list must be empty.
  pub targeted_position_types as "targetedPositionTypes,omitempty": List[Str] = []
} derive Json

/// WatchCreativeRequest: A request for watching changes to creative Status.
pub struct WatchCreativeRequest {
  /// The Pub/Sub topic to publish notifications to. This topic must already exist and must give permission to ad-exchange-buyside-reports@google.com to write to the topic. This should be the full resource name in "projects/{project_id}/topics/{topic_id}" format.
  pub topic as "topic,omitempty": Str = ""
} derive Json
