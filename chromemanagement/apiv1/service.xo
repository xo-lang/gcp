  /// When set to `true`, operations that are reachable are returned as normal, and those that are unreachable are returned in the ListOperationsResponse.unreachable field. This can only be `true` when reading across collections. For example, when `parent` is set to `"projects/example/locations/-"`. This field is not supported by default and will result in an `UNIMPLEMENTED` error if set unless explicitly documented otherwise in service or product specific documentation.
  pub return_partial_success: Bool? = None
  /// The fields of the result to return (Go's Fields), joined with commas.
  pub fields: List[Str] = []
  /// Fail with 304 when the result's ETag is this (Go's IfNoneMatch).
  pub if_none_match: Str = ""
  /// More request headers (Go's Header).
  pub headers: List[(Str, Str)] = []
}

/// list: Lists operations that match the specified filter in the request. If the server doesn't support this method, it returns `UNIMPLEMENTED`.
/// (Go's chromemanagement.operations.list.)
pub fn (r: OperationsService[fx]) list(name: Str, options: OperationsListOptions = OperationsListOptions{}) -> GoogleLongrunningListOperationsResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.filter {
    q.set("filter", v)
  }
  if let Some(v) = options.page_size {
    q.set("pageSize", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if let Some(v) = options.return_partial_success {
    q.set("returnPartialSuccess", "${v}")
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v1/{+name}"), {"name": name})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[GoogleLongrunningListOperationsResponse](resp)
}

/// OperationsListPages: the pages of OperationsService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct OperationsListPages[fx: Effects] {
  r: OperationsService[fx]
  name: Str
  options: OperationsListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: OperationsService.list's pages, from the first.
pub fn (r: OperationsService[fx]) list_pages(name: Str, options: OperationsListOptions = OperationsListOptions{}) -> OperationsListPages[fx] {
  OperationsListPages{r: r, name: name, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: OperationsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: OperationsListPages[fx]) next_page() -> GoogleLongrunningListOperationsResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(p.name, o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
  new_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
