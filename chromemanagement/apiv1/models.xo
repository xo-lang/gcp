  /// Output only. Graphics reports collected periodically.
  pub graphics_status_report as "graphicsStatusReport,omitempty": List[GoogleChromeManagementV1GraphicsStatusReport] = []
  /// Output only. Heartbeat status report containing timestamps periodically sorted in decreasing order of report_time
  pub heartbeat_status_report as "heartbeatStatusReport,omitempty": List[GoogleChromeManagementV1HeartbeatStatusReport] = []
  /// Output only. Kiosk app status report for the kiosk device
  pub kiosk_app_status_report as "kioskAppStatusReport,omitempty": List[GoogleChromeManagementV1KioskAppStatusReport] = []
  /// Output only. Information regarding memory specs for the device.
