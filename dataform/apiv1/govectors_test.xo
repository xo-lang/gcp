test "Go's dataform.projects.locations.repositories.queryDirectoryContents pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"directoryEntries\":[{\"directory\":\"s-directory\",\"file\":\"s-file\",\"metadata\":{\"sizeBytes\":\"7\",\"updateTime\":\"s-updatetime\"}}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"directoryEntries\":[{\"directory\":\"s-directory\",\"file\":\"s-file\",\"metadata\":{\"sizeBytes\":\"7\",\"updateTime\":\"s-updatetime\"}}]}")
  gv_note(f, "CALL dataform.projects.locations.repositories.queryDirectoryContents pages")
  var p = svc.projects.locations.repositories.query_directory_contents_pages("id1/ x", options: ProjectsLocationsRepositoriesQueryDirectoryContentsOptions{commit_sha: Some("s-commitsha"), page_size: Some(7), page_token: Some("s-pagetoken"), path: Some("s-path"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_37)
}

