  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"repositories\":[{\"containingFolder\":\"s-containingfolder\",\"createTime\":\"s-createtime\",\"dataEncryptionState\":{\"kmsKeyVersionName\":\"s-kmskeyversionname\"},\"displayName\":\"s-displayname\",\"endUserAuthConfig\":{},\"gitRemoteSettings\":{\"authenticationTokenSecretVersion\":\"s-authenticationtokensecretversion\",\"defaultBranch\":\"s-defaultbranch\",\"effectiveDefaultBranch\":\"s-effectivedefaultbranch\",\"gitRepositoryLink\":\"s-gitrepositorylink\",\"tokenStatus\":\"s-tokenstatus\",\"url\":\"s-url\"},\"internalMetadata\":\"s-internalmetadata\",\"kmsKeyName\":\"s-kmskeyname\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"npmrcEnvironmentVariablesSecretVersion\":\"s-npmrcenvironmentvariablessecretversion\",\"serviceAccount\":\"s-serviceaccount\",\"setAuthenticatedUserAdmin\":true,\"teamFolderName\":\"s-teamfoldername\",\"workspaceCompilationOverrides\":{\"defaultDatabase\":\"s-defaultdatabase\",\"schemaSuffix\":\"s-schemasuffix\",\"tablePrefix\":\"s-tableprefix\"}}],\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"repositories\":[{\"containingFolder\":\"s-containingfolder\",\"createTime\":\"s-createtime\",\"dataEncryptionState\":{\"kmsKeyVersionName\":\"s-kmskeyversionname\"},\"displayName\":\"s-displayname\",\"endUserAuthConfig\":{},\"gitRemoteSettings\":{\"authenticationTokenSecretVersion\":\"s-authenticationtokensecretversion\",\"defaultBranch\":\"s-defaultbranch\",\"effectiveDefaultBranch\":\"s-effectivedefaultbranch\",\"gitRepositoryLink\":\"s-gitrepositorylink\",\"tokenStatus\":\"s-tokenstatus\",\"url\":\"s-url\"},\"internalMetadata\":\"s-internalmetadata\",\"kmsKeyName\":\"s-kmskeyname\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"npmrcEnvironmentVariablesSecretVersion\":\"s-npmrcenvironmentvariablessecretversion\",\"serviceAccount\":\"s-serviceaccount\",\"setAuthenticatedUserAdmin\":true,\"teamFolderName\":\"s-teamfoldername\",\"workspaceCompilationOverrides\":{\"defaultDatabase\":\"s-defaultdatabase\",\"schemaSuffix\":\"s-schemasuffix\",\"tablePrefix\":\"s-tableprefix\"}}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL dataform.projects.locations.repositories.list pages")
  var p = svc.projects.locations.repositories.list_pages("id1/ x", options: ProjectsLocationsRepositoriesListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_33)
}

