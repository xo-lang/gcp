test "Go's monitoring.projects.dashboards.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"dashboards\":[{\"annotations\":{},\"columnLayout\":{},\"displayName\":\"s-displayname\",\"etag\":\"s-etag\",\"gridLayout\":{\"columns\":\"7\"},\"labels\":{\"k1\":\"s-labels\"},\"mosaicLayout\":{\"columns\":7},\"name\":\"s-name\",\"rowLayout\":{}}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"dashboards\":[{\"annotations\":{},\"columnLayout\":{},\"displayName\":\"s-displayname\",\"etag\":\"s-etag\",\"gridLayout\":{\"columns\":\"7\"},\"labels\":{\"k1\":\"s-labels\"},\"mosaicLayout\":{\"columns\":7},\"name\":\"s-name\",\"rowLayout\":{}}]}")
  gv_note(f, "CALL monitoring.projects.dashboards.list pages")
  var p = svc.projects.dashboards.list_pages("id1/ x", options: ProjectsDashboardsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_9)
}

