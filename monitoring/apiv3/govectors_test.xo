  gv_queue(f, "{\"alertPolicies\":[{\"alertStrategy\":{\"autoClose\":\"s-autoclose\"},\"combiner\":\"s-combiner\",\"creationRecord\":{\"mutateTime\":\"s-mutatetime\",\"mutatedBy\":\"s-mutatedby\"},\"displayName\":\"s-displayname\",\"documentation\":{\"content\":\"s-content\",\"mimeType\":\"s-mimetype\",\"subject\":\"s-subject\"},\"enabled\":true,\"mutationRecord\":{\"mutateTime\":\"s-mutatetime\",\"mutatedBy\":\"s-mutatedby\"},\"name\":\"s-name\",\"notificationChannels\":[\"s-notificationchannels\"],\"severity\":\"s-severity\",\"userLabels\":{\"k1\":\"s-userlabels\"},\"validity\":{\"code\":7,\"message\":\"s-message\"}}],\"totalSize\":7}")
  gv_note(f, "CALL monitoring.projects.alertPolicies.list pages")
