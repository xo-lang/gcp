  gv_queue(f, "{\"services\":[{\"appEngine\":{\"moduleId\":\"s-moduleid\"},\"basicService\":{\"serviceType\":\"s-servicetype\"},\"cloudEndpoints\":{\"service\":\"s-service\"},\"cloudRun\":{\"location\":\"s-location\",\"serviceName\":\"s-servicename\"},\"clusterIstio\":{\"clusterName\":\"s-clustername\",\"location\":\"s-location\",\"serviceName\":\"s-servicename\",\"serviceNamespace\":\"s-servicenamespace\"},\"custom\":{},\"displayName\":\"s-displayname\",\"gkeNamespace\":{\"clusterName\":\"s-clustername\",\"location\":\"s-location\",\"namespaceName\":\"s-namespacename\",\"projectId\":\"s-projectid\"},\"gkeService\":{\"clusterName\":\"s-clustername\",\"location\":\"s-location\",\"namespaceName\":\"s-namespacename\",\"projectId\":\"s-projectid\",\"serviceName\":\"s-servicename\"},\"gkeWorkload\":{\"clusterName\":\"s-clustername\",\"location\":\"s-location\",\"namespaceName\":\"s-namespacename\",\"projectId\":\"s-projectid\",\"topLevelControllerName\":\"s-toplevelcontrollername\",\"topLevelControllerType\":\"s-toplevelcontrollertype\"},\"istioCanonicalService\":{\"canonicalService\":\"s-canonicalservice\",\"canonicalServiceNamespace\":\"s-canonicalservicenamespace\",\"meshUid\":\"s-meshuid\"},\"meshIstio\":{\"meshUid\":\"s-meshuid\",\"serviceName\":\"s-servicename\",\"serviceNamespace\":\"s-servicenamespace\"},\"name\":\"s-name\",\"telemetry\":{\"resourceName\":\"s-resourcename\"},\"userLabels\":{\"k1\":\"s-userlabels\"}}]}")
  gv_note(f, "CALL monitoring.services.list pages")
  var p = svc.services.list_pages("id1/ x", options: ServicesListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_63)
}

