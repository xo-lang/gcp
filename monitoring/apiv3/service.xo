pub fn (r: UptimeCheckIpsService[fx]) list_pages(options: UptimeCheckIpsListOptions = UptimeCheckIpsListOptions{}) -> UptimeCheckIpsListPages[fx] {
  UptimeCheckIpsListPages{r: r, options: options}
