/// (Go's monitoring.uptimeCheckIps.list.)
pub fn (r: UptimeCheckIpsService[fx]) list(options: UptimeCheckIpsListOptions = UptimeCheckIpsListOptions{}) -> ListUptimeCheckIpsResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.page_size {
    q.set("pageSize", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v3/uptimeCheckIps"), {})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[ListUptimeCheckIpsResponse](resp)
}

/// UptimeCheckIpsListPages: the pages of UptimeCheckIpsService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct UptimeCheckIpsListPages[fx: Effects] {
  r: UptimeCheckIpsService[fx]
