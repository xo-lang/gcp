/// Whether there is a page left to fetch.
pub fn (p: UptimeCheckIpsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: UptimeCheckIpsListPages[fx]) next_page() -> ListUptimeCheckIpsResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

