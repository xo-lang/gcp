pub struct TimeSeriesQuery {
  /// Preview: A query used to fetch a time series, category series, or numeric series with SQL. This is a preview feature and may be subject to change before final release.
  pub ops_analytics_query as "opsAnalyticsQuery,omitempty": OpsAnalyticsQuery? = None
  /// Optional. If set, Cloud Monitoring will treat the full query duration as the alignment period so that there will be only 1 output value.*Note: This could override the configured alignment period except for the cases where a series of data points are expected, like - XyChart - Scorecard's spark chart
  pub output_full_duration as "outputFullDuration,omitempty": Bool = false
  /// A query used to fetch time series with PromQL.
  pub prometheus_query as "prometheusQuery,omitempty": Str = ""
  /// Filter parameters to fetch time series.
  pub time_series_filter as "timeSeriesFilter,omitempty": TimeSeriesFilter? = None
  /// Parameters to fetch a ratio between two time series filters.
  pub time_series_filter_ratio as "timeSeriesFilterRatio,omitempty": TimeSeriesFilterRatio? = None
  /// A query used to fetch time series with MQL.
  pub time_series_query_language as "timeSeriesQueryLanguage,omitempty": Str = ""
  /// Optional. Preview: Query for traces. This is a preview feature and may be subject to change before final release.
  pub trace_query as "traceQuery,omitempty": TraceQuery? = None
  /// The unit of data contained in fetched time series. If non-empty, this unit will override any unit that accompanies fetched data. The format is the same as the unit (https://cloud.google.com/monitoring/api/ref_v3/rest/v3/projects.metricDescriptors) field in MetricDescriptor.
  pub unit_override as "unitOverride,omitempty": Str = ""
} derive Json

/// TimeSeriesTable: A table that displays time series data.
pub struct TimeSeriesTable {
  /// Optional. The list of the persistent column settings for the table.
  pub column_settings as "columnSettings,omitempty": List[ColumnSettings] = []
  /// Required. The data displayed in this table.
  pub data_sets as "dataSets,omitempty": List[TableDataSet] = []
  /// Optional. Store rendering strategy
  pub metric_visualization as "metricVisualization,omitempty": Str = ""
} derive Json

/// TraceQuery: LINT.IfChange Preview: Query for traces. This is a preview feature and may be subject to change before final release.
pub struct TraceQuery {
  /// Optional. The resource name of the project or Trace scope to fetch data from. If empty, the widget will default to the project's default Trace scope. If scope cannot be determined, then we fallback to the current project. Optional.
  pub resource_container as "resourceContainer,omitempty": Str = ""
  /// The type of span data value to be displayed on the chart. Required.
  pub span_data_value as "spanDataValue,omitempty": Str = ""
  /// First version of span filtering that we will support. Required.
  pub span_filters as "spanFilters,omitempty": SpanFilters? = None
} derive Json

/// Treemap: A widget that displays hierarchical data as a treemap.
pub struct Treemap {
  /// Required. The collection of datasets used to construct and populate the treemap. For the rendered treemap rectangles: Color is determined by the aggregated value for each grouping. Size is proportional to the count of time series aggregated within that rectangle's segment.
  pub data_sets as "dataSets,omitempty": List[TreemapDataSet] = []
  /// Required. Ordered labels representing the hierarchical treemap structure.
  pub treemap_hierarchy as "treemapHierarchy,omitempty": List[Str] = []
} derive Json

/// TreemapDataSet: The data represented by the treemap. Needs to include the data itself, plus rules on how to organize it hierarchically.
pub struct TreemapDataSet {
  /// Optional. The collection of breakdowns to be applied to the dataset. A breakdown is a way to slice the data. For example, you can break down the data by region.
  pub breakdowns as "breakdowns,omitempty": List[Breakdown] = []
  /// Optional. A collection of measures. A measure is a measured value of a property in your data. For example, rainfall in inches, number of units sold, revenue gained, etc.
  pub measures as "measures,omitempty": List[Measure] = []
  /// Required. The query that fetches the relevant data. See google.monitoring.dashboard.v1.TimeSeriesQuery
  pub time_series_query as "timeSeriesQuery,omitempty": TimeSeriesQuery? = None
} derive Json

/// Type: A protocol buffer message type.New usages of this message as an alternative to DescriptorProto are strongly discouraged. This message does not reliability preserve all information necessary to model the schema and preserve semantics. Instead make use of FileDescriptorSet which preserves the necessary information.
pub struct Type {
  /// The source edition string, only valid when syntax is SYNTAX_EDITIONS.
  pub edition as "edition,omitempty": Str = ""
  /// The list of fields.
  pub fields as "fields,omitempty": List[Field] = []
  /// The fully qualified message name.
  pub name as "name,omitempty": Str = ""
  /// The list of types appearing in oneof definitions in this type.
  pub oneofs as "oneofs,omitempty": List[Str] = []
  /// The protocol buffer options.
  pub options as "options,omitempty": List[OptionModel] = []
  /// The source context.
  pub source_context as "sourceContext,omitempty": SourceContext? = None
  /// The source syntax.
  pub syntax as "syntax,omitempty": Str = ""
} derive Json

/// VisibilityCondition: Condition that determines whether the widget should be displayed.
pub struct VisibilityCondition {
  /// A condition whose evaluation is based on the value of a template variable.
  pub template_variable_condition as "templateVariableCondition,omitempty": TemplateVariableCondition? = None
} derive Json

/// Widget: Widget contains a single dashboard component and configuration of how to present the component in the dashboard.
pub struct Widget {
  /// A chart of alert policy data.
  pub alert_chart as "alertChart,omitempty": AlertChart? = None
  /// A blank space.
  pub blank as "blank,omitempty": Empty? = None
  /// A widget that groups the other widgets. All widgets that are within the area spanned by the grouping widget are considered member widgets.
  pub collapsible_group as "collapsibleGroup,omitempty": CollapsibleGroup? = None
  /// A widget that displays a list of error groups.
  pub error_reporting_panel as "errorReportingPanel,omitempty": ErrorReportingPanel? = None
  /// A widget that displays an input field to change the value of a template variable.
  pub filter_control as "filterControl,omitempty": FilterControl? = None
  /// Optional. The widget id. Ids may be made up of alphanumerics, dashes and underscores. Widget ids are optional.
  pub id as "id,omitempty": Str = ""
  /// A widget that shows list of incidents.
  pub incident_list as "incidentList,omitempty": IncidentList? = None
  /// A widget that shows a stream of logs.
  pub logs_panel as "logsPanel,omitempty": LogsPanel? = None
  /// A widget that displays timeseries data as a pie chart.
  pub pie_chart as "pieChart,omitempty": PieChart? = None
  /// A scorecard summarizing time series data.
  pub scorecard as "scorecard,omitempty": Scorecard? = None
  /// A widget that defines a section header for easier navigation of the dashboard.
  pub section_header as "sectionHeader,omitempty": SectionHeader? = None
  /// A widget that groups the other widgets by using a dropdown menu.
  pub single_view_group as "singleViewGroup,omitempty": SingleViewGroup? = None
  /// A raw string or markdown displaying textual content.
  pub text as "text,omitempty": Text? = None
  /// Optional. Represents a time range for the widget. When set, this time range will override the dashboard time range. Supported for line, stacked area and stacked bar widgets only.
  pub time_range as "timeRange,omitempty": TimeRange? = None
  /// A widget that displays time series data in a tabular format.
  pub time_series_table as "timeSeriesTable,omitempty": TimeSeriesTable? = None
  /// Optional. The title of the widget.
  pub title as "title,omitempty": Str = ""
  /// A widget that displays data as a treemap.
  pub treemap as "treemap,omitempty": Treemap? = None
  /// Optional. If set, this widget is rendered only when the condition is evaluated to true.
  pub visibility_condition as "visibilityCondition,omitempty": VisibilityCondition? = None
  /// A chart of time series data.
  pub xy_chart as "xyChart,omitempty": XyChart? = None
} derive Json

/// XyChart: A chart that displays data on a 2D (X and Y axes) plane.
pub struct XyChart {
  /// Display options for the chart.
  pub chart_options as "chartOptions,omitempty": ChartOptions? = None
  /// Required. The data displayed in this chart.
  pub data_sets as "dataSets,omitempty": List[DataSet] = []
  /// Threshold lines drawn horizontally across the chart.
  pub thresholds as "thresholds,omitempty": List[Threshold] = []
  /// The duration used to display a comparison chart. A comparison chart simultaneously shows values from two similar-length time periods (e.g., week-over-week metrics). The duration must be positive, and it can only be applied to charts with data sets of LINE plot type.
  pub timeshift_duration as "timeshiftDuration,omitempty": Str = ""
  /// The properties applied to the x-axis.
  pub x_axis as "xAxis,omitempty": Axis? = None
  /// The properties applied to the y2-axis.
  pub y2_axis as "y2Axis,omitempty": Axis? = None
  /// The properties applied to the y-axis.
  pub y_axis as "yAxis,omitempty": Axis? = None
} derive Json
