  pub headers: List[(Str, Str)] = []
}

/// list: Lists all the sites available in an account.
/// (Go's adsense.accounts.sites.list.)
pub fn (r: AccountsSitesService[fx]) list(parent: Str, options: AccountsSitesListOptions = AccountsSitesListOptions{}) -> ListSitesResponse ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.page_size {
    q.set("pageSize", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "v2/{+parent}/sites"), {"parent": parent})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[ListSitesResponse](resp)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> Service[fx] {
