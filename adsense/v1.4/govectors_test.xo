  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"items\":[{\"compatibleDimensions\":[\"s-compatibledimensions\"],\"compatibleMetrics\":[\"s-compatiblemetrics\"],\"id\":\"s-id\",\"kind\":\"s-kind\",\"requiredDimensions\":[\"s-requireddimensions\"],\"requiredMetrics\":[\"s-requiredmetrics\"],\"supportedProducts\":[\"s-supportedproducts\"]}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL adsense.metadata.metrics.list")
  match svc.metadata.metrics.list(options: MetadataMetricsListOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_31)
}

