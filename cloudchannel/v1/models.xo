  /// If true, disables commitment-based offer on renewal and switches to flexible or pay as you go. Deprecated: Use `payment_plan` instead.
  pub disable_commitment as "disableCommitment,omitempty": Bool = false
  /// If false, the plan will be completed at the end date.
  pub enable_renewal as "enableRenewal,omitempty": Bool = false
  /// Describes how frequently the reseller will be billed, such as once per month.
  pub payment_cycle as "paymentCycle,omitempty": GoogleCloudChannelV1alpha1Period? = None
  /// Set if enable_renewal=true. Deprecated: Use `payment_cycle` instead.
  pub payment_option as "paymentOption,omitempty": Str = ""
  /// Describes how a reseller will be billed.
  pub payment_plan as "paymentPlan,omitempty": Str = ""
  /// If true and enable_renewal = true, the unit (for example seats or licenses) will be set to the number of active units at renewal time.
  pub resize_unit_count as "resizeUnitCount,omitempty": Bool = false
  /// Output only. The offer resource name that the entitlement will renew on at the end date. Takes the form: accounts/{account_id}/offers/{offer_id}.
  pub scheduled_renewal_offer as "scheduledRenewalOffer,omitempty": Str = ""
} derive Json

