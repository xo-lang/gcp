}

/// list_by_activity: Shut down. See https://developers.google.com/+/api-shutdown for more details.
/// (Go's plusDomains.people.listByActivity.)
pub fn (r: PeopleService[fx]) list_by_activity(activity_id: Str, collection: Str, options: PeopleListByActivityOptions = PeopleListByActivityOptions{}) -> PeopleFeed ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.max_results {
    q.set("maxResults", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "activities/{activityId}/people/{collection}"), {"activityId": activity_id, "collection": collection})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
