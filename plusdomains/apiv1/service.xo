  options: PeopleListByActivityOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_by_activity_pages: PeopleService.list_by_activity's pages, from the first.
pub fn (r: PeopleService[fx]) list_by_activity_pages(activity_id: Str, collection: Str, options: PeopleListByActivityOptions = PeopleListByActivityOptions{}) -> PeopleListByActivityPages[fx] {
  PeopleListByActivityPages{r: r, activity_id: activity_id, collection: collection, options: options}
