  gv_set(f, "{\"etag\":\"s-etag\",\"items\":[{\"aboutMe\":\"s-aboutme\",\"birthday\":\"s-birthday\",\"braggingRights\":\"s-braggingrights\",\"circledByCount\":7,\"cover\":{\"coverInfo\":{\"leftImageOffset\":7,\"topImageOffset\":7},\"coverPhoto\":{\"height\":7,\"url\":\"s-url\",\"width\":7},\"layout\":\"s-layout\"},\"currentLocation\":\"s-currentlocation\",\"displayName\":\"s-displayname\",\"domain\":\"s-domain\",\"emails\":[{\"type\":\"s-type\",\"value\":\"s-value\"}],\"etag\":\"s-etag\",\"gender\":\"s-gender\",\"id\":\"s-id\",\"image\":{\"isDefault\":true,\"url\":\"s-url\"},\"isPlusUser\":true,\"kind\":\"s-kind\",\"name\":{\"familyName\":\"s-familyname\",\"formatted\":\"s-formatted\",\"givenName\":\"s-givenname\",\"honorificPrefix\":\"s-honorificprefix\",\"honorificSuffix\":\"s-honorificsuffix\",\"middleName\":\"s-middlename\"},\"nickname\":\"s-nickname\",\"objectType\":\"s-objecttype\",\"occupation\":\"s-occupation\",\"organizations\":[{\"department\":\"s-department\",\"description\":\"s-description\",\"endDate\":\"s-enddate\",\"location\":\"s-location\",\"name\":\"s-name\",\"primary\":true,\"startDate\":\"s-startdate\",\"title\":\"s-title\",\"type\":\"s-type\"}],\"placesLived\":[{\"primary\":true,\"value\":\"s-value\"}],\"plusOneCount\":7,\"relationshipStatus\":\"s-relationshipstatus\",\"skills\":\"s-skills\",\"tagline\":\"s-tagline\",\"url\":\"s-url\",\"urls\":[{\"label\":\"s-label\",\"type\":\"s-type\",\"value\":\"s-value\"}],\"verified\":true}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\",\"selfLink\":\"s-selflink\",\"title\":\"s-title\",\"totalItems\":7}")
  gv_note(f, "CALL plusDomains.people.listByActivity")
  match svc.people.list_by_activity("id1/ x", "id2/ x", options: PeopleListByActivityOptions{max_results: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_9)
}
