test "Go's discovery.apis.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"discoveryVersion\":\"s-discoveryversion\",\"items\":[{\"description\":\"s-description\",\"discoveryLink\":\"s-discoverylink\",\"discoveryRestUrl\":\"s-discoveryresturl\",\"documentationLink\":\"s-documentationlink\",\"icons\":{\"x16\":\"s-x16\",\"x32\":\"s-x32\"},\"id\":\"s-id\",\"kind\":\"s-kind\",\"labels\":[\"s-labels\"],\"name\":\"s-name\",\"preferred\":true,\"title\":\"s-title\",\"version\":\"s-version\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL discovery.apis.list")
  match svc.apis.list(options: ApisListOptions{name: Some("s-name"), preferred: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_1)
}
