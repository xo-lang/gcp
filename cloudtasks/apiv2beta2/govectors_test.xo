  gv_queue(f, "{\"tasks\":[{\"appEngineHttpRequest\":{\"httpMethod\":\"s-httpmethod\",\"payload\":\"YWI=\",\"relativeUrl\":\"s-relativeurl\"},\"createTime\":\"s-createtime\",\"httpRequest\":{\"body\":\"YWI=\",\"httpMethod\":\"s-httpmethod\",\"url\":\"s-url\"},\"name\":\"s-name\",\"pullMessage\":{\"payload\":\"YWI=\",\"tag\":\"s-tag\"},\"retryConfig\":{\"maxAttempts\":7,\"maxBackoff\":\"s-maxbackoff\",\"maxDoublings\":7,\"maxRetryDuration\":\"s-maxretryduration\",\"minBackoff\":\"s-minbackoff\",\"unlimitedAttempts\":true},\"scheduleTime\":\"s-scheduletime\",\"status\":{\"attemptDispatchCount\":7,\"attemptResponseCount\":7},\"view\":\"s-view\"}]}")
  gv_note(f, "CALL cloudtasks.projects.locations.queues.tasks.list pages")
  var p = svc.projects.locations.queues.tasks.list_pages("id1/ x", options: ProjectsLocationsQueuesTasksListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), response_view: Some("s-responseview"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_29)
}

