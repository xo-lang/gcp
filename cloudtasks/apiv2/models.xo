pub fn (m: UriOverride) body_marked() -> Bool {
  if m.force_send_fields.len() > 0 || m.null_fields.len() > 0 {
    return true
  }
  if let Some(c) = m.path_override {
    if c.body_marked() {
      return true
    }
  }
  if let Some(c) = m.query_override {
    if c.body_marked() {
      return true
    }
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: UriOverride) body_mark(v: json.Value) -> json.Value {
  var o = v
  if let Some(c) = m.path_override {
    o = gensupport.mark_field(o, "pathOverride", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  if let Some(c) = m.query_override {
    o = gensupport.mark_field(o, "queryOverride", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  gensupport.mark(o, m.force_send_fields.map(uri_override_field_entry), m.null_fields.map(uri_override_field_entry))
}
