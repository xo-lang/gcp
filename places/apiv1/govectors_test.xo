  gv_note(f, "CALL places.places.searchText")
  match svc.places.search_text(json.decode_str[GoogleMapsPlacesV1SearchTextRequest]("{\"evOptions\":{\"connectorTypes\":[\"s-connectortypes\"],\"minimumChargingRateKw\":1.5},\"includeFutureOpeningBusinesses\":true,\"includePureServiceAreaBusinesses\":true,\"includedType\":\"s-includedtype\",\"languageCode\":\"s-languagecode\",\"locationBias\":{\"circle\":{\"radius\":1.5},\"rectangle\":{}},\"locationRestriction\":{\"rectangle\":{}},\"maxResultCount\":7,\"minRating\":1.5,\"openNow\":true,\"pageSize\":7,\"pageToken\":\"s-pagetoken\",\"priceLevels\":[\"s-pricelevels\"],\"rankPreference\":\"s-rankpreference\",\"regionCode\":\"s-regioncode\",\"routingParameters\":{\"origin\":{\"latitude\":1.5,\"longitude\":1.5},\"routeModifiers\":{\"avoidFerries\":true,\"avoidHighways\":true,\"avoidIndoor\":true,\"avoidTolls\":true},\"routingPreference\":\"s-routingpreference\",\"travelMode\":\"s-travelmode\"},\"searchAlongRouteParameters\":{\"polyline\":{\"encodedPolyline\":\"s-encodedpolyline\"}},\"strictTypeFiltering\":true,\"textQuery\":\"s-textquery\"}") ?? e => fault(e.display()), options: PlacesSearchTextOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_3)
}

