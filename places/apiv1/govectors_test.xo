\"freeGarageParking\":true,\"freeParkingLot\":true,\"freeStreetParking\":true,\"paidGarageParking\":true,\"paidParkingLot\":true,\"paidStreetParking\":true,\"valetParking\":true},\"paymentOptions\":{\"acceptsCashOnly\":true,\"acceptsCreditCards\":true,\"acceptsDebitCards\":true,\"acceptsNfc\":true},\"plusCode\":{\"compoundCode\":\"s-compoundcode\",\"globalCode\":\"s-globalcode\"},\"postalAddress\":{\"administrativeArea\":\"s-administrativearea\",\"languageCode\":\"s-languagecode\",\"locality\":\"s-locality\",\"organization\":\"s-organization\",\"postalCode\":\"s-postalcode\",\"regionCode\":\"s-regioncode\",\"revision\":7,\"sortingCode\":\"s-sortingcode\",\"sublocality\":\"s-sublocality\"},\"priceLevel\":\"s-pricelevel\",\"priceRange\":{},\"primaryType\":\"s-primarytype\",\"primaryTypeDisplayName\":{\"languageCode\":\"s-languagecode\",\"text\":\"s-text\"},\"pureServiceAreaBusiness\":true,\"rating\":1.5,\"regularOpeningHours\":{\"nextCloseTime\":\"s-nextclosetime\",\"nextOpenTime\":\"s-nextopentime\",\"openNow\":true,\"secondaryHoursType\":\"s-secondaryhourstype\"},\"reservable\":true,\"restroom\":true,\"reviewSummary\":{\"flagContentUri\":\"s-flagcontenturi\",\"reviewsUri\":\"s-reviewsuri\"},\"servesBeer\":true,\"servesBreakfast\":true,\"servesBrunch\":true,\"servesCocktails\":true,\"servesCoffee\":true,\"servesDessert\":true,\"servesDinner\":true,\"servesLunch\":true,\"servesVegetarianFood\":true,\"servesWine\":true,\"shortFormattedAddress\":\"s-shortformattedaddress\",\"takeout\":true,\"timeZone\":{\"id\":\"s-id\",\"version\":\"s-version\"},\"transitStation\":{},\"types\":[\"s-types\"],\"userRatingCount\":7,\"utcOffsetMinutes\":7,\"viewport\":{},\"websiteUri\":\"s-websiteuri\"}],\"routingSummaries\":[{\"directionsUri\":\"s-directionsuri\"}]}")
