  gv_note(f, "CALL places.places.searchText pages")
  var p = svc.places.search_text_pages(json.decode_str[GoogleMapsPlacesV1SearchTextRequest]("{\"evOptions\":{\"connectorTypes\":[\"s-connectortypes\"],\"minimumChargingRateKw\":1.5},\"includeFutureOpeningBusinesses\":true,\"includePureServiceAreaBusinesses\":true,\"includedType\":\"s-includedtype\",\"languageCode\":\"s-languagecode\",\"locationBias\":{\"circle\":{\"radius\":1.5},\"rectangle\":{}},\"locationRestriction\":{\"rectangle\":{}},\"maxResultCount\":7,\"minRating\":1.5,\"openNow\":true,\"pageSize\":7,\"pageToken\":\"s-pagetoken\",\"priceLevels\":[\"s-pricelevels\"],\"rankPreference\":\"s-rankpreference\",\"regionCode\":\"s-regioncode\",\"routingParameters\":{\"origin\":{\"latitude\":1.5,\"longitude\":1.5},\"routeModifiers\":{\"avoidFerries\":true,\"avoidHighways\":true,\"avoidIndoor\":true,\"avoidTolls\":true},\"routingPreference\":\"s-routingpreference\",\"travelMode\":\"s-travelmode\"},\"searchAlongRouteParameters\":{\"polyline\":{\"encodedPolyline\":\"s-encodedpolyline\"}},\"strictTypeFiltering\":true,\"textQuery\":\"s-textquery\"}") ?? e => fault(e.display()), options: PlacesSearchTextOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_4)
}

const GO_5: List[Str] = [
  "CALL places.places.photos.getMedia",
  "REQ GET https://places.googleapis.com/v1/id1/%20x?alt=json&fields=kind%2Cid&maxHeightPx=7&maxWidthPx=7&prettyPrint=false&skipHttpRedirect=true",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"name\":\"s-name\",\"photoUri\":\"s-photouri\"}",
  "OUT: {\"name\":\"s-name\",\"photoUri\":\"s-photouri\"}",
]

test "Go's places.places.photos.getMedia" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"name\":\"s-name\",\"photoUri\":\"s-photouri\"}")
  gv_note(f, "CALL places.places.photos.getMedia")
  match svc.places.photos.get_media("id1/ x", options: PlacesPhotosGetMediaOptions{max_height_px: Some(7), max_width_px: Some(7), skip_http_redirect: Some(true), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_5)
}
