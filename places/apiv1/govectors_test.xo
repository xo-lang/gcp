// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 places/v1 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://places.googleapis.com"

const GO_0: List[Str] = [
  "CALL places.places.autocomplete",
  "REQ POST https://places.googleapis.com/v1/places:autocomplete?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"includeFutureOpeningBusinesses\":true,\"includePureServiceAreaBusinesses\":true,\"includeQueryPredictions\":true,\"includedPrimaryTypes\":[\"s-includedprimarytypes\"],\"includedRegionCodes\":[\"s-includedregioncodes\"],\"input\":\"s-input\",\"inputOffset\":7,\"languageCode\":\"s-languagecode\",\"locationBias\":{\"circle\":{\"radius\":1.5},\"rectangle\":{}},\"locationRestriction\":{\"circle\":{\"radius\":1.5},\"rectangle\":{}},\"origin\":{\"latitude\":1.5,\"longitude\":1.5},\"regionCode\":\"s-regioncode\",\"sessionToken\":\"s-sessiontoken\"}",
  "",
  "  SERVED 200 {\"suggestions\":[{\"placePrediction\":{\"distanceMeters\":7,\"place\":\"s-place\",\"placeId\":\"s-placeid\"},\"queryPrediction\":{}}]}",
  "OUT: {\"suggestions\":[{\"placePrediction\":{\"distanceMeters\":7,\"place\":\"s-place\",\"placeId\":\"s-placeid\"},\"queryPrediction\":{}}]}",
]

test "Go's places.places.autocomplete" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"suggestions\":[{\"placePrediction\":{\"distanceMeters\":7,\"place\":\"s-place\",\"placeId\":\"s-placeid\"},\"queryPrediction\":{}}]}")
  gv_note(f, "CALL places.places.autocomplete")
  match svc.places.autocomplete(json.decode_str[GoogleMapsPlacesV1AutocompletePlacesRequest]("{\"includeFutureOpeningBusinesses\":true,\"includePureServiceAreaBusinesses\":true,\"includeQueryPredictions\":true,\"includedPrimaryTypes\":[\"s-includedprimarytypes\"],\"includedRegionCodes\":[\"s-includedregioncodes\"],\"input\":\"s-input\",\"inputOffset\":7,\"languageCode\":\"s-languagecode\",\"locationBias\":{\"circle\":{\"radius\":1.5},\"rectangle\":{}},\"locationRestriction\":{\"circle\":{\"radius\":1.5},\"rectangle\":{}},\"origin\":{\"latitude\":1.5,\"longitude\":1.5},\"regionCode\":\"s-regioncode\",\"sessionToken\":\"s-sessiontoken\"}") ?? e => fault(e.display()), options: PlacesAutocompleteOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

