test "Go's dialogflow.projects.locations.agents.playbooks.versions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"playbookVersions\":[{\"description\":\"s-description\",\"name\":\"s-name\",\"playbook\":{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"goal\":\"s-goal\",\"name\":\"s-name\",\"playbookType\":\"s-playbooktype\",\"tokenCount\":\"7\",\"updateTime\":\"s-updatetime\"},\"updateTime\":\"s-updatetime\"}]}")
  gv_queue(f, "{\"playbookVersions\":[{\"description\":\"s-description\",\"name\":\"s-name\",\"playbook\":{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"goal\":\"s-goal\",\"name\":\"s-name\",\"playbookType\":\"s-playbooktype\",\"tokenCount\":\"7\",\"updateTime\":\"s-updatetime\"},\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL dialogflow.projects.locations.agents.playbooks.versions.list pages")
  var p = svc.projects.locations.agents.playbooks.versions.list_pages("id1/ x", options: ProjectsLocationsAgentsPlaybooksVersionsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_122)
}

