  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"changelogs\":[{\"action\":\"s-action\",\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"languageCode\":\"s-languagecode\",\"name\":\"s-name\",\"resource\":\"s-resource\",\"type\":\"s-type\",\"userEmail\":\"s-useremail\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"changelogs\":[{\"action\":\"s-action\",\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"languageCode\":\"s-languagecode\",\"name\":\"s-name\",\"resource\":\"s-resource\",\"type\":\"s-type\",\"userEmail\":\"s-useremail\"}]}")
  gv_note(f, "CALL dialogflow.projects.locations.agents.changelogs.list pages")
  var p = svc.projects.locations.agents.changelogs.list_pages("id1/ x", options: ProjectsLocationsAgentsChangelogsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_17)
}

