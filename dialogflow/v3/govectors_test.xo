test "Go's dialogflow.projects.locations.agents.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"agents\":[{\"advancedSettings\":{},\"answerFeedbackSettings\":{\"enableAnswerFeedback\":true},\"avatarUri\":\"s-avataruri\",\"clientCertificateSettings\":{\"passphrase\":\"s-passphrase\",\"privateKey\":\"s-privatekey\",\"sslCertificate\":\"s-sslcertificate\"},\"defaultLanguageCode\":\"s-defaultlanguagecode\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"enableMultiLanguageTraining\":true,\"enableSpellCorrection\":true,\"enableStackdriverLogging\":true,\"genAppBuilderSettings\":{\"engine\":\"s-engine\"},\"gitIntegrationSettings\":{},\"locked\":true,\"name\":\"s-name\",\"personalizationSettings\":{\"defaultEndUserMetadata\":{\"k\":\"v\"}},\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"securitySettings\":\"s-securitysettings\",\"speechToTextSettings\":{\"enableSpeechAdaptation\":true},\"startFlow\":\"s-startflow\",\"startPlaybook\":\"s-startplaybook\",\"supportedLanguageCodes\":[\"s-supportedlanguagecodes\"],\"textToSpeechSettings\":{},\"timeZone\":\"s-timezone\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"agents\":[{\"advancedSettings\":{},\"answerFeedbackSettings\":{\"enableAnswerFeedback\":true},\"avatarUri\":\"s-avataruri\",\"clientCertificateSettings\":{\"passphrase\":\"s-passphrase\",\"privateKey\":\"s-privatekey\",\"sslCertificate\":\"s-sslcertificate\"},\"defaultLanguageCode\":\"s-defaultlanguagecode\",\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"enableMultiLanguageTraining\":true,\"enableSpellCorrection\":true,\"enableStackdriverLogging\":true,\"genAppBuilderSettings\":{\"engine\":\"s-engine\"},\"gitIntegrationSettings\":{},\"locked\":true,\"name\":\"s-name\",\"personalizationSettings\":{\"defaultEndUserMetadata\":{\"k\":\"v\"}},\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"securitySettings\":\"s-securitysettings\",\"speechToTextSettings\":{\"enableSpeechAdaptation\":true},\"startFlow\":\"s-startflow\",\"startPlaybook\":\"s-startplaybook\",\"supportedLanguageCodes\":[\"s-supportedlanguagecodes\"],\"textToSpeechSettings\":{},\"timeZone\":\"s-timezone\"}]}")
  gv_note(f, "CALL dialogflow.projects.locations.agents.list pages")
  var p = svc.projects.locations.agents.list_pages("id1/ x", options: ProjectsLocationsAgentsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_10)
}

