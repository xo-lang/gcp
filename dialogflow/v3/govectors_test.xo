  gv_queue(f, "{\"generators\":[{\"displayName\":\"s-displayname\",\"llmModelSettings\":{\"model\":\"s-model\",\"promptText\":\"s-prompttext\"},\"modelParameter\":{\"maxDecodeSteps\":7,\"temperature\":1.5,\"topK\":7,\"topP\":1.5},\"name\":\"s-name\",\"promptText\":{\"text\":\"s-text\"}}]}")
  gv_note(f, "CALL dialogflow.projects.locations.agents.generators.list pages")
  var p = svc.projects.locations.agents.generators.list_pages("id1/ x", options: ProjectsLocationsAgentsGeneratorsListOptions{language_code: Some("s-languagecode"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
