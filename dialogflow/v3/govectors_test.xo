test "Go's dialogflow.projects.locations.agents.intents.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"intents\":[{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"dtmfPattern\":\"s-dtmfpattern\",\"isFallback\":true,\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"priority\":7}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"intents\":[{\"description\":\"s-description\",\"displayName\":\"s-displayname\",\"dtmfPattern\":\"s-dtmfpattern\",\"isFallback\":true,\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"priority\":7}]}")
  gv_note(f, "CALL dialogflow.projects.locations.agents.intents.list pages")
  var p = svc.projects.locations.agents.intents.list_pages("id1/ x", options: ProjectsLocationsAgentsIntentsListOptions{intent_view: Some("s-intentview"), language_code: Some("s-languagecode"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
