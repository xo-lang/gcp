ame\":\"s-name\",\"phoneNumber\":{\"countryCode\":7,\"phoneNumber\":\"s-phonenumber\"},\"startTime\":\"s-starttime\",\"telephonyConnectionInfo\":{\"dialedNumber\":\"s-dialednumber\",\"extraMimeContents\":[{\"content\":\"YWI=\",\"mimeType\":\"s-mimetype\"}],\"sdp\":\"s-sdp\",\"sipHeaders\":[{\"name\":\"s-name\",\"value\":\"s-value\"}]}}")
