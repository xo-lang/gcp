// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 kgsearch/v1 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://kgsearch.googleapis.com"

const GO_0: List[Str] = [
  "CALL kgsearch.entities.search",
  "REQ GET https://kgsearch.googleapis.com/v1/entities:search?alt=json&fields=kind%2Cid&ids=s-ids&indent=true&languages=s-languages&limit=7&prefix=true&prettyPrint=false&query=s-query&types=s-types",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"itemListElement\":[{\"k\":\"v\"}]}",
  "OUT: {\"itemListElement\":[{\"k\":\"v\"}]}",
]

test "Go's kgsearch.entities.search" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"itemListElement\":[{\"k\":\"v\"}]}")
  gv_note(f, "CALL kgsearch.entities.search")
  match svc.entities.search(options: EntitiesSearchOptions{ids: ["s-ids"], indent: Some(true), languages: ["s-languages"], limit: Some(7), prefix: Some(true), query: Some("s-query"), types: ["s-types"], fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
