// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 displayvideo/v5 with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json
use github.com/xo-lang/gcp/gensupport

const GV_HOST: Str = "https://displayvideo.googleapis.com"

const GO_0: List[Str] = [
  "CALL displayvideo.media.download",
  "REQ GET https://displayvideo.googleapis.com/download/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"resourceName\":\"s-resourcename\"}",
  "OUT: {\"resourceName\":\"s-resourcename\"}",
]

test "Go's displayvideo.media.download" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"resourceName\":\"s-resourcename\"}")
  gv_note(f, "CALL displayvideo.media.download")
  match svc.media.download("id1/ x", options: MediaDownloadOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

