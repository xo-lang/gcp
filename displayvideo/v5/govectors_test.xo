  match svc.media.upload_media(os.clock, os.rand, "id1/ x", json.decode_str[GoogleBytestreamMedia]("{\"resourceName\":\"s-resourcename\"}") ?? e => fault(e.display()), media: gensupport.Media{data: gv_big(), content_type: "text/plain", chunk_size: 262144}, options: MediaUploadOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
