// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://displayvideo.googleapis.com"

const GO_0: List[Str] = [
  "CALL displayvideo.advertisers.audit",
  "REQ GET https://displayvideo.googleapis.com/v4/advertisers/7:audit?alt=json&fields=kind%2Cid&prettyPrint=false&readMask=s-readmask",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"adGroupCriteriaCount\":\"7\",\"campaignCriteriaCount\":\"7\",\"channelsCount\":\"7\",\"negativeKeywordListsCount\":\"7\",\"negativelyTargetedChannelsCount\":\"7\",\"usedCampaignsCount\":\"7\",\"usedInsertionOrdersCount\":\"7\",\"usedLineItemsCount\":\"7\"}",
