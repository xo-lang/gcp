test "Go's displayvideo.advertisers.adAssets.upload" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"adAsset\":{\"adAssetId\":\"7\",\"adAssetType\":\"s-adassettype\",\"entityStatus\":\"s-entitystatus\",\"name\":\"s-name\",\"syntheticContentAttestationStatus\":\"s-syntheticcontentattestationstatus\",\"youtubeVideoAsset\":{\"youtubeVideoId\":\"s-youtubevideoid\"}}}")
  gv_note(f, "CALL displayvideo.advertisers.adAssets.upload")
  match svc.advertisers.ad_assets.upload("7", json.decode_str[UploadAdAssetRequest]("{\"adAssetType\":\"s-adassettype\",\"filename\":\"s-filename\",\"syntheticContentAttestationStatus\":\"s-syntheticcontentattestationstatus\"}") ?? e => fault(e.display()), options: AdvertisersAdAssetsUploadOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_13)
}

