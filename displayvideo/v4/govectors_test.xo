]

test "Go's displayvideo.advertisers.audit" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"adGroupCriteriaCount\":\"7\",\"campaignCriteriaCount\":\"7\",\"channelsCount\":\"7\",\"negativeKeywordListsCount\":\"7\",\"negativelyTargetedChannelsCount\":\"7\",\"usedCampaignsCount\":\"7\",\"usedInsertionOrdersCount\":\"7\",\"usedLineItemsCount\":\"7\"}")
  gv_note(f, "CALL displayvideo.advertisers.audit")
  match svc.advertisers.audit("7", options: AdvertisersAuditOptions{read_mask: Some("s-readmask"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

