/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct YoutubeVideoDetails {
  /// Output only. The YouTube video ID which can be searched on YouTube webpage.
  pub id as "id,omitempty": Str = ""
  /// Output only. The reason why the video data is not available.
  pub unavailable_reason as "unavailableReason,omitempty": Str = ""
  /// Required. The YouTube video asset id. This is the adAssetId of an AdAsset resource.
  pub video_asset_id as "videoAssetId,omitempty,string": Int = 0
  pub force_send_fields as "-": List[YoutubeVideoDetailsField] = []
  pub null_fields as "-": List[YoutubeVideoDetailsField] = []
} derive Json

/// YoutubeVideoDetailsField: YoutubeVideoDetails's fields, for force_send_fields and null_fields.
pub enum YoutubeVideoDetailsField {
  Id
  UnavailableReason
  VideoAssetId
}

fn youtube_video_details_field_entry(f: YoutubeVideoDetailsField) -> Str {
  match f {
    Id => "id=\"\""
    UnavailableReason => "unavailableReason=\"\""
    VideoAssetId => "videoAssetId=\"0\""
  }
}

/// body_marked: whether m, or a model in it, sets force_send_fields or
/// null_fields (decision 0013; the service's request bodies ask).
pub fn (m: YoutubeVideoDetails) body_marked() -> Bool {
  if m.force_send_fields.len() > 0 || m.null_fields.len() > 0 {
    return true
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: YoutubeVideoDetails) body_mark(v: json.Value) -> json.Value {
  var o = v
  gensupport.mark(o, m.force_send_fields.map(youtube_video_details_field_entry), m.null_fields.map(youtube_video_details_field_entry))
}
