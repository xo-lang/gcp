  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"sites\":[{\"name\":\"s-name\",\"urlOrAppId\":\"s-urlorappid\"}]}",
  "REQ GET https://displayvideo.googleapis.com/v1/advertisers/7/channels/7/sites?alt=json&fields=kind%2Cid&filter=s-filter&orderBy=s-orderby&pageSize=7&pageToken=s-nextpagetoken&partnerId=7&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"sites\":[{\"name\":\"s-name\",\"urlOrAppId\":\"s-urlorappid\"}]}",
  "OUT: {\"sites\":[{\"name\":\"s-name\",\"urlOrAppId\":\"s-urlorappid\"}]}",
  "OUT: ok",
]

test "Go's displayvideo.advertisers.channels.sites.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"sites\":[{\"name\":\"s-name\",\"urlOrAppId\":\"s-urlorappid\"}]}")
  gv_queue(f, "{\"sites\":[{\"name\":\"s-name\",\"urlOrAppId\":\"s-urlorappid\"}]}")
  gv_note(f, "CALL displayvideo.advertisers.channels.sites.list pages")
  var p = svc.advertisers.channels.sites.list_pages(7, 7, options: AdvertisersChannelsSitesListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), partner_id: Some(7), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_33)
}

