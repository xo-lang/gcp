test "Go's displayvideo.media.upload resumable" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "@H Location=https://displayvideo.googleapis.com/upload/session-1 @B ")
  gv_queue(f, "@H X-Http-Status-Code-Override=308 @B ")
  gv_queue(f, "{\"resourceName\":\"s-resourcename\"}")
  gv_note(f, "CALL displayvideo.media.upload resumable")
  match svc.media.upload_media(os.clock, os.rand, "id1/ x", json.decode_str[GoogleBytestreamMedia]("{\"resourceName\":\"s-resourcename\"}") ?? e => fault(e.display()), media: gensupport.Media{data: gv_big(), content_type: "text/plain", chunk_size: 262144}, options: MediaUploadOptions{fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_158)
}

