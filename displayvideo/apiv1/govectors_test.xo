test "Go's displayvideo.inventorySourceGroups.assignedInventorySources.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"assignedInventorySources\":[{\"assignedInventorySourceId\":\"7\",\"inventorySourceId\":\"s-inventorysourceid\",\"name\":\"s-name\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"assignedInventorySources\":[{\"assignedInventorySourceId\":\"7\",\"inventorySourceId\":\"s-inventorysourceid\",\"name\":\"s-name\"}]}")
  gv_note(f, "CALL displayvideo.inventorySourceGroups.assignedInventorySources.list pages")
  var p = svc.inventory_source_groups.assigned_inventory_sources.list_pages(7, options: InventorySourceGroupsAssignedInventorySourcesListOptions{advertiser_id: Some(7), filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), partner_id: Some(7), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_147)
}

