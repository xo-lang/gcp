test "Go's displayvideo.users.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"users\":[{\"displayName\":\"s-displayname\",\"email\":\"s-email\",\"lastLoginTime\":\"s-lastlogintime\",\"name\":\"s-name\",\"userId\":\"7\"}]}")
  gv_queue(f, "{\"users\":[{\"displayName\":\"s-displayname\",\"email\":\"s-email\",\"lastLoginTime\":\"s-lastlogintime\",\"name\":\"s-name\",\"userId\":\"7\"}]}")
  gv_note(f, "CALL displayvideo.users.list pages")
  var p = svc.users.list_pages(options: UsersListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_191)
}

