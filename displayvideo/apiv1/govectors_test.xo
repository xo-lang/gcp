  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"inventorySources\":[{\"commitment\":\"s-commitment\",\"dealId\":\"s-dealid\",\"deliveryMethod\":\"s-deliverymethod\",\"displayName\":\"s-displayname\",\"exchange\":\"s-exchange\",\"guaranteedOrderId\":\"s-guaranteedorderid\",\"inventorySourceId\":\"7\",\"inventorySourceProductType\":\"s-inventorysourceproducttype\",\"inventorySourceType\":\"s-inventorysourcetype\",\"name\":\"s-name\",\"publisherName\":\"s-publishername\",\"rateDetails\":{\"inventorySourceRateType\":\"s-inventorysourceratetype\",\"unitsPurchased\":\"7\"},\"readAdvertiserIds\":[\"7\"],\"readPartnerIds\":[\"7\"],\"readWriteAccessors\":{},\"status\":{\"configStatus\":\"s-configstatus\",\"entityPauseReason\":\"s-entitypausereason\",\"entityStatus\":\"s-entitystatus\",\"sellerPauseReason\":\"s-sellerpausereason\",\"sellerStatus\":\"s-sellerstatus\"},\"timeRange\":{\"endTime\":\"s-endtime\",\"startTime\":\"s-starttime\"},\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"inventorySources\":[{\"commitment\":\"s-commitment\",\"dealId\":\"s-dealid\",\"deliveryMethod\":\"s-deliverymethod\",\"displayName\":\"s-displayname\",\"exchange\":\"s-exchange\",\"guaranteedOrderId\":\"s-guaranteedorderid\",\"inventorySourceId\":\"7\",\"inventorySourceProductType\":\"s-inventorysourceproducttype\",\"inventorySourceType\":\"s-inventorysourcetype\",\"name\":\"s-name\",\"publisherName\":\"s-publishername\",\"rateDetails\":{\"inventorySourceRateType\":\"s-inventorysourceratetype\",\"unitsPurchased\":\"7\"},\"readAdvertiserIds\":[\"7\"],\"readPartnerIds\":[\"7\"],\"readWriteAccessors\":{},\"status\":{\"configStatus\":\"s-configstatus\",\"entityPauseReason\":\"s-entitypausereason\",\"entityStatus\":\"s-entitystatus\",\"sellerPauseReason\":\"s-sellerpausereason\",\"sellerStatus\":\"s-sellerstatus\"},\"timeRange\":{\"endTime\":\"s-endtime\",\"startTime\":\"s-starttime\"},\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL displayvideo.inventorySources.list pages")
  var p = svc.inventory_sources.list_pages(options: InventorySourcesListOptions{advertiser_id: Some(7), filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), partner_id: Some(7), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_152)
}

