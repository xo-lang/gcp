test "Go's displayvideo.advertisers.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"advertisers\":[{\"adServerConfig\":{},\"advertiserId\":\"7\",\"creativeConfig\":{\"dynamicCreativeEnabled\":true,\"iasClientId\":\"7\",\"obaComplianceDisabled\":true,\"videoCreativeDataSharingAuthorized\":true},\"dataAccessConfig\":{},\"displayName\":\"s-displayname\",\"entityStatus\":\"s-entitystatus\",\"generalConfig\":{\"currencyCode\":\"s-currencycode\",\"domainUrl\":\"s-domainurl\",\"timeZone\":\"s-timezone\"},\"integrationDetails\":{\"details\":\"s-details\",\"integrationCode\":\"s-integrationcode\"},\"name\":\"s-name\",\"partnerId\":\"7\",\"prismaEnabled\":true,\"servingConfig\":{\"exemptTvFromViewabilityTargeting\":true},\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"advertisers\":[{\"adServerConfig\":{},\"advertiserId\":\"7\",\"creativeConfig\":{\"dynamicCreativeEnabled\":true,\"iasClientId\":\"7\",\"obaComplianceDisabled\":true,\"videoCreativeDataSharingAuthorized\":true},\"dataAccessConfig\":{},\"displayName\":\"s-displayname\",\"entityStatus\":\"s-entitystatus\",\"generalConfig\":{\"currencyCode\":\"s-currencycode\",\"domainUrl\":\"s-domainurl\",\"timeZone\":\"s-timezone\"},\"integrationDetails\":{\"details\":\"s-details\",\"integrationCode\":\"s-integrationcode\"},\"name\":\"s-name\",\"partnerId\":\"7\",\"prismaEnabled\":true,\"servingConfig\":{\"exemptTvFromViewabilityTargeting\":true},\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL displayvideo.advertisers.list pages")
  var p = svc.advertisers.list_pages(options: AdvertisersListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), partner_id: Some(7), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_8)
}

