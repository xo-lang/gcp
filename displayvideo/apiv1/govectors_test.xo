  "REQ POST https://displayvideo.googleapis.com/v1/advertisers/7/channels/7/sites?alt=json&fields=kind%2Cid&partnerId=7&prettyPrint=false",
  "  H content-type=application/json | x-extra=v1",
  "  B {\"name\":\"s-name\",\"urlOrAppId\":\"s-urlorappid\"}",
  "",
  "  SERVED 200 {\"name\":\"s-name\",\"urlOrAppId\":\"s-urlorappid\"}",
  "OUT: {\"name\":\"s-name\",\"urlOrAppId\":\"s-urlorappid\"}",
]

test "Go's displayvideo.advertisers.channels.sites.create" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"name\":\"s-name\",\"urlOrAppId\":\"s-urlorappid\"}")
  gv_note(f, "CALL displayvideo.advertisers.channels.sites.create")
  match svc.advertisers.channels.sites.create(7, 7, json.decode_str[Site]("{\"name\":\"s-name\",\"urlOrAppId\":\"s-urlorappid\"}") ?? e => fault(e.display()), options: AdvertisersChannelsSitesCreateOptions{partner_id: Some(7), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_30)
}

