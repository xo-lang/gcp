const GV_HOST: Str = "https://displayvideo.googleapis.com"

const GO_0: List[Str] = [
  "CALL displayvideo.advertisers.audit",
  "REQ GET https://displayvideo.googleapis.com/v1/advertisers/7:audit?alt=json&fields=kind%2Cid&prettyPrint=false&readMask=s-readmask",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
