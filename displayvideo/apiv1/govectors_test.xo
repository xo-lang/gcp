test "Go's displayvideo.advertisers.campaigns.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"campaigns\":[{\"advertiserId\":\"7\",\"campaignFlight\":{\"plannedSpendAmountMicros\":\"7\"},\"campaignGoal\":{\"campaignGoalType\":\"s-campaigngoaltype\"},\"campaignId\":\"7\",\"displayName\":\"s-displayname\",\"entityStatus\":\"s-entitystatus\",\"frequencyCap\":{\"maxImpressions\":7,\"timeUnit\":\"s-timeunit\",\"timeUnitCount\":7,\"unlimited\":true},\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"campaigns\":[{\"advertiserId\":\"7\",\"campaignFlight\":{\"plannedSpendAmountMicros\":\"7\"},\"campaignGoal\":{\"campaignGoalType\":\"s-campaigngoaltype\"},\"campaignId\":\"7\",\"displayName\":\"s-displayname\",\"entityStatus\":\"s-entitystatus\",\"frequencyCap\":{\"maxImpressions\":7,\"timeUnit\":\"s-timeunit\",\"timeUnitCount\":7,\"unlimited\":true},\"name\":\"s-name\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL displayvideo.advertisers.campaigns.list pages")
  var p = svc.advertisers.campaigns.list_pages(7, options: AdvertisersCampaignsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_19)
}

