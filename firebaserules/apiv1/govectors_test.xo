  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"rulesets\":[{\"attachmentPoint\":\"s-attachmentpoint\",\"createTime\":\"s-createtime\",\"metadata\":{},\"name\":\"s-name\",\"source\":{}}]}")
  gv_queue(f, "{\"rulesets\":[{\"attachmentPoint\":\"s-attachmentpoint\",\"createTime\":\"s-createtime\",\"metadata\":{},\"name\":\"s-name\",\"source\":{}}]}")
  gv_note(f, "CALL firebaserules.projects.rulesets.list pages")
  var p = svc.projects.rulesets.list_pages("id1/ x", options: ProjectsRulesetsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_12)
}
