      return true
    }
  }
  for c in m.libraries {
    if c.body_marked() {
      return true
    }
  }
  if let Some(c) = m.manual_scaling {
    if c.body_marked() {
      return true
    }
  }
  if let Some(c) = m.network {
    if c.body_marked() {
      return true
    }
  }
  if let Some(c) = m.resources {
