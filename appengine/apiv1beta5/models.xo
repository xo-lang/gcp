      return true
    }
  }
  false
}

/// body_mark: v, m's JSON, with the force and null entries of m and of
/// the models in it, for gensupport.apply_fields (decision 0013).
pub fn (m: Version) body_mark(v: json.Value) -> json.Value {
  var o = v
  if let Some(c) = m.api_config {
    o = gensupport.mark_field(o, "apiConfig", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  if let Some(c) = m.automatic_scaling {
    o = gensupport.mark_field(o, "automaticScaling", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  if let Some(c) = m.basic_scaling {
    o = gensupport.mark_field(o, "basicScaling", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  if let Some(c) = m.deployment {
    o = gensupport.mark_field(o, "deployment", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  if let Some(c) = m.endpoints_api_service {
    o = gensupport.mark_field(o, "endpointsApiService", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  o = gensupport.mark_field(o, "errorHandlers", fn(x: json.Value) -> json.Value { gensupport.mark_list(x, fn(i: Int, e: json.Value) -> json.Value { m.error_handlers[i].body_mark(e) }) })
  o = gensupport.mark_field(o, "handlers", fn(x: json.Value) -> json.Value { gensupport.mark_list(x, fn(i: Int, e: json.Value) -> json.Value { m.handlers[i].body_mark(e) }) })
  if let Some(c) = m.health_check {
    o = gensupport.mark_field(o, "healthCheck", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  o = gensupport.mark_field(o, "libraries", fn(x: json.Value) -> json.Value { gensupport.mark_list(x, fn(i: Int, e: json.Value) -> json.Value { m.libraries[i].body_mark(e) }) })
  if let Some(c) = m.manual_scaling {
    o = gensupport.mark_field(o, "manualScaling", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  if let Some(c) = m.network {
    o = gensupport.mark_field(o, "network", fn(x: json.Value) -> json.Value { c.body_mark(x) })
  }
  if let Some(c) = m.resources {
    o = gensupport.mark_field(o, "resources", fn(x: json.Value) -> json.Value { c.body_mark(x) })
