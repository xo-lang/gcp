/// TrafficSplit: Traffic routing configuration for versions within a single service. Traffic splits define how traffic directed to the service is assigned to versions.
pub struct TrafficSplit {
  /// Mapping from version IDs within the service to fractional (0.000, 1] allocations of traffic for that version. Each version can be specified only once, but some versions in the service may not have any traffic allocation. Services that have traffic allocated cannot be deleted until either the service is deleted or their traffic allocation is removed. Allocations must sum to 1. Up to two decimal place precision is supported for IP-based splits and up to three decimal places is supported for cookie-based splits.
  pub allocations as "allocations,omitempty": Map[Str, Float] = {}
  /// Mechanism used to determine which version a request is sent to. The traffic selection algorithm will be stable for either type until allocations are changed.
  pub shard_by as "shardBy,omitempty": Str = ""
} derive Json

/// UrlDispatchRule: Rules to match an HTTP request and dispatch that request to a service.
pub struct UrlDispatchRule {
  /// Domain name to match against. The wildcard "*" is supported if specified before a period: "*.".Defaults to matching all domains: "*".
  pub domain as "domain,omitempty": Str = ""
  /// Pathname within the host. Must start with a "/". A single "*" can be included at the end of the path.The sum of the lengths of the domain and path may not exceed 100 characters.
  pub path as "path,omitempty": Str = ""
  /// Resource ID of a service in this application that should serve the matched request. The service must already exist. Example: default.
  pub service as "service,omitempty": Str = ""
} derive Json

/// UrlMap: URL pattern and description of how the URL should be handled. App Engine can handle URLs by executing application code or by serving static files uploaded with the version, such as images, CSS, or JavaScript.
pub struct UrlMap {
  /// Uses API Endpoints to handle requests.
  pub api_endpoint as "apiEndpoint,omitempty": ApiEndpointHandler? = None
  /// Action to take when users access resources that require authentication. Defaults to redirect.
  pub auth_fail_action as "authFailAction,omitempty": Str = ""
  /// Level of login required to access this resource. Not supported for Node.js in the App Engine standard environment.
  pub login as "login,omitempty": Str = ""
  /// 30x code to use when performing redirects for the secure field. Defaults to 302.
  pub redirect_http_response_code as "redirectHttpResponseCode,omitempty": Str = ""
  /// Executes a script to handle the requests that match this URL pattern. Only the auto value is supported for Node.js in the App Engine standard environment, for example "script": "auto".
  pub script as "script,omitempty": ScriptHandler? = None
  /// Security (HTTPS) enforcement for this URL.
  pub security_level as "securityLevel,omitempty": Str = ""
  /// Returns the contents of a file, such as an image, as the response.
  pub static_files as "staticFiles,omitempty": StaticFilesHandler? = None
  /// URL prefix. Uses regular expression syntax, which means regexp special characters must be escaped, but should not contain groupings. All URLs that begin with this prefix are handled by this handler, using the portion of the URL after the prefix as part of the file path.
  pub url_regex as "urlRegex,omitempty": Str = ""
} derive Json

/// Version: A Version resource is a specific set of source code and configuration files that are deployed into a service.
pub struct Version {
  /// Serving configuration for Google Cloud Endpoints (https://cloud.google.com/endpoints).Only returned in GET requests if view=FULL is set.
  pub api_config as "apiConfig,omitempty": ApiConfigHandler? = None
  /// Allows App Engine second generation runtimes to access the legacy bundled services.
  pub app_engine_apis as "appEngineApis,omitempty": Bool = false
  /// List of specific App Engine Bundled Services that are enabled for this Version.
  pub app_engine_bundled_services as "appEngineBundledServices,omitempty": List[Str] = []
  /// Automatic scaling is based on request rate, response latencies, and other application metrics. Instances are dynamically created and destroyed as needed in order to handle traffic.
  pub automatic_scaling as "automaticScaling,omitempty": AutomaticScaling? = None
  /// A service with basic scaling will create an instance when the application receives a request. The instance will be turned down when the app becomes idle. Basic scaling is ideal for work that is intermittent or driven by user activity.
  pub basic_scaling as "basicScaling,omitempty": BasicScaling? = None
  /// Metadata settings that are supplied to this version to enable beta runtime features.
  pub beta_settings as "betaSettings,omitempty": Map[Str, Str] = {}
  /// Environment variables available to the build environment.Only returned in GET requests if view=FULL is set.
  pub build_env_variables as "buildEnvVariables,omitempty": Map[Str, Str] = {}
  /// Time that this version was created.@OutputOnly
  pub create_time as "createTime,omitempty": Str = ""
  /// Output only. Email address of the user who created this version.@OutputOnly
  pub created_by as "createdBy,omitempty": Str = ""
  /// Duration that static files should be cached by web proxies and browsers. Only applicable if the corresponding StaticFilesHandler (https://cloud.google.com/appengine/docs/admin-api/reference/rest/v1/apps.services.versions#StaticFilesHandler) does not specify its own expiration time.Only returned in GET requests if view=FULL is set.
  pub default_expiration as "defaultExpiration,omitempty": Str = ""
  /// Code and application artifacts that make up this version.Only returned in GET requests if view=FULL is set.
  pub deployment as "deployment,omitempty": Deployment? = None
  /// Output only. Total size in bytes of all the files that are included in this version and currently hosted on the App Engine disk.@OutputOnly
  pub disk_usage_bytes as "diskUsageBytes,omitempty,string": Int = 0
  /// Cloud Endpoints configuration.If endpoints_api_service is set, the Cloud Endpoints Extensible Service Proxy will be provided to serve the API implemented by the app.
  pub endpoints_api_service as "endpointsApiService,omitempty": EndpointsApiService? = None
  /// The entrypoint for the application.
  pub entrypoint as "entrypoint,omitempty": Entrypoint? = None
  /// App Engine execution environment for this version.Defaults to standard.
  pub env as "env,omitempty": Str = ""
  /// Environment variables available to the application.Only returned in GET requests if view=FULL is set.
  pub env_variables as "envVariables,omitempty": Map[Str, Str] = {}
  /// Custom static error pages. Limited to 10KB per page.Only returned in GET requests if view=FULL is set.
  pub error_handlers as "errorHandlers,omitempty": List[ErrorHandler] = []
  /// Settings for App Engine flexible runtimes.
  pub flexible_runtime_settings as "flexibleRuntimeSettings,omitempty": FlexibleRuntimeSettings? = None
  /// Additional Google Generated Customer Metadata, this field won't be provided by default and can be requested by setting the IncludeExtraData field in GetVersionRequest
  pub generated_customer_metadata as "generatedCustomerMetadata,omitempty": json.Value? = None
  /// An ordered list of URL-matching patterns that should be applied to incoming requests. The first matching URL handles the request and other request handlers are not attempted.Only returned in GET requests if view=FULL is set.
  pub handlers as "handlers,omitempty": List[UrlMap] = []
  /// Configures health checking for instances. Unhealthy instances are stopped and replaced with new instances. Only applicable in the App Engine flexible environment.
  pub health_check as "healthCheck,omitempty": HealthCheck? = None
  /// Relative name of the version within the service. Example: v1. Version names can contain only lowercase letters, numbers, or hyphens. Reserved names: "default", "latest", and any name with the prefix "ah-".
  pub id as "id,omitempty": Str = ""
  /// Before an application can receive email or XMPP messages, the application must be configured to enable the service.
  pub inbound_services as "inboundServices,omitempty": List[Str] = []
  /// Instance class that is used to run this version. Valid values are: AutomaticScaling: F1, F2, F4, F4_1G ManualScaling or BasicScaling: B1, B2, B4, B8, B4_1GDefaults to F1 for AutomaticScaling and B1 for ManualScaling or BasicScaling.
  pub instance_class as "instanceClass,omitempty": Str = ""
  /// Configuration for third-party Python runtime libraries that are required by the application.Only returned in GET requests if view=FULL is set.
  pub libraries as "libraries,omitempty": List[Library] = []
  /// Configures liveness health checking for instances. Unhealthy instances are stopped and replaced with new instances
  pub liveness_check as "livenessCheck,omitempty": LivenessCheck? = None
  /// A service with manual scaling runs continuously, allowing you to perform complex initialization and rely on the state of its memory over time. Manually scaled versions are sometimes referred to as "backends".
  pub manual_scaling as "manualScaling,omitempty": ManualScaling? = None
  /// Output only. Full path to the Version resource in the API. Example: apps/myapp/services/default/versions/v1.@OutputOnly
  pub name as "name,omitempty": Str = ""
  /// Extra network settings. Only applicable in the App Engine flexible environment.
  pub network as "network,omitempty": Network? = None
  /// Files that match this pattern will not be built into this version. Only applicable for Go runtimes.Only returned in GET requests if view=FULL is set.
  pub nobuild_files_regex as "nobuildFilesRegex,omitempty": Str = ""
  /// Configures readiness health checking for instances. Unhealthy instances are not put into the backend traffic rotation.
  pub readiness_check as "readinessCheck,omitempty": ReadinessCheck? = None
  /// Machine resources for this version. Only applicable in the App Engine flexible environment.
  pub resources as "resources,omitempty": Resources? = None
  /// Desired runtime. Example: python27.
  pub runtime as "runtime,omitempty": Str = ""
  /// The version of the API in the given runtime environment. Please see the app.yaml reference for valid values at https://cloud.google.com/appengine/docs/standard//config/appref
  pub runtime_api_version as "runtimeApiVersion,omitempty": Str = ""
  /// The channel of the runtime to use. Only available for some runtimes. Defaults to the default channel.
  pub runtime_channel as "runtimeChannel,omitempty": Str = ""
  /// The path or name of the app's main executable.
  pub runtime_main_executable_path as "runtimeMainExecutablePath,omitempty": Str = ""
  /// The identity that the deployed version will run as. Admin API will use the App Engine Appspot service account as default if this field is neither provided in app.yaml file nor through CLI flag.
  pub service_account as "serviceAccount,omitempty": Str = ""
  /// Current serving status of this version. Only the versions with a SERVING status create instances and can be billed.SERVING_STATUS_UNSPECIFIED is an invalid value. Defaults to SERVING.
  pub serving_status as "servingStatus,omitempty": Str = ""
  /// Whether multiple requests can be dispatched to this version at once.
  pub threadsafe as "threadsafe,omitempty": Bool = false
  /// Output only. Serving URL for this version. Example: "https://myversion-dot-myservice-dot-myapp.appspot.com"@OutputOnly
  pub version_url as "versionUrl,omitempty": Str = ""
  /// Whether to deploy this version in a container on a virtual machine.
  pub vm as "vm,omitempty": Bool = false
  /// Enables VPC access connectivity for standard apps.
  pub vpc_access as "vpcAccess,omitempty": VpcAccess? = None
  /// Enables VPC connectivity for standard apps.
  pub vpc_access_connector as "vpcAccessConnector,omitempty": VpcAccessConnector? = None
  /// The Google Compute Engine zones that are supported by this version in the App Engine flexible environment. Deprecated.
  pub zones as "zones,omitempty": List[Str] = []
} derive Json

/// Volume: Volumes mounted within the app container. Only applicable in the App Engine flexible environment.
pub struct Volume {
  /// Unique name for the volume.
  pub name as "name,omitempty": Str = ""
  /// Volume size in gigabytes.
  pub size_gb as "sizeGb,omitempty": Float = 0.0
  /// Underlying volume type, e.g. 'tmpfs'.
  pub volume_type as "volumeType,omitempty": Str = ""
} derive Json

/// VpcAccess: VPC Access settings
pub struct VpcAccess {
  /// The Direct VPC configuration. Currently only single network interface is supported.
  pub network_interfaces as "networkInterfaces,omitempty": List[VpcNetworkInterface] = []
  /// The traffic egress setting for the VPC network interface, controlling what traffic is diverted through it.
  pub vpc_egress as "vpcEgress,omitempty": Str = ""
} derive Json

/// VpcAccessConnector: VPC access connector specification.
pub struct VpcAccessConnector {
  /// The egress setting for the connector, controlling what traffic is diverted through it.
  pub egress_setting as "egressSetting,omitempty": Str = ""
  /// Full Serverless VPC Access Connector name e.g. projects/my-project/locations/us-central1/connectors/c1.
  pub name as "name,omitempty": Str = ""
} derive Json

/// VpcNetworkInterface: Network interface key message.
pub struct VpcNetworkInterface {
  /// Optional. The VPC network that the App Engine resource will be able to send traffic to. At least one of network or subnetwork must be specified. If both network and subnetwork are specified, the given VPC subnetwork must belong to the given VPC network. If network is not specified, it will be looked up from the subnetwork. Could be either a short name or a full path. e.g. {VPC_NETWORK} or projects/{HOST_PROJECT_ID}/global/networks/{VPC_NETWORK}
  pub network as "network,omitempty": Str = ""
  /// Optional. The VPC subnetwork that the App Engine resource will get IPs from. At least one of network or subnetwork must be specified. If both network and subnetwork are specified, the given VPC subnetwork must belong to the given VPC network. If subnetwork is not specified, the subnetwork with the same name with the network will be used. Could be either a short name or a full path. e.g. {SUBNET_NAME} or projects/{HOST_PROJECT_ID}/regions/{REGION}/subnetworks/{SUBNET_NAME}
  pub subnet as "subnet,omitempty": Str = ""
  /// Optional. The network tags that will be applied to this App Engine resource.
  pub tags as "tags,omitempty": List[Str] = []
} derive Json

/// ZipInfo: The zip file information for a zip deployment.
pub struct ZipInfo {
  /// An estimate of the number of files in a zip for a zip deployment. If set, must be greater than or equal to the actual number of files. Used for optimizing performance; if not provided, deployment may be slow.
  pub files_count as "filesCount,omitempty": Int = 0
  /// URL of the zip file to deploy from. Must be a URL to a resource in Google Cloud Storage in the form 'http(s)://storage.googleapis.com//'.
  pub source_url as "sourceUrl,omitempty": Str = ""
} derive Json
