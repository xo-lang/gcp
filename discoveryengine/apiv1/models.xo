/// GoogleCloudDiscoveryengineV1betaDataStore: DataStore captures global settings and configs at the DataStore level.
pub struct GoogleCloudDiscoveryengineV1betaDataStore {
  /// Immutable. Whether data in the DataStore has ACL information. If set to `true`, the source data must have ACL. ACL will be ingested when data is ingested by DocumentService.ImportDocuments methods. When ACL is enabled for the DataStore, Document can't be accessed by calling DocumentService.GetDocument or DocumentService.ListDocuments. Currently ACL is only supported in `GENERIC` industry vertical with non-`PUBLIC_WEBSITE` content config.
  pub acl_enabled as "aclEnabled,omitempty": Bool = false
  /// Optional. Configuration for advanced site search.
  pub advanced_site_search_config as "advancedSiteSearchConfig,omitempty": GoogleCloudDiscoveryengineV1betaAdvancedSiteSearchConfig? = None
  /// Output only. Data size estimation for billing.
  pub billing_estimation as "billingEstimation,omitempty": GoogleCloudDiscoveryengineV1betaDataStoreBillingEstimation? = None
  /// Output only. CMEK-related information for the DataStore.
  pub cmek_config as "cmekConfig,omitempty": GoogleCloudDiscoveryengineV1betaCmekConfig? = None
  /// Optional. Configuration for configurable billing approach. See
  pub configurable_billing_approach as "configurableBillingApproach,omitempty": Str = ""
  /// Output only. The timestamp when configurable_billing_approach was last updated.
  pub configurable_billing_approach_update_time as "configurableBillingApproachUpdateTime,omitempty": Str = ""
  /// Immutable. The content config of the data store. If this field is unset, the server behavior defaults to ContentConfig.NO_CONTENT.
  pub content_config as "contentConfig,omitempty": Str = ""
  /// Output only. Timestamp the DataStore was created at.
  pub create_time as "createTime,omitempty": Str = ""
  /// Output only. The id of the default Schema associated to this data store.
  pub default_schema_id as "defaultSchemaId,omitempty": Str = ""
  /// Required. The data store display name. This field must be a UTF-8 encoded string with a length limit of 128 characters. Otherwise, an INVALID_ARGUMENT error is returned.
  pub display_name as "displayName,omitempty": Str = ""
  /// Configuration for Document understanding and enrichment.
  pub document_processing_config as "documentProcessingConfig,omitempty": GoogleCloudDiscoveryengineV1betaDocumentProcessingConfig? = None
  /// Optional. If set, this DataStore is a federated search DataStore.
  pub federated_search_config as "federatedSearchConfig,omitempty": GoogleCloudDiscoveryengineV1betaDataStoreFederatedSearchConfig? = None
  /// Optional. Configuration for `HEALTHCARE_FHIR` vertical.
  pub healthcare_fhir_config as "healthcareFhirConfig,omitempty": GoogleCloudDiscoveryengineV1betaHealthcareFhirConfig? = None
  /// Immutable. The fully qualified resource name of the associated IdentityMappingStore. This field can only be set for acl_enabled DataStores with `THIRD_PARTY` or `GSUITE` IdP. Format: `projects/{project}/locations/{location}/identityMappingStores/{identity_mapping_store}`.
  pub identity_mapping_store as "identityMappingStore,omitempty": Str = ""
  /// Immutable. The industry vertical that the data store registers.
  pub industry_vertical as "industryVertical,omitempty": Str = ""
  /// Optional. If set, this DataStore is an Infobot FAQ DataStore.
  pub is_infobot_faq_data_store as "isInfobotFaqDataStore,omitempty": Bool = false
  /// Input only. The KMS key to be used to protect this DataStore at creation time. Must be set for requests that need to comply with CMEK Org Policy protections. If this field is set and processed successfully, the DataStore will be protected by the KMS key, as indicated in the cmek_config field.
  pub kms_key_name as "kmsKeyName,omitempty": Str = ""
  /// Language info for DataStore.
  pub language_info as "languageInfo,omitempty": GoogleCloudDiscoveryengineV1betaLanguageInfo? = None
  /// Immutable. Identifier. The full resource name of the data store. Format: `projects/{project}/locations/{location}/collections/{collection_id}/dataStores/{data_store_id}`. This field must be a UTF-8 encoded string with a length limit of 1024 characters.
  pub name as "name,omitempty": Str = ""
  /// Optional. Configuration for Natural Language Query Understanding.
  pub natural_language_query_understanding_config as "naturalLanguageQueryUnderstandingConfig,omitempty": GoogleCloudDiscoveryengineV1betaNaturalLanguageQueryUnderstandingConfig? = None
  /// Optional. Stores serving config at DataStore level.
  pub serving_config_data_store as "servingConfigDataStore,omitempty": GoogleCloudDiscoveryengineV1betaDataStoreServingConfigDataStore? = None
  /// The solutions that the data store enrolls. Available solutions for each industry_vertical: * `MEDIA`: `SOLUTION_TYPE_RECOMMENDATION` and `SOLUTION_TYPE_SEARCH`. * `SITE_SEARCH`: `SOLUTION_TYPE_SEARCH` is automatically enrolled. Other solutions cannot be enrolled.
  pub solution_types as "solutionTypes,omitempty": List[Str] = []
  /// The start schema to use for this DataStore when provisioning it. If unset, a default vertical specialized schema will be used. This field is only used by CreateDataStore API, and will be ignored if used in other APIs. This field will be omitted from all API responses including CreateDataStore API. To retrieve a schema of a DataStore, use SchemaService.GetSchema API instead. The provided schema will be validated against certain rules on schema. Learn more from [this doc](https://cloud.google.com/generative-ai-app-builder/docs/provide-schema).
  pub starting_schema as "startingSchema,omitempty": GoogleCloudDiscoveryengineV1betaSchema? = None
  /// Config to store data store type configuration for workspace data. This must be set when DataStore.content_config is set as DataStore.ContentConfig.GOOGLE_WORKSPACE.
  pub workspace_config as "workspaceConfig,omitempty": GoogleCloudDiscoveryengineV1betaWorkspaceConfig? = None
} derive Json

