  /// Optional. The interpolation type to be applied to connect the control points listed below.
  pub interpolation_type as "interpolationType,omitempty": Str = ""
} derive Json

/// GoogleCloudDiscoveryengineV1betaControlBoostActionInterpolationBoostSpecControlPoint: The control points used to define the curve. The curve defined through these control points can only be monotonically increasing or decreasing(constant values are acceptable).
