/// GoogleCloudDiscoveryengineV1alphaEngine: Metadata that describes the training and serving parameters of an Engine.
pub struct GoogleCloudDiscoveryengineV1alphaEngine {
  /// Optional. The agent gateway setting for the engine.
  pub agent_gateway_setting as "agentGatewaySetting,omitempty": GoogleCloudDiscoveryengineV1alphaAgentGatewaySetting? = None
  /// Optional. Immutable. This the application type which this engine resource represents. NOTE: this is a new concept independ of existing industry vertical or solution type.
  pub app_type as "appType,omitempty": Str = ""
  /// Configurations for the Chat Engine. Only applicable if solution_type is SOLUTION_TYPE_CHAT.
  pub chat_engine_config as "chatEngineConfig,omitempty": GoogleCloudDiscoveryengineV1alphaEngineChatEngineConfig? = None
  /// Output only. Additional information of the Chat Engine. Only applicable if solution_type is SOLUTION_TYPE_CHAT.
  pub chat_engine_metadata as "chatEngineMetadata,omitempty": GoogleCloudDiscoveryengineV1alphaEngineChatEngineMetadata? = None
  /// Output only. CMEK-related information for the Engine.
  pub cmek_config as "cmekConfig,omitempty": GoogleCloudDiscoveryengineV1alphaCmekConfig? = None
  /// Common config spec that specifies the metadata of the engine.
  pub common_config as "commonConfig,omitempty": GoogleCloudDiscoveryengineV1alphaEngineCommonConfig? = None
  /// Optional. Configuration for configurable billing approach.
  pub configurable_billing_approach as "configurableBillingApproach,omitempty": Str = ""
  /// Optional. Maps a connector ID (e.g., "hybrid-github", "shopify") to tenant-specific information required for that connector. The structure of the tenant information string is connector-dependent.
  pub connector_tenant_info as "connectorTenantInfo,omitempty": Map[Str, Str] = {}
  /// Output only. Timestamp the Recommendation Engine was created at.
  pub create_time as "createTime,omitempty": Str = ""
  /// Optional. The data stores associated with this engine. For SOLUTION_TYPE_SEARCH and SOLUTION_TYPE_RECOMMENDATION type of engines, they can only associate with at most one data store. If solution_type is SOLUTION_TYPE_CHAT, multiple DataStores in the same Collection can be associated here. Note that when used in CreateEngineRequest, one DataStore id must be provided as the system will use it for necessary initializations.
  pub data_store_ids as "dataStoreIds,omitempty": List[Str] = []
  /// Optional. Whether to disable analytics for searches performed on this engine.
  pub disable_analytics as "disableAnalytics,omitempty": Bool = false
  /// Required. The display name of the engine. Should be human readable. UTF-8 encoded string with limit of 1024 characters.
  pub display_name as "displayName,omitempty": Str = ""
  /// Optional. Feature config for the engine to opt in or opt out of features. Supported keys: * `*`: all features, if it's present, all other feature state settings are ignored. * `agent-gallery` * `no-code-agent-builder` * `prompt-gallery` * `model-selector` * `notebook-lm` * `people-search` * `people-search-org-chart` * `bi-directional-audio` * `feedback` * `session-sharing` * `personalization-memory` * `personalization-suggested-highlights` * `disable-agent-sharing` * `disable-image-generation` * `disable-video-generation` * `disable-onedrive-upload` * `disable-talk-to-content` * `disable-google-drive-upload` * `disable-welcome-emails`
  pub features as "features,omitempty": Map[Str, Str] = {}
  /// Optional. The industry vertical that the engine registers. The restriction of the Engine industry vertical is based on DataStore: Vertical on Engine has to match vertical of the DataStore linked to the engine.
  pub industry_vertical as "industryVertical,omitempty": Str = ""
  /// Optional. Configurations for the Knowledge Graph. Only applicable if solution_type is SOLUTION_TYPE_SEARCH.
  pub knowledge_graph_config as "knowledgeGraphConfig,omitempty": GoogleCloudDiscoveryengineV1alphaEngineKnowledgeGraphConfig? = None
  /// Optional. The visibility of marketplace agents in the agent gallery.
  pub marketplace_agent_visibility as "marketplaceAgentVisibility,omitempty": Str = ""
  /// Configurations for the Media Engine. Only applicable on the data stores with solution_type SOLUTION_TYPE_RECOMMENDATION and IndustryVertical.MEDIA vertical.
  pub media_recommendation_engine_config as "mediaRecommendationEngineConfig,omitempty": GoogleCloudDiscoveryengineV1alphaEngineMediaRecommendationEngineConfig? = None
  /// Optional. Maps a model name to its specific configuration for this engine. This allows admin users to turn on/off individual models. This only stores models whose states are overridden by the admin. When the state is unspecified, or model_configs is empty for this model, the system will decide if this model should be available or not based on the default configuration. For example, a preview model should be disabled by default if the admin has not chosen to enable it.
  pub model_configs as "modelConfigs,omitempty": Map[Str, Str] = {}
  /// Immutable. Identifier. The fully qualified resource name of the engine. This field must be a UTF-8 encoded string with a length limit of 1024 characters. Format: `projects/{project}/locations/{location}/collections/{collection}/engines/{engine}` engine should be 1-63 characters, and valid characters are /a-z0-9*/. Otherwise, an INVALID_ARGUMENT error is returned.
  pub name as "name,omitempty": Str = ""
  /// Optional. Observability config for the engine.
  pub observability_config as "observabilityConfig,omitempty": GoogleCloudDiscoveryengineV1alphaObservabilityConfig? = None
  /// Optional. The emails of the procurement contacts.
  pub procurement_contact_emails as "procurementContactEmails,omitempty": List[Str] = []
  /// Output only. Additional information of a recommendation engine. Only applicable if solution_type is SOLUTION_TYPE_RECOMMENDATION.
  pub recommendation_metadata as "recommendationMetadata,omitempty": GoogleCloudDiscoveryengineV1alphaEngineRecommendationMetadata? = None
  /// Configurations for the Search Engine. Only applicable if solution_type is SOLUTION_TYPE_SEARCH.
  pub search_engine_config as "searchEngineConfig,omitempty": GoogleCloudDiscoveryengineV1alphaEngineSearchEngineConfig? = None
  /// Additional config specs for a `similar-items` engine.
  pub similar_documents_config as "similarDocumentsConfig,omitempty": GoogleCloudDiscoveryengineV1alphaEngineSimilarDocumentsEngineConfig? = None
  /// Required. The solutions of the engine.
  pub solution_type as "solutionType,omitempty": Str = ""
  /// Output only. Timestamp the Recommendation Engine was last updated.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

/// GoogleCloudDiscoveryengineV1alphaEngineChatEngineConfig: Configurations for a Chat Engine.
pub struct GoogleCloudDiscoveryengineV1alphaEngineChatEngineConfig {
  /// The configurationt generate the Dialogflow agent that is associated to this Engine. Note that these configurations are one-time consumed by and passed to Dialogflow service. It means they cannot be retrieved using EngineService.GetEngine or EngineService.ListEngines API after engine creation.
