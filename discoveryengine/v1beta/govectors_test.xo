  gv_queue(f, "{\"dataStores\":[{\"aclEnabled\":true,\"advancedSiteSearchConfig\":{\"disableAutomaticRefresh\":true,\"disableInitialIndex\":true},\"billingEstimation\":{\"structuredDataSize\":\"7\",\"structuredDataUpdateTime\":\"s-structureddataupdatetime\",\"unstructuredDataSize\":\"7\",\"unstructuredDataUpdateTime\":\"s-unstructureddataupdatetime\",\"websiteDataSize\":\"7\",\"websiteDataUpdateTime\":\"s-websitedataupdatetime\"},\"cmekConfig\":{\"isDefault\":true,\"kmsKey\":\"s-kmskey\",\"kmsKeyVersion\":\"s-kmskeyversion\",\"lastRotationTimestampMicros\":\"7\",\"name\":\"s-name\",\"notebooklmState\":\"s-notebooklmstate\",\"state\":\"s-state\"},\"configurableBillingApproach\":\"s-configurablebillingapproach\",\"configurableBillingApproachUpdateTime\":\"s-configurablebillingapproachupdatetime\",\"contentConfig\":\"s-contentconfig\",\"createTime\":\"s-createtime\",\"dataProtectionPolicy\":{},\"defaultSchemaId\":\"s-defaultschemaid\",\"displayName\":\"s-displayname\",\"documentProcessingConfig\":{\"name\":\"s-name\"},\"federatedSearchConfig\":{},\"healthcareFhirConfig\":{\"enableConfigurableSchema\":true,\"enableStaticIndexingForBatchIngestion\":true},\"identityMappingStore\":\"s-identitymappingstore\",\"industryVertical\":\"s-industryvertical\",\"isInfobotFaqDataStore\":true,\"kmsKeyName\":\"s-kmskeyname\",\"languageInfo\":{\"language\":\"s-language\",\"languageCode\":\"s-languagecode\",\"normalizedLanguageCode\":\"s-normalizedlanguagecode\",\"region\":\"s-region\"},\"name\":\"s-name\",\"naturalLanguageQueryUnderstandingConfig\":{\"mode\":\"s-mode\"},\"servingConfigDataStore\":{\"disabledForServing\":true},\"solutionTypes\":[\"s-solutiontypes\"],\"startingSchema\":{\"jsonSchema\":\"s-jsonschema\",\"name\":\"s-name\",\"structSchema\":{\"k\":\"v\"}},\"workspaceConfig\":{\"dasherCustomerId\":\"s-dashercustomerid\",\"superAdminEmailAddress\":\"s-superadminemailaddress\",\"superAdminServiceAccount\":\"s-superadminserviceaccount\",\"type\":\"s-type\"}}]}")
  gv_note(f, "CALL discoveryengine.projects.locations.dataStores.list pages")
  var p = svc.projects.locations.data_stores.list_pages("id1/ x", options: ProjectsLocationsDataStoresListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_189)
}

