  gv_queue(f, "{\"userLicenses\":[{\"createTime\":\"s-createtime\",\"lastLoginTime\":\"s-lastlogintime\",\"licenseAssignmentState\":\"s-licenseassignmentstate\",\"licenseConfig\":\"s-licenseconfig\",\"updateTime\":\"s-updatetime\",\"userPrincipal\":\"s-userprincipal\",\"userProfile\":\"s-userprofile\"}]}")
  gv_note(f, "CALL discoveryengine.projects.locations.userStores.userLicenses.list pages")
  var p = svc.projects.locations.user_stores.user_licenses.list_pages("id1/ x", options: ProjectsLocationsUserStoresUserLicensesListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
