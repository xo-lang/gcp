test "Go's discoveryengine.projects.locations.dataStores.sessions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"sessions\":[{\"displayName\":\"s-displayname\",\"endTime\":\"s-endtime\",\"isPinned\":true,\"labels\":[\"s-labels\"],\"name\":\"s-name\",\"pendingAsyncAssistOperationId\":\"s-pendingasyncassistoperationid\",\"startTime\":\"s-starttime\",\"state\":\"s-state\",\"userPseudoId\":\"s-userpseudoid\"}]}")
  gv_queue(f, "{\"sessions\":[{\"displayName\":\"s-displayname\",\"endTime\":\"s-endtime\",\"isPinned\":true,\"labels\":[\"s-labels\"],\"name\":\"s-name\",\"pendingAsyncAssistOperationId\":\"s-pendingasyncassistoperationid\",\"startTime\":\"s-starttime\",\"state\":\"s-state\",\"userPseudoId\":\"s-userpseudoid\"}]}")
  gv_note(f, "CALL discoveryengine.projects.locations.dataStores.sessions.list pages")
  var p = svc.projects.locations.data_stores.sessions.list_pages("id1/ x", options: ProjectsLocationsDataStoresSessionsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_250)
}

