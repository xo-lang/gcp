  pub nvidia_driver_version as "nvidiaDriverVersion,omitempty": Str = ""
  /// If true, allocate a preemptible VM.
  pub preemptible as "preemptible,omitempty": Bool = false
  /// If specified, the VM will only be allocated inside the matching reservation. It will fail if the VM parameters don't match the reservation.
  pub reservation as "reservation,omitempty": Str = ""
  /// The service account to install on the VM. This account does not need any permissions other than those required by the pipeline.
  pub service_account as "serviceAccount,omitempty": ServiceAccount? = None
  /// The list of disks and other storage to create or attach to the VM. Specify either the `volumes[]` field or the `disks[]` field, but not both.
  pub volumes as "volumes,omitempty": List[Volume] = []
} derive Json

/// Volume: Carries information about storage that can be attached to a VM. Specify either `Volume` or `Disk`, but not both.
pub struct Volume {
  /// Configuration for a existing disk.
  pub existing_disk as "existingDisk,omitempty": ExistingDisk? = None
  /// Configuration for an NFS mount.
  pub nfs_mount as "nfsMount,omitempty": NFSMount? = None
  /// Configuration for a persistent disk.
  pub persistent_disk as "persistentDisk,omitempty": PersistentDisk? = None
  /// A user-supplied name for the volume. Used when mounting the volume into `Actions`. The name must contain only upper and lowercase alphanumeric characters and hyphens and cannot start with a hyphen.
  pub volume as "volume,omitempty": Str = ""
} derive Json

/// WorkerAssignedEvent: An event generated after a worker VM has been assigned to run the pipeline.
pub struct WorkerAssignedEvent {
  /// The worker's instance name.
  pub instance as "instance,omitempty": Str = ""
  /// The machine type that was assigned for the worker.
  pub machine_type as "machineType,omitempty": Str = ""
  /// The zone the worker is running in.
  pub zone as "zone,omitempty": Str = ""
} derive Json

/// WorkerReleasedEvent: An event generated when the worker VM that was assigned to the pipeline has been released (deleted).
pub struct WorkerReleasedEvent {
  /// The worker's instance name.
  pub instance as "instance,omitempty": Str = ""
  /// The zone the worker was running in.
  pub zone as "zone,omitempty": Str = ""
} derive Json
