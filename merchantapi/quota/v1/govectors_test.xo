use std/json

const GV_HOST: Str = "https://merchantapi.googleapis.com"

const GO_0: List[Str] = [
  "CALL merchantapi.accounts.limits.get",
  "REQ GET https://merchantapi.googleapis.com/quota/v1/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"name\":\"s-name\",\"products\":{\"limit\":\"7\",\"scope\":\"s-scope\"}}",
  "OUT: {\"name\":\"s-name\",\"products\":{\"limit\":\"7\",\"scope\":\"s-scope\"}}",
]

test "Go's merchantapi.accounts.limits.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"name\":\"s-name\",\"products\":{\"limit\":\"7\",\"scope\":\"s-scope\"}}")
  gv_note(f, "CALL merchantapi.accounts.limits.get")
  match svc.accounts.limits.get("id1/ x", options: AccountsLimitsGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

