test "Go's merchantapi.accounts.productReviews.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"productReviews\":[{\"dataSource\":\"s-datasource\",\"name\":\"s-name\",\"productReviewAttributes\":{\"aggregatorName\":\"s-aggregatorname\",\"collectionMethod\":\"s-collectionmethod\",\"content\":\"s-content\",\"isIncentivizedReview\":true,\"isSpam\":true,\"isVerifiedPurchase\":true,\"maxRating\":\"7\",\"minRating\":\"7\",\"publisherFavicon\":\"s-publisherfavicon\",\"publisherName\":\"s-publishername\",\"rating\":1.5,\"reviewCountry\":\"s-reviewcountry\",\"reviewLanguage\":\"s-reviewlanguage\",\"reviewTime\":\"s-reviewtime\",\"reviewerId\":\"s-reviewerid\",\"reviewerIsAnonymous\":true,\"reviewerUsername\":\"s-reviewerusername\",\"subclientName\":\"s-subclientname\",\"title\":\"s-title\",\"transactionId\":\"s-transactionid\"},\"productReviewId\":\"s-productreviewid\",\"productReviewStatus\":{\"createTime\":\"s-createtime\",\"lastUpdateTime\":\"s-lastupdatetime\"}}]}")
  gv_note(f, "CALL merchantapi.accounts.productReviews.list")
  match svc.accounts.product_reviews.list("id1/ x", options: AccountsProductReviewsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
