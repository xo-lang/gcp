  gv_queue(f, "{\"regionalInventories\":[{\"account\":\"7\",\"availability\":\"s-availability\",\"base64EncodedName\":\"s-base64encodedname\",\"name\":\"s-name\",\"price\":{\"amountMicros\":\"7\",\"currencyCode\":\"s-currencycode\"},\"region\":\"s-region\",\"salePrice\":{\"amountMicros\":\"7\",\"currencyCode\":\"s-currencycode\"},\"salePriceEffectiveDate\":{\"endTime\":\"s-endtime\",\"startTime\":\"s-starttime\"}}]}")
  gv_note(f, "CALL merchantapi.accounts.products.regionalInventories.list pages")
  var p = svc.accounts.products.regional_inventories.list_pages("id1/ x", options: AccountsProductsRegionalInventoriesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_7)
}
