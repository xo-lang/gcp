test "Go's merchantapi.accounts.lfpStores.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"lfpStores\":[{\"gcidCategory\":[\"s-gcidcategory\"],\"matchingState\":\"s-matchingstate\",\"matchingStateHint\":\"s-matchingstatehint\",\"name\":\"s-name\",\"phoneNumber\":\"s-phonenumber\",\"placeId\":\"s-placeid\",\"storeAddress\":\"s-storeaddress\",\"storeCode\":\"s-storecode\",\"storeName\":\"s-storename\",\"targetAccount\":\"7\",\"websiteUri\":\"s-websiteuri\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"lfpStores\":[{\"gcidCategory\":[\"s-gcidcategory\"],\"matchingState\":\"s-matchingstate\",\"matchingStateHint\":\"s-matchingstatehint\",\"name\":\"s-name\",\"phoneNumber\":\"s-phonenumber\",\"placeId\":\"s-placeid\",\"storeAddress\":\"s-storeaddress\",\"storeCode\":\"s-storecode\",\"storeName\":\"s-storename\",\"targetAccount\":\"7\",\"websiteUri\":\"s-websiteuri\"}]}")
  gv_note(f, "CALL merchantapi.accounts.lfpStores.list pages")
  var p = svc.accounts.lfp_stores.list_pages("id1/ x", options: AccountsLfpStoresListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), target_account: Some(7), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_7)
}
