// Generated from the output of a local Go program that calls every
// method of google.golang.org/api v0.311.0 merchantapi/quota_v1beta with every argument and
// optional parameter set, against a fake transport (no network); do not
// edit (codegen/cmd/govec). Each test makes the same call here and
// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://merchantapi.googleapis.com"

const GO_0: List[Str] = [
  "CALL merchantapi.accounts.quotas.list",
  "REQ GET https://merchantapi.googleapis.com/quota/v1beta/id1/%20x/quotas?alt=json&fields=kind%2Cid&pageSize=7&pageToken=s-pagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"nextPageToken\":\"s-nextpagetoken\",\"quotaGroups\":[{\"name\":\"s-name\",\"quotaLimit\":\"7\",\"quotaMinuteLimit\":\"7\",\"quotaUsage\":\"7\"}]}",
  "OUT: {\"nextPageToken\":\"s-nextpagetoken\",\"quotaGroups\":[{\"name\":\"s-name\",\"quotaLimit\":\"7\",\"quotaMinuteLimit\":\"7\",\"quotaUsage\":\"7\"}]}",
]

test "Go's merchantapi.accounts.quotas.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"quotaGroups\":[{\"name\":\"s-name\",\"quotaLimit\":\"7\",\"quotaMinuteLimit\":\"7\",\"quotaUsage\":\"7\"}]}")
  gv_note(f, "CALL merchantapi.accounts.quotas.list")
  match svc.accounts.quotas.list("id1/ x", options: AccountsQuotasListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}
