  /// Text to be used as the [aria-label](https://www.w3.org/TR/WCAG20-TECHS/ARIA14.html) for the input.
  pub aria_label as "ariaLabel,omitempty": Str = ""
  /// Information about the required format. If present, it should be shown close to the input field to help the business to provide a correct value. For example: "VAT numbers should be in a format similar to SK9999999999"
  pub format_info as "formatInfo,omitempty": Str = ""
  /// Type of the text input
  pub type_ as "type,omitempty": Str = ""
} derive Json

/// TextInputValue: Value for text input field.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct TextInputValue {
  /// Required. Text provided by the business.
  pub value as "value,omitempty": Str = ""
  pub force_send_fields as "~forceSendFields,omitempty": List[TextInputValueField] = []
  pub null_fields as "~nullFields,omitempty": List[TextInputValueField] = []
} derive Json

/// TextInputValueField: TextInputValue's fields, for force_send_fields and null_fields.
pub enum TextInputValueField {
  Value as "value=\"\""
} derive Json

/// TextWithTooltip: Block of text that may contain a tooltip with more information.
pub struct TextWithTooltip {
  /// Value of the tooltip as a simple text.
  pub simple_tooltip_value as "simpleTooltipValue,omitempty": Str = ""
  /// Value of the message as a simple text.
  pub simple_value as "simpleValue,omitempty": Str = ""
  /// The suggested type of an icon for tooltip, if a tooltip is present.
  pub tooltip_icon_style as "tooltipIconStyle,omitempty": Str = ""
} derive Json

/// TriggerActionPayload: The payload for the triggered action.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct TriggerActionPayload {
  /// Required. The context from the selected action. The value is obtained from rendered issues and needs to be sent back to identify the action that is being triggered.
  pub action_context as "actionContext,omitempty": Str = ""
  /// Required. Input provided by the business.
  pub action_input as "actionInput,omitempty": ActionInput? = None
  pub force_send_fields as "~forceSendFields,omitempty": List[TriggerActionPayloadField] = []
  pub null_fields as "~nullFields,omitempty": List[TriggerActionPayloadField] = []
} derive Json

/// TriggerActionPayloadField: TriggerActionPayload's fields, for force_send_fields and null_fields.
pub enum TriggerActionPayloadField {
  ActionContext as "actionContext=\"\""
  ActionInput as "actionInput"
} derive Json

/// TriggerActionResponse: Response informing about the started action.
pub struct TriggerActionResponse {
  /// The message for the business.
  pub message as "message,omitempty": Str = ""
} derive Json
