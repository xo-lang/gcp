test "Go's merchantapi.accounts.promotions.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"promotions\":[{\"attributes\":{\"audience\":\"s-audience\",\"couponValueType\":\"s-couponvaluetype\",\"customRedemptionRestriction\":\"s-customredemptionrestriction\",\"eventApplicability\":\"s-eventapplicability\",\"freeGiftDescription\":\"s-freegiftdescription\",\"freeGiftItemId\":\"s-freegiftitemid\",\"genericRedemptionCode\":\"s-genericredemptioncode\",\"getThisQuantityDiscounted\":\"7\",\"limitQuantity\":\"7\",\"longTitle\":\"s-longtitle\",\"maxPercentOff\":\"7\",\"minPercentOff\":\"7\",\"minimumPurchaseQuantity\":\"7\",\"offerType\":\"s-offertype\",\"percentOff\":\"7\",\"productApplicability\":\"s-productapplicability\",\"promotionUrl\":\"s-promotionurl\",\"redemptionRestriction\":\"s-redemptionrestriction\",\"storeApplicability\":\"s-storeapplicability\"},\"contentLanguage\":\"s-contentlanguage\",\"dataSource\":\"s-datasource\",\"name\":\"s-name\",\"promotionId\":\"s-promotionid\",\"promotionStatus\":{\"creationDate\":\"s-creationdate\",\"lastUpdateDate\":\"s-lastupdatedate\"},\"redemptionChannel\":[\"s-redemptionchannel\"],\"targetCountry\":\"s-targetcountry\",\"versionNumber\":\"7\"}]}")
  gv_note(f, "CALL merchantapi.accounts.promotions.list")
  match svc.accounts.promotions.list("id1/ x", options: AccountsPromotionsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_2)
}
