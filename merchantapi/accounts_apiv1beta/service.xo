/// retrieve_latest: Retrieves the latest version of the `TermsOfService` for a given `kind` and `region_code`.
/// (Go's merchantapi.termsOfService.retrieveLatest.)
pub fn (r: TermsOfServiceService[fx]) retrieve_latest(options: TermsOfServiceRetrieveLatestOptions = TermsOfServiceRetrieveLatestOptions{}) -> TermsOfService ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.kind {
    q.set("kind", v)
  }
  if let Some(v) = options.region_code {
    q.set("regionCode", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "accounts/v1beta/termsOfService:retrieveLatest"), {})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[TermsOfService](resp)
}

/// A service sending through `net`, with `opts`.
pub fn new_service[fx: Effects](net: Net, opts: option.ClientOptions[fx] = option.ClientOptions{}) -> APIService[fx] {
  new_api_service_from(gensupport.new_core(net, opts, BASE_PATH))
}
