  gv_queue(f, "{\"omnichannelSettings\":[{\"about\":{\"state\":\"s-state\",\"uri\":\"s-uri\"},\"inStock\":{\"state\":\"s-state\",\"uri\":\"s-uri\"},\"inventoryVerification\":{\"contact\":\"s-contact\",\"contactEmail\":\"s-contactemail\",\"contactState\":\"s-contactstate\",\"state\":\"s-state\"},\"lfpLink\":{\"externalAccountId\":\"s-externalaccountid\",\"lfpProvider\":\"s-lfpprovider\",\"state\":\"s-state\"},\"lsfType\":\"s-lsftype\",\"name\":\"s-name\",\"odo\":{\"state\":\"s-state\",\"uri\":\"s-uri\"},\"pickup\":{\"state\":\"s-state\",\"uri\":\"s-uri\"},\"regionCode\":\"s-regioncode\"}]}")
