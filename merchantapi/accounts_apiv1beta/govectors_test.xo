  gv_queue(f, "{\"programs\":[{\"activeRegionCodes\":[\"s-activeregioncodes\"],\"documentationUri\":\"s-documentationuri\",\"name\":\"s-name\",\"state\":\"s-state\"}]}")
  gv_note(f, "CALL merchantapi.accounts.programs.list pages")
  var p = svc.accounts.programs.list_pages("id1/ x", options: AccountsProgramsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
