test "Go's merchantapi.accounts.regions.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"regions\":[{\"displayName\":\"s-displayname\",\"geotargetArea\":{},\"name\":\"s-name\",\"postalCodeArea\":{\"regionCode\":\"s-regioncode\"},\"radiusArea\":{\"radius\":1.5,\"radiusUnits\":\"s-radiusunits\",\"regionCode\":\"s-regioncode\"},\"regionalInventoryEligible\":true,\"shippingEligible\":true}]}")
  gv_queue(f, "{\"regions\":[{\"displayName\":\"s-displayname\",\"geotargetArea\":{},\"name\":\"s-name\",\"postalCodeArea\":{\"regionCode\":\"s-regioncode\"},\"radiusArea\":{\"radius\":1.5,\"radiusUnits\":\"s-radiusunits\",\"regionCode\":\"s-regioncode\"},\"regionalInventoryEligible\":true,\"shippingEligible\":true}]}")
  gv_note(f, "CALL merchantapi.accounts.regions.list pages")
  var p = svc.accounts.regions.list_pages("id1/ x", options: AccountsRegionsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_60)
}

