    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_84)
}

const GO_85: List[Str] = [
  "CALL merchantapi.termsOfService.retrieveLatest",
  "REQ GET https://merchantapi.googleapis.com/accounts/v1beta/termsOfService:retrieveLatest?alt=json&fields=kind%2Cid&kind=s-kind&prettyPrint=false&regionCode=s-regioncode",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"external\":true,\"fileUri\":\"s-fileuri\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"regionCode\":\"s-regioncode\"}",
  "OUT: {\"external\":true,\"fileUri\":\"s-fileuri\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"regionCode\":\"s-regioncode\"}",
]

test "Go's merchantapi.termsOfService.retrieveLatest" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"external\":true,\"fileUri\":\"s-fileuri\",\"kind\":\"s-kind\",\"name\":\"s-name\",\"regionCode\":\"s-regioncode\"}")
  gv_note(f, "CALL merchantapi.termsOfService.retrieveLatest")
  match svc.terms_of_service.retrieve_latest(options: TermsOfServiceRetrieveLatestOptions{kind: Some("s-kind"), region_code: Some("s-regioncode"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_85)
}
