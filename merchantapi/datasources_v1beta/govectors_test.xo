    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_5)
}

const GO_6: List[Str] = [
  "CALL merchantapi.accounts.dataSources.fileUploads.get",
  "REQ GET https://merchantapi.googleapis.com/datasources/v1beta/id1/%20x?alt=json&fields=kind%2Cid&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"dataSourceId\":\"7\",\"issues\":[{\"code\":\"s-code\",\"count\":\"7\",\"description\":\"s-description\",\"documentationUri\":\"s-documentationuri\",\"severity\":\"s-severity\",\"title\":\"s-title\"}],\"itemsCreated\":\"7\",\"itemsTotal\":\"7\",\"itemsUpdated\":\"7\",\"name\":\"s-name\",\"processingState\":\"s-processingstate\",\"uploadTime\":\"s-uploadtime\"}",
  "OUT: {\"dataSourceId\":\"7\",\"issues\":[{\"code\":\"s-code\",\"count\":\"7\",\"description\":\"s-description\",\"documentationUri\":\"s-documentationuri\",\"severity\":\"s-severity\",\"title\":\"s-title\"}],\"itemsCreated\":\"7\",\"itemsTotal\":\"7\",\"itemsUpdated\":\"7\",\"name\":\"s-name\",\"processingState\":\"s-processingstate\",\"uploadTime\":\"s-uploadtime\"}",
]

test "Go's merchantapi.accounts.dataSources.fileUploads.get" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"dataSourceId\":\"7\",\"issues\":[{\"code\":\"s-code\",\"count\":\"7\",\"description\":\"s-description\",\"documentationUri\":\"s-documentationuri\",\"severity\":\"s-severity\",\"title\":\"s-title\"}],\"itemsCreated\":\"7\",\"itemsTotal\":\"7\",\"itemsUpdated\":\"7\",\"name\":\"s-name\",\"processingState\":\"s-processingstate\",\"uploadTime\":\"s-uploadtime\"}")
  gv_note(f, "CALL merchantapi.accounts.dataSources.fileUploads.get")
  match svc.accounts.data_sources.file_uploads.get("id1/ x", options: AccountsDataSourcesFileUploadsGetOptions{fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_6)
}
