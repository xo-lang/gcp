test "Go's merchantapi.accounts.products.list" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"products\":[{\"archived\":true,\"automatedDiscounts\":{},\"base64EncodedName\":\"s-base64encodedname\",\"contentLanguage\":\"s-contentlanguage\",\"dataSource\":\"s-datasource\",\"feedLabel\":\"s-feedlabel\",\"legacyLocal\":true,\"name\":\"s-name\",\"offerId\":\"s-offerid\",\"productAttributes\":{\"adsGrouping\":\"s-adsgrouping\",\"adsRedirect\":\"s-adsredirect\",\"adult\":true,\"ageGroup\":\"s-agegroup\",\"availability\":\"s-availability\",\"availabilityDate\":\"s-availabilitydate\",\"bodyStyle\":\"s-bodystyle\",\"brand\":\"s-brand\",\"canonicalLink\":\"s-canonicallink\",\"certifiedPreOwned\":true,\"color\":\"s-color\",\"condition\":\"s-condition\",\"customLabel0\":\"s-customlabel0\",\"customLabel1\":\"s-customlabel1\",\"customLabel2\":\"s-customlabel2\",\"customLabel3\":\"s-customlabel3\",\"customLabel4\":\"s-customlabel4\",\"dateFirstRegistered\":\"s-datefirstregistered\",\"description\":\"s-description\",\"disclosureDate\":\"s-disclosuredate\",\"displayAdsId\":\"s-displayadsid\",\"displayAdsLink\":\"s-displayadslink\",\"displayAdsTitle\":\"s-displayadstitle\",\"displayAdsValue\":1.5,\"emissionsStandard\":\"s-emissionsstandard\",\"energyEfficiencyClass\":\"s-energyefficiencyclass\",\"engine\":\"s-engine\",\"expirationDate\":\"s-expirationdate\",\"externalSellerId\":\"s-externalsellerid\",\"gender\":\"s-gender\",\"googleProductCategory\":\"s-googleproductcategory\",\"identifierExists\":true,\"imageLink\":\"s-imagelink\",\"isBundle\":true,\"itemGroupId\":\"s-itemgroupid\",\"itemGroupTitle\":\"s-itemgrouptitle\",\"latitude\":1.5,\"link\":\"s-link\",\"linkTemplate\":\"s-linktemplate\",\"longitude\":1.5,\"material\":\"s-material\",\"maxEnergyEfficiencyClass\":\"s-maxenergyefficiencyclass\",\"maxHandlingTime\":\"7\",\"minEnergyEfficiencyClass\":\"s-minenergyefficiencyclass\",\"minHandlingTime\":\"7\",\"mobileLink\":\"s-mobilelink\",\"mobileLinkTemplate\":\"s-mobilelinktemplate\",\"model\":\"s-model\",\"mpn\":\"s-mpn\",\"multipack\":\"7\",\"neighborhood\":\"s-neighborhood\",\"numberOfBathrooms\":1.5,\"numberOfBedrooms\":1.5,\"numberOfUnits\":\"7\",\"pattern\":\"s-pattern\",\"pause\":\"s-pause\",\"pickupMethod\":\"s-pickupmethod\",\"pickupSla\":\"s-pickupsla\",\"popularityRank\":1.5,\"propertyName\":\"s-propertyname\",\"propertyType\":\"s-propertytype\",\"returnPolicyLabel\":\"s-returnpolicylabel\",\"sellOnGoogleQuantity\":\"7\",\"shippingLabel\":\"s-shippinglabel\",\"shortTitle\":\"s-shorttitle\",\"size\":\"s-size\",\"sizeSystem\":\"s-sizesystem\",\"specialtyHousingType\":\"s-specialtyhousingtype\",\"title\":\"s-title\",\"transitTimeLabel\":\"s-transittimelabel\",\"trim\":\"s-trim\",\"vehicleMandatoryInspectionIncluded\":true,\"vehiclePriceType\":\"s-vehiclepricetype\",\"vin\":\"s-vin\",\"virtualModelLink\":\"s-virtualmodellink\",\"year\":\"7\"},\"productStatus\":{\"creationDate\":\"s-creationdate\",\"googleExpirationDate\":\"s-googleexpirationdate\",\"lastUpdateDate\":\"s-lastupdatedate\"},\"versionNumber\":\"7\"}]}")
  gv_note(f, "CALL merchantapi.accounts.products.list")
  match svc.accounts.products.list("id1/ x", options: AccountsProductsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_4)
}
