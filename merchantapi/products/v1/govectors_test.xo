// compares the request, the response served and the result.

use std/json

const GV_HOST: Str = "https://merchantapi.googleapis.com"

const GO_0: List[Str] = [
  "CALL merchantapi.accounts.productInputs.delete",
  "REQ DELETE https://merchantapi.googleapis.com/products/v1/id1/%20x?alt=json&dataSource=s-datasource&fields=kind%2Cid&prettyPrint=false",
  "  H x-extra=v1",
  "  B ",
  "  SERVED 200 {}",
  "OUT: {}",
]

test "Go's merchantapi.accounts.productInputs.delete" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{}")
  gv_note(f, "CALL merchantapi.accounts.productInputs.delete")
  match svc.accounts.product_inputs.delete("id1/ x", options: AccountsProductInputsDeleteOptions{data_source: Some("s-datasource"), fields: ["kind", "id"], headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_0)
}

