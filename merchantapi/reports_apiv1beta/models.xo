/// SearchRequest: Request message for the `ReportService.Search` method.
///
/// In a request body, force_send_fields are sent even when empty and null_fields as null (decision 0013).
pub struct SearchRequest {
  /// Optional. Number of `ReportRows` to retrieve in a single page. Defaults to 1000. Values above 100,000 are coerced to 100,000.
  pub page_size as "pageSize,omitempty": Int = 0
  /// Optional. Token of the page to retrieve. If not specified, the first page of results is returned. In order to request the next page of results, the value obtained from `next_page_token` in the previous response should be used.
  pub page_token as "pageToken,omitempty": Str = ""
  /// Required. Query that defines a report to be retrieved. For details on how to construct your query, see the [Query Language guide](/merchant/api/guides/reports/query-language). For the full list of available tables and fields, see the Available fields.
  pub query as "query,omitempty": Str = ""
  pub force_send_fields as "~forceSendFields,omitempty": List[SearchRequestField] = []
  pub null_fields as "~nullFields,omitempty": List[SearchRequestField] = []
} derive Json

/// SearchRequestField: SearchRequest's fields, for force_send_fields and null_fields.
pub enum SearchRequestField {
  PageSize as "pageSize=0"
  PageToken as "pageToken=\"\""
  Query as "query=\"\""
} derive Json

/// SearchResponse: Response message for the `ReportService.Search` method.
pub struct SearchResponse {
  /// Token which can be sent as `page_token` to retrieve the next page. If omitted, there are no subsequent pages.
  pub next_page_token as "nextPageToken,omitempty": Str = ""
  /// Rows that matched the search query.
  pub results as "results,omitempty": List[ReportRow] = []
} derive Json

/// StatusPerReportingContext: Status of the product for a specific reporting context. Equivalent to `DestinationStatus` in Products API.
pub struct StatusPerReportingContext {
  /// List of approved countries in the reporting context, represented in [ISO 3166](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2) format, for example, `US`.
  pub approved_countries as "approvedCountries,omitempty": List[Str] = []
  /// List of disapproved countries in the reporting context, represented in [ISO 3166](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2) format, for example, `US`.
  pub disapproved_countries as "disapprovedCountries,omitempty": List[Str] = []
  /// List of pending countries in the reporting context, represented in [ISO 3166](https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2) format, for example, `US`.
  pub pending_countries as "pendingCountries,omitempty": List[Str] = []
  /// Reporting context the status applies to.
  pub reporting_context as "reportingContext,omitempty": Str = ""
} derive Json
