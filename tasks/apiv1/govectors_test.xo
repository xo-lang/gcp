test "Go's tasks.tasks.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"etag\":\"s-etag\",\"items\":[{\"assignmentInfo\":{\"linkToTask\":\"s-linktotask\",\"surfaceType\":\"s-surfacetype\"},\"completed\":\"s-completed\",\"deleted\":true,\"due\":\"s-due\",\"etag\":\"s-etag\",\"hidden\":true,\"id\":\"s-id\",\"kind\":\"s-kind\",\"links\":[{\"description\":\"s-description\",\"link\":\"s-link\",\"type\":\"s-type\"}],\"notes\":\"s-notes\",\"parent\":\"s-parent\",\"position\":\"s-position\",\"selfLink\":\"s-selflink\",\"status\":\"s-status\",\"title\":\"s-title\",\"updated\":\"s-updated\",\"webViewLink\":\"s-webviewlink\"}],\"kind\":\"s-kind\",\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"etag\":\"s-etag\",\"items\":[{\"assignmentInfo\":{\"linkToTask\":\"s-linktotask\",\"surfaceType\":\"s-surfacetype\"},\"completed\":\"s-completed\",\"deleted\":true,\"due\":\"s-due\",\"etag\":\"s-etag\",\"hidden\":true,\"id\":\"s-id\",\"kind\":\"s-kind\",\"links\":[{\"description\":\"s-description\",\"link\":\"s-link\",\"type\":\"s-type\"}],\"notes\":\"s-notes\",\"parent\":\"s-parent\",\"position\":\"s-position\",\"selfLink\":\"s-selflink\",\"status\":\"s-status\",\"title\":\"s-title\",\"updated\":\"s-updated\",\"webViewLink\":\"s-webviewlink\"}],\"kind\":\"s-kind\"}")
  gv_note(f, "CALL tasks.tasks.list pages")
  var p = svc.tasks.list_pages("id1/ x", options: TasksListOptions{completed_max: Some("s-completedmax"), completed_min: Some("s-completedmin"), due_max: Some("s-duemax"), due_min: Some("s-duemin"), max_results: Some(7), page_token: Some("s-pagetoken"), show_assigned: Some(true), show_completed: Some(true), show_deleted: Some(true), show_hidden: Some(true), updated_min: Some("s-updatedmin"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_12)
}

