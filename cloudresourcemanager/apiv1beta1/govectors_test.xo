test "Go's cloudresourcemanager.projects.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"projects\":[{\"configuredCapabilities\":[\"s-configuredcapabilities\"],\"createTime\":\"s-createtime\",\"isManagementProject\":true,\"labels\":{\"k1\":\"s-labels\"},\"lifecycleState\":\"s-lifecyclestate\",\"managementType\":\"s-managementtype\",\"name\":\"s-name\",\"parent\":{\"id\":\"s-id\",\"type\":\"s-type\"},\"projectId\":\"s-projectid\",\"projectNumber\":\"7\"}]}")
  gv_queue(f, "{\"projects\":[{\"configuredCapabilities\":[\"s-configuredcapabilities\"],\"createTime\":\"s-createtime\",\"isManagementProject\":true,\"labels\":{\"k1\":\"s-labels\"},\"lifecycleState\":\"s-lifecyclestate\",\"managementType\":\"s-managementtype\",\"name\":\"s-name\",\"parent\":{\"id\":\"s-id\",\"type\":\"s-type\"},\"projectId\":\"s-projectid\",\"projectNumber\":\"7\"}]}")
  gv_note(f, "CALL cloudresourcemanager.projects.list pages")
  var p = svc.projects.list_pages(options: ProjectsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_13)
}

