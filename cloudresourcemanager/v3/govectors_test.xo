  gv_queue(f, "{\"capabilityConfigs\":[{\"boundaries\":[\"s-boundaries\"],\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"etag\":\"s-etag\",\"managementProject\":\"s-managementproject\",\"name\":\"s-name\",\"state\":\"s-state\",\"types\":[\"s-types\"],\"updateTime\":\"s-updatetime\"}]}")
