test "Go's cloudresourcemanager.folders.search pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"folders\":[{\"configuredCapabilities\":[\"s-configuredcapabilities\"],\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"displayName\":\"s-displayname\",\"etag\":\"s-etag\",\"managementProject\":\"s-managementproject\",\"name\":\"s-name\",\"parent\":\"s-parent\",\"state\":\"s-state\",\"tags\":{\"k1\":\"s-tags\"},\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"folders\":[{\"configuredCapabilities\":[\"s-configuredcapabilities\"],\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"displayName\":\"s-displayname\",\"etag\":\"s-etag\",\"managementProject\":\"s-managementproject\",\"name\":\"s-name\",\"parent\":\"s-parent\",\"state\":\"s-state\",\"tags\":{\"k1\":\"s-tags\"},\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL cloudresourcemanager.folders.search pages")
  var p = svc.folders.search_pages(options: FoldersSearchOptions{page_size: Some(7), page_token: Some("s-pagetoken"), query: Some("s-query"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_12)
}

