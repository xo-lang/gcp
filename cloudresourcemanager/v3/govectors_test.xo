test "Go's cloudresourcemanager.tagValues.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"tagValues\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"namespacedName\":\"s-namespacedname\",\"parent\":\"s-parent\",\"shortName\":\"s-shortname\",\"updateTime\":\"s-updatetime\"}]}")
  gv_queue(f, "{\"tagValues\":[{\"createTime\":\"s-createtime\",\"description\":\"s-description\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"namespacedName\":\"s-namespacedname\",\"parent\":\"s-parent\",\"shortName\":\"s-shortname\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL cloudresourcemanager.tagValues.list pages")
  var p = svc.tag_values.list_pages(options: TagValuesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), parent: Some("s-parent"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_99)
}

