test "Go's cloudresourcemanager.liens.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"liens\":[{\"createTime\":\"s-createtime\",\"name\":\"s-name\",\"origin\":\"s-origin\",\"parent\":\"s-parent\",\"reason\":\"s-reason\",\"restrictions\":[\"s-restrictions\"]}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"liens\":[{\"createTime\":\"s-createtime\",\"name\":\"s-name\",\"origin\":\"s-origin\",\"parent\":\"s-parent\",\"reason\":\"s-reason\",\"restrictions\":[\"s-restrictions\"]}]}")
  gv_note(f, "CALL cloudresourcemanager.liens.list pages")
  var p = svc.liens.list_pages(options: LiensListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), parent: Some("s-parent"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_35)
}

