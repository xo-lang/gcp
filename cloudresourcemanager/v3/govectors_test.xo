  "REQ GET https://cloudresourcemanager.googleapis.com/v3/id1/%20x/tagHolds?alt=json&fields=kind%2Cid&filter=s-filter&pageSize=7&pageToken=s-nextpagetoken&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"tagHolds\":[{\"createTime\":\"s-createtime\",\"helpLink\":\"s-helplink\",\"holder\":\"s-holder\",\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "OUT: {\"tagHolds\":[{\"createTime\":\"s-createtime\",\"helpLink\":\"s-helplink\",\"holder\":\"s-holder\",\"name\":\"s-name\",\"origin\":\"s-origin\"}]}",
  "OUT: ok",
]

test "Go's cloudresourcemanager.tagValues.tagHolds.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"tagHolds\":[{\"createTime\":\"s-createtime\",\"helpLink\":\"s-helplink\",\"holder\":\"s-holder\",\"name\":\"s-name\",\"origin\":\"s-origin\"}]}")
  gv_queue(f, "{\"tagHolds\":[{\"createTime\":\"s-createtime\",\"helpLink\":\"s-helplink\",\"holder\":\"s-holder\",\"name\":\"s-name\",\"origin\":\"s-origin\"}]}")
  gv_note(f, "CALL cloudresourcemanager.tagValues.tagHolds.list pages")
  var p = svc.tag_values.tag_holds.list_pages("id1/ x", options: TagValuesTagHoldsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_106)
}

const GO_107: List[Str] = [
  "CALL cloudresourcemanager.fetchResourceSemantics",
  "REQ GET https://cloudresourcemanager.googleapis.com/v3:fetchResourceSemantics?alt=json&fields=kind%2Cid&fullResourceName=s-fullresourcename&prettyPrint=false",
  "  H if-none-match=etag-1 | x-extra=v1",
  "  B ",
  "  SERVED 200 {\"fullResourceName\":\"s-fullresourcename\",\"semantics\":{\"k1\":\"s-semantics\"}}",
  "OUT: {\"fullResourceName\":\"s-fullresourcename\",\"semantics\":{\"k1\":\"s-semantics\"}}",
]

test "Go's cloudresourcemanager.fetchResourceSemantics" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"fullResourceName\":\"s-fullresourcename\",\"semantics\":{\"k1\":\"s-semantics\"}}")
  gv_note(f, "CALL cloudresourcemanager.fetchResourceSemantics")
  match svc.v3.fetch_resource_semantics(options: V3FetchResourceSemanticsOptions{full_resource_name: Some("s-fullresourcename"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
    Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
    Err(e) => gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
  }
  gv_compare(gv_log_of(f), GO_107)
}
