pub struct WorkloadIdentityIdentityProviderStateDetail {
  /// The state of the Identity Provider.
  pub code as "code,omitempty": Str = ""
  /// A human-readable description of the current state or returned error.
  pub description as "description,omitempty": Str = ""
} derive Json

/// WorkloadIdentityState: **WorkloadIdentity**: The membership-specific state for WorkloadIdentity feature.
pub struct WorkloadIdentityState {
  /// Deprecated, this field will be erased after code is changed to use the new field.
  pub description as "description,omitempty": Str = ""
  /// The state of the Identity Providers corresponding to the membership.
  pub identity_provider_state_details as "identityProviderStateDetails,omitempty": Map[Str, WorkloadIdentityIdentityProviderStateDetail] = {}
} derive Json
