  pub rbacrolebinding_states as "rbacrolebindingStates,omitempty": Map[Str, RBACRoleBindingActuationRBACRoleBindingState] = {}
} derive Json

/// ServiceMeshAnalysisMessage: AnalysisMessage is a single message produced by an analyzer, and it used to communicate to the end user about the state of their Service Mesh configuration.
pub struct ServiceMeshAnalysisMessage {
  /// A UI can combine these args with a template (based on message_base.type) to produce an internationalized message.
  pub args as "args,omitempty": json.Value? = None
  /// A human readable description of what the error means. It is suitable for non-internationalize display purposes.
  pub description as "description,omitempty": Str = ""
  /// Details common to all types of Istio and ServiceMesh analysis messages.
  pub message_base as "messageBase,omitempty": ServiceMeshAnalysisMessageBase? = None
  /// A list of strings specifying the resource identifiers that were the cause of message generation. A "path" here may be: * MEMBERSHIP_ID if the cause is a specific member cluster * MEMBERSHIP_ID/(NAMESPACE\/)?RESOURCETYPE/NAME if the cause is a resource in a cluster
  pub resource_paths as "resourcePaths,omitempty": List[Str] = []
} derive Json

/// ServiceMeshAnalysisMessageBase: AnalysisMessageBase describes some common information that is needed for all messages.
pub struct ServiceMeshAnalysisMessageBase {
  /// A url pointing to the Service Mesh or Istio documentation for this specific error type.
  pub documentation_url as "documentationUrl,omitempty": Str = ""
  /// Represents how severe a message is.
  pub level as "level,omitempty": Str = ""
  /// Represents the specific type of a message.
  pub type_ as "type,omitempty": ServiceMeshType? = None
} derive Json

/// ServiceMeshCondition: Condition being reported.
pub struct ServiceMeshCondition {
  /// Unique identifier of the condition which describes the condition recognizable to the user.
  pub code as "code,omitempty": Str = ""
  /// A short summary about the issue.
  pub details as "details,omitempty": Str = ""
  /// Links contains actionable information.
  pub documentation_link as "documentationLink,omitempty": Str = ""
  /// Severity level of the condition.
  pub severity as "severity,omitempty": Str = ""
} derive Json

/// ServiceMeshControlPlaneManagement: Status of control plane management.
pub struct ServiceMeshControlPlaneManagement {
  /// Explanation of state.
  pub details as "details,omitempty": List[ServiceMeshStatusDetails] = []
  /// Output only. Implementation of managed control plane.
  pub implementation as "implementation,omitempty": Str = ""
  /// LifecycleState of control plane management.
  pub state as "state,omitempty": Str = ""
} derive Json

/// ServiceMeshDataPlaneManagement: Status of data plane management. Only reported per-member.
pub struct ServiceMeshDataPlaneManagement {
  /// Explanation of the status.
  pub details as "details,omitempty": List[ServiceMeshStatusDetails] = []
  /// Lifecycle status of data plane management.
  pub state as "state,omitempty": Str = ""
} derive Json

/// ServiceMeshSpec: **Service Mesh**: Spec for a single Membership for the servicemesh feature
pub struct ServiceMeshSpec {
  /// Optional. Specifies the API that will be used for configuring the mesh workloads.
  pub config_api as "configApi,omitempty": Str = ""
  /// Deprecated: use `management` instead Enables automatic control plane management.
  pub control_plane as "controlPlane,omitempty": Str = ""
  /// Determines which release channel to use for default injection and service mesh APIs.
  pub default_channel as "defaultChannel,omitempty": Str = ""
  /// Optional. Enables automatic Service Mesh management.
  pub management as "management,omitempty": Str = ""
} derive Json

/// ServiceMeshState: **Service Mesh**: State for a single Membership, as analyzed by the Service Mesh Hub Controller.
pub struct ServiceMeshState {
  /// Output only. Results of running Service Mesh analyzers.
  pub analysis_messages as "analysisMessages,omitempty": List[ServiceMeshAnalysisMessage] = []
  /// Output only. List of conditions reported for this membership.
  pub conditions as "conditions,omitempty": List[ServiceMeshCondition] = []
  /// The API version (i.e. Istio CRD version) for configuring service mesh in this cluster. This version is influenced by the `default_channel` field.
  pub config_api_version as "configApiVersion,omitempty": Str = ""
  /// Output only. Status of control plane management
  pub control_plane_management as "controlPlaneManagement,omitempty": ServiceMeshControlPlaneManagement? = None
  /// Output only. Status of data plane management.
  pub data_plane_management as "dataPlaneManagement,omitempty": ServiceMeshDataPlaneManagement? = None
} derive Json

/// ServiceMeshStatusDetails: Structured and human-readable details for a status.
pub struct ServiceMeshStatusDetails {
  /// A machine-readable code that further describes a broad status.
  pub code as "code,omitempty": Str = ""
  /// Human-readable explanation of code.
  pub details as "details,omitempty": Str = ""
} derive Json

/// ServiceMeshType: A unique identifier for the type of message. Display_name is intended to be human-readable, code is intended to be machine readable. There should be a one-to-one mapping between display_name and code. (i.e. do not re-use display_names or codes between message types.) See istio.analysis.v1alpha1.AnalysisMessageBase.Type
pub struct ServiceMeshType {
  /// A 7 character code matching `^IST[0-9]{4}$` or `^ASM[0-9]{4}$`, intended to uniquely identify the message type. (e.g. "IST0001" is mapped to the "InternalError" message type.)
  pub code as "code,omitempty": Str = ""
  /// A human-readable name for the message type. e.g. "InternalError", "PodMissingProxy". This should be the same for all messages of the same type. (This corresponds to the `name` field in open-source Istio.)
  pub display_name as "displayName,omitempty": Str = ""
} derive Json

/// State: High-level state of a MembershipFeature.
pub struct State {
  /// The high-level, machine-readable status of this MembershipFeature.
  pub code as "code,omitempty": Str = ""
  /// A human-readable description of the current status.
  pub description as "description,omitempty": Str = ""
  /// The time this status and any related Feature-specific details were updated.
  pub update_time as "updateTime,omitempty": Str = ""
} derive Json

/// WorkloadCertificateSpec: **WorkloadCertificate**: The membership-specific input for WorkloadCertificate feature.
pub struct WorkloadCertificateSpec {
  /// CertificateManagement specifies workload certificate management.
  pub certificate_management as "certificateManagement,omitempty": Str = ""
} derive Json

