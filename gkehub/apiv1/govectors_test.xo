test "Go's gkehub.projects.locations.fleets.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"fleets\":[{\"createTime\":\"s-createtime\",\"defaultClusterConfig\":{},\"deleteTime\":\"s-deletetime\",\"displayName\":\"s-displayname\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"state\":{\"code\":\"s-code\"},\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\"}")
  gv_queue(f, "{\"fleets\":[{\"createTime\":\"s-createtime\",\"defaultClusterConfig\":{},\"deleteTime\":\"s-deletetime\",\"displayName\":\"s-displayname\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"state\":{\"code\":\"s-code\"},\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}]}")
  gv_note(f, "CALL gkehub.projects.locations.fleets.list pages")
  var p = svc.projects.locations.fleets.list_pages("id1/ x", options: ProjectsLocationsFleetsListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_18)
}

