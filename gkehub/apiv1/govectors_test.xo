  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"membershipBindings\":[{\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"scope\":\"s-scope\",\"state\":{\"code\":\"s-code\"},\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\",\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"membershipBindings\":[{\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"scope\":\"s-scope\",\"state\":{\"code\":\"s-code\"},\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL gkehub.projects.locations.memberships.bindings.list pages")
  var p = svc.projects.locations.memberships.bindings.list_pages("id1/ x", options: ProjectsLocationsMembershipsBindingsListOptions{filter: Some("s-filter"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
