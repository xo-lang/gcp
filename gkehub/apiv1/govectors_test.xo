  gv_queue(f, "{\"rolloutSequences\":[{\"autoUpgradeConfig\":{},\"computedReleaseChannel\":\"s-computedreleasechannel\",\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"displayName\":\"s-displayname\",\"effectiveAutoUpgradeConfig\":{},\"etag\":\"s-etag\",\"ignoredClustersSelector\":{\"labelSelector\":\"s-labelselector\"},\"labels\":{\"k1\":\"s-labels\"},\"lastQualifiedControlPlaneVersion\":\"s-lastqualifiedcontrolplaneversion\",\"lastQualifiedNodeVersion\":\"s-lastqualifiednodeversion\",\"name\":\"s-name\",\"operationalState\":{\"state\":\"s-state\",\"stateChangeTime\":\"s-statechangetime\"},\"targetControlPlaneVersion\":\"s-targetcontrolplaneversion\",\"targetNodeVersion\":\"s-targetnodeversion\",\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}]}")
