  gv_queue(f, "{\"rollouts\":[{\"completeTime\":\"s-completetime\",\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"displayName\":\"s-displayname\",\"etag\":\"s-etag\",\"ignoreClusterDisruptionBudgets\":true,\"ignoreMaintenancePolicies\":true,\"intent\":\"s-intent\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"prioritized\":true,\"rolloutSequence\":\"s-rolloutsequence\",\"stageSoakDurationOverrides\":{\"k1\":\"s-stagesoakdurationoverrides\"},\"state\":\"s-state\",\"stateReason\":\"s-statereason\",\"stateReasonType\":\"s-statereasontype\",\"trigger\":\"s-trigger\",\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\",\"versionUpgrade\":{\"desiredVersion\":\"s-desiredversion\",\"type\":\"s-type\"}}]}")
