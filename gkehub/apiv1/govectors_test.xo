  gv_queue(f, "{\"resources\":[{\"createTime\":\"s-createtime\",\"deleteTime\":\"s-deletetime\",\"fleetDefaultMemberConfig\":{},\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"resourceState\":{\"state\":\"s-state\"},\"spec\":{},\"state\":{},\"unreachable\":[\"s-unreachable\"],\"updateTime\":\"s-updatetime\"}]}")
