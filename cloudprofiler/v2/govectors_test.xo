test "Go's cloudprofiler.projects.profiles.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"profiles\":[{\"deployment\":{\"projectId\":\"s-projectid\",\"target\":\"s-target\"},\"duration\":\"s-duration\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"profileBytes\":\"YWI=\",\"profileType\":\"s-profiletype\",\"startTime\":\"s-starttime\"}],\"skippedProfiles\":7}")
  gv_queue(f, "{\"profiles\":[{\"deployment\":{\"projectId\":\"s-projectid\",\"target\":\"s-target\"},\"duration\":\"s-duration\",\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"profileBytes\":\"YWI=\",\"profileType\":\"s-profiletype\",\"startTime\":\"s-starttime\"}],\"skippedProfiles\":7}")
  gv_note(f, "CALL cloudprofiler.projects.profiles.list pages")
  var p = svc.projects.profiles.list_pages("id1/ x", options: ProjectsProfilesListOptions{page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_3)
}

