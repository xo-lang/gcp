// Events.patch bodies with force_send_fields and null_fields (decision
// 0013), each against the body google.golang.org/api v0.311.0's
// calendar/v3 Events.Patch sends for the same ForceSendFields and
// NullFields (a local Go program with a recording transport; no network).

use std/json
use std/testing

fn patch_body(net: testing.FakeNet, ev: Event) -> Str {
  let f = gv_new_fake(net, GV_HOST)
  let svc = new_service(net, gv_opts())
  gv_set(f, "{}")
  match svc.events.patch("primary", "ev1", ev) {
    Ok(_) => {}
    Err(e) => gv_note(f, "error: ${e.display()}")
  }
  let bodies = gv_log_of(f).filter(fn(l: Str) -> Bool { l.starts_with("  B ") })
  if bodies.len() == 0 { "" } else { bodies[0].trim_prefix("  B ") }
}

test "remove every guest: attendees []" {
  expect(patch_body(os.net, Event{force_send_fields: [EventField.Attendees]})) == "{\"attendees\":[]}"
}

test "remove a Meet link: conferenceData null" {
  expect(patch_body(os.net, Event{null_fields: [EventField.ConferenceData]})) == "{\"conferenceData\":null}"
}

test "reminders.useDefault false" {
  expect(patch_body(os.net, Event{reminders: Some(EventReminders{force_send_fields: [EventRemindersField.UseDefault]})})) == "{\"reminders\":{\"useDefault\":false}}"
}

test "an override with minutes 0, in a list" {
  let ev = Event{summary: "standup", reminders: Some(EventReminders{force_send_fields: [EventRemindersField.UseDefault], overrides: [EventReminder{method: "popup", minutes: 0, force_send_fields: [EventReminderField.Minutes]}, EventReminder{method: "email", minutes: 10}]})}
  expect(patch_body(os.net, ev)) == "{\"reminders\":{\"overrides\":[{\"method\":\"popup\",\"minutes\":0},{\"method\":\"email\",\"minutes\":10}],\"useDefault\":false},\"summary\":\"standup\"}"
}

test "a decoded event, encoded again, has no force or null keys" {
  let ev = json.decode_str[Event]("{\"summary\":\"s\",\"attendees\":[],\"reminders\":{\"useDefault\":false,\"overrides\":[{\"minutes\":0}]}}")?
  expect(json.encode_str(ev).contains("~")) == false
  expect(json.encode_str(Event{summary: "s"}).contains("~")) == false
}
