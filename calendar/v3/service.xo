    q.set("syncToken", v)
  }
  if let Some(v) = options.time_max {
    q.set("timeMax", v)
  }
  if let Some(v) = options.time_min {
    q.set("timeMin", v)
  }
  if let Some(v) = options.time_zone {
    q.set("timeZone", v)
  }
  if let Some(v) = options.updated_min {
