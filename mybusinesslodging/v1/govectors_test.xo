  gv_note(f, "CALL mybusinesslodging.locations.lodging.getGoogleUpdated")
  match svc.locations.lodging.get_google_updated("id1/ x", options: LocationsLodgingGetGoogleUpdatedOptions{read_mask: Some("s-readmask"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]}) {
