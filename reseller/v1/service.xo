pub fn (r: SubscriptionsService[fx]) insert(customer_id: Str, subscription: Subscription, options: SubscriptionsInsertOptions = SubscriptionsInsertOptions{}) -> Subscription ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.action {
    q.set("action", v)
  }
  if let Some(v) = options.customer_auth_token {
    q.set("customerAuthToken", v)
  }
  if let Some(v) = options.source_sku_id {
    q.set("sourceSkuId", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  hs.push(("Content-Type", "application/json"))
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "apps/reseller/v1/customers/{customerId}/subscriptions"), {"customerId": customer_id})
  let resp = r.core.client.send(gensupport.Request{method: "POST", url: u, query: q, headers: hs, body: gensupport.json_body(subscription, data_wrapper: false)})?
  gensupport.check(resp)?
  gensupport.decode[Subscription](resp)
}

