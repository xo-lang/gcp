pub fn (r: SubscriptionsService[fx]) list(options: SubscriptionsListOptions = SubscriptionsListOptions{}) -> Subscriptions ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  var q = url.values()
  if let Some(v) = options.customer_auth_token {
    q.set("customerAuthToken", v)
  }
  if let Some(v) = options.customer_id {
    q.set("customerId", v)
  }
  if let Some(v) = options.customer_name_prefix {
    q.set("customerNamePrefix", v)
  }
  if let Some(v) = options.max_results {
    q.set("maxResults", "${v}")
  }
  if let Some(v) = options.page_token {
    q.set("pageToken", v)
  }
  if !options.fields.is_empty() {
    q.set("fields", options.fields.join(","))
  }
  q.set("alt", "json")
  q.set("prettyPrint", "false")
  var hs: List[(Str, Str)] = []
  if options.if_none_match != "" {
    hs.push(("If-None-Match", options.if_none_match))
  }
  hs = hs + options.headers
  let u = googleapi.expand(googleapi.resolve_relative(r.core.base_path, "apps/reseller/v1/subscriptions"), {})
  let resp = r.core.client.send(gensupport.Request{method: "GET", url: u, query: q, headers: hs, body: b""})?
  gensupport.check(resp)?
  gensupport.decode[Subscriptions](resp)
}

/// SubscriptionsListPages: the pages of SubscriptionsService.list (Go's Pages).
/// Call next_page while more() is true.
pub struct SubscriptionsListPages[fx: Effects] {
  r: SubscriptionsService[fx]
  options: SubscriptionsListOptions
  next_token: Str = ""
  started: Bool = false
}

/// list_pages: SubscriptionsService.list's pages, from the first.
pub fn (r: SubscriptionsService[fx]) list_pages(options: SubscriptionsListOptions = SubscriptionsListOptions{}) -> SubscriptionsListPages[fx] {
  SubscriptionsListPages{r: r, options: options}
}

/// Whether there is a page left to fetch.
pub fn (p: SubscriptionsListPages[fx]) more() -> Bool {
  !p.started || p.next_token != ""
}

/// The next page.
pub fn (var p: SubscriptionsListPages[fx]) next_page() -> Subscriptions ! gensupport.CallErr uses (net.dial, clock, rand, fx) {
  let o = if p.started { p.options with {page_token: Some(p.next_token)} } else { p.options }
  let v = p.r.list(o)?
  p.started = true
  p.next_token = v.next_page_token
  Ok(v)
}

