  gv_queue(f, "{\"backupPlans\":[{\"backupChannel\":\"s-backupchannel\",\"backupConfig\":{\"allNamespaces\":true,\"includeSecrets\":true,\"includeVolumeData\":true,\"permissiveMode\":true},\"backupSchedule\":{\"cronSchedule\":\"s-cronschedule\",\"nextScheduledBackupTime\":\"s-nextscheduledbackuptime\",\"paused\":true},\"cluster\":\"s-cluster\",\"createTime\":\"s-createtime\",\"deactivated\":true,\"description\":\"s-description\",\"etag\":\"s-etag\",\"labels\":{\"k1\":\"s-labels\"},\"lastSuccessfulBackupTime\":\"s-lastsuccessfulbackuptime\",\"name\":\"s-name\",\"protectedNamespaceCount\":7,\"protectedPodCount\":7,\"retentionPolicy\":{\"backupDeleteLockDays\":7,\"backupRetainDays\":7,\"locked\":true},\"rpoRiskLevel\":7,\"rpoRiskReason\":\"s-rporiskreason\",\"state\":\"s-state\",\"stateReason\":\"s-statereason\",\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
