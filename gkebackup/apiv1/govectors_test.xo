test "Go's gkebackup.projects.locations.restorePlans.restores.volumeRestores.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"volumeRestores\":[{\"completeTime\":\"s-completetime\",\"createTime\":\"s-createtime\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"state\":\"s-state\",\"stateMessage\":\"s-statemessage\",\"targetPvc\":{\"name\":\"s-name\",\"namespace\":\"s-namespace\"},\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\",\"volumeBackup\":\"s-volumebackup\",\"volumeHandle\":\"s-volumehandle\",\"volumeType\":\"s-volumetype\"}]}")
  gv_queue(f, "{\"volumeRestores\":[{\"completeTime\":\"s-completetime\",\"createTime\":\"s-createtime\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"state\":\"s-state\",\"stateMessage\":\"s-statemessage\",\"targetPvc\":{\"name\":\"s-name\",\"namespace\":\"s-namespace\"},\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\",\"volumeBackup\":\"s-volumebackup\",\"volumeHandle\":\"s-volumehandle\",\"volumeType\":\"s-volumetype\"}]}")
  gv_note(f, "CALL gkebackup.projects.locations.restorePlans.restores.volumeRestores.list pages")
  var p = svc.projects.locations.restore_plans.restores.volume_restores.list_pages("id1/ x", options: ProjectsLocationsRestorePlansRestoresVolumeRestoresListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_76)
}

