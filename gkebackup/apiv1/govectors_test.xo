  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"restorePlanBindings\":[{\"backupPlan\":\"s-backupplan\",\"createTime\":\"s-createtime\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"restorePlan\":\"s-restoreplan\",\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"restorePlanBindings\":[{\"backupPlan\":\"s-backupplan\",\"createTime\":\"s-createtime\",\"etag\":\"s-etag\",\"name\":\"s-name\",\"restorePlan\":\"s-restoreplan\",\"uid\":\"s-uid\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL gkebackup.projects.locations.restoreChannels.restorePlanBindings.list pages")
  var p = svc.projects.locations.restore_channels.restore_plan_bindings.list_pages("id1/ x", options: ProjectsLocationsRestoreChannelsRestorePlanBindingsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
