test "Go's datamigration.projects.locations.privateConnections.list pages" {
  let f = gv_new_fake(os.net, GV_HOST)
  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"nextPageToken\":\"s-nextpagetoken\",\"privateConnections\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"error\":{\"code\":7,\"message\":\"s-message\"},\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"pscInterfaceConfig\":{\"networkAttachment\":\"s-networkattachment\"},\"reservedPublicIpConfig\":{\"natIpsCount\":7},\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"vpcPeeringConfig\":{\"subnet\":\"s-subnet\",\"vpcName\":\"s-vpcname\"}}],\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"privateConnections\":[{\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"error\":{\"code\":7,\"message\":\"s-message\"},\"labels\":{\"k1\":\"s-labels\"},\"name\":\"s-name\",\"pscInterfaceConfig\":{\"networkAttachment\":\"s-networkattachment\"},\"reservedPublicIpConfig\":{\"natIpsCount\":7},\"satisfiesPzi\":true,\"satisfiesPzs\":true,\"state\":\"s-state\",\"updateTime\":\"s-updatetime\",\"vpcPeeringConfig\":{\"subnet\":\"s-subnet\",\"vpcName\":\"s-vpcname\"}}],\"unreachable\":[\"s-unreachable\"]}")
  gv_note(f, "CALL datamigration.projects.locations.privateConnections.list pages")
  var p = svc.projects.locations.private_connections.list_pages("id1/ x", options: ProjectsLocationsPrivateConnectionsListOptions{filter: Some("s-filter"), order_by: Some("s-orderby"), page_size: Some(7), page_token: Some("s-pagetoken"), fields: ["kind", "id"], if_none_match: "etag-1", headers: [("X-Extra", "v1")]})
  var failed = false
  while !failed && p.more() {
    match p.next_page() {
      Ok(r) => gv_note(f, "OUT: ${json.encode_str(r)}")
      Err(e) => {
        gv_note_lines(f, "OUT: error: ${e.display().replace("\n", "\n| ")}")
        failed = true
      }
    }
  }
  if !failed {
    gv_note(f, "OUT: ok")
  }
  gv_compare(gv_log_of(f), GO_79)
}

