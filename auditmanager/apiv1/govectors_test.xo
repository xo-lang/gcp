  let svc = new_service(os.net, gv_opts())
  gv_set(f, "{\"auditSchedules\":[{\"complianceFramework\":\"s-complianceframework\",\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"errorMessage\":\"s-errormessage\",\"gcsUri\":\"s-gcsuri\",\"lastTriggerTime\":\"s-lasttriggertime\",\"name\":\"s-name\",\"nextRunTime\":\"s-nextruntime\",\"reportFormat\":\"s-reportformat\",\"scheduleConfig\":{\"endTime\":\"s-endtime\",\"frequency\":\"s-frequency\",\"startTime\":\"s-starttime\",\"timeZone\":\"s-timezone\"},\"state\":\"s-state\",\"updateTime\":\"s-updatetime\"}],\"nextPageToken\":\"s-nextpagetoken\",\"unreachable\":[\"s-unreachable\"]}")
  gv_queue(f, "{\"auditSchedules\":[{\"complianceFramework\":\"s-complianceframework\",\"createTime\":\"s-createtime\",\"displayName\":\"s-displayname\",\"errorMessage\":\"s-errormessage\",\"gcsUri\":\"s-gcsuri\",\"lastTriggerTime\":\"s-lasttriggertime\",\"name\":\"s-name\",\"nextRunTime\":\"s-nextruntime\",\"reportFormat\":\"s-reportformat\",\"scheduleConfig\":{\"endTime\":\"s-endtime\",\"frequency\":\"s-frequency\",\"startTime\":\"s-starttime\",\"timeZone\":\"s-timezone\"},\"state\":\"s-state\",\"updateTime\":\"s-updatetime\"}],\"unreachable\":[\"s-unreachable\"]}")
